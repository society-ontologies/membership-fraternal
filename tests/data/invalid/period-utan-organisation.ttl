# EXPECT: a period that no organisation links to with mbr:hasPeriod
# MESSAGE: A period belongs to exactly one organisation
@prefix org:   <http://www.w3.org/ns/org#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix mbr:  <https://w3id.org/membership#> .
@prefix mbrc: <https://w3id.org/membership/code/> .
@prefix ex:    <https://example.org/invalid/> .

ex:Club a mbr:MembershipOrganization ; org:classification mbrc:privateClub .

ex:p a mbr:OrganizationPeriod ;
    mbr:genderPolicy mbrc:mixed ; mbr:startDate "2000"^^xsd:gYear .
