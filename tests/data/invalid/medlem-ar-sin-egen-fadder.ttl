# EXPECT: a membership whose mentor is the member
# MESSAGE: A member cannot be their own mentor
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org:  <http://www.w3.org/ns/org#> .
@prefix mbr:  <https://w3id.org/membership#> .
@prefix mbrc: <https://w3id.org/membership/code/> .
@prefix ex:   <https://example.org/invalid/> .

ex:Club a mbr:MembershipOrganization ; org:classification mbrc:privateClub .
ex:a a foaf:Person .
ex:m a mbr:Membership ; org:member ex:a ; org:organization ex:Club ; mbr:mentor ex:a .
