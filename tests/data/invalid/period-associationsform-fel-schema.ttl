# EXPECT: a period gives a legal form (mbrc:privateClub is an organisation type) from the wrong codelist
@prefix org:   <http://www.w3.org/ns/org#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix mbr:  <https://w3id.org/membership#> .
@prefix mbrc: <https://w3id.org/membership/code/> .
@prefix ex:    <https://example.org/invalid/> .

ex:Club a mbr:MembershipOrganization ; org:classification mbrc:privateClub .

ex:Club mbr:hasPeriod ex:p .
ex:p a mbr:OrganizationPeriod ; mbr:legalForm mbrc:privateClub ; mbr:startDate "2000"^^xsd:gYear .
