# EXPECT: mbrc:gold is a material, not a membership status
# MESSAGE: mbr:membershipStatus must be a concept in mbrc:MembershipStatuses
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix org:   <http://www.w3.org/ns/org#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix mbr:  <https://w3id.org/membership#> .
@prefix mbrc: <https://w3id.org/membership/code/> .
@prefix ex:    <https://example.org/invalid/> .

ex:Club a mbr:MembershipOrganization ; org:classification mbrc:privateClub .
ex:a a foaf:Person .
ex:m a mbr:Membership ; org:member ex:a ; org:organization ex:Club ;
    mbr:membershipStatus mbrc:gold .
