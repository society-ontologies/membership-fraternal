# EXPECT: a term of office whose office is a local concept with no mapping to mbrc:OfficeTypes
# MESSAGE: org:role must be a concept in mbrc:OfficeTypes
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix org:   <http://www.w3.org/ns/org#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix mbr:  <https://w3id.org/membership#> .
@prefix mbrc: <https://w3id.org/membership/code/> .
@prefix ex:    <https://example.org/invalid/> .

ex:Roller a skos:ConceptScheme ; skos:prefLabel "Egna ämbeten"@sv .
ex:klubbmastare a mbr:Office , skos:Concept ; skos:inScheme ex:Roller ; skos:prefLabel "Klubbmästare"@sv .
ex:Club a mbr:MembershipOrganization ; org:classification mbrc:privateClub .
ex:a a foaf:Person .
ex:t a mbr:Tenure ; org:member ex:a ; org:organization ex:Club ; org:role ex:klubbmastare ;
    mbr:startDate "2021"^^xsd:gYear .
