# EXPECT: an assessment whose outcome is a local concept with no mapping to fraternalc:AssessmentOutcomes
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mbr:  <https://w3id.org/membership#> .
@prefix fraternal:  <https://w3id.org/fraternal#> .
@prefix fraternalc: <https://w3id.org/fraternal/code/> .
@prefix ex:   <https://example.org/invalid/> .

ex:Utfall a skos:ConceptScheme ; skos:prefLabel "Egna utfall"@sv .
ex:tveksam a skos:Concept ; skos:inScheme ex:Utfall ; skos:prefLabel "Tveksam"@sv .
ex:SomeOrder a fraternal:FraternalOrder ; rdfs:label "Some order"@en ;
    fraternal:characteristic fraternalc:gradedDegrees .
ex:assessor a foaf:Organization .
ex:assessment a fraternal:LegitimacyAssessment ;
    fraternal:assessedOrder ex:SomeOrder ;
    fraternal:assessedBy ex:assessor ;
    fraternal:assessmentOutcome ex:tveksam ;
    mbr:startDate "2001"^^xsd:gYear .
