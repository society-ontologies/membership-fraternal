# EXPECT: a period gives mbrc:active (a membership status) as gender policy
# MESSAGE: mbr:genderPolicy must be one concept in mbrc:GenderPolicies
@prefix org:   <http://www.w3.org/ns/org#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix mbr:  <https://w3id.org/membership#> .
@prefix mbrc: <https://w3id.org/membership/code/> .
@prefix ex:    <https://example.org/invalid/> .

ex:Club a mbr:MembershipOrganization ; org:classification mbrc:privateClub .

ex:Club mbr:hasPeriod ex:p .
ex:p a mbr:OrganizationPeriod ; mbr:genderPolicy mbrc:active ; mbr:startDate "2000"^^xsd:gYear .
