# EXPECT: end date before start date (here on a term of office)
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org:  <http://www.w3.org/ns/org#> .
@prefix mbr:  <https://w3id.org/membership#> .
@prefix mbrc: <https://w3id.org/membership/code/> .
@prefix ex:   <https://example.org/invalid/> .

ex:Club a mbr:MembershipOrganization ; org:classification mbrc:privateClub .
ex:a a foaf:Person .
ex:t a mbr:Tenure ; org:member ex:a ; org:organization ex:Club ; org:role mbrc:secretary ;
    mbr:startDate "2020"^^xsd:gYear ; mbr:endDate "2019"^^xsd:gYear .
