# EXPECT: a period with none of genderPolicy, admissionMode, ownershipModel, organizationStatus, organizationType and legalForm
# MESSAGE: A period needs at least one of mbr:genderPolicy
@prefix org:   <http://www.w3.org/ns/org#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix mbr:  <https://w3id.org/membership#> .
@prefix mbrc: <https://w3id.org/membership/code/> .
@prefix ex:    <https://example.org/invalid/> .

ex:Club a mbr:MembershipOrganization ; org:classification mbrc:privateClub .

ex:Club mbr:hasPeriod ex:p .
ex:p a mbr:OrganizationPeriod ; mbr:startDate "2000"^^xsd:gYear .
