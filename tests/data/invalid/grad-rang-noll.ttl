# EXPECT: a degree whose fraternal:degreeRank is zero
# MESSAGE: fraternal:degreeRank must be one positive integer
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix fraternal: <https://w3id.org/fraternal#> .
@prefix ex:   <https://example.org/invalid/> .

ex:S a skos:ConceptScheme , fraternal:DegreeSystem ; skos:prefLabel "Ladder"@en .
ex:d0 a fraternal:Degree ; skos:inScheme ex:S ; skos:prefLabel "Zero"@en ;
    fraternal:degreeRank 0 .
