# Run on the HermiT-reasoned stack + samples (make reason). Returns one row per
# inference that must NOT happen; `robot verify` fails on any row.

PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX mbr:  <https://w3id.org/membership#>
PREFIX fraternal:  <https://w3id.org/fraternal#>
PREFIX club:  <https://example.org/lanternmere/>
PREFIX sor:   <https://example.org/soror-exemplum/>
PREFIX org:   <http://www.w3.org/ns/org#>
PREFIX th:    <https://example.org/thistledown/>
PREFIX fr:    <https://example.org/exemplie/>
PREFIX it:    <https://example.org/esempio/>

SELECT ?wrong WHERE {
    VALUES (?s ?type) {
        (club:Heatherbrook  mbr:GentlemensClub)
        (club:Lanternmere   mbr:LadiesClub)
        (club:Lanternmere   fraternal:FraternalOrder)   # a club is not an order
        (sor:FraterExemplum fraternal:Sorority)
        (club:guest1        mbr:MembershipOrganization)
        # a period is not an organisation (the property domains must not leak onto it)
        (th:policy-menonly  org:Organization)
        (th:policy-mixed    org:Organization)
        (th:policy-mixed    mbr:MembershipOrganization)
        # a women-only obedience is not a sorority: the gender policy does not define the class
        (fr:GrandeLogeDuSudExemplaire fraternal:Sorority)
        # a lodge is a branch, not an organisation in its own right
        (fr:LogeLaLanterne     mbr:MembershipOrganization)
        (it:LoggiaLaFenice     mbr:MembershipOrganization)
        # an association and a contrada are not orders
        (fr:AmisDeLaFontaine   fraternal:FraternalOrder)
        (it:ContradaDelFalco   fraternal:FraternalOrder)
    }
    ?s rdf:type ?type .
    BIND (CONCAT(STR(?s), " must not be a ", STR(?type)) AS ?wrong)
}
