# CQ8: All fraternal organisations, whatever codelist classifies them.
# Walks the SKOS hierarchy and the hub mappings (fraternal order types map to
# mbrc:fraternalOrganization), so the sororities, fraternities, lodges' grand
# bodies and Studentenverbindungen are found, while the clubs and nations are not.
# Labels: English if there is one, otherwise the first language alphabetically.

PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX org:   <http://www.w3.org/ns/org#>
PREFIX mbrc: <https://w3id.org/membership/code/>

SELECT DISTINCT ?name ?classifiedAs
WHERE {
    ?org org:classification ?type .
    ?type (skos:broader|skos:broadMatch|skos:exactMatch)* mbrc:fraternalOrganization .
    OPTIONAL { { SELECT ?type (STRAFTER(MIN(CONCAT(IF(LANG(?l) = "en", "0", "1"), LANG(?l), "|", STR(?l))), "|") AS ?classifiedAs)
                 WHERE { ?type skos:prefLabel ?l } GROUP BY ?type } }
    OPTIONAL { { SELECT ?org (STRAFTER(MIN(CONCAT(IF(LANG(?l) = "en", "0", "1"), LANG(?l), "|", STR(?l))), "|") AS ?name)
                 WHERE { ?org rdfs:label ?l } GROUP BY ?org } }
}
ORDER BY ?name
