# CQ7: The degree ladder of every order, in rank order, with the generic
# hub degree each one corresponds to (a direct exact, close or broad match, as
# the shapes accept).
# Labels: English if there is one, otherwise the first language alphabetically.

PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX fraternal: <https://w3id.org/fraternal#>

SELECT ?order ?rank ?degree ?notation ?hub
WHERE {
    ?o fraternal:degreeSystem ?system .
    ?d skos:inScheme ?system ;
       fraternal:degreeRank ?rank .
    OPTIONAL { { SELECT ?o (STRAFTER(MIN(CONCAT(IF(LANG(?l) = "en", "0", "1"), LANG(?l), "|", STR(?l))), "|") AS ?order)
                 WHERE { ?o rdfs:label ?l } GROUP BY ?o } }
    OPTIONAL { { SELECT ?d (STRAFTER(MIN(CONCAT(IF(LANG(?l) = "en", "0", "1"), LANG(?l), "|", STR(?l))), "|") AS ?degree)
                 WHERE { ?d skos:prefLabel ?l } GROUP BY ?d } }
    OPTIONAL { ?d skos:notation ?notation }
    OPTIONAL { ?d skos:exactMatch|skos:closeMatch|skos:broadMatch ?h .
               { SELECT ?h (STRAFTER(MIN(CONCAT(IF(LANG(?l) = "en", "0", "1"), LANG(?l), "|", STR(?l))), "|") AS ?hub)
                 WHERE { ?h skos:prefLabel ?l } GROUP BY ?h } }
}
ORDER BY ?order ?rank
