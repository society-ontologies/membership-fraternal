# CQ11: What does membership cost? One row per fee in force on a given date,
# with organisation type, how members are admitted, fee type, membership
# category (blank = all members), amount and currency.
# Labels: English if there is one, otherwise the first language alphabetically.

PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <http://schema.org/>
PREFIX org:    <http://www.w3.org/ns/org#>
PREFIX mbr:    <https://w3id.org/membership#>

SELECT ?organisation ?type ?admission ?feeType ?category ?price ?currency
WHERE {
    BIND (2025 AS ?year)
    ?o mbr:membershipFee ?fee ;
       org:classification ?otype .
    { SELECT ?o (STRAFTER(MIN(CONCAT(IF(LANG(?l) = "en", "0", "1"), LANG(?l), "|", STR(?l))), "|") AS ?organisation)
      WHERE { ?o rdfs:label ?l } GROUP BY ?o }
    { SELECT ?otype (STRAFTER(MIN(CONCAT(IF(LANG(?l) = "en", "0", "1"), LANG(?l), "|", STR(?l))), "|") AS ?type)
      WHERE { ?otype skos:prefLabel ?l } GROUP BY ?otype }
    OPTIONAL { ?o mbr:admissionMode ?am .
               { SELECT ?am (STRAFTER(MIN(CONCAT(IF(LANG(?l) = "en", "0", "1"), LANG(?l), "|", STR(?l))), "|") AS ?admission)
                 WHERE { ?am skos:prefLabel ?l } GROUP BY ?am } }
    ?fee mbr:feeType ?ft ;
         schema:price ?price ;
         schema:priceCurrency ?currency .
    { SELECT ?ft (STRAFTER(MIN(CONCAT(IF(LANG(?l) = "en", "0", "1"), LANG(?l), "|", STR(?l))), "|") AS ?feeType)
      WHERE { ?ft skos:prefLabel ?l } GROUP BY ?ft }
    OPTIONAL { ?fee mbr:appliesToCategory ?cat .
               { SELECT ?cat (STRAFTER(MIN(CONCAT(IF(LANG(?l) = "en", "0", "1"), LANG(?l), "|", STR(?l))), "|") AS ?category)
                 WHERE { ?cat skos:prefLabel ?l } GROUP BY ?cat } }
    # In force during ?year (compared by year, as dates may be partial).
    OPTIONAL { ?fee mbr:startDate ?s }
    OPTIONAL { ?fee mbr:endDate ?e }
    FILTER (!BOUND(?s) || xsd:integer(SUBSTR(STR(?s), 1, 4)) <= ?year)
    FILTER (!BOUND(?e) || xsd:integer(SUBSTR(STR(?e), 1, 4)) >= ?year)
}
ORDER BY ?organisation ?feeType ?category
