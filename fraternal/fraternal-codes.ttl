##############################################################################
# fraternal codelists  —  v1.1.0
#
# SKOS codelists for the Fraternal Orders and Sororities Ontology. Like the membership
# codelists these are hubs: an order's own degrees and titles map to them in
# mappings/*.sssom.tsv. The two generic degree ladders are real DegreeSystems,
# so a small order can use them directly instead of defining its own.
#
# The hub schemes (sections 1 to 7) hold only what orders in many countries have in
# common. What belongs to one tradition sits in a scheme of its own that says
# dcterms:isPartOf its hub scheme (section 10, and the Studentenverbindung schemes in
# section 9). See the README, design rule 3.
##############################################################################

@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix mbr:    <https://w3id.org/membership#> .
@prefix mbrc:   <https://w3id.org/membership/code/> .
@prefix fraternal:    <https://w3id.org/fraternal#> .
@prefix fraternalc:   <https://w3id.org/fraternal/code/> .

<https://w3id.org/fraternal/code>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/fraternal/code/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    owl:priorVersion <https://w3id.org/fraternal/code/1.0.0> ;
    owl:backwardCompatibleWith <https://w3id.org/fraternal/code/1.0.0> ;
    owl:imports <https://w3id.org/fraternal> , <https://w3id.org/membership/code> ;
    dcterms:title "Fraternal Orders and Sororities — codelists"@en ,
                  "Ordenssällskap — kodlistor"@sv ,
                  "Ordres fraternels et sororités — listes de codes"@fr ,
                  "Ordensgesellschaften und Schwesternschaften – Codelisten"@de ,
                  "Ordini fraternali e sororità — liste di codici"@it ,
                  "Órdenes fraternales y sororidades — listas de códigos"@es ,
                  "Ordens fraternais e sororidades — listas de códigos"@pt ,
                  "Testvéri rendek és női egyletek — kódlisták"@hu ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-10-09"^^xsd:date ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    vann:preferredNamespacePrefix "fraternalc" ;
    vann:preferredNamespaceUri "https://w3id.org/fraternal/code/" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator <https://orcid.org/0009-0002-6239-5346> ;
    dcterms:rightsHolder <https://orcid.org/0009-0002-6239-5346> ;
    dcterms:publisher <https://github.com/society-ontologies> .

<https://orcid.org/0009-0002-6239-5346> <http://xmlns.com/foaf/0.1/name> "Oscar Almgren" .

<https://github.com/society-ontologies> a <http://xmlns.com/foaf/0.1/Organization> ;
    <http://xmlns.com/foaf/0.1/name> "Society Ontologies" .

##############################################################################
# 1. ORDER TYPES  (each refines mbrc:fraternalOrganization via skos:broadMatch,
#    stated in mappings/fraternal-hubs.sssom.tsv; the two order-of-chivalry
#    types refine mbrc:society instead, since they are not ordenssällskap)
##############################################################################

fraternalc:OrderTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Order Types"@en , "Ordenstyper"@sv , "Types d'ordres"@fr , "Ordensarten"@de , "Tipi di ordine"@it , "Tipos de orden"@es , "Tipos de ordem"@pt , "Rendtípusok"@hu ;
    skos:definition "Kinds of fraternal order, used with org:classification."@en ,
                    "Typer av ordenssällskap, används med org:classification."@sv ,
                    "Sortes d'ordres fraternels, utilisées avec org:classification."@fr ,
                    "Arten von Ordensgesellschaften, verwendet mit org:classification."@de ,
                    "Tipi di ordine fraternale, usati con org:classification."@it ,
                    "Tipos de orden fraternal, usados con org:classification."@es ,
                    "Tipos de ordem fraternal, usados com org:classification."@pt ,
                    "A testvéri rendek fajtái, az org:classification-nel használatosak."@hu ;
    skos:hasTopConcept fraternalc:fraternalOrder , fraternalc:collegeFraternity , fraternalc:sorority ,
                       fraternalc:coedFraternity , fraternalc:secretSociety , fraternalc:confraternity ,
                       fraternalc:chivalricStyleOrder , fraternalc:studentOrder , fraternalc:benevolentOrder ,
                       fraternalc:adoptiveOrder , fraternalc:orderOfChivalry ,
                       fraternalc:selfStyledOrderOfChivalry , fraternalc:gastronomicBrotherhood ,
                       fraternalc:craftBrotherhood , fraternalc:intermediateBody .

fraternalc:intermediateBody a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Intermediate Body"@en , "Mellannivåorgan"@sv , "Organe intermédiaire"@fr , "Zwischenebene"@de , "Organo intermedio"@it , "Organismo intermedio"@es , "Organismo intermédio"@pt , "Közbülső testület"@hu ;
    skos:definition "A provincial, district or regional body that stands between the local lodges and the grand body: a provincial grand lodge, a district, a priory."@en ,
                    "Ett provins-, distrikts- eller regionalt organ mellan de lokala logerna och det överordnade organet: en provinsstorloge, ett distrikt, ett priorat."@sv ,
                    "Un organe provincial, de district ou régional entre les loges locales et l'organe dirigeant : une grande loge provinciale, un district, un prieuré."@fr ,
                    "Ein Provinz-, Distrikts- oder Regionalorgan zwischen den örtlichen Logen und dem übergeordneten Organ: eine Provinzialgroßloge, ein Distrikt, ein Priorat."@de ,
                    "Un organismo provinciale, distrettuale o regionale tra le logge locali e l'organismo di governo: una gran loggia provinciale, un distretto, un priorato."@it ,
                    "Un organismo provincial, de distrito o regional que está entre las logias locales y el organismo rector: una gran logia provincial, un distrito, un priorato."@es ,
                    "Um organismo provincial, de distrito ou regional que está entre as lojas locais e o organismo dirigente: uma grande loja provincial, um distrito, um priorado."@pt ,
                    "Tartományi, kerületi vagy területi testület, amely a helyi páholyok és az irányító testület között áll: tartományi nagypáholy, kerület, perjelség."@hu ;
    skos:scopeNote "Link the levels with org:subOrganizationOf: lodge, intermediate body, grand body. The type says where the body stands in the order, not what kind of order it is; give the order's own type to the grand body."@en ,
                   "Länka nivåerna med org:subOrganizationOf: loge, mellannivåorgan, överordnat organ. Typen anger var organet står i orden, inte vilken sorts orden det är; ange ordens egen typ på det överordnade organet."@sv ,
                   "Reliez les niveaux avec org:subOrganizationOf : loge, organe intermédiaire, organe dirigeant. Le type dit où l'organe se situe dans l'ordre, non de quelle sorte d'ordre il s'agit ; donnez le type propre de l'ordre à l'organe dirigeant."@fr ,
                   "Die Ebenen werden mit org:subOrganizationOf verknüpft: Loge, Zwischenebene, übergeordnetes Organ. Der Typ sagt, wo das Organ im Orden steht, nicht welche Art von Orden es ist; die eigene Art des Ordens gehört dem übergeordneten Organ."@de ,
                   "Si collegano i livelli con org:subOrganizationOf: loggia, organismo intermedio, organismo di governo. Il tipo dice dove si trova l'organismo nell'ordine, non di che specie di ordine si tratta; il tipo proprio dell'ordine va dato all'organismo di governo."@it ,
                   "Los niveles se vinculan con org:subOrganizationOf: logia, organismo intermedio, organismo rector. El tipo dice dónde está el organismo en la orden, no de qué clase de orden se trata; el tipo propio de la orden se da al organismo rector."@es ,
                   "Os níveis ligam-se com org:subOrganizationOf: loja, organismo intermédio, organismo dirigente. O tipo diz onde está o organismo na ordem, não de que espécie de ordem se trata; o tipo próprio da ordem dá-se ao organismo dirigente."@pt ,
                   "A szinteket az org:subOrganizationOf kapcsolja össze: páholy, közbülső testület, irányító testület. A típus azt mondja meg, hol áll a testület a rendben, nem azt, milyen fajta rendről van szó; a rend saját típusát az irányító testületnek kell megadni."@hu .

fraternalc:fraternalOrder a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Fraternal Order"@en , "Ordenssällskap"@sv , "Ordre fraternel"@fr , "Ordensgesellschaft"@de , "Ordine fraternale"@it , "Orden fraternal"@es , "Ordem fraternal"@pt , "Testvéri rend"@hu ;
    skos:definition "An order with initiation, ritual and degrees, not otherwise specified."@en ,
                    "En orden med initiering, ritual och grader, utan närmare precisering."@sv ,
                    "Ordre à initiation, rituel et degrés, sans autre précision."@fr ,
                    "Ein Orden mit Initiation, Ritual und Graden, nicht näher bestimmt."@de ,
                    "Un ordine con iniziazione, rituale e gradi, non altrimenti specificato."@it ,
                    "Una orden con iniciación, ritual y grados, sin mayor precisión."@es ,
                    "Uma ordem com iniciação, ritual e graus, sem maior precisão."@pt ,
                    "Beavatással, szertartással és fokozatokkal rendelkező rend, közelebbi meghatározás nélkül."@hu .

fraternalc:collegeFraternity a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "College Fraternity"@en , "Studentbrödraskap"@sv , "Fraternité universitaire"@fr , "College-Fraternity"@de , "Fraternity universitaria"@it , "Fraternidad universitaria"@es , "Fraternidade universitária"@pt , "Egyetemi fraternitás"@hu ;
    skos:definition "A collegiate social organisation for men, typically with Greek-letter names."@en ,
                    "En studentorganisation för män, oftast med namn av grekiska bokstäver."@sv ,
                    "Organisation sociale universitaire pour hommes, portant en général des noms en lettres grecques."@fr ,
                    "Eine studentische gesellige Organisation für Männer, typischerweise mit griechischen Buchstaben als Namen."@de ,
                    "Un'organizzazione sociale universitaria per uomini, di norma con nomi in lettere greche."@it ,
                    "Una organización social universitaria para hombres, típicamente con nombres en letras griegas."@es ,
                    "Uma organização social universitária para homens, tipicamente com nomes em letras gregas."@pt ,
                    "Férfiaknak szóló egyetemi társasági szervezet, jellemzően görög betűs nevekkel."@hu .

fraternalc:sorority a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Sorority"@en , "Systerskap"@sv , "Sororité"@fr , "Sorority"@de , "Sororità"@it , "Sororidad"@es , "Sororidade"@pt , "Női egylet"@hu ;
    skos:definition "A collegiate or fraternal organisation for women."@en ,
                    "En student- eller ordensorganisation för kvinnor."@sv ,
                    "Organisation universitaire ou fraternelle pour femmes."@fr ,
                    "Eine studentische oder bruderschaftliche Organisation für Frauen."@de ,
                    "Un'organizzazione universitaria o fraternale per donne."@it ,
                    "Una organización universitaria o fraternal para mujeres."@es ,
                    "Uma organização universitária ou fraternal para mulheres."@pt ,
                    "Nőknek szóló egyetemi vagy testvéri szervezet."@hu .

fraternalc:coedFraternity a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Co-ed Fraternity"@en , "Blandat ordenssällskap"@sv , "Fraternité mixte"@fr , "Gemischte Fraternity"@de , "Fraternity mista"@it , "Fraternidad mixta"@es , "Fraternidade mista"@pt , "Vegyes fraternitás"@hu ;
    skos:definition "A fraternal organisation admitting members of any gender."@en ,
                    "Ett ordenssällskap som upptar medlemmar av alla kön."@sv ,
                    "Organisation fraternelle qui admet des membres de tout genre."@fr ,
                    "Eine bruderschaftliche Organisation, die Mitglieder jeden Geschlechts aufnimmt."@de ,
                    "Un'organizzazione fraternale che ammette soci di qualsiasi genere."@it ,
                    "Una organización fraternal que admite miembros de cualquier género."@es ,
                    "Uma organização fraternal que admite membros de qualquer género."@pt ,
                    "Bármely nemű tagot felvevő testvéri szervezet."@hu .

fraternalc:secretSociety a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Secret Society"@en , "Hemligt sällskap"@sv , "Société secrète"@fr , "Geheimgesellschaft"@de , "Società segreta"@it , "Sociedad secreta"@es , "Sociedade secreta"@pt , "Titkos társaság"@hu ;
    skos:definition "An order whose activities and inner workings are concealed from non-members."@en ,
                    "En orden vars verksamhet och inre liv är dolda för icke-medlemmar."@sv ,
                    "Ordre dont l'activité et la vie interne sont cachées aux non-membres."@fr ,
                    "Ein Orden, dessen Tätigkeit und innere Abläufe vor Nichtmitgliedern verborgen sind."@de ,
                    "Un ordine le cui attività e il cui funzionamento interno sono nascosti ai non soci."@it ,
                    "Una orden cuyas actividades y funcionamiento interno se ocultan a los no miembros."@es ,
                    "Uma ordem cujas atividades e funcionamento interno se ocultam aos não membros."@pt ,
                    "Rend, amelynek tevékenységét és belső működését eltitkolják a kívülállók elől."@hu .

fraternalc:confraternity a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Confraternity"@en , "Konfraternitet"@sv , "Confrérie de laïcs"@fr , "Bruderschaft"@de , "Confraternita"@it , "Cofradía"@es , "Irmandade"@pt , "Társulat"@hu ;
    skos:definition "A religious lay brotherhood or sisterhood."@en ,
                    "Ett religiöst lekmannabrödraskap eller -systerskap."@sv ,
                    "Fraternité ou sororité religieuse de laïcs."@fr ,
                    "Eine religiöse Laienbruderschaft oder Laienschwesternschaft."@de ,
                    "Un sodalizio religioso di laici, di uomini o di donne."@it ,
                    "Una hermandad o cofradía religiosa de laicos."@es ,
                    "Uma irmandade ou confraria religiosa de leigos."@pt ,
                    "Vallásos világi testvériség vagy nővériség."@hu .

fraternalc:chivalricStyleOrder a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Order in the Chivalric Style"@en , "Orden i riddarordensstil"@sv , "Ordre de style chevaleresque"@fr , "Orden im Stil der Ritterorden"@de , "Ordine in stile cavalleresco"@it , "Orden de estilo caballeresco"@es , "Ordem de estilo cavaleiresco"@pt , "Lovagrendi stílusú rend"@hu ;
    skos:definition "An order society whose grades and insignia imitate those of an order of chivalry (member, knight, commander, grand cross), worn only within the order, and which does not claim to be an order of chivalry."@en ,
                    "Ett ordenssällskap vars grader och insignier efterbildar en riddarordens (ledamot, riddare, kommendör, storkors) och bärs endast inom orden, och som inte gör anspråk på att vara en riddarorden."@sv ,
                    "Société d'ordre dont les grades et les insignes imitent ceux d'un ordre de chevalerie (membre, chevalier, commandeur, grand-croix), portés seulement au sein de l'ordre, et qui ne prétend pas être un ordre de chevalerie."@fr ,
                    "Eine Ordensgesellschaft, deren Grade und Insignien denen eines Ritterordens nachgeahmt sind (Mitglied, Ritter, Kommandeur, Großkreuz), nur innerhalb des Ordens getragen werden und die nicht beansprucht, ein Ritterorden zu sein."@de ,
                    "Una società d'ordine i cui gradi e le cui insegne imitano quelli di un ordine cavalleresco (membro, cavaliere, commendatore, gran croce), portate solo all'interno dell'ordine, e che non pretende di essere un ordine cavalleresco."@it ,
                    "Una sociedad de orden cuyos grados e insignias imitan los de una orden de caballería (miembro, caballero, comendador, gran cruz), que se llevan solo dentro de la orden, y que no pretende ser una orden de caballería."@es ,
                    "Uma sociedade de ordem cujos graus e insígnias imitam os de uma ordem de cavalaria (membro, cavaleiro, comendador, grã-cruz), que se usam apenas dentro da ordem, e que não pretende ser uma ordem de cavalaria."@pt ,
                    "Rendtársaság, amelynek fokozatai és jelvényei egy lovagrendét utánozzák (tag, lovag, parancsnok, nagykereszt), amelyeket csak a renden belül viselnek, és amely nem állítja magáról, hogy lovagrend."@hu ;
    skos:scopeNote "Not a self-styled order of chivalry: what separates the two is the claim to be an order of chivalry (see fraternalc:selfStyledOrderOfChivalry)."@en ,
                   "Inte en självutnämnd riddarorden: det som skiljer de två åt är anspråket på att vara en riddarorden (se fraternalc:selfStyledOrderOfChivalry)."@sv ,
                   "Pas un ordre de chevalerie autoproclamé : ce qui sépare les deux est la prétention d'être un ordre de chevalerie (voir fraternalc:selfStyledOrderOfChivalry)."@fr ,
                   "Kein selbsternannter Ritterorden: Was beide trennt, ist der Anspruch, ein Ritterorden zu sein (siehe fraternalc:selfStyledOrderOfChivalry)."@de ,
                   "Non è un ordine cavalleresco autoproclamato: ciò che separa i due è la pretesa di essere un ordine cavalleresco (vedi fraternalc:selfStyledOrderOfChivalry)."@it ,
                   "No es una orden de caballería autoproclamada: lo que separa a ambas es la pretensión de ser una orden de caballería (véase fraternalc:selfStyledOrderOfChivalry)."@es ,
                   "Não é uma ordem de cavalaria autoproclamada: o que separa as duas é a pretensão de ser uma ordem de cavalaria (ver fraternalc:selfStyledOrderOfChivalry)."@pt ,
                   "Nem önmagát lovagrendnek nevező rend: ami a kettőt elválasztja, az a lovagrendnek vallása (lásd fraternalc:selfStyledOrderOfChivalry)."@hu .

fraternalc:studentOrder a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Student Order"@en , "Studentorden"@sv , "Ordre étudiant"@fr , "Studentenorden"@de , "Ordine studentesco"@it , "Orden estudiantil"@es , "Ordem estudantil"@pt , "Diákrend"@hu ;
    skos:definition "An order founded by and recruiting mainly among students, alumni or school pupils: university orders, orders of a student nation or union, and upper-secondary school orders."@en ,
                    "En orden grundad av och med rekrytering främst bland studenter, akademiker eller elever: universitetsordnar, nations- och kårordnar samt gymnasieordnar."@sv ,
                    "Ordre fondé par des étudiants, des anciens ou des lycéens et recrutant surtout parmi eux : ordres universitaires, ordres d'une nation ou d'un syndicat étudiant, et ordres de lycée."@fr ,
                    "Ein Orden, der von Studierenden, Ehemaligen oder Schülern gegründet wurde und hauptsächlich unter ihnen Mitglieder gewinnt: Universitätsorden, Orden einer Studentennation oder -vereinigung und Orden von Gymnasien."@de ,
                    "Un ordine fondato da studenti, ex alunni o liceali e che recluta soprattutto tra di loro: ordini universitari, ordini di una nazione o di un'unione studentesca e ordini di scuola secondaria superiore."@it ,
                    "Una orden fundada por estudiantes, antiguos alumnos o alumnos de secundaria y que recluta sobre todo entre ellos: órdenes universitarias, órdenes de una nación o unión estudiantil y órdenes de bachillerato."@es ,
                    "Uma ordem fundada por estudantes, antigos alunos ou alunos do ensino secundário e que recruta sobretudo entre eles: ordens universitárias, ordens de uma nação ou união estudantil e ordens do ensino secundário."@pt ,
                    "Diákok, öregdiákok vagy középiskolások által alapított és főként közülük toborzó rend: egyetemi rendek, diáknemzet vagy diákszövetség rendjei és középiskolai rendek."@hu ;
    skos:scopeNote "A student merit order that consists only of a badge awarded by a nation or union, with no body of members, is a distinction (mbr:Distinction), not an order."@en ,
                   "En studentförtjänstorden som bara består av ett tecken som en nation eller kår delar ut, utan egen medlemskrets, är en utmärkelse (mbr:Distinction), inte en orden."@sv ,
                   "Un ordre étudiant de mérite qui consiste seulement en un insigne décerné par une nation ou un syndicat, sans corps de membres, est une distinction (mbr:Distinction) et non un ordre."@fr ,
                   "Ein studentischer Verdienstorden, der nur aus einem von einer Nation oder Vereinigung verliehenen Abzeichen ohne Mitgliederkörper besteht, ist eine Auszeichnung (mbr:Distinction) und kein Orden."@de ,
                   "Un ordine studentesco di merito che consiste soltanto in un distintivo conferito da una nazione o da un'unione, senza un corpo di soci, è un riconoscimento (mbr:Distinction) e non un ordine."@it ,
                   "Una orden de mérito estudiantil que consiste solo en una insignia concedida por una nación o unión, sin cuerpo de miembros, es una distinción (mbr:Distinction), no una orden."@es ,
                   "Uma ordem de mérito estudantil que consiste apenas num distintivo concedido por uma nação ou união, sem corpo de membros, é uma distinção (mbr:Distinction), não uma ordem."@pt ,
                   "Az a diák érdemrend, amely csupán egy diáknemzet vagy -szövetség által adott jelvényből áll, tagtestület nélkül, kitüntetés (mbr:Distinction), nem rend."@hu .

fraternalc:benevolentOrder a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Benevolent Order"@en , "Välgörenhetsorden"@sv , "Ordre de bienfaisance"@fr , "Wohltätigkeitsorden"@de , "Ordine di beneficenza"@it , "Orden benéfica"@es , "Ordem benemérita"@pt , "Jótékonysági rend"@hu ;
    skos:definition "An order whose main purpose is mutual aid or charity."@en ,
                    "En orden vars huvudsyfte är ömsesidig hjälp eller välgörenhet."@sv ,
                    "Ordre dont le but principal est l'entraide ou la bienfaisance."@fr ,
                    "Ein Orden, dessen Hauptzweck gegenseitige Hilfe oder Wohltätigkeit ist."@de ,
                    "Un ordine il cui scopo principale è il mutuo soccorso o la beneficenza."@it ,
                    "Una orden cuyo fin principal es la ayuda mutua o la beneficencia."@es ,
                    "Uma ordem cujo fim principal é a ajuda mútua ou a beneficência."@pt ,
                    "Rend, amelynek fő célja a kölcsönös segítség vagy a jótékonyság."@hu .

fraternalc:adoptiveOrder a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Adoptive Order"@en , "Adoptivorden"@sv , "Ordre adoptif"@fr , "Adoptivorden"@de , "Ordine adottivo"@it , "Orden de adopción"@es , "Ordem de adoção"@pt , "Adoptív rend"@hu ;
    skos:definition "An order open to relatives of members of another order, often women relatives of a men's order."@en ,
                    "En orden öppen för anhöriga till medlemmar i en annan orden, ofta kvinnliga anhöriga till en herrorden."@sv ,
                    "Ordre ouvert aux proches des membres d'un autre ordre, souvent aux femmes proches d'un ordre masculin."@fr ,
                    "Ein Orden, der Angehörigen von Mitgliedern eines anderen Ordens offensteht, oft weiblichen Angehörigen eines Männerordens."@de ,
                    "Un ordine aperto ai parenti dei soci di un altro ordine, spesso alle parenti donne di un ordine maschile."@it ,
                    "Una orden abierta a familiares de miembros de otra orden, a menudo mujeres emparentadas con una orden de hombres."@es ,
                    "Uma ordem aberta a familiares de membros de outra ordem, muitas vezes mulheres aparentadas com uma ordem de homens."@pt ,
                    "Egy másik rend tagjainak hozzátartozói előtt nyitott rend, gyakran egy férfirend női hozzátartozóié."@hu .

fraternalc:orderOfChivalry a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Order of Chivalry"@en , "Riddarorden"@sv , "Ordre de chevalerie"@fr , "Ritterorden"@de , "Ordine cavalleresco"@it , "Orden de caballería"@es , "Ordem de cavalaria"@pt , "Lovagrend"@hu ;
    skos:definition "An order of knights and dames whose fons honorum is generally recognised: a state order, the order of a reigning or formerly reigning royal house, or an independent or semi-independent order such as those under the Holy See. Described here as the organisation of its members."@en ,
                    "En orden av riddare och damer vars fons honorum är allmänt erkänd: en statsorden, ett regerande eller tidigare regerande furstehus orden, eller en oberoende eller halvoberoende orden som de under Den heliga stolen. Beskrivs här som sammanslutningen av dess medlemmar."@sv ,
                    "Ordre de chevaliers et de dames dont la fons honorum est généralement reconnue : ordre d'État, ordre d'une maison royale régnante ou ayant régné, ou ordre indépendant ou semi-indépendant comme ceux relevant du Saint-Siège. Décrit ici comme l'organisation de ses membres."@fr ,
                    "Ein Orden von Rittern und Damen, dessen fons honorum allgemein anerkannt ist: ein staatlicher Orden, der Orden eines regierenden oder ehemals regierenden Königshauses oder ein unabhängiger oder halbunabhängiger Orden wie die unter dem Heiligen Stuhl. Hier als Organisation seiner Mitglieder beschrieben."@de ,
                    "Un ordine di cavalieri e dame la cui fons honorum è generalmente riconosciuta: un ordine di Stato, l'ordine di una casa reale regnante o già regnante, o un ordine indipendente o semindipendente come quelli che dipendono dalla Santa Sede. Descritto qui come l'organizzazione dei suoi membri."@it ,
                    "Una orden de caballeros y damas cuyo fons honorum es generalmente reconocido: una orden del Estado, la orden de una casa real reinante o que reinó, o una orden independiente o semiindependiente como las que están bajo la Santa Sede. Se describe aquí como la organización de sus miembros."@es ,
                    "Uma ordem de cavaleiros e damas cujo fons honorum é geralmente reconhecido: uma ordem do Estado, a ordem de uma casa real reinante ou que reinou, ou uma ordem independente ou semi-independente como as que estão sob a Santa Sé. Descreve-se aqui como a organização dos seus membros."@pt ,
                    "Lovagok és hölgyek rendje, amelynek fons honorum-át általánosan elismerik: állami rend, uralkodó vagy egykor uralkodó királyi ház rendje, vagy a Szentszék alatt állókhoz hasonló független vagy félig független rend. Itt tagjai szervezeteként van leírva."@hu ;
    skos:scopeNote "Give the authority with fraternal:fonsHonorum and any published judgement with fraternal:LegitimacyAssessment. An order of merit with no body of members is a mbr:Distinction."@en ,
                   "Ange auktoriteten med fraternal:fonsHonorum och publicerade bedömningar med fraternal:LegitimacyAssessment. En förtjänstorden utan medlemskrets är en mbr:Distinction."@sv ,
                   "Indiquer l'autorité avec fraternal:fonsHonorum et tout jugement publié avec fraternal:LegitimacyAssessment. Un ordre de mérite sans corps de membres est une mbr:Distinction."@fr ,
                   "Die Autorität mit fraternal:fonsHonorum und jedes veröffentlichte Urteil mit fraternal:LegitimacyAssessment angeben. Ein Verdienstorden ohne Mitgliederkörper ist eine mbr:Distinction."@de ,
                   "L'autorità si indica con fraternal:fonsHonorum e ogni giudizio pubblicato con fraternal:LegitimacyAssessment. Un ordine di merito senza un corpo di soci è un mbr:Distinction."@it ,
                   "La autoridad se da con fraternal:fonsHonorum y cualquier juicio publicado con fraternal:LegitimacyAssessment. Una orden de mérito sin cuerpo de miembros es una mbr:Distinction."@es ,
                   "A autoridade indica-se com fraternal:fonsHonorum e qualquer juízo publicado com fraternal:LegitimacyAssessment. Uma ordem de mérito sem corpo de membros é uma mbr:Distinction."@pt ,
                   "A hatalmat a fraternal:fonsHonorum, a közzétett ítéletet a fraternal:LegitimacyAssessment adja meg. A tagtestület nélküli érdemrend mbr:Distinction."@hu .

fraternalc:selfStyledOrderOfChivalry a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Self-styled Order of Chivalry"@en , "Självutnämnd riddarorden"@sv , "Ordre de chevalerie autoproclamé"@fr , "Selbsternannter Ritterorden"@de , "Ordine cavalleresco autoproclamato"@it , "Orden de caballería autoproclamada"@es , "Ordem de cavalaria autoproclamada"@pt , "Önmagát lovagrendnek nevező rend"@hu ;
    skos:altLabel "False Order of Chivalry"@en , "Private Order"@en ,
                  "Oäkta riddarorden"@sv , "Privatorden"@sv ,
                  "Ordre de fantaisie"@fr ,
                  "Falso ordine cavalleresco"@it ,
                  "Ordine privato"@it ;
    skos:definition "An organisation that claims to be an order of chivalry without a generally recognised fons honorum."@en ,
                    "En sammanslutning som gör anspråk på att vara en riddarorden utan en allmänt erkänd fons honorum."@sv ,
                    "Organisation qui prétend être un ordre de chevalerie sans fons honorum généralement reconnue."@fr ,
                    "Eine Organisation, die beansprucht, ein Ritterorden zu sein, ohne einen allgemein anerkannten fons honorum zu haben."@de ,
                    "Un'organizzazione che pretende di essere un ordine cavalleresco senza una fons honorum generalmente riconosciuta."@it ,
                    "Una organización que pretende ser una orden de caballería sin un fons honorum generalmente reconocido."@es ,
                    "Uma organização que pretende ser uma ordem de cavalaria sem um fons honorum geralmente reconhecido."@pt ,
                    "Szervezet, amely általánosan elismert fons honorum nélkül állítja magáról, hogy lovagrend."@hu ;
    skos:scopeNote "Calling an order self-styled is a judgement: record who made it, when and where with a fraternal:LegitimacyAssessment. An order society that uses chivalric grades without claiming to be an order of chivalry is fraternalc:chivalricStyleOrder."@en ,
                   "Att kalla en orden självutnämnd är en bedömning: ange vem som gjort den, när och var med en fraternal:LegitimacyAssessment. Ett ordenssällskap som använder riddarordensgrader utan att göra anspråk på att vara en riddarorden är fraternalc:chivalricStyleOrder."@sv ,
                   "Qualifier un ordre d'autoproclamé est un jugement : consigner qui l'a émis, quand et où, avec une fraternal:LegitimacyAssessment. Une société d'ordre qui emploie des grades chevaleresques sans prétendre être un ordre de chevalerie est un fraternalc:chivalricStyleOrder."@fr ,
                   "Einen Orden selbsternannt zu nennen ist ein Urteil: Wer es wann und wo gefällt hat, mit einer fraternal:LegitimacyAssessment festhalten. Eine Ordensgesellschaft, die ritterliche Grade verwendet, ohne zu beanspruchen, ein Ritterorden zu sein, ist fraternalc:chivalricStyleOrder."@de ,
                   "Chiamare autoproclamato un ordine è un giudizio: si registra chi lo ha espresso, quando e dove con una fraternal:LegitimacyAssessment. Una società d'ordine che usa gradi cavallereschi senza pretendere di essere un ordine cavalleresco è fraternalc:chivalricStyleOrder."@it ,
                   "Llamar autoproclamada a una orden es un juicio: quién lo hizo, cuándo y dónde se registra con una fraternal:LegitimacyAssessment. Una sociedad de orden que usa grados caballerescos sin pretender ser una orden de caballería es fraternalc:chivalricStyleOrder."@es ,
                   "Chamar autoproclamada a uma ordem é um juízo: quem o fez, quando e onde regista-se com uma fraternal:LegitimacyAssessment. Uma sociedade de ordem que usa graus cavaleirescos sem pretender ser uma ordem de cavalaria é fraternalc:chivalricStyleOrder."@pt ,
                   "Egy rendet önmagát nevezőnek mondani ítélet: ki mondta, mikor és hol, fraternal:LegitimacyAssessment rögzíti. Az a rendtársaság, amely lovagrendi fokozatokat használ anélkül, hogy lovagrendnek állítaná magát, fraternalc:chivalricStyleOrder."@hu .

fraternalc:gastronomicBrotherhood a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Food and Wine Brotherhood"@en , "Gastronomiskt brödraskap"@sv , "Confrérie gastronomique"@fr , "Wein- und Gastronomiebruderschaft"@de , "Confraternita enogastronomica"@it , "Cofradía gastronómica"@es , "Confraria gastronómica"@pt , "Gasztronómiai testvériség"@hu ;
    skos:altLabel "Wine Brotherhood"@en , "Confrérie bachique"@fr , "Confrérie vineuse"@fr , "Confraternita del vino"@it ;
    skos:definition "A brotherhood devoted to a regional food or drink tradition, such as a wine, cheese or beer brotherhood, whose members are inducted at a ceremonial chapter and often wear robes and bear titles in the chivalric style."@en ,
                    "Ett brödraskap ägnat en regional mat- eller dryckestradition, som ett vin-, ost- eller ölbrödraskap, vars medlemmar upptas vid en ceremoniell sammankomst och ofta bär dräkt och titlar i riddarordensstil."@sv ,
                    "Confrérie vouée à une tradition gastronomique ou viticole régionale, dont les membres sont intronisés lors d'un chapitre et portent souvent une robe et des titres de style chevaleresque."@fr ,
                    "Eine Bruderschaft, die einer regionalen Speisen- oder Getränketradition gewidmet ist, etwa eine Wein-, Käse- oder Bierbruderschaft; ihre Mitglieder werden bei einem zeremoniellen Kapitel aufgenommen, tragen oft Roben und führen Titel im ritterlichen Stil."@de ,
                    "Una confraternita dedicata a una tradizione regionale di cibo o bevanda, come una confraternita del vino, del formaggio o della birra, i cui membri sono investiti in un capitolo cerimoniale e spesso indossano un abito e portano titoli in stile cavalleresco."@it ,
                    "Una cofradía dedicada a una tradición regional de comida o bebida, como una cofradía del vino, del queso o de la cerveza, cuyos miembros son investidos en un capítulo ceremonial y a menudo llevan túnicas y ostentan títulos al estilo caballeresco."@es ,
                    "Uma confraria dedicada a uma tradição regional de comida ou bebida, como uma confraria do vinho, do queijo ou da cerveja, cujos membros são investidos num capítulo cerimonial e muitas vezes usam túnicas e ostentam títulos ao estilo cavaleiresco."@pt ,
                    "Egy regionális étel- vagy italhagyománynak szentelt testvériség, például bor-, sajt- vagy sörtestvériség, amelynek tagjait ünnepi káptalanban avatják, és gyakran köntöst viselnek és lovagrendi stílusú címeket használnak."@hu ;
    skos:scopeNote "Often also fraternalc:chivalricStyleOrder: classify with both. Not a religious confraternity (fraternalc:confraternity), though the French word confrérie covers those too."@en ,
                   "Är ofta också fraternalc:chivalricStyleOrder: klassificera med båda. Inte ett religiöst lekmannabrödraskap (fraternalc:confraternity), fast det franska ordet confrérie också omfattar sådana."@sv ,
                   "Souvent aussi un fraternalc:chivalricStyleOrder : classer avec les deux. Pas une confrérie religieuse (fraternalc:confraternity), bien que le mot confrérie couvre aussi celles-ci."@fr ,
                   "Oft auch fraternalc:chivalricStyleOrder: Mit beiden einordnen. Keine religiöse Bruderschaft (fraternalc:confraternity), obwohl das französische Wort confrérie auch diese umfasst."@de ,
                   "Spesso anche fraternalc:chivalricStyleOrder: si classifica con entrambi. Non è una confraternita religiosa (fraternalc:confraternity), anche se la parola francese confrérie comprende anche queste."@it ,
                   "A menudo también fraternalc:chivalricStyleOrder: se clasifica con ambos. No es una cofradía religiosa (fraternalc:confraternity), aunque la palabra francesa confrérie abarca también esas."@es ,
                   "Muitas vezes também fraternalc:chivalricStyleOrder: classifica-se com ambos. Não é uma irmandade religiosa (fraternalc:confraternity), embora a palavra francesa confrérie abranja também essas."@pt ,
                   "Gyakran egyben fraternalc:chivalricStyleOrder: mindkettővel osztályozandó. Nem vallásos társulat (fraternalc:confraternity), bár a francia confrérie szó azokat is felöleli."@hu .

fraternalc:craftBrotherhood a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:OrderTypes ; skos:topConceptOf fraternalc:OrderTypes ;
    skos:prefLabel "Craft Brotherhood"@en , "Hantverksbrödraskap"@sv , "Compagnonnage"@fr , "Handwerkerbruderschaft"@de , "Confraternita di mestiere"@it , "Hermandad de oficio"@es , "Irmandade de ofício"@pt , "Mesterségi testvériség"@hu ;
    skos:altLabel "Journeymen's Brotherhood"@en , "Association compagnonnique"@fr ;
    skos:definition "A brotherhood of craftsmen that passes on a trade through initiation, ritual and stages of membership, typically with years of travel between workplaces and a masterpiece before full membership. French compagnonnage, a network of such brotherhoods, is the main example."@en ,
                    "Ett brödraskap av hantverkare som för ett yrke vidare genom initiering, ritual och medlemsstadier, vanligen med år av vandring mellan arbetsplatser och ett mästerstycke före fullt medlemskap. Det franska compagnonnage, ett nätverk av sådana brödraskap, är det främsta exemplet."@sv ,
                    "Fraternité d'artisans qui transmet un métier par l'initiation, le rituel et des étapes d'appartenance, en général avec des années de voyage d'un lieu de travail à l'autre et un chef-d'œuvre avant le plein statut de membre. Le compagnonnage français, réseau de telles fraternités, en est l'exemple principal."@fr ,
                    "Eine Bruderschaft von Handwerkern, die ein Gewerbe durch Aufnahme, Ritual und Mitgliedschaftsstufen weitergibt, typischerweise mit Jahren der Wanderschaft zwischen Werkstätten und einem Meisterstück vor der Vollmitgliedschaft. Das französische Compagnonnage, ein Netz solcher Bruderschaften, ist das wichtigste Beispiel."@de ,
                    "Una confraternita di artigiani che trasmette un mestiere con iniziazione, rituale e stadi di appartenenza, di solito con anni di viaggio tra le botteghe e un capolavoro prima della piena appartenenza. Il compagnonnage francese, una rete di tali confraternite, ne è l'esempio principale."@it ,
                    "Una hermandad de artesanos que transmite un oficio mediante iniciación, ritual y etapas de pertenencia, típicamente con años de viaje entre talleres y una obra maestra antes de la pertenencia plena. El compagnonnage francés, una red de tales hermandades, es el ejemplo principal."@es ,
                    "Uma irmandade de artesãos que transmite um ofício através de iniciação, ritual e etapas de filiação, tipicamente com anos de viagem entre oficinas e uma obra-prima antes da filiação plena. O compagnonnage francês, uma rede de tais irmandades, é o exemplo principal."@pt ,
                    "Kézművesek testvérisége, amely a mesterséget beavatással, szertartással és tagsági szakaszokkal adja tovább, jellemzően évekig tartó vándorlással a műhelyek között és remekművel a teljes tagság előtt. A francia compagnonnage, ilyen testvériségek hálózata, a fő példa."@hu ;
    skos:scopeNote "A guild or trade association that only represents a trade, without initiation, ritual or stages of membership, is not a craft brotherhood. The compagnonnage was entered on the UNESCO Representative List of the Intangible Cultural Heritage of Humanity in 2010."@en ,
                   "Ett skrå eller en yrkesförening som bara företräder ett yrke, utan initiering, ritual eller medlemsstadier, är inte ett hantverksbrödraskap. Compagnonnage togs 2010 upp på Unescos representativa lista över mänsklighetens immateriella kulturarv."@sv ,
                   "Une corporation ou une association professionnelle qui ne fait que représenter un métier, sans initiation, rituel ni étapes d'appartenance, n'est pas une fraternité d'artisans. Le compagnonnage a été inscrit en 2010 sur la Liste représentative du patrimoine culturel immatériel de l'humanité de l'UNESCO."@fr ,
                   "Eine Zunft oder ein Berufsverband, der ein Gewerbe nur vertritt, ohne Aufnahme, Ritual oder Mitgliedschaftsstufen, ist keine Handwerkerbruderschaft. Das Compagnonnage wurde 2010 in die Repräsentative Liste des immateriellen Kulturerbes der Menschheit der UNESCO aufgenommen."@de ,
                   "Una corporazione o un'associazione di categoria che rappresenta soltanto un mestiere, senza iniziazione, rituale né stadi di appartenenza, non è una confraternita di mestiere. Il compagnonnage è stato iscritto nel 2010 nella Lista rappresentativa del patrimonio culturale immateriale dell'umanità dell'UNESCO."@it ,
                   "Un gremio o asociación profesional que solo representa un oficio, sin iniciación, ritual ni etapas de pertenencia, no es una hermandad de oficio. El compagnonnage fue inscrito en 2010 en la Lista Representativa del Patrimonio Cultural Inmaterial de la Humanidad de la UNESCO."@es ,
                   "Um grémio ou associação profissional que apenas representa um ofício, sem iniciação, ritual nem etapas de filiação, não é uma irmandade de ofício. O compagnonnage foi inscrito em 2010 na Lista Representativa do Património Cultural Imaterial da Humanidade da UNESCO."@pt ,
                   "A céh vagy szakmai egyesület, amely csupán egy mesterséget képvisel, beavatás, szertartás vagy tagsági szakaszok nélkül, nem mesterségi testvériség. A compagnonnage-t 2010-ben felvették az UNESCO Az emberiség szellemi kulturális örökségének reprezentatív listájára."@hu .

fraternalc:studentenverbindung a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTypes ; skos:topConceptOf fraternalc:StudentenverbindungTypes ;
    skos:narrower fraternalc:corps , fraternalc:burschenschaft , fraternalc:landsmannschaft , fraternalc:turnerschaft ,
                  fraternalc:saengerschaft , fraternalc:catholicStudentenverbindung , fraternalc:christianStudentenverbindung ,
                  fraternalc:turnverbindung , fraternalc:wissenschaftlicheVerbindung , fraternalc:damenverbindung ,
                  fraternalc:schuelerverbindung ;
    skos:prefLabel "Studentenverbindung"@en , "Tysk studentkorporation"@sv , "Studentenverbindung"@de , "Studentenverbindung"@it , "Studentenverbindung"@fr , "Studentenverbindung"@es , "Studentenverbindung"@pt , "Studentenverbindung"@hu ;
    skos:altLabel "German Student Fraternity"@en , "Student Corporation"@en , "Korporation"@de , "Verbindung"@de , "Studentenverbindning"@sv , "Corporazione studentesca"@it ;
    skos:definition "A student fraternity of the German-speaking countries (Germany, Austria, Switzerland), also called a Korporation: a lifelong union of students and alumni with its own house, colours, customs and a rule book (the Comment), usually organised in an active branch of current students (Aktivitas) and an alumni branch (Altherrenschaft). The traditions below refine it."@en ,
                    "En studentförening i de tyskspråkiga länderna (Tyskland, Österrike, Schweiz), även kallad korporation: ett livslångt förbund av studenter och alumner med eget hus, egna färger och sedvänjor samt ett regelverk (Comment), vanligen uppdelat i en aktivitas av nuvarande studenter och en gammalherrarförening (Altherrenschaft). Traditionerna nedan förfinar den."@sv ,
                    "Eine studentische Gemeinschaft des deutschsprachigen Raums (Deutschland, Österreich, Schweiz), auch Korporation genannt: ein auf Lebenszeit angelegter Bund von Studierenden und Ehemaligen mit eigenem Haus, Farben, Bräuchen und einem Regelwerk (dem Komment), meist gegliedert in die Aktivitas der Studierenden und die Altherrenschaft. Die folgenden Traditionen verfeinern sie."@de ,
                    "Una corporazione studentesca dei paesi di lingua tedesca (Germania, Austria, Svizzera), detta anche Korporation: un'unione per la vita di studenti ed ex studenti con una propria casa, propri colori, usanze e un regolamento (il Comment), di solito organizzata in un ramo attivo di studenti in corso (Aktivitas) e in un ramo di ex studenti (Altherrenschaft). Le tradizioni qui sotto la specificano."@it ,
                    "Corporation d'étudiants des pays de langue allemande (Allemagne, Autriche, Suisse), appelée aussi Korporation : union à vie d'étudiants et d'anciens avec sa propre maison, ses couleurs, ses usages et un règlement (le Comment), en général organisée en une branche active d'étudiants en cours d'études (Aktivitas) et une branche d'anciens (Altherrenschaft). Les traditions ci-dessous la précisent."@fr ,
                    "Una fraternidad estudiantil de los países de habla alemana (Alemania, Austria, Suiza), llamada también Korporation: una unión de por vida de estudiantes y antiguos alumnos con casa propia, colores, costumbres y un reglamento (el Comment), por lo general organizada en una rama activa de estudiantes actuales (Aktivitas) y una rama de antiguos alumnos (Altherrenschaft). Las tradiciones siguientes la precisan."@es ,
                    "Uma fraternidade estudantil dos países de língua alemã (Alemanha, Áustria, Suíça), chamada também Korporation: uma união para toda a vida de estudantes e antigos alunos com casa própria, cores, costumes e um regulamento (o Comment), em regra organizada num ramo ativo de estudantes atuais (Aktivitas) e num ramo de antigos alunos (Altherrenschaft). As tradições seguintes precisam-na."@pt ,
                    "A német nyelvű országok (Németország, Ausztria, Svájc) diákfraternitása, Korporationnak is nevezik: diákok és öregdiákok élethosszig tartó szövetsége saját házzal, színekkel, szokásokkal és szabálykönyvvel (a Comment), rendszerint a jelenlegi diákok aktív ágára (Aktivitas) és az öregdiákok ágára (Altherrenschaft) szerveződve. Az alábbi hagyományok pontosítják."@hu .

fraternalc:corps a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTypes ; skos:broader fraternalc:studentenverbindung ;
    skos:prefLabel "Corps"@en , "Corps"@sv , "Corps"@de , "Corps"@it , "Corps"@fr , "Corps"@es , "Corps"@pt , "Corps"@hu ;
    skos:altLabel "Kösener Corps"@de , "Weinheimer Corps"@de ;
    skos:definition "The oldest tradition of Studentenverbindung, growing out of the regional student groups of the 18th century. Typically lifelong (Lebensbund), self-governing through the convent, tolerant in politics and religion, wearing colours and requiring the Mensur. Federations include the Kösener Senioren-Convents-Verband (KSCV) and the Weinheimer Senioren-Convent (WSC)."@en ,
                    "Den äldsta traditionen av Studentenverbindung, framvuxen ur 1700-talets regionala studentgrupper. Vanligen livslång (Lebensbund), självstyrande genom konventet, tolerant i politik och religion, med färger och krav på mensur. Förbund är bland andra Kösener Senioren-Convents-Verband (KSCV) och Weinheimer Senioren-Convent (WSC)."@sv ,
                    "Die älteste Tradition der Studentenverbindung, hervorgegangen aus den regionalen Studentengruppen des 18. Jahrhunderts. In der Regel auf Lebenszeit (Lebensbund), durch den Convent selbst verwaltet, politisch und religiös tolerant, farbentragend und mit Mensurpflicht. Dachverbände sind unter anderem der Kösener Senioren-Convents-Verband (KSCV) und der Weinheimer Senioren-Convent (WSC)."@de ,
                    "La più antica tradizione di Studentenverbindung, nata dai gruppi studenteschi regionali del Settecento. Di norma per la vita (Lebensbund), autogovernata attraverso il convent, tollerante in politica e religione, con colori portati e con la Mensur obbligatoria. Le federazioni comprendono il Kösener Senioren-Convents-Verband (KSCV) e il Weinheimer Senioren-Convent (WSC)."@it ,
                    "La plus ancienne tradition de Studentenverbindung, issue des groupes d'étudiants régionaux du XVIIIe siècle. En général à vie (Lebensbund), autogérée par le convent, tolérante en politique et en religion, portant les couleurs et exigeant la Mensur. Parmi les fédérations : le Kösener Senioren-Convents-Verband (KSCV) et le Weinheimer Senioren-Convent (WSC)."@fr ,
                    "La tradición más antigua de Studentenverbindung, surgida de los grupos estudiantiles regionales del siglo XVIII. Típicamente de por vida (Lebensbund), autogobernada por el convent, tolerante en política y religión, con colores y que exige la Mensur. Las federaciones incluyen el Kösener Senioren-Convents-Verband (KSCV) y el Weinheimer Senioren-Convent (WSC)."@es ,
                    "A tradição mais antiga de Studentenverbindung, surgida dos grupos estudantis regionais do século XVIII. Tipicamente para toda a vida (Lebensbund), autogovernada pelo convent, tolerante em política e religião, com cores e que exige a Mensur. As federações incluem o Kösener Senioren-Convents-Verband (KSCV) e o Weinheimer Senioren-Convent (WSC)."@pt ,
                    "A Studentenverbindung legrégebbi hagyománya, a 18. századi regionális diákcsoportokból nőtt ki. Jellemzően élethosszig tartó (Lebensbund), a konventen át önkormányzó, politikában és vallásban toleráns, színeket visel, és megköveteli a Mensurt. A szövetségek közé tartozik a Kösener Senioren-Convents-Verband (KSCV) és a Weinheimer Senioren-Convent (WSC)."@hu .

fraternalc:burschenschaft a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTypes ; skos:broader fraternalc:studentenverbindung ;
    skos:prefLabel "Burschenschaft"@en , "Burschenschaft"@sv , "Burschenschaft"@de , "Burschenschaft"@it , "Burschenschaft"@fr , "Burschenschaft"@es , "Burschenschaft"@pt , "Burschenschaft"@hu ;
    skos:definition "A tradition of Studentenverbindung that arose from the patriotic and liberal student movement after 1815 (the first at Jena), with the motto Ehre, Freiheit, Vaterland and the colours black, red and gold. The federation is the Deutsche Burschenschaft (DB); in Austria there are Burschenschaften of their own. Some are schlagend, others not."@en ,
                    "En tradition av Studentenverbindung som uppstod ur den patriotiska och liberala studentrörelsen efter 1815 (den första i Jena), med devisen Ehre, Freiheit, Vaterland och färgerna svart, rött och guld. Förbundet är Deutsche Burschenschaft (DB); i Österrike finns egna Burschenschaften. Vissa är schlagend, andra inte."@sv ,
                    "Eine Tradition der Studentenverbindung, die aus der patriotisch-liberalen Studentenbewegung nach 1815 hervorging (die erste in Jena), mit dem Wahlspruch Ehre, Freiheit, Vaterland und den Farben Schwarz, Rot und Gold. Der Dachverband ist die Deutsche Burschenschaft (DB); in Österreich gibt es eigene Burschenschaften. Manche sind schlagend, andere nicht."@de ,
                    "Una tradizione di Studentenverbindung sorta dal movimento studentesco patriottico e liberale dopo il 1815 (la prima a Jena), con il motto Ehre, Freiheit, Vaterland e i colori nero, rosso e oro. La federazione è la Deutsche Burschenschaft (DB); in Austria esistono Burschenschaften proprie. Alcune sono schlagend, altre no."@it ,
                    "Tradition de Studentenverbindung née du mouvement étudiant patriotique et libéral après 1815 (la première à Iéna), avec la devise Ehre, Freiheit, Vaterland et les couleurs noir, rouge et or. La fédération est la Deutsche Burschenschaft (DB) ; en Autriche il existe des Burschenschaften propres. Certaines sont schlagend, d'autres non."@fr ,
                    "Una tradición de Studentenverbindung surgida del movimiento estudiantil patriótico y liberal tras 1815 (la primera en Jena), con el lema Ehre, Freiheit, Vaterland y los colores negro, rojo y oro. La federación es la Deutsche Burschenschaft (DB); en Austria hay Burschenschaften propias. Unas son schlagend y otras no."@es ,
                    "Uma tradição de Studentenverbindung surgida do movimento estudantil patriótico e liberal depois de 1815 (a primeira em Jena), com o lema Ehre, Freiheit, Vaterland e as cores preto, vermelho e ouro. A federação é a Deutsche Burschenschaft (DB); na Áustria há Burschenschaften próprias. Umas são schlagend e outras não."@pt ,
                    "A Studentenverbindung hagyománya, amely az 1815 utáni hazafias és liberális diákmozgalomból született (az első Jénában), az Ehre, Freiheit, Vaterland jelmondattal és a fekete, piros és arany színekkel. A szövetség a Deutsche Burschenschaft (DB); Ausztriában saját Burschenschaftok vannak. Egyesek schlagend, mások nem."@hu .

fraternalc:landsmannschaft a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTypes ; skos:broader fraternalc:studentenverbindung ;
    skos:prefLabel "Landsmannschaft"@en , "Landsmannschaft"@sv , "Landsmannschaft"@de , "Landsmannschaft"@it , "Landsmannschaft"@fr , "Landsmannschaft"@es , "Landsmannschaft"@pt , "Landsmannschaft"@hu ;
    skos:definition "A tradition of Studentenverbindung that goes back to the student groups formed by region of origin (Land). Landsmannschaften are usually schlagend and wear colours; many belong to the Coburger Convent (CC)."@en ,
                    "En tradition av Studentenverbindung som går tillbaka på studentgrupper bildade efter hemtrakt (Land). Landsmannschaften är oftast schlagend och bär färger; många tillhör Coburger Convent (CC)."@sv ,
                    "Eine Tradition der Studentenverbindung, die auf die nach Herkunftsland gebildeten Studentengruppen zurückgeht. Landsmannschaften sind meist schlagend und farbentragend; viele gehören dem Coburger Convent (CC) an."@de ,
                    "Una tradizione di Studentenverbindung che risale ai gruppi studenteschi formati per regione di provenienza (Land). Le Landsmannschaften sono di solito schlagend e portano i colori; molte appartengono al Coburger Convent (CC)."@it ,
                    "Tradition de Studentenverbindung qui remonte aux groupes d'étudiants formés selon la région d'origine (Land). Les Landsmannschaften sont en général schlagend et portent les couleurs ; beaucoup appartiennent au Coburger Convent (CC)."@fr ,
                    "Una tradición de Studentenverbindung que se remonta a los grupos estudiantiles formados por región de origen (Land). Las Landsmannschaften suelen ser schlagend y llevan colores; muchas pertenecen al Coburger Convent (CC)."@es ,
                    "Uma tradição de Studentenverbindung que remonta aos grupos estudantis formados por região de origem (Land). As Landsmannschaften são em regra schlagend e usam cores; muitas pertencem ao Coburger Convent (CC)."@pt ,
                    "A Studentenverbindung hagyománya, amely a származási vidék (Land) szerint alakult diákcsoportokra megy vissza. A Landsmannschaftok rendszerint schlagend és színeket viselnek; sok a Coburger Convenhez (CC) tartozik."@hu .

fraternalc:turnerschaft a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTypes ; skos:broader fraternalc:studentenverbindung ;
    skos:prefLabel "Turnerschaft"@en , "Turnerschaft"@sv , "Turnerschaft"@de , "Turnerschaft"@it , "Turnerschaft"@fr , "Turnerschaft"@es , "Turnerschaft"@pt , "Turnerschaft"@hu ;
    skos:definition "A tradition of Studentenverbindung rooted in the 19th-century gymnastics movement (Turnbewegung), combining gymnastics with fencing. Turnerschaften usually belong to the Coburger Convent (CC)."@en ,
                    "En tradition av Studentenverbindung med rötter i 1800-talets gymnastikrörelse (Turnbewegung), som förenar gymnastik med fäktning. Turnerschaften tillhör oftast Coburger Convent (CC)."@sv ,
                    "Eine Tradition der Studentenverbindung mit Wurzeln in der Turnbewegung des 19. Jahrhunderts, die Turnen mit Fechten verbindet. Turnerschaften gehören meist dem Coburger Convent (CC) an."@de ,
                    "Una tradizione di Studentenverbindung radicata nel movimento ginnico dell'Ottocento (Turnbewegung), che unisce ginnastica e scherma. Le Turnerschaften di solito appartengono al Coburger Convent (CC)."@it ,
                    "Tradition de Studentenverbindung enracinée dans le mouvement gymnique du XIXe siècle (Turnbewegung), qui associe la gymnastique et l'escrime. Les Turnerschaften appartiennent en général au Coburger Convent (CC)."@fr ,
                    "Una tradición de Studentenverbindung con raíces en el movimiento gimnástico del siglo XIX (Turnbewegung), que combina gimnasia y esgrima. Las Turnerschaften suelen pertenecer al Coburger Convent (CC)."@es ,
                    "Uma tradição de Studentenverbindung com raízes no movimento ginástico do século XIX (Turnbewegung), que combina ginástica e esgrima. As Turnerschaften pertencem em regra ao Coburger Convent (CC)."@pt ,
                    "A Studentenverbindung hagyománya a 19. századi tornamozgalomban (Turnbewegung) gyökerezik, a tornát és a vívást ötvözi. A Turnerschaftok rendszerint a Coburger Convenhez (CC) tartoznak."@hu .

fraternalc:saengerschaft a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTypes ; skos:broader fraternalc:studentenverbindung ;
    skos:prefLabel "Sängerschaft"@en , "Sängerschaft"@sv , "Sängerschaft"@de , "Sängerschaft"@it , "Sängerschaft"@fr , "Sängerschaft"@es , "Sängerschaft"@pt , "Sängerschaft"@hu ;
    skos:definition "A tradition of Studentenverbindung built around choral singing and music. Sängerschaften belong to the Deutsche Sängerschaft (DS) and most are schlagend."@en ,
                    "En tradition av Studentenverbindung med kör- och musikutövning som kärna. Sängerschaften tillhör Deutsche Sängerschaft (DS) och de flesta är schlagend."@sv ,
                    "Eine Tradition der Studentenverbindung, die auf Chorgesang und Musik gründet. Sängerschaften gehören der Deutschen Sängerschaft (DS) an und sind meist schlagend."@de ,
                    "Una tradizione di Studentenverbindung costruita intorno al canto corale e alla musica. Le Sängerschaften appartengono alla Deutsche Sängerschaft (DS) e la maggior parte è schlagend."@it ,
                    "Tradition de Studentenverbindung construite autour du chant choral et de la musique. Les Sängerschaften appartiennent à la Deutsche Sängerschaft (DS) et la plupart sont schlagend."@fr ,
                    "Una tradición de Studentenverbindung construida en torno al canto coral y la música. Las Sängerschaften pertenecen a la Deutsche Sängerschaft (DS) y la mayoría son schlagend."@es ,
                    "Uma tradição de Studentenverbindung construída em torno do canto coral e da música. As Sängerschaften pertencem à Deutsche Sängerschaft (DS) e a maioria é schlagend."@pt ,
                    "A Studentenverbindung hagyománya a kórusének és a zene köré épül. A Sängerschaftok a Deutsche Sängerschafthoz (DS) tartoznak, és a legtöbb schlagend."@hu .

fraternalc:catholicStudentenverbindung a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTypes ; skos:broader fraternalc:studentenverbindung ;
    skos:prefLabel "Catholic Studentenverbindung"@en , "Katolsk studentkorporation"@sv , "Katholische Studentenverbindung"@de , "Studentenverbindung cattolica"@it , "Studentenverbindung catholique"@fr , "Studentenverbindung católica"@es , "Studentenverbindung católica"@pt , "Katolikus Studentenverbindung"@hu ;
    skos:altLabel "Katholische Verbindung"@de ;
    skos:definition "A Studentenverbindung founded on the Catholic faith, usually colour-wearing and not schlagend, with principles such as religio, scientia and amicitia (in the CV also patria). Federations include the Cartellverband (CV), the Kartellverband (KV), the Unitas-Verband (UV) and, in Austria, the Österreichischer Cartellverband (ÖCV)."@en ,
                    "En Studentenverbindung grundad på katolsk tro, vanligen med färger och inte schlagend, med principer som religio, scientia och amicitia (i CV även patria). Förbund är bland andra Cartellverband (CV), Kartellverband (KV), Unitas-Verband (UV) och i Österrike Österreichischer Cartellverband (ÖCV)."@sv ,
                    "Eine auf den katholischen Glauben gegründete Studentenverbindung, meist farbentragend und nichtschlagend, mit Prinzipien wie religio, scientia und amicitia (im CV auch patria). Dachverbände sind unter anderem der Cartellverband (CV), der Kartellverband (KV), der Unitas-Verband (UV) und in Österreich der Österreichische Cartellverband (ÖCV)."@de ,
                    "Una Studentenverbindung fondata sulla fede cattolica, di solito con colori portati e non schlagend, con principi come religio, scientia e amicitia (nel CV anche patria). Le federazioni comprendono il Cartellverband (CV), il Kartellverband (KV), l'Unitas-Verband (UV) e, in Austria, l'Österreichischer Cartellverband (ÖCV)."@it ,
                    "Studentenverbindung fondée sur la foi catholique, en général portant les couleurs et non schlagend, avec des principes tels que religio, scientia et amicitia (dans le CV aussi patria). Parmi les fédérations : le Cartellverband (CV), le Kartellverband (KV), l'Unitas-Verband (UV) et, en Autriche, l'Österreichischer Cartellverband (ÖCV)."@fr ,
                    "Una Studentenverbindung fundada sobre la fe católica, normalmente con colores y no schlagend, con principios como religio, scientia y amicitia (en el CV también patria). Las federaciones incluyen el Cartellverband (CV), el Kartellverband (KV), el Unitas-Verband (UV) y, en Austria, el Österreichischer Cartellverband (ÖCV)."@es ,
                    "Uma Studentenverbindung fundada na fé católica, normalmente com cores e não schlagend, com princípios como religio, scientia e amicitia (no CV também patria). As federações incluem o Cartellverband (CV), o Kartellverband (KV), o Unitas-Verband (UV) e, na Áustria, o Österreichischer Cartellverband (ÖCV)."@pt ,
                    "A katolikus hitre alapozott Studentenverbindung, rendszerint színeket viselő és nem schlagend, olyan elvekkel, mint a religio, scientia és amicitia (a CV-ben patria is). A szövetségek közé tartozik a Cartellverband (CV), a Kartellverband (KV), az Unitas-Verband (UV) és Ausztriában az Österreichischer Cartellverband (ÖCV)."@hu .

fraternalc:christianStudentenverbindung a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTypes ; skos:broader fraternalc:studentenverbindung ;
    skos:prefLabel "Protestant Studentenverbindung"@en , "Protestantisk studentkorporation"@sv , "Evangelische Studentenverbindung"@de , "Studentenverbindung protestante"@it , "Studentenverbindung protestante"@fr , "Studentenverbindung protestante"@es , "Studentenverbindung protestante"@pt , "Protestáns Studentenverbindung"@hu ;
    skos:altLabel "Christian Studentenverbindung"@en , "Christliche Studentenverbindung"@de ;
    skos:definition "A Studentenverbindung founded on the Protestant Christian faith, usually colour-wearing and not schlagend. Federations include the Wingolfsbund (Wingolf) and the Schwarzburgbund (SB)."@en ,
                    "En Studentenverbindung grundad på protestantisk kristen tro, vanligen med färger och inte schlagend. Förbund är bland andra Wingolfsbund (Wingolf) och Schwarzburgbund (SB)."@sv ,
                    "Eine auf den evangelischen christlichen Glauben gegründete Studentenverbindung, meist farbentragend und nichtschlagend. Dachverbände sind unter anderem der Wingolfsbund (Wingolf) und der Schwarzburgbund (SB)."@de ,
                    "Una Studentenverbindung fondata sulla fede cristiana protestante, di solito con colori portati e non schlagend. Le federazioni comprendono il Wingolfsbund (Wingolf) e lo Schwarzburgbund (SB)."@it ,
                    "Studentenverbindung fondée sur la foi chrétienne protestante, en général portant les couleurs et non schlagend. Parmi les fédérations : le Wingolfsbund (Wingolf) et le Schwarzburgbund (SB)."@fr ,
                    "Una Studentenverbindung fundada sobre la fe cristiana protestante, normalmente con colores y no schlagend. Las federaciones incluyen el Wingolfsbund (Wingolf) y el Schwarzburgbund (SB)."@es ,
                    "Uma Studentenverbindung fundada na fé cristã protestante, normalmente com cores e não schlagend. As federações incluem o Wingolfsbund (Wingolf) e o Schwarzburgbund (SB)."@pt ,
                    "A protestáns keresztény hitre alapozott Studentenverbindung, rendszerint színeket viselő és nem schlagend. A szövetségek közé tartozik a Wingolfsbund (Wingolf) és a Schwarzburgbund (SB)."@hu .

fraternalc:turnverbindung a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTypes ; skos:broader fraternalc:studentenverbindung ;
    skos:prefLabel "Akademische Turnverbindung"@en , "Akademisk Turnverbindung"@sv , "Akademische Turnverbindung"@de , "Akademische Turnverbindung"@it , "Akademische Turnverbindung"@fr , "Akademische Turnverbindung"@es , "Akademische Turnverbindung"@pt , "Akademische Turnverbindung"@hu ;
    skos:altLabel "ATV"@de ;
    skos:definition "A Studentenverbindung in the gymnastics tradition that practises gymnastics and sport. Akademische Turnverbindungen belong to the Akademischer Turnbund (ATB)."@en ,
                    "En Studentenverbindung i gymnastiktraditionen som utövar gymnastik och idrott. Akademische Turnverbindungen tillhör Akademischer Turnbund (ATB)."@sv ,
                    "Eine Studentenverbindung in der Turntradition, die Turnen und Sport betreibt. Akademische Turnverbindungen gehören dem Akademischen Turnbund (ATB) an."@de ,
                    "Una Studentenverbindung nella tradizione ginnica che pratica ginnastica e sport. Le Akademische Turnverbindungen appartengono all'Akademischer Turnbund (ATB)."@it ,
                    "Studentenverbindung de tradition gymnique qui pratique la gymnastique et le sport. Les Akademische Turnverbindungen appartiennent à l'Akademischer Turnbund (ATB)."@fr ,
                    "Una Studentenverbindung de tradición gimnástica que practica la gimnasia y el deporte. Las Akademische Turnverbindungen pertenecen al Akademischer Turnbund (ATB)."@es ,
                    "Uma Studentenverbindung de tradição ginástica que pratica ginástica e desporto. As Akademische Turnverbindungen pertencem ao Akademischer Turnbund (ATB)."@pt ,
                    "Tornahagyományú Studentenverbindung, amely tornát és sportot űz. Az Akademische Turnverbindungek az Akademischer Turnbundhoz (ATB) tartoznak."@hu .

fraternalc:wissenschaftlicheVerbindung a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTypes ; skos:broader fraternalc:studentenverbindung ;
    skos:prefLabel "Scientific Studentenverbindung"@en , "Vetenskaplig studentkorporation"@sv , "Wissenschaftliche Verbindung"@de , "Studentenverbindung scientifica"@it , "Studentenverbindung scientifique"@fr , "Studentenverbindung científica"@es , "Studentenverbindung científica"@pt , "Tudományos Studentenverbindung"@hu ;
    skos:altLabel "Fachverbindung"@de ;
    skos:definition "A Studentenverbindung whose members belong to one academic field or profession, for example chemistry, engineering or forestry."@en ,
                    "En Studentenverbindung vars medlemmar tillhör ett vetenskapsområde eller ett yrke, till exempel kemi, teknik eller skogsbruk."@sv ,
                    "Eine Studentenverbindung, deren Mitglieder einem Fachgebiet oder Beruf angehören, zum Beispiel Chemie, Technik oder Forstwesen."@de ,
                    "Una Studentenverbindung i cui soci appartengono a un solo campo accademico o professione, per esempio chimica, ingegneria o scienze forestali."@it ,
                    "Studentenverbindung dont les membres relèvent d'une même discipline universitaire ou d'une même profession, par exemple la chimie, l'ingénierie ou les sciences forestières."@fr ,
                    "Una Studentenverbindung cuyos miembros pertenecen a un campo académico o a una profesión, por ejemplo química, ingeniería o ciencias forestales."@es ,
                    "Uma Studentenverbindung cujos membros pertencem a um campo académico ou a uma profissão, por exemplo química, engenharia ou ciências florestais."@pt ,
                    "Studentenverbindung, amelynek tagjai egy tudományterülethez vagy szakmához tartoznak, például kémiához, mérnöki tudományhoz vagy erdészethez."@hu .

fraternalc:damenverbindung a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTypes ; skos:broader fraternalc:studentenverbindung ;
    skos:prefLabel "Damenverbindung"@en , "Damverbindung"@sv , "Damenverbindung"@de , "Damenverbindung"@it , "Damenverbindung"@fr , "Damenverbindung"@es , "Damenverbindung"@pt , "Damenverbindung"@hu ;
    skos:altLabel "Women's Studentenverbindung"@en , "Studentinnenverbindung"@de ;
    skos:definition "A Studentenverbindung whose members are women students, formed on the model of the men's Verbindungen since the early 20th century."@en ,
                    "En Studentenverbindung vars medlemmar är kvinnliga studenter, bildad efter förebild från männens Verbindungen sedan tidigt 1900-tal."@sv ,
                    "Eine Studentenverbindung, deren Mitglieder Studentinnen sind, nach dem Vorbild der Männerverbindungen seit dem frühen 20. Jahrhundert gebildet."@de ,
                    "Una Studentenverbindung i cui soci sono studentesse, formata sul modello delle Verbindungen maschili dall'inizio del Novecento."@it ,
                    "Studentenverbindung dont les membres sont des étudiantes, formée depuis le début du XXe siècle sur le modèle des Verbindungen masculines."@fr ,
                    "Una Studentenverbindung cuyos miembros son estudiantes mujeres, formada desde principios del siglo XX según el modelo de las Verbindungen masculinas."@es ,
                    "Uma Studentenverbindung cujos membros são estudantes do sexo feminino, formada desde o início do século XX segundo o modelo das Verbindungen masculinas."@pt ,
                    "Studentenverbindung, amelynek tagjai női hallgatók, a férfi Verbindungek mintájára a 20. század elejétől alakult."@hu .

fraternalc:schuelerverbindung a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTypes ; skos:broader fraternalc:studentenverbindung ;
    skos:prefLabel "Schülerverbindung"@en , "Gymnasistkorporation"@sv , "Schülerverbindung"@de , "Schülerverbindung"@it , "Schülerverbindung"@fr , "Schülerverbindung"@es , "Schülerverbindung"@pt , "Schülerverbindung"@hu ;
    skos:altLabel "Pennalie"@de , "Mittelschülerverbindung"@de ;
    skos:definition "A Verbindung of secondary-school pupils, modelled on the Studentenverbindungen and with its own federations, for example the Mittelschüler-Kartell-Verband (MKV) in Austria."@en ,
                    "En Verbindung för gymnasieelever, utformad efter Studentenverbindungen och med egna förbund, till exempel Mittelschüler-Kartell-Verband (MKV) i Österrike."@sv ,
                    "Eine Verbindung von Schülern höherer Schulen nach dem Vorbild der Studentenverbindungen, mit eigenen Dachverbänden, etwa dem Mittelschüler-Kartell-Verband (MKV) in Österreich."@de ,
                    "Una Verbindung di alunni delle scuole secondarie, modellata sulle Studentenverbindungen e con federazioni proprie, per esempio il Mittelschüler-Kartell-Verband (MKV) in Austria."@it ,
                    "Verbindung d'élèves de l'enseignement secondaire, calquée sur les Studentenverbindungen et dotée de fédérations propres, par exemple le Mittelschüler-Kartell-Verband (MKV) en Autriche."@fr ,
                    "Una Verbindung de alumnos de enseñanza secundaria, modelada sobre las Studentenverbindungen y con sus propias federaciones, por ejemplo el Mittelschüler-Kartell-Verband (MKV) en Austria."@es ,
                    "Uma Verbindung de alunos do ensino secundário, modelada sobre as Studentenverbindungen e com as suas próprias federações, por exemplo o Mittelschüler-Kartell-Verband (MKV) na Áustria."@pt ,
                    "Középiskolások Verbindungja, a Studentenverbindungek mintájára, saját szövetségekkel, például az Mittelschüler-Kartell-Verband (MKV) Ausztriában."@hu .

fraternalc:studentenverbindungDachverband a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTypes ; skos:topConceptOf fraternalc:StudentenverbindungTypes ;
    skos:prefLabel "Federation of Studentenverbindungen"@en , "Förbund av studentkorporationer"@sv , "Dachverband von Studentenverbindungen"@de , "Federazione di Studentenverbindungen"@it , "Fédération de Studentenverbindungen"@fr , "Federación de Studentenverbindungen"@es , "Federação de Studentenverbindungen"@pt , "Studentenverbindungek szövetsége"@hu ;
    skos:altLabel "Verband"@de ;
    skos:definition "An umbrella federation of Studentenverbindungen of one tradition, such as the Kösener Senioren-Convents-Verband for Corps, the Deutsche Burschenschaft or the Cartellverband for Catholic Verbindungen. The member Verbindungen stay independent."@en ,
                    "Ett paraplyförbund för Studentenverbindungen av en tradition, till exempel Kösener Senioren-Convents-Verband för Corps, Deutsche Burschenschaft eller Cartellverband för katolska Verbindungen. Medlemsförbindelserna förblir självständiga."@sv ,
                    "Ein Zusammenschluss von Studentenverbindungen einer Tradition, etwa der Kösener Senioren-Convents-Verband für Corps, die Deutsche Burschenschaft oder der Cartellverband für katholische Verbindungen. Die Mitgliedsverbindungen bleiben selbstständig."@de ,
                    "Una federazione ombrello di Studentenverbindungen di una tradizione, come il Kösener Senioren-Convents-Verband per i Corps, la Deutsche Burschenschaft o il Cartellverband per le Verbindungen cattoliche. Le Verbindungen che ne fanno parte restano indipendenti."@it ,
                    "Fédération faîtière de Studentenverbindungen d'une même tradition, comme le Kösener Senioren-Convents-Verband pour les Corps, la Deutsche Burschenschaft ou le Cartellverband pour les Verbindungen catholiques. Les Verbindungen membres restent indépendantes."@fr ,
                    "Una federación paraguas de Studentenverbindungen de una misma tradición, como el Kösener Senioren-Convents-Verband para los Corps, la Deutsche Burschenschaft o el Cartellverband para las Verbindungen católicas. Las Verbindungen miembros siguen siendo independientes."@es ,
                    "Uma federação-chapéu de Studentenverbindungen de uma mesma tradição, como o Kösener Senioren-Convents-Verband para os Corps, a Deutsche Burschenschaft ou o Cartellverband para as Verbindungen católicas. As Verbindungen membros continuam independentes."@pt ,
                    "Egy hagyományhoz tartozó Studentenverbindungek ernyőszövetsége, mint a Kösener Senioren-Convents-Verband a Corpsok számára, a Deutsche Burschenschaft vagy a Cartellverband a katolikus Verbindungek számára. A tag Verbindungek függetlenek maradnak."@hu .

##############################################################################
# 2. GENERIC DEGREE LADDERS  (hubs; also usable directly as degree systems)
##############################################################################

fraternalc:CraftDegrees a skos:ConceptScheme , fraternal:DegreeSystem , owl:NamedIndividual ;
    skos:prefLabel "Generic Craft-style Degrees"@en , "Generiska grader i hantverksstil"@sv , "Degrés génériques de style artisanal"@fr , "Allgemeine Grade im Stil der Handwerkslogen"@de , "Gradi generici in stile artigiano"@it , "Grados genéricos de estilo gremial"@es , "Graus genéricos de estilo corporativo"@pt , "Általános mesterségi stílusú fokozatok"@hu ;
    skos:definition "A generic ladder of degrees in the style of craft lodges: entry, intermediate, full, higher."@en ,
                    "En generisk gradstege i hantverkslogernas stil: inträde, mellangrad, fullgrad, högre grad."@sv ,
                    "Échelle générique de degrés dans le style des loges artisanales : entrée, intermédiaire, plein, supérieur."@fr ,
                    "Eine allgemeine Stufenfolge von Graden im Stil der Handwerkslogen: Eingangs-, Mittel-, Voll- und höherer Grad."@de ,
                    "Una scala generica di gradi nello stile delle logge artigiane: ingresso, intermedio, pieno, superiore."@it ,
                    "Una escala genérica de grados al estilo de las logias de oficio: de entrada, intermedio, pleno, superior."@es ,
                    "Uma escala genérica de graus ao estilo das lojas de ofício: de entrada, intermédio, pleno, superior."@pt ,
                    "A fokozatok általános létrája a mesterségi páholyok mintájára: belépő, közbülső, teljes, magasabb."@hu ;
    skos:hasTopConcept fraternalc:entryDegree , fraternalc:intermediateDegree , fraternalc:fullDegree , fraternalc:higherDegree .

fraternalc:entryDegree a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CraftDegrees ; skos:topConceptOf fraternalc:CraftDegrees ;
    fraternal:degreeRank 1 ; fraternal:nextDegree fraternalc:intermediateDegree ;
    skos:prefLabel "Entry Degree"@en , "Inträdesgrad"@sv , "Degré d'entrée"@fr , "Eingangsgrad"@de , "Grado d'ingresso"@it , "Grado de entrada"@es , "Grau de entrada"@pt , "Belépő fokozat"@hu ;
    skos:altLabel "Apprentice"@en , "Lärling"@sv , "Apprenti"@fr , "Apprendista"@it ;
    skos:definition "The first degree, conferred at initiation."@en , "Den första graden, som tilldelas vid initieringen."@sv , "Le premier degré, conféré lors de l'initiation."@fr , "Der erste Grad, bei der Initiation verliehen."@de , "Il primo grado, conferito all'iniziazione."@it , "El primer grado, conferido en la iniciación."@es , "O primeiro grau, conferido na iniciação."@pt , "Az első fokozat, amelyet a beavatáskor adnak."@hu .

fraternalc:intermediateDegree a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CraftDegrees ; skos:topConceptOf fraternalc:CraftDegrees ;
    fraternal:degreeRank 2 ; fraternal:nextDegree fraternalc:fullDegree ;
    skos:prefLabel "Intermediate Degree"@en , "Mellangrad"@sv , "Degré intermédiaire"@fr , "Mittelgrad"@de , "Grado intermedio"@it , "Grado intermedio"@es , "Grau intermédio"@pt , "Közbülső fokozat"@hu ;
    skos:altLabel "Fellow"@en , "Gesäll"@sv , "Compagnon"@fr , "Compagno"@it , "Compagno d'arte"@it ;
    skos:definition "A degree between entry and full membership."@en , "En grad mellan inträde och fullt medlemskap."@sv , "Degré entre l'entrée et le plein statut de membre."@fr , "Ein Grad zwischen Eintritt und Vollmitgliedschaft."@de , "Un grado tra l'ingresso e la piena appartenenza."@it , "Un grado entre la entrada y la pertenencia plena."@es , "Um grau entre a entrada e a filiação plena."@pt , "A belépés és a teljes tagság közötti fokozat."@hu ;
    skos:scopeNote "In freemasonry the fellow (compagnon) is the second degree. In French compagnonnage the compagnon is instead the full status reached after the masterpiece; map that to fraternalc:fullDegree."@en ,
                   "I frimureriet är gesällen (compagnon) den andra graden. I det franska compagnonnage är compagnon i stället den fulla ställning man når efter mästerstycket; koppla den till fraternalc:fullDegree."@sv ,
                   "En franc-maçonnerie, le compagnon est le deuxième degré. Dans le compagnonnage français, le compagnon est au contraire le plein statut atteint après le chef-d'œuvre ; l'associer à fraternalc:fullDegree."@fr ,
                   "In der Freimaurerei ist der Geselle (compagnon) der zweite Grad. Im französischen Compagnonnage ist der Compagnon dagegen der volle Status, der nach dem Meisterstück erreicht wird; das ist auf fraternalc:fullDegree abzubilden."@de ,
                   "In massoneria il compagno (compagno d'arte) è il secondo grado. Nel compagnonnage francese il compagnon è invece lo stato pieno raggiunto dopo il capolavoro; lo si associa a fraternalc:fullDegree."@it ,
                   "En la masonería el compañero (compagnon) es el segundo grado. En el compagnonnage francés el compagnon es, en cambio, la condición plena que se alcanza tras la obra maestra; esa se asocia a fraternalc:fullDegree."@es ,
                   "Na maçonaria o companheiro (compagnon) é o segundo grau. No compagnonnage francês o compagnon é, pelo contrário, a condição plena que se alcança após a obra-prima; essa associa-se a fraternalc:fullDegree."@pt ,
                   "A szabadkőművességben a legény (compagnon) a második fokozat. A francia compagnonnage-ban a compagnon ezzel szemben a remekmű után elért teljes státusz; azt a fraternalc:fullDegree-hez kell rendelni."@hu .

fraternalc:fullDegree a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CraftDegrees ; skos:topConceptOf fraternalc:CraftDegrees ;
    fraternal:degreeRank 3 ; fraternal:nextDegree fraternalc:higherDegree ;
    skos:prefLabel "Full Degree"@en , "Fullgrad"@sv , "Degré plein"@fr , "Vollgrad"@de , "Grado pieno"@it , "Grado pleno"@es , "Grau pleno"@pt , "Teljes fokozat"@hu ;
    skos:altLabel "Master"@en , "Mästare"@sv , "Maître"@fr , "Maestro"@it ;
    skos:definition "The degree that gives full membership."@en , "Den grad som ger fullt medlemskap."@sv , "Le degré qui donne le plein statut de membre."@fr , "Der Grad, der die Vollmitgliedschaft gibt."@de , "Il grado che dà la piena appartenenza."@it , "El grado que da la pertenencia plena."@es , "O grau que dá a filiação plena."@pt , "A fokozat, amely teljes tagságot ad."@hu .

fraternalc:higherDegree a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CraftDegrees ; skos:topConceptOf fraternalc:CraftDegrees ;
    fraternal:degreeRank 4 ;
    skos:prefLabel "Higher Degree"@en , "Högre grad"@sv , "Degré supérieur"@fr , "Höherer Grad"@de , "Grado superiore"@it , "Grado superior"@es , "Grau superior"@pt , "Magasabb fokozat"@hu ;
    skos:definition "Any degree above full membership."@en , "Varje grad över fullt medlemskap."@sv , "Tout degré au-dessus du plein statut de membre."@fr , "Jeder Grad über der Vollmitgliedschaft."@de , "Qualsiasi grado al di sopra della piena appartenenza."@it , "Cualquier grado por encima de la pertenencia plena."@es , "Qualquer grau acima da filiação plena."@pt , "Bármely fokozat a teljes tagság felett."@hu ;
    skos:scopeNote "A side degree outside the numbered sequence is not a higher degree; give it fraternalc:sideDegree as its fraternal:degreeKind."@en ,
                   "En tilläggsgrad utanför den numrerade följden är ingen högre grad; ange fraternalc:sideDegree som dess fraternal:degreeKind."@sv ,
                   "Un degré annexe hors de la suite numérotée n'est pas un degré supérieur ; lui attribuer fraternalc:sideDegree comme fraternal:degreeKind."@fr ,
                   "Ein Nebengrad außerhalb der nummerierten Folge ist kein höherer Grad; ihm fraternalc:sideDegree als fraternal:degreeKind geben."@de ,
                   "Un grado laterale fuori dalla sequenza numerata non è un grado superiore; gli si dà fraternalc:sideDegree come fraternal:degreeKind."@it ,
                   "Un grado lateral fuera de la secuencia numerada no es un grado superior; se le da fraternalc:sideDegree como fraternal:degreeKind."@es ,
                   "Um grau lateral fora da sequência numerada não é um grau superior; dá-se-lhe fraternalc:sideDegree como fraternal:degreeKind."@pt ,
                   "A számozott sorrenden kívüli mellék-fokozat nem magasabb fokozat; a fraternalc:sideDegree-t kell megadni fraternal:degreeKind-ként."@hu .

fraternalc:ChivalricGrades a skos:ConceptScheme , fraternal:DegreeSystem , owl:NamedIndividual ;
    skos:prefLabel "Generic Chivalric-style Grades"@en , "Generiska grader i riddarordensstil"@sv , "Grades génériques de style chevaleresque"@fr , "Allgemeine Stufen im Stil der Ritterorden"@de , "Gradi generici in stile cavalleresco"@it , "Grados genéricos de estilo caballeresco"@es , "Graus genéricos de estilo cavaleiresco"@pt , "Általános lovagrendi stílusú fokozatok"@hu ;
    skos:definition "A generic ladder of grades in the style of orders of chivalry."@en ,
                    "En generisk gradstege i riddarordnarnas stil."@sv ,
                    "Échelle générique de grades dans le style des ordres de chevalerie."@fr ,
                    "Eine allgemeine Stufenfolge von Graden im Stil der Ritterorden."@de ,
                    "Una scala generica di gradi nello stile degli ordini cavallereschi."@it ,
                    "Una escala genérica de grados al estilo de las órdenes de caballería."@es ,
                    "Uma escala genérica de graus ao estilo das ordens de cavalaria."@pt ,
                    "A fokozatok általános létrája a lovagrendek mintájára."@hu ;
    skos:hasTopConcept fraternalc:memberGrade , fraternalc:knightGrade , fraternalc:officerGrade ,
                       fraternalc:commanderGrade , fraternalc:commanderFirstClassGrade , fraternalc:grandCrossGrade ,
                       fraternalc:collarGrade .

fraternalc:memberGrade a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:ChivalricGrades ; skos:topConceptOf fraternalc:ChivalricGrades ;
    fraternal:degreeRank 1 ; fraternal:nextDegree fraternalc:knightGrade ;
    skos:prefLabel "Member Grade"@en , "Ledamot"@sv , "Membre (grade)"@fr , "Mitglied (Stufe)"@de , "Membro (grado)"@it , "Grado de miembro"@es , "Grau de membro"@pt , "Tagi fokozat"@hu ;
    skos:definition "The lowest grade of an order."@en , "En ordens lägsta grad."@sv , "Le grade le plus bas d'un ordre."@fr , "Die niedrigste Stufe eines Ordens."@de , "Il grado più basso di un ordine."@it , "El grado más bajo de una orden."@es , "O grau mais baixo de uma ordem."@pt , "Egy rend legalacsonyabb fokozata."@hu ;
    skos:scopeNote "In older Swedish order nomenclature \"ledamot\" (abbreviated L) also denoted the women's counterpart of a knight; here it means the entry grade."@en ,
                   "I äldre svensk ordensterminologi betecknade \"ledamot\" (förkortat L) även kvinnors motsvarighet till riddare; här avses inträdesgraden."@sv ,
                   "Dans l'ancienne nomenclature suédoise des ordres, « ledamot » (abrégé L) désignait aussi l'équivalent féminin du chevalier ; ici il désigne le grade d'entrée."@fr ,
                   "In der älteren schwedischen Ordensterminologie bezeichnete „ledamot“ (abgekürzt L) auch das weibliche Gegenstück eines Ritters; hier bedeutet es die Eingangsstufe."@de ,
                   "Nella più antica nomenclatura svedese degli ordini «ledamot» (abbreviato L) indicava anche la controparte femminile di un cavaliere; qui significa il grado d'ingresso."@it ,
                   "En la nomenclatura sueca antigua de las órdenes, «ledamot» (abreviado L) designaba también a la contrapartida femenina de un caballero; aquí significa el grado de entrada."@es ,
                   "Na nomenclatura sueca antiga das ordens, «ledamot» (abreviado L) designava também a contrapartida feminina de um cavaleiro; aqui significa o grau de entrada."@pt ,
                   "A régi svéd rendi nómenklatúrában a „ledamot” (rövidítve L) a lovag női megfelelőjét is jelölte; itt a belépő fokozatot jelenti."@hu .

fraternalc:knightGrade a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:ChivalricGrades ; skos:topConceptOf fraternalc:ChivalricGrades ;
    fraternal:degreeRank 2 ; fraternal:nextDegree fraternalc:officerGrade ;
    skos:prefLabel "Knight"@en , "Riddare"@sv , "Chevalier"@fr , "Ritter"@de , "Cavaliere"@it , "Caballero"@es , "Cavaleiro"@pt , "Lovag"@hu ;
    skos:definition "The knight grade of an order."@en , "En ordens riddargrad."@sv , "Le grade de chevalier d'un ordre."@fr , "Die Ritterstufe eines Ordens."@de , "Il grado di cavaliere di un ordine."@it , "El grado de caballero de una orden."@es , "O grau de cavaleiro de uma ordem."@pt , "Egy rend lovagi fokozata."@hu .

fraternalc:officerGrade a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:ChivalricGrades ; skos:topConceptOf fraternalc:ChivalricGrades ;
    fraternal:degreeRank 3 ; fraternal:nextDegree fraternalc:commanderGrade ;
    skos:prefLabel "Officer"@en , "Officer"@sv , "Officier"@fr , "Offizier"@de , "Ufficiale"@it , "Oficial"@es , "Oficial"@pt , "Tiszt"@hu ;
    skos:altLabel "Knight First Class"@en , "Riddare av första klassen"@sv ;
    skos:definition "The grade between knight and commander."@en , "Graden mellan riddare och kommendör."@sv , "Le grade entre chevalier et commandeur."@fr , "Die Stufe zwischen Ritter und Kommandeur."@de , "Il grado tra cavaliere e commendatore."@it , "El grado entre caballero y comendador."@es , "O grau entre cavaleiro e comendador."@pt , "A lovag és a parancsnok közötti fokozat."@hu .

fraternalc:commanderGrade a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:ChivalricGrades ; skos:topConceptOf fraternalc:ChivalricGrades ;
    fraternal:degreeRank 4 ; fraternal:nextDegree fraternalc:commanderFirstClassGrade ;
    skos:prefLabel "Commander"@en , "Kommendör"@sv , "Commandeur"@fr , "Kommandeur"@de , "Commendatore"@it , "Comendador"@es , "Comendador"@pt , "Parancsnok"@hu ;
    skos:definition "The commander grade of an order."@en , "En ordens kommendörsgrad."@sv , "Le grade de commandeur d'un ordre."@fr , "Die Kommandeursstufe eines Ordens."@de , "Il grado di commendatore di un ordine."@it , "El grado de comendador de una orden."@es , "O grau de comendador de uma ordem."@pt , "Egy rend parancsnoki fokozata."@hu .

fraternalc:commanderFirstClassGrade a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:ChivalricGrades ; skos:topConceptOf fraternalc:ChivalricGrades ;
    fraternal:degreeRank 5 ; fraternal:nextDegree fraternalc:grandCrossGrade ;
    skos:prefLabel "Commander First Class"@en , "Kommendör av första klassen"@sv , "Commandeur de première classe"@fr , "Kommandeur 1. Klasse"@de , "Commendatore di prima classe"@it , "Comendador de primera clase"@es , "Comendador de primeira classe"@pt , "Elsőosztályú parancsnok"@hu ;
    skos:altLabel "Grand Officer"@en , "Grand officier"@fr , "Grande Ufficiale"@it ;
    skos:definition "The grade between commander and grand cross."@en , "Graden mellan kommendör och storkors."@sv , "Le grade entre commandeur et grand-croix."@fr , "Die Stufe zwischen Kommandeur und Großkreuz."@de , "Il grado tra commendatore e gran croce."@it , "El grado entre comendador y gran cruz."@es , "O grau entre comendador e grã-cruz."@pt , "A parancsnok és a nagykereszt közötti fokozat."@hu .

fraternalc:grandCrossGrade a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:ChivalricGrades ; skos:topConceptOf fraternalc:ChivalricGrades ;
    fraternal:degreeRank 6 ; fraternal:nextDegree fraternalc:collarGrade ;
    skos:prefLabel "Grand Cross"@en , "Storkors"@sv , "Grand-croix"@fr , "Großkreuz"@de , "Gran croce"@it , "Gran Cruz"@es , "Grã-Cruz"@pt , "Nagykereszt"@hu ;
    skos:altLabel "Kommendör med stora korset"@sv , "Kommendör med storkors"@sv , "Stora korset"@sv , "Grand'croix"@fr , "Cavaliere di Gran Croce"@it ;
    skos:definition "The highest regular grade of an order; in some orders a collar stands above it."@en , "En ordens högsta ordinarie grad; i vissa ordnar står en ordenskedja över den."@sv , "Le grade ordinaire le plus élevé d'un ordre ; dans certains ordres, un collier se place au-dessus."@fr , "Die höchste reguläre Stufe eines Ordens; in manchen Orden steht eine Kollane darüber."@de , "Il grado ordinario più alto di un ordine; in alcuni ordini un collare sta sopra di esso."@it , "El grado regular más alto de una orden; en algunas órdenes hay un collar por encima."@es , "O grau regular mais alto de uma ordem; em algumas ordens há um colar acima dele."@pt , "Egy rend legmagasabb rendes fokozata; néhány rendben fölötte lánc áll."@hu .

fraternalc:collarGrade a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:ChivalricGrades ; skos:topConceptOf fraternalc:ChivalricGrades ;
    fraternal:degreeRank 7 ;
    skos:prefLabel "Grand Collar"@en , "Ordenskedja (grad)"@sv , "Grand collier"@fr , "Kollane (Stufe)"@de , "Gran collare"@it , "Gran Collar"@es , "Grande-Colar"@pt , "Nagylánc"@hu ;
    skos:altLabel "Collar"@en ;
    skos:definition "The grade above the grand cross in some orders, whose insignia is a collar; usually reserved for heads of state and a few others."@en ,
                    "Graden över storkorset i vissa ordnar, vars insignier är en ordenskedja; vanligen förbehållen statsöverhuvuden och ett fåtal andra."@sv ,
                    "Le grade au-dessus de la grand-croix dans certains ordres, dont l'insigne est un collier ; en général réservé aux chefs d'État et à quelques autres."@fr ,
                    "Die Stufe über dem Großkreuz in manchen Orden, deren Insigne eine Kollane ist; meist Staatsoberhäuptern und wenigen anderen vorbehalten."@de ,
                    "Il grado sopra la gran croce in alcuni ordini, la cui insegna è un collare; di solito riservato ai capi di Stato e a pochi altri."@it ,
                    "El grado por encima de la gran cruz en algunas órdenes, cuya insignia es un collar; normalmente reservado a jefes de Estado y a unos pocos más."@es ,
                    "O grau acima da grã-cruz em algumas ordens, cuja insígnia é um colar; normalmente reservado a chefes de Estado e a poucos mais."@pt ,
                    "A nagykereszt feletti fokozat néhány rendben, amelynek jelvénye lánc; rendszerint államfőknek és néhány másiknak van fenntartva."@hu .

fraternalc:MemberStages a skos:ConceptScheme , fraternal:DegreeSystem , owl:NamedIndividual ;
    skos:prefLabel "Generic Stages of Membership"@en , "Generiska medlemsstadier"@sv , "Étapes génériques de l'appartenance"@fr , "Allgemeine Mitgliedschaftsstufen"@de , "Fasi generiche dell'appartenenza"@it , "Etapas genéricas de la pertenencia"@es , "Etapas genéricas da filiação"@pt , "A tagság általános szakaszai"@hu ;
    skos:definition "A generic ladder of three stages through which a member of a student society or a similar body passes: novice, active member, alumnus. The stages of a tradition (Fuchs, Bursch and Alter Herr; novato, tuno and veterano) are placed under these in the mappings."@en ,
                    "En generisk stege av tre stadier som en medlem i ett studentsällskap eller liknande organ genomgår: novis, aktiv medlem, alumn. En traditions egna stadier (Fuchs, Bursch och Alter Herr; novato, tuno och veterano) placeras under dessa i mappningarna."@sv ,
                    "Échelle générique de trois étapes que traverse un membre d'une société étudiante ou d'un organe semblable : novice, membre actif, ancien. Les étapes d'une tradition (Fuchs, Bursch et Alter Herr ; novato, tuno et veterano) sont placées sous celles-ci dans les mappings."@fr ,
                    "Eine allgemeine Folge von drei Stufen, die ein Mitglied einer studentischen Gesellschaft oder einer ähnlichen Einrichtung durchläuft: Neuling, aktives Mitglied, Ehemaliger. Die Stufen einer Tradition (Fuchs, Bursch und Alter Herr; novato, tuno und veterano) sind in den Mappings diesen zugeordnet."@de ,
                    "Una scala generica di tre fasi che un socio di una società studentesca o di un organismo simile percorre: novizio, socio attivo, ex socio. Le fasi di una tradizione (Fuchs, Bursch e Alter Herr; novato, tuno e veterano) sono collocate sotto queste nei mapping."@it ,
                    "Una escala genérica de tres etapas por las que pasa un miembro de una sociedad estudiantil o de un organismo similar: novicio, miembro activo, antiguo miembro. Las etapas de una tradición (Fuchs, Bursch y Alter Herr; novato, tuno y veterano) se colocan bajo estas en las correspondencias."@es ,
                    "Uma escala genérica de três etapas por que passa um membro de uma sociedade estudantil ou de um organismo semelhante: noviço, membro ativo, antigo membro. As etapas de uma tradição (Fuchs, Bursch e Alter Herr; novato, tuno e veterano) colocam-se sob estas nas correspondências."@pt ,
                    "Három szakasz általános létrája, amelyen egy diáktársaság vagy hasonló testület tagja átmegy: újonc, aktív tag, volt tag. Egy hagyomány szakaszai (Fuchs, Bursch és Alter Herr; novato, tuno és veterano) a megfeleltetésekben ezek alá kerülnek."@hu ;
    skos:hasTopConcept fraternalc:noviceStage , fraternalc:activeStage , fraternalc:alumniStage .

fraternalc:noviceStage a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MemberStages ; skos:topConceptOf fraternalc:MemberStages ;
    fraternal:degreeRank 1 ; fraternal:nextDegree fraternalc:activeStage ;
    skos:prefLabel "Novice Stage"@en , "Novisstadiet"@sv , "Étape de novice"@fr , "Neulingsstufe"@de , "Stadio di novizio"@it , "Etapa de novicio"@es , "Etapa de noviço"@pt , "Újonc szakasz"@hu ;
    skos:definition "The first stage of membership, in which a new member is on probation and learns the customs of the society before being admitted in full."@en ,
                    "Medlemskapets första stadium, då en ny medlem är på prov och lär sig sällskapets sedvänjor innan medlemmen tas upp fullt ut."@sv ,
                    "La première étape de l'appartenance, où un nouveau membre est à l'essai et apprend les usages de la société avant d'être admis pleinement."@fr ,
                    "Die erste Stufe der Mitgliedschaft, in der ein neues Mitglied auf Probe ist und die Bräuche der Gesellschaft lernt, bevor es voll aufgenommen wird."@de ,
                    "La prima fase dell'appartenenza, in cui un nuovo socio è in prova e impara gli usi della società prima di essere ammesso a pieno titolo."@it ,
                    "La primera etapa de la pertenencia, en la que un nuevo miembro está a prueba y aprende las costumbres de la sociedad antes de ser admitido plenamente."@es ,
                    "A primeira etapa da filiação, em que um novo membro está em prova e aprende os costumes da sociedade antes de ser plenamente admitido."@pt ,
                    "A tagság első szakasza, amelyben az új tag próbaidőn van, és megtanulja a társaság szokásait, mielőtt teljes jogúként felvennék."@hu .

fraternalc:activeStage a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MemberStages ; skos:topConceptOf fraternalc:MemberStages ;
    fraternal:degreeRank 2 ; fraternal:nextDegree fraternalc:alumniStage ;
    skos:prefLabel "Active Stage"@en , "Aktiva stadiet"@sv , "Étape active"@fr , "Aktivenstufe"@de , "Stadio attivo"@it , "Etapa activa"@es , "Etapa ativa"@pt , "Aktív szakasz"@hu ;
    skos:definition "The stage in which a member takes full part in the life of the society, shares its duties and holds its offices."@en ,
                    "Stadiet då en medlem deltar fullt ut i sällskapets liv, delar dess plikter och innehar dess ämbeten."@sv ,
                    "L'étape où un membre prend pleinement part à la vie de la société, en partage les devoirs et en occupe les fonctions."@fr ,
                    "Die Stufe, in der ein Mitglied voll am Leben der Gesellschaft teilnimmt, ihre Pflichten teilt und ihre Ämter innehat."@de ,
                    "La fase in cui un socio partecipa pienamente alla vita della società, ne condivide i doveri e ne ricopre le cariche."@it ,
                    "La etapa en la que un miembro participa plenamente en la vida de la sociedad, comparte sus deberes y ocupa sus cargos."@es ,
                    "A etapa em que um membro participa plenamente na vida da sociedade, partilha os seus deveres e ocupa os seus cargos."@pt ,
                    "A szakasz, amelyben a tag teljesen részt vesz a társaság életében, osztozik a kötelességeiben és betölti a tisztségeit."@hu .

fraternalc:alumniStage a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MemberStages ; skos:topConceptOf fraternalc:MemberStages ;
    fraternal:degreeRank 3 ;
    skos:prefLabel "Alumni Stage"@en , "Alumnstadiet"@sv , "Étape d'ancien"@fr , "Stufe der Ehemaligen"@de , "Stadio degli ex soci"@it , "Etapa de antiguo miembro"@es , "Etapa de antigo membro"@pt , "Volt tagi szakasz"@hu ;
    skos:definition "The stage that follows the active one, for members who have left the active life, often after their studies, but remain members for life."@en ,
                    "Stadiet efter det aktiva, för medlemmar som lämnat det aktiva livet, ofta efter sina studier, men förblir medlemmar för livet."@sv ,
                    "L'étape qui suit l'étape active, pour les membres qui ont quitté la vie active, souvent après leurs études, mais restent membres à vie."@fr ,
                    "Die Stufe nach der aktiven, für Mitglieder, die das aktive Leben verlassen haben, oft nach dem Studium, aber lebenslang Mitglieder bleiben."@de ,
                    "La fase che segue quella attiva, per i soci che hanno lasciato la vita attiva, spesso dopo gli studi, ma restano soci a vita."@it ,
                    "La etapa que sigue a la activa, para miembros que han dejado la vida activa, a menudo tras sus estudios, pero siguen siendo miembros de por vida."@es ,
                    "A etapa que se segue à ativa, para membros que deixaram a vida ativa, muitas vezes depois dos estudos, mas continuam a ser membros para toda a vida."@pt ,
                    "Az aktív szakaszt követő szakasz azoknak a tagoknak, akik elhagyták az aktív életet, gyakran a tanulmányaik után, de egy életre tagok maradnak."@hu .

##############################################################################
# 2b. DEGREE KINDS  (values of fraternal:degreeKind)
##############################################################################

fraternalc:DegreeKinds a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Degree Kinds"@en , "Gradarter"@sv , "Natures de degré"@fr , "Gradarten"@de , "Tipi di grado"@it , "Tipos de grado"@es , "Tipos de grau"@pt , "Fokozatfajták"@hu ;
    skos:definition "Kinds of degree other than an ordinary degree of the numbered sequence. Degrees of the kinds honorary, office, side, associate and emeritus usually stand outside the sequence and have no fraternal:degreeRank."@en ,
                    "Arter av grader utöver en vanlig grad i den numrerade följden. Heders-, ämbets-, tilläggs-, anhörig- och emeritusgrader står oftast utanför följden och saknar fraternal:degreeRank."@sv ,
                    "Sortes de degrés autres qu'un degré ordinaire de la suite numérotée. Les degrés de nature honoraire, de fonction, annexe, d'associé et émérite se tiennent en général hors de la suite et n'ont pas de fraternal:degreeRank."@fr ,
                    "Arten von Graden, die keine gewöhnlichen Grade der nummerierten Folge sind. Grade der Arten Ehren-, Amts-, Neben-, assoziierter und Emeritusgrad stehen meist außerhalb der Folge und haben keinen fraternal:degreeRank."@de ,
                    "Tipi di grado diversi da un grado ordinario della sequenza numerata. I gradi onorari, di carica, laterali, associati ed emeriti di solito stanno fuori dalla sequenza e non hanno fraternal:degreeRank."@it ,
                    "Tipos de grado distintos de un grado ordinario de la secuencia numerada. Los grados de tipo honorífico, de cargo, lateral, asociado y emérito suelen quedar fuera de la secuencia y no tienen fraternal:degreeRank."@es ,
                    "Tipos de grau distintos de um grau ordinário da sequência numerada. Os graus de tipo honorífico, de cargo, lateral, associado e emérito costumam ficar fora da sequência e não têm fraternal:degreeRank."@pt ,
                    "A számozott sorrend rendes fokozatától eltérő fokozatfajták. A tiszteleti, tisztségi, mellék, társult és emeritus fajtájú fokozatok rendszerint a sorrenden kívül állnak, és nincs fraternal:degreeRank értékük."@hu ;
    skos:hasTopConcept fraternalc:honoraryDegree , fraternalc:officeDegree , fraternalc:sideDegree ,
                       fraternalc:probationaryDegree , fraternalc:associateDegree , fraternalc:emeritusDegree .

fraternalc:honoraryDegree a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:DegreeKinds ; skos:topConceptOf fraternalc:DegreeKinds ;
    skos:prefLabel "Honorary Degree"@en , "Hedersgrad"@sv , "Degré honoraire"@fr , "Ehrengrad"@de , "Grado onorario"@it , "Grado honorífico"@es , "Grau honorífico"@pt , "Tiszteleti fokozat"@hu ;
    skos:definition "A degree conferred for merit rather than reached by advancement, often with a limited number of holders."@en ,
                    "En grad som tilldelas för förtjänst snarare än nås genom befordran, ofta med ett begränsat antal innehavare."@sv ,
                    "Degré conféré pour son mérite plutôt qu'atteint par avancement, souvent avec un nombre limité de titulaires."@fr ,
                    "Ein Grad, der für Verdienste verliehen und nicht durch Aufstieg erreicht wird, oft mit einer begrenzten Zahl von Inhabern."@de ,
                    "Un grado conferito per merito anziché raggiunto per avanzamento, spesso con un numero limitato di titolari."@it ,
                    "Un grado conferido por mérito y no alcanzado por ascenso, a menudo con un número limitado de titulares."@es ,
                    "Um grau conferido por mérito e não alcançado por progressão, muitas vezes com um número limitado de titulares."@pt ,
                    "Érdemért adott, nem előlépéssel elért fokozat, gyakran korlátozott számú birtokossal."@hu .

fraternalc:officeDegree a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:DegreeKinds ; skos:topConceptOf fraternalc:DegreeKinds ;
    skos:prefLabel "Office Degree"@en , "Ämbetsgrad"@sv , "Degré de fonction"@fr , "Amtsgrad"@de , "Grado di carica"@it , "Grado de cargo"@es , "Grau de cargo"@pt , "Tisztségi fokozat"@hu ;
    skos:definition "A degree held by virtue of an office in the order."@en ,
                    "En grad som innehas i kraft av ett ämbete i orden."@sv ,
                    "Degré détenu en vertu d'une fonction dans l'ordre."@fr ,
                    "Ein Grad, der aufgrund eines Amtes im Orden geführt wird."@de ,
                    "Un grado detenuto in virtù di una carica nell'ordine."@it ,
                    "Un grado que se ostenta en virtud de un cargo en la orden."@es ,
                    "Um grau que se detém em virtude de um cargo na ordem."@pt ,
                    "A rendben viselt tisztség folytán birtokolt fokozat."@hu .

fraternalc:sideDegree a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:DegreeKinds ; skos:topConceptOf fraternalc:DegreeKinds ;
    skos:prefLabel "Side Degree"@en , "Tilläggsgrad"@sv , "Degré annexe"@fr , "Nebengrad"@de , "Grado laterale"@it , "Grado lateral"@es , "Grau lateral"@pt , "Mellék-fokozat"@hu ;
    skos:altLabel "Additional Degree"@en , "Sidograd"@sv , "Degré complémentaire"@fr , "Grado aggiuntivo"@it ;
    skos:definition "A degree worked alongside the main sequence rather than as a step in it."@en ,
                    "En grad som arbetas vid sidan av huvudföljden i stället för som ett steg i den."@sv ,
                    "Degré pratiqué à côté de la suite principale et non comme une étape de celle-ci."@fr ,
                    "Ein Grad, der neben der Hauptfolge gearbeitet wird und kein Schritt in ihr ist."@de ,
                    "Un grado lavorato accanto alla sequenza principale anziché come gradino di essa."@it ,
                    "Un grado que se trabaja junto a la secuencia principal y no como un escalón de ella."@es ,
                    "Um grau que se trabalha ao lado da sequência principal e não como um degrau dela."@pt ,
                    "A fő sorrend mellett művelt, nem annak lépcsőfokaként szolgáló fokozat."@hu .

fraternalc:probationaryDegree a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:DegreeKinds ; skos:topConceptOf fraternalc:DegreeKinds ;
    skos:prefLabel "Probationary Degree"@en , "Prövograd"@sv , "Degré probatoire"@fr , "Probegrad"@de , "Grado di prova"@it , "Grado de prueba"@es , "Grau de prova"@pt , "Próba-fokozat"@hu ;
    skos:altLabel "Novice Degree"@en , "Novisgrad"@sv , "Degré de novice"@fr , "Grado di novizio"@it ;
    skos:definition "A trial degree before full membership. It may be the first step of the sequence or stand before it."@en ,
                    "En prövograd före fullvärdigt medlemskap. Den kan vara följdens första steg eller stå före den."@sv ,
                    "Degré d'épreuve avant le plein statut de membre. Il peut être la première étape de la suite ou la précéder."@fr ,
                    "Ein Probegrad vor der Vollmitgliedschaft. Er kann der erste Schritt der Folge sein oder vor ihr stehen."@de ,
                    "Un grado di prova prima della piena appartenenza. Può essere il primo passo della sequenza o precederla."@it ,
                    "Un grado de prueba antes de la pertenencia plena. Puede ser el primer escalón de la secuencia o estar antes de ella."@es ,
                    "Um grau de prova antes da filiação plena. Pode ser o primeiro degrau da sequência ou estar antes dela."@pt ,
                    "A teljes tagság előtti próbafokozat. Lehet a sorrend első lépése, vagy előtte állhat."@hu .

fraternalc:associateDegree a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:DegreeKinds ; skos:topConceptOf fraternalc:DegreeKinds ;
    skos:prefLabel "Associate Degree"@en , "Anhöriggrad"@sv , "Degré d'associé"@fr , "Assoziierter Grad"@de , "Grado associato"@it , "Grado asociado"@es , "Grau associado"@pt , "Társult fokozat"@hu ;
    skos:altLabel "Ladies' Degree"@en , "Damgrad"@sv ;
    skos:definition "A degree conferred on people connected with members, such as their partners, who are not members of the order themselves."@en ,
                    "En grad som tilldelas personer knutna till medlemmar, t.ex. deras partner, som inte själva är medlemmar i orden."@sv ,
                    "Degré conféré à des personnes liées aux membres, comme leurs conjoints, qui ne sont pas elles-mêmes membres de l'ordre."@fr ,
                    "Ein Grad, der Personen verliehen wird, die mit Mitgliedern verbunden sind, etwa deren Partnern, und selbst keine Mitglieder des Ordens sind."@de ,
                    "Un grado conferito a persone legate ai soci, come i loro partner, che non sono soci dell'ordine."@it ,
                    "Un grado conferido a personas vinculadas con los miembros, como sus parejas, que no son miembros de la orden."@es ,
                    "Um grau conferido a pessoas ligadas aos membros, como os seus companheiros, que não são membros da ordem."@pt ,
                    "A tagokhoz kapcsolódó személyeknek, például párjaiknak adott fokozat, akik maguk nem tagjai a rendnek."@hu .

fraternalc:emeritusDegree a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:DegreeKinds ; skos:topConceptOf fraternalc:DegreeKinds ;
    skos:prefLabel "Emeritus Degree"@en , "Seniorgrad"@sv , "Degré émérite"@fr , "Emeritusgrad"@de , "Grado emerito"@it , "Grado emérito"@es , "Grau emérito"@pt , "Emeritus fokozat"@hu ;
    skos:altLabel "Seniority Degree"@en , "Emeritusgrad"@sv , "Degré d'ancienneté"@fr , "Grado di anzianità"@it ;
    skos:definition "A degree for former office holders or members of long standing."@en ,
                    "En grad för tidigare ämbetsinnehavare eller medlemmar med lång tjänstetid."@sv ,
                    "Degré pour d'anciens titulaires de fonctions ou des membres de longue date."@fr ,
                    "Ein Grad für frühere Amtsträger oder langjährige Mitglieder."@de ,
                    "Un grado per ex titolari di cariche o soci di lunga data."@it ,
                    "Un grado para antiguos titulares de cargos o miembros de larga trayectoria."@es ,
                    "Um grau para antigos titulares de cargos ou membros de longa data."@pt ,
                    "Fokozat volt tisztségviselőknek vagy régi tagoknak."@hu .

##############################################################################
# 3. MEMBER TITLES
##############################################################################

fraternalc:MemberTitles a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Member Titles"@en , "Medlemstitlar"@sv , "Titres des membres"@fr , "Mitgliedsanreden"@de , "Appellativi dei soci"@it , "Tratamientos de los miembros"@es , "Tratamentos dos membros"@pt , "Tagok megszólításai"@hu ;
    skos:definition "The forms of address that members of an order use for one another and by which they are called, such as brother, sister or companion. Used with fraternal:memberTitle."@en ,
                    "De tilltalsformer som medlemmar i en orden använder om varandra och kallas, till exempel broder, syster eller kompanjon. Används med fraternal:memberTitle."@sv ,
                    "Les formes d'appellation que les membres d'un ordre emploient entre eux et par lesquelles on les désigne, comme frère, sœur ou compagnon. S'utilise avec fraternal:memberTitle."@fr ,
                    "Die Anreden, mit denen sich die Mitglieder eines Ordens untereinander ansprechen und bezeichnet werden, etwa Bruder, Schwester oder Gefährte. Wird mit fraternal:memberTitle verwendet."@de ,
                    "Gli appellativi con cui i membri di un ordine si rivolgono l'uno all'altro e sono chiamati, come fratello, sorella o compagno. Si usa con fraternal:memberTitle."@it ,
                    "Las formas de tratamiento que los miembros de una orden usan entre sí y con las que se les llama, como hermano, hermana o compañero. Se usa con fraternal:memberTitle."@es ,
                    "As formas de tratamento que os membros de uma ordem usam entre si e com que são chamados, como irmão, irmã ou companheiro. Usa-se com fraternal:memberTitle."@pt ,
                    "Azok a megszólítási formák, amelyeket egy rend tagjai egymásra használnak, és amelyekkel hívják őket, például testvér, nővér vagy társ. A fraternal:memberTitle-lel használatos."@hu ;
    skos:hasTopConcept fraternalc:brother , fraternalc:sister , fraternalc:sibling , fraternalc:companion ,
                       fraternalc:fraterInSpe , fraternalc:sororInSpe .

fraternalc:brother a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MemberTitles ; skos:topConceptOf fraternalc:MemberTitles ;
    skos:prefLabel "Brother"@en , "Broder"@sv , "Frère"@fr , "Bruder"@de , "Fratello"@it , "Hermano"@es , "Irmão"@pt , "Testvér"@hu ;
    skos:altLabel "Frater"@la ;
    skos:definition "The title by which a male member of an order or lodge is addressed and called."@en ,
                    "Den titel varmed en manlig medlem av en orden eller loge tilltalas och kallas."@sv ,
                    "Le titre par lequel on s'adresse à un membre masculin d'un ordre ou d'une loge et on le désigne."@fr ,
                    "Die Anrede, mit der ein männliches Mitglied eines Ordens oder einer Loge angesprochen und bezeichnet wird."@de ,
                    "L'appellativo con cui ci si rivolge a un membro maschio di un ordine o di una loggia e lo si chiama."@it ,
                    "El tratamiento con que se dirige uno a un miembro masculino de una orden o logia y con que se le llama."@es ,
                    "O tratamento com que se dirige alguém a um membro masculino de uma ordem ou loja e com que é chamado."@pt ,
                    "A megszólítás, amellyel egy rend vagy páholy férfi tagját szólítják és hívják."@hu .

fraternalc:sister a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MemberTitles ; skos:topConceptOf fraternalc:MemberTitles ;
    skos:prefLabel "Sister"@en , "Syster"@sv , "Sœur"@fr , "Schwester"@de , "Sorella"@it , "Hermana"@es , "Irmã"@pt , "Nővér"@hu ;
    skos:altLabel "Soror"@la ;
    skos:definition "The title by which a female member of an order or lodge is addressed and called."@en ,
                    "Den titel varmed en kvinnlig medlem av en orden eller loge tilltalas och kallas."@sv ,
                    "Le titre par lequel on s'adresse à un membre féminin d'un ordre ou d'une loge et on la désigne."@fr ,
                    "Die Anrede, mit der ein weibliches Mitglied eines Ordens oder einer Loge angesprochen und bezeichnet wird."@de ,
                    "L'appellativo con cui ci si rivolge a una socia di un ordine o di una loggia e la si chiama."@it ,
                    "El tratamiento con que se dirige uno a una miembro femenina de una orden o logia y con que se la llama."@es ,
                    "O tratamento com que se dirige alguém a uma membro feminina de uma ordem ou loja e com que é chamada."@pt ,
                    "A megszólítás, amellyel egy rend vagy páholy női tagját szólítják és hívják."@hu .

fraternalc:sibling a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MemberTitles ; skos:topConceptOf fraternalc:MemberTitles ;
    skos:prefLabel "Sibling"@en , "Syskon"@sv , "Membre (titre neutre)"@fr , "Geschwister"@de , "Consocio"@it , "Hermane"@es , "Irmane"@pt , "Testvér (nemsemleges)"@hu ;
    skos:definition "Gender-neutral member title."@en , "Könsneutral medlemstitel."@sv , "Titre de membre neutre quant au genre."@fr , "Geschlechtsneutrale Mitgliedsanrede."@de , "Appellativo di socio neutro rispetto al genere."@it , "Tratamiento de miembro neutro en cuanto al género."@es , "Tratamento de membro neutro quanto ao género."@pt , "Nemsemleges tagi megszólítás."@hu .

fraternalc:companion a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MemberTitles ; skos:topConceptOf fraternalc:MemberTitles ;
    skos:prefLabel "Companion"@en , "Kompanjon"@sv , "Compagnon"@fr , "Gefährte"@de , "Compagno"@it , "Compañero"@es , "Companheiro"@pt , "Társ"@hu ;
    skos:definition "A title of address for a member of certain orders and craft brotherhoods, for example a compagnon in the French compagnonnage or a Companion in a Royal Arch chapter."@en ,
                    "En tilltalstitel för en medlem av vissa ordnar och hantverksbrödraskap, till exempel en compagnon i det franska compagnonnage eller en Companion i ett Royal Arch-kapitel."@sv ,
                    "Titre d'appellation d'un membre de certains ordres et confréries de métier, par exemple un compagnon du compagnonnage français ou un Companion d'un chapitre du Royal Arch."@fr ,
                    "Eine Anrede für ein Mitglied bestimmter Orden und Handwerksbruderschaften, etwa einen Compagnon im französischen Compagnonnage oder einen Companion in einem Royal-Arch-Kapitel."@de ,
                    "Un appellativo per un membro di certi ordini e confraternite di mestiere, per esempio un compagnon del compagnonnage francese o un Companion di un capitolo del Royal Arch."@it ,
                    "Un tratamiento para un miembro de ciertas órdenes y hermandades de oficio, por ejemplo un compagnon en el compagnonnage francés o un Compañero en un capítulo del Arco Real."@es ,
                    "Um tratamento para um membro de certas ordens e irmandades de ofício, por exemplo um compagnon no compagnonnage francês ou um Companheiro num capítulo do Arco Real."@pt ,
                    "Megszólítás bizonyos rendek és mesterségi testvériségek tagjának, például egy compagnon a francia compagnonnage-ban vagy egy Társ a Royal Arch káptalanban."@hu .

fraternalc:fraterInSpe a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MemberTitles ; skos:topConceptOf fraternalc:MemberTitles ;
    skos:prefLabel "Frater in spe"@la , "Brother-to-be"@en , "Blivande broder"@sv , "Futur frère"@fr , "Bruder in spe"@de , "Futuro fratello"@it , "Futuro hermano"@es , "Futuro irmão"@pt , "Leendő testvér"@hu ;
    skos:definition "Title of a male candidate who has not yet been initiated."@en , "Titel för en manlig kandidat som ännu inte initierats."@sv , "Titre d'un candidat masculin qui n'a pas encore été initié."@fr , "Anrede eines männlichen Kandidaten, der noch nicht initiiert ist."@de , "Appellativo di un candidato uomo che non è ancora stato iniziato."@it , "Título de un candidato masculino que aún no ha sido iniciado."@es , "Título de um candidato masculino que ainda não foi iniciado."@pt , "A még be nem avatott férfijelölt címe."@hu .

fraternalc:sororInSpe a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MemberTitles ; skos:topConceptOf fraternalc:MemberTitles ;
    skos:prefLabel "Soror in spe"@la , "Sister-to-be"@en , "Blivande syster"@sv , "Future sœur"@fr , "Schwester in spe"@de , "Futura sorella"@it , "Futura hermana"@es , "Futura irmã"@pt , "Leendő nővér"@hu ;
    skos:definition "Title of a female candidate who has not yet been initiated."@en , "Titel för en kvinnlig kandidat som ännu inte initierats."@sv , "Titre d'une candidate qui n'a pas encore été initiée."@fr , "Anrede einer weiblichen Kandidatin, die noch nicht initiiert ist."@de , "Appellativo di una candidata donna che non è ancora stata iniziata."@it , "Título de una candidata femenina que aún no ha sido iniciada."@es , "Título de uma candidata feminina que ainda não foi iniciada."@pt , "A még be nem avatott női jelölt címe."@hu .

fraternalc:bundesbruder a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTitles ; skos:topConceptOf fraternalc:StudentenverbindungTitles ;
    skos:prefLabel "Bundesbruder"@en , "Bundesbruder"@sv , "Bundesbruder"@de , "Bundesbruder"@it , "Bundesbruder"@fr , "Bundesbruder"@es , "Bundesbruder"@pt , "Bundesbruder"@hu ;
    skos:definition "How members of a Studentenverbindung address one another (Bund: the union)."@en ,
                    "Hur medlemmar i en Studentenverbindung tilltalar varandra (Bund: förbundet)."@sv ,
                    "Wie Mitglieder einer Studentenverbindung einander anreden (Bund: der Zusammenschluss)."@de ,
                    "Come si rivolgono l'uno all'altro i soci di una Studentenverbindung (Bund: l'unione)."@it ,
                    "Façon dont les membres d'une Studentenverbindung s'appellent entre eux (Bund : l'union)."@fr ,
                    "Cómo se tratan entre sí los miembros de una Studentenverbindung (Bund: la unión)."@es ,
                    "Como se tratam entre si os membros de uma Studentenverbindung (Bund: a união)."@pt ,
                    "Hogyan szólítják egymást egy Studentenverbindung tagjai (Bund: a szövetség)."@hu .

fraternalc:bundesschwester a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTitles ; skos:topConceptOf fraternalc:StudentenverbindungTitles ;
    skos:prefLabel "Bundesschwester"@en , "Bundesschwester"@sv , "Bundesschwester"@de , "Bundesschwester"@it , "Bundesschwester"@fr , "Bundesschwester"@es , "Bundesschwester"@pt , "Bundesschwester"@hu ;
    skos:definition "How members of a Damenverbindung or a mixed Verbindung address one another."@en ,
                    "Hur medlemmar i en Damenverbindung eller en blandad Verbindung tilltalar varandra."@sv ,
                    "Wie Mitglieder einer Damenverbindung oder gemischten Verbindung einander anreden."@de ,
                    "Come si rivolgono l'una all'altra i soci di una Damenverbindung o di una Verbindung mista."@it ,
                    "Façon dont les membres d'une Damenverbindung ou d'une Verbindung mixte s'appellent entre elles."@fr ,
                    "Cómo se tratan entre sí los miembros de una Damenverbindung o de una Verbindung mixta."@es ,
                    "Como se tratam entre si os membros de uma Damenverbindung ou de uma Verbindung mista."@pt ,
                    "Hogyan szólítják egymást egy Damenverbindung vagy vegyes Verbindung tagjai."@hu .

fraternalc:corpsbruder a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTitles ; skos:topConceptOf fraternalc:StudentenverbindungTitles ;
    skos:prefLabel "Corpsbruder"@en , "Corpsbruder"@sv , "Corpsbruder"@de , "Corpsbruder"@it , "Corpsbruder"@fr , "Corpsbruder"@es , "Corpsbruder"@pt , "Corpsbruder"@hu ;
    skos:altLabel "Corpsbursch"@de ;
    skos:definition "How members of a Corps address one another."@en ,
                    "Hur medlemmar i ett Corps tilltalar varandra."@sv ,
                    "Wie Mitglieder eines Corps einander anreden."@de ,
                    "Come si rivolgono l'uno all'altro i soci di un Corps."@it ,
                    "Façon dont les membres d'un Corps s'appellent entre eux."@fr ,
                    "Cómo se tratan entre sí los miembros de un Corps."@es ,
                    "Como se tratam entre si os membros de um Corps."@pt ,
                    "Hogyan szólítják egymást egy Corps tagjai."@hu .

fraternalc:cartellbruder a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungTitles ; skos:topConceptOf fraternalc:StudentenverbindungTitles ;
    skos:prefLabel "Cartellbruder"@en , "Cartellbruder"@sv , "Cartellbruder"@de , "Cartellbruder"@it , "Cartellbruder"@fr , "Cartellbruder"@es , "Cartellbruder"@pt , "Cartellbruder"@hu ;
    skos:definition "How members of Verbindungen in the Cartellverband (CV) address one another across Verbindungen."@en ,
                    "Hur medlemmar i Verbindungen inom Cartellverband (CV) tilltalar varandra över Verbindungsgränserna."@sv ,
                    "Wie Mitglieder von Verbindungen im Cartellverband (CV) einander über die Verbindungen hinweg anreden."@de ,
                    "Come si rivolgono l'uno all'altro, da una Verbindung all'altra, i soci delle Verbindungen del Cartellverband (CV)."@it ,
                    "Façon dont les membres des Verbindungen du Cartellverband (CV) s'appellent entre eux d'une Verbindung à l'autre."@fr ,
                    "Cómo se tratan entre sí los miembros de las Verbindungen del Cartellverband (CV) de una Verbindung a otra."@es ,
                    "Como se tratam entre si os membros das Verbindungen do Cartellverband (CV) de uma Verbindung para outra."@pt ,
                    "Hogyan szólítják egymást a Cartellverband (CV) Verbindungeinek tagjai a Verbindungek között."@hu .

##############################################################################
# 4. CHARACTERISTICS
##############################################################################

fraternalc:Characteristics a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Characteristics of Orders"@en , "Ordensdrag"@sv , "Caractéristiques des ordres"@fr , "Merkmale von Orden"@de , "Caratteristiche degli ordini"@it , "Características de las órdenes"@es , "Características das ordens"@pt , "A rendek jellemzői"@hu ;
    skos:definition "Features by which orders and lodges differ from or resemble one another: rituals, degrees, oaths, rites, principles and requirements. Used with fraternal:characteristic."@en ,
                    "Drag som skiljer ordnar och loger åt eller gör dem lika: ritualer, grader, eder, riter, principer och krav. Används med fraternal:characteristic."@sv ,
                    "Traits par lesquels les ordres et les loges se distinguent ou se ressemblent : rituels, degrés, serments, rites, principes et exigences. S'utilise avec fraternal:characteristic."@fr ,
                    "Merkmale, in denen sich Orden und Logen unterscheiden oder gleichen: Rituale, Grade, Eide, Riten, Grundsätze und Anforderungen. Wird mit fraternal:characteristic verwendet."@de ,
                    "Tratti in cui gli ordini e le logge differiscono o si somigliano: rituali, gradi, giuramenti, riti, principi e requisiti. Si usa con fraternal:characteristic."@it ,
                    "Rasgos por los que las órdenes y logias se distinguen o se parecen: rituales, grados, juramentos, ritos, principios y requisitos. Se usa con fraternal:characteristic."@es ,
                    "Traços pelos quais as ordens e lojas se distinguem ou se parecem: rituais, graus, juramentos, ritos, princípios e requisitos. Usa-se com fraternal:characteristic."@pt ,
                    "Vonások, amelyek szerint a rendek és páholyok különböznek vagy hasonlítanak egymásra: szertartások, fokozatok, eskük, ritusok, elvek és követelmények. A fraternal:characteristic-kal használatos."@hu ;
    skos:hasTopConcept fraternalc:initiationRitual , fraternalc:gradedDegrees , fraternalc:oathOfObligation ,
                       fraternalc:secrecy , fraternalc:regalia , fraternalc:mutualAid , fraternalc:charity ,
                       fraternalc:religiousRequirement , fraternalc:noDogmaticRequirement .

fraternalc:initiationRitual a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:Characteristics ; skos:topConceptOf fraternalc:Characteristics ;
    skos:prefLabel "Initiation Ritual"@en , "Initieringsritual"@sv , "Rituel d'initiation"@fr , "Initiationsritual"@de , "Rituale d'iniziazione"@it , "Ritual de iniciación"@es , "Ritual de iniciação"@pt , "Beavatási szertartás"@hu ;
    skos:definition "A new member is admitted through a ritual of initiation."@en ,
                    "En ny medlem upptas genom en initieringsritual."@sv ,
                    "Un nouveau membre est admis par un rituel d'initiation."@fr ,
                    "Ein neues Mitglied wird durch ein Aufnahmeritual aufgenommen."@de ,
                    "Un nuovo socio viene ammesso mediante un rituale di iniziazione."@it ,
                    "Un nuevo miembro es admitido mediante un ritual de iniciación."@es ,
                    "Um novo membro é admitido através de um ritual de iniciação."@pt ,
                    "Az új tagot beavatási szertartással veszik fel."@hu .

fraternalc:gradedDegrees a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:Characteristics ; skos:topConceptOf fraternalc:Characteristics ;
    skos:prefLabel "Graded Degrees"@en , "Gradsystem"@sv , "Système de degrés"@fr , "Gestufte Grade"@de , "Gradi successivi"@it , "Grados sucesivos"@es , "Graus sucessivos"@pt , "Fokozatos tagság"@hu ;
    skos:definition "Membership is arranged in successive degrees or grades through which a member advances."@en ,
                    "Medlemskapet är ordnat i på varandra följande grader som medlemmen avancerar genom."@sv ,
                    "L'appartenance est organisée en degrés ou grades successifs que le membre franchit."@fr ,
                    "Die Mitgliedschaft ist in aufeinanderfolgende Grade oder Stufen gegliedert, die ein Mitglied durchläuft."@de ,
                    "L'appartenenza è articolata in gradi successivi che il socio percorre."@it ,
                    "La pertenencia se organiza en grados o escalones sucesivos por los que avanza el miembro."@es ,
                    "A filiação organiza-se em graus ou degraus sucessivos por que avança o membro."@pt ,
                    "A tagság egymás utáni fokozatokba vagy lépcsőfokokba rendezett, amelyeken a tag előrehalad."@hu .

fraternalc:oathOfObligation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:Characteristics ; skos:topConceptOf fraternalc:Characteristics ;
    skos:prefLabel "Oath or Obligation"@en , "Ed eller förpliktelse"@sv , "Serment ou engagement"@fr , "Eid oder Verpflichtung"@de , "Giuramento o obbligazione"@it , "Juramento u obligación"@es , "Juramento ou obrigação"@pt , "Eskü vagy kötelezettségvállalás"@hu ;
    skos:definition "A member takes an oath or obligation on admission or on advancing to a degree."@en ,
                    "En medlem avlägger en ed eller förpliktelse vid upptagning eller vid avancemang till en grad."@sv ,
                    "Un membre prête un serment ou un engagement à son admission ou en passant à un degré."@fr ,
                    "Ein Mitglied legt bei der Aufnahme oder beim Aufstieg in einen Grad einen Eid oder eine Verpflichtung ab."@de ,
                    "Un socio presta un giuramento o un'obbligazione all'ammissione o al passaggio a un grado."@it ,
                    "Un miembro presta un juramento u obligación al ser admitido o al avanzar a un grado."@es ,
                    "Um membro presta um juramento ou obrigação ao ser admitido ou ao avançar para um grau."@pt ,
                    "A tag esküt vagy kötelezettséget vállal a felvételkor vagy egy fokozatba lépéskor."@hu .

fraternalc:secrecy a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:Characteristics ; skos:topConceptOf fraternalc:Characteristics ;
    skos:prefLabel "Secrecy"@en , "Tystnadsplikt"@sv , "Obligation de secret"@fr , "Verschwiegenheit"@de , "Segretezza"@it , "Secreto"@es , "Segredo"@pt , "Titoktartás"@hu ;
    skos:definition "Members are bound to keep certain matters, such as rituals, signs or the membership itself, secret from outsiders."@en ,
                    "Medlemmarna är bundna att hålla vissa saker, till exempel ritualer, tecken eller själva medlemskapet, hemliga för utomstående."@sv ,
                    "Les membres sont tenus de garder secrètes pour les non-membres certaines choses, comme les rituels, les signes ou l'appartenance elle-même."@fr ,
                    "Die Mitglieder sind verpflichtet, bestimmte Dinge, etwa Rituale, Zeichen oder die Mitgliedschaft selbst, Außenstehenden gegenüber geheim zu halten."@de ,
                    "I soci sono tenuti a mantenere segrete agli estranei certe cose, come rituali, segni o la stessa appartenenza."@it ,
                    "Los miembros están obligados a mantener en secreto ante los ajenos ciertos asuntos, como los rituales, los signos o la pertenencia misma."@es ,
                    "Os membros estão obrigados a manter em segredo perante estranhos certos assuntos, como os rituais, os sinais ou a própria filiação."@pt ,
                    "A tagok kötelesek bizonyos dolgokat, például a szertartásokat, a jeleket vagy magát a tagságot titokban tartani a kívülállók előtt."@hu .

fraternalc:regalia a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:Characteristics ; skos:topConceptOf fraternalc:Characteristics ;
    skos:prefLabel "Regalia and Insignia"@en , "Ordensdräkt och insignier"@sv , "Tenue et insignes"@fr , "Ordenskleidung und Insignien"@de , "Paramenti e insegne"@it , "Regalías e insignias"@es , "Regalias e insígnias"@pt , "Jelvények és ékességek"@hu ;
    skos:definition "Members wear regalia or insignia at the order's meetings, as a sign of membership, degree or office."@en ,
                    "Medlemmarna bär ordensdräkt eller insignier vid ordens sammankomster, som tecken på medlemskap, grad eller ämbete."@sv ,
                    "Les membres portent une tenue ou des insignes aux réunions de l'ordre, comme signe d'appartenance, de degré ou de fonction."@fr ,
                    "Die Mitglieder tragen bei den Zusammenkünften des Ordens Ordenskleidung oder Insignien als Zeichen der Mitgliedschaft, eines Grades oder eines Amtes."@de ,
                    "I soci portano paramenti o insegne alle riunioni dell'ordine, come segno di appartenenza, di grado o di carica."@it ,
                    "Los miembros llevan regalías o insignias en las reuniones de la orden, como signo de pertenencia, grado o cargo."@es ,
                    "Os membros usam regalias ou insígnias nas reuniões da ordem, como sinal de filiação, grau ou cargo."@pt ,
                    "A tagok a rend összejövetelein ékességeket vagy jelvényeket viselnek a tagság, fokozat vagy tisztség jeléül."@hu .

fraternalc:mutualAid a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:Characteristics ; skos:topConceptOf fraternalc:Characteristics ;
    skos:prefLabel "Mutual Aid"@en , "Ömsesidig hjälp"@sv , "Entraide"@fr , "Gegenseitige Hilfe"@de , "Mutuo soccorso"@it , "Ayuda mutua"@es , "Ajuda mútua"@pt , "Kölcsönös segítség"@hu ;
    skos:definition "Members support one another in need, for example through relief funds, sick pay or burial benefit."@en ,
                    "Medlemmarna stöder varandra i nöd, till exempel genom understödskassor, sjukpenning eller begravningshjälp."@sv ,
                    "Les membres se soutiennent mutuellement dans le besoin, par exemple par des caisses de secours, des indemnités de maladie ou une aide aux obsèques."@fr ,
                    "Die Mitglieder unterstützen einander in Not, etwa durch Hilfskassen, Krankengeld oder Sterbegeld."@de ,
                    "I soci si sostengono a vicenda nel bisogno, per esempio con casse di soccorso, indennità di malattia o sussidi funerari."@it ,
                    "Los miembros se apoyan unos a otros en la necesidad, por ejemplo mediante fondos de socorro, subsidio de enfermedad o auxilio funerario."@es ,
                    "Os membros apoiam-se uns aos outros na necessidade, por exemplo através de fundos de socorro, subsídio de doença ou auxílio funerário."@pt ,
                    "A tagok szükség esetén támogatják egymást, például segélyalapokkal, táppénzzel vagy temetési segéllyel."@hu .

fraternalc:charity a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:Characteristics ; skos:topConceptOf fraternalc:Characteristics ;
    skos:prefLabel "Charity"@en , "Välgörenhet"@sv , "Bienfaisance"@fr , "Wohltätigkeit"@de , "Beneficenza"@it , "Beneficencia"@es , "Beneficência"@pt , "Jótékonyság"@hu ;
    skos:definition "Giving to charity or relief is one of the aims of the order."@en ,
                    "Välgörenhet eller understöd är ett av ordens syften."@sv ,
                    "La bienfaisance ou le secours est l'un des buts de l'ordre."@fr ,
                    "Wohltätigkeit oder Unterstützung ist eines der Ziele des Ordens."@de ,
                    "La beneficenza o il soccorso è uno degli scopi dell'ordine."@it ,
                    "Dar a la beneficencia o al socorro es uno de los fines de la orden."@es ,
                    "Dar à beneficência ou ao socorro é um dos fins da ordem."@pt ,
                    "A jótékonyság vagy segélyezés a rend egyik célja."@hu .

fraternalc:religiousRequirement a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:Characteristics ; skos:topConceptOf fraternalc:Characteristics ;
    skos:prefLabel "Religious Requirement"@en , "Religiöst krav"@sv , "Exigence religieuse"@fr , "Religiöse Anforderung"@de , "Requisito religioso"@it , "Requisito religioso"@es , "Requisito religioso"@pt , "Vallási követelmény"@hu ;
    skos:definition "Members must profess a faith or belief."@en , "Medlemmar måste bekänna en tro."@sv , "Les membres doivent professer une foi ou une croyance."@fr , "Mitglieder müssen sich zu einem Glauben oder einer Überzeugung bekennen."@de , "I soci devono professare una fede o una credenza."@it , "Los miembros deben profesar una fe o creencia."@es , "Os membros têm de professar uma fé ou crença."@pt , "A tagoknak hitet vagy meggyőződést kell vallaniuk."@hu ;
    skos:narrower fraternalc:supremeBeingRequirement .

fraternalc:supremeBeingRequirement a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:Characteristics ; skos:broader fraternalc:religiousRequirement ;
    skos:prefLabel "Belief in a Supreme Being"@en , "Tro på ett högsta väsen"@sv , "Croyance en un Être suprême"@fr , "Glaube an ein höchstes Wesen"@de , "Fede in un Essere supremo"@it , "Creencia en un Ser Supremo"@es , "Crença num Ser Supremo"@pt , "Hit egy Legfőbb Lényben"@hu ;
    skos:altLabel "Great Architect of the Universe"@en , "Grand Architecte de l'Univers"@fr , "Grande Architetto dell'Universo"@it ;
    skos:definition "Members must profess belief in a supreme being, called the Great Architect of the Universe in masonic orders."@en ,
                    "Medlemmar måste bekänna tro på ett högsta väsen, som i frimurarordnar kallas Världsalltets store byggmästare."@sv ,
                    "Les membres doivent professer la croyance en un être suprême, appelé Grand Architecte de l'Univers dans les ordres maçonniques."@fr ,
                    "Die Mitglieder müssen den Glauben an ein höchstes Wesen bekennen, in freimaurerischen Orden der Große Baumeister aller Welten genannt."@de ,
                    "I soci devono professare la fede in un essere supremo, chiamato Grande Architetto dell'Universo negli ordini massonici."@it ,
                    "Los miembros deben profesar la creencia en un ser supremo, llamado Gran Arquitecto del Universo en las órdenes masónicas."@es ,
                    "Os membros têm de professar a crença num ser supremo, chamado Grande Arquiteto do Universo nas ordens maçónicas."@pt ,
                    "A tagoknak hitet kell vallaniuk egy legfőbb lényben, amelyet a szabadkőműves rendekben a Világmindenség Nagy Építőmesterének hívnak."@hu .

fraternalc:noDogmaticRequirement a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:Characteristics ; skos:topConceptOf fraternalc:Characteristics ;
    skos:prefLabel "No Dogmatic Requirement"@en , "Inget trosbekännelsekrav"@sv , "Adogmatique"@fr , "Keine dogmatische Anforderung"@de , "Nessun requisito dogmatico"@it , "Sin requisito dogmático"@es , "Sem requisito dogmático"@pt , "Dogmatikus követelmény nélkül"@hu ;
    skos:altLabel "Non-dogmatic"@en , "Adogmatic"@en , "Adogmatico"@it ;
    skos:definition "Members are not required to profess any belief or disbelief. In French masonry, the adogmatic obediences, such as the Grand Orient de France, which removed the requirement in 1877, take this position."@en ,
                    "Medlemmar behöver inte bekänna någon tro eller icke-tro. Inom fransk frimureri intar de adogmatiska obedienserna, som Grand Orient de France, som slopade kravet 1877, denna hållning."@sv ,
                    "Les membres n'ont à professer aucune croyance ni aucune incroyance. En franc-maçonnerie française, les obédiences adogmatiques, comme le Grand Orient de France qui a supprimé cette exigence en 1877, adoptent cette position."@fr ,
                    "Von den Mitgliedern wird kein Bekenntnis zu Glauben oder Unglauben verlangt. In der französischen Freimaurerei vertreten die adogmatischen Obedienzen diese Haltung, etwa der Grand Orient de France, der die Anforderung 1877 abschaffte."@de ,
                    "Ai soci non si chiede di professare alcuna credenza né incredulità. Nella massoneria francese questa posizione è propria delle obbedienze adogmatiche, come il Grande Oriente di Francia, che tolse il requisito nel 1877."@it ,
                    "No se exige a los miembros que profesen ninguna creencia ni increencia. En la masonería francesa adoptan esta postura las obediencias adogmáticas, como el Gran Oriente de Francia, que suprimió el requisito en 1877."@es ,
                    "Não se exige aos membros que professem nenhuma crença nem descrença. Na maçonaria francesa adotam esta posição as obediências adogmáticas, como o Grande Oriente de França, que suprimiu o requisito em 1877."@pt ,
                    "A tagoktól nem követelik meg semmilyen hit vagy hitetlenség vallását. A francia szabadkőművességben az adogmatikus obedienziák, mint a Franciaországi Nagy Orient, amely 1877-ben megszüntette a követelményt, ezt az álláspontot vallják."@hu ;
    skos:scopeNote "The opposite of fraternalc:supremeBeingRequirement, which is a kind of fraternalc:religiousRequirement."@en , "L'inverse de fraternalc:supremeBeingRequirement, qui est une sorte de fraternalc:religiousRequirement."@fr , "Das Gegenteil von fraternalc:supremeBeingRequirement, einer Art von fraternalc:religiousRequirement."@de , "L'opposto di fraternalc:supremeBeingRequirement, che è una forma di fraternalc:religiousRequirement."@it , "Motsatsen till fraternalc:supremeBeingRequirement, som är en form av fraternalc:religiousRequirement."@sv , "Lo contrario de fraternalc:supremeBeingRequirement, que es un tipo de fraternalc:religiousRequirement."@es , "O oposto de fraternalc:supremeBeingRequirement, que é um tipo de fraternalc:religiousRequirement."@pt , "A fraternalc:supremeBeingRequirement ellentéte, amely a fraternalc:religiousRequirement egyik fajtája."@hu .

fraternalc:itinerantTraining a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CompagnonnageCharacteristics ; skos:topConceptOf fraternalc:CompagnonnageCharacteristics ;
    skos:prefLabel "Itinerant Training"@en , "Gesällvandring"@sv , "Tour de France"@fr , "Wanderschaft"@de , "Formazione itinerante"@it , "Formación itinerante"@es , "Formação itinerante"@pt , "Vándorképzés"@hu ;
    skos:altLabel "Journeyman Years"@en , "Wanderjahre"@de ;
    skos:definition "Members in training travel between workplaces and places, often for years, to learn their trade, as the French compagnons do on their Tour de France."@en ,
                    "Medlemmar under utbildning vandrar mellan arbetsplatser och orter, ofta i flera år, för att lära sitt yrke, som de franska compagnons gör på sin Tour de France."@sv ,
                    "Les membres en formation voyagent d'un lieu de travail et d'une ville à l'autre, souvent pendant des années, pour apprendre leur métier, comme le font les compagnons français lors de leur Tour de France."@fr ,
                    "Mitglieder in Ausbildung ziehen, oft jahrelang, zwischen Werkstätten und Orten umher, um ihr Gewerbe zu erlernen, wie es die französischen Compagnons auf ihrer Tour de France tun."@de ,
                    "I soci in formazione viaggiano tra botteghe e luoghi, spesso per anni, per imparare il mestiere, come fanno i compagnons francesi nel loro Tour de France."@it ,
                    "Los miembros en formación viajan entre talleres y lugares, a menudo durante años, para aprender su oficio, como hacen los compagnons franceses en su Tour de France."@es ,
                    "Os membros em formação viajam entre oficinas e lugares, muitas vezes durante anos, para aprender o seu ofício, como fazem os compagnons franceses no seu Tour de France."@pt ,
                    "A képzésben lévő tagok műhelyek és helyek között vándorolnak, gyakran évekig, hogy megtanulják a mesterségüket, ahogy a francia compagnonok teszik a Tour de France-on."@hu ;
    skos:scopeNote "The Tour de France of the compagnons is not the cycling race."@en , "Le Tour de France des compagnons n'est pas la course cycliste."@fr , "Die Tour de France der Compagnons ist nicht das Radrennen."@de , "Il Tour de France dei compagnons non è la corsa ciclistica."@it , "Compagnonernas Tour de France är inte cykelloppet."@sv , "El Tour de France de los compagnons no es la carrera ciclista."@es , "O Tour de France dos compagnons não é a corrida de ciclismo."@pt , "A compagnonok Tour de France-a nem a kerékpárverseny."@hu .

fraternalc:masterpieceRequirement a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CompagnonnageCharacteristics ; skos:topConceptOf fraternalc:CompagnonnageCharacteristics ;
    skos:prefLabel "Masterpiece Requirement"@en , "Krav på mästerstycke"@sv , "Chef-d'œuvre"@fr , "Meisterstück-Erfordernis"@de , "Requisito del capolavoro"@it , "Requisito de obra maestra"@es , "Requisito de obra-prima"@pt , "Remekmű-követelmény"@hu ;
    skos:altLabel "Travail de réception"@fr ;
    skos:definition "A member must make and present a masterpiece, judged by the order, to advance to full membership."@en ,
                    "En medlem måste göra och lägga fram ett mästerstycke, som bedöms av orden, för att nå fullt medlemskap."@sv ,
                    "Un membre doit réaliser et présenter un chef-d'œuvre, jugé par l'ordre, pour accéder au plein statut de membre."@fr ,
                    "Ein Mitglied muss ein Meisterstück anfertigen und vorlegen, das vom Orden beurteilt wird, um zur Vollmitgliedschaft aufzusteigen."@de ,
                    "Un socio deve realizzare e presentare un capolavoro, giudicato dall'ordine, per avanzare alla piena appartenenza."@it ,
                    "Un miembro debe hacer y presentar una obra maestra, juzgada por la orden, para avanzar a la pertenencia plena."@es ,
                    "Um membro tem de fazer e apresentar uma obra-prima, julgada pela ordem, para avançar para a filiação plena."@pt ,
                    "A tagnak remekművet kell készítenie és bemutatnia, amelyet a rend megítél, hogy teljes tagságra lépjen."@hu .

fraternalc:masonicRite a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MasonicRites ; skos:topConceptOf fraternalc:MasonicRites ;
    skos:prefLabel "Masonic Rite"@en , "Frimurarrit"@sv , "Rite maçonnique"@fr , "Freimaurerischer Ritus"@de , "Rito massonico"@it , "Rito masónico"@es , "Rito maçónico"@pt , "Szabadkőműves rítus"@hu ;
    skos:definition "The ritual tradition a lodge or masonic body works, with its own wording of the ceremonies and its own series of higher degrees."@en ,
                    "Den ritualtradition en loge eller ett frimurarorgan arbetar efter, med egen lydelse av ceremonierna och egen följd av högre grader."@sv ,
                    "Tradition rituelle selon laquelle travaille une loge ou un corps maçonnique, avec sa propre rédaction des cérémonies et sa propre suite de hauts grades."@fr ,
                    "Die rituelle Tradition, nach der eine Loge oder freimaurerische Körperschaft arbeitet, mit eigenem Wortlaut der Zeremonien und einer eigenen Reihe höherer Grade."@de ,
                    "La tradizione rituale che una loggia o un corpo massonico pratica, con una propria formulazione delle cerimonie e una propria serie di gradi superiori."@it ,
                    "La tradición ritual que trabaja una logia o un organismo masónico, con su propia redacción de las ceremonias y su propia serie de grados superiores."@es ,
                    "A tradição ritual que trabalha uma loja ou um organismo maçónico, com a sua própria redação das cerimónias e a sua própria série de graus superiores."@pt ,
                    "A rituális hagyomány, amelyet egy páholy vagy szabadkőműves testület művel, a szertartások saját szövegével és a magasabb fokozatok saját sorozatával."@hu ;
    skos:scopeNote "A rite is not a degree system: give the lodge's ladder with fraternal:degreeSystem and its rite with fraternal:characteristic."@en , "Un rite n'est pas un système de degrés : indiquer l'échelle de la loge avec fraternal:degreeSystem et son rite avec fraternal:characteristic."@fr , "Ein Ritus ist kein Gradsystem: Die Stufenfolge der Loge wird mit fraternal:degreeSystem angegeben und ihr Ritus mit fraternal:characteristic."@de , "Un rito non è un sistema di gradi: la scala della loggia si indica con fraternal:degreeSystem e il suo rito con fraternal:characteristic."@it , "En rit är inte ett gradsystem: logens gradstege anges med fraternal:degreeSystem och dess rit med fraternal:characteristic."@sv , "Un rito no es un sistema de grados: la escala de la logia se da con fraternal:degreeSystem y su rito con fraternal:characteristic."@es , "Um rito não é um sistema de graus: a escala da loja indica-se com fraternal:degreeSystem e o seu rito com fraternal:characteristic."@pt , "A rítus nem fokozatrendszer: a páholy létráját a fraternal:degreeSystem, a rítusát a fraternal:characteristic adja meg."@hu ;
    skos:narrower fraternalc:ancientAndAcceptedScottishRite , fraternalc:frenchRite , fraternalc:rectifiedScottishRite .

fraternalc:ancientAndAcceptedScottishRite a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MasonicRites ; skos:broader fraternalc:masonicRite ;
    skos:prefLabel "Ancient and Accepted Scottish Rite"@en , "Antika och accepterade skotska riten"@sv , "Rite écossais ancien et accepté"@fr , "Alter und Angenommener Schottischer Ritus"@de , "Rito Scozzese Antico ed Accettato"@it , "Rito Escocés Antiguo y Aceptado"@es , "Rito Escocês Antigo e Aceite"@pt , "Ősi és Elfogadott Skót Rítus"@hu ;
    skos:altLabel "AASR"@en , "REAA"@fr , "R.S.A.A."@it ;
    skos:definition "A masonic rite of thirty-three degrees, worked in France and in many other countries."@en ,
                    "En frimurarrit med trettiotre grader, som används i Frankrike och i många andra länder."@sv ,
                    "Rite maçonnique de trente-trois degrés, pratiqué en France et dans de nombreux autres pays."@fr ,
                    "Ein freimaurerischer Ritus mit dreiunddreißig Graden, der in Frankreich und in vielen anderen Ländern gearbeitet wird."@de ,
                    "Un rito massonico di trentatré gradi, praticato in Francia, in Italia e in molti altri paesi."@it ,
                    "Un rito masónico de treinta y tres grados, que se trabaja en Francia y en muchos otros países."@es ,
                    "Um rito maçónico de trinta e três graus, que se trabalha em França e em muitos outros países."@pt ,
                    "Harminchárom fokozatú szabadkőműves rítus, amelyet Franciaországban és sok más országban művelnek."@hu .

fraternalc:frenchRite a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MasonicRites ; skos:broader fraternalc:masonicRite ;
    skos:prefLabel "French Rite"@en , "Franska riten"@sv , "Rite français"@fr , "Französischer Ritus"@de , "Rito Francese"@it , "Rito Francés"@es , "Rito Francês"@pt , "Francia Rítus"@hu ;
    skos:altLabel "Modern Rite"@en , "Rite moderne"@fr , "RF"@fr , "Rito Moderno"@it ;
    skos:definition "The rite of the Grand Orient de France: the three craft degrees followed by a short series of higher orders."@en ,
                    "Den rit som Grand Orient de France arbetar efter: de tre symboliska graderna följda av en kort följd av högre ordnar."@sv ,
                    "Rite du Grand Orient de France : les trois degrés symboliques suivis d'une courte série d'ordres supérieurs."@fr ,
                    "Der Ritus des Grand Orient de France: die drei Johannisgrade, gefolgt von einer kurzen Reihe höherer Ordnungen."@de ,
                    "Il rito del Grande Oriente di Francia: i tre gradi simbolici seguiti da una breve serie di ordini superiori."@it ,
                    "El rito del Gran Oriente de Francia: los tres grados simbólicos seguidos de una breve serie de órdenes superiores."@es ,
                    "O rito do Grande Oriente de França: os três graus simbólicos seguidos de uma breve série de ordens superiores."@pt ,
                    "A Franciaországi Nagy Orient rítusa: a három jelképes fokozat, majd magasabb rendek rövid sorozata."@hu .

fraternalc:rectifiedScottishRite a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MasonicRites ; skos:broader fraternalc:masonicRite ;
    skos:prefLabel "Rectified Scottish Rite"@en , "Rektifierade skotska riten"@sv , "Rite écossais rectifié"@fr , "Rektifizierter Schottischer Ritus"@de , "Rito Scozzese Rettificato"@it , "Rito Escocés Rectificado"@es , "Rito Escocês Retificado"@pt , "Reformált Skót Rítus"@hu ;
    skos:altLabel "RER"@fr ;
    skos:definition "A rite descending from the Strict Observance, reformed at the Convent of Lyon in 1778, with a Christian-rooted ritual and chivalric higher degrees."@en ,
                    "En rit som härstammar från Strikt observans, reformerat vid konventet i Lyon 1778, med en kristet förankrad ritual och riddargrader som högre grader."@sv ,
                    "Rite issu de la Stricte Observance, réformé au convent de Lyon en 1778, au rituel d'inspiration chrétienne et aux grades supérieurs chevaleresques."@fr ,
                    "Ein Ritus, der von der Strikten Observanz abstammt und auf dem Konvent von Lyon 1778 reformiert wurde, mit einem christlich verwurzelten Ritual und ritterlichen höheren Graden."@de ,
                    "Un rito discendente dalla Stretta Osservanza, riformato al Convento di Lione nel 1778, con un rituale di radice cristiana e gradi superiori cavallereschi."@it ,
                    "Un rito descendiente de la Estricta Observancia, reformado en el Convento de Lyon en 1778, con un ritual de raíz cristiana y grados superiores caballerescos."@es ,
                    "Um rito descendente da Estrita Observância, reformado no Convento de Lião em 1778, com um ritual de raiz cristã e graus superiores cavaleirescos."@pt ,
                    "A Szigorú Megfigyelésből származó rítus, amelyet az 1778-as lyoni konventen reformáltak, keresztény gyökerű szertartással és lovagi magasabb fokozatokkal."@hu .

fraternalc:lifelongBond a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCharacteristics ; skos:topConceptOf fraternalc:StudentenverbindungCharacteristics ;
    skos:prefLabel "Lifelong Bond"@en , "Livslångt förbund"@sv , "Lebensbund"@de , "Vincolo per la vita"@it , "Lien à vie"@fr , "Vínculo de por vida"@es , "Vínculo para toda a vida"@pt , "Élethosszig tartó kötelék"@hu ;
    skos:altLabel "Lebensbundprinzip"@de ;
    skos:definition "Membership lasts for life: the active member stays on as an alumnus (Alter Herr) and remains bound to the organisation and to the other members."@en ,
                    "Medlemskapet varar hela livet: den aktive medlemmen blir kvar som alumn (Alter Herr) och förblir knuten till organisationen och de andra medlemmarna."@sv ,
                    "Die Mitgliedschaft gilt auf Lebenszeit: Das aktive Mitglied bleibt als Alter Herr und bleibt der Organisation und den anderen Mitgliedern verbunden."@de ,
                    "L'appartenenza dura per tutta la vita: il socio attivo resta come ex alunno (Alter Herr) e rimane legato all'organizzazione e agli altri soci."@it ,
                    "L'appartenance dure toute la vie : le membre actif reste comme ancien (Alter Herr) et demeure lié à l'organisation et aux autres membres."@fr ,
                    "La pertenencia dura toda la vida: el miembro activo sigue como antiguo miembro (Alter Herr) y permanece ligado a la organización y a los demás miembros."@es ,
                    "A filiação dura toda a vida: o membro ativo continua como antigo membro (Alter Herr) e permanece ligado à organização e aos outros membros."@pt ,
                    "A tagság egy életre szól: az aktív tag öregdiákként (Alter Herr) marad, és a szervezethez és a többi taghoz kötve marad."@hu .

fraternalc:conventPrinciple a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCharacteristics ; skos:topConceptOf fraternalc:StudentenverbindungCharacteristics ;
    skos:prefLabel "Convent Principle"@en , "Konventsprincipen"@sv , "Conventsprinzip"@de , "Principio del convent"@it , "Principe du convent"@fr , "Principio del convent"@es , "Princípio do convent"@pt , "Konvent-elv"@hu ;
    skos:definition "The organisation governs itself: the convent of its members decides its affairs, and each member has one vote."@en ,
                    "Organisationen styr sig själv: medlemmarnas konvent beslutar i dess angelägenheter, och varje medlem har en röst."@sv ,
                    "Die Organisation verwaltet sich selbst: Der Convent ihrer Mitglieder entscheidet über ihre Angelegenheiten, und jedes Mitglied hat eine Stimme."@de ,
                    "L'organizzazione si governa da sé: il convent dei suoi soci decide i suoi affari e ogni socio ha un voto."@it ,
                    "L'organisation se gouverne elle-même : le convent de ses membres décide de ses affaires, et chaque membre a une voix."@fr ,
                    "La organización se gobierna a sí misma: el convent de sus miembros decide sus asuntos, y cada miembro tiene un voto."@es ,
                    "A organização governa-se a si própria: o convent dos seus membros decide os seus assuntos, e cada membro tem um voto."@pt ,
                    "A szervezet önkormányzó: tagjainak konventje dönt az ügyeiről, és minden tagnak egy szavazata van."@hu .

fraternalc:tolerancePrinciple a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCharacteristics ; skos:topConceptOf fraternalc:StudentenverbindungCharacteristics ;
    skos:prefLabel "Principle of Tolerance"@en , "Toleransprincipen"@sv , "Toleranzprinzip"@de , "Principio di tolleranza"@it , "Principe de tolérance"@fr , "Principio de tolerancia"@es , "Princípio de tolerância"@pt , "Tolerancia-elv"@hu ;
    skos:definition "The organisation takes no common political or religious position and admits members of differing views."@en ,
                    "Organisationen intar ingen gemensam politisk eller religiös ståndpunkt och tar emot medlemmar med olika åsikter."@sv ,
                    "Die Organisation nimmt keine gemeinsame politische oder religiöse Haltung ein und nimmt Mitglieder unterschiedlicher Anschauung auf."@de ,
                    "L'organizzazione non assume una posizione politica o religiosa comune e ammette soci di opinioni diverse."@it ,
                    "L'organisation ne prend aucune position politique ou religieuse commune et admet des membres d'opinions différentes."@fr ,
                    "La organización no adopta una posición política o religiosa común y admite miembros de opiniones diversas."@es ,
                    "A organização não adota uma posição política ou religiosa comum e admite membros de opiniões diversas."@pt ,
                    "A szervezet nem foglal el közös politikai vagy vallási álláspontot, és eltérő nézetű tagokat is felvesz."@hu .

fraternalc:compulsoryFencing a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCharacteristics ; skos:topConceptOf fraternalc:StudentenverbindungCharacteristics ;
    skos:prefLabel "Compulsory Fencing"@en , "Obligatorisk mensur"@sv , "Pflichtschlagend"@de , "Scherma obbligatoria"@it , "Escrime obligatoire"@fr , "Esgrima obligatoria"@es , "Esgrima obrigatória"@pt , "Kötelező vívás"@hu ;
    skos:altLabel "Schlagend"@de ;
    skos:definition "Members must fight a number of Mensuren as a condition of full membership (see fraternalc:mensur)."@en ,
                    "Medlemmar måste utkämpa ett antal mensurer som villkor för fullt medlemskap (se fraternalc:mensur)."@sv ,
                    "Mitglieder müssen als Bedingung der Vollmitgliedschaft eine Anzahl von Mensuren fechten (siehe fraternalc:mensur)."@de ,
                    "I soci devono sostenere un certo numero di Mensuren come condizione della piena appartenenza (vedi fraternalc:mensur)."@it ,
                    "Les membres doivent livrer un certain nombre de Mensuren comme condition du plein statut de membre (voir fraternalc:mensur)."@fr ,
                    "Los miembros deben batirse en cierto número de Mensuren como condición de la pertenencia plena (véase fraternalc:mensur)."@es ,
                    "Os membros têm de bater-se em certo número de Mensuren como condição da filiação plena (ver fraternalc:mensur)."@pt ,
                    "A tagoknak a teljes tagság feltételeként több Mensurt kell vívniuk (lásd fraternalc:mensur)."@hu .

fraternalc:optionalFencing a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCharacteristics ; skos:topConceptOf fraternalc:StudentenverbindungCharacteristics ;
    skos:prefLabel "Optional Fencing"@en , "Frivillig mensur"@sv , "Fakultativ schlagend"@de , "Scherma facoltativa"@it , "Escrime facultative"@fr , "Esgrima optativa"@es , "Esgrima facultativa"@pt , "Választható vívás"@hu ;
    skos:definition "The Mensur is practised and permitted but not required of members (see fraternalc:mensur)."@en ,
                    "Mensur utövas och är tillåten men krävs inte av medlemmarna (se fraternalc:mensur)."@sv ,
                    "Die Mensur wird ausgeübt und ist erlaubt, aber von den Mitgliedern nicht verlangt (siehe fraternalc:mensur)."@de ,
                    "La Mensur è praticata e consentita ma non richiesta ai soci (vedi fraternalc:mensur)."@it ,
                    "La Mensur est pratiquée et permise mais n'est pas exigée des membres (voir fraternalc:mensur)."@fr ,
                    "La Mensur se practica y se permite, pero no se exige a los miembros (véase fraternalc:mensur)."@es ,
                    "A Mensur pratica-se e permite-se, mas não se exige aos membros (ver fraternalc:mensur)."@pt ,
                    "A Mensurt gyakorolják és megengedik, de nem követelik meg a tagoktól (lásd fraternalc:mensur)."@hu .

fraternalc:nonFencing a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCharacteristics ; skos:topConceptOf fraternalc:StudentenverbindungCharacteristics ;
    skos:prefLabel "No Fencing"@en , "Ingen mensur"@sv , "Nichtschlagend"@de , "Nessuna scherma"@it , "Pas d'escrime"@fr , "Sin esgrima"@es , "Sem esgrima"@pt , "Vívás nélkül"@hu ;
    skos:definition "The organisation rejects the Mensur (see fraternalc:mensur)."@en ,
                    "Organisationen avvisar mensur (se fraternalc:mensur)."@sv ,
                    "Die Organisation lehnt die Mensur ab (siehe fraternalc:mensur)."@de ,
                    "L'organizzazione rifiuta la Mensur (vedi fraternalc:mensur)."@it ,
                    "L'organisation rejette la Mensur (voir fraternalc:mensur)."@fr ,
                    "La organización rechaza la Mensur (véase fraternalc:mensur)."@es ,
                    "A organização rejeita a Mensur (ver fraternalc:mensur)."@pt ,
                    "A szervezet elutasítja a Mensurt (lásd fraternalc:mensur)."@hu .

fraternalc:satisfactionPrinciple a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCharacteristics ; skos:topConceptOf fraternalc:StudentenverbindungCharacteristics ;
    skos:prefLabel "Satisfaction Principle"@en , "Satisfaktionsprincipen"@sv , "Satisfaktionsprinzip"@de , "Principio della soddisfazione"@it , "Principe de satisfaction"@fr , "Principio de satisfacción"@es , "Princípio de satisfação"@pt , "Elégtétel-elv"@hu ;
    skos:definition "Members may be required to answer for their honour in a duel or by academic fencing; the obligation may be unconditional (unbedingte Satisfaktion) or limited."@en ,
                    "Medlemmar kan vara skyldiga att stå till svars för sin ära i en duell eller genom akademisk fäktning; skyldigheten kan vara ovillkorlig (unbedingte Satisfaktion) eller begränsad."@sv ,
                    "Mitglieder können verpflichtet sein, für ihre Ehre im Zweikampf oder durch akademisches Fechten einzustehen; die Verpflichtung kann unbedingt (unbedingte Satisfaktion) oder eingeschränkt sein."@de ,
                    "Ai soci si può chiedere di rispondere del proprio onore in un duello o con la scherma accademica; l'obbligo può essere incondizionato (unbedingte Satisfaktion) o limitato."@it ,
                    "Les membres peuvent être tenus de répondre de leur honneur par un duel ou par l'escrime académique ; l'obligation peut être inconditionnelle (unbedingte Satisfaktion) ou limitée."@fr ,
                    "Puede exigirse a los miembros que respondan de su honor en un duelo o mediante esgrima académica; la obligación puede ser incondicional (unbedingte Satisfaktion) o limitada."@es ,
                    "Pode exigir-se aos membros que respondam pela sua honra num duelo ou através de esgrima académica; a obrigação pode ser incondicional (unbedingte Satisfaktion) ou limitada."@pt ,
                    "A tagoktól megkövetelhető, hogy párbajban vagy akadémiai vívással feleljenek a becsületükért; a kötelezettség lehet feltétel nélküli (unbedingte Satisfaktion) vagy korlátozott."@hu .

fraternalc:colourWearing a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCharacteristics ; skos:topConceptOf fraternalc:StudentenverbindungCharacteristics ;
    skos:prefLabel "Colour-wearing"@en , "Bär färger"@sv , "Farbentragend"@de , "Colori portati"@it , "Port des couleurs"@fr , "Con colores"@es , "Com cores"@pt , "Színviselő"@hu ;
    skos:definition "Members wear the organisation's colours (colour band and cap) in public on festive occasions."@en ,
                    "Medlemmar bär organisationens färger (färgband och mössa) offentligt vid festliga tillfällen."@sv ,
                    "Die Mitglieder tragen die Farben der Organisation (Band und Mütze) bei festlichen Anlässen öffentlich."@de ,
                    "I soci portano in pubblico, nelle occasioni festive, i colori dell'organizzazione (nastro e berretto)."@it ,
                    "Les membres portent en public, dans les occasions festives, les couleurs de l'organisation (bande et calotte)."@fr ,
                    "Los miembros llevan los colores de la organización (banda de colores y gorro) en público en ocasiones festivas."@es ,
                    "Os membros usam as cores da organização (banda de cores e barrete) em público em ocasiões festivas."@pt ,
                    "A tagok ünnepi alkalmakkor nyilvánosan viselik a szervezet színeit (színes szalag és sapka)."@hu .

fraternalc:colourCarrying a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCharacteristics ; skos:topConceptOf fraternalc:StudentenverbindungCharacteristics ;
    skos:prefLabel "Colour-carrying"@en , "För färger"@sv , "Farbenführend"@de , "Colori posseduti"@it , "Possession des couleurs"@fr , "Con colores sin llevarlos"@es , "Com cores sem as usar"@pt , "Színhordó"@hu ;
    skos:definition "The organisation has colours but its members do not wear them in public."@en ,
                    "Organisationen har färger men medlemmarna bär dem inte offentligt."@sv ,
                    "Die Organisation führt Farben, ihre Mitglieder tragen sie aber nicht öffentlich."@de ,
                    "L'organizzazione ha dei colori ma i suoi soci non li portano in pubblico."@it ,
                    "L'organisation a des couleurs mais ses membres ne les portent pas en public."@fr ,
                    "La organización tiene colores, pero sus miembros no los llevan en público."@es ,
                    "A organização tem cores, mas os seus membros não as usam em público."@pt ,
                    "A szervezetnek vannak színei, de tagjai nem viselik őket nyilvánosan."@hu .

##############################################################################
# 5. CEREMONY TYPES  (values for mbr:gatheringType on fraternal:Ceremony)
##############################################################################

fraternalc:CeremonyTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Ceremony Types"@en , "Ceremonityper"@sv , "Types de cérémonies"@fr , "Zeremonienarten"@de , "Tipi di cerimonia"@it , "Tipos de ceremonia"@es , "Tipos de cerimónia"@pt , "Szertartástípusok"@hu ;
    skos:definition "Kinds of ceremony and ritual gathering held by orders and societies, from initiation and the conferral of degrees to festive meals and student customs. Each is mapped to a gathering type in mbrc:GatheringTypes."@en ,
                    "Slag av ceremonier och rituella sammankomster i ordnar och sällskap, från initiering och gradtilldelning till festmåltider och studentseder. Varje typ mappas till en sammankomsttyp i mbrc:GatheringTypes."@sv ,
                    "Types de cérémonies et de réunions rituelles des ordres et des sociétés, de l'initiation et de la collation des degrés aux repas festifs et aux usages étudiants. Chacun est associé à un type de réunion de mbrc:GatheringTypes."@fr ,
                    "Arten von Zeremonien und rituellen Zusammenkünften von Orden und Gesellschaften, von Aufnahme und Gradverleihung bis zu Festmählern und studentischen Bräuchen. Jede ist einer Versammlungsart in mbrc:GatheringTypes zugeordnet."@de ,
                    "Tipi di cerimonie e di riunioni rituali di ordini e società, dall'iniziazione e dal conferimento dei gradi ai banchetti rituali e agli usi studenteschi. Ciascuno è associato a un tipo di riunione di mbrc:GatheringTypes."@it ,
                    "Tipos de ceremonia y reunión ritual que celebran las órdenes y sociedades, desde la iniciación y la concesión de grados hasta los banquetes festivos y las costumbres estudiantiles. Cada uno se asocia a un tipo de reunión de mbrc:GatheringTypes."@es ,
                    "Tipos de cerimónia e reunião ritual que realizam as ordens e sociedades, desde a iniciação e a atribuição de graus até aos banquetes festivos e aos costumes estudantis. Cada um associa-se a um tipo de reunião de mbrc:GatheringTypes."@pt ,
                    "A rendek és társaságok által tartott szertartások és rituális összejövetelek fajtái, a beavatástól és a fokozatok adományozásától az ünnepi lakomákig és a diákszokásokig. Mindegyik az mbrc:GatheringTypes egy összejövetel-típusához rendelődik."@hu ;
    skos:hasTopConcept fraternalc:initiationCeremony , fraternalc:degreeCeremony , fraternalc:installation ,
                       fraternalc:memorialCeremony , fraternalc:festiveBoard , fraternalc:patronsFeast ,
                       fraternalc:openMeeting ,
                       fraternalc:investiture , fraternalc:consecration .

fraternalc:initiationCeremony a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CeremonyTypes ; skos:topConceptOf fraternalc:CeremonyTypes ;
    skos:prefLabel "Initiation Ceremony"@en , "Initieringsceremoni"@sv , "Cérémonie d'initiation"@fr , "Initiationszeremonie"@de , "Cerimonia d'iniziazione"@it , "Ceremonia de iniciación"@es , "Cerimónia de iniciação"@pt , "Beavatási szertartás"@hu ;
    skos:altLabel "Recipiering"@sv , "Intronisation"@fr , "Iniziazione"@it ;
    skos:definition "The ceremony in which a new member is admitted to the order."@en ,
                    "Ceremonin där en ny medlem upptas i ordern."@sv ,
                    "La cérémonie où un nouveau membre est admis dans l'ordre."@fr ,
                    "Die Zeremonie, in der ein neues Mitglied in den Orden aufgenommen wird."@de ,
                    "La cerimonia in cui un nuovo socio viene ammesso nell'ordine."@it ,
                    "La ceremonia en la que un nuevo miembro es admitido en la orden."@es ,
                    "A cerimónia em que um novo membro é admitido na ordem."@pt ,
                    "A szertartás, amelyben az új tagot felveszik a rendbe."@hu .

fraternalc:degreeCeremony a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CeremonyTypes ; skos:topConceptOf fraternalc:CeremonyTypes ;
    skos:prefLabel "Degree Ceremony"@en , "Gradceremoni"@sv , "Cérémonie de passage de degré"@fr , "Gradzeremonie"@de , "Cerimonia di grado"@it , "Ceremonia de grado"@es , "Cerimónia de grau"@pt , "Fokozati szertartás"@hu ;
    skos:altLabel "Passing"@en , "Raising"@en , "Befordran"@sv , "Passage"@fr , "Élévation"@fr , "Passaggio di grado"@it , "Innalzamento"@it ;
    skos:definition "The ceremony in which a member is advanced to the next degree."@en ,
                    "Ceremonin där en medlem avancerar till nästa grad."@sv ,
                    "La cérémonie où un membre passe au degré suivant."@fr ,
                    "Die Zeremonie, in der ein Mitglied in den nächsten Grad aufsteigt."@de ,
                    "La cerimonia in cui un socio passa al grado successivo."@it ,
                    "La ceremonia en la que un miembro asciende al grado siguiente."@es ,
                    "A cerimónia em que um membro sobe ao grau seguinte."@pt ,
                    "A szertartás, amelyben egy tag a következő fokozatba lép."@hu .

fraternalc:installation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CeremonyTypes ; skos:topConceptOf fraternalc:CeremonyTypes ;
    skos:prefLabel "Installation of Officers"@en , "Installation av ämbetsmän"@sv , "Installation des officiers"@fr , "Amtseinsetzung"@de , "Insediamento dei titolari di carica"@it , "Toma de posesión de los cargos"@es , "Tomada de posse dos cargos"@pt , "Tisztségviselők beiktatása"@hu ;
    skos:definition "The ceremony in which newly elected or appointed officers take up their offices."@en ,
                    "Ceremonin där nyvalda eller utsedda ämbetsmän tillträder sina ämbeten."@sv ,
                    "La cérémonie où les officiers nouvellement élus ou nommés prennent leurs fonctions."@fr ,
                    "Die Zeremonie, in der neu gewählte oder ernannte Amtsträger ihr Amt antreten."@de ,
                    "La cerimonia in cui i titolari di carica appena eletti o nominati assumono le loro cariche."@it ,
                    "La ceremonia en la que los cargos recién elegidos o nombrados toman posesión."@es ,
                    "A cerimónia em que os cargos recém-eleitos ou nomeados tomam posse."@pt ,
                    "A szertartás, amelyben az újonnan megválasztott vagy kinevezett tisztségviselők átveszik tisztségüket."@hu .

fraternalc:memorialCeremony a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CeremonyTypes ; skos:topConceptOf fraternalc:CeremonyTypes ;
    skos:prefLabel "Memorial Ceremony"@en , "Sorgeloge"@sv , "Cérémonie du souvenir"@fr , "Gedenkzeremonie"@de , "Cerimonia commemorativa"@it , "Ceremonia en memoria"@es , "Cerimónia em memória"@pt , "Emlékszertartás"@hu ;
    skos:altLabel "Lodge of Sorrow"@en , "Tenue funèbre"@fr ;
    skos:definition "A ceremony in memory of deceased members."@en , "En ceremoni till minne av avlidna medlemmar."@sv , "Cérémonie à la mémoire des membres décédés."@fr , "Eine Zeremonie zum Gedenken an verstorbene Mitglieder."@de , "Una cerimonia in ricordo dei soci defunti."@it , "Una ceremonia en memoria de los miembros fallecidos."@es , "Uma cerimónia em memória dos membros falecidos."@pt , "Az elhunyt tagok emlékére tartott szertartás."@hu .

fraternalc:festiveBoard a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CeremonyTypes ; skos:topConceptOf fraternalc:CeremonyTypes ;
    skos:prefLabel "Festive Board"@en , "Ordensmåltid"@sv , "Agapes"@fr , "Tafelloge"@de , "Agape fraterna"@it , "Ágape"@es , "Ágape"@pt , "Ünnepi asztal"@hu ;
    skos:definition "The ritual meal following a ceremony."@en , "Den rituella måltiden efter en ceremoni."@sv , "Le repas rituel qui suit une cérémonie."@fr , "Das rituelle Mahl im Anschluss an eine Zeremonie."@de , "Il pasto rituale che segue una cerimonia."@it , "La comida ritual que sigue a una ceremonia."@es , "A refeição ritual que se segue a uma cerimónia."@pt , "A szertartást követő rituális étkezés."@hu .

fraternalc:patronsFeast a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CeremonyTypes ; skos:topConceptOf fraternalc:CeremonyTypes ;
    skos:prefLabel "Patron's Feast"@en , "Patronshögtid"@sv , "Fête patronale"@fr , "Patronatsfest"@de , "Festa del patrono"@it , "Fiesta del patrón"@es , "Festa do patrono"@pt , "Védőszent ünnepe"@hu ;
    skos:definition "A feast in honour of the order's patron or namesake."@en , "En högtid till ära för ordens patron eller namngivare."@sv , "Fête en l'honneur du patron ou de l'éponyme de l'ordre."@fr , "Ein Fest zu Ehren des Schutzpatrons oder Namensgebers des Ordens."@de , "Una festa in onore del patrono o dell'eponimo dell'ordine."@it , "Una fiesta en honor del patrón de la orden o de aquel de quien toma el nombre."@es , "Uma festa em honra do patrono da ordem ou daquele de quem toma o nome."@pt , "A rend védőszentjének vagy névadójának tiszteletére tartott ünnep."@hu .

fraternalc:openMeeting a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CeremonyTypes ; skos:topConceptOf fraternalc:CeremonyTypes ;
    skos:prefLabel "Open Meeting"@en , "Öppen sammankomst"@sv , "Tenue blanche"@fr , "Offene Zusammenkunft"@de , "Tornata aperta"@it , "Reunión abierta"@es , "Reunião aberta"@pt , "Nyílt ülés"@hu ;
    skos:definition "A meeting of a lodge or order that non-members, such as relatives and friends, may attend; no ritual reserved for members is worked."@en ,
                    "En sammankomst i en loge eller orden dit icke-medlemmar, som anhöriga och vänner, får komma; ingen ritual som är förbehållen medlemmar utförs."@sv ,
                    "Réunion d'une loge ou d'un ordre à laquelle peuvent assister des non-membres, comme des proches et des amis ; aucun rituel réservé aux membres n'y est pratiqué."@fr ,
                    "Eine Zusammenkunft einer Loge oder eines Ordens, an der Nichtmitglieder, etwa Angehörige und Freunde, teilnehmen dürfen; es wird kein den Mitgliedern vorbehaltenes Ritual gearbeitet."@de ,
                    "Una riunione di una loggia o di un ordine a cui possono assistere i non soci, come parenti e amici; non vi si lavora alcun rituale riservato ai soci."@it ,
                    "Una reunión de una logia u orden a la que pueden asistir no miembros, como familiares y amigos; no se trabaja ningún ritual reservado a los miembros."@es ,
                    "Uma reunião de uma loja ou ordem a que podem assistir não membros, como familiares e amigos; não se trabalha nenhum ritual reservado aos membros."@pt ,
                    "Egy páholy vagy rend ülése, amelyen nem tagok, például hozzátartozók és barátok részt vehetnek; tagoknak fenntartott szertartást nem végeznek."@hu .

fraternalc:convent a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCeremonies ; skos:topConceptOf fraternalc:StudentenverbindungCeremonies ;
    skos:prefLabel "Convent"@en , "Konvent"@sv , "Convent"@de , "Convent"@it , "Convent"@fr , "Convent"@es , "Convent"@pt , "Konvent"@hu ;
    skos:altLabel "Konvent"@de ;
    skos:definition "The assembly of the members of a Studentenverbindung, held under formal rules, which decides its affairs: the Aktivenconvent (Corpsconvent) of the active members and the Philisterconvent (Altherrenconvent) of the alumni."@en ,
                    "Sammankomsten för en Studentenverbindungs medlemmar, hållen enligt formella regler, som beslutar i dess angelägenheter: Aktivenconvent (Corpsconvent) för de aktiva och Philisterconvent (Altherrenconvent) för alumnerna."@sv ,
                    "Die Versammlung der Mitglieder einer Studentenverbindung nach förmlichen Regeln, die über ihre Angelegenheiten entscheidet: der Aktivenconvent (Corpsconvent) der Aktiven und der Philisterconvent (Altherrenconvent) der Alten Herren."@de ,
                    "L'assemblea dei soci di una Studentenverbindung, tenuta secondo regole formali, che decide i suoi affari: l'Aktivenconvent (Corpsconvent) dei soci attivi e il Philisterconvent (Altherrenconvent) degli ex alunni."@it ,
                    "L'assemblée des membres d'une Studentenverbindung, tenue selon des règles formelles, qui décide de ses affaires : l'Aktivenconvent (Corpsconvent) des membres actifs et le Philisterconvent (Altherrenconvent) des anciens."@fr ,
                    "La asamblea de los miembros de una Studentenverbindung, celebrada con reglas formales, que decide sus asuntos: el Aktivenconvent (Corpsconvent) de los miembros activos y el Philisterconvent (Altherrenconvent) de los antiguos miembros."@es ,
                    "A assembleia dos membros de uma Studentenverbindung, realizada com regras formais, que decide os seus assuntos: o Aktivenconvent (Corpsconvent) dos membros ativos e o Philisterconvent (Altherrenconvent) dos antigos membros."@pt ,
                    "Egy Studentenverbindung tagjainak formális szabályok szerint tartott gyűlése, amely az ügyeiről dönt: az aktív tagok Aktivenconventje (Corpsconvent) és az öregdiákok Philisterconventje (Altherrenconvent)."@hu .

fraternalc:kneipe a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCeremonies ; skos:topConceptOf fraternalc:StudentenverbindungCeremonies ;
    skos:prefLabel "Kneipe"@en , "Kneipe"@sv , "Kneipe"@de , "Kneipe"@it , "Kneipe"@fr , "Kneipe"@es , "Kneipe"@pt , "Kneipe"@hu ;
    skos:altLabel "Kneipabend"@de ;
    skos:definition "A formal gathering of a Studentenverbindung with communal singing and drinking, held under the rules of the Kneipcomment and led by a presiding officer (Präses)."@en ,
                    "En formell sammankomst i en Studentenverbindung med allsång och dryckeslag, hållen enligt Kneipcomment och ledd av en ordförande (Präses)."@sv ,
                    "Eine förmliche Zusammenkunft einer Studentenverbindung mit gemeinsamem Singen und Trinken nach dem Kneipkomment unter der Leitung eines Präses."@de ,
                    "Un ritrovo formale di una Studentenverbindung con canto e bevute in comune, tenuto secondo le regole del Kneipcomment e guidato da un presidente (Präses)."@it ,
                    "Réunion formelle d'une Studentenverbindung avec chants et libations en commun, tenue selon les règles du Kneipcomment et dirigée par un président de séance (Präses)."@fr ,
                    "Una reunión formal de una Studentenverbindung con canto y bebida en común, celebrada según las reglas del Kneipcomment y dirigida por un presidente de mesa (Präses)."@es ,
                    "Uma reunião formal de uma Studentenverbindung com canto e bebida em comum, realizada segundo as regras do Kneipcomment e dirigida por um presidente de mesa (Präses)."@pt ,
                    "Egy Studentenverbindung formális összejövetele közös énekkel és itallal, a Kneipcomment szabályai szerint, elnöklő tisztségviselő (Präses) vezetésével."@hu .

fraternalc:kommers a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCeremonies ; skos:topConceptOf fraternalc:StudentenverbindungCeremonies ;
    skos:prefLabel "Kommers"@en , "Kommers"@sv , "Kommers"@de , "Kommers"@it , "Kommers"@fr , "Kommers"@es , "Kommers"@pt , "Kommers"@hu ;
    skos:altLabel "Festkommers"@de ;
    skos:definition "A festive and more ceremonial form of the Kneipe, with speeches, guests and traditional songs, held on occasions such as a Stiftungsfest."@en ,
                    "En festlig och mer ceremoniell form av Kneipe, med tal, gäster och traditionella sånger, hållen vid tillfällen som ett Stiftungsfest."@sv ,
                    "Eine festliche und feierlichere Form der Kneipe mit Reden, Gästen und traditionellen Liedern, abgehalten zu Anlässen wie einem Stiftungsfest."@de ,
                    "Una forma festiva e più cerimoniale della Kneipe, con discorsi, ospiti e canti tradizionali, tenuta in occasioni come uno Stiftungsfest."@it ,
                    "Forme festive et plus cérémonielle de la Kneipe, avec discours, invités et chants traditionnels, tenue à des occasions comme un Stiftungsfest."@fr ,
                    "Una forma festiva y más ceremonial de la Kneipe, con discursos, invitados y canciones tradicionales, celebrada en ocasiones como un Stiftungsfest."@es ,
                    "Uma forma festiva e mais cerimonial da Kneipe, com discursos, convidados e canções tradicionais, realizada em ocasiões como um Stiftungsfest."@pt ,
                    "A Kneipe ünnepi és szertartásosabb formája beszédekkel, vendégekkel és hagyományos dalokkal, olyan alkalmakon, mint egy Stiftungsfest."@hu .

fraternalc:stiftungsfest a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCeremonies ; skos:topConceptOf fraternalc:StudentenverbindungCeremonies ;
    skos:prefLabel "Stiftungsfest"@en , "Stiftungsfest"@sv , "Stiftungsfest"@de , "Stiftungsfest"@it , "Stiftungsfest"@fr , "Stiftungsfest"@es , "Stiftungsfest"@pt , "Stiftungsfest"@hu ;
    skos:altLabel "Foundation Festival"@en , "Stiftelsefest"@sv ;
    skos:definition "The yearly celebration of the foundation of a Studentenverbindung, usually with a Festkommers and often a service and a ball."@en ,
                    "Den årliga högtiden för grundandet av en Studentenverbindung, vanligen med en Festkommers och ofta en gudstjänst och en bal."@sv ,
                    "Die jährliche Feier der Gründung einer Studentenverbindung, meist mit einem Festkommers und oft mit Gottesdienst und Ball."@de ,
                    "La celebrazione annuale della fondazione di una Studentenverbindung, di solito con un Festkommers e spesso con una funzione religiosa e un ballo."@it ,
                    "La célébration annuelle de la fondation d'une Studentenverbindung, en général avec un Festkommers et souvent un office et un bal."@fr ,
                    "La celebración anual de la fundación de una Studentenverbindung, normalmente con un Festkommers y a menudo con un oficio religioso y un baile."@es ,
                    "A celebração anual da fundação de uma Studentenverbindung, normalmente com um Festkommers e muitas vezes com um ofício religioso e um baile."@pt ,
                    "Egy Studentenverbindung alapításának éves ünnepe, rendszerint Festkommersszel, és gyakran istentisztelettel és bállal."@hu .

fraternalc:mensur a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCeremonies ; skos:topConceptOf fraternalc:StudentenverbindungCeremonies ;
    skos:prefLabel "Mensur"@en , "Mensur"@sv , "Mensur"@de , "Mensur"@it , "Mensur"@fr , "Mensur"@es , "Mensur"@pt , "Mensur"@hu ;
    skos:altLabel "Academic Fencing Bout"@en , "Akademisk fäktning"@sv , "Partie"@de , "Bestimmungsmensur"@de ;
    skos:definition "A regulated academic fencing bout between members of two Studentenverbindungen, fought with sharp weapons (Schläger) and protective gear under strict rules, as a test of composure. Required in some traditions (see fraternalc:compulsoryFencing), rejected in others (see fraternalc:nonFencing)."@en ,
                    "En reglerad akademisk fäktning mellan medlemmar i två Studentenverbindungen, utkämpad med skarpa vapen (Schläger) och skyddsutrustning enligt stränga regler, som prov på behärskning. Krävs i vissa traditioner (se fraternalc:compulsoryFencing), avvisas i andra (se fraternalc:nonFencing)."@sv ,
                    "Eine geregelte akademische Fechtpartie zwischen Mitgliedern zweier Studentenverbindungen, mit scharfen Waffen (Schlägern) und Schutzausrüstung nach strengen Regeln als Probe der Selbstbeherrschung. In manchen Traditionen verlangt (siehe fraternalc:compulsoryFencing), in anderen abgelehnt (siehe fraternalc:nonFencing)."@de ,
                    "Un incontro regolato di scherma accademica tra soci di due Studentenverbindungen, combattuto con armi affilate (Schläger) e protezioni sotto regole rigorose, come prova di autocontrollo. Richiesta in alcune tradizioni (vedi fraternalc:compulsoryFencing), rifiutata in altre (vedi fraternalc:nonFencing)."@it ,
                    "Combat d'escrime académique réglementé entre membres de deux Studentenverbindungen, mené avec des armes tranchantes (Schläger) et des protections sous des règles strictes, comme épreuve de sang-froid. Exigée dans certaines traditions (voir fraternalc:compulsoryFencing), rejetée dans d'autres (voir fraternalc:nonFencing)."@fr ,
                    "Un asalto de esgrima académica reglamentado entre miembros de dos Studentenverbindungen, con armas afiladas (Schläger) y equipo de protección bajo reglas estrictas, como prueba de serenidad. Exigido en algunas tradiciones (véase fraternalc:compulsoryFencing), rechazado en otras (véase fraternalc:nonFencing)."@es ,
                    "Um assalto de esgrima académica regulamentado entre membros de duas Studentenverbindungen, com armas afiadas (Schläger) e equipamento de proteção sob regras estritas, como prova de serenidade. Exigido em algumas tradições (ver fraternalc:compulsoryFencing), rejeitado noutras (ver fraternalc:nonFencing)."@pt ,
                    "Két Studentenverbindung tagjai közötti szabályozott akadémiai vívás, éles fegyverekkel (Schläger) és védőfelszereléssel, szigorú szabályok szerint, a higgadtság próbájaként. Egyes hagyományokban kötelező (lásd fraternalc:compulsoryFencing), másokban elutasított (lásd fraternalc:nonFencing)."@hu .

fraternalc:rezeption a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCeremonies ; skos:topConceptOf fraternalc:StudentenverbindungCeremonies ;
    skos:prefLabel "Reception"@en , "Rezeption"@sv , "Rezeption"@de , "Ricezione"@it , "Réception"@fr , "Recepción"@es , "Receção"@pt , "Befogadás"@hu ;
    skos:altLabel "Rezeption als Fuchs"@de ;
    skos:definition "The ceremony in which a candidate is received into a Studentenverbindung as a Fuchs (see fraternalc:fuchs)."@en ,
                    "Ceremonin där en kandidat tas emot i en Studentenverbindung som Fuchs (se fraternalc:fuchs)."@sv ,
                    "Die Zeremonie, in der ein Kandidat als Fuchs in eine Studentenverbindung aufgenommen wird (siehe fraternalc:fuchs)."@de ,
                    "La cerimonia in cui un candidato è ricevuto in una Studentenverbindung come Fuchs (vedi fraternalc:fuchs)."@it ,
                    "La cérémonie par laquelle un candidat est reçu dans une Studentenverbindung comme Fuchs (voir fraternalc:fuchs)."@fr ,
                    "La ceremonia en la que un candidato es recibido en una Studentenverbindung como Fuchs (véase fraternalc:fuchs)."@es ,
                    "A cerimónia em que um candidato é recebido numa Studentenverbindung como Fuchs (ver fraternalc:fuchs)."@pt ,
                    "A szertartás, amelyben a jelöltet Fuchsként fogadják be egy Studentenverbindungba (lásd fraternalc:fuchs)."@hu .

fraternalc:burschung a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCeremonies ; skos:topConceptOf fraternalc:StudentenverbindungCeremonies ;
    skos:prefLabel "Burschung"@en , "Burschung"@sv , "Burschung"@de , "Burschung"@it , "Burschung"@fr , "Burschung"@es , "Burschung"@pt , "Burschung"@hu ;
    skos:altLabel "Burschenprüfung"@de ;
    skos:definition "The ceremony in which a Fuchs, after the probationary period (Fuchsenzeit) and the Burschenprüfung, becomes a Bursch with full rights (see fraternalc:bursch)."@en ,
                    "Ceremonin där en Fuchs, efter prövotiden (Fuchsenzeit) och Burschenprüfung, blir Bursch med fulla rättigheter (se fraternalc:bursch)."@sv ,
                    "Die Zeremonie, in der ein Fuchs nach der Probezeit (Fuchsenzeit) und der Burschenprüfung zum Burschen mit vollen Rechten wird (siehe fraternalc:bursch)."@de ,
                    "La cerimonia in cui un Fuchs, dopo il periodo di prova (Fuchsenzeit) e la Burschenprüfung, diventa Bursch con pieni diritti (vedi fraternalc:bursch)."@it ,
                    "La cérémonie par laquelle un Fuchs, après la période probatoire (Fuchsenzeit) et la Burschenprüfung, devient Bursch à part entière (voir fraternalc:bursch)."@fr ,
                    "La ceremonia en la que un Fuchs, tras el período de prueba (Fuchsenzeit) y la Burschenprüfung, pasa a ser Bursch con plenos derechos (véase fraternalc:bursch)."@es ,
                    "A cerimónia em que um Fuchs, depois do período de prova (Fuchsenzeit) e da Burschenprüfung, passa a Bursch com plenos direitos (ver fraternalc:bursch)."@pt ,
                    "A szertartás, amelyben a Fuchs a próbaidő (Fuchsenzeit) és a Burschenprüfung után teljes jogú Burschsá válik (lásd fraternalc:bursch)."@hu .

fraternalc:philistrierung a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCeremonies ; skos:topConceptOf fraternalc:StudentenverbindungCeremonies ;
    skos:prefLabel "Philistration"@en , "Philistrering"@sv , "Philistrierung"@de , "Philistrierung"@it , "Philistration"@fr , "Philistrierung"@es , "Philistrierung"@pt , "Philistrierung"@hu ;
    skos:altLabel "Philistration"@de ;
    skos:definition "The ceremony in which a Bursch becomes an Alter Herr (Philister), usually on leaving the active branch after his studies (see fraternalc:alterHerr)."@en ,
                    "Ceremonin där en Bursch blir Alter Herr (Philister), vanligen när han lämnar aktivitas efter sina studier (se fraternalc:alterHerr)."@sv ,
                    "Die Zeremonie, in der ein Bursch zum Alten Herrn (Philister) wird, meist beim Ausscheiden aus der Aktivitas nach dem Studium (siehe fraternalc:alterHerr)."@de ,
                    "La cerimonia in cui un Bursch diventa Alter Herr (Philister), di solito quando lascia il ramo attivo dopo gli studi (vedi fraternalc:alterHerr)."@it ,
                    "La cérémonie par laquelle un Bursch devient Alter Herr (Philister), en général en quittant la branche active après ses études (voir fraternalc:alterHerr)."@fr ,
                    "La ceremonia en la que un Bursch pasa a ser Alter Herr (Philister), normalmente al dejar la rama activa tras sus estudios (véase fraternalc:alterHerr)."@es ,
                    "A cerimónia em que um Bursch passa a Alter Herr (Philister), normalmente ao deixar o ramo ativo depois dos estudos (ver fraternalc:alterHerr)."@pt ,
                    "A szertartás, amelyben a Bursch Alter Herrré (Philisterré) válik, rendszerint a tanulmányok utáni távozáskor az aktív ágból (lásd fraternalc:alterHerr)."@hu .

fraternalc:fackelzug a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCeremonies ; skos:topConceptOf fraternalc:StudentenverbindungCeremonies ;
    skos:prefLabel "Torchlight Procession"@en , "Fackeltåg"@sv , "Fackelzug"@de , "Fiaccolata"@it , "Cortège aux flambeaux"@fr , "Desfile de antorchas"@es , "Desfile de tochas"@pt , "Fáklyás felvonulás"@hu ;
    skos:definition "A torchlit procession of a Studentenverbindung, held on festive occasions such as a Stiftungsfest or a university anniversary."@en ,
                    "Ett fackeltåg för en Studentenverbindung, hållet vid festliga tillfällen som ett Stiftungsfest eller ett universitetsjubileum."@sv ,
                    "Ein Umzug einer Studentenverbindung mit Fackeln zu festlichen Anlässen wie einem Stiftungsfest oder einem Universitätsjubiläum."@de ,
                    "Un corteo con le fiaccole di una Studentenverbindung, tenuto in occasioni festive come uno Stiftungsfest o un anniversario dell'università."@it ,
                    "Cortège aux flambeaux d'une Studentenverbindung, organisé à des occasions festives comme un Stiftungsfest ou un anniversaire de l'université."@fr ,
                    "Un desfile con antorchas de una Studentenverbindung, celebrado en ocasiones festivas como un Stiftungsfest o un aniversario de la universidad."@es ,
                    "Um desfile com tochas de uma Studentenverbindung, realizado em ocasiões festivas como um Stiftungsfest ou um aniversário da universidade."@pt ,
                    "Egy Studentenverbindung fáklyás felvonulása ünnepi alkalmakkor, mint egy Stiftungsfest vagy az egyetem évfordulója."@hu .

fraternalc:investiture a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CeremonyTypes ; skos:topConceptOf fraternalc:CeremonyTypes ;
    skos:prefLabel "Investiture"@en , "Investitur"@sv , "Investiture"@fr , "Investitur"@de , "Investitura"@it , "Investidura"@es , "Investidura"@pt , "Beiktatás"@hu ;
    skos:definition "The ceremony in which a member is invested with the insignia and rank of an order, such as a knighting or the award of a grade."@en ,
                    "Ceremonin där en medlem iklädes en ordens insignier och rang, till exempel ett riddarslag eller tilldelningen av en grad."@sv ,
                    "La cérémonie où un membre est investi des insignes et du rang d'un ordre, comme un adoubement ou la remise d'un grade."@fr ,
                    "Die Zeremonie, in der ein Mitglied mit den Insignien und dem Rang eines Ordens bekleidet wird, etwa ein Ritterschlag oder die Verleihung einer Stufe."@de ,
                    "La cerimonia in cui un membro è investito delle insegne e del rango di un ordine, come un'investitura a cavaliere o il conferimento di un grado."@it ,
                    "La ceremonia en la que se inviste a un miembro con las insignias y el rango de una orden, como el armado de un caballero o la concesión de un grado."@es ,
                    "A cerimónia em que se investe um membro com as insígnias e o grau de uma ordem, como o armar de um cavaleiro ou a atribuição de um grau."@pt ,
                    "A szertartás, amelyben egy tagot egy rend jelvényeivel és rangjával ruháznak fel, például lovaggá ütéssel vagy fokozat adományozásával."@hu .

fraternalc:consecration a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CeremonyTypes ; skos:topConceptOf fraternalc:CeremonyTypes ;
    skos:prefLabel "Consecration"@en , "Invigning"@sv , "Consécration"@fr , "Weihe"@de , "Consacrazione"@it , "Consagración"@es , "Consagração"@pt , "Felszentelés"@hu ;
    skos:definition "The ceremony in which a lodge, a temple, a flag or another object of an order is dedicated, or a new lodge is constituted."@en ,
                    "Ceremonin där en loge, ett tempel, en fana eller ett annat föremål tillhörande en orden invigs, eller en ny loge konstitueras."@sv ,
                    "La cérémonie où une loge, un temple, un drapeau ou un autre objet d'un ordre est consacré, ou une nouvelle loge constituée."@fr ,
                    "Die Zeremonie, in der eine Loge, ein Tempel, eine Fahne oder ein anderer Gegenstand eines Ordens geweiht oder eine neue Loge konstituiert wird."@de ,
                    "La cerimonia in cui una loggia, un tempio, una bandiera o un altro oggetto di un ordine è consacrato, o una nuova loggia è costituita."@it ,
                    "La ceremonia en la que se dedica una logia, un templo, una bandera u otro objeto de una orden, o se constituye una nueva logia."@es ,
                    "A cerimónia em que se dedica uma loja, um templo, uma bandeira ou outro objeto de uma ordem, ou se constitui uma nova loja."@pt ,
                    "A szertartás, amelyben egy páholyt, templomot, zászlót vagy a rend más tárgyát felavatják, vagy új páholyt alapítanak."@hu .

##############################################################################
# 6. INSIGNIA TYPES  (mapped to Getty AAT in mappings/fraternal-aat.sssom.tsv)
##############################################################################

fraternalc:InsigniaTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Insignia Types"@en , "Insignietyper"@sv , "Types d'insignes"@fr , "Insignienarten"@de , "Tipi di insegne"@it , "Tipos de insignia"@es , "Tipos de insígnia"@pt , "Jelvénytípusok"@hu ;
    skos:definition "Kinds of badge, garment and other object worn or carried as a sign of membership, degree or office. Used with fraternal:insigniaType."@en ,
                    "Slag av märken, plagg och andra föremål som bärs som tecken på medlemskap, grad eller ämbete. Används med fraternal:insigniaType."@sv ,
                    "Types d'insignes, de vêtements et d'autres objets portés comme signe d'appartenance, de degré ou de fonction. S'utilise avec fraternal:insigniaType."@fr ,
                    "Arten von Abzeichen, Kleidungsstücken und anderen Gegenständen, die als Zeichen der Mitgliedschaft, eines Grades oder eines Amtes getragen werden. Wird mit fraternal:insigniaType verwendet."@de ,
                    "Tipi di insegne, indumenti e altri oggetti portati come segno di appartenenza, di grado o di carica. Si usa con fraternal:insigniaType."@it ,
                    "Tipos de distintivo, prenda y otro objeto que se lleva o porta como signo de pertenencia, grado o cargo. Se usa con fraternal:insigniaType."@es ,
                    "Tipos de distintivo, peça de vestuário e outro objeto que se usa ou leva como sinal de filiação, grau ou cargo. Usa-se com fraternal:insigniaType."@pt ,
                    "A jelvények, ruhadarabok és más tárgyak fajtái, amelyeket a tagság, fokozat vagy tisztség jeleként viselnek vagy hordanak. A fraternal:insigniaType-pal használatos."@hu ;
    skos:hasTopConcept fraternalc:apron , fraternalc:collar , fraternalc:sash , fraternalc:jewel ,
                       fraternalc:ribbon , fraternalc:ring , fraternalc:pin , fraternalc:hat ,
                       fraternalc:sword , fraternalc:breastStar , fraternalc:cross , fraternalc:rosette ,
                       fraternalc:staff ,
                       fraternalc:robe , fraternalc:banner , fraternalc:gavel .

fraternalc:apron a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Apron"@en , "Förkläde"@sv , "Tablier"@fr , "Schurz"@de , "Grembiule"@it , "Mandil"@es , "Avental"@pt , "Kötény"@hu ;
    skos:definition "An apron worn as regalia, especially in masonic orders."@en ,
                    "Ett förkläde som bärs som ordensdräkt, särskilt i frimurarordnar."@sv ,
                    "Tablier porté comme tenue, surtout dans les ordres maçonniques."@fr ,
                    "Ein als Ordenskleidung getragener Schurz, besonders in freimaurerischen Orden."@de ,
                    "Un grembiule portato come paramento, soprattutto negli ordini massonici."@it ,
                    "Un mandil que se lleva como regalía, especialmente en las órdenes masónicas."@es ,
                    "Um avental que se usa como regalia, especialmente nas ordens maçónicas."@pt ,
                    "Ékességként viselt kötény, különösen a szabadkőműves rendekben."@hu .

fraternalc:collar a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Collar"@en , "Ordenskedja"@sv , "Collier"@fr , "Kollane"@de , "Collare"@it , "Collar"@es , "Colar"@pt , "Lánc"@hu ;
    skos:altLabel "Chain"@en , "Krage"@sv , "Chaîne"@fr , "Catena"@it ;
    skos:definition "A chain or collar of links worn over the shoulders with the badge hanging from it: the highest form of an order's insignia, also used as a chain of office."@en ,
                    "En kedja av länkar som bärs över axlarna med ordenstecknet hängande i den: den förnämsta formen av ordenstecken, även använd som ämbetskedja."@sv ,
                    "Chaîne ou collier de maillons porté sur les épaules, d'où pend l'insigne : la forme la plus haute des insignes d'un ordre, aussi utilisée comme chaîne de fonction."@fr ,
                    "Eine Kette oder ein Kragen aus Gliedern, die über den Schultern getragen werden und an der das Abzeichen hängt: die höchste Form der Insignien eines Ordens, auch als Amtskette verwendet."@de ,
                    "Una catena o un collare di anelli portato sulle spalle con il distintivo che ne pende: la forma più alta delle insegne di un ordine, usata anche come catena di carica."@it ,
                    "Una cadena o collar de eslabones que se lleva sobre los hombros con la insignia colgada de él: la forma más alta de las insignias de una orden, usada también como cadena de cargo."@es ,
                    "Uma corrente ou colar de elos que se usa sobre os ombros com a insígnia pendente dele: a forma mais alta das insígnias de uma ordem, usada também como cadeia de cargo."@pt ,
                    "A vállon viselt láncszemekből álló lánc, rajta függő jelvénnyel: a rend jelvényeinek legmagasabb formája, hivatali láncként is használatos."@hu .

fraternalc:sash a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Sash"@en , "Storkorsband"@sv , "Écharpe"@fr , "Schärpe"@de , "Banda"@it , "Banda"@es , "Banda"@pt , "Vállszalag"@hu ;
    skos:altLabel "Riband"@en , "Gradband"@sv , "Band en écharpe"@sv , "Grand cordon"@fr , "Fascia"@it ;
    skos:definition "A wide ribbon worn over one shoulder and across the chest to the opposite hip, where the badge rests: the grand cross sash of an order of chivalry, or the degree sash of an order society."@en ,
                    "Ett brett band som bärs över ena axeln och diagonalt över bröstet till motsatt höft, där ordenstecknet vilar: en riddarordens storkorsband eller ett ordenssällskaps gradband."@sv ,
                    "Large ruban porté sur une épaule et en travers de la poitrine jusqu'à la hanche opposée, où repose l'insigne : l'écharpe de grand-croix d'un ordre de chevalerie, ou l'écharpe de degré d'une société d'ordre."@fr ,
                    "Ein breites Band, das über einer Schulter und quer über die Brust zur gegenüberliegenden Hüfte getragen wird, wo das Abzeichen ruht: die Großkreuzschärpe eines Ritterordens oder die Gradschärpe einer Ordensgesellschaft."@de ,
                    "Un largo nastro portato su una spalla e attraverso il petto fino al fianco opposto, dove poggia il distintivo: la banda di gran croce di un ordine cavalleresco o la banda di grado di una società d'ordine."@it ,
                    "Una cinta ancha que se lleva sobre un hombro y cruzando el pecho hasta la cadera opuesta, donde descansa la insignia: la banda de gran cruz de una orden de caballería, o la banda de grado de una sociedad de orden."@es ,
                    "Uma fita larga que se usa sobre um ombro e atravessada no peito até à anca oposta, onde descansa a insígnia: a banda de grã-cruz de uma ordem de cavalaria, ou a banda de grau de uma sociedade de ordem."@pt ,
                    "Széles szalag, amelyet egyik vállon és a mellkason át a másik csípőig viselnek, ahol a jelvény nyugszik: a lovagrend nagykeresztjének szalagja vagy egy rendtársaság fokozati szalagja."@hu .

fraternalc:jewel a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Jewel"@en , "Juvel"@sv , "Bijou"@fr , "Juwel"@de , "Gioiello"@it , "Joya"@es , "Joia"@pt , "Ékszer"@hu ;
    skos:altLabel "Pendant"@en , "Hängsmycke"@sv , "Pendentif"@fr , "Pendente"@it ;
    skos:definition "A badge or pendant of a degree or office, usually worn on a collar or ribbon."@en ,
                    "Ett tecken eller hängsmycke för en grad eller ett ämbete, vanligen buret i kedja eller band."@sv ,
                    "Insigne ou pendentif d'un degré ou d'une fonction, porté en général à un collier ou à un ruban."@fr ,
                    "Ein Abzeichen oder Anhänger eines Grades oder Amtes, meist an einer Kollane oder einem Band getragen."@de ,
                    "Un distintivo o pendente di un grado o di una carica, di solito portato su un collare o su un nastro."@it ,
                    "Una insignia o colgante de un grado o cargo, normalmente llevado en un collar o cinta."@es ,
                    "Uma insígnia ou pendente de um grau ou cargo, normalmente usado num colar ou fita."@pt ,
                    "Fokozat vagy tisztség jelvénye vagy függője, rendszerint láncon vagy szalagon viselve."@hu .

fraternalc:ribbon a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Ribbon"@en , "Band"@sv , "Ruban"@fr , "Band"@de , "Nastro"@it , "Cinta"@es , "Fita"@pt , "Szalag"@hu ;
    skos:altLabel "Ordensband"@sv ;
    skos:definition "A ribbon in an order's colours on which a badge or medal is worn at the neck or on the breast; also worn on its own as a sign of membership."@en ,
                    "Ett band i ordens färger där ett tecken eller en medalj bärs i halsen eller på bröstet; bärs även ensamt som tecken på medlemskap."@sv ,
                    "Ruban aux couleurs d'un ordre auquel est suspendu un insigne ou une médaille, au cou ou sur la poitrine ; porté aussi seul comme signe d'appartenance."@fr ,
                    "Ein Band in den Farben eines Ordens, an dem ein Abzeichen oder eine Medaille am Hals oder auf der Brust getragen wird; auch allein als Zeichen der Mitgliedschaft getragen."@de ,
                    "Un nastro nei colori di un ordine su cui si porta un distintivo o una medaglia al collo o sul petto; si porta anche da solo come segno di appartenenza."@it ,
                    "Una cinta con los colores de una orden de la que se lleva una insignia o medalla al cuello o en el pecho; se lleva también sola como signo de pertenencia."@es ,
                    "Uma fita com as cores de uma ordem de que se usa uma insígnia ou medalha ao pescoço ou no peito; usa-se também só como sinal de filiação."@pt ,
                    "A rend színeiben szalag, amelyen jelvényt vagy érmet viselnek a nyakban vagy a mellen; önmagában is viselik a tagság jeleként."@hu .

fraternalc:ring a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Ring"@en , "Ordensring"@sv , "Bague"@fr , "Ring"@de , "Anello"@it , "Anillo"@es , "Anel"@pt , "Gyűrű"@hu ;
    skos:definition "A finger ring worn as a sign of full membership or of a degree, usually on the right middle finger."@en ,
                    "En fingerring som bärs som tecken på fullvärdigt medlemskap eller på en grad, vanligen på höger långfinger."@sv ,
                    "Bague portée comme signe de plein statut de membre ou d'un degré, en général au majeur de la main droite."@fr ,
                    "Ein Fingerring, getragen als Zeichen der Vollmitgliedschaft oder eines Grades, meist am Mittelfinger der rechten Hand."@de ,
                    "Un anello portato al dito come segno di piena appartenenza o di un grado, di solito al medio della mano destra."@it ,
                    "Un anillo de dedo que se lleva como signo de pertenencia plena o de un grado, normalmente en el dedo corazón de la mano derecha."@es ,
                    "Um anel de dedo que se usa como sinal de filiação plena ou de um grau, normalmente no dedo médio da mão direita."@pt ,
                    "Ujjgyűrű, amelyet a teljes tagság vagy egy fokozat jeleként viselnek, rendszerint a jobb kéz középső ujján."@hu .

fraternalc:pin a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Lapel Pin"@en , "Ordensnål"@sv , "Épinglette"@fr , "Anstecknadel"@de , "Spilla da bavero"@it , "Pin de solapa"@es , "Pin de lapela"@pt , "Hajtókatű"@hu ;
    skos:altLabel "Pin"@en , "Föreningsnål"@sv , "Pin"@sv , "Pin's"@fr , "Pin"@it ;
    skos:definition "A small badge fixed to the lapel, worn inside and outside the order as a sign of membership."@en ,
                    "Ett litet märke som fästs på kavajslaget och bärs både inom och utanför orden som tecken på medlemskap."@sv ,
                    "Petit insigne fixé au revers du veston, porté dans l'ordre et en dehors comme signe d'appartenance."@fr ,
                    "Ein kleines Abzeichen am Revers, innerhalb und außerhalb des Ordens als Zeichen der Mitgliedschaft getragen."@de ,
                    "Un piccolo distintivo fissato al bavero, portato dentro e fuori dall'ordine come segno di appartenenza."@it ,
                    "Una pequeña insignia fijada a la solapa, que se lleva dentro y fuera de la orden como signo de pertenencia."@es ,
                    "Um pequeno distintivo preso à lapela, que se usa dentro e fora da ordem como sinal de filiação."@pt ,
                    "A hajtókára tűzött kis jelvény, amelyet a renden belül és kívül a tagság jeleként viselnek."@hu .

fraternalc:hat a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Hat"@en , "Hatt"@sv , "Chapeau"@fr , "Hut"@de , "Cappello"@it , "Sombrero"@es , "Chapéu"@pt , "Kalap"@hu ;
    skos:definition "A hat or other headwear worn as regalia."@en ,
                    "En hatt eller annan huvudbonad som bärs som ordensdräkt."@sv ,
                    "Chapeau ou autre coiffure portée comme tenue."@fr ,
                    "Ein Hut oder eine andere Kopfbedeckung, getragen als Ordenskleidung."@de ,
                    "Un cappello o altro copricapo portato come paramento."@it ,
                    "Un sombrero u otro tocado que se lleva como regalía."@es ,
                    "Um chapéu ou outro toucado que se usa como regalia."@pt ,
                    "Ékességként viselt kalap vagy más fejfedő."@hu .

fraternalc:sword a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Sword"@en , "Svärd"@sv , "Épée"@fr , "Schwert"@de , "Spada"@it , "Espada"@es , "Espada"@pt , "Kard"@hu ;
    skos:definition "A sword worn or carried as regalia, or used in ceremonies such as dubbing."@en ,
                    "Ett svärd som bärs som ordensdräkt eller används vid ceremonier, t.ex. dubbning."@sv ,
                    "Épée portée ou tenue comme élément de tenue, ou utilisée dans des cérémonies comme l'adoubement."@fr ,
                    "Ein Schwert, getragen oder geführt als Ordenskleidung oder bei Zeremonien wie dem Ritterschlag verwendet."@de ,
                    "Una spada portata o impugnata come paramento, o usata in cerimonie come l'investitura a cavaliere."@it ,
                    "Una espada que se lleva o porta como regalía, o se usa en ceremonias como el espaldarazo."@es ,
                    "Uma espada que se usa ou leva como regalia, ou se utiliza em cerimónias como o armar cavaleiro."@pt ,
                    "Ékességként viselt vagy hordott kard, vagy szertartásokon, például a lovaggá ütésnél használt."@hu .

fraternalc:breastStar a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Breast Star"@en , "Kraschan"@sv , "Plaque"@fr , "Bruststern"@de , "Placca"@it , "Placa"@es , "Placa"@pt , "Mellcsillag"@hu ;
    skos:altLabel "Plaque"@en , "Étoile de poitrine"@fr , "Stella"@it ;
    skos:definition "A star-shaped badge worn on the breast, usually the left, by the higher grades of an order."@en ,
                    "Ett stjärnformat ordenstecken som bärs på bröstet, vanligen det vänstra, av en ordens högre grader."@sv ,
                    "Insigne en forme d'étoile porté sur la poitrine, en général à gauche, par les grades supérieurs d'un ordre."@fr ,
                    "Ein sternförmiges Abzeichen, auf der Brust getragen, meist links, von den höheren Stufen eines Ordens."@de ,
                    "Un distintivo a forma di stella portato sul petto, di solito a sinistra, dai gradi superiori di un ordine."@it ,
                    "Una insignia en forma de estrella que se lleva en el pecho, normalmente a la izquierda, en los grados superiores de una orden."@es ,
                    "Um distintivo em forma de estrela que se usa no peito, normalmente à esquerda, nos graus superiores de uma ordem."@pt ,
                    "A mellkason, rendszerint balra viselt csillag alakú jelvény egy rend magasabb fokozatainak."@hu .

fraternalc:cross a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Cross"@en , "Kors"@sv , "Croix"@fr , "Kreuz"@de , "Croce"@it , "Cruz"@es , "Cruz"@pt , "Kereszt"@hu ;
    skos:definition "Cross-shaped badge of an order, worn at the neck or on the breast."@en ,
                    "Korsformat ordenstecken, buret i halsen eller på bröstet."@sv ,
                    "Insigne en forme de croix d'un ordre, porté au cou ou sur la poitrine."@fr ,
                    "Kreuzförmiges Abzeichen eines Ordens, am Hals oder auf der Brust getragen."@de ,
                    "Il distintivo a forma di croce di un ordine, portato al collo o sul petto."@it ,
                    "Insignia en forma de cruz de una orden, que se lleva al cuello o en el pecho."@es ,
                    "Distintivo em forma de cruz de uma ordem, que se usa ao pescoço ou no peito."@pt ,
                    "Egy rend kereszt alakú jelvénye, nyakban vagy mellen viselve."@hu .

fraternalc:rosette a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Rosette"@en , "Rosett"@sv , "Rosette"@fr , "Rosette"@de , "Rosetta"@it , "Roseta"@es , "Roseta"@pt , "Rozetta"@hu ;
    skos:definition "A small rosette of pleated ribbon in the order's colours, worn on the lapel. In some orders of chivalry it marks the higher grades, while the lowest grade wears a plain ribbon."@en ,
                    "En liten rosett av vecklat band i ordens färger, buren på kavajslaget. I vissa riddarordnar markerar den de högre graderna, medan den lägsta graden bär ett enkelt band."@sv ,
                    "Petite rosette de ruban plissé aux couleurs de l'ordre, portée à la boutonnière. Dans certains ordres, elle marque les grades supérieurs, le grade le plus bas portant un simple ruban."@fr ,
                    "Eine kleine Rosette aus plissiertem Band in den Farben des Ordens, am Revers getragen. In manchen Ritterorden kennzeichnet sie die höheren Grade, während der niedrigste Grad ein schlichtes Band trägt."@de ,
                    "Una piccola rosetta di nastro plissettato nei colori dell'ordine, portata sul bavero. In alcuni ordini cavallereschi segna i gradi superiori, mentre il grado più basso porta un semplice nastrino."@it ,
                    "Una pequeña roseta de cinta plisada con los colores de la orden, que se lleva en la solapa. En algunas órdenes de caballería marca los grados superiores, mientras que el grado más bajo lleva una cinta lisa."@es ,
                    "Uma pequena roseta de fita pregueada com as cores da ordem, que se usa na lapela. Em algumas ordens de cavalaria marca os graus superiores, enquanto o grau mais baixo usa uma fita lisa."@pt ,
                    "A rend színeiben redőzött szalagból készült kis rozetta, a hajtókán viselve. Egyes lovagrendekben a magasabb fokozatokat jelöli, míg a legalacsonyabb fokozat sima szalagot visel."@hu .

fraternalc:staff a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Staff"@en , "Stav"@sv , "Canne"@fr , "Stab"@de , "Bastone"@it , "Bastón"@es , "Bastão"@pt , "Bot"@hu ;
    skos:altLabel "Walking Staff"@en , "Cane"@en , "Vandringsstav"@sv ;
    skos:definition "A staff or cane received at reception and carried as a sign of membership, as the compagnons carry theirs; it stands for the travelling life of the trade."@en ,
                    "En stav eller käpp som tas emot vid upptagningen och bärs som tecken på medlemskap, som compagnons bär sin; den står för yrkets vandringsliv."@sv ,
                    "Bâton ou canne reçu lors de la réception et porté comme signe d'appartenance, comme le font les compagnons ; il représente la vie itinérante du métier."@fr ,
                    "Ein Stab oder Stock, der bei der Aufnahme empfangen und als Zeichen der Mitgliedschaft getragen wird, wie ihn die Compagnons tragen; er steht für das Wanderleben des Gewerbes."@de ,
                    "Un bastone ricevuto alla ricezione e portato come segno di appartenenza, come lo portano i compagnons; rappresenta la vita itinerante del mestiere."@it ,
                    "Un bastón recibido en la recepción y portado como signo de pertenencia, como lo portan los compagnons; representa la vida viajera del oficio."@es ,
                    "Um bastão recebido na receção e levado como sinal de filiação, como o levam os compagnons; representa a vida viajante do ofício."@pt ,
                    "A befogadáskor kapott és a tagság jeleként hordott bot vagy sétapálca, ahogy a compagnonok hordják; a mesterség vándorlét életét jelképezi."@hu .

fraternalc:couleurband a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungInsignia ; skos:topConceptOf fraternalc:StudentenverbindungInsignia ;
    skos:prefLabel "Colour Band"@en , "Färgband"@sv , "Couleurband"@de , "Nastro dei colori"@it , "Bande aux couleurs"@fr , "Banda de colores"@es , "Banda de cores"@pt , "Színes szalag"@hu ;
    skos:altLabel "Burschenband"@de , "Couleur Ribbon"@en ;
    skos:definition "The ribbon in the colours (Farben) of a Studentenverbindung, worn across the chest as the sign of membership. Usually in three colours, with a narrow Fuchsenband for a Fuchs."@en ,
                    "Bandet i en Studentenverbindungs färger (Farben), som bärs diagonalt över bröstet som tecken på medlemskap. Vanligen i tre färger, med ett smalare Fuchsenband för en Fuchs."@sv ,
                    "Das Band in den Farben einer Studentenverbindung, quer über die Brust getragen als Zeichen der Mitgliedschaft. Meist dreifarbig, für einen Fuchs ein schmaleres Fuchsenband."@de ,
                    "Il nastro nei colori (Farben) di una Studentenverbindung, portato attraverso il petto come segno di appartenenza. Di solito di tre colori, con uno stretto Fuchsenband per un Fuchs."@it ,
                    "Le ruban aux couleurs (Farben) d'une Studentenverbindung, porté en travers de la poitrine comme signe d'appartenance. En général de trois couleurs, avec un étroit Fuchsenband pour un Fuchs."@fr ,
                    "La cinta con los colores (Farben) de una Studentenverbindung, que se lleva cruzada sobre el pecho como signo de pertenencia. Suele ser de tres colores, con un Fuchsenband más estrecho para un Fuchs."@es ,
                    "A fita com as cores (Farben) de uma Studentenverbindung, que se usa atravessada no peito como sinal de filiação. Costuma ser de três cores, com um Fuchsenband mais estreito para um Fuchs."@pt ,
                    "A Studentenverbindung színeiben (Farben) szalag, amelyet a mellkason átlósan viselnek a tagság jeleként. Rendszerint háromszínű, a Fuchs számára keskenyebb Fuchsenbanddal."@hu .

fraternalc:cerevis a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungInsignia ; skos:topConceptOf fraternalc:StudentenverbindungInsignia ;
    skos:prefLabel "Cerevis"@en , "Cerevis"@sv , "Cerevis"@de , "Cerevis"@it , "Cerevis"@fr , "Cerevis"@es , "Cerevis"@pt , "Cerevis"@hu ;
    skos:altLabel "Student Cap"@en , "Studentenmütze"@de , "Mütze"@de , "Kappe"@de ;
    skos:definition "The small round cap in the colours of a Studentenverbindung, worn together with the colour band."@en ,
                    "Den lilla runda mössan i en Studentenverbindungs färger, som bärs tillsammans med färgbandet."@sv ,
                    "Die kleine runde Mütze in den Farben einer Studentenverbindung, zusammen mit dem Band getragen."@de ,
                    "Il piccolo berretto rotondo nei colori di una Studentenverbindung, portato insieme al nastro dei colori."@it ,
                    "La petite calotte ronde aux couleurs d'une Studentenverbindung, portée avec la bande aux couleurs."@fr ,
                    "El pequeño gorro redondo con los colores de una Studentenverbindung, que se lleva junto con la banda de colores."@es ,
                    "O pequeno barrete redondo com as cores de uma Studentenverbindung, que se usa junto com a banda de cores."@pt ,
                    "A Studentenverbindung színeiben kis kerek sapka, a színes szalaggal együtt viselve."@hu .

fraternalc:schlaeger a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungInsignia ; skos:topConceptOf fraternalc:StudentenverbindungInsignia ;
    skos:prefLabel "Schläger"@en , "Schläger"@sv , "Schläger"@de , "Schläger"@it , "Schläger"@fr , "Schläger"@es , "Schläger"@pt , "Schläger"@hu ;
    skos:altLabel "Fencing Weapon"@en , "Korbschläger"@de , "Glockenschläger"@de ;
    skos:definition "The straight-bladed fencing weapon used in the Mensur, also worn with the full dress of a Studentenverbindung."@en ,
                    "Det raka fäktvapnet som används vid mensur och som även bärs till en Studentenverbindungs högtidsdräkt."@sv ,
                    "Die gerade Fechtwaffe der Mensur, die auch zur Festkleidung einer Studentenverbindung getragen wird."@de ,
                    "L'arma da scherma a lama dritta usata nella Mensur, portata anche con l'abito di gala di una Studentenverbindung."@it ,
                    "L'arme d'escrime à lame droite employée dans la Mensur, portée aussi avec la grande tenue d'une Studentenverbindung."@fr ,
                    "El arma de esgrima de hoja recta que se usa en la Mensur, llevada también con el traje de gala de una Studentenverbindung."@es ,
                    "A arma de esgrima de lâmina reta que se usa na Mensur, levada também com o traje de gala de uma Studentenverbindung."@pt ,
                    "A Mensurban használt egyenes pengéjű vívófegyver, a Studentenverbindung díszruhájához is viselve."@hu .

fraternalc:wichs a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungInsignia ; skos:topConceptOf fraternalc:StudentenverbindungInsignia ;
    skos:prefLabel "Wichs"@en , "Wichs"@sv , "Wichs"@de , "Wichs"@it , "Wichs"@fr , "Wichs"@es , "Wichs"@pt , "Wichs"@hu ;
    skos:altLabel "Vollwichs"@de , "Full Dress of a Studentenverbindung"@en ;
    skos:definition "The full ceremonial dress of a member of a Studentenverbindung, with jacket, cap, colour band and Schläger, worn at the Kommers and other festive occasions."@en ,
                    "Högtidsdräkten för en medlem i en Studentenverbindung, med jacka, mössa, färgband och Schläger, som bärs vid Kommers och andra festliga tillfällen."@sv ,
                    "Die Festkleidung eines Mitglieds einer Studentenverbindung mit Jacke, Mütze, Band und Schläger, getragen beim Kommers und bei anderen festlichen Anlässen."@de ,
                    "L'abito completo di gala di un socio di una Studentenverbindung, con giacca, berretto, nastro dei colori e Schläger, portato al Kommers e in altre occasioni festive."@it ,
                    "La grande tenue de cérémonie d'un membre d'une Studentenverbindung, avec veste, calotte, bande aux couleurs et Schläger, portée au Kommers et à d'autres occasions festives."@fr ,
                    "El traje ceremonial completo de un miembro de una Studentenverbindung, con chaqueta, gorro, banda de colores y Schläger, que se lleva en el Kommers y otras ocasiones festivas."@es ,
                    "O traje cerimonial completo de um membro de uma Studentenverbindung, com casaco, barrete, banda de cores e Schläger, que se usa no Kommers e noutras ocasiões festivas."@pt ,
                    "Egy Studentenverbindung tagjának teljes ünnepi öltözete dzsekivel, sapkával, színes szalaggal és Schlägerrel, a Kommersen és más ünnepi alkalmakon viselve."@hu .

fraternalc:zipfel a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungInsignia ; skos:topConceptOf fraternalc:StudentenverbindungInsignia ;
    skos:prefLabel "Zipfel"@en , "Zipfel"@sv , "Zipfel"@de , "Zipfel"@it , "Zipfel"@fr , "Zipfel"@es , "Zipfel"@pt , "Zipfel"@hu ;
    skos:altLabel "Bierzipfel"@de , "Friendship Token"@en ;
    skos:definition "A small token in the colours of a Studentenverbindung on a chain or cord, exchanged as a sign of friendship between members of different Verbindungen."@en ,
                    "Ett litet tecken i en Studentenverbindungs färger på en kedja eller ett band, utbytt som vänskapstecken mellan medlemmar i olika Verbindungen."@sv ,
                    "Ein kleines Zeichen in den Farben einer Studentenverbindung an einer Kette oder Schnur, das als Freundschaftszeichen zwischen Mitgliedern verschiedener Verbindungen getauscht wird."@de ,
                    "Un piccolo segno nei colori di una Studentenverbindung su una catenella o un cordoncino, scambiato come segno di amicizia tra soci di Verbindungen diverse."@it ,
                    "Petit insigne aux couleurs d'une Studentenverbindung, sur une chaînette ou un cordon, échangé en signe d'amitié entre membres de Verbindungen différentes."@fr ,
                    "Una pequeña prenda con los colores de una Studentenverbindung en una cadena o cordón, que se intercambia como signo de amistad entre miembros de distintas Verbindungen."@es ,
                    "Uma pequena peça com as cores de uma Studentenverbindung numa corrente ou cordão, que se troca como sinal de amizade entre membros de Verbindungen diferentes."@pt ,
                    "A Studentenverbindung színeiben kis jelvény láncon vagy zsinóron, amelyet a különböző Verbindungek tagjai barátságuk jeleként cserélnek."@hu .

fraternalc:robe a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Robe"@en , "Mantel"@sv , "Manteau"@fr , "Mantel"@de , "Manto"@it , "Túnica"@es , "Túnica"@pt , "Köntös"@hu ;
    skos:altLabel "Mantle"@en ;
    skos:definition "A long outer garment worn at ceremonies as a sign of membership, grade or office, such as the mantle of a knightly order or an academic gown."@en ,
                    "Ett långt ytterplagg som bärs vid ceremonier som tecken på medlemskap, grad eller ämbete, till exempel en riddarordens mantel eller en akademisk kappa."@sv ,
                    "Long vêtement de dessus porté lors des cérémonies comme signe d'appartenance, de grade ou de fonction, comme le manteau d'un ordre de chevalerie ou une robe académique."@fr ,
                    "Ein langes Obergewand, das bei Zeremonien als Zeichen der Mitgliedschaft, eines Grades oder eines Amtes getragen wird, etwa der Mantel eines Ritterordens oder ein akademischer Talar."@de ,
                    "Un lungo indumento esterno portato alle cerimonie come segno di appartenenza, di grado o di carica, come il manto di un ordine cavalleresco o una toga accademica."@it ,
                    "Una prenda exterior larga que se lleva en las ceremonias como signo de pertenencia, grado o cargo, como el manto de una orden de caballería o una toga académica."@es ,
                    "Uma peça exterior comprida que se usa nas cerimónias como sinal de filiação, grau ou cargo, como o manto de uma ordem cavaleiresca ou uma toga académica."@pt ,
                    "Hosszú felsőruha, amelyet szertartásokon a tagság, fokozat vagy tisztség jeleként viselnek, mint egy lovagrend palástja vagy egy akadémiai talár."@hu .

fraternalc:banner a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Banner"@en , "Banér"@sv , "Bannière"@fr , "Banner"@de , "Vessillo"@it , "Estandarte"@es , "Estandarte"@pt , "Zászló"@hu ;
    skos:altLabel "Standard"@en ;
    skos:definition "The flag or standard of an organisation or of a body within it, carried at processions and ceremonies and kept at the meeting place."@en ,
                    "En organisations eller en del av dess fana eller standar, som bärs vid tåg och ceremonier och förvaras på mötesplatsen."@sv ,
                    "Le drapeau ou l'étendard d'une organisation ou d'un de ses organes, porté lors des cortèges et des cérémonies et conservé au lieu de réunion."@fr ,
                    "Die Fahne oder das Banner einer Organisation oder eines ihrer Teile, das bei Umzügen und Zeremonien getragen und im Versammlungsort aufbewahrt wird."@de ,
                    "La bandiera o lo stendardo di un'organizzazione o di una sua parte, portato nei cortei e nelle cerimonie e custodito nel luogo di riunione."@it ,
                    "La bandera o estandarte de una organización o de un órgano de ella, que se porta en procesiones y ceremonias y se guarda en el lugar de reunión."@es ,
                    "A bandeira ou estandarte de uma organização ou de um órgão dela, que se leva em procissões e cerimónias e se guarda no local de reunião."@pt ,
                    "A szervezet vagy egy testületének zászlaja, amelyet felvonulásokon és szertartásokon visznek, és az összejövetel helyén őriznek."@hu .

fraternalc:gavel a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:InsigniaTypes ; skos:topConceptOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Gavel"@en , "Klubba"@sv , "Maillet"@fr , "Hammer"@de , "Maglietto"@it , "Mazo"@es , "Maço"@pt , "Kalapács"@hu ;
    skos:altLabel "Mallet"@en ;
    skos:definition "The mallet with which the presiding officer opens, directs and closes a meeting, a sign of that office."@en ,
                    "Klubban med vilken ordföranden öppnar, leder och avslutar ett möte, ett tecken på ämbetet."@sv ,
                    "Le maillet avec lequel le président ouvre, dirige et clôt une séance, signe de cette fonction."@fr ,
                    "Der Hammer, mit dem der Vorsitzende eine Sitzung eröffnet, leitet und schließt, ein Zeichen dieses Amtes."@de ,
                    "Il maglietto con cui il presidente apre, dirige e chiude una riunione, segno di quella carica."@it ,
                    "El mazo con el que el presidente abre, dirige y cierra una reunión, signo de ese cargo."@es ,
                    "O maço com que o presidente abre, dirige e encerra uma reunião, sinal desse cargo."@pt ,
                    "A kalapács, amellyel az elnöklő tisztségviselő megnyitja, vezeti és bezárja az ülést, e tisztség jele."@hu .

##############################################################################
# 7. ASSESSMENT OUTCOMES AND RECOGNITION TYPES  (values of fraternal:assessmentOutcome and fraternal:recognitionType)
##############################################################################

fraternalc:AssessmentOutcomes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Assessment Outcomes"@en , "Bedömningsutfall"@sv , "Résultats d'évaluation"@fr , "Bewertungsergebnisse"@de , "Esiti della valutazione"@it , "Resultados de la evaluación"@es , "Resultados da avaliação"@pt , "Értékelési eredmények"@hu ;
    skos:definition "What a fraternal:LegitimacyAssessment concluded about an order."@en ,
                    "Vad en fraternal:LegitimacyAssessment kom fram till om en orden."@sv ,
                    "Ce qu'une fraternal:LegitimacyAssessment a conclu à propos d'un ordre."@fr ,
                    "Zu welchem Ergebnis eine fraternal:LegitimacyAssessment über einen Orden kam."@de ,
                    "Ciò che una fraternal:LegitimacyAssessment ha concluso su un ordine."@it ,
                    "Lo que concluyó una fraternal:LegitimacyAssessment sobre una orden."@es ,
                    "O que concluiu uma fraternal:LegitimacyAssessment sobre uma ordem."@pt ,
                    "Amit egy fraternal:LegitimacyAssessment egy rendről megállapított."@hu ;
    skos:hasTopConcept fraternalc:recognisedAsGenuine , fraternalc:notRecognised , fraternalc:declaredSelfStyled ,
                       fraternalc:wearingPermitted , fraternalc:wearingProhibited ,
                       fraternalc:regular , fraternalc:irregular , fraternalc:clandestine .

fraternalc:recognisedAsGenuine a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:AssessmentOutcomes ; skos:topConceptOf fraternalc:AssessmentOutcomes ;
    skos:prefLabel "Recognised as Genuine"@en , "Erkänd som äkta"@sv , "Reconnu comme authentique"@fr , "Als echt anerkannt"@de , "Riconosciuto come autentico"@it , "Reconocida como auténtica"@es , "Reconhecida como autêntica"@pt , "Valódinak elismert"@hu ;
    skos:altLabel "Listed"@en , "Upptagen"@sv , "Répertorié"@fr ;
    skos:definition "The assessor recognises the order as a genuine order of chivalry, for example by listing it in a register."@en ,
                    "Bedömaren erkänner orden som en äkta riddarorden, t.ex. genom att uppta den i ett register."@sv ,
                    "L'évaluateur reconnaît l'ordre comme un véritable ordre de chevalerie, par exemple en l'inscrivant dans un registre."@fr ,
                    "Der Bewertende erkennt den Orden als echten Ritterorden an, zum Beispiel indem er ihn in einem Verzeichnis aufführt."@de ,
                    "Chi valuta riconosce l'ordine come un autentico ordine cavalleresco, per esempio inserendolo in un elenco ufficiale."@it ,
                    "El evaluador reconoce la orden como una auténtica orden de caballería, por ejemplo incluyéndola en un registro."@es ,
                    "O avaliador reconhece a ordem como uma autêntica ordem de cavalaria, por exemplo incluindo-a num registo."@pt ,
                    "Az értékelő a rendet valódi lovagrendnek ismeri el, például nyilvántartásba vételével."@hu .

fraternalc:notRecognised a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:AssessmentOutcomes ; skos:topConceptOf fraternalc:AssessmentOutcomes ;
    skos:prefLabel "Not Recognised"@en , "Inte erkänd"@sv , "Non reconnu"@fr , "Nicht anerkannt"@de , "Non riconosciuto"@it , "No reconocida"@es , "Não reconhecida"@pt , "El nem ismert"@hu ;
    skos:altLabel "Removed from Register"@en , "Struken ur register"@sv , "Radié du registre"@fr ;
    skos:definition "The assessor does not recognise the order, or has withdrawn an earlier recognition."@en ,
                    "Bedömaren erkänner inte orden eller har dragit tillbaka ett tidigare erkännande."@sv ,
                    "L'évaluateur ne reconnaît pas l'ordre, ou a retiré une reconnaissance antérieure."@fr ,
                    "Der Bewertende erkennt den Orden nicht an oder hat eine frühere Anerkennung zurückgenommen."@de ,
                    "Chi valuta non riconosce l'ordine, o ha ritirato un riconoscimento precedente."@it ,
                    "El evaluador no reconoce la orden, o ha retirado un reconocimiento anterior."@es ,
                    "O avaliador não reconhece a ordem, ou retirou um reconhecimento anterior."@pt ,
                    "Az értékelő nem ismeri el a rendet, vagy visszavonta a korábbi elismerést."@hu .

fraternalc:declaredSelfStyled a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:AssessmentOutcomes ; skos:topConceptOf fraternalc:AssessmentOutcomes ;
    skos:prefLabel "Declared Self-styled"@en , "Förklarad självutnämnd"@sv , "Déclaré autoproclamé"@fr , "Als selbsternannt erklärt"@de , "Dichiarato autoproclamato"@it , "Declarada autoproclamada"@es , "Declarada autoproclamada"@pt , "Önmagát nevezőnek nyilvánított"@hu ;
    skos:altLabel "Listed as False"@en , "Upptagen som oäkta"@sv , "Répertorié comme faux"@fr ;
    skos:definition "The assessor states that the order is a self-styled order of chivalry, for example in a published list of false orders."@en ,
                    "Bedömaren förklarar att orden är en självutnämnd riddarorden, t.ex. i en publicerad förteckning över oäkta ordnar."@sv ,
                    "L'évaluateur déclare que l'ordre est un ordre de chevalerie autoproclamé, par exemple dans une liste publiée d'ordres faux."@fr ,
                    "Der Bewertende erklärt, der Orden sei ein selbsternannter Ritterorden, zum Beispiel in einer veröffentlichten Liste falscher Orden."@de ,
                    "Chi valuta afferma che l'ordine è un ordine cavalleresco autoproclamato, per esempio in un elenco pubblicato di ordini falsi."@it ,
                    "El evaluador declara que la orden es una orden de caballería autoproclamada, por ejemplo en una lista publicada de órdenes falsas."@es ,
                    "O avaliador declara que a ordem é uma ordem de cavalaria autoproclamada, por exemplo numa lista publicada de ordens falsas."@pt ,
                    "Az értékelő kijelenti, hogy a rend önmagát lovagrendnek nevező rend, például a hamis rendek közzétett listájában."@hu .

fraternalc:wearingPermitted a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:AssessmentOutcomes ; skos:topConceptOf fraternalc:AssessmentOutcomes ;
    skos:prefLabel "Wearing Permitted"@en , "Bärande tillåtet"@sv , "Port autorisé"@fr , "Tragen erlaubt"@de , "Uso consentito"@it , "Uso permitido"@es , "Uso permitido"@pt , "Viselet engedélyezett"@hu ;
    skos:definition "An authority permits the order's insignia to be worn in a given setting, for example on uniform. Says nothing about whether the order is genuine."@en ,
                    "En myndighet tillåter att ordens insignier bärs i ett visst sammanhang, t.ex. till uniform. Säger inget om huruvida orden är äkta."@sv ,
                    "Une autorité autorise le port des insignes de l'ordre dans un cadre donné, par exemple en uniforme. Ne dit rien de l'authenticité de l'ordre."@fr ,
                    "Eine Stelle erlaubt, die Insignien des Ordens in einem bestimmten Rahmen zu tragen, zum Beispiel zur Uniform. Sagt nichts darüber aus, ob der Orden echt ist."@de ,
                    "Un'autorità consente di portare le insegne dell'ordine in un dato contesto, per esempio sull'uniforme. Non dice nulla sull'autenticità dell'ordine."@it ,
                    "Una autoridad permite llevar las insignias de la orden en un entorno determinado, por ejemplo sobre el uniforme. No dice nada sobre si la orden es auténtica."@es ,
                    "Uma autoridade permite usar as insígnias da ordem num contexto determinado, por exemplo sobre o uniforme. Nada diz sobre se a ordem é autêntica."@pt ,
                    "Egy hatóság engedélyezi a rend jelvényeinek viseletét adott környezetben, például egyenruhán. Nem mond semmit arról, hogy a rend valódi-e."@hu .

fraternalc:wearingProhibited a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:AssessmentOutcomes ; skos:topConceptOf fraternalc:AssessmentOutcomes ;
    skos:prefLabel "Wearing Prohibited"@en , "Bärande förbjudet"@sv , "Port interdit"@fr , "Tragen verboten"@de , "Uso vietato"@it , "Uso prohibido"@es , "Uso proibido"@pt , "Viselet tilos"@hu ;
    skos:definition "An authority forbids the order's insignia to be worn in public or in a given setting."@en ,
                    "En myndighet förbjuder att ordens insignier bärs offentligt eller i ett visst sammanhang."@sv ,
                    "Une autorité interdit le port des insignes de l'ordre en public ou dans un cadre donné."@fr ,
                    "Eine Stelle verbietet, die Insignien des Ordens in der Öffentlichkeit oder in einem bestimmten Rahmen zu tragen."@de ,
                    "Un'autorità vieta di portare le insegne dell'ordine in pubblico o in un dato contesto."@it ,
                    "Una autoridad prohíbe llevar las insignias de la orden en público o en un entorno determinado."@es ,
                    "Uma autoridade proíbe usar as insígnias da ordem em público ou num contexto determinado."@pt ,
                    "Egy hatóság megtiltja a rend jelvényeinek viseletét nyilvánosan vagy adott környezetben."@hu .

fraternalc:regular a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:AssessmentOutcomes ; skos:topConceptOf fraternalc:AssessmentOutcomes ;
    skos:prefLabel "Regular"@en , "Reguljär"@sv , "Régulière"@fr , "Regulär"@de , "Regolare"@it , "Regular"@es , "Regular"@pt , "Szabályos"@hu ;
    skos:definition "The assessing body holds the other to be regular: lawfully constituted and working on the principles the assessing body requires. Recognition normally follows."@en ,
                    "Det bedömande organet anser det andra vara reguljärt: lagligen konstituerat och verksamt på de principer som det bedömande organet kräver. Erkännande följer normalt."@sv ,
                    "L'organe qui évalue tient l'autre pour régulier : légalement constitué et travaillant selon les principes qu'il exige. La reconnaissance suit normalement."@fr ,
                    "Das bewertende Organ hält das andere für regulär: rechtmäßig konstituiert und nach den Grundsätzen arbeitend, die es verlangt. Die Anerkennung folgt normalerweise."@de ,
                    "L'organismo che valuta ritiene l'altro regolare: legittimamente costituito e operante secondo i principi che esso richiede. Di norma segue il riconoscimento."@it ,
                    "El organismo evaluador considera al otro regular: legalmente constituido y trabajando según los principios que el evaluador exige. Normalmente sigue el reconocimiento."@es ,
                    "O organismo avaliador considera o outro regular: legalmente constituído e a trabalhar segundo os princípios que o avaliador exige. Normalmente segue-se o reconhecimento."@pt ,
                    "Az értékelő testület a másikat szabályosnak tartja: jogszerűen alakult és az értékelő által megkövetelt elvek szerint működik. Rendszerint az elismerés követi."@hu ;
    skos:scopeNote "The terms regular, irregular and clandestine come from freemasonry, and their use differs between jurisdictions. The definitions here are the common core; a body that uses them differently should say how in its own assessment."@en ,
                   "Termerna reguljär, irreguljär och klandestin kommer från frimureriet, och bruket skiljer sig mellan jurisdiktioner. Definitionerna här är den gemensamma kärnan; ett organ som använder dem annorlunda bör säga hur i sin egen bedömning."@sv ,
                   "Les termes régulier, irrégulier et clandestin viennent de la franc-maçonnerie, et leur emploi diffère selon les juridictions. Les définitions données ici en sont le noyau commun ; un organe qui les emploie autrement devrait dire comment dans sa propre évaluation."@fr ,
                   "Die Begriffe regulär, irregulär und klandestin stammen aus der Freimaurerei, und ihr Gebrauch unterscheidet sich zwischen Jurisdiktionen. Die Definitionen hier sind der gemeinsame Kern; ein Organ, das sie anders verwendet, sollte in seiner eigenen Bewertung sagen, wie."@de ,
                   "I termini regolare, irregolare e clandestino vengono dalla massoneria, e il loro uso varia tra le giurisdizioni. Le definizioni qui date sono il nucleo comune; un organismo che li usa diversamente dovrebbe dire come nella propria valutazione."@it ,
                   "Los términos regular, irregular y clandestino proceden de la masonería, y su uso difiere entre jurisdicciones. Las definiciones de aquí son el núcleo común; un organismo que los use de otro modo debería decir cómo en su propia evaluación."@es ,
                   "Os termos regular, irregular e clandestino vêm da maçonaria, e o seu uso difere entre jurisdições. As definições daqui são o núcleo comum; um organismo que os use de outro modo deveria dizer como na sua própria avaliação."@pt ,
                   "A szabályos, szabálytalan és titkos (clandestine) kifejezések a szabadkőművességből származnak, és használatuk joghatóságonként eltér. Az itteni meghatározások a közös mag; az a testület, amely másként használja őket, mondja meg a saját értékelésében, hogyan."@hu .

fraternalc:irregular a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:AssessmentOutcomes ; skos:topConceptOf fraternalc:AssessmentOutcomes ;
    skos:prefLabel "Irregular"@en , "Irreguljär"@sv , "Irrégulière"@fr , "Irregulär"@de , "Irregolare"@it , "Irregular"@es , "Irregular"@pt , "Szabálytalan"@hu ;
    skos:definition "The assessing body holds the other not to meet its requirements, for example in whom it admits or what it asks of its members, although the other may be lawfully constituted. Recognition is withheld or withdrawn."@en ,
                    "Det bedömande organet anser att det andra inte uppfyller dess krav, till exempel i fråga om vem det tar in eller vad det begär av sina medlemmar, även om det andra kan vara lagligen konstituerat. Erkännande nekas eller dras tillbaka."@sv ,
                    "L'organe qui évalue tient l'autre pour ne pas remplir ses exigences, par exemple quant à qui il admet ou à ce qu'il demande à ses membres, même si l'autre peut être légalement constitué. La reconnaissance est refusée ou retirée."@fr ,
                    "Das bewertende Organ hält das andere für nicht den eigenen Anforderungen entsprechend, etwa hinsichtlich der Aufnahme von Personen oder dessen, was es von seinen Mitgliedern verlangt, auch wenn das andere rechtmäßig konstituiert sein kann. Die Anerkennung wird verweigert oder entzogen."@de ,
                    "L'organismo che valuta ritiene che l'altro non soddisfi i suoi requisiti, per esempio quanto a chi ammette o a ciò che chiede ai propri membri, anche se l'altro può essere legittimamente costituito. Il riconoscimento è negato o ritirato."@it ,
                    "El organismo evaluador considera que el otro no cumple sus requisitos, por ejemplo en cuanto a a quién admite o qué pide a sus miembros, aunque el otro pueda estar legalmente constituido. El reconocimiento se niega o se retira."@es ,
                    "O organismo avaliador considera que o outro não cumpre os seus requisitos, por exemplo quanto a quem admite ou ao que pede aos seus membros, embora o outro possa estar legalmente constituído. O reconhecimento é negado ou retirado."@pt ,
                    "Az értékelő testület szerint a másik nem felel meg a követelményeinek, például abban, kit vesz fel vagy mit kér a tagjaitól, bár a másik lehet jogszerűen alakult. Az elismerést megtagadják vagy visszavonják."@hu .

fraternalc:clandestine a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:AssessmentOutcomes ; skos:topConceptOf fraternalc:AssessmentOutcomes ;
    skos:prefLabel "Clandestine"@en , "Klandestin"@sv , "Clandestine"@fr , "Klandestin"@de , "Clandestina"@it , "Clandestina"@es , "Clandestina"@pt , "Titkos (clandestine)"@hu ;
    skos:definition "The assessing body holds the other to work without lawful authority, for example a lodge founded without a warrant from a regular grand body."@en ,
                    "Det bedömande organet anser att det andra verkar utan laglig auktoritet, till exempel en loge som grundats utan stiftelsebrev från ett reguljärt överordnat organ."@sv ,
                    "L'organe qui évalue tient l'autre pour travailler sans autorité légitime, par exemple une loge fondée sans lettres patentes d'un organe dirigeant régulier."@fr ,
                    "Das bewertende Organ hält das andere für ohne rechtmäßige Autorität arbeitend, etwa eine Loge, die ohne Patent eines regulären übergeordneten Organs gegründet wurde."@de ,
                    "L'organismo che valuta ritiene che l'altro operi senza legittima autorità, per esempio una loggia fondata senza la patente di un organismo di governo regolare."@it ,
                    "El organismo evaluador considera que el otro trabaja sin autoridad legítima, por ejemplo una logia fundada sin patente de un organismo rector regular."@es ,
                    "O organismo avaliador considera que o outro trabalha sem autoridade legítima, por exemplo uma loja fundada sem patente de um organismo dirigente regular."@pt ,
                    "Az értékelő testület szerint a másik jogszerű felhatalmazás nélkül működik, például egy szabályos irányító testület pátense nélkül alapított páholy."@hu .

fraternalc:RecognitionTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Recognition Types"@en , "Typer av erkännande"@sv , "Types de reconnaissance"@fr , "Arten der Anerkennung"@de , "Tipi di riconoscimento"@it , "Tipos de reconocimiento"@es , "Tipos de reconhecimento"@pt , "Elismerési típusok"@hu ;
    skos:definition "The kinds of relation one body can formally have to another, recorded on a fraternal:Recognition. Used with fraternal:recognitionType."@en ,
                    "De slag av förhållande ett organ formellt kan ha till ett annat, registrerade på en fraternal:Recognition. Används med fraternal:recognitionType."@sv ,
                    "Les sortes de relation qu'un organe peut avoir formellement avec un autre, consignées sur une fraternal:Recognition. S'utilise avec fraternal:recognitionType."@fr ,
                    "Die Arten von Beziehung, die ein Organ förmlich zu einem anderen haben kann, festgehalten an einer fraternal:Recognition. Wird mit fraternal:recognitionType verwendet."@de ,
                    "I tipi di rapporto che un organismo può avere formalmente con un altro, registrati su una fraternal:Recognition. Si usa con fraternal:recognitionType."@it ,
                    "Los tipos de relación que un organismo puede tener formalmente con otro, registrados en un fraternal:Recognition. Se usa con fraternal:recognitionType."@es ,
                    "Os tipos de relação que um organismo pode ter formalmente com outro, registados num fraternal:Recognition. Usa-se com fraternal:recognitionType."@pt ,
                    "A kapcsolat fajtái, amelyekkel egy testület formálisan egy másikhoz viszonyulhat, fraternal:Recognition-ön rögzítve. A fraternal:recognitionType-pal használatos."@hu ;
    skos:hasTopConcept fraternalc:regularRecognition , fraternalc:amity , fraternalc:intervisitation .

fraternalc:regularRecognition a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:RecognitionTypes ; skos:topConceptOf fraternalc:RecognitionTypes ;
    skos:prefLabel "Recognition as Regular"@en , "Erkännande som reguljär"@sv , "Reconnaissance comme régulière"@fr , "Anerkennung als regulär"@de , "Riconoscimento come regolare"@it , "Reconocimiento como regular"@es , "Reconhecimento como regular"@pt , "Szabályosként elismerés"@hu ;
    skos:definition "The recognising body formally accepts the other as regular. It is directional: the other body may or may not recognise it in return."@en ,
                    "Det erkännande organet godtar formellt det andra som reguljärt. Det är riktat: det andra organet kan eller kan inte erkänna det tillbaka."@sv ,
                    "L'organe qui reconnaît accepte formellement l'autre comme régulier. Elle est orientée : l'autre organe peut ou non le reconnaître en retour."@fr ,
                    "Das anerkennende Organ nimmt das andere förmlich als regulär an. Sie ist gerichtet: das andere Organ kann es erwidern oder nicht."@de ,
                    "L'organismo che riconosce accetta formalmente l'altro come regolare. È orientato: l'altro organismo può o no riconoscerlo a sua volta."@it ,
                    "El organismo que reconoce acepta formalmente al otro como regular. Tiene dirección: el otro organismo puede o no reconocerlo a su vez."@es ,
                    "O organismo que reconhece aceita formalmente o outro como regular. Tem direção: o outro organismo pode ou não reconhecê-lo por sua vez."@pt ,
                    "Az elismerő testület formálisan szabályosként fogadja el a másikat. Irányított: a másik testület viszonozhatja vagy nem."@hu .

fraternalc:amity a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:RecognitionTypes ; skos:topConceptOf fraternalc:RecognitionTypes ;
    skos:prefLabel "Amity"@en , "Vänskapsförbund"@sv , "Amitié"@fr , "Freundschaftsverhältnis"@de , "Amicizia"@it , "Amistad"@es , "Amizade"@pt , "Barátság"@hu ;
    skos:definition "Two orders agree to friendly relations and cooperation without either accepting the other as regular. It is mutual and is stated once."@en ,
                    "Två ordnar enas om vänskapliga förbindelser och samarbete utan att någon av dem godtar den andra som reguljär. Den är ömsesidig och anges en gång."@sv ,
                    "Deux ordres conviennent de relations amicales et de coopération sans que l'un accepte l'autre comme régulier. Elle est mutuelle et ne s'indique qu'une fois."@fr ,
                    "Zwei Orden vereinbaren freundschaftliche Beziehungen und Zusammenarbeit, ohne dass einer den anderen als regulär annimmt. Sie ist gegenseitig und wird einmal angegeben."@de ,
                    "Due ordini concordano rapporti amichevoli e di collaborazione senza che nessuno accetti l'altro come regolare. È reciproca e si indica una sola volta."@it ,
                    "Dos órdenes acuerdan relaciones amistosas y de cooperación sin que ninguna acepte a la otra como regular. Es mutua y se indica una sola vez."@es ,
                    "Duas ordens acordam relações amistosas e de cooperação sem que nenhuma aceite a outra como regular. É mútua e indica-se uma só vez."@pt ,
                    "Két rend baráti kapcsolatokban és együttműködésben állapodik meg anélkül, hogy bármelyik szabályosként fogadná el a másikat. Kölcsönös, és egyszer kell megadni."@hu .

fraternalc:intervisitation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:RecognitionTypes ; skos:topConceptOf fraternalc:RecognitionTypes ;
    skos:prefLabel "Intervisitation"@en , "Besöksrätt"@sv , "Visite réciproque"@fr , "Besuchsrecht"@de , "Visita reciproca"@it , "Visita recíproca"@es , "Visita recíproca"@pt , "Kölcsönös látogatás"@hu ;
    skos:definition "The members of the one body may attend the meetings of the other, usually on a card or letter of introduction. It may follow from recognition or be agreed on its own."@en ,
                    "Medlemmarna i det ena organet får närvara vid det andras möten, vanligen mot ett kort eller ett introduktionsbrev. Den kan följa av erkännande eller avtalas för sig."@sv ,
                    "Les membres de l'un des organes peuvent assister aux réunions de l'autre, d'ordinaire sur présentation d'une carte ou d'une lettre d'introduction. Elle peut découler de la reconnaissance ou être convenue séparément."@fr ,
                    "Die Mitglieder des einen Organs dürfen an den Zusammenkünften des anderen teilnehmen, meist gegen eine Karte oder ein Empfehlungsschreiben. Es kann aus der Anerkennung folgen oder für sich vereinbart werden."@de ,
                    "I membri di un organismo possono assistere alle riunioni dell'altro, di solito con una tessera o una lettera di presentazione. Può derivare dal riconoscimento o essere concordata a parte."@it ,
                    "Los miembros de un organismo pueden asistir a las reuniones del otro, normalmente con una tarjeta o carta de presentación. Puede derivar del reconocimiento o acordarse por sí sola."@es ,
                    "Os membros de um organismo podem assistir às reuniões do outro, normalmente com um cartão ou carta de apresentação. Pode decorrer do reconhecimento ou acordar-se por si só."@pt ,
                    "Az egyik testület tagjai részt vehetnek a másik összejövetelein, rendszerint kártyával vagy bemutatkozó levéllel. Következhet az elismerésből, vagy külön is megállapodhatnak benne."@hu .

##############################################################################
# 8. OFFICES OF FRENCH LODGES, COMPAGNONNAGE AND ACADEMIES  (offices that have
#    no close generic equivalent; placed under the generic office types in
#    mappings/fraternal-offices-fr.sssom.tsv. Their schemes (MasonicLodgeOffices,
#    CompagnonnageOffices, AcademyOffices) are defined in section 10. Draft from
#    general knowledge: the French and Swedish wording needs a native reviewer.)
##############################################################################

fraternalc:venerableMaster a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MasonicLodgeOffices ; skos:topConceptOf fraternalc:MasonicLodgeOffices ;
    skos:prefLabel "Venerable Master"@en , "Vördnadsvärd mästare"@sv , "Vénérable Maître"@fr , "Meister vom Stuhl"@de , "Venerabile Maestro"@it , "Venerable Maestro"@es , "Venerável Mestre"@pt , "Tiszteletre méltó Mester"@hu ;
    skos:altLabel "Worshipful Master"@en , "Vénérable"@fr , "Venerabile"@it ;
    skos:definition "The officer who presides over a lodge, elected for a fixed term."@en ,
                    "Den ämbetsman som leder en loge, vald för en bestämd tid."@sv ,
                    "Officier qui préside une loge, élu pour une durée déterminée."@fr ,
                    "Der Amtsträger, der einer Loge vorsitzt, für eine feste Amtszeit gewählt."@de ,
                    "Il titolare di carica che presiede una loggia, eletto per un periodo determinato."@it ,
                    "El cargo que preside una logia, elegido por un plazo fijo."@es ,
                    "O cargo que preside a uma loja, eleito por um prazo fixo."@pt ,
                    "A tisztségviselő, aki egy páholyban elnököl, meghatározott időre megválasztva."@hu .

fraternalc:firstWarden a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MasonicLodgeOffices ; skos:topConceptOf fraternalc:MasonicLodgeOffices ;
    skos:prefLabel "First Warden"@en , "Förste uppsyningsman"@sv , "Premier Surveillant"@fr , "Erster Aufseher"@de , "Primo Sorvegliante"@it , "Primer Vigilante"@es , "Primeiro Vigilante"@pt , "Első Felügyelő"@hu ;
    skos:definition "The officer who stands first after the master of a lodge and directs the work of the companions."@en ,
                    "Den ämbetsman som står närmast efter logens mästare och leder gesällernas arbete."@sv ,
                    "Officier qui vient en premier après le Vénérable Maître et dirige les travaux des compagnons."@fr ,
                    "Der Amtsträger, der in einer Loge als Erster nach dem Meister steht und die Arbeit der Gesellen leitet."@de ,
                    "Il titolare di carica che nella loggia viene per primo dopo il maestro e dirige il lavoro dei compagni."@it ,
                    "El cargo que está en primer lugar después del maestro de una logia y dirige el trabajo de los compañeros."@es ,
                    "O cargo que está em primeiro lugar depois do mestre de uma loja e dirige o trabalho dos companheiros."@pt ,
                    "A tisztségviselő, aki a páholy mestere után az első helyen áll, és a legények munkáját vezeti."@hu .

fraternalc:secondWarden a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MasonicLodgeOffices ; skos:topConceptOf fraternalc:MasonicLodgeOffices ;
    skos:prefLabel "Second Warden"@en , "Andre uppsyningsman"@sv , "Second Surveillant"@fr , "Zweiter Aufseher"@de , "Secondo Sorvegliante"@it , "Segundo Vigilante"@es , "Segundo Vigilante"@pt , "Második Felügyelő"@hu ;
    skos:definition "The officer who stands second after the master of a lodge and directs the work of the apprentices."@en ,
                    "Den ämbetsman som står näst efter logens mästare och leder lärlingarnas arbete."@sv ,
                    "Officier qui vient en second après le Vénérable Maître et dirige les travaux des apprentis."@fr ,
                    "Der Amtsträger, der in einer Loge als Zweiter nach dem Meister steht und die Arbeit der Lehrlinge leitet."@de ,
                    "Il titolare di carica che nella loggia viene per secondo dopo il maestro e dirige il lavoro degli apprendisti."@it ,
                    "El cargo que está en segundo lugar después del maestro de una logia y dirige el trabajo de los aprendices."@es ,
                    "O cargo que está em segundo lugar depois do mestre de uma loja e dirige o trabalho dos aprendizes."@pt ,
                    "A tisztségviselő, aki a páholy mestere után a második helyen áll, és a tanoncok munkáját vezeti."@hu .

fraternalc:expert a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MasonicLodgeOffices ; skos:topConceptOf fraternalc:MasonicLodgeOffices ;
    skos:prefLabel "Expert"@en , "Expert"@sv , "Expert"@fr , "Experte"@de , "Esperto"@it , "Experto"@es , "Experto"@pt , "Szakértő"@hu ;
    skos:definition "The officer who prepares candidates and accompanies them through the ceremonies of initiation."@en ,
                    "Den ämbetsman som förbereder kandidater och följer dem genom initieringens ceremonier."@sv ,
                    "Officier qui prépare les candidats et les accompagne au cours des cérémonies d'initiation."@fr ,
                    "Der Amtsträger, der die Kandidaten vorbereitet und sie durch die Zeremonien der Aufnahme begleitet."@de ,
                    "Il titolare di carica che prepara i candidati e li accompagna nelle cerimonie d'iniziazione."@it ,
                    "El cargo que prepara a los candidatos y los acompaña en las ceremonias de iniciación."@es ,
                    "O cargo que prepara os candidatos e os acompanha nas cerimónias de iniciação."@pt ,
                    "A tisztségviselő, aki a jelölteket előkészíti, és a beavatási szertartásokon kíséri."@hu .

fraternalc:perpetualSecretary a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:AcademyOffices ; skos:topConceptOf fraternalc:AcademyOffices ;
    skos:prefLabel "Permanent Secretary"@en , "Ständig sekreterare"@sv , "Secrétaire perpétuel"@fr , "Ständiger Sekretär"@de , "Segretario perpetuo"@it , "Secretario perpetuo"@es , "Secretário perpétuo"@pt , "Állandó titkár"@hu ;
    skos:definition "The officer who runs an academy and speaks for it, elected for a long term; more senior than an ordinary secretary."@en ,
                    "Den ämbetsman som leder en akademi och talar för den, vald för en lång period; mer framskjuten än en vanlig sekreterare."@sv ,
                    "Officier qui dirige une académie et parle en son nom, élu pour une longue durée ; plus élevé qu'un secrétaire ordinaire."@fr ,
                    "Der Amtsträger, der eine Akademie leitet und für sie spricht, für eine lange Amtszeit gewählt; ranghöher als ein gewöhnlicher Schriftführer."@de ,
                    "Il titolare di carica che dirige un'accademia e parla a suo nome, eletto per un lungo periodo; più elevato di un segretario ordinario."@it ,
                    "El cargo que dirige una academia y habla en su nombre, elegido por un largo plazo; más importante que un secretario ordinario."@es ,
                    "O cargo que dirige uma academia e fala em seu nome, eleito por um longo prazo; mais importante do que um secretário ordinário."@pt ,
                    "A tisztségviselő, aki egy akadémiát vezet és a nevében beszél, hosszú időre megválasztva; rangosabb a rendes titkárnál."@hu .

fraternalc:housePrevot a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CompagnonnageOffices ; skos:topConceptOf fraternalc:CompagnonnageOffices ;
    skos:prefLabel "House Provost"@en , "Husföreståndare"@sv , "Prévôt de maison"@fr , "Hausprevot"@de , "Prevosto della casa"@it , "Preboste de la casa"@es , "Preboste da casa"@pt , "Házprépost"@hu ;
    skos:definition "The officer in charge of a compagnons' house (cayenne), where the compagnons and aspirants of a town live and meet."@en ,
                    "Den ämbetsman som ansvarar för ett compagnons hus (cayenne), där compagnons och aspiranter i en stad bor och möts."@sv ,
                    "Responsable d'une maison de compagnons (cayenne), où les compagnons et aspirants d'une ville logent et se réunissent."@fr ,
                    "Der Amtsträger, der ein Haus der Compagnons (cayenne) leitet, in dem die Compagnons und Aspiranten einer Stadt wohnen und sich treffen."@de ,
                    "Il titolare di carica a capo di una casa dei compagnons (cayenne), dove i compagnons e gli aspiranti di una città abitano e si riuniscono."@it ,
                    "El cargo al frente de una casa de compagnons (cayenne), donde viven y se reúnen los compagnons y aspirantes de una ciudad."@es ,
                    "O cargo à frente de uma casa de compagnons (cayenne), onde vivem e se reúnem os compagnons e aspirantes de uma cidade."@pt ,
                    "A tisztségviselő, aki egy compagnon-ház (cayenne) élén áll, ahol egy város compagnonjai és aspiránsai laknak és összejönnek."@hu ;
    skos:scopeNote "Not mbrc:provost, who keeps order at gatherings."@en , "À ne pas confondre avec mbrc:provost, qui maintient l'ordre lors des réunions."@fr , "Nicht mbrc:provost, der bei Zusammenkünften für Ordnung sorgt."@de , "Non è mbrc:provost, che mantiene l'ordine negli incontri."@it , "Inte mbrc:provost, som håller ordning vid sammankomster."@sv , "No es mbrc:provost, que mantiene el orden en las reuniones."@es , "Não é mbrc:provost, que mantém a ordem nas reuniões."@pt , "Nem az mbrc:provost, aki az összejöveteleken fenntartja a rendet."@hu .

fraternalc:rolleur a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CompagnonnageOffices ; skos:topConceptOf fraternalc:CompagnonnageOffices ;
    skos:prefLabel "Rôleur"@en , "Rôleur"@sv , "Rôleur"@fr , "Rôleur"@de , "Rôleur"@it , "Rôleur"@es , "Rôleur"@pt , "Rôleur"@hu ;
    skos:altLabel "Rouleur"@fr ;
    skos:definition "Originally the itinerant compagnon in charge of hiring; now the officer who assists the house provost and often acts as master of ceremonies."@en ,
                    "Ursprungligen den vandrande compagnon som ansvarade för anställning; nu den ämbetsman som biträder husföreståndaren och ofta är ceremonimästare."@sv ,
                    "À l'origine le compagnon itinérant chargé de l'embauche ; aujourd'hui l'officier qui assiste le prévôt et fait souvent office de maître des cérémonies."@fr ,
                    "Ursprünglich der wandernde Compagnon, der für die Anwerbung zuständig war; heute der Amtsträger, der den Hausprevot unterstützt und oft als Zeremonienmeister auftritt."@de ,
                    "In origine il compagnon itinerante incaricato dell'ingaggio; oggi il titolare di carica che assiste il prevosto della casa e spesso fa da maestro delle cerimonie."@it ,
                    "En origen el compagnon itinerante encargado de la contratación; hoy el cargo que asiste al preboste de la casa y a menudo hace de maestro de ceremonias."@es ,
                    "Na origem o compagnon itinerante encarregado da contratação; hoje o cargo que auxilia o preboste da casa e muitas vezes faz de mestre de cerimónias."@pt ,
                    "Eredetileg a felvételért felelős vándor compagnon; ma a tisztségviselő, aki a házprépostot segíti, és gyakran szertartásmesterként működik."@hu .

fraternalc:houseMother a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CompagnonnageOffices ; skos:topConceptOf fraternalc:CompagnonnageOffices ;
    skos:prefLabel "House Mother"@en , "Husmor"@sv , "Mère"@fr , "Hausmutter"@de , "Madre della casa"@it , "Madre de la casa"@es , "Mãe da casa"@pt , "Házanya"@hu ;
    skos:altLabel "Maîtresse de maison"@fr ;
    skos:definition "The woman who runs a compagnons' house, with its lodging and meals. Her title (dame économe, dame hôtesse, mère) depends on her level of initiation."@en ,
                    "Kvinnan som driver ett compagnons hus, med logi och måltider. Hennes titel (dame économe, dame hôtesse, mère) beror på hennes initieringsnivå."@sv ,
                    "Femme qui tient une maison de compagnons, avec son hébergement et ses repas. Son titre (dame économe, dame hôtesse, mère) dépend de son niveau d'initiation."@fr ,
                    "Die Frau, die ein Haus der Compagnons mit Unterkunft und Mahlzeiten führt. Ihr Titel (dame économe, dame hôtesse, mère) hängt von ihrer Einweihungsstufe ab."@de ,
                    "La donna che dirige una casa dei compagnons, con alloggio e pasti. Il suo titolo (dame économe, dame hôtesse, mère) dipende dal suo livello di iniziazione."@it ,
                    "La mujer que dirige una casa de compagnons, con su alojamiento y sus comidas. Su título (dame économe, dame hôtesse, mère) depende de su nivel de iniciación."@es ,
                    "A mulher que dirige uma casa de compagnons, com o seu alojamento e as suas refeições. O seu título (dame économe, dame hôtesse, mère) depende do seu nível de iniciação."@pt ,
                    "A nő, aki a compagnonok házát vezeti szállásával és étkezéseivel. Címe (dame économe, dame hôtesse, mère) a beavatottsági szintjétől függ."@hu .

##############################################################################
# 9. STUDENTENVERBINDUNGEN  (the stages of membership, categories, offices and
#    roles at gatherings of the German-speaking student fraternities; their
#    types, titles, ceremonies, insignia and principles are in the concept
#    blocks of sections 1, 3, 4, 5 and 6, but in the schemes of section 10)
##############################################################################

fraternalc:StudentenverbindungDegrees a skos:ConceptScheme , fraternal:DegreeSystem , owl:NamedIndividual ;
    skos:prefLabel "Stages of a Studentenverbindung"@en , "Stadier i en Studentenverbindung"@sv , "Stufen einer Studentenverbindung"@de , "Stadi di una Studentenverbindung"@it , "Étapes d'une Studentenverbindung"@fr , "Etapas de una Studentenverbindung"@es , "Etapas de uma Studentenverbindung"@pt , "Egy Studentenverbindung szakaszai"@hu ;
    skos:definition "The three stages through which a member of a Studentenverbindung passes: Fuchs, Bursch, Alter Herr. Each is entered by a ceremony (Rezeption, Burschung, Philistrierung)."@en ,
                    "De tre stadier en medlem i en Studentenverbindung genomgår: Fuchs, Bursch, Alter Herr. Varje stadium inleds med en ceremoni (Rezeption, Burschung, Philistrierung)."@sv ,
                    "Die drei Stufen, die ein Mitglied einer Studentenverbindung durchläuft: Fuchs, Bursch, Alter Herr. Jede beginnt mit einer Zeremonie (Rezeption, Burschung, Philistrierung)."@de ,
                    "I tre stadi che un socio di una Studentenverbindung percorre: Fuchs, Bursch, Alter Herr. Ciascuno si raggiunge con una cerimonia (Rezeption, Burschung, Philistrierung)."@it ,
                    "Les trois étapes que parcourt un membre d'une Studentenverbindung : Fuchs, Bursch, Alter Herr. On entre dans chacune par une cérémonie (Rezeption, Burschung, Philistrierung)."@fr ,
                    "Las tres etapas por las que pasa un miembro de una Studentenverbindung: Fuchs, Bursch, Alter Herr. En cada una se entra mediante una ceremonia (Rezeption, Burschung, Philistrierung)."@es ,
                    "As três etapas por que passa um membro de uma Studentenverbindung: Fuchs, Bursch, Alter Herr. Em cada uma entra-se através de uma cerimónia (Rezeption, Burschung, Philistrierung)."@pt ,
                    "A három szakasz, amelyen egy Studentenverbindung tagja átmegy: Fuchs, Bursch, Alter Herr. Mindegyikbe szertartással lépnek (Rezeption, Burschung, Philistrierung)."@hu ;
    skos:hasTopConcept fraternalc:fuchs , fraternalc:bursch , fraternalc:alterHerr .

fraternalc:fuchs a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungDegrees ; skos:topConceptOf fraternalc:StudentenverbindungDegrees ;
    fraternal:degreeRank 1 ; fraternal:nextDegree fraternalc:bursch ; fraternal:degreeKind fraternalc:probationaryDegree ;
    skos:prefLabel "Fuchs"@en , "Fux"@sv , "Fuchs"@de , "Fuchs"@it , "Fuchs"@fr , "Fuchs"@es , "Fuchs"@pt , "Fuchs"@hu ;
    skos:altLabel "Fux"@de , "Probationary Member"@en , "Fox"@en ;
    skos:definition "The first stage: the probationary member, received at the Rezeption and trained during the Fuchsenzeit by the Fuchsmajor and a personal mentor (Leibbursch), until the Burschenprüfung."@en ,
                    "Det första stadiet: provmedlemmen, mottagen vid Rezeption och utbildad under Fuchsenzeit av Fuchsmajor och en personlig mentor (Leibbursch), fram till Burschenprüfung."@sv ,
                    "Die erste Stufe: das Probemitglied, bei der Rezeption aufgenommen und während der Fuchsenzeit vom Fuchsmajor und einem persönlichen Betreuer (Leibbursch) ausgebildet, bis zur Burschenprüfung."@de ,
                    "Il primo stadio: il socio in prova, ricevuto alla Rezeption e formato durante la Fuchsenzeit dal Fuchsmajor e da un tutore personale (Leibbursch), fino alla Burschenprüfung."@it ,
                    "La première étape : le membre à l'essai, reçu à la Rezeption et formé pendant la Fuchsenzeit par le Fuchsmajor et un parrain personnel (Leibbursch), jusqu'à la Burschenprüfung."@fr ,
                    "La primera etapa: el miembro a prueba, recibido en la Rezeption y formado durante la Fuchsenzeit por el Fuchsmajor y un mentor personal (Leibbursch), hasta la Burschenprüfung."@es ,
                    "A primeira etapa: o membro em prova, recebido na Rezeption e formado durante a Fuchsenzeit pelo Fuchsmajor e por um mentor pessoal (Leibbursch), até à Burschenprüfung."@pt ,
                    "Az első szakasz: a próbatag, akit a Rezeptionon fogadnak be, és a Fuchsenzeit alatt a Fuchsmajor és egy személyes mentor (Leibbursch) képez a Burschenprüfungig."@hu .

fraternalc:bursch a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungDegrees ; skos:topConceptOf fraternalc:StudentenverbindungDegrees ;
    fraternal:degreeRank 2 ; fraternal:nextDegree fraternalc:alterHerr ;
    skos:prefLabel "Bursch"@en , "Bursch"@sv , "Bursch"@de , "Bursch"@it , "Bursch"@fr , "Bursch"@es , "Bursch"@pt , "Bursch"@hu ;
    skos:altLabel "Bursche"@de , "Full Member"@en ;
    skos:definition "The second stage: the full member with a vote in the convent, who may hold offices and fight the Mensur."@en ,
                    "Det andra stadiet: den fulla medlemmen med rösträtt i konventet, som kan inneha ämbeten och utkämpa mensur."@sv ,
                    "Die zweite Stufe: das Vollmitglied mit Stimmrecht im Convent, das Ämter bekleiden und die Mensur fechten kann."@de ,
                    "Il secondo stadio: il socio pieno con voto nel convent, che può ricoprire cariche e battersi nella Mensur."@it ,
                    "La deuxième étape : le membre à part entière, avec voix au convent, qui peut tenir des fonctions et livrer la Mensur."@fr ,
                    "La segunda etapa: el miembro de pleno derecho con voto en el convent, que puede ocupar cargos y batirse en la Mensur."@es ,
                    "A segunda etapa: o membro de pleno direito com voto no convent, que pode ocupar cargos e bater-se na Mensur."@pt ,
                    "A második szakasz: a teljes jogú tag szavazati joggal a konventen, aki tisztséget tölthet be és Mensurt vívhat."@hu .

fraternalc:alterHerr a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungDegrees ; skos:topConceptOf fraternalc:StudentenverbindungDegrees ;
    fraternal:degreeRank 3 ;
    skos:prefLabel "Alter Herr"@en , "Alter Herr"@sv , "Alter Herr"@de , "Alter Herr"@it , "Alter Herr"@fr , "Alter Herr"@es , "Alter Herr"@pt , "Alter Herr"@hu ;
    skos:altLabel "Philister"@de , "Alumnus"@en , "AH"@de ;
    skos:definition "The third stage: the alumnus, who has left the active branch after his studies and belongs to the Altherrenschaft for life."@en ,
                    "Det tredje stadiet: alumnen, som lämnat aktivitas efter sina studier och tillhör Altherrenschaft livet ut."@sv ,
                    "Die dritte Stufe: der Ehemalige, der nach dem Studium aus der Aktivitas ausgeschieden ist und der Altherrenschaft auf Lebenszeit angehört."@de ,
                    "Il terzo stadio: l'ex alunno, che ha lasciato il ramo attivo dopo gli studi e appartiene per la vita all'Altherrenschaft."@it ,
                    "La troisième étape : l'ancien, qui a quitté la branche active après ses études et appartient à vie à l'Altherrenschaft."@fr ,
                    "La tercera etapa: el antiguo miembro, que ha dejado la rama activa tras sus estudios y pertenece de por vida a la Altherrenschaft."@es ,
                    "A terceira etapa: o antigo membro, que deixou o ramo ativo depois dos estudos e pertence para toda a vida à Altherrenschaft."@pt ,
                    "A harmadik szakasz: az öregdiák, aki a tanulmányai után elhagyta az aktív ágat, és életre az Altherrenschafthoz tartozik."@hu .

fraternalc:StudentenverbindungCategories a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:MembershipCategories ;
    skos:prefLabel "Membership Forms of a Studentenverbindung"@en , "Medlemsformer i en Studentenverbindung"@sv , "Mitgliedschaftsformen einer Studentenverbindung"@de , "Forme di appartenenza a una Studentenverbindung"@it , "Formes d'appartenance à une Studentenverbindung"@fr , "Formas de pertenencia a una Studentenverbindung"@es , "Formas de filiação numa Studentenverbindung"@pt , "Egy Studentenverbindung tagsági formái"@hu ;
    skos:definition "Forms of belonging to a Studentenverbindung beside the stages of fraternalc:StudentenverbindungDegrees, used with mbr:membershipCategory."@en ,
                    "Former av tillhörighet till en Studentenverbindung vid sidan av stadierna i fraternalc:StudentenverbindungDegrees, används med mbr:membershipCategory."@sv ,
                    "Formen der Zugehörigkeit zu einer Studentenverbindung neben den Stufen von fraternalc:StudentenverbindungDegrees, verwendet mit mbr:membershipCategory."@de ,
                    "Forme di appartenenza a una Studentenverbindung accanto agli stadi di fraternalc:StudentenverbindungDegrees, usate con mbr:membershipCategory."@it ,
                    "Formes d'appartenance à une Studentenverbindung à côté des étapes de fraternalc:StudentenverbindungDegrees, utilisées avec mbr:membershipCategory."@fr ,
                    "Formas de pertenecer a una Studentenverbindung además de las etapas de fraternalc:StudentenverbindungDegrees, usadas con mbr:membershipCategory."@es ,
                    "Formas de pertencer a uma Studentenverbindung além das etapas de fraternalc:StudentenverbindungDegrees, usadas com mbr:membershipCategory."@pt ,
                    "A Studentenverbindunghoz tartozás formái a fraternalc:StudentenverbindungDegrees szakaszai mellett, az mbr:membershipCategory-val használatosak."@hu ;
    skos:hasTopConcept fraternalc:aktiver , fraternalc:inaktiver .

fraternalc:aktiver a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCategories ; skos:topConceptOf fraternalc:StudentenverbindungCategories ;
    skos:prefLabel "Aktiver"@en , "Aktiv"@sv , "Aktiver"@de , "Aktiver"@it , "Aktiver"@fr , "Aktiver"@es , "Aktiver"@pt , "Aktiver"@hu ;
    skos:altLabel "Aktivitas"@de ;
    skos:definition "A Fuchs or Bursch who takes part in the life of the Verbindung while studying and shares its duties, offices and costs."@en ,
                    "En Fuchs eller Bursch som deltar i Verbindungens liv under sina studier och delar dess plikter, ämbeten och kostnader."@sv ,
                    "Ein Fuchs oder Bursch, der während des Studiums am Leben der Verbindung teilnimmt und ihre Pflichten, Ämter und Kosten teilt."@de ,
                    "Un Fuchs o un Bursch che partecipa alla vita della Verbindung durante gli studi e ne condivide doveri, cariche e costi."@it ,
                    "Un Fuchs ou un Bursch qui participe à la vie de la Verbindung pendant ses études et en partage les devoirs, les fonctions et les frais."@fr ,
                    "Un Fuchs o Bursch que participa en la vida de la Verbindung mientras estudia y comparte sus deberes, cargos y costes."@es ,
                    "Um Fuchs ou Bursch que participa na vida da Verbindung enquanto estuda e partilha os seus deveres, cargos e custos."@pt ,
                    "Fuchs vagy Bursch, aki tanulmányai alatt részt vesz a Verbindung életében, és osztozik kötelességeiben, tisztségeiben és költségeiben."@hu .

fraternalc:inaktiver a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungCategories ; skos:topConceptOf fraternalc:StudentenverbindungCategories ;
    skos:prefLabel "Inaktiver"@en , "Inaktiv"@sv , "Inaktiver"@de , "Inaktiver"@it , "Inaktiver"@fr , "Inaktiver"@es , "Inaktiver"@pt , "Inaktiver"@hu ;
    skos:altLabel "Inactive Member"@en , "Inaktiv"@de ;
    skos:definition "A Bursch released from the duties of an active member, for example while finishing his studies or staying abroad, who keeps his membership and his vote."@en ,
                    "En Bursch som befriats från en aktiv medlems skyldigheter, till exempel under slutförandet av studier eller utlandsvistelse, och som behåller sitt medlemskap och sin rösträtt."@sv ,
                    "Ein von den Pflichten eines Aktiven entbundener Bursch, etwa während des Studienabschlusses oder eines Auslandsaufenthalts, der seine Mitgliedschaft und sein Stimmrecht behält."@de ,
                    "Un Bursch esonerato dai doveri di socio attivo, per esempio mentre termina gli studi o soggiorna all'estero, che conserva l'appartenenza e il voto."@it ,
                    "Un Bursch dispensé des devoirs d'un membre actif, par exemple en finissant ses études ou en séjour à l'étranger, qui garde son appartenance et sa voix."@fr ,
                    "Un Bursch liberado de los deberes de un miembro activo, por ejemplo mientras termina sus estudios o está en el extranjero, que conserva su pertenencia y su voto."@es ,
                    "Um Bursch libertado dos deveres de um membro ativo, por exemplo enquanto termina os estudos ou está no estrangeiro, que conserva a sua filiação e o seu voto."@pt ,
                    "Az aktív tag kötelességei alól felmentett Bursch, például tanulmányai befejezése vagy külföldi tartózkodása idején, aki megtartja tagságát és szavazati jogát."@hu .

fraternalc:StudentenverbindungParticipationRoles a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:ParticipationRoles ;
    skos:prefLabel "Roles at Gatherings of a Studentenverbindung"@en , "Roller vid en Studentenverbindungs sammankomster"@sv , "Rollen bei Zusammenkünften einer Studentenverbindung"@de , "Ruoli alle riunioni di una Studentenverbindung"@it , "Rôles aux réunions d'une Studentenverbindung"@fr , "Papeles en las reuniones de una Studentenverbindung"@es , "Papéis nas reuniões de uma Studentenverbindung"@pt , "Szerepek egy Studentenverbindung összejövetelein"@hu ;
    skos:definition "Roles that non-members can take at the gatherings of a Studentenverbindung, used with mbr:participationRole."@en ,
                    "Roller som icke-medlemmar kan ha vid en Studentenverbindungs sammankomster, används med mbr:participationRole."@sv ,
                    "Rollen, die Nichtmitglieder bei den Zusammenkünften einer Studentenverbindung einnehmen können, verwendet mit mbr:participationRole."@de ,
                    "Ruoli che i non soci possono avere alle riunioni di una Studentenverbindung, usati con mbr:participationRole."@it ,
                    "Rôles que des non-membres peuvent tenir aux réunions d'une Studentenverbindung, utilisés avec mbr:participationRole."@fr ,
                    "Papeles que pueden desempeñar los no miembros en las reuniones de una Studentenverbindung, usados con mbr:participationRole."@es ,
                    "Papéis que podem desempenhar os não membros nas reuniões de uma Studentenverbindung, usados com mbr:participationRole."@pt ,
                    "Szerepek, amelyeket nem tagok betölthetnek egy Studentenverbindung összejövetelein, az mbr:participationRole-lal használatosak."@hu ;
    skos:hasTopConcept fraternalc:konkneipant .

fraternalc:konkneipant a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungParticipationRoles ; skos:topConceptOf fraternalc:StudentenverbindungParticipationRoles ;
    skos:prefLabel "Konkneipant"@en , "Konkneipant"@sv , "Konkneipant"@de , "Konkneipant"@it , "Konkneipant"@fr , "Konkneipant"@es , "Konkneipant"@pt , "Konkneipant"@hu ;
    skos:altLabel "Kneipgast"@de ;
    skos:definition "A student or alumnus who takes part in the gatherings of a Verbindung, for example the Kneipe, without being a member."@en ,
                    "En student eller alumn som deltar i en Verbindungs sammankomster, till exempel Kneipe, utan att vara medlem."@sv ,
                    "Ein Student oder Ehemaliger, der an den Zusammenkünften einer Verbindung, etwa der Kneipe, teilnimmt, ohne Mitglied zu sein."@de ,
                    "Uno studente o ex alunno che partecipa agli incontri di una Verbindung, per esempio alla Kneipe, senza esserne socio."@it ,
                    "Un étudiant ou un ancien qui prend part aux réunions d'une Verbindung, par exemple à la Kneipe, sans en être membre."@fr ,
                    "Un estudiante o antiguo alumno que participa en las reuniones de una Verbindung, por ejemplo la Kneipe, sin ser miembro."@es ,
                    "Um estudante ou antigo aluno que participa nas reuniões de uma Verbindung, por exemplo a Kneipe, sem ser membro."@pt ,
                    "Diák vagy öregdiák, aki tagság nélkül részt vesz egy Verbindung összejövetelein, például a Kneipén."@hu .

fraternalc:StudentenverbindungOffices a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:OfficeTypes ;
    skos:prefLabel "Offices of a Studentenverbindung"@en , "Ämbeten i en Studentenverbindung"@sv , "Chargen einer Studentenverbindung"@de , "Cariche di una Studentenverbindung"@it , "Fonctions d'une Studentenverbindung"@fr , "Cargos de una Studentenverbindung"@es , "Cargos de uma Studentenverbindung"@pt , "Egy Studentenverbindung tisztségei"@hu ;
    skos:definition "The offices (Chargen) common to Studentenverbindungen. Each is placed under a generic office in mappings/fraternal-offices.sssom.tsv; a Verbindung may use its own names."@en ,
                    "De ämbeten (Chargen) som är gemensamma för Studentenverbindungen. Varje ämbete placeras under ett generiskt ämbete i mappings/fraternal-offices.sssom.tsv; en Verbindung kan använda egna namn."@sv ,
                    "Die Chargen, die Studentenverbindungen gemeinsam sind. Jede ist in mappings/fraternal-offices.sssom.tsv einem allgemeinen Amt zugeordnet; eine Verbindung kann eigene Bezeichnungen verwenden."@de ,
                    "Le cariche (Chargen) comuni alle Studentenverbindungen. Ciascuna è collocata sotto una carica generica in mappings/fraternal-offices.sssom.tsv; una Verbindung può usare nomi propri."@it ,
                    "Les fonctions (Chargen) communes aux Studentenverbindungen. Chacune est placée sous une fonction générique dans mappings/fraternal-offices.sssom.tsv ; une Verbindung peut employer ses propres noms."@fr ,
                    "Los cargos (Chargen) comunes a las Studentenverbindungen. Cada uno se coloca bajo un cargo genérico en mappings/fraternal-offices.sssom.tsv; una Verbindung puede usar sus propios nombres."@es ,
                    "Os cargos (Chargen) comuns às Studentenverbindungen. Cada um coloca-se sob um cargo genérico em mappings/fraternal-offices.sssom.tsv; uma Verbindung pode usar os seus próprios nomes."@pt ,
                    "A Studentenverbindungenekben közös tisztségek (Chargen). Mindegyik általános tisztség alá kerül a mappings/fraternal-offices.sssom.tsv fájlban; egy Verbindung használhatja a saját neveit."@hu ;
    skos:hasTopConcept fraternalc:senior , fraternalc:consenior , fraternalc:scriptor , fraternalc:kassenwart ,
                       fraternalc:fuchsmajor , fraternalc:fechtwart , fraternalc:philistersenior .

fraternalc:senior a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungOffices ; skos:topConceptOf fraternalc:StudentenverbindungOffices ;
    skos:prefLabel "Senior"@en , "Senior"@sv , "Senior"@de , "Senior"@it , "Senior"@fr , "Senior"@es , "Senior"@pt , "Senior"@hu ;
    skos:altLabel "Sprecher"@de , "Erstchargierter"@de ;
    skos:definition "The head of the active branch of a Studentenverbindung, who chairs the convent and represents the Verbindung. Called Sprecher in a Burschenschaft."@en ,
                    "Chefen för en Studentenverbindungs aktivitas, som leder konventet och företräder Verbindungen. Kallas Sprecher i en Burschenschaft."@sv ,
                    "Der Leiter der Aktivitas einer Studentenverbindung, der den Convent leitet und die Verbindung vertritt. In einer Burschenschaft Sprecher genannt."@de ,
                    "Il capo del ramo attivo di una Studentenverbindung, che presiede il convent e rappresenta la Verbindung. Si chiama Sprecher in una Burschenschaft."@it ,
                    "Le chef de la branche active d'une Studentenverbindung, qui préside le convent et représente la Verbindung. Appelé Sprecher dans une Burschenschaft."@fr ,
                    "El jefe de la rama activa de una Studentenverbindung, que preside el convent y representa a la Verbindung. Se llama Sprecher en una Burschenschaft."@es ,
                    "O chefe do ramo ativo de uma Studentenverbindung, que preside ao convent e representa a Verbindung. Chama-se Sprecher numa Burschenschaft."@pt ,
                    "A Studentenverbindung aktív ágának vezetője, aki a konventen elnököl és képviseli a Verbindungot. A Burschenschaftban Sprechernek hívják."@hu .

fraternalc:consenior a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungOffices ; skos:topConceptOf fraternalc:StudentenverbindungOffices ;
    skos:prefLabel "Consenior"@en , "Konsenior"@sv , "Consenior"@de , "Consenior"@it , "Consenior"@fr , "Consenior"@es , "Consenior"@pt , "Consenior"@hu ;
    skos:altLabel "Zweitchargierter"@de , "Vorsitzender-Stellvertreter"@de ;
    skos:definition "The deputy of the Senior."@en ,
                    "Seniorens ställföreträdare."@sv ,
                    "Der Stellvertreter des Seniors."@de ,
                    "Il vice del Senior."@it ,
                    "L'adjoint du Senior."@fr ,
                    "El suplente del Senior."@es ,
                    "O substituto do Senior."@pt ,
                    "A Senior helyettese."@hu .

fraternalc:scriptor a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungOffices ; skos:topConceptOf fraternalc:StudentenverbindungOffices ;
    skos:prefLabel "Scriptor"@en , "Skriptor"@sv , "Scriptor"@de , "Scriptor"@it , "Scriptor"@fr , "Scriptor"@es , "Scriptor"@pt , "Scriptor"@hu ;
    skos:altLabel "Schriftwart"@de ;
    skos:definition "Keeps the minutes of the convent and the correspondence of the active branch."@en ,
                    "För konventets protokoll och aktivitasens korrespondens."@sv ,
                    "Führt die Protokolle des Conventes und die Korrespondenz der Aktivitas."@de ,
                    "Tiene il verbale del convent e la corrispondenza del ramo attivo."@it ,
                    "Tient les procès-verbaux du convent et la correspondance de la branche active."@fr ,
                    "Lleva las actas del convent y la correspondencia de la rama activa."@es ,
                    "Mantém as atas do convent e a correspondência do ramo ativo."@pt ,
                    "Vezeti a konvent jegyzőkönyvét és az aktív ág levelezését."@hu .

fraternalc:kassenwart a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungOffices ; skos:topConceptOf fraternalc:StudentenverbindungOffices ;
    skos:prefLabel "Kassenwart"@en , "Kassör"@sv , "Kassenwart"@de , "Kassenwart"@it , "Kassenwart"@fr , "Kassenwart"@es , "Kassenwart"@pt , "Kassenwart"@hu ;
    skos:altLabel "Kassier"@de , "Kassierer"@de , "Quästor"@de ;
    skos:definition "Manages the finances of the active branch."@en ,
                    "Förvaltar aktivitasens ekonomi."@sv ,
                    "Verwaltet die Finanzen der Aktivitas."@de ,
                    "Gestisce le finanze del ramo attivo."@it ,
                    "Gère les finances de la branche active."@fr ,
                    "Gestiona las finanzas de la rama activa."@es ,
                    "Gere as finanças do ramo ativo."@pt ,
                    "Az aktív ág pénzügyeit kezeli."@hu .

fraternalc:fuchsmajor a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungOffices ; skos:topConceptOf fraternalc:StudentenverbindungOffices ;
    skos:prefLabel "Fuchsmajor"@en , "Fuxmajor"@sv , "Fuchsmajor"@de , "Fuchsmajor"@it , "Fuchsmajor"@fr , "Fuchsmajor"@es , "Fuchsmajor"@pt , "Fuchsmajor"@hu ;
    skos:altLabel "Fuxmajor"@de , "Fuchswart"@de , "Master of Novices"@en ;
    skos:definition "Trains and examines the Füchse during the Fuchsenzeit and prepares them for the Burschenprüfung."@en ,
                    "Utbildar och examinerar Füchse under Fuchsenzeit och förbereder dem för Burschenprüfung."@sv ,
                    "Bildet die Füchse während der Fuchsenzeit aus, prüft sie und bereitet sie auf die Burschenprüfung vor."@de ,
                    "Forma ed esamina i Füchse durante la Fuchsenzeit e li prepara alla Burschenprüfung."@it ,
                    "Forme et examine les Füchse pendant la Fuchsenzeit et les prépare à la Burschenprüfung."@fr ,
                    "Forma y examina a los Füchse durante la Fuchsenzeit y los prepara para la Burschenprüfung."@es ,
                    "Forma e examina os Füchse durante a Fuchsenzeit e prepara-os para a Burschenprüfung."@pt ,
                    "Képzi és vizsgáztatja a Füchséket a Fuchsenzeit alatt, és felkészíti őket a Burschenprüfungra."@hu .

fraternalc:fechtwart a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungOffices ; skos:topConceptOf fraternalc:StudentenverbindungOffices ;
    skos:prefLabel "Fencing Officer"@en , "Fäktansvarig"@sv , "Fechtwart"@de , "Responsabile della scherma"@it , "Responsable de l'escrime"@fr , "Responsable de esgrima"@es , "Responsável pela esgrima"@pt , "Vívásfelelős"@hu ;
    skos:altLabel "Fechtchargierter"@de , "Fechtchargen"@de ;
    skos:definition "Arranges the fencing practice and the Mensuren of the Verbindung."@en ,
                    "Ordnar Verbindungens fäktövningar och mensurer."@sv ,
                    "Organisiert den Fechtbetrieb und die Mensuren der Verbindung."@de ,
                    "Organizza gli allenamenti di scherma e le Mensuren della Verbindung."@it ,
                    "Organise l'entraînement à l'escrime et les Mensuren de la Verbindung."@fr ,
                    "Organiza la práctica de esgrima y las Mensuren de la Verbindung."@es ,
                    "Organiza a prática de esgrima e as Mensuren da Verbindung."@pt ,
                    "Szervezi a Verbindung vívásgyakorlatait és Mensurjeit."@hu .

fraternalc:philistersenior a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:StudentenverbindungOffices ; skos:topConceptOf fraternalc:StudentenverbindungOffices ;
    skos:prefLabel "Philistersenior"@en , "Philistersenior"@sv , "Philistersenior"@de , "Philistersenior"@it , "Philistersenior"@fr , "Philistersenior"@es , "Philistersenior"@pt , "Philistersenior"@hu ;
    skos:altLabel "Altherrenvorsitzender"@de , "Vorsitzender der Altherrenschaft"@de ;
    skos:definition "The head of the alumni branch (Altherrenschaft) of a Studentenverbindung."@en ,
                    "Chefen för en Studentenverbindungs gammalherrarförening (Altherrenschaft)."@sv ,
                    "Der Vorsitzende der Altherrenschaft einer Studentenverbindung."@de ,
                    "Il capo del ramo degli ex alunni (Altherrenschaft) di una Studentenverbindung."@it ,
                    "Le chef de la branche des anciens (Altherrenschaft) d'une Studentenverbindung."@fr ,
                    "El jefe de la rama de antiguos alumnos (Altherrenschaft) de una Studentenverbindung."@es ,
                    "O chefe do ramo de antigos alunos (Altherrenschaft) de uma Studentenverbindung."@pt ,
                    "A Studentenverbindung öregdiák-ágának (Altherrenschaft) vezetője."@hu .

##############################################################################
# 10. TRADITION SCHEMES  (the content of the hub schemes above that belongs to
#     one tradition rather than to every order)
#
#     A hub scheme holds only what orders in many countries have in common. What
#     belongs to one tradition (the Masonic lodge, the French compagnonnage, the
#     German Studentenverbindung) sits in a scheme of its own that says
#     dcterms:isPartOf <hub scheme>. A concept is in the tradition scheme only,
#     not in the hub scheme as well. Where the hub has a counterpart the concept
#     is mapped to it (mappings/fraternal-offices*.sssom.tsv,
#     fraternal-studentenverbindung.sssom.tsv, fraternal-hubs.sssom.tsv,
#     fraternal-ceremonies.sssom.tsv); where it has none (the German principles
#     of fencing and colours, the names of the rites) the concept stands without
#     a mapping. The shapes accept a value from the hub scheme, from a scheme
#     that is part of it, or one mapped to it. The concept blocks keep their
#     place in the file; the scheme is the one named by skos:inScheme.
#     Draft from general knowledge: the wording needs native reviewers.
##############################################################################

fraternalc:MasonicLodgeOffices a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:OfficeTypes ;
    skos:prefLabel "Offices of a Masonic Lodge"@en , "Ämbeten i en frimurarloge"@sv , "Fonctions d'une loge maçonnique"@fr , "Ämter einer Freimaurerloge"@de , "Cariche di una loggia massonica"@it , "Cargos de una logia masónica"@es , "Cargos de uma loja maçónica"@pt , "Egy szabadkőműves páholy tisztségei"@hu ;
    skos:definition "Offices of a lodge that have no close equivalent among the generic office types: the Venerable Master, the two Wardens and the Expert. Each is placed under a generic office in mappings/fraternal-offices-fr.sssom.tsv. The treasurer, secretary, master of ceremonies, orator, almoner and tyler (couvreur) of a lodge are the generic mbrc:treasurer, mbrc:secretary, mbrc:masterOfCeremonies, mbrc:orator, mbrc:almoner and mbrc:provost."@en ,
                    "Ämbeten i en loge som saknar nära motsvarighet bland de generiska ämbetstyperna: vördnadsvärd mästare, de två uppsyningsmännen (wardens) och experten. Varje ämbete placeras under ett generiskt ämbete i mappings/fraternal-offices-fr.sssom.tsv. Logens skattmästare, sekreterare, ceremonimästare, talare, allmosegivare och vaktmästare (couvreur) är de generiska mbrc:treasurer, mbrc:secretary, mbrc:masterOfCeremonies, mbrc:orator, mbrc:almoner och mbrc:provost."@sv ,
                    "Fonctions d'une loge sans équivalent proche parmi les types de fonctions génériques : le Vénérable Maître, les deux Surveillants et l'Expert. Chacune est placée sous une fonction générique dans mappings/fraternal-offices-fr.sssom.tsv. Le trésorier, le secrétaire, le maître des cérémonies, l'orateur, l'hospitalier et le couvreur d'une loge correspondent aux fonctions génériques mbrc:treasurer, mbrc:secretary, mbrc:masterOfCeremonies, mbrc:orator, mbrc:almoner et mbrc:provost."@fr ,
                    "Ämter einer Loge, die unter den allgemeinen Amtsarten keine nahe Entsprechung haben: der Meister vom Stuhl, die beiden Aufseher und der Experte. Jedes ist in mappings/fraternal-offices-fr.sssom.tsv einem allgemeinen Amt zugeordnet. Schatzmeister, Schriftführer, Zeremonienmeister, Redner, Almosenier und Deckender (couvreur) einer Loge sind die allgemeinen mbrc:treasurer, mbrc:secretary, mbrc:masterOfCeremonies, mbrc:orator, mbrc:almoner und mbrc:provost."@de ,
                    "Cariche di una loggia che non hanno un equivalente vicino tra i tipi generici di carica: il Venerabile Maestro, i due Sorveglianti e l'Esperto. Ciascuna è associata a una carica generica in mappings/fraternal-offices-fr.sssom.tsv. Il tesoriere, il segretario, il maestro delle cerimonie, l'oratore, l'elemosiniere e il copritore (couvreur) di una loggia sono i generici mbrc:treasurer, mbrc:secretary, mbrc:masterOfCeremonies, mbrc:orator, mbrc:almoner e mbrc:provost."@it ,
                    "Cargos de una logia que no tienen un equivalente próximo entre los tipos de cargo genéricos: el Venerable Maestro, los dos Vigilantes y el Experto. Cada uno se coloca bajo un cargo genérico en mappings/fraternal-offices-fr.sssom.tsv. El tesorero, el secretario, el maestro de ceremonias, el orador, el limosnero y el cubridor (couvreur) de una logia son los genéricos mbrc:treasurer, mbrc:secretary, mbrc:masterOfCeremonies, mbrc:orator, mbrc:almoner y mbrc:provost."@es ,
                    "Cargos de uma loja que não têm um equivalente próximo entre os tipos de cargo genéricos: o Venerável Mestre, os dois Vigilantes e o Experto. Cada um coloca-se sob um cargo genérico em mappings/fraternal-offices-fr.sssom.tsv. O tesoureiro, o secretário, o mestre de cerimónias, o orador, o esmoler e o cobridor (couvreur) de uma loja são os genéricos mbrc:treasurer, mbrc:secretary, mbrc:masterOfCeremonies, mbrc:orator, mbrc:almoner e mbrc:provost."@pt ,
                    "A páholy tisztségei, amelyeknek nincs közeli megfelelőjük az általános tisztségtípusok között: a Tiszteletre méltó Mester, a két Felügyelő és a Szakértő. Mindegyik általános tisztség alá kerül a mappings/fraternal-offices-fr.sssom.tsv fájlban. A páholy pénztárosa, titkára, szertartásmestere, szónoka, alamizsnamestere és őrzője (couvreur) az általános mbrc:treasurer, mbrc:secretary, mbrc:masterOfCeremonies, mbrc:orator, mbrc:almoner és mbrc:provost."@hu ;
    skos:hasTopConcept fraternalc:venerableMaster , fraternalc:firstWarden , fraternalc:secondWarden ,
                       fraternalc:expert .

fraternalc:CompagnonnageOffices a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:OfficeTypes ;
    skos:prefLabel "Offices of the Compagnonnage"@en , "Ämbeten i compagnonnage"@sv , "Fonctions du compagnonnage"@fr , "Ämter des Compagnonnage"@de , "Cariche del compagnonnage"@it , "Cargos del compagnonnage"@es , "Cargos do compagnonnage"@pt , "A compagnonnage tisztségei"@hu ;
    skos:definition "Offices of a compagnons' house (cayenne) in the French compagnonnage: the house provost, the rôleur and the house mother. Each is placed under a generic office in mappings/fraternal-offices-fr.sssom.tsv."@en ,
                    "Ämbeten i ett compagnonhus (cayenne) i det franska compagnonnage: husföreståndaren (prévôt), rôleur och husmodern. Varje ämbete placeras under ett generiskt ämbete i mappings/fraternal-offices-fr.sssom.tsv."@sv ,
                    "Fonctions d'une maison de compagnons (cayenne) dans le compagnonnage français : le prévôt de maison, le rôleur et la mère. Chacune est placée sous une fonction générique dans mappings/fraternal-offices-fr.sssom.tsv."@fr ,
                    "Ämter eines Gesellenhauses (Cayenne) im französischen Compagnonnage: der Hausprevot, der Rôleur und die Hausmutter. Jedes ist in mappings/fraternal-offices-fr.sssom.tsv einem allgemeinen Amt zugeordnet."@de ,
                    "Cariche di una casa di compagnons (cayenne) nel compagnonnage francese: il prevosto della casa, il rôleur e la madre di casa. Ciascuna è associata a una carica generica in mappings/fraternal-offices-fr.sssom.tsv."@it ,
                    "Cargos de una casa de compagnons (cayenne) del compagnonnage francés: el preboste de la casa, el rôleur y la madre de la casa. Cada uno se coloca bajo un cargo genérico en mappings/fraternal-offices-fr.sssom.tsv."@es ,
                    "Cargos de uma casa de compagnons (cayenne) do compagnonnage francês: o preboste da casa, o rôleur e a mãe da casa. Cada um coloca-se sob um cargo genérico em mappings/fraternal-offices-fr.sssom.tsv."@pt ,
                    "A francia compagnonnage egy compagnon-háza (cayenne) tisztségei: a ház prépostja, a rôleur és a ház anyja. Mindegyik általános tisztség alá kerül a mappings/fraternal-offices-fr.sssom.tsv fájlban."@hu ;
    skos:hasTopConcept fraternalc:housePrevot , fraternalc:rolleur , fraternalc:houseMother .

fraternalc:AcademyOffices a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:OfficeTypes ;
    skos:prefLabel "Offices of an Academy"@en , "Ämbeten i en akademi"@sv , "Fonctions d'une académie"@fr , "Ämter einer Akademie"@de , "Cariche di un'accademia"@it , "Cargos de una academia"@es , "Cargos de uma academia"@pt , "Egy akadémia tisztségei"@hu ;
    skos:definition "Offices of an academy or learned society that have no close generic equivalent: the permanent secretary, who runs the academy and speaks for it. It is placed under a generic office in mappings/fraternal-offices-fr.sssom.tsv."@en ,
                    "Ämbeten i en akademi eller ett lärt sällskap som saknar nära generisk motsvarighet: ständige sekreteraren, som leder akademin och talar för den. Det placeras under ett generiskt ämbete i mappings/fraternal-offices-fr.sssom.tsv."@sv ,
                    "Fonctions d'une académie ou d'une société savante sans équivalent générique proche : le secrétaire perpétuel, qui dirige l'académie et parle en son nom. Elle est placée sous une fonction générique dans mappings/fraternal-offices-fr.sssom.tsv."@fr ,
                    "Ämter einer Akademie oder gelehrten Gesellschaft, die keine nahe allgemeine Entsprechung haben: der ständige Sekretär, der die Akademie leitet und für sie spricht. Es ist in mappings/fraternal-offices-fr.sssom.tsv einem allgemeinen Amt zugeordnet."@de ,
                    "Cariche di un'accademia o società dotta senza stretto equivalente generico: il segretario perpetuo, che dirige l'accademia e parla a suo nome. È associata a una carica generica in mappings/fraternal-offices-fr.sssom.tsv."@it ,
                    "Cargos de una academia o sociedad científica que no tienen un equivalente genérico próximo: el secretario perpetuo, que dirige la academia y habla en su nombre. Se coloca bajo un cargo genérico en mappings/fraternal-offices-fr.sssom.tsv."@es ,
                    "Cargos de uma academia ou sociedade científica que não têm um equivalente genérico próximo: o secretário perpétuo, que dirige a academia e fala em seu nome. Coloca-se sob um cargo genérico em mappings/fraternal-offices-fr.sssom.tsv."@pt ,
                    "Egy akadémia vagy tudós társaság tisztségei, amelyeknek nincs közeli általános megfelelőjük: az állandó titkár, aki vezeti az akadémiát és a nevében beszél. Általános tisztség alá kerül a mappings/fraternal-offices-fr.sssom.tsv fájlban."@hu ;
    skos:hasTopConcept fraternalc:perpetualSecretary .

fraternalc:MasonicRites a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:Characteristics ;
    skos:prefLabel "Masonic Rites"@en , "Riter inom frimureriet"@sv , "Rites maçonniques"@fr , "Freimaurerische Riten"@de , "Riti massonici"@it , "Ritos masónicos"@es , "Ritos maçónicos"@pt , "Szabadkőműves ritusok"@hu ;
    skos:definition "The rites in which a lodge or an obedience works its degrees: the Ancient and Accepted Scottish Rite, the French Rite and the Rectified Scottish Rite, under the general concept of a Masonic rite. Used with fraternal:characteristic."@en ,
                    "De riter i vilka en loge eller obedients arbetar sina grader: Ancient and Accepted Scottish Rite, Franska riten och Rectified Scottish Rite, under det allmänna begreppet frimurarrit. Används med fraternal:characteristic."@sv ,
                    "Les rites dans lesquels une loge ou une obédience travaille ses degrés : le Rite écossais ancien et accepté, le Rite français et le Rite écossais rectifié, sous le concept général de rite maçonnique. S'utilise avec fraternal:characteristic."@fr ,
                    "Die Riten, in denen eine Loge oder Obödienz ihre Grade arbeitet: der Alte und Angenommene Schottische Ritus, der Französische Ritus und der Rektifizierte Schottische Ritus, unter dem allgemeinen Begriff eines freimaurerischen Ritus. Wird mit fraternal:characteristic verwendet."@de ,
                    "I riti in cui una loggia o un'obbedienza lavora i propri gradi: il Rito Scozzese Antico ed Accettato, il Rito Francese e il Rito Scozzese Rettificato, sotto il concetto generale di rito massonico. Si usa con fraternal:characteristic."@it ,
                    "Los ritos en que una logia u obediencia trabaja sus grados: el Rito Escocés Antiguo y Aceptado, el Rito Francés y el Rito Escocés Rectificado, bajo el concepto general de rito masónico. Se usa con fraternal:characteristic."@es ,
                    "Os ritos em que uma loja ou obediência trabalha os seus graus: o Rito Escocês Antigo e Aceite, o Rito Francês e o Rito Escocês Retificado, sob o conceito geral de rito maçónico. Usa-se com fraternal:characteristic."@pt ,
                    "A ritusok, amelyekben egy páholy vagy obedienzia a fokozatait műveli: az Ősi és Elfogadott Skót Rítus, a Francia Rítus és a Reformált Skót Rítus, a szabadkőműves rítus általános fogalma alatt. A fraternal:characteristic-kal használatos."@hu ;
    skos:hasTopConcept fraternalc:masonicRite .

fraternalc:CompagnonnageCharacteristics a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:Characteristics ;
    skos:prefLabel "Characteristics of the Compagnonnage"@en , "Drag hos compagnonnage"@sv , "Caractéristiques du compagnonnage"@fr , "Merkmale des Compagnonnage"@de , "Caratteristiche del compagnonnage"@it , "Características del compagnonnage"@es , "Características do compagnonnage"@pt , "A compagnonnage jellemzői"@hu ;
    skos:definition "Traits of the craft brotherhoods of the French compagnonnage: the journey of training around the country (the Tour de France) and the masterpiece (chef-d'œuvre) as a condition of advancement. Used with fraternal:characteristic."@en ,
                    "Drag hos de franska hantverksbrödraskapen i compagnonnage: utbildningsresan runt i landet (Tour de France) och mästerstycket (chef-d'œuvre) som villkor för avancemang. Används med fraternal:characteristic."@sv ,
                    "Traits des confréries de métier du compagnonnage français : le voyage de formation à travers le pays (le Tour de France) et le chef-d'œuvre comme condition d'avancement. S'utilise avec fraternal:characteristic."@fr ,
                    "Merkmale der Handwerksbruderschaften des französischen Compagnonnage: die Ausbildungsreise durch das Land (die Tour de France) und das Meisterstück (chef-d'œuvre) als Bedingung des Aufstiegs. Wird mit fraternal:characteristic verwendet."@de ,
                    "Tratti delle confraternite di mestiere del compagnonnage francese: il viaggio di formazione attraverso il paese (il Tour de France) e il capolavoro (chef-d'œuvre) come condizione di avanzamento. Si usa con fraternal:characteristic."@it ,
                    "Rasgos de las hermandades de oficio del compagnonnage francés: el viaje de formación por el país (el Tour de France) y la obra maestra (chef-d'œuvre) como condición para el ascenso. Se usa con fraternal:characteristic."@es ,
                    "Traços das irmandades de ofício do compagnonnage francês: a viagem de formação pelo país (o Tour de France) e a obra-prima (chef-d'œuvre) como condição para a progressão. Usa-se com fraternal:characteristic."@pt ,
                    "A francia compagnonnage mesterségi testvériségeinek vonásai: a képzési utazás az országban (a Tour de France) és a remekmű (chef-d'œuvre) mint az előrelépés feltétele. A fraternal:characteristic-kal használatos."@hu ;
    skos:hasTopConcept fraternalc:itinerantTraining , fraternalc:masterpieceRequirement .

fraternalc:StudentenverbindungCharacteristics a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:Characteristics ;
    skos:prefLabel "Principles and Customs of a Studentenverbindung"@en , "Principer och sedvänjor i en Studentenverbindung"@sv , "Principes et usages d'une Studentenverbindung"@fr , "Prinzipien und Bräuche einer Studentenverbindung"@de , "Principi e usanze di una Studentenverbindung"@it , "Principios y costumbres de una Studentenverbindung"@es , "Princípios e costumes de uma Studentenverbindung"@pt , "Egy Studentenverbindung elvei és szokásai"@hu ;
    skos:definition "The principles and customs by which Studentenverbindungen differ from one another: lifelong membership, the convent as the body that decides, tolerance, satisfaction (the duty to give redress for an insult), the attitude to academic fencing (compulsory, optional or none) and wearing or carrying colours. Used with fraternal:characteristic."@en ,
                    "De principer och sedvänjor som skiljer Studentenverbindungen åt: livslångt medlemskap, konventet som beslutande organ, tolerans, satisfaktion (skyldigheten att ge upprättelse för en förolämpning), inställningen till akademisk fäktning (obligatorisk, frivillig eller ingen) och att bära eller föra färger. Används med fraternal:characteristic."@sv ,
                    "Les principes et usages par lesquels les Studentenverbindungen se distinguent : l'appartenance à vie, le convent comme organe de décision, la tolérance, la satisfaction (le devoir de donner réparation d'une offense), l'attitude envers l'escrime universitaire (obligatoire, facultative ou aucune) et le port ou la présentation des couleurs. S'utilise avec fraternal:characteristic."@fr ,
                    "Die Prinzipien und Bräuche, in denen sich Studentenverbindungen unterscheiden: der Lebensbund, der Convent als Beschlussorgan, Toleranz, Satisfaktion (die Pflicht, für eine Beleidigung Genugtuung zu geben), die Haltung zum akademischen Fechten (Pflicht, wahlweise oder keines) und das Tragen oder Führen von Farben. Wird mit fraternal:characteristic verwendet."@de ,
                    "I principi e le usanze in cui le Studentenverbindungen differiscono: l'appartenenza a vita, il convento come organo decisionale, la tolleranza, la satisfaktion (il dovere di dare soddisfazione per un'offesa), l'atteggiamento verso la scherma accademica (obbligatoria, facoltativa o assente) e il portare o esibire i colori. Si usa con fraternal:characteristic."@it ,
                    "Los principios y costumbres por los que las Studentenverbindungen se distinguen entre sí: la pertenencia de por vida, el convent como órgano que decide, la tolerancia, la satisfacción (el deber de dar reparación por una ofensa), la actitud ante la esgrima académica (obligatoria, optativa o ninguna) y llevar o portar colores. Se usa con fraternal:characteristic."@es ,
                    "Os princípios e costumes pelos quais as Studentenverbindungen se distinguem entre si: a filiação para toda a vida, o convent como órgão que decide, a tolerância, a satisfação (o dever de dar reparação por uma ofensa), a atitude perante a esgrima académica (obrigatória, facultativa ou nenhuma) e usar ou levar cores. Usa-se com fraternal:characteristic."@pt ,
                    "Az elvek és szokások, amelyek szerint a Studentenverbindungenek különböznek egymástól: az élethosszig tartó tagság, a konvent mint döntő testület, a tolerancia, az elégtétel (a kötelesség, hogy sértésért elégtételt adjanak), a viszony az akadémiai víváshoz (kötelező, választható vagy nincs) és a színek viselése vagy hordása. A fraternal:characteristic-kal használatos."@hu ;
    skos:hasTopConcept fraternalc:lifelongBond , fraternalc:conventPrinciple , fraternalc:tolerancePrinciple ,
                       fraternalc:satisfactionPrinciple , fraternalc:compulsoryFencing ,
                       fraternalc:optionalFencing , fraternalc:nonFencing , fraternalc:colourWearing ,
                       fraternalc:colourCarrying .

fraternalc:StudentenverbindungTypes a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:OrderTypes ;
    skos:prefLabel "Types of Studentenverbindung"@en , "Typer av Studentenverbindung"@sv , "Types de Studentenverbindung"@fr , "Arten von Studentenverbindungen"@de , "Tipi di Studentenverbindung"@it , "Tipos de Studentenverbindung"@es , "Tipos de Studentenverbindung"@pt , "A Studentenverbindung típusai"@hu ;
    skos:definition "The kinds of German-speaking student fraternity (Corps, Burschenschaft, Landsmannschaft, Turnerschaft, Sängerschaft and others), with the general concept Studentenverbindung above them and the federations they form. Each is placed under mbrc:fraternalOrganization and mbrc:studentSociety (a federation under mbrc:voluntaryAssociation) in mappings/fraternal-hubs.sssom.tsv."@en ,
                    "De slag av tyskspråkiga studentkorporationer (Corps, Burschenschaft, Landsmannschaft, Turnerschaft, Sängerschaft med flera), med det allmänna begreppet Studentenverbindung över dem och de förbund de bildar. Varje slag placeras under mbrc:fraternalOrganization och mbrc:studentSociety (ett förbund under mbrc:voluntaryAssociation) i mappings/fraternal-hubs.sssom.tsv."@sv ,
                    "Les sortes de corporations étudiantes germanophones (Corps, Burschenschaft, Landsmannschaft, Turnerschaft, Sängerschaft et autres), avec le concept général de Studentenverbindung au-dessus d'elles et les fédérations qu'elles forment. Chacune est placée sous mbrc:fraternalOrganization et mbrc:studentSociety (une fédération sous mbrc:voluntaryAssociation) dans mappings/fraternal-hubs.sssom.tsv."@fr ,
                    "Die Arten deutschsprachiger studentischer Verbindungen (Corps, Burschenschaft, Landsmannschaft, Turnerschaft, Sängerschaft und andere), mit dem allgemeinen Begriff Studentenverbindung darüber und den Verbänden, die sie bilden. Jede ist in mappings/fraternal-hubs.sssom.tsv unter mbrc:fraternalOrganization und mbrc:studentSociety (ein Verband unter mbrc:voluntaryAssociation) eingeordnet."@de ,
                    "I tipi di associazioni studentesche di lingua tedesca (Corps, Burschenschaft, Landsmannschaft, Turnerschaft, Sängerschaft e altri), con il concetto generale di Studentenverbindung sopra di essi e le federazioni che formano. Ciascuno è collocato sotto mbrc:fraternalOrganization e mbrc:studentSociety (una federazione sotto mbrc:voluntaryAssociation) in mappings/fraternal-hubs.sssom.tsv."@it ,
                    "Los tipos de fraternidad estudiantil de habla alemana (Corps, Burschenschaft, Landsmannschaft, Turnerschaft, Sängerschaft y otros), con el concepto general Studentenverbindung por encima y las federaciones que forman. Cada uno se coloca bajo mbrc:fraternalOrganization y mbrc:studentSociety (una federación bajo mbrc:voluntaryAssociation) en mappings/fraternal-hubs.sssom.tsv."@es ,
                    "Os tipos de fraternidade estudantil de língua alemã (Corps, Burschenschaft, Landsmannschaft, Turnerschaft, Sängerschaft e outros), com o conceito geral Studentenverbindung por cima e as federações que formam. Cada um coloca-se sob mbrc:fraternalOrganization e mbrc:studentSociety (uma federação sob mbrc:voluntaryAssociation) em mappings/fraternal-hubs.sssom.tsv."@pt ,
                    "A német nyelvű diákfraternitások fajtái (Corps, Burschenschaft, Landsmannschaft, Turnerschaft, Sängerschaft és mások), fölöttük a Studentenverbindung általános fogalmával és az általuk alkotott szövetségekkel. Mindegyik az mbrc:fraternalOrganization és az mbrc:studentSociety alá kerül (egy szövetség az mbrc:voluntaryAssociation alá) a mappings/fraternal-hubs.sssom.tsv fájlban."@hu ;
    skos:hasTopConcept fraternalc:studentenverbindung , fraternalc:studentenverbindungDachverband .

fraternalc:StudentenverbindungTitles a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:MemberTitles ;
    skos:prefLabel "Member Titles in a Studentenverbindung"@en , "Medlemstitlar i en Studentenverbindung"@sv , "Titres des membres d'une Studentenverbindung"@fr , "Mitgliedsanreden in einer Studentenverbindung"@de , "Appellativi dei soci di una Studentenverbindung"@it , "Tratamientos de los miembros en una Studentenverbindung"@es , "Tratamentos dos membros numa Studentenverbindung"@pt , "A tagok megszólításai egy Studentenverbindungben"@hu ;
    skos:definition "The forms of address in a Studentenverbindung: Bundesbruder and Bundesschwester, and Corpsbruder and Cartellbruder in the Corps and the Cartellverband. Each is placed under fraternalc:brother or fraternalc:sister in mappings/fraternal-studentenverbindung.sssom.tsv. Used with fraternal:memberTitle."@en ,
                    "Tilltalsformerna i en Studentenverbindung: Bundesbruder och Bundesschwester, samt Corpsbruder och Cartellbruder i Corps och Cartellverband. Varje form placeras under fraternalc:brother eller fraternalc:sister i mappings/fraternal-studentenverbindung.sssom.tsv. Används med fraternal:memberTitle."@sv ,
                    "Les formes d'appellation d'une Studentenverbindung : Bundesbruder et Bundesschwester, ainsi que Corpsbruder et Cartellbruder dans les Corps et le Cartellverband. Chacune est placée sous fraternalc:brother ou fraternalc:sister dans mappings/fraternal-studentenverbindung.sssom.tsv. S'utilise avec fraternal:memberTitle."@fr ,
                    "Die Anreden in einer Studentenverbindung: Bundesbruder und Bundesschwester sowie Corpsbruder und Cartellbruder in den Corps und im Cartellverband. Jede ist in mappings/fraternal-studentenverbindung.sssom.tsv unter fraternalc:brother oder fraternalc:sister eingeordnet. Wird mit fraternal:memberTitle verwendet."@de ,
                    "Gli appellativi in una Studentenverbindung: Bundesbruder e Bundesschwester, e Corpsbruder e Cartellbruder nei Corps e nel Cartellverband. Ciascuno è collocato sotto fraternalc:brother o fraternalc:sister in mappings/fraternal-studentenverbindung.sssom.tsv. Si usa con fraternal:memberTitle."@it ,
                    "Las formas de tratamiento en una Studentenverbindung: Bundesbruder y Bundesschwester, y Corpsbruder y Cartellbruder en los Corps y el Cartellverband. Cada una se coloca bajo fraternalc:brother o fraternalc:sister en mappings/fraternal-studentenverbindung.sssom.tsv. Se usa con fraternal:memberTitle."@es ,
                    "As formas de tratamento numa Studentenverbindung: Bundesbruder e Bundesschwester, e Corpsbruder e Cartellbruder nos Corps e no Cartellverband. Cada uma coloca-se sob fraternalc:brother ou fraternalc:sister em mappings/fraternal-studentenverbindung.sssom.tsv. Usa-se com fraternal:memberTitle."@pt ,
                    "A megszólítási formák egy Studentenverbindungben: Bundesbruder és Bundesschwester, valamint Corpsbruder és Cartellbruder a Corpsokban és a Cartellverbandban. Mindegyik a fraternalc:brother vagy fraternalc:sister alá kerül a mappings/fraternal-studentenverbindung.sssom.tsv fájlban. A fraternal:memberTitle-lel használatos."@hu ;
    skos:hasTopConcept fraternalc:bundesbruder , fraternalc:bundesschwester , fraternalc:corpsbruder ,
                       fraternalc:cartellbruder .

fraternalc:StudentenverbindungCeremonies a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:CeremonyTypes ;
    skos:prefLabel "Ceremonies and Customs of a Studentenverbindung"@en , "Ceremonier och sedvänjor i en Studentenverbindung"@sv , "Cérémonies et usages d'une Studentenverbindung"@fr , "Zeremonien und Bräuche einer Studentenverbindung"@de , "Cerimonie e usanze di una Studentenverbindung"@it , "Ceremonias y costumbres de una Studentenverbindung"@es , "Cerimónias e costumes de uma Studentenverbindung"@pt , "Egy Studentenverbindung szertartásai és szokásai"@hu ;
    skos:definition "Gatherings and customs of a Studentenverbindung: Rezeption, Burschung and Philistrierung (the steps of membership), Convent, Kneipe, Kommers, Stiftungsfest, Mensur and Fackelzug. Each is placed under a generic gathering type in mappings/fraternal-ceremonies.sssom.tsv. Used with mbr:gatheringType."@en ,
                    "Sammankomster och sedvänjor i en Studentenverbindung: Rezeption, Burschung och Philistrierung (medlemskapets steg), Convent, Kneipe, Kommers, Stiftungsfest, Mensur och Fackelzug. Varje placeras under en generisk sammankomsttyp i mappings/fraternal-ceremonies.sssom.tsv. Används med mbr:gatheringType."@sv ,
                    "Réunions et usages d'une Studentenverbindung : Rezeption, Burschung et Philistrierung (les étapes de l'appartenance), Convent, Kneipe, Kommers, Stiftungsfest, Mensur et Fackelzug. Chacun est placé sous un type de réunion générique dans mappings/fraternal-ceremonies.sssom.tsv. S'utilise avec mbr:gatheringType."@fr ,
                    "Zusammenkünfte und Bräuche einer Studentenverbindung: Rezeption, Burschung und Philistrierung (die Stufen der Mitgliedschaft), Convent, Kneipe, Kommers, Stiftungsfest, Mensur und Fackelzug. Jede ist in mappings/fraternal-ceremonies.sssom.tsv einer allgemeinen Versammlungsart zugeordnet. Wird mit mbr:gatheringType verwendet."@de ,
                    "Riunioni e usanze di una Studentenverbindung: Rezeption, Burschung e Philistrierung (i passaggi dell'appartenenza), Convent, Kneipe, Kommers, Stiftungsfest, Mensur e Fackelzug. Ciascuna è collocata sotto un tipo di riunione generico in mappings/fraternal-ceremonies.sssom.tsv. Si usa con mbr:gatheringType."@it ,
                    "Reuniones y costumbres de una Studentenverbindung: Rezeption, Burschung y Philistrierung (los pasos de la pertenencia), Convent, Kneipe, Kommers, Stiftungsfest, Mensur y Fackelzug. Cada una se coloca bajo un tipo de reunión genérico en mappings/fraternal-ceremonies.sssom.tsv. Se usa con mbr:gatheringType."@es ,
                    "Reuniões e costumes de uma Studentenverbindung: Rezeption, Burschung e Philistrierung (os passos da filiação), Convent, Kneipe, Kommers, Stiftungsfest, Mensur e Fackelzug. Cada uma coloca-se sob um tipo de reunião genérico em mappings/fraternal-ceremonies.sssom.tsv. Usa-se com mbr:gatheringType."@pt ,
                    "Egy Studentenverbindung összejövetelei és szokásai: Rezeption, Burschung és Philistrierung (a tagság lépései), Convent, Kneipe, Kommers, Stiftungsfest, Mensur és Fackelzug. Mindegyik általános összejövetel-típus alá kerül a mappings/fraternal-ceremonies.sssom.tsv fájlban. Az mbr:gatheringType-pal használatos."@hu ;
    skos:hasTopConcept fraternalc:burschung , fraternalc:convent , fraternalc:fackelzug , fraternalc:kneipe ,
                       fraternalc:kommers , fraternalc:mensur , fraternalc:philistrierung ,
                       fraternalc:rezeption , fraternalc:stiftungsfest .

fraternalc:StudentenverbindungInsignia a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Insignia of a Studentenverbindung"@en , "Insignier i en Studentenverbindung"@sv , "Insignes d'une Studentenverbindung"@fr , "Insignien einer Studentenverbindung"@de , "Insegne di una Studentenverbindung"@it , "Insignias de una Studentenverbindung"@es , "Insígnias de uma Studentenverbindung"@pt , "Egy Studentenverbindung jelvényei"@hu ;
    skos:definition "The insignia of a Studentenverbindung: the colour band (Couleurband), the cap (Cerevis), the sabre (Schläger), the full dress (Wichs) and the Zipfel. The band, the cap and the sabre are placed under fraternalc:ribbon, fraternalc:hat and fraternalc:sword in mappings/fraternal-studentenverbindung.sssom.tsv. Used with fraternal:insigniaType."@en ,
                    "En Studentenverbindungs insignier: färgbandet (Couleurband), mössan (Cerevis), sabeln (Schläger), högtidsdräkten (Wichs) och Zipfel. Bandet, mössan och sabeln placeras under fraternalc:ribbon, fraternalc:hat och fraternalc:sword i mappings/fraternal-studentenverbindung.sssom.tsv. Används med fraternal:insigniaType."@sv ,
                    "Les insignes d'une Studentenverbindung : le ruban aux couleurs (Couleurband), la casquette (Cerevis), le sabre (Schläger), la tenue de gala (Wichs) et le Zipfel. Le ruban, la casquette et le sabre sont placés sous fraternalc:ribbon, fraternalc:hat et fraternalc:sword dans mappings/fraternal-studentenverbindung.sssom.tsv. S'utilise avec fraternal:insigniaType."@fr ,
                    "Die Insignien einer Studentenverbindung: das Couleurband, die Mütze (Cerevis), der Schläger, die Festtracht (Wichs) und der Zipfel. Band, Mütze und Schläger sind in mappings/fraternal-studentenverbindung.sssom.tsv unter fraternalc:ribbon, fraternalc:hat und fraternalc:sword eingeordnet. Wird mit fraternal:insigniaType verwendet."@de ,
                    "Le insegne di una Studentenverbindung: il nastro dei colori (Couleurband), il berretto (Cerevis), la sciabola (Schläger), l'abito di gala (Wichs) e lo Zipfel. Il nastro, il berretto e la sciabola sono collocati sotto fraternalc:ribbon, fraternalc:hat e fraternalc:sword in mappings/fraternal-studentenverbindung.sssom.tsv. Si usa con fraternal:insigniaType."@it ,
                    "Las insignias de una Studentenverbindung: la banda de colores (Couleurband), el gorro (Cerevis), el sable (Schläger), el traje de gala (Wichs) y el Zipfel. La banda, el gorro y el sable se colocan bajo fraternalc:ribbon, fraternalc:hat y fraternalc:sword en mappings/fraternal-studentenverbindung.sssom.tsv. Se usa con fraternal:insigniaType."@es ,
                    "As insígnias de uma Studentenverbindung: a banda de cores (Couleurband), o barrete (Cerevis), o sabre (Schläger), o traje de gala (Wichs) e o Zipfel. A banda, o barrete e o sabre colocam-se sob fraternalc:ribbon, fraternalc:hat e fraternalc:sword em mappings/fraternal-studentenverbindung.sssom.tsv. Usa-se com fraternal:insigniaType."@pt ,
                    "Egy Studentenverbindung jelvényei: a színes szalag (Couleurband), a sapka (Cerevis), a kard (Schläger), a díszruha (Wichs) és a Zipfel. A szalag, a sapka és a kard a fraternalc:ribbon, fraternalc:hat és fraternalc:sword alá kerül a mappings/fraternal-studentenverbindung.sssom.tsv fájlban. A fraternal:insigniaType-pal használatos."@hu ;
    skos:hasTopConcept fraternalc:cerevis , fraternalc:couleurband , fraternalc:schlaeger , fraternalc:wichs ,
                       fraternalc:zipfel .

##############################################################################
# 11. SPAIN  (the Order of Charles III, the tuna, the cofradías)
# A first draft from general knowledge and Spanish Wikipedia, for a Spanish-speaking
# reviewer to check against the primary sources (the order's regulation in the BOE, the
# statutes of a hermandad). Each scheme is dcterms:isPartOf its hub scheme and every
# concept is mapped in mappings/fraternal-spain.sssom.tsv.
##############################################################################

fraternalc:CharlesIIIDegrees a skos:ConceptScheme , fraternal:DegreeSystem , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:ChivalricGrades ;
    skos:prefLabel "Grades of the Order of Charles III"@en , "Grader i Karl III:s orden"@sv , "Grades de l'ordre de Charles III"@fr , "Stufen des Karls-III.-Ordens"@de , "Gradi dell'Ordine di Carlo III"@it , "Grados de la Orden de Carlos III"@es , "Graus da Ordem de Carlos III"@pt , "A III. Károly-rend fokozatai"@hu ;
    skos:definition "The five grades of the Spanish Order of Charles III, from the lowest to the highest: Cross, Commander, Commander by Number, Grand Cross and Collar. Placed under the generic chivalric grades in mappings/fraternal-spain.sssom.tsv."@en ,
                    "De fem graderna i den spanska Karl III:s orden, från lägsta till högsta: Cruz, Encomienda, Encomienda de Número, Gran Cruz och Collar. Placeras under de generiska riddarordensgraderna i mappings/fraternal-spain.sssom.tsv."@sv ,
                    "Les cinq grades de l'ordre espagnol de Charles III, du plus bas au plus haut : Cruz, Encomienda, Encomienda de Número, Gran Cruz et Collar. Placés sous les grades génériques de style chevaleresque dans mappings/fraternal-spain.sssom.tsv."@fr ,
                    "Die fünf Stufen des spanischen Karls-III.-Ordens, von der niedrigsten bis zur höchsten: Cruz, Encomienda, Encomienda de Número, Gran Cruz und Collar. Unter die allgemeinen Ritterordensstufen gestellt in mappings/fraternal-spain.sssom.tsv."@de ,
                    "I cinque gradi dell'Ordine spagnolo di Carlo III, dal più basso al più alto: Cruz, Encomienda, Encomienda de Número, Gran Cruz e Collar. Collocati sotto i gradi cavallereschi generici in mappings/fraternal-spain.sssom.tsv."@it ,
                    "Los cinco grados de la Orden española de Carlos III, del más bajo al más alto: Cruz, Encomienda, Encomienda de Número, Gran Cruz y Collar. Colocados bajo los grados caballerescos genéricos en mappings/fraternal-spain.sssom.tsv."@es ,
                    "Os cinco graus da Ordem espanhola de Carlos III, do mais baixo ao mais alto: Cruz, Encomienda, Encomienda de Número, Gran Cruz e Collar. Colocados sob os graus cavaleirescos genéricos em mappings/fraternal-spain.sssom.tsv."@pt ,
                    "A spanyol III. Károly-rend öt fokozata a legalacsonyabbtól a legmagasabbig: Cruz, Encomienda, Encomienda de Número, Gran Cruz és Collar. Az általános lovagrendi fokozatok alá sorolva a mappings/fraternal-spain.sssom.tsv fájlban."@hu ;
    skos:hasTopConcept fraternalc:carlosIIICruz , fraternalc:carlosIIIEncomienda , fraternalc:carlosIIIEncomiendaDeNumero ,
                       fraternalc:carlosIIIGranCruz , fraternalc:carlosIIICollar .

fraternalc:carlosIIICruz a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CharlesIIIDegrees ; skos:topConceptOf fraternalc:CharlesIIIDegrees ;
    fraternal:degreeRank 1 ; fraternal:nextDegree fraternalc:carlosIIIEncomienda ;
    skos:prefLabel "Cross"@en , "Cruz"@sv , "Cruz"@fr , "Cruz"@de , "Cruz"@it , "Cruz"@es , "Cruz"@pt , "Kereszt"@hu ;
    skos:definition "The lowest of the five grades of the Order of Charles III."@en ,
                    "Den lägsta av de fem graderna i Karl III:s orden."@sv ,
                    "Le plus bas des cinq grades de l'ordre de Charles III."@fr ,
                    "Die niedrigste der fünf Stufen des Karls-III.-Ordens."@de ,
                    "Il più basso dei cinque gradi dell'Ordine di Carlo III."@it ,
                    "El más bajo de los cinco grados de la Orden de Carlos III."@es ,
                    "O mais baixo dos cinco graus da Ordem de Carlos III."@pt ,
                    "A III. Károly-rend öt fokozata közül a legalacsonyabb."@hu .

fraternalc:carlosIIIEncomienda a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CharlesIIIDegrees ; skos:topConceptOf fraternalc:CharlesIIIDegrees ;
    fraternal:degreeRank 2 ; fraternal:nextDegree fraternalc:carlosIIIEncomiendaDeNumero ;
    skos:prefLabel "Commander"@en , "Encomienda"@sv , "Encomienda"@fr , "Encomienda"@de , "Encomienda"@it , "Encomienda"@es , "Comendador"@pt , "Parancsnok"@hu ;
    skos:definition "The second grade of the Order of Charles III, above the Cross."@en ,
                    "Den andra graden i Karl III:s orden, över Cruz."@sv ,
                    "Le deuxième grade de l'ordre de Charles III, au-dessus de la Cruz."@fr ,
                    "Die zweite Stufe des Karls-III.-Ordens, über der Cruz."@de ,
                    "Il secondo grado dell'Ordine di Carlo III, sopra la Cruz."@it ,
                    "El segundo grado de la Orden de Carlos III, por encima de la Cruz."@es ,
                    "O segundo grau da Ordem de Carlos III, acima da Cruz."@pt ,
                    "A III. Károly-rend második fokozata, a Cruz felett."@hu .

fraternalc:carlosIIIEncomiendaDeNumero a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CharlesIIIDegrees ; skos:topConceptOf fraternalc:CharlesIIIDegrees ;
    fraternal:degreeRank 3 ; fraternal:nextDegree fraternalc:carlosIIIGranCruz ;
    skos:prefLabel "Commander by Number"@en , "Encomienda de Número"@sv , "Encomienda de Número"@fr , "Encomienda de Número"@de , "Encomienda de Número"@it , "Encomienda de Número"@es , "Comendador de número"@pt , "Rendes parancsnok"@hu ;
    skos:definition "The third grade of the Order of Charles III, above the Encomienda. It is given to citizens who have done notable service to Spain and have held the Encomienda for more than three years, or who meet the requirements for the Grand Cross without having held a high office."@en ,
                    "Den tredje graden i Karl III:s orden, över Encomienda. Den ges till medborgare som gjort Spanien anmärkningsvärda tjänster och haft Encomienda i mer än tre år, eller som uppfyller kraven för Gran Cruz utan att ha innehaft något högt ämbete."@sv ,
                    "Le troisième grade de l'ordre de Charles III, au-dessus de l'Encomienda. Il est accordé aux citoyens qui ont rendu des services notables à l'Espagne et détiennent l'Encomienda depuis plus de trois ans, ou qui remplissent les conditions de la Gran Cruz sans avoir exercé de haute fonction."@fr ,
                    "Die dritte Stufe des Karls-III.-Ordens, über der Encomienda. Sie wird Bürgern verliehen, die sich um Spanien verdient gemacht und die Encomienda länger als drei Jahre getragen haben, oder die die Voraussetzungen der Gran Cruz erfüllen, ohne ein hohes Amt innegehabt zu haben."@de ,
                    "Il terzo grado dell'Ordine di Carlo III, sopra l'Encomienda. È conferito ai cittadini che hanno reso servizi notevoli alla Spagna e hanno l'Encomienda da più di tre anni, o che soddisfano i requisiti della Gran Cruz senza aver ricoperto un'alta carica."@it ,
                    "El tercer grado de la Orden de Carlos III, por encima de la Encomienda. Se concede a los ciudadanos que han prestado notables servicios a España y tienen la Encomienda desde hace más de tres años, o que reúnen los requisitos de la Gran Cruz sin haber ocupado un cargo elevado."@es ,
                    "O terceiro grau da Ordem de Carlos III, acima da Encomienda. É concedido a cidadãos que prestaram serviços notáveis a Espanha e detêm a Encomienda há mais de três anos, ou que reúnem os requisitos da Gran Cruz sem terem ocupado um cargo elevado."@pt ,
                    "A III. Károly-rend harmadik fokozata, az Encomienda felett. Olyan állampolgároknak adják, akik kiemelkedő szolgálatot tettek Spanyolországnak, és több mint három éve birtokolják az Encomiendát, vagy akik megfelelnek a Gran Cruz követelményeinek anélkül, hogy magas tisztséget viseltek volna."@hu .

fraternalc:carlosIIIGranCruz a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CharlesIIIDegrees ; skos:topConceptOf fraternalc:CharlesIIIDegrees ;
    fraternal:degreeRank 4 ; fraternal:nextDegree fraternalc:carlosIIICollar ;
    skos:prefLabel "Grand Cross"@en , "Gran Cruz"@sv , "Gran Cruz"@fr , "Gran Cruz"@de , "Gran Cruz"@it , "Gran Cruz"@es , "Grã-Cruz"@pt , "Nagykereszt"@hu ;
    skos:definition "The fourth grade of the Order of Charles III, for those who have rendered outstanding service to Spain, in particular holders of high state office such as presidents of the chambers and of the high courts and ministers."@en ,
                    "Den fjärde graden i Karl III:s orden, för dem som gjort Spanien enastående tjänster, särskilt innehavare av höga statliga ämbeten som talmän, ordförande i de högsta domstolarna och ministrar."@sv ,
                    "Le quatrième grade de l'ordre de Charles III, pour ceux qui ont rendu des services éminents à l'Espagne, notamment les titulaires de hautes fonctions de l'État comme les présidents des chambres et des hautes juridictions et les ministres."@fr ,
                    "Die vierte Stufe des Karls-III.-Ordens, für diejenigen, die sich in herausragender Weise um Spanien verdient gemacht haben, insbesondere Inhaber hoher Staatsämter wie die Präsidenten der Kammern und der obersten Gerichte und Minister."@de ,
                    "Il quarto grado dell'Ordine di Carlo III, per coloro che hanno reso servizi eminenti alla Spagna, in particolare i titolari di alte cariche dello Stato come i presidenti delle camere e delle alte corti e i ministri."@it ,
                    "El cuarto grado de la Orden de Carlos III, para quienes han prestado servicios relevantes a España, en particular quienes ocupan o han ocupado altos cargos del Estado, como los presidentes de las cámaras y de los altos tribunales y los ministros."@es ,
                    "O quarto grau da Ordem de Carlos III, para quem prestou serviços relevantes a Espanha, em particular titulares de altos cargos do Estado, como os presidentes das câmaras e dos altos tribunais e os ministros."@pt ,
                    "A III. Károly-rend negyedik fokozata azoknak, akik kiemelkedő szolgálatot tettek Spanyolországnak, különösen a magas állami tisztséget viselőknek, például a kamarák és a legfelsőbb bíróságok elnökeinek és a minisztereknek."@hu .

fraternalc:carlosIIICollar a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:CharlesIIIDegrees ; skos:topConceptOf fraternalc:CharlesIIIDegrees ;
    fraternal:degreeRank 5 ;
    skos:prefLabel "Collar"@en , "Collar"@sv , "Collar"@fr , "Collar"@de , "Collar"@it , "Collar"@es , "Colar"@pt , "Lánc"@hu ;
    skos:definition "The highest grade of the Order of Charles III, reserved for members of the royal family, heads of state and of government, and Spanish citizens who have held the Grand Cross for at least three years, in a limited number."@en ,
                    "Den högsta graden i Karl III:s orden, förbehållen medlemmar av kungafamiljen, stats- och regeringschefer samt spanska medborgare som haft Gran Cruz i minst tre år, i begränsat antal."@sv ,
                    "Le plus haut grade de l'ordre de Charles III, réservé aux membres de la famille royale, aux chefs d'État et de gouvernement et aux citoyens espagnols qui ont détenu la Gran Cruz pendant au moins trois ans, en nombre limité."@fr ,
                    "Die höchste Stufe des Karls-III.-Ordens, vorbehalten den Mitgliedern der königlichen Familie, Staats- und Regierungschefs und spanischen Bürgern, die die Gran Cruz mindestens drei Jahre getragen haben, in begrenzter Zahl."@de ,
                    "Il grado più alto dell'Ordine di Carlo III, riservato ai membri della famiglia reale, ai capi di Stato e di governo e ai cittadini spagnoli che hanno avuto la Gran Cruz per almeno tre anni, in numero limitato."@it ,
                    "El grado más alto de la Orden de Carlos III, reservado a los miembros de la familia real, los jefes de Estado y de Gobierno y los ciudadanos españoles que posean la Gran Cruz al menos durante tres años, en número limitado."@es ,
                    "O grau mais alto da Ordem de Carlos III, reservado a membros da família real, chefes de Estado e de governo e cidadãos espanhóis que tenham a Gran Cruz há pelo menos três anos, em número limitado."@pt ,
                    "A III. Károly-rend legmagasabb fokozata, a királyi család tagjainak, az államfőknek és kormányfőknek, valamint azoknak a spanyol állampolgároknak fenntartva, akik legalább három éve birtokolják a Gran Cruzt, korlátozott számban."@hu .

fraternalc:TunaDegrees a skos:ConceptScheme , fraternal:DegreeSystem , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:MemberStages ;
    skos:prefLabel "Stages of a tuna"@en , "Stadier i en tuna"@sv , "Étapes d'une tuna"@fr , "Stufen einer Tuna"@de , "Stadi di una tuna"@it , "Etapas de una tuna"@es , "Etapas de uma tuna"@pt , "Egy tuna szakaszai"@hu ;
    skos:definition "The stages of a member of a tuna, the Spanish student music group: novato, pardillo and tuno. Many tunas have both of the first two before a candidate is baptised as a tuno; others have one."@en ,
                    "Stadierna för en medlem i en tuna, den spanska studentmusikgruppen: novato, pardillo och tuno. Många tunas har båda de två första innan en kandidat döps till tuno; andra har ett."@sv ,
                    "Les étapes d'un membre d'une tuna, le groupe musical étudiant espagnol : novato, pardillo et tuno. Beaucoup de tunas ont les deux premières avant qu'un candidat soit baptisé tuno ; d'autres n'en ont qu'une."@fr ,
                    "Die Stufen eines Mitglieds einer Tuna, der spanischen studentischen Musikgruppe: novato, pardillo und tuno. Viele Tunas kennen beide ersten Stufen, bevor ein Kandidat zum Tuno getauft wird; andere nur eine."@de ,
                    "Gli stadi di un membro di una tuna, il gruppo musicale studentesco spagnolo: novato, pardillo e tuno. Molte tunas hanno entrambi i primi due prima che un candidato sia battezzato tuno; altre ne hanno uno."@it ,
                    "Las etapas de un miembro de una tuna, el grupo musical estudiantil español: novato, pardillo y tuno. Muchas tunas tienen las dos primeras antes de que un candidato sea bautizado como tuno; otras tienen una."@es ,
                    "As etapas de um membro de uma tuna, o grupo musical estudantil espanhol: novato, pardillo e tuno. Muitas tunas têm as duas primeiras antes de um candidato ser batizado tuno; outras têm uma."@pt ,
                    "Egy tuna, a spanyol diák zenei csoport tagjának szakaszai: novato, pardillo és tuno. Sok tunában megvan az első kettő, mielőtt a jelöltet tunóvá keresztelik; másokban egy van."@hu ;
    skos:hasTopConcept fraternalc:novato , fraternalc:pardillo , fraternalc:tuno .

fraternalc:novato a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:TunaDegrees ; skos:topConceptOf fraternalc:TunaDegrees ;
    fraternal:degreeRank 1 ; fraternal:nextDegree fraternalc:pardillo ; fraternal:degreeKind fraternalc:probationaryDegree ;
    skos:prefLabel "Novato"@en , "Novato"@sv , "Novato"@fr , "Novato"@de , "Novato"@it , "Novato"@es , "Novato"@pt , "Novato"@hu ;
    skos:definition "The first stage: a new candidate who learns the music and customs of the tuna and helps the veterans, without the full costume."@en ,
                    "Det första stadiet: en ny kandidat som lär sig tunans musik och seder och hjälper veteranerna, utan den fulla dräkten."@sv ,
                    "La première étape : un nouveau candidat qui apprend la musique et les usages de la tuna et aide les vétérans, sans le costume complet."@fr ,
                    "Die erste Stufe: ein neuer Kandidat, der die Musik und die Bräuche der Tuna lernt und den Veteranen hilft, ohne das volle Kostüm."@de ,
                    "Il primo stadio: un nuovo candidato che impara la musica e le usanze della tuna e aiuta i veterani, senza il costume completo."@it ,
                    "La primera etapa: un nuevo candidato que aprende la música y las costumbres de la tuna y ayuda a los veteranos, sin el traje completo."@es ,
                    "A primeira etapa: um novo candidato que aprende a música e os costumes da tuna e ajuda os veteranos, sem o traje completo."@pt ,
                    "Az első szakasz: új jelölt, aki megtanulja a tuna zenéjét és szokásait, és segít a veteránoknak, a teljes öltözet nélkül."@hu .

fraternalc:pardillo a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:TunaDegrees ; skos:topConceptOf fraternalc:TunaDegrees ;
    fraternal:degreeRank 2 ; fraternal:nextDegree fraternalc:tuno ; fraternal:degreeKind fraternalc:probationaryDegree ;
    skos:prefLabel "Pardillo"@en , "Pardillo"@sv , "Pardillo"@fr , "Pardillo"@de , "Pardillo"@it , "Pardillo"@es , "Pardillo"@pt , "Pardillo"@hu ;
    skos:definition "The second stage in the tunas that have two: the candidate who has passed the first trials and is still an apprentice, before being baptised as a tuno."@en ,
                    "Det andra stadiet i de tunas som har två: kandidaten som klarat de första proven och fortfarande är lärling, före dopet till tuno."@sv ,
                    "La deuxième étape dans les tunas qui en ont deux : le candidat qui a passé les premières épreuves et reste apprenti, avant d'être baptisé tuno."@fr ,
                    "Die zweite Stufe in den Tunas, die zwei haben: der Kandidat, der die ersten Proben bestanden hat und noch Lehrling ist, vor der Taufe zum Tuno."@de ,
                    "Il secondo stadio nelle tunas che ne hanno due: il candidato che ha superato le prime prove ed è ancora apprendista, prima di essere battezzato tuno."@it ,
                    "La segunda etapa en las tunas que tienen dos: el candidato que ha superado las primeras pruebas y sigue siendo aprendiz, antes de ser bautizado como tuno."@es ,
                    "A segunda etapa nas tunas que têm duas: o candidato que passou as primeiras provas e continua aprendiz, antes de ser batizado tuno."@pt ,
                    "A második szakasz azokban a tunákban, amelyekben kettő van: a jelölt, aki túljutott az első próbákon és még tanonc, mielőtt tunóvá keresztelik."@hu .

fraternalc:tuno a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:TunaDegrees ; skos:topConceptOf fraternalc:TunaDegrees ;
    fraternal:degreeRank 3 ;
    skos:prefLabel "Tuno"@en , "Tuno"@sv , "Tuno"@fr , "Tuno"@de , "Tuno"@it , "Tuno"@es , "Tuno"@pt , "Tuno"@hu ;
    skos:definition "The full member, baptised in public before the group and other tunas, who wears the full costume with the beca."@en ,
                    "Den fulla medlemmen, döpt offentligt inför gruppen och andra tunas, som bär hela dräkten med beca."@sv ,
                    "Le membre à part entière, baptisé en public devant le groupe et les autres tunas, qui porte le costume complet avec la beca."@fr ,
                    "Das Vollmitglied, öffentlich vor der Gruppe und anderen Tunas getauft, das das volle Kostüm mit der Beca trägt."@de ,
                    "Il membro pieno, battezzato in pubblico davanti al gruppo e alle altre tunas, che indossa il costume completo con la beca."@it ,
                    "El miembro de pleno derecho, bautizado públicamente ante el grupo y las demás tunas, que viste el traje completo con la beca."@es ,
                    "O membro de pleno direito, batizado publicamente perante o grupo e as outras tunas, que veste o traje completo com a beca."@pt ,
                    "A teljes jogú tag, akit nyilvánosan megkereszteltek a csoport és a többi tuna előtt, és aki a teljes öltözetet viseli a becával."@hu .

fraternalc:TunaInsignia a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Insignia of a tuna"@en , "Insignier i en tuna"@sv , "Insignes d'une tuna"@fr , "Insignien einer Tuna"@de , "Insegne di una tuna"@it , "Insignias de una tuna"@es , "Insígnias de uma tuna"@pt , "Egy tuna jelvényei"@hu ;
    skos:definition "The insignia of a tuno: the beca and the cape. Placed under the generic sash and robe in mappings/fraternal-spain.sssom.tsv."@en ,
                    "Insignierna för en tuno: beca och kappan. Placeras under det generiska skärpet och mantlen i mappings/fraternal-spain.sssom.tsv."@sv ,
                    "Les insignes d'un tuno : la beca et la cape. Placées sous l'écharpe et la robe génériques dans mappings/fraternal-spain.sssom.tsv."@fr ,
                    "Die Insignien eines Tuno: die Beca und der Umhang. Unter die allgemeine Schärpe und das Gewand gestellt in mappings/fraternal-spain.sssom.tsv."@de ,
                    "Le insegne di un tuno: la beca e il mantello. Collocate sotto la fascia e la veste generiche in mappings/fraternal-spain.sssom.tsv."@it ,
                    "Las insignias de un tuno: la beca y la capa. Colocadas bajo la banda y la vestidura genéricas en mappings/fraternal-spain.sssom.tsv."@es ,
                    "As insígnias de um tuno: a beca e a capa. Colocadas sob a banda e a túnica genéricas em mappings/fraternal-spain.sssom.tsv."@pt ,
                    "A tuno jelvényei: a beca és a köpeny. Az általános vállszalag és köntös alá sorolva a mappings/fraternal-spain.sssom.tsv fájlban."@hu ;
    skos:hasTopConcept fraternalc:beca , fraternalc:capa .

fraternalc:beca a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:TunaInsignia ; skos:topConceptOf fraternalc:TunaInsignia ;
    skos:prefLabel "Beca"@en , "Beca"@sv , "Beca"@fr , "Beca"@de , "Beca"@it , "Beca"@es , "Beca"@pt , "Beca"@hu ;
    skos:definition "The band of cloth, silk or felt worn in a V over the chest and shoulders, in the colour of the faculty of the tuna. It once showed that the wearer held a university scholarship."@en ,
                    "Bandet av tyg, siden eller filt som bärs i V-form över bröstet och axlarna, i färgen på tunans fakultet. Det visade en gång att bäraren hade ett universitetsstipendium."@sv ,
                    "La bande de drap, de soie ou de feutre portée en V sur la poitrine et les épaules, dans la couleur de la faculté de la tuna. Elle montrait autrefois que le porteur avait une bourse universitaire."@fr ,
                    "Das Band aus Tuch, Seide oder Filz, in V-Form über Brust und Schultern getragen, in der Farbe der Fakultät der Tuna. Es zeigte einst, dass der Träger ein Universitätsstipendium hatte."@de ,
                    "La fascia di panno, seta o feltro portata a V sul petto e sulle spalle, nel colore della facoltà della tuna. Un tempo indicava che chi la portava aveva una borsa di studio universitaria."@it ,
                    "La banda de paño, seda o fieltro que se coloca en forma de V sobre el pecho y los hombros, del color de la facultad de la tuna. Antiguamente indicaba que su portador estaba becado por la universidad."@es ,
                    "A banda de pano, seda ou feltro que se usa em V sobre o peito e os ombros, da cor da faculdade da tuna. Antigamente indicava que quem a usava tinha uma bolsa da universidade."@pt ,
                    "A szövet-, selyem- vagy filcszalag, amelyet V alakban viselnek a mellkason és a vállon, a tuna karának színében. Egykor azt jelezte, hogy viselője egyetemi ösztöndíjas volt."@hu .

fraternalc:capa a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:TunaInsignia ; skos:topConceptOf fraternalc:TunaInsignia ;
    skos:prefLabel "Cape"@en , "Kappa"@sv , "Cape"@fr , "Umhang"@de , "Mantello"@it , "Capa"@es , "Capa"@pt , "Köpeny"@hu ;
    skos:altLabel "Manteo"@es ;
    skos:definition "The cape or manteo worn with the tuno's costume."@en ,
                    "Kappan eller manteon som bärs till tunons dräkt."@sv ,
                    "La cape ou manteo portée avec le costume du tuno."@fr ,
                    "Der Umhang oder Manteo, der zum Kostüm des Tuno getragen wird."@de ,
                    "Il mantello o manteo portato con il costume del tuno."@it ,
                    "La capa o manteo que se lleva con el traje del tuno."@es ,
                    "A capa ou manteo que se leva com o traje do tuno."@pt ,
                    "A tuno öltözetéhez viselt köpeny vagy manteo."@hu .

fraternalc:TunaCeremonies a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:CeremonyTypes ;
    skos:prefLabel "Ceremonies of a tuna"@en , "Ceremonier i en tuna"@sv , "Cérémonies d'une tuna"@fr , "Zeremonien einer Tuna"@de , "Cerimonie di una tuna"@it , "Ceremonias de una tuna"@es , "Cerimónias de uma tuna"@pt , "Egy tuna szertartásai"@hu ;
    skos:definition "The ceremony by which a candidate is baptised as a tuno. Placed under the generic ceremony in mappings/fraternal-spain.sssom.tsv."@en ,
                    "Ceremonin där en kandidat döps till tuno. Placeras under den generiska ceremonin i mappings/fraternal-spain.sssom.tsv."@sv ,
                    "La cérémonie par laquelle un candidat est baptisé tuno. Placée sous la cérémonie générique dans mappings/fraternal-spain.sssom.tsv."@fr ,
                    "Die Zeremonie, durch die ein Kandidat zum Tuno getauft wird. Unter die allgemeine Zeremonie gestellt in mappings/fraternal-spain.sssom.tsv."@de ,
                    "La cerimonia con cui un candidato è battezzato tuno. Collocata sotto la cerimonia generica in mappings/fraternal-spain.sssom.tsv."@it ,
                    "La ceremonia por la que un candidato es bautizado como tuno. Colocada bajo la ceremonia genérica en mappings/fraternal-spain.sssom.tsv."@es ,
                    "A cerimónia pela qual um candidato é batizado tuno. Colocada sob a cerimónia genérica em mappings/fraternal-spain.sssom.tsv."@pt ,
                    "A szertartás, amellyel a jelöltet tunóvá keresztelik. Az általános szertartás alá sorolva a mappings/fraternal-spain.sssom.tsv fájlban."@hu ;
    skos:hasTopConcept fraternalc:bautizoDeTuno .

fraternalc:bautizoDeTuno a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:TunaCeremonies ; skos:topConceptOf fraternalc:TunaCeremonies ;
    skos:prefLabel "Baptism of a Tuno"@en , "Tunodop"@sv , "Baptême d'un tuno"@fr , "Tuno-Taufe"@de , "Battesimo del tuno"@it , "Bautizo de tuno"@es , "Batizado de tuno"@pt , "Tuno-keresztelő"@hu ;
    skos:definition "The public ceremony before the group and other tunas at which a candidate is recognised as a tuno."@en ,
                    "Den offentliga ceremoni inför gruppen och andra tunas där en kandidat erkänns som tuno."@sv ,
                    "La cérémonie publique devant le groupe et les autres tunas où un candidat est reconnu comme tuno."@fr ,
                    "Die öffentliche Zeremonie vor der Gruppe und anderen Tunas, bei der ein Kandidat als Tuno anerkannt wird."@de ,
                    "La cerimonia pubblica davanti al gruppo e alle altre tunas in cui un candidato è riconosciuto come tuno."@it ,
                    "La ceremonia pública ante el grupo y las demás tunas en que un candidato es reconocido como tuno."@es ,
                    "A cerimónia pública perante o grupo e as outras tunas em que um candidato é reconhecido como tuno."@pt ,
                    "A nyilvános szertartás a csoport és a többi tuna előtt, amelyen a jelöltet tunóként ismerik el."@hu .

fraternalc:SpanishConfraternityOffices a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:OfficeTypes ;
    skos:prefLabel "Offices of a Spanish confraternity"@en , "Ämbeten i en spansk brödraskapsförening"@sv , "Fonctions d'une confrérie espagnole"@fr , "Ämter einer spanischen Bruderschaft"@de , "Cariche di una confraternita spagnola"@it , "Cargos de una cofradía española"@es , "Cargos de uma irmandade espanhola"@pt , "Egy spanyol társulat tisztségei"@hu ;
    skos:definition "The head of a Spanish cofradía or hermandad, the Hermano Mayor, placed under the generic president in mappings/fraternal-spain.sssom.tsv. The rest of the Junta de Gobierno uses the generic offices."@en ,
                    "Chefen för en spansk cofradía eller hermandad, Hermano Mayor, placerad under den generiska ordföranden i mappings/fraternal-spain.sssom.tsv. Resten av Junta de Gobierno använder de generiska ämbetena."@sv ,
                    "Le chef d'une cofradía ou hermandad espagnole, le Hermano Mayor, placé sous le président générique dans mappings/fraternal-spain.sssom.tsv. Le reste de la Junta de Gobierno utilise les fonctions génériques."@fr ,
                    "Das Oberhaupt einer spanischen Cofradía oder Hermandad, der Hermano Mayor, unter den allgemeinen Präsidenten gestellt in mappings/fraternal-spain.sssom.tsv. Der Rest der Junta de Gobierno verwendet die allgemeinen Ämter."@de ,
                    "Il capo di una cofradía o hermandad spagnola, l'Hermano Mayor, collocato sotto il presidente generico in mappings/fraternal-spain.sssom.tsv. Il resto della Junta de Gobierno usa le cariche generiche."@it ,
                    "El responsable de una cofradía o hermandad española, el Hermano Mayor, colocado bajo el presidente genérico en mappings/fraternal-spain.sssom.tsv. El resto de la Junta de Gobierno usa los cargos genéricos."@es ,
                    "O responsável de uma cofradía ou hermandad espanhola, o Hermano Mayor, colocado sob o presidente genérico em mappings/fraternal-spain.sssom.tsv. O resto da Junta de Gobierno usa os cargos genéricos."@pt ,
                    "Egy spanyol cofradía vagy hermandad vezetője, a Hermano Mayor, az általános elnök alá sorolva a mappings/fraternal-spain.sssom.tsv fájlban. A Junta de Gobierno többi tagja az általános tisztségeket használja."@hu ;
    skos:hasTopConcept fraternalc:hermanoMayor .

fraternalc:hermanoMayor a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:SpanishConfraternityOffices ; skos:topConceptOf fraternalc:SpanishConfraternityOffices ;
    skos:prefLabel "Hermano Mayor"@en , "Hermano Mayor"@sv , "Hermano Mayor"@fr , "Hermano Mayor"@de , "Hermano Mayor"@it , "Hermano Mayor"@es , "Hermano Mayor"@pt , "Hermano Mayor"@hu ;
    skos:altLabel "Elder Brother"@en , "Presidente"@es ;
    skos:definition "The president of a Spanish cofradía or hermandad, who heads its Junta de Gobierno and is elected to the office."@en ,
                    "Ordförande i en spansk cofradía eller hermandad, som leder dess Junta de Gobierno och väljs till ämbetet."@sv ,
                    "Le président d'une cofradía ou hermandad espagnole, qui dirige sa Junta de Gobierno et est élu à cette fonction."@fr ,
                    "Der Präsident einer spanischen Cofradía oder Hermandad, der ihre Junta de Gobierno leitet und in das Amt gewählt wird."@de ,
                    "Il presidente di una cofradía o hermandad spagnola, che guida la sua Junta de Gobierno ed è eletto alla carica."@it ,
                    "El presidente de una cofradía o hermandad española, que encabeza su Junta de Gobierno y es elegido para el cargo."@es ,
                    "O presidente de uma cofradía ou hermandad espanhola, que encabeça a sua Junta de Gobierno e é eleito para o cargo."@pt ,
                    "Egy spanyol cofradía vagy hermandad elnöke, aki a Junta de Gobierno élén áll, és tisztségére megválasztják."@hu .

fraternalc:SpanishConfraternityCeremonies a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:CeremonyTypes ;
    skos:prefLabel "Ceremonies of a Spanish confraternity"@en , "Ceremonier i en spansk brödraskapsförening"@sv , "Cérémonies d'une confrérie espagnole"@fr , "Zeremonien einer spanischen Bruderschaft"@de , "Cerimonie di una confraternita spagnola"@it , "Ceremonias de una cofradía española"@es , "Cerimónias de uma irmandade espanhola"@pt , "Egy spanyol társulat szertartásai"@hu ;
    skos:definition "The admission of a new brother (Jura de Reglas) and the public procession of the Holy Week confraternities (Estación de Penitencia). Placed under the generic ceremony and procession in mappings/fraternal-spain.sssom.tsv."@en ,
                    "Upptagningen av en ny broder (Jura de Reglas) och påskveckans brödraskaps offentliga procession (Estación de Penitencia). Placeras under den generiska ceremonin och processionen i mappings/fraternal-spain.sssom.tsv."@sv ,
                    "L'admission d'un nouveau frère (Jura de Reglas) et la procession publique des confréries de la Semaine sainte (Estación de Penitencia). Placées sous la cérémonie et la procession génériques dans mappings/fraternal-spain.sssom.tsv."@fr ,
                    "Die Aufnahme eines neuen Bruders (Jura de Reglas) und die öffentliche Prozession der Bruderschaften der Karwoche (Estación de Penitencia). Unter die allgemeine Zeremonie und Prozession gestellt in mappings/fraternal-spain.sssom.tsv."@de ,
                    "L'ammissione di un nuovo fratello (Jura de Reglas) e la processione pubblica delle confraternite della Settimana Santa (Estación de Penitencia). Collocate sotto la cerimonia e la processione generiche in mappings/fraternal-spain.sssom.tsv."@it ,
                    "La admisión de un nuevo hermano (Jura de Reglas) y la procesión pública de las cofradías de Semana Santa (Estación de Penitencia). Colocadas bajo la ceremonia y la procesión genéricas en mappings/fraternal-spain.sssom.tsv."@es ,
                    "A admissão de um novo irmão (Jura de Reglas) e a procissão pública das irmandades da Semana Santa (Estación de Penitencia). Colocadas sob a cerimónia e a procissão genéricas em mappings/fraternal-spain.sssom.tsv."@pt ,
                    "Egy új testvér felvétele (Jura de Reglas) és a nagyheti társulatok nyilvános körmenete (Estación de Penitencia). Az általános szertartás és felvonulás alá sorolva a mappings/fraternal-spain.sssom.tsv fájlban."@hu ;
    skos:hasTopConcept fraternalc:juraDeReglas , fraternalc:estacionDePenitencia .

fraternalc:juraDeReglas a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:SpanishConfraternityCeremonies ; skos:topConceptOf fraternalc:SpanishConfraternityCeremonies ;
    skos:prefLabel "Oath on the Rule"@en , "Ed på reglerna"@sv , "Serment sur la Règle"@fr , "Eid auf die Regel"@de , "Giuramento sulla Regola"@it , "Jura de Reglas"@es , "Juramento sobre as Regras"@pt , "Szabályeskü"@hu ;
    skos:definition "The act of admission into a cofradía: the new brother kisses the Book of Rules and swears to keep them, after a member has vouched for the candidate."@en ,
                    "Upptagningsakten i en cofradía: den nye brodern kysser regelboken och svär att hålla den, sedan en medlem gått i god för kandidaten."@sv ,
                    "L'acte d'admission dans une cofradía : le nouveau frère embrasse le Livre des Règles et jure de les respecter, après qu'un membre s'est porté garant du candidat."@fr ,
                    "Der Aufnahmeakt in eine Cofradía: der neue Bruder küsst das Regelbuch und schwört, es zu halten, nachdem ein Mitglied für den Kandidaten gebürgt hat."@de ,
                    "L'atto di ammissione in una cofradía: il nuovo fratello bacia il Libro delle Regole e giura di osservarle, dopo che un membro ha garantito per il candidato."@it ,
                    "El acto de admisión en una cofradía: el nuevo hermano besa el Libro de Reglas y jura cumplirlas, tras el aval de un hermano."@es ,
                    "O ato de admissão numa cofradía: o novo irmão beija o Livro das Regras e jura cumpri-las, depois do aval de um irmão."@pt ,
                    "A cofradíába felvétel aktusa: az új testvér megcsókolja a Szabálykönyvet, és megesküszik, hogy betartja, miután egy testvér kezeskedett a jelöltért."@hu .

fraternalc:estacionDePenitencia a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:SpanishConfraternityCeremonies ; skos:topConceptOf fraternalc:SpanishConfraternityCeremonies ;
    skos:prefLabel "Station of Penance"@en , "Botgöringsprocession"@sv , "Station de pénitence"@fr , "Bußprozession"@de , "Stazione di penitenza"@it , "Estación de penitencia"@es , "Estação de penitência"@pt , "Bűnbánati körmenet"@hu ;
    skos:definition "The public procession that a penitential cofradía makes in Holy Week."@en ,
                    "Den offentliga procession som en botgörande cofradía håller under påskveckan."@sv ,
                    "La procession publique qu'une cofradía pénitentielle fait pendant la Semaine sainte."@fr ,
                    "Die öffentliche Prozession, die eine Bußbruderschaft in der Karwoche hält."@de ,
                    "La processione pubblica che una cofradía penitenziale fa durante la Settimana Santa."@it ,
                    "La procesión pública que una cofradía penitencial hace en Semana Santa."@es ,
                    "A procissão pública que uma cofradía penitencial faz na Semana Santa."@pt ,
                    "A nyilvános körmenet, amelyet egy bűnbánati cofradía nagyhéten tart."@hu .

##############################################################################
# 12. PORTUGAL  (the honorific orders, the praxe, the Misericórdias)
# A first draft from general knowledge and Portuguese Wikipedia, for a Portuguese-speaking
# reviewer to check against the primary sources (the Lei das Ordens Honoríficas, the
# Código da Praxe of a university, the Compromisso of a Misericórdia). Each scheme is
# dcterms:isPartOf its hub scheme and every concept is mapped in
# mappings/fraternal-portugal.sssom.tsv.
##############################################################################

fraternalc:PortugueseOrderGrades a skos:ConceptScheme , fraternal:DegreeSystem , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:ChivalricGrades ;
    skos:prefLabel "Grades of the Portuguese Honorific Orders"@en , "Grader i de portugisiska förtjänstorden"@sv , "Grades des ordres honorifiques portugais"@fr , "Stufen der portugiesischen Verdienstorden"@de , "Gradi degli ordini onorifici portoghesi"@it , "Grados de las órdenes honoríficas portuguesas"@es , "Graus das Ordens Honoríficas Portuguesas"@pt , "A portugál érdemrendek fokozatai"@hu ;
    skos:definition "The six grades of the Portuguese honorific orders, from the lowest to the highest: Cavaleiro or Dama, Oficial, Comendador, Grande-Oficial, Grã-Cruz and Grande-Colar. The Grande-Colar is a special grade held only in some of the orders. In the orders of civil merit the lowest grade is a Medalha in place of the Cavaleiro. The President of the Republic is the Grand Master of all the orders. Placed one to one under the generic chivalric grades in mappings/fraternal-portugal.sssom.tsv."@en ,
                    "De sex graderna i de portugisiska förtjänstorden, från lägsta till högsta: Cavaleiro eller Dama, Oficial, Comendador, Grande-Oficial, Grã-Cruz och Grande-Colar. Grande-Colar är en särskild grad som bara finns i vissa av orden. I förtjänstorden för civila insatser är den lägsta graden en Medalha i stället för Cavaleiro. Republikens president är stormästare i alla orden. Placeras ett till ett under de generiska riddarordensgraderna i mappings/fraternal-portugal.sssom.tsv."@sv ,
                    "Les six grades des ordres honorifiques portugais, du plus bas au plus haut : Cavaleiro ou Dama, Oficial, Comendador, Grande-Oficial, Grã-Cruz et Grande-Colar. Le Grande-Colar est un grade spécial qui n'existe que dans certains ordres. Dans les ordres du mérite civil, le grade le plus bas est une Medalha au lieu du Cavaleiro. Le président de la République est grand maître de tous les ordres. Placés un à un sous les grades génériques de style chevaleresque dans mappings/fraternal-portugal.sssom.tsv."@fr ,
                    "Die sechs Stufen der portugiesischen Verdienstorden, von der niedrigsten bis zur höchsten: Cavaleiro oder Dama, Oficial, Comendador, Grande-Oficial, Grã-Cruz und Grande-Colar. Das Grande-Colar ist eine besondere Stufe, die es nur in einigen der Orden gibt. In den Orden des zivilen Verdienstes ist die niedrigste Stufe eine Medalha anstelle des Cavaleiro. Der Präsident der Republik ist Großmeister aller Orden. Eins zu eins unter die allgemeinen Ritterordensstufen gestellt in mappings/fraternal-portugal.sssom.tsv."@de ,
                    "I sei gradi degli ordini onorifici portoghesi, dal più basso al più alto: Cavaleiro o Dama, Oficial, Comendador, Grande-Oficial, Grã-Cruz e Grande-Colar. Il Grande-Colar è un grado speciale che esiste solo in alcuni degli ordini. Negli ordini del merito civile il grado più basso è una Medalha al posto del Cavaleiro. Il Presidente della Repubblica è Gran Maestro di tutti gli ordini. Collocati uno a uno sotto i gradi cavallereschi generici in mappings/fraternal-portugal.sssom.tsv."@it ,
                    "Los seis grados de las órdenes honoríficas portuguesas, del más bajo al más alto: Cavaleiro o Dama, Oficial, Comendador, Grande-Oficial, Grã-Cruz y Grande-Colar. El Grande-Colar es un grado especial que solo existe en algunas de las órdenes. En las órdenes de mérito civil el grado más bajo es una Medalha en lugar del Cavaleiro. El Presidente de la República es Gran Maestre de todas las órdenes. Colocados uno a uno bajo los grados caballerescos genéricos en mappings/fraternal-portugal.sssom.tsv."@es ,
                    "Os seis graus das Ordens Honoríficas Portuguesas, do mais baixo ao mais alto: Cavaleiro ou Dama, Oficial, Comendador, Grande-Oficial, Grã-Cruz e Grande-Colar. O Grande-Colar é um grau especial que existe apenas em algumas das Ordens. Nas Ordens de Mérito Civil o grau mais baixo é a Medalha, em vez de Cavaleiro. O Presidente da República é o Grão-Mestre de todas as Ordens. Colocados um a um sob os graus genéricos de estilo cavaleiresco em mappings/fraternal-portugal.sssom.tsv."@pt ,
                    "A portugál érdemrendek hat fokozata a legalacsonyabbtól a legmagasabbig: Cavaleiro vagy Dama, Oficial, Comendador, Grande-Oficial, Grã-Cruz és Grande-Colar. A Grande-Colar különleges fokozat, amely csak néhány rendben van meg. A polgári érdemrendekben a legalacsonyabb fokozat a Cavaleiro helyett Medalha. A köztársasági elnök minden rend nagymestere. Egy-egy megfeleltetéssel az általános lovagrendi fokozatok alá sorolva a mappings/fraternal-portugal.sssom.tsv fájlban."@hu ;
    skos:hasTopConcept fraternalc:ptCavaleiro , fraternalc:ptOficial , fraternalc:ptComendador ,
                       fraternalc:ptGrandeOficial , fraternalc:ptGraCruz , fraternalc:ptGrandeColar .

fraternalc:ptCavaleiro a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:PortugueseOrderGrades ; skos:topConceptOf fraternalc:PortugueseOrderGrades ;
    fraternal:degreeRank 1 ; fraternal:nextDegree fraternalc:ptOficial ;
    skos:prefLabel "Knight or Dame"@en , "Cavaleiro eller Dama"@sv , "Cavaleiro ou Dama"@fr , "Cavaleiro oder Dama"@de , "Cavaleiro o Dama"@it , "Cavaleiro o Dama"@es , "Cavaleiro ou Dama"@pt , "Lovag vagy hölgy"@hu ;
    skos:altLabel "Cavaleiro"@pt , "Dama"@pt ;
    skos:definition "The lowest grade of the Portuguese honorific orders, found in the old military orders and the national orders. In the orders of civil merit a Medalha takes its place."@en ,
                    "Den lägsta graden i de portugisiska förtjänstorden, som finns i de gamla militärorden och de nationella orden. I förtjänstorden för civila insatser tar en Medalha dess plats."@sv ,
                    "Le grade le plus bas des ordres honorifiques portugais, présent dans les anciens ordres militaires et les ordres nationaux. Dans les ordres du mérite civil, une Medalha le remplace."@fr ,
                    "Die niedrigste Stufe der portugiesischen Verdienstorden, die es in den alten Militärorden und den Nationalorden gibt. In den Orden des zivilen Verdienstes tritt eine Medalha an ihre Stelle."@de ,
                    "Il grado più basso degli ordini onorifici portoghesi, presente negli antichi ordini militari e negli ordini nazionali. Negli ordini del merito civile lo sostituisce una Medalha."@it ,
                    "El grado más bajo de las órdenes honoríficas portuguesas, presente en las antiguas órdenes militares y en las órdenes nacionales. En las órdenes de mérito civil lo sustituye una Medalha."@es ,
                    "O grau mais baixo das Ordens Honoríficas Portuguesas, existente nas Antigas Ordens Militares e nas Ordens Nacionais. Nas Ordens de Mérito Civil é substituído pela Medalha."@pt ,
                    "A portugál érdemrendek legalacsonyabb fokozata, az egykori katonai rendekben és a nemzeti rendekben. A polgári érdemrendekben Medalha lép a helyére."@hu .

fraternalc:ptOficial a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:PortugueseOrderGrades ; skos:topConceptOf fraternalc:PortugueseOrderGrades ;
    fraternal:degreeRank 2 ; fraternal:nextDegree fraternalc:ptComendador ;
    skos:prefLabel "Officer"@en , "Oficial"@sv , "Oficial"@fr , "Oficial"@de , "Oficial"@it , "Oficial"@es , "Oficial"@pt , "Tiszt"@hu ;
    skos:definition "The second grade of the Portuguese honorific orders, above the Cavaleiro; the badge is a medal with a rosette in the colour of the ribbon."@en ,
                    "Den andra graden i de portugisiska förtjänstorden, över Cavaleiro; märket är en medalj med en rosett i bandets färg."@sv ,
                    "Le deuxième grade des ordres honorifiques portugais, au-dessus du Cavaleiro ; l'insigne est une médaille avec une rosette de la couleur du ruban."@fr ,
                    "Die zweite Stufe der portugiesischen Verdienstorden, über dem Cavaleiro; das Abzeichen ist eine Medaille mit einer Rosette in der Farbe des Bandes."@de ,
                    "Il secondo grado degli ordini onorifici portoghesi, sopra il Cavaleiro; l'insegna è una medaglia con una rosetta del colore del nastro."@it ,
                    "El segundo grado de las órdenes honoríficas portuguesas, por encima del Cavaleiro; la insignia es una medalla con una roseta del color de la cinta."@es ,
                    "O segundo grau das Ordens Honoríficas Portuguesas, acima de Cavaleiro; a insígnia é uma medalha com roseta da cor da fita."@pt ,
                    "A portugál érdemrendek második fokozata, a Cavaleiro felett; a jelvény a szalag színű rozettával ellátott érem."@hu .

fraternalc:ptComendador a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:PortugueseOrderGrades ; skos:topConceptOf fraternalc:PortugueseOrderGrades ;
    fraternal:degreeRank 3 ; fraternal:nextDegree fraternalc:ptGrandeOficial ;
    skos:prefLabel "Commander"@en , "Comendador"@sv , "Comendador"@fr , "Comendador"@de , "Comendador"@it , "Comendador"@es , "Comendador"@pt , "Parancsnok"@hu ;
    skos:definition "The third grade of the Portuguese honorific orders, above the Oficial; the insignia are a ribbon at the neck and a silver enamelled plaque."@en ,
                    "Den tredje graden i de portugisiska förtjänstorden, över Oficial; insignierna är ett band runt halsen och en emaljerad silverplakett."@sv ,
                    "Le troisième grade des ordres honorifiques portugais, au-dessus de l'Oficial ; les insignes sont un ruban au cou et une plaque d'argent émaillé."@fr ,
                    "Die dritte Stufe der portugiesischen Verdienstorden, über dem Oficial; die Insignien sind ein Band am Hals und eine Platte aus emailliertem Silber."@de ,
                    "Il terzo grado degli ordini onorifici portoghesi, sopra l'Oficial; le insegne sono un nastro al collo e una placca d'argento smaltato."@it ,
                    "El tercer grado de las órdenes honoríficas portuguesas, por encima del Oficial; las insignias son una cinta al cuello y una placa de plata esmaltada."@es ,
                    "O terceiro grau das Ordens Honoríficas Portuguesas, acima de Oficial; as insígnias são uma fita ao pescoço e uma placa de prata esmaltada."@pt ,
                    "A portugál érdemrendek harmadik fokozata, az Oficial felett; a jelvények a nyakszalag és az ezüst zománcozott lap."@hu .

fraternalc:ptGrandeOficial a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:PortugueseOrderGrades ; skos:topConceptOf fraternalc:PortugueseOrderGrades ;
    fraternal:degreeRank 4 ; fraternal:nextDegree fraternalc:ptGraCruz ;
    skos:prefLabel "Grand Officer"@en , "Grande-Oficial"@sv , "Grande-Oficial"@fr , "Grande-Oficial"@de , "Grande-Oficial"@it , "Grande-Oficial"@es , "Grande-Oficial"@pt , "Nagytiszt"@hu ;
    skos:definition "The fourth grade of the Portuguese honorific orders, above the Comendador; the same ribbon as the Comendador, with a gold enamelled plaque."@en ,
                    "Den fjärde graden i de portugisiska förtjänstorden, över Comendador; samma band som Comendador, med en emaljerad guldplakett."@sv ,
                    "Le quatrième grade des ordres honorifiques portugais, au-dessus du Comendador ; le même ruban que le Comendador, avec une plaque d'or émaillé."@fr ,
                    "Die vierte Stufe der portugiesischen Verdienstorden, über dem Comendador; dasselbe Band wie beim Comendador, mit einer Platte aus emailliertem Gold."@de ,
                    "Il quarto grado degli ordini onorifici portoghesi, sopra il Comendador; lo stesso nastro del Comendador, con una placca d'oro smaltato."@it ,
                    "El cuarto grado de las órdenes honoríficas portuguesas, por encima del Comendador; la misma cinta que el Comendador, con una placa de oro esmaltado."@es ,
                    "O quarto grau das Ordens Honoríficas Portuguesas, acima de Comendador; a mesma fita do Comendador, com placa de ouro esmaltado."@pt ,
                    "A portugál érdemrendek negyedik fokozata, a Comendador felett; ugyanaz a szalag, mint a Comendadornak, arany zománcozott lappal."@hu .

fraternalc:ptGraCruz a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:PortugueseOrderGrades ; skos:topConceptOf fraternalc:PortugueseOrderGrades ;
    fraternal:degreeRank 5 ; fraternal:nextDegree fraternalc:ptGrandeColar ;
    skos:prefLabel "Grand Cross"@en , "Grã-Cruz"@sv , "Grã-Cruz"@fr , "Grã-Cruz"@de , "Grã-Cruz"@it , "Grã-Cruz"@es , "Grã-Cruz"@pt , "Nagykereszt"@hu ;
    skos:definition "The fifth grade of the Portuguese honorific orders, above the Grande-Oficial; the insignia are a sash worn across the body from right to left and a gold enamelled plaque."@en ,
                    "Den femte graden i de portugisiska förtjänstorden, över Grande-Oficial; insignierna är ett skärp som bärs diagonalt från höger till vänster och en emaljerad guldplakett."@sv ,
                    "Le cinquième grade des ordres honorifiques portugais, au-dessus du Grande-Oficial ; les insignes sont une écharpe portée en travers du corps de droite à gauche et une plaque d'or émaillé."@fr ,
                    "Die fünfte Stufe der portugiesischen Verdienstorden, über dem Grande-Oficial; die Insignien sind eine Schärpe, von rechts nach links quer über den Körper getragen, und eine Platte aus emailliertem Gold."@de ,
                    "Il quinto grado degli ordini onorifici portoghesi, sopra il Grande-Oficial; le insegne sono una fascia portata a tracolla da destra a sinistra e una placca d'oro smaltato."@it ,
                    "El quinto grado de las órdenes honoríficas portuguesas, por encima del Grande-Oficial; las insignias son una banda cruzada de derecha a izquierda y una placa de oro esmaltado."@es ,
                    "O quinto grau das Ordens Honoríficas Portuguesas, acima de Grande-Oficial; as insígnias são uma banda a tiracolo da direita para a esquerda e uma placa de ouro esmaltado."@pt ,
                    "A portugál érdemrendek ötödik fokozata, a Grande-Oficial felett; a jelvények a jobbról balra átlósan viselt vállszalag és az arany zománcozott lap."@hu .

fraternalc:ptGrandeColar a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:PortugueseOrderGrades ; skos:topConceptOf fraternalc:PortugueseOrderGrades ;
    fraternal:degreeRank 6 ;
    skos:prefLabel "Grand Collar"@en , "Grande-Colar"@sv , "Grande-Colar"@fr , "Grande-Colar"@de , "Grande-Colar"@it , "Grande-Colar"@es , "Grande-Colar"@pt , "Nagylánc"@hu ;
    skos:definition "The special highest grade of the Portuguese honorific orders, held only in some of them and traditionally reserved for heads of state; its insignia are a large enamelled gold collar, a sash and a plaque."@en ,
                    "Den särskilda högsta graden i de portugisiska förtjänstorden, som bara finns i några av dem och traditionellt är förbehållen statschefer; insignierna är en stor emaljerad guldkedja, ett skärp och en plakett."@sv ,
                    "Le grade spécial le plus élevé des ordres honorifiques portugais, qui n'existe que dans certains d'entre eux et est traditionnellement réservé aux chefs d'État ; ses insignes sont un grand collier d'or émaillé, une écharpe et une plaque."@fr ,
                    "Die besondere höchste Stufe der portugiesischen Verdienstorden, die es nur in einigen von ihnen gibt und die traditionell Staatsoberhäuptern vorbehalten ist; ihre Insignien sind eine große Kette aus emailliertem Gold, eine Schärpe und eine Platte."@de ,
                    "Il grado speciale più alto degli ordini onorifici portoghesi, presente solo in alcuni di essi e tradizionalmente riservato ai capi di Stato; le sue insegne sono un grande collare d'oro smaltato, una fascia e una placca."@it ,
                    "El grado especial más alto de las órdenes honoríficas portuguesas, que solo existe en algunas de ellas y tradicionalmente se reserva a los jefes de Estado; sus insignias son un gran collar de oro esmaltado, una banda y una placa."@es ,
                    "O grau especial máximo das Ordens Honoríficas Portuguesas, existente apenas em algumas delas e tradicionalmente reservado a chefes de Estado; as suas insígnias são um grande colar de ouro esmaltado, uma banda e uma placa."@pt ,
                    "A portugál érdemrendek különleges legmagasabb fokozata, amely csak néhányukban van meg, és hagyományosan államfőknek van fenntartva; jelvényei nagy zománcozott aranylánc, vállszalag és lap."@hu .

fraternalc:PraxeDegrees a skos:ConceptScheme , fraternal:DegreeSystem , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:MemberStages ;
    skos:prefLabel "Stages of the praxe"@en , "Stadier i praxen"@sv , "Étapes de la praxe"@fr , "Stufen der Praxe"@de , "Stadi della praxe"@it , "Etapas de la praxe"@es , "Fases da praxe"@pt , "A praxe szakaszai"@hu ;
    skos:definition "The three stages of the Portuguese academic praxe, the student tradition with its code: the caloiro (a student in the first enrolment), the doutor (a student of a later year) and the veterano (a student with more enrolments than the course needs). At Coimbra the doutores have several ranks by number of enrolments."@en ,
                    "De tre stadierna i den portugisiska akademiska praxen, studenttraditionen med sin kod: caloiro (en student på första inskrivningen), doutor (en student på ett senare år) och veterano (en student med fler inskrivningar än utbildningen kräver). I Coimbra har doutores flera led efter antalet inskrivningar."@sv ,
                    "Les trois étapes de la praxe académique portugaise, la tradition étudiante avec son code : le caloiro (étudiant en première inscription), le doutor (étudiant d'une année ultérieure) et le veterano (étudiant avec plus d'inscriptions que le cursus n'en exige). À Coimbra, les doutores ont plusieurs rangs selon le nombre d'inscriptions."@fr ,
                    "Die drei Stufen der portugiesischen akademischen Praxe, der studentischen Tradition mit ihrem Kodex: der Caloiro (ein Student im ersten Einschreibejahr), der Doutor (ein Student eines späteren Jahres) und der Veterano (ein Student mit mehr Einschreibungen, als das Studium verlangt). In Coimbra haben die Doutores mehrere Ränge nach der Zahl der Einschreibungen."@de ,
                    "I tre stadi della praxe accademica portoghese, la tradizione studentesca con il suo codice: il caloiro (uno studente alla prima iscrizione), il doutor (uno studente di un anno successivo) e il veterano (uno studente con più iscrizioni di quante ne richieda il corso). A Coimbra i doutores hanno più gradi secondo il numero di iscrizioni."@it ,
                    "Las tres etapas de la praxe académica portuguesa, la tradición estudiantil con su código: el caloiro (un estudiante en primera matrícula), el doutor (un estudiante de un curso posterior) y el veterano (un estudiante con más matrículas de las que exige la carrera). En Coímbra los doutores tienen varios rangos según el número de matrículas."@es ,
                    "As três fases da praxe académica portuguesa, a tradição estudantil com o seu código: o caloiro (estudante na primeira matrícula), o doutor (estudante de um ano mais avançado) e o veterano (estudante com mais inscrições do que as necessárias para acabar o curso). Em Coimbra os doutores têm vários graus hierárquicos, consoante o número de inscrições."@pt ,
                    "A portugál akadémiai praxe, a kódexszel rendelkező diákhagyomány három szakasza: a caloiro (elsőéves beiratkozású diák), a doutor (későbbi évfolyamos diák) és a veterano (a képzés befejezéséhez szükségesnél több beiratkozású diák). Coimbrában a doutoroknak a beiratkozások száma szerint több rangjuk van."@hu ;
    skos:hasTopConcept fraternalc:caloiro , fraternalc:doutor , fraternalc:veterano .

fraternalc:caloiro a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:PraxeDegrees ; skos:topConceptOf fraternalc:PraxeDegrees ;
    fraternal:degreeRank 1 ; fraternal:nextDegree fraternalc:doutor ; fraternal:degreeKind fraternalc:probationaryDegree ;
    skos:prefLabel "Caloiro"@en , "Caloiro"@sv , "Caloiro"@fr , "Caloiro"@de , "Caloiro"@it , "Caloiro"@es , "Caloiro"@pt , "Caloiro"@hu ;
    skos:altLabel "Freshman"@en , "Novato"@pt ;
    skos:definition "The first stage: the student in the first enrolment, subject to the praxe and the orders of the older students until the end of the academic year."@en ,
                    "Det första stadiet: studenten på första inskrivningen, som står under praxen och de äldre studenternas order till läsårets slut."@sv ,
                    "La première étape : l'étudiant en première inscription, soumis à la praxe et aux ordres des étudiants plus anciens jusqu'à la fin de l'année universitaire."@fr ,
                    "Die erste Stufe: der Student im ersten Einschreibejahr, der bis zum Ende des akademischen Jahres der Praxe und den Anordnungen der älteren Studenten unterliegt."@de ,
                    "Il primo stadio: lo studente alla prima iscrizione, soggetto alla praxe e agli ordini degli studenti più anziani fino alla fine dell'anno accademico."@it ,
                    "La primera etapa: el estudiante en primera matrícula, sometido a la praxe y a las órdenes de los estudiantes mayores hasta el final del curso."@es ,
                    "A primeira fase: o estudante na primeira matrícula, sujeito à praxe e às ordens dos estudantes mais antigos até ao fim do ano letivo."@pt ,
                    "Az első szakasz: az első beiratkozású diák, aki a tanév végéig a praxe és az idősebb diákok parancsainak van alávetve."@hu .

fraternalc:doutor a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:PraxeDegrees ; skos:topConceptOf fraternalc:PraxeDegrees ;
    fraternal:degreeRank 2 ; fraternal:nextDegree fraternalc:veterano ;
    skos:prefLabel "Doutor"@en , "Doutor"@sv , "Doutor"@fr , "Doutor"@de , "Doutor"@it , "Doutor"@es , "Doutor"@pt , "Doutor"@hu ;
    skos:definition "The second stage: any student beyond the first enrolment, who may take part in the praxe and exercise it over the caloiros. It has several ranks by number of enrolments at Coimbra."@en ,
                    "Det andra stadiet: varje student efter den första inskrivningen, som får delta i praxen och utöva den över caloiros. I Coimbra har den flera led efter antalet inskrivningar."@sv ,
                    "La deuxième étape : tout étudiant au-delà de la première inscription, qui peut participer à la praxe et l'exercer sur les caloiros. À Coimbra, elle a plusieurs rangs selon le nombre d'inscriptions."@fr ,
                    "Die zweite Stufe: jeder Student nach dem ersten Einschreibejahr, der an der Praxe teilnehmen und sie gegenüber den Caloiros ausüben darf. In Coimbra hat sie mehrere Ränge nach der Zahl der Einschreibungen."@de ,
                    "Il secondo stadio: ogni studente oltre la prima iscrizione, che può prendere parte alla praxe ed esercitarla sui caloiros. A Coimbra ha più gradi secondo il numero di iscrizioni."@it ,
                    "La segunda etapa: todo estudiante más allá de la primera matrícula, que puede participar en la praxe y ejercerla sobre los caloiros. En Coímbra tiene varios rangos según el número de matrículas."@es ,
                    "A segunda fase: qualquer estudante para além da primeira matrícula, que pode participar na praxe e exercê-la sobre os caloiros. Em Coimbra tem vários graus consoante o número de matrículas."@pt ,
                    "A második szakasz: bármely diák az első beiratkozáson túl, aki részt vehet a praxéban, és gyakorolhatja azt a caloirókon. Coimbrában a beiratkozások száma szerint több rangja van."@hu .

fraternalc:veterano a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:PraxeDegrees ; skos:topConceptOf fraternalc:PraxeDegrees ;
    fraternal:degreeRank 3 ;
    skos:prefLabel "Veterano"@en , "Veterano"@sv , "Veterano"@fr , "Veterano"@de , "Veterano"@it , "Veterano"@es , "Veterano"@pt , "Veterano"@hu ;
    skos:definition "The highest rank of the student: one with more enrolments than the course needs to finish. At Coimbra the veteranos form the Council of Veterans that elects the Dux Veteranorum."@en ,
                    "Studentens högsta led: en som har fler inskrivningar än utbildningen kräver för att avsluta den. I Coimbra bildar veteranos Veteranrådet, som väljer Dux Veteranorum."@sv ,
                    "Le rang le plus élevé de l'étudiant : celui qui a plus d'inscriptions que le cursus n'en exige pour le terminer. À Coimbra, les veteranos forment le Conseil des Vétérans, qui élit le Dux Veteranorum."@fr ,
                    "Der höchste Rang des Studenten: wer mehr Einschreibungen hat, als das Studium zum Abschluss verlangt. In Coimbra bilden die Veteranos den Rat der Veteranen, der den Dux Veteranorum wählt."@de ,
                    "Il rango più alto dello studente: chi ha più iscrizioni di quante ne richieda il corso per finire. A Coimbra i veteranos formano il Consiglio dei Veterani, che elegge il Dux Veteranorum."@it ,
                    "El rango más alto del estudiante: quien tiene más matrículas de las que exige la carrera para terminar. En Coímbra los veteranos forman el Consejo de Veteranos, que elige al Dux Veteranorum."@es ,
                    "O grau mais alto do estudante: aquele que tem mais inscrições do que as necessárias para acabar o curso. Em Coimbra os veteranos formam o Conselho de Veteranos, que elege o Dux Veteranorum."@pt ,
                    "A diák legmagasabb rangja: akinek több beiratkozása van, mint amennyi a képzés befejezéséhez kell. Coimbrában a veteránok alkotják a Veteránok Tanácsát, amely a Dux Veteranorumot választja."@hu .

fraternalc:PraxeOffices a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:OfficeTypes ;
    skos:prefLabel "Offices of the praxe"@en , "Ämbeten i praxen"@sv , "Fonctions de la praxe"@fr , "Ämter der Praxe"@de , "Cariche della praxe"@it , "Cargos de la praxe"@es , "Cargos da praxe"@pt , "A praxe tisztségei"@hu ;
    skos:definition "The head of the praxe at Coimbra, the Dux Veteranorum, placed under the generic president in mappings/fraternal-portugal.sssom.tsv."@en ,
                    "Praxens chef i Coimbra, Dux Veteranorum, placerad under den generiska ordföranden i mappings/fraternal-portugal.sssom.tsv."@sv ,
                    "Le chef de la praxe à Coimbra, le Dux Veteranorum, placé sous le président générique dans mappings/fraternal-portugal.sssom.tsv."@fr ,
                    "Das Oberhaupt der Praxe in Coimbra, der Dux Veteranorum, unter den allgemeinen Präsidenten gestellt in mappings/fraternal-portugal.sssom.tsv."@de ,
                    "Il capo della praxe a Coimbra, il Dux Veteranorum, collocato sotto il presidente generico in mappings/fraternal-portugal.sssom.tsv."@it ,
                    "El jefe de la praxe en Coímbra, el Dux Veteranorum, colocado bajo el presidente genérico en mappings/fraternal-portugal.sssom.tsv."@es ,
                    "O chefe da praxe em Coimbra, o Dux Veteranorum, colocado sob o presidente genérico em mappings/fraternal-portugal.sssom.tsv."@pt ,
                    "A praxe feje Coimbrában, a Dux Veteranorum, az általános elnök alá sorolva a mappings/fraternal-portugal.sssom.tsv fájlban."@hu ;
    skos:hasTopConcept fraternalc:duxVeteranorum .

fraternalc:duxVeteranorum a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:PraxeOffices ; skos:topConceptOf fraternalc:PraxeOffices ;
    skos:prefLabel "Dux Veteranorum"@en , "Dux Veteranorum"@sv , "Dux Veteranorum"@fr , "Dux Veteranorum"@de , "Dux Veteranorum"@it , "Dux Veteranorum"@es , "Dux Veteranorum"@pt , "Dux Veteranorum"@hu ;
    skos:definition "The head of the praxe at the University of Coimbra, in principle the student with the most enrolments, elected by the Magnum Concilium Veteranum (the Council of Veterans)."@en ,
                    "Praxens chef vid Coimbras universitet, i princip studenten med flest inskrivningar, vald av Magnum Concilium Veteranum (Veteranrådet)."@sv ,
                    "Le chef de la praxe à l'université de Coimbra, en principe l'étudiant ayant le plus d'inscriptions, élu par le Magnum Concilium Veteranum (le Conseil des Vétérans)."@fr ,
                    "Das Oberhaupt der Praxe an der Universität Coimbra, im Prinzip der Student mit den meisten Einschreibungen, gewählt vom Magnum Concilium Veteranum (dem Rat der Veteranen)."@de ,
                    "Il capo della praxe all'Università di Coimbra, in principio lo studente con più iscrizioni, eletto dal Magnum Concilium Veteranum (il Consiglio dei Veterani)."@it ,
                    "El jefe de la praxe en la Universidad de Coímbra, en principio el estudiante con más matrículas, elegido por el Magnum Concilium Veteranum (el Consejo de Veteranos)."@es ,
                    "O chefe da praxe na Universidade de Coimbra, em princípio o estudante com mais inscrições, eleito pelo Magnum Concilium Veteranum (o Magno Conselho de Veteranos)."@pt ,
                    "A praxe feje a Coimbrai Egyetemen, elvileg a legtöbb beiratkozással rendelkező diák, akit a Magnum Concilium Veteranum (a Veteránok Nagy Tanácsa) választ."@hu .

fraternalc:PraxeInsignia a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:InsigniaTypes ;
    skos:prefLabel "Insignia of the praxe"@en , "Insignier i praxen"@sv , "Insignes de la praxe"@fr , "Insignien der Praxe"@de , "Insegne della praxe"@it , "Insignias de la praxe"@es , "Insígnias da praxe"@pt , "A praxe jelvényei"@hu ;
    skos:definition "The academic dress worn in the praxe, placed under the generic robe in mappings/fraternal-portugal.sssom.tsv."@en ,
                    "Den akademiska dräkt som bärs i praxen, placerad under den generiska mantlen i mappings/fraternal-portugal.sssom.tsv."@sv ,
                    "L'habit académique porté dans la praxe, placé sous la robe générique dans mappings/fraternal-portugal.sssom.tsv."@fr ,
                    "Die in der Praxe getragene akademische Tracht, unter das allgemeine Gewand gestellt in mappings/fraternal-portugal.sssom.tsv."@de ,
                    "L'abito accademico portato nella praxe, collocato sotto la veste generica in mappings/fraternal-portugal.sssom.tsv."@it ,
                    "El traje académico que se lleva en la praxe, colocado bajo la vestidura genérica en mappings/fraternal-portugal.sssom.tsv."@es ,
                    "O traje académico usado na praxe, colocado sob a vestidura genérica em mappings/fraternal-portugal.sssom.tsv."@pt ,
                    "A praxéban viselt akadémiai öltözet, az általános köntös alá sorolva a mappings/fraternal-portugal.sssom.tsv fájlban."@hu ;
    skos:hasTopConcept fraternalc:trajeAcademico .

fraternalc:trajeAcademico a skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:PraxeInsignia ; skos:topConceptOf fraternalc:PraxeInsignia ;
    skos:prefLabel "Academic Dress"@en , "Akademisk dräkt"@sv , "Habit académique"@fr , "Akademische Tracht"@de , "Abito accademico"@it , "Traje académico"@es , "Traje académico"@pt , "Akadémiai öltözet"@hu ;
    skos:definition "The black suit and cape that students wear in the praxe and on academic occasions; its correct wear is part of the academic etiquette that the code of the praxe regulates."@en ,
                    "Den svarta dräkt och kappa som studenter bär i praxen och vid akademiska tillfällen; hur den bärs hör till den akademiska etikett som praxens kod reglerar."@sv ,
                    "Le costume noir et la cape que les étudiants portent dans la praxe et lors d'occasions académiques ; son port correct fait partie de l'étiquette académique que règle le code de la praxe."@fr ,
                    "Der schwarze Anzug und Umhang, den Studenten in der Praxe und bei akademischen Anlässen tragen; sein richtiges Tragen gehört zur akademischen Etikette, die der Kodex der Praxe regelt."@de ,
                    "L'abito nero e il mantello che gli studenti portano nella praxe e nelle occasioni accademiche; il modo corretto di portarlo fa parte dell'etichetta accademica che il codice della praxe regola."@it ,
                    "El traje negro y la capa que llevan los estudiantes en la praxe y en las ocasiones académicas; su porte correcto forma parte de la etiqueta académica que regula el código de la praxe."@es ,
                    "O traje negro e a capa que os estudantes usam na praxe e em ocasiões académicas; o seu porte adequado faz parte da etiqueta académica que o código da praxe regula."@pt ,
                    "A fekete öltöny és köpeny, amelyet a diákok a praxéban és akadémiai alkalmakkor viselnek; helyes viselése a praxe kódexe által szabályozott akadémiai etikett része."@hu .

fraternalc:MisericordiaOffices a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:OfficeTypes ;
    skos:prefLabel "Offices of a Misericórdia"@en , "Ämbeten i en Misericórdia"@sv , "Fonctions d'une Misericórdia"@fr , "Ämter einer Misericórdia"@de , "Cariche di una Misericórdia"@it , "Cargos de una Misericórdia"@es , "Cargos de uma Misericórdia"@pt , "Egy Misericórdia tisztségei"@hu ;
    skos:definition "The head of a Santa Casa da Misericórdia, the Provedor, placed under the generic president in mappings/fraternal-portugal.sssom.tsv. The other members of the Mesa Administrativa (Vice-Provedor, Secretário, Tesoureiro, Mesários) use the generic offices."@en ,
                    "Chefen för en Santa Casa da Misericórdia, Provedor, placerad under den generiska ordföranden i mappings/fraternal-portugal.sssom.tsv. Övriga ledamöter av Mesa Administrativa (Vice-Provedor, Secretário, Tesoureiro, Mesários) använder de generiska ämbetena."@sv ,
                    "Le chef d'une Santa Casa da Misericórdia, le Provedor, placé sous le président générique dans mappings/fraternal-portugal.sssom.tsv. Les autres membres de la Mesa Administrativa (Vice-Provedor, Secretário, Tesoureiro, Mesários) utilisent les fonctions génériques."@fr ,
                    "Das Oberhaupt einer Santa Casa da Misericórdia, der Provedor, unter den allgemeinen Präsidenten gestellt in mappings/fraternal-portugal.sssom.tsv. Die übrigen Mitglieder der Mesa Administrativa (Vice-Provedor, Secretário, Tesoureiro, Mesários) verwenden die allgemeinen Ämter."@de ,
                    "Il capo di una Santa Casa da Misericórdia, il Provedor, collocato sotto il presidente generico in mappings/fraternal-portugal.sssom.tsv. Gli altri membri della Mesa Administrativa (Vice-Provedor, Secretário, Tesoureiro, Mesários) usano le cariche generiche."@it ,
                    "El jefe de una Santa Casa da Misericórdia, el Provedor, colocado bajo el presidente genérico en mappings/fraternal-portugal.sssom.tsv. Los demás miembros de la Mesa Administrativa (Vice-Provedor, Secretário, Tesoureiro, Mesários) usan los cargos genéricos."@es ,
                    "O chefe de uma Santa Casa da Misericórdia, o Provedor, colocado sob o presidente genérico em mappings/fraternal-portugal.sssom.tsv. Os restantes membros da Mesa Administrativa (Vice-Provedor, Secretário, Tesoureiro, Mesários) usam os cargos genéricos."@pt ,
                    "A Santa Casa da Misericórdia vezetője, a Provedor, az általános elnök alá sorolva a mappings/fraternal-portugal.sssom.tsv fájlban. A Mesa Administrativa többi tagja (Vice-Provedor, Secretário, Tesoureiro, Mesários) az általános tisztségeket használja."@hu ;
    skos:hasTopConcept fraternalc:provedor .

fraternalc:provedor a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:MisericordiaOffices ; skos:topConceptOf fraternalc:MisericordiaOffices ;
    skos:prefLabel "Provedor"@en , "Provedor"@sv , "Provedor"@fr , "Provedor"@de , "Provedor"@it , "Provedor"@es , "Provedor"@pt , "Provedor"@hu ;
    skos:definition "The head of a Santa Casa da Misericórdia, a lay brotherhood of charity: he or she leads its Mesa Administrativa, the board that the Irmãos (the members) elect."@en ,
                    "Chefen för en Santa Casa da Misericórdia, ett lekmannabrödraskap för välgörenhet: leder dess Mesa Administrativa, den styrelse som Irmãos (medlemmarna) väljer."@sv ,
                    "Le chef d'une Santa Casa da Misericórdia, confrérie laïque de charité : il ou elle dirige sa Mesa Administrativa, le conseil que les Irmãos (les membres) élisent."@fr ,
                    "Das Oberhaupt einer Santa Casa da Misericórdia, einer Laienbruderschaft der Wohltätigkeit: leitet ihre Mesa Administrativa, den Vorstand, den die Irmãos (die Mitglieder) wählen."@de ,
                    "Il capo di una Santa Casa da Misericórdia, una confraternita laica di carità: guida la sua Mesa Administrativa, il consiglio che gli Irmãos (i soci) eleggono."@it ,
                    "El jefe de una Santa Casa da Misericórdia, una cofradía laica de caridad: dirige su Mesa Administrativa, la junta que eligen los Irmãos (los miembros)."@es ,
                    "O chefe de uma Santa Casa da Misericórdia, irmandade leiga de caridade: dirige a sua Mesa Administrativa, o órgão que os Irmãos elegem."@pt ,
                    "A Santa Casa da Misericórdia, a jótékonysági világi testvériség vezetője: a Mesa Administrativát, az Irmãos (a tagok) által választott testületet vezeti."@hu .

##############################################################################
# 13. HUNGARY  (the Order of Merit, the Emericana, the student title bajtárs)
# A first draft from general knowledge and Hungarian Wikipedia, for a Hungarian-speaking
# reviewer to check against the primary sources (the Act CCII of 2011 on the state
# decorations, the statutes of a federation). Each scheme is dcterms:isPartOf its hub scheme
# and every concept is mapped in mappings/fraternal-hungary.sssom.tsv.
##############################################################################

fraternalc:HungarianOrderGrades a skos:ConceptScheme , fraternal:DegreeSystem , owl:NamedIndividual ;
    dcterms:isPartOf fraternalc:ChivalricGrades ;
    skos:prefLabel "Grades of the Hungarian Order of Merit"@en , "Grader i Ungerns förtjänstorden"@sv , "Grades de l'Ordre du Mérite hongrois"@fr , "Stufen des Ungarischen Verdienstordens"@de , "Gradi dell'Ordine al Merito ungherese"@it , "Grados de la Orden del Mérito de Hungría"@es , "Graus da Ordem do Mérito da Hungria"@pt , "A Magyar Érdemrend fokozatai"@hu ;
    skos:definition "The six grades of the Hungarian Order of Merit, from the lowest to the highest: Knight's Cross, Officer's Cross, Commander's Cross, Commander's Cross with Star, Grand Cross, and Grand Cross with Collar and Golden Rayed Star, which is given only to heads of state. Placed one to one under the generic chivalric grades in mappings/fraternal-hungary.sssom.tsv."@en ,
                    "De sex graderna i Ungerns förtjänstorden, från lägsta till högsta: Riddarkors, Officerskors, Kommendörskors, Kommendörskors med stjärna, Storkors, och Storkors med kedja och gyllene strålstjärna, som bara ges åt statschefer. Placeras ett till ett under de generiska riddarordensgraderna i mappings/fraternal-hungary.sssom.tsv."@sv ,
                    "Les six grades de l'Ordre du Mérite hongrois, du plus bas au plus haut : croix de chevalier, croix d'officier, croix de commandeur, croix de commandeur avec étoile, grand-croix, et grand-croix avec collier et étoile rayonnante d'or, qui n'est donnée qu'aux chefs d'État. Placés un à un sous les grades génériques de style chevaleresque dans mappings/fraternal-hungary.sssom.tsv."@fr ,
                    "Die sechs Stufen des Ungarischen Verdienstordens, von der niedrigsten bis zur höchsten: Ritterkreuz, Offizierskreuz, Kommandeurskreuz, Kommandeurskreuz mit Stern, Großkreuz und Großkreuz mit Kette und goldenem Strahlenstern, das nur Staatsoberhäuptern verliehen wird. Eins zu eins unter die allgemeinen Ritterordensstufen gestellt in mappings/fraternal-hungary.sssom.tsv."@de ,
                    "I sei gradi dell'Ordine al Merito ungherese, dal più basso al più alto: croce di cavaliere, croce di ufficiale, croce di comandante, croce di comandante con stella, gran croce, e gran croce con collare e stella raggiata d'oro, che è conferita solo ai capi di Stato. Collocati uno a uno sotto i gradi cavallereschi generici in mappings/fraternal-hungary.sssom.tsv."@it ,
                    "Los seis grados de la Orden del Mérito de Hungría, del más bajo al más alto: Cruz de Caballero, Cruz de Oficial, Cruz de Comendador, Cruz de Comendador con Estrella, Gran Cruz, y Gran Cruz con Collar y Estrella radiante de oro, que solo se concede a jefes de Estado. Colocados uno a uno bajo los grados caballerescos genéricos en mappings/fraternal-hungary.sssom.tsv."@es ,
                    "Os seis graus da Ordem do Mérito da Hungria, do mais baixo ao mais alto: Cruz de Cavaleiro, Cruz de Oficial, Cruz de Comendador, Cruz de Comendador com Estrela, Grã-Cruz, e Grã-Cruz com Colar e Estrela radiante de ouro, que só é concedida a chefes de Estado. Colocados um a um sob os graus genéricos de estilo cavaleiresco em mappings/fraternal-hungary.sssom.tsv."@pt ,
                    "A Magyar Érdemrend hat fokozata a legalacsonyabbtól a legmagasabbig: lovagkereszt, tisztikereszt, parancsnoki kereszt, parancsnoki kereszt a csillaggal, nagykereszt, valamint a nagykereszt a nyaklánccal és az arany sugaras csillaggal, amelyet csak államfők kaphatnak. Egy-egy megfeleltetéssel az általános lovagrendi fokozatok alá sorolva a mappings/fraternal-hungary.sssom.tsv fájlban."@hu ;
    skos:hasTopConcept fraternalc:huLovagkereszt , fraternalc:huTisztikereszt , fraternalc:huParancsnokiKereszt ,
                       fraternalc:huParancsnokiKeresztCsillaggal , fraternalc:huNagykereszt , fraternalc:huNagykeresztNyaklanccal .

fraternalc:huLovagkereszt a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:HungarianOrderGrades ; skos:topConceptOf fraternalc:HungarianOrderGrades ;
    fraternal:degreeRank 1 ; fraternal:nextDegree fraternalc:huTisztikereszt ;
    skos:prefLabel "Knight's Cross"@en , "Riddarkors"@sv , "Croix de chevalier"@fr , "Ritterkreuz"@de , "Croce di cavaliere"@it , "Cruz de Caballero"@es , "Cruz de Cavaleiro"@pt , "Lovagkereszt"@hu ;
    skos:definition "The lowest grade of the Hungarian Order of Merit; the number of Hungarian citizens who may receive it is limited each year."@en ,
                    "Den lägsta graden i Ungerns förtjänstorden; antalet ungerska medborgare som får den är begränsat varje år."@sv ,
                    "Le grade le plus bas de l'Ordre du Mérite hongrois ; le nombre de citoyens hongrois qui peuvent le recevoir est limité chaque année."@fr ,
                    "Die niedrigste Stufe des Ungarischen Verdienstordens; die Zahl der ungarischen Staatsbürger, die sie erhalten dürfen, ist jedes Jahr begrenzt."@de ,
                    "Il grado più basso dell'Ordine al Merito ungherese; il numero di cittadini ungheresi che possono riceverlo è limitato ogni anno."@it ,
                    "El grado más bajo de la Orden del Mérito de Hungría; el número de ciudadanos húngaros que pueden recibirlo está limitado cada año."@es ,
                    "O grau mais baixo da Ordem do Mérito da Hungria; o número de cidadãos húngaros que o podem receber é limitado em cada ano."@pt ,
                    "A Magyar Érdemrend legalacsonyabb fokozata; az évente kitüntethető magyar állampolgárok száma korlátozott."@hu .

fraternalc:huTisztikereszt a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:HungarianOrderGrades ; skos:topConceptOf fraternalc:HungarianOrderGrades ;
    fraternal:degreeRank 2 ; fraternal:nextDegree fraternalc:huParancsnokiKereszt ;
    skos:prefLabel "Officer's Cross"@en , "Officerskors"@sv , "Croix d'officier"@fr , "Offizierskreuz"@de , "Croce di ufficiale"@it , "Cruz de Oficial"@es , "Cruz de Oficial"@pt , "Tisztikereszt"@hu ;
    skos:definition "The second grade of the Hungarian Order of Merit, above the Knight's Cross."@en ,
                    "Den andra graden i Ungerns förtjänstorden, över Riddarkors."@sv ,
                    "Le deuxième grade de l'Ordre du Mérite hongrois, au-dessus de la croix de chevalier."@fr ,
                    "Die zweite Stufe des Ungarischen Verdienstordens, über dem Ritterkreuz."@de ,
                    "Il secondo grado dell'Ordine al Merito ungherese, sopra la croce di cavaliere."@it ,
                    "El segundo grado de la Orden del Mérito de Hungría, por encima de la Cruz de Caballero."@es ,
                    "O segundo grau da Ordem do Mérito da Hungria, acima da Cruz de Cavaleiro."@pt ,
                    "A Magyar Érdemrend második fokozata, a lovagkereszt felett."@hu .

fraternalc:huParancsnokiKereszt a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:HungarianOrderGrades ; skos:topConceptOf fraternalc:HungarianOrderGrades ;
    fraternal:degreeRank 3 ; fraternal:nextDegree fraternalc:huParancsnokiKeresztCsillaggal ;
    skos:prefLabel "Commander's Cross"@en , "Kommendörskors"@sv , "Croix de commandeur"@fr , "Kommandeurskreuz"@de , "Croce di comandante"@it , "Cruz de Comendador"@es , "Cruz de Comendador"@pt , "Parancsnoki kereszt"@hu ;
    skos:definition "The third grade of the Hungarian Order of Merit, above the Officer's Cross."@en ,
                    "Den tredje graden i Ungerns förtjänstorden, över Officerskors."@sv ,
                    "Le troisième grade de l'Ordre du Mérite hongrois, au-dessus de la croix d'officier."@fr ,
                    "Die dritte Stufe des Ungarischen Verdienstordens, über dem Offizierskreuz."@de ,
                    "Il terzo grado dell'Ordine al Merito ungherese, sopra la croce di ufficiale."@it ,
                    "El tercer grado de la Orden del Mérito de Hungría, por encima de la Cruz de Oficial."@es ,
                    "O terceiro grau da Ordem do Mérito da Hungria, acima da Cruz de Oficial."@pt ,
                    "A Magyar Érdemrend harmadik fokozata, a tisztikereszt felett."@hu .

fraternalc:huParancsnokiKeresztCsillaggal a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:HungarianOrderGrades ; skos:topConceptOf fraternalc:HungarianOrderGrades ;
    fraternal:degreeRank 4 ; fraternal:nextDegree fraternalc:huNagykereszt ;
    skos:prefLabel "Commander's Cross with Star"@en , "Kommendörskors med stjärna"@sv , "Croix de commandeur avec étoile"@fr , "Kommandeurskreuz mit Stern"@de , "Croce di comandante con stella"@it , "Cruz de Comendador con Estrella"@es , "Cruz de Comendador com Estrela"@pt , "Parancsnoki kereszt a csillaggal"@hu ;
    skos:definition "The fourth grade of the Hungarian Order of Merit, above the Commander's Cross."@en ,
                    "Den fjärde graden i Ungerns förtjänstorden, över Kommendörskors."@sv ,
                    "Le quatrième grade de l'Ordre du Mérite hongrois, au-dessus de la croix de commandeur."@fr ,
                    "Die vierte Stufe des Ungarischen Verdienstordens, über dem Kommandeurskreuz."@de ,
                    "Il quarto grado dell'Ordine al Merito ungherese, sopra la croce di comandante."@it ,
                    "El cuarto grado de la Orden del Mérito de Hungría, por encima de la Cruz de Comendador."@es ,
                    "O quarto grau da Ordem do Mérito da Hungria, acima da Cruz de Comendador."@pt ,
                    "A Magyar Érdemrend negyedik fokozata, a parancsnoki kereszt felett."@hu .

fraternalc:huNagykereszt a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:HungarianOrderGrades ; skos:topConceptOf fraternalc:HungarianOrderGrades ;
    fraternal:degreeRank 5 ; fraternal:nextDegree fraternalc:huNagykeresztNyaklanccal ;
    skos:prefLabel "Grand Cross"@en , "Storkors"@sv , "Grand-croix"@fr , "Großkreuz"@de , "Gran croce"@it , "Gran Cruz"@es , "Grã-Cruz"@pt , "Nagykereszt"@hu ;
    skos:definition "The fifth grade of the Hungarian Order of Merit, the highest that Hungarian citizens can receive."@en ,
                    "Den femte graden i Ungerns förtjänstorden, den högsta som ungerska medborgare kan få."@sv ,
                    "Le cinquième grade de l'Ordre du Mérite hongrois, le plus élevé que les citoyens hongrois puissent recevoir."@fr ,
                    "Die fünfte Stufe des Ungarischen Verdienstordens, die höchste, die ungarische Staatsbürger erhalten können."@de ,
                    "Il quinto grado dell'Ordine al Merito ungherese, il più alto che i cittadini ungheresi possano ricevere."@it ,
                    "El quinto grado de la Orden del Mérito de Hungría, el más alto que pueden recibir los ciudadanos húngaros."@es ,
                    "O quinto grau da Ordem do Mérito da Hungria, o mais alto que os cidadãos húngaros podem receber."@pt ,
                    "A Magyar Érdemrend ötödik fokozata, a legmagasabb, amelyet magyar állampolgárok kaphatnak."@hu .

fraternalc:huNagykeresztNyaklanccal a fraternal:Degree , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:HungarianOrderGrades ; skos:topConceptOf fraternalc:HungarianOrderGrades ;
    fraternal:degreeRank 6 ;
    skos:prefLabel "Grand Cross with Collar and Golden Rayed Star"@en , "Storkors med kedja och gyllene strålstjärna"@sv , "Grand-croix avec collier et étoile rayonnante d'or"@fr , "Großkreuz mit Kette und goldenem Strahlenstern"@de , "Gran croce con collare e stella raggiata d'oro"@it , "Gran Cruz con Collar y Estrella radiante de oro"@es , "Grã-Cruz com Colar e Estrela radiante de ouro"@pt , "Nagykereszt a nyaklánccal és az arany sugaras csillaggal"@hu ;
    skos:definition "The highest grade of the Hungarian Order of Merit, given only to heads of state; the President of Hungary holds it by virtue of the office."@en ,
                    "Den högsta graden i Ungerns förtjänstorden, som bara ges åt statschefer; Ungerns president innehar den genom sitt ämbete."@sv ,
                    "Le grade le plus élevé de l'Ordre du Mérite hongrois, qui n'est donné qu'aux chefs d'État ; le président de la Hongrie le détient de par sa fonction."@fr ,
                    "Die höchste Stufe des Ungarischen Verdienstordens, die nur Staatsoberhäuptern verliehen wird; der Präsident Ungarns hat sie kraft seines Amtes."@de ,
                    "Il grado più alto dell'Ordine al Merito ungherese, conferito solo ai capi di Stato; il Presidente dell'Ungheria lo detiene per la sua carica."@it ,
                    "El grado más alto de la Orden del Mérito de Hungría, que solo se concede a jefes de Estado; el Presidente de Hungría lo posee por razón del cargo."@es ,
                    "O grau mais alto da Ordem do Mérito da Hungria, concedido apenas a chefes de Estado; o Presidente da Hungria detém-no por inerência do cargo."@pt ,
                    "A Magyar Érdemrend legmagasabb fokozata, amelyet csak államfők kaphatnak; Magyarország köztársasági elnöke hivatalánál fogva viseli."@hu .

fraternalc:EmericanaOffices a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:OfficeTypes ;
    skos:prefLabel "Offices of the Foederatio Emericana"@en , "Ämbeten i Foederatio Emericana"@sv , "Fonctions de la Foederatio Emericana"@fr , "Ämter der Foederatio Emericana"@de , "Cariche della Foederatio Emericana"@it , "Cargos de la Foederatio Emericana"@es , "Cargos da Foederatio Emericana"@pt , "A Foederatio Emericana tisztségei"@hu ;
    skos:definition "The offices of the Vezérség, the leadership of the Hungarian Catholic student federation Foederatio Emericana (1921–1946): the Kommendátor (the head), the Praeceptor (his deputy), the Anonymus (the national secretary-general) and the Magister Magnus (the chief priest). Each is placed under a generic office in mappings/fraternal-hungary.sssom.tsv."@en ,
                    "Ämbetena i Vezérség, ledningen för den ungerska katolska studentfederationen Foederatio Emericana (1921–1946): Kommendátor (chefen), Praeceptor (hans ställföreträdare), Anonymus (riksgeneralsekreteraren) och Magister Magnus (överprästen). Vart och ett placeras under ett generiskt ämbete i mappings/fraternal-hungary.sssom.tsv."@sv ,
                    "Les fonctions de la Vezérség, la direction de la fédération étudiante catholique hongroise Foederatio Emericana (1921–1946) : le Kommendátor (le chef), le Praeceptor (son adjoint), l'Anonymus (le secrétaire général national) et le Magister Magnus (le grand prêtre). Chacune est placée sous une fonction générique dans mappings/fraternal-hungary.sssom.tsv."@fr ,
                    "Die Ämter der Vezérség, der Leitung des ungarischen katholischen Studentenverbands Foederatio Emericana (1921–1946): der Kommendátor (das Oberhaupt), der Praeceptor (sein Stellvertreter), der Anonymus (der Landesgeneralsekretär) und der Magister Magnus (der oberste Priester). Jedes wird unter ein allgemeines Amt gestellt in mappings/fraternal-hungary.sssom.tsv."@de ,
                    "Le cariche della Vezérség, la direzione della federazione studentesca cattolica ungherese Foederatio Emericana (1921–1946): il Kommendátor (il capo), il Praeceptor (il suo vice), l'Anonymus (il segretario generale nazionale) e il Magister Magnus (il sommo sacerdote). Ognuna è collocata sotto una carica generica in mappings/fraternal-hungary.sssom.tsv."@it ,
                    "Los cargos de la Vezérség, la dirección de la federación estudiantil católica húngara Foederatio Emericana (1921–1946): el Kommendátor (el jefe), el Praeceptor (su adjunto), el Anonymus (el secretario general nacional) y el Magister Magnus (el sumo sacerdote). Cada uno se coloca bajo un cargo genérico en mappings/fraternal-hungary.sssom.tsv."@es ,
                    "Os cargos da Vezérség, a direção da federação estudantil católica húngara Foederatio Emericana (1921–1946): o Kommendátor (o chefe), o Praeceptor (o seu adjunto), o Anonymus (o secretário-geral nacional) e o Magister Magnus (o sumo sacerdote). Cada um é colocado sob um cargo genérico em mappings/fraternal-hungary.sssom.tsv."@pt ,
                    "A Vezérség, a Foederatio Emericana magyar katolikus diákszövetség (1921–1946) vezetésének tisztségei: a Kommendátor (a vezető), a Praeceptor (a helyettese), az Anonymus (az országos főtitkár) és a Magister Magnus (a főpap). Mindegyik általános tisztség alá van sorolva a mappings/fraternal-hungary.sssom.tsv fájlban."@hu ;
    skos:hasTopConcept fraternalc:kommendator , fraternalc:praeceptor , fraternalc:anonymus , fraternalc:magisterMagnus .

fraternalc:kommendator a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme fraternalc:EmericanaOffices ; skos:topConceptOf fraternalc:EmericanaOffices ;
    skos:prefLabel "Kommendátor"@en , "Kommendátor"@sv , "Kommendátor"@fr , "Kommendátor"@de , "Kommendátor"@it , "Kommendátor"@es , "Kommendátor"@pt , "Kommendátor"@hu ;
    skos:definition "The head of the Foederatio Emericana, who led its Vezérség."@en ,
                    "Chefen för Foederatio Emericana, som ledde dess Vezérség."@sv ,
                    "Le chef de la Foederatio Emericana, qui dirigeait sa Vezérség."@fr ,
                    "Das Oberhaupt der Foederatio Emericana, das ihre Vezérség leitete."@de ,
                    "Il capo della Foederatio Emericana, che guidava la sua Vezérség."@it ,
                    "El jefe de la Foederatio Emericana, que dirigía su Vezérség."@es ,
                    "O chefe da Foederatio Emericana, que dirigia a sua Vezérség."@pt ,
                    "A Foederatio Emericana vezetője, aki a Vezérséget irányította."@hu .

