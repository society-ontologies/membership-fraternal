##############################################################################
# membership codelists  —  v1.1.0
#
# SKOS codelists for the Membership Organisations Ontology. They are the
# generic *hubs*: each organisation's own codelist maps to these (skos:*Match,
# kept in mappings/*.sssom.tsv), never directly to other organisations' lists.
# External mappings (Wikidata, Getty AAT) also live in mappings/, not here.
##############################################################################

@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix mbr:    <https://w3id.org/membership#> .
@prefix mbrc:   <https://w3id.org/membership/code/> .

<https://w3id.org/membership/code>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/membership/code/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    owl:priorVersion <https://w3id.org/membership/code/1.0.0> ;
    owl:backwardCompatibleWith <https://w3id.org/membership/code/1.0.0> ;
    owl:imports <https://w3id.org/membership> ;
    dcterms:title "Membership Organisations — codelists"@en ,
                  "Medlemsorganisationer — kodlistor"@sv ,
                  "Mitgliederorganisationen – Codelisten"@de ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-10-09"^^xsd:date ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    vann:preferredNamespacePrefix "mbrc" ;
    vann:preferredNamespaceUri "https://w3id.org/membership/code/" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator <https://orcid.org/0009-0002-6239-5346> ;
    dcterms:rightsHolder <https://orcid.org/0009-0002-6239-5346> ;
    dcterms:publisher <https://github.com/society-ontologies> .

<https://orcid.org/0009-0002-6239-5346> <http://xmlns.com/foaf/0.1/name> "Oscar Almgren" .

<https://github.com/society-ontologies> a <http://xmlns.com/foaf/0.1/Organization> ;
    <http://xmlns.com/foaf/0.1/name> "Society Ontologies" .

##############################################################################
# 1. ORGANISATION TYPES
##############################################################################

mbrc:OrganizationTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Organisation Types"@en , "Organisationstyper"@sv , "Organisationsarten"@de ;
    skos:definition "Kinds of membership organisation, used with org:classification. The fraternal codelists extend the fraternal branch."@en ,
                    "Typer av medlemsorganisationer, används med org:classification. Kodlistorna i fraternal utökar grenen för ordenssällskap."@sv ,
                    "Arten von Mitgliederorganisationen, verwendet mit org:classification. Die Codelisten von fraternal erweitern den Zweig der Ordensgesellschaften."@de ;
    skos:hasTopConcept mbrc:voluntaryAssociation .

mbrc:voluntaryAssociation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:topConceptOf mbrc:OrganizationTypes ;
    skos:prefLabel "Voluntary Association"@en , "Frivillig sammanslutning"@sv , "Freiwillige Vereinigung"@de ;
    skos:altLabel "ideell förening"@sv ;
    skos:definition "A group of people who join together voluntarily for a shared purpose."@en ,
                    "En grupp människor som frivilligt går samman för ett gemensamt syfte."@sv ,
                    "Eine Gruppe von Menschen, die sich freiwillig für einen gemeinsamen Zweck zusammenschließen."@de ;
    skos:narrower mbrc:club , mbrc:society , mbrc:informalCircle , mbrc:fraternalOrganization ,
                  mbrc:politicalParty , mbrc:tradeUnion .

mbrc:informalCircle a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:voluntaryAssociation ;
    skos:prefLabel "Informal Circle"@en , "Kotteri"@sv ;
    skos:altLabel "Coterie"@en , "Circle of Friends"@en , "Vänkrets"@sv , "Umgängeskrets"@sv ,
                  "Coterie"@fr , "Cercle d'amis"@fr , "Freundeskreis"@de ;
    skos:definition "A relatively closed company of friends or associates without legal status or registration, held together by friendship or invitation rather than formal admission. It may be a temporary group that keeps together at a larger gathering, or a more lasting circle of friends, often formed to arrange or take part in an occasion such as a ball, a banquet or a student celebration."@en ,
                    "Ett relativt slutet sällskap av vänner eller bekanta utan rättslig status eller registrering, som hålls samman av vänskap eller inbjudan snarare än av formellt upptagande. Det kan vara en tillfällig grupp som håller ihop vid ett större samkväm, eller en mer varaktig vänkrets, ofta bildad för att ordna eller delta i en tillställning som en bal, en bankett eller ett studentfirande."@sv ;
    skos:scopeNote "The Swedish word kotteri, from French coterie, is often used in a derogatory sense of a clique that favours its own. That is a judgement, not a kind of organisation, and is not what this code records. The organiser of a gathering is given with mbr:organizer; compare mbrc:diningClub, a club that meets regularly for dinner."@en ,
                   "Ordet kotteri, av franskans coterie, används ofta i nedsättande mening om en klick som gynnar sina egna. Det är en bedömning och inte en slags organisation, och är inte vad den här koden anger. Den som ordnar en tillställning anges med mbr:organizer; jämför mbrc:diningClub, en klubb som regelbundet träffas för middag."@sv .

mbrc:club a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:voluntaryAssociation ;
    skos:prefLabel "Club"@en , "Klubb"@sv , "Club"@de ;
    skos:definition "An association of people for social or recreational purposes or for a shared interest."@en ,
                    "En sammanslutning för sällskapsliv, rekreation eller ett gemensamt intresse."@sv ,
                    "Ein Zusammenschluss von Menschen zu geselligen oder erholsamen Zwecken oder für ein gemeinsames Interesse."@de ;
    skos:narrower mbrc:privateClub , mbrc:diningClub , mbrc:countryClub , mbrc:armedForcesClub ,
                  mbrc:facultyClub , mbrc:sportsClub , mbrc:literaryClub , mbrc:serviceClub ,
                  mbrc:hobbyClub , mbrc:supportersClub .

mbrc:privateClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Private Club"@en , "Privat klubb"@sv , "Privatclub"@de ;
    skos:definition "A club with exclusive membership, usually admitting members by proposal and election."@en ,
                    "En klubb med slutet medlemskap, där medlemmar vanligen upptas efter förslag och val."@sv ,
                    "Ein Club mit exklusiver Mitgliedschaft, der Mitglieder in der Regel auf Vorschlag und durch Wahl aufnimmt."@de ;
    skos:narrower mbrc:gentlemensClub , mbrc:ladiesClub , mbrc:politicalClub , mbrc:universityClub ,
                  mbrc:professionalClub , mbrc:artsClub .

mbrc:gentlemensClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:privateClub ;
    skos:prefLabel "Gentlemen's Club"@en , "Herrklubb"@sv , "Herrenclub"@de ;
    skos:definition "A private social club traditionally for men, usually with its own clubhouse."@en ,
                    "En privat sällskapsklubb traditionellt för män, vanligen med eget klubbhus."@sv ,
                    "Ein privater geselliger Club, traditionell für Männer, meist mit eigenem Clubhaus."@de .

mbrc:ladiesClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:privateClub ;
    skos:prefLabel "Ladies' Club"@en , "Damklubb"@sv , "Damenclub"@de ;
    skos:altLabel "Women's Club"@en ;
    skos:definition "A private social club for women."@en ,
                    "En privat sällskapsklubb för kvinnor."@sv ,
                    "Ein privater geselliger Club für Frauen."@de .

mbrc:politicalClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:privateClub ;
    skos:prefLabel "Political Club"@en , "Politisk klubb"@sv , "Politischer Club"@de ;
    skos:definition "A private club whose members share an allegiance to a political party or tradition."@en ,
                    "En privat klubb vars medlemmar delar tillhörighet till ett politiskt parti eller en politisk tradition."@sv ,
                    "Ein privater Club, dessen Mitglieder einer politischen Partei oder Richtung verbunden sind."@de ;
    skos:scopeNote "Not a political party: use mbrc:politicalParty for the party itself."@en ,
                   "Inte ett politiskt parti: använd mbrc:politicalParty för själva partiet."@sv ,
                   "Keine politische Partei: Für die Partei selbst mbrc:politicalParty verwenden."@de .

mbrc:universityClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:privateClub ;
    skos:prefLabel "University Club"@en , "Alumniklubb"@sv , "Universitätsclub"@de ;
    skos:definition "A private club for graduates of one or more particular universities."@en ,
                    "En privat klubb för dem som tagit examen vid ett eller flera bestämda universitet."@sv ,
                    "Ein privater Club für Absolventen einer oder mehrerer bestimmter Universitäten."@de .

mbrc:professionalClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:privateClub ;
    skos:prefLabel "Professional Club"@en , "Yrkesklubb"@sv , "Berufsclub"@de ;
    skos:definition "A private club whose members share a profession, such as law, medicine or the press."@en ,
                    "En privat klubb vars medlemmar delar ett yrke, t.ex. juridik, medicin eller press."@sv ,
                    "Ein privater Club, dessen Mitglieder einen Beruf teilen, etwa Recht, Medizin oder Presse."@de .

mbrc:artsClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:privateClub ;
    skos:prefLabel "Arts Club"@en , "Konstnärsklubb"@sv , "Künstlerclub"@de ;
    skos:definition "A private club for people in the arts: artists, writers, actors, musicians and their patrons."@en ,
                    "En privat klubb för kulturutövare: konstnärer, författare, skådespelare, musiker och deras mecenater."@sv ,
                    "Ein privater Club für Menschen in den Künsten: Künstler, Schriftsteller, Schauspieler, Musiker und ihre Förderer."@de .

mbrc:diningClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Dining Club"@en , "Middagsklubb"@sv , "Dinnerclub"@de ;
    skos:altLabel "middagssällskap"@sv ;
    skos:definition "A club that meets regularly for dinner and conversation."@en ,
                    "En klubb som regelbundet samlas till middag och samtal."@sv ,
                    "Ein Club, der sich regelmäßig zu Essen und Gespräch trifft."@de .

mbrc:countryClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Country Club"@en , "Countryclub"@sv , "Country-Club"@de ;
    skos:definition "A club with sporting and social facilities, typically outside a city."@en ,
                    "En klubb med idrotts- och sällskapsanläggningar, oftast utanför staden."@sv ,
                    "Ein Club mit sportlichen und geselligen Einrichtungen, in der Regel außerhalb einer Stadt."@de .

mbrc:armedForcesClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Armed Forces Club"@en , "Försvarsklubb"@sv , "Club der Streitkräfte"@de ;
    skos:altLabel "Service Club (military)"@en ;
    skos:definition "A club for serving and former members of the armed forces."@en ,
                    "En klubb för tjänstgörande och tidigare medlemmar av försvarsmakten."@sv ,
                    "Ein Club für aktive und ehemalige Angehörige der Streitkräfte."@de ;
    skos:narrower mbrc:officersClub .

mbrc:officersClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:armedForcesClub ;
    skos:prefLabel "Officers' Club"@en , "Officersklubb"@sv , "Offiziersclub"@de ;
    skos:definition "A club for commissioned military officers."@en ,
                    "En klubb för officerare."@sv ,
                    "Ein Club für Offiziere."@de .

mbrc:facultyClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Faculty Club"@en , "Universitetslärarklubb"@sv , "Dozentenclub"@de ;
    skos:definition "A club for the teaching staff of a university."@en ,
                    "En klubb för ett universitets lärare och forskare."@sv ,
                    "Ein Club für das Lehrpersonal einer Universität."@de .

mbrc:sportsClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Sports Club"@en , "Idrottsklubb"@sv , "Sportverein"@de ;
    skos:definition "A club organised around a sport."@en ,
                    "En klubb organiserad kring en idrott."@sv ,
                    "Ein um eine Sportart organisierter Club."@de ;
    skos:narrower mbrc:yachtClub .

mbrc:yachtClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:sportsClub ;
    skos:prefLabel "Yacht Club"@en , "Segelsällskap"@sv , "Yachtclub"@de ;
    skos:altLabel "Kungliga segelsällskap"@sv ;
    skos:definition "A club for sailing and yachting, often with a social clubhouse."@en ,
                    "En klubb för segling och båtliv, ofta med ett sällskapligt klubbhus."@sv ,
                    "Ein Club für Segeln und Yachtsport, oft mit einem geselligen Clubhaus."@de .

mbrc:serviceClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Service Club"@en , "Serviceklubb"@sv , "Service-Club"@de ;
    skos:definition "A club whose members meet socially and do voluntary or charitable work, such as Rotary or Lions clubs."@en ,
                    "En klubb vars medlemmar träffas socialt och gör ideella insatser, t.ex. Rotary- eller Lionsklubbar."@sv ,
                    "Ein Club, dessen Mitglieder sich gesellig treffen und ehrenamtliche oder wohltätige Arbeit leisten, etwa Rotary- oder Lions-Clubs."@de .

mbrc:literaryClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Literary Club"@en , "Litterär klubb"@sv , "Literaturclub"@de ;
    skos:definition "A club devoted to literature, reading or writing."@en ,
                    "En klubb ägnad åt litteratur, läsning eller skrivande."@sv ,
                    "Ein Club, der der Literatur, dem Lesen oder dem Schreiben gewidmet ist."@de .

mbrc:hobbyClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Hobby Club"@en , "Hobbyklubb"@sv , "Hobbyclub"@de ;
    skos:altLabel "Hobbyförening"@sv ;
    skos:definition "A club whose members pursue a hobby or craft together, such as a sewing circle, a photography club or a model railway club."@en ,
                    "En klubb vars medlemmar utövar en hobby eller ett hantverk tillsammans, t.ex. en syförening, en fotoklubb eller en modelljärnvägsklubb."@sv ,
                    "Ein Club, dessen Mitglieder gemeinsam einem Hobby oder Handwerk nachgehen, etwa ein Nähkreis, ein Fotoclub oder ein Modelleisenbahnclub."@de .

mbrc:supportersClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Supporters' Club"@en , "Supporterklubb"@sv , "Fanclub"@de ;
    skos:altLabel "Supporters' Association"@en , "Supporterförening"@sv ;
    skos:definition "A club for supporters of a sports team, most often a football club. It may be independent of the team or affiliated with it."@en ,
                    "En klubb för supportrar till ett idrottslag, oftast en fotbollsklubb. Den kan vara fristående från laget eller knuten till det."@sv ,
                    "Ein Club für Anhänger einer Sportmannschaft, meist eines Fußballvereins. Er kann von der Mannschaft unabhängig oder mit ihr verbunden sein."@de .

mbrc:society a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:voluntaryAssociation ;
    skos:prefLabel "Society"@en , "Sällskap"@sv , "Gesellschaft"@de ;
    skos:definition "An association of people united by a common interest, purpose or profession."@en ,
                    "En sammanslutning av personer förenade av ett gemensamt intresse, syfte eller yrke."@sv ,
                    "Ein Zusammenschluss von Menschen, die ein gemeinsames Interesse, ein gemeinsamer Zweck oder ein gemeinsamer Beruf verbindet."@de ;
    skos:narrower mbrc:learnedSociety , mbrc:charitableSociety , mbrc:studentNation , mbrc:studentSociety .

mbrc:learnedSociety a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Learned Society"@en , "Lärt sällskap"@sv , "Gelehrte Gesellschaft"@de ;
    skos:definition "A society that promotes an academic discipline or the arts."@en ,
                    "Ett sällskap som främjar en vetenskap eller konstart."@sv ,
                    "Eine Gesellschaft, die eine wissenschaftliche Disziplin oder die Künste fördert."@de .

mbrc:charitableSociety a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Charitable Society"@en , "Välgörenhetssällskap"@sv , "Wohltätigkeitsgesellschaft"@de ;
    skos:definition "A society whose main purpose is charity."@en ,
                    "Ett sällskap vars huvudsyfte är välgörenhet."@sv ,
                    "Eine Gesellschaft, deren Hauptzweck die Wohltätigkeit ist."@de .

mbrc:studentNation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Student Nation"@en , "Studentnation"@sv , "Studentennation"@de ;
    skos:definition "A student organisation at a university, traditionally based on the students' home region, as at Uppsala and Lund."@en ,
                    "En studentorganisation vid ett universitet, traditionellt grundad på studenternas hembygd, som i Uppsala och Lund."@sv ,
                    "Eine studentische Organisation an einer Universität, traditionell nach der Herkunftsregion der Studierenden gebildet, wie in Uppsala und Lund."@de .

mbrc:studentSociety a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Student Society"@en , "Studentförening"@sv , "Studentische Vereinigung"@de ;
    skos:definition "A society whose members are students or former students."@en ,
                    "En förening vars medlemmar är studenter eller före detta studenter."@sv ,
                    "Eine Gesellschaft, deren Mitglieder Studierende oder ehemalige Studierende sind."@de .

mbrc:fraternalOrganization a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:voluntaryAssociation ;
    skos:prefLabel "Fraternal Organisation"@en , "Ordenssällskap"@sv , "Ordensgesellschaft"@de ;
    skos:altLabel "Fraternal Order"@en , "brödraskap"@sv ;
    skos:definition "An organisation whose members are bound together by initiation, ritual and usually graded degrees. Refined by the fraternal codelists."@en ,
                    "En organisation vars medlemmar är förenade genom initiering, ritual och vanligen graderade grader. Förfinas av kodlistorna i fraternal."@sv ,
                    "Eine Organisation, deren Mitglieder durch Initiation, Ritual und meist gestufte Grade verbunden sind. Wird von den Codelisten von fraternal verfeinert."@de .

mbrc:politicalParty a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:voluntaryAssociation ;
    skos:prefLabel "Political Party"@en , "Politiskt parti"@sv , "Politische Partei"@de ;
    skos:definition "An organisation that seeks to influence public policy, usually by nominating candidates in public elections, and that people join as members."@en ,
                    "En organisation som söker påverka den offentliga politiken, vanligen genom att ställa upp kandidater i allmänna val, och som man blir medlem i."@sv ,
                    "Eine Organisation, die Einfluss auf die Politik zu nehmen sucht, meist indem sie Kandidaten für öffentliche Wahlen aufstellt, und der man als Mitglied beitritt."@de ;
    skos:scopeNote "Not the same as mbrc:politicalClub, a private club whose members share a party allegiance. Data about who belongs to a party reveals political opinions: see the scope note on mbr:Membership."@en ,
                   "Inte detsamma som mbrc:politicalClub, en privat klubb vars medlemmar delar partitillhörighet. Uppgifter om vem som tillhör ett parti röjer politiska åsikter: se anmärkningen till mbr:Membership."@sv ,
                   "Nicht dasselbe wie mbrc:politicalClub, ein privater Club, dessen Mitglieder einer Partei verbunden sind. Daten darüber, wer einer Partei angehört, offenbaren politische Meinungen: siehe die Anwendungshinweise zu mbr:Membership."@de .

mbrc:tradeUnion a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:voluntaryAssociation ;
    skos:prefLabel "Trade Union"@en , "Fackförening"@sv , "Gewerkschaft"@de ;
    skos:altLabel "Labour Union"@en , "Labor Union"@en , "Fackförbund"@sv ;
    skos:definition "An organisation of employees that represents its members' interests towards employers, for example in collective bargaining."@en ,
                    "En organisation av arbetstagare som företräder medlemmarnas intressen gentemot arbetsgivare, t.ex. i förhandlingar om kollektivavtal."@sv ,
                    "Eine Organisation von Arbeitnehmern, die die Interessen ihrer Mitglieder gegenüber Arbeitgebern vertritt, etwa in Tarifverhandlungen."@de ;
    skos:scopeNote "Trade union membership is special-category personal data: see the scope note on mbr:Membership."@en ,
                   "Medlemskap i en fackförening är en känslig personuppgift: se anmärkningen till mbr:Membership."@sv ,
                   "Die Mitgliedschaft in einer Gewerkschaft gehört zu den besonderen Kategorien personenbezogener Daten: siehe die Anwendungshinweise zu mbr:Membership."@de .

##############################################################################
# 2. MEMBERSHIP STATUSES
##############################################################################

mbrc:MembershipStatuses a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Membership Statuses"@en , "Medlemskapsstatusar"@sv , "Mitgliedschaftsstatus"@de ;
    skos:definition "Stages in the life of a membership, from being considered to leaving."@en ,
                    "Stadier i ett medlemskaps livscykel, från att vara påtänkt till utträde."@sv ,
                    "Abschnitte im Leben einer Mitgliedschaft, von der Erwägung bis zum Ausscheiden."@de ;
    skos:hasTopConcept mbrc:prospect , mbrc:proposed , mbrc:candidate , mbrc:elected ,
                       mbrc:notAdmitted , mbrc:active , mbrc:dormant , mbrc:suspended ,
                       mbrc:resigned , mbrc:lapsed , mbrc:expelled , mbrc:deceased ,
                       mbrc:emeritus .

mbrc:prospect a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Prospect"@en , "Påtänkt"@sv , "Interessent"@de ;
    skos:definition "Being considered for membership; not yet formally proposed."@en ,
                    "Påtänkt för medlemskap men ännu inte formellt föreslagen."@sv ,
                    "Wird für die Mitgliedschaft in Betracht gezogen; noch nicht förmlich vorgeschlagen."@de .

mbrc:proposed a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Proposed"@en , "Föreslagen"@sv , "Vorgeschlagen"@de ;
    skos:definition "Formally proposed for membership by a member."@en ,
                    "Formellt föreslagen till medlemskap av en medlem."@sv ,
                    "Von einem Mitglied förmlich für die Mitgliedschaft vorgeschlagen."@de .

mbrc:candidate a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Candidate"@en , "Kandidat"@sv , "Kandidat"@de ;
    skos:altLabel "Applicant"@en , "Sökande"@sv ;
    skos:definition "Accepted as a candidate, or has applied, and awaiting election, an admission decision or initiation."@en ,
                    "Antagen som kandidat, eller har ansökt, och i väntan på val, beslut om upptagning eller initiering."@sv ,
                    "Als Kandidat angenommen oder hat sich beworben und erwartet Wahl, Aufnahmeentscheidung oder Initiation."@de .

mbrc:elected a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Elected"@en , "Invald"@sv , "Gewählt"@de ;
    skos:definition "Elected to membership but not yet admitted."@en ,
                    "Invald men ännu inte upptagen."@sv ,
                    "In die Mitgliedschaft gewählt, aber noch nicht aufgenommen."@de .

mbrc:notAdmitted a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Not Admitted"@en , "Ej upptagen"@sv , "Nicht aufgenommen"@de ;
    skos:definition "The proposal or application ended without admission: it was rejected, stopped or withdrawn."@en ,
                    "Förslaget eller ansökan avslutades utan upptagning: det avslogs, stoppades eller drogs tillbaka."@sv ,
                    "Der Vorschlag oder die Bewerbung endete ohne Aufnahme: Sie wurde abgelehnt, gestoppt oder zurückgezogen."@de ;
    skos:scopeNote "Record the organisation's decision as a mbr:MembershipEvent of type mbrc:rejection with mbr:resultingStatus mbrc:notAdmitted."@en ,
                   "Organisationens beslut registreras som en mbr:MembershipEvent av typen mbrc:rejection med mbr:resultingStatus mbrc:notAdmitted."@sv ,
                   "Die Entscheidung der Organisation als mbr:MembershipEvent der Art mbrc:rejection mit mbr:resultingStatus mbrc:notAdmitted festhalten."@de .

mbrc:active a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Active Member"@en , "Aktiv medlem"@sv , "Aktives Mitglied"@de ;
    skos:definition "A full member in good standing."@en ,
                    "En fullvärdig medlem med alla rättigheter."@sv ,
                    "Ein Vollmitglied in gutem Ansehen."@de .

mbrc:dormant a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Dormant"@en , "Vilande"@sv , "Ruhend"@de ;
    skos:definition "A member who has, by agreement, paused participation."@en ,
                    "En medlem som efter överenskommelse gjort uppehåll i deltagandet."@sv ,
                    "Ein Mitglied, das die Teilnahme einvernehmlich ausgesetzt hat."@de .

mbrc:suspended a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Suspended"@en , "Avstängd"@sv , "Suspendiert"@de ;
    skos:definition "Temporarily deprived of the rights of membership."@en ,
                    "Tillfälligt fråntagen medlemskapets rättigheter."@sv ,
                    "Vorübergehend der Rechte der Mitgliedschaft beraubt."@de .

mbrc:resigned a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Resigned"@en , "Utträdd"@sv , "Ausgetreten"@de ;
    skos:definition "Left the organisation at their own request."@en ,
                    "Har lämnat organisationen på egen begäran."@sv ,
                    "Hat die Organisation auf eigenen Wunsch verlassen."@de .

mbrc:lapsed a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Lapsed"@en , "Avförd"@sv , "Erloschen"@de ;
    skos:definition "Membership ended because obligations such as fees were not met."@en ,
                    "Medlemskapet har upphört för att skyldigheter, t.ex. avgifter, inte fullgjorts."@sv ,
                    "Die Mitgliedschaft endete, weil Pflichten wie die Beitragszahlung nicht erfüllt wurden."@de .

mbrc:expelled a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Expelled"@en , "Utesluten"@sv , "Ausgeschlossen"@de ;
    skos:definition "Removed from membership by decision of the organisation."@en ,
                    "Skild från medlemskapet genom beslut av organisationen."@sv ,
                    "Durch Beschluss der Organisation aus der Mitgliedschaft entfernt."@de .

mbrc:deceased a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Deceased"@en , "Avliden"@sv , "Verstorben"@de ;
    skos:definition "Membership ended by the death of the member."@en ,
                    "Medlemskapet har upphört genom medlemmens död."@sv ,
                    "Die Mitgliedschaft endete mit dem Tod des Mitglieds."@de .

mbrc:emeritus a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Emeritus"@en , "Emeritus"@sv , "Emeritus"@de ;
    skos:definition "A retired member who keeps an honoured standing."@en ,
                    "En medlem som dragit sig tillbaka men behåller en hedrad ställning."@sv ,
                    "Ein im Ruhestand befindliches Mitglied, das ein ehrenvolles Ansehen behält."@de .

##############################################################################
# 3. MEMBERSHIP CATEGORIES
##############################################################################

mbrc:MembershipCategories a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Membership Categories"@en , "Medlemskategorier"@sv , "Mitgliedschaftskategorien"@de ;
    skos:definition "Categories of membership with different rights or fees."@en ,
                    "Medlemskategorier med olika rättigheter eller avgifter."@sv ,
                    "Kategorien der Mitgliedschaft mit unterschiedlichen Rechten oder Beiträgen."@de ;
    skos:hasTopConcept mbrc:ordinary , mbrc:life , mbrc:honorary , mbrc:associate ,
                       mbrc:junior , mbrc:nonResident , mbrc:overseas , mbrc:partnerMember ,
                       mbrc:founding .

mbrc:ordinary a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories ; skos:topConceptOf mbrc:MembershipCategories ;
    skos:prefLabel "Ordinary Member"@en , "Ordinarie medlem"@sv , "Ordentliches Mitglied"@de ;
    skos:definition "The standard category with full rights."@en , "Standardkategorin med fulla rättigheter."@sv , "Die Standardkategorie mit allen Rechten."@de .

mbrc:life a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories ; skos:topConceptOf mbrc:MembershipCategories ;
    skos:prefLabel "Life Member"@en , "Ständig medlem"@sv , "Mitglied auf Lebenszeit"@de ;
    skos:definition "Membership for life, usually after a one-time fee."@en , "Medlemskap på livstid, vanligen efter en engångsavgift."@sv , "Mitgliedschaft auf Lebenszeit, meist nach einer einmaligen Gebühr."@de .

mbrc:honorary a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories ; skos:topConceptOf mbrc:MembershipCategories ;
    skos:prefLabel "Honorary Member"@en , "Hedersledamot"@sv , "Ehrenmitglied"@de ;
    skos:definition "Membership conferred as an honour, usually without fees."@en , "Medlemskap som ges som hedersbetygelse, vanligen utan avgift."@sv , "Als Ehre verliehene Mitgliedschaft, meist ohne Beiträge."@de .

mbrc:associate a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories ; skos:topConceptOf mbrc:MembershipCategories ;
    skos:prefLabel "Associate Member"@en , "Associerad medlem"@sv , "Außerordentliches Mitglied"@de ;
    skos:definition "Membership with limited rights, for example without vote."@en , "Medlemskap med begränsade rättigheter, t.ex. utan rösträtt."@sv , "Mitgliedschaft mit eingeschränkten Rechten, zum Beispiel ohne Stimmrecht."@de .

mbrc:junior a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories ; skos:topConceptOf mbrc:MembershipCategories ;
    skos:prefLabel "Junior Member"@en , "Juniormedlem"@sv , "Jugendmitglied"@de ;
    skos:definition "Membership for younger members, often at a reduced fee."@en , "Medlemskap för yngre medlemmar, ofta till reducerad avgift."@sv , "Mitgliedschaft für jüngere Mitglieder, oft mit ermäßigtem Beitrag."@de .

mbrc:nonResident a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories ; skos:topConceptOf mbrc:MembershipCategories ;
    skos:prefLabel "Country Member"@en , "Landsortsmedlem"@sv , "Auswärtiges Mitglied"@de ;
    skos:altLabel "Non-resident Member"@en ;
    skos:definition "Membership for members living far from the club's premises."@en , "Medlemskap för medlemmar som bor långt från klubbens lokaler."@sv , "Mitgliedschaft für Mitglieder, die weit von den Räumlichkeiten des Clubs entfernt wohnen."@de .

mbrc:overseas a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories ; skos:topConceptOf mbrc:MembershipCategories ;
    skos:prefLabel "Overseas Member"@en , "Utlandsmedlem"@sv , "Mitglied im Ausland"@de ;
    skos:definition "Membership for members living abroad."@en , "Medlemskap för medlemmar bosatta utomlands."@sv , "Mitgliedschaft für Mitglieder, die im Ausland leben."@de .

mbrc:partnerMember a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories ; skos:topConceptOf mbrc:MembershipCategories ;
    skos:prefLabel "Partner Member"@en , "Partnermedlem"@sv , "Partnermitglied"@de ;
    skos:definition "Membership granted to the spouse or partner of a member."@en , "Medlemskap för en medlems make, maka eller partner."@sv , "Mitgliedschaft, die dem Ehegatten oder Partner eines Mitglieds gewährt wird."@de .

mbrc:founding a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories ; skos:topConceptOf mbrc:MembershipCategories ;
    skos:prefLabel "Founding Member"@en , "Stiftande medlem"@sv , "Gründungsmitglied"@de ;
    skos:definition "A member who took part in founding the organisation."@en , "En medlem som deltog i organisationens grundande."@sv , "Ein Mitglied, das an der Gründung der Organisation beteiligt war."@de .

##############################################################################
# 4. MEMBERSHIP EVENT TYPES
##############################################################################

mbrc:MembershipEventTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Membership Event Types"@en , "Typer av medlemskapshändelser"@sv , "Arten von Mitgliedschaftsereignissen"@de ;
    skos:hasTopConcept mbrc:application , mbrc:proposal , mbrc:ballot , mbrc:rejection ,
                       mbrc:admission , mbrc:statusChange , mbrc:resignation , mbrc:lapse ,
                       mbrc:expulsion , mbrc:reinstatement , mbrc:death .

mbrc:application a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Application"@en , "Ansökan"@sv , "Antrag"@de ;
    skos:definition "Someone applies for membership."@en , "Någon ansöker om medlemskap."@sv , "Jemand beantragt die Mitgliedschaft."@de .

mbrc:proposal a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Proposal"@en , "Förslag"@sv , "Vorschlag"@de ;
    skos:definition "A member proposes a candidate."@en , "En medlem föreslår en kandidat."@sv , "Ein Mitglied schlägt einen Kandidaten vor."@de .

mbrc:ballot a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Ballot"@en , "Ballotering"@sv , "Abstimmung"@de ;
    skos:definition "The members vote on a candidate."@en , "Medlemmarna röstar om en kandidat."@sv , "Die Mitglieder stimmen über einen Kandidaten ab."@de .

mbrc:rejection a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Rejection"@en , "Avslag"@sv , "Ablehnung"@de ;
    skos:definition "The organisation decides not to go ahead with a proposal or application, by ballot or otherwise. The resulting status is mbrc:notAdmitted."@en ,
                    "Organisationen beslutar att inte gå vidare med ett förslag eller en ansökan, genom ballotering eller på annat sätt. Den nya statusen blir mbrc:notAdmitted."@sv ,
                    "Die Organisation beschließt, einen Vorschlag oder Antrag nicht weiterzuverfolgen, durch Abstimmung oder auf andere Weise. Der resultierende Status ist mbrc:notAdmitted."@de .

mbrc:admission a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Admission"@en , "Upptagning"@sv , "Aufnahme"@de ;
    skos:definition "The candidate, applicant or person enrolling becomes a member."@en ,
                    "Kandidaten, den sökande eller den som anmäler sig blir medlem."@sv ,
                    "Der Kandidat, Antragsteller oder Eintretende wird Mitglied."@de .

mbrc:statusChange a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Status Change"@en , "Statusändring"@sv , "Statusänderung"@de ;
    skos:definition "Any other change of membership status or category."@en , "Annan ändring av medlemskapets status eller kategori."@sv , "Jede andere Änderung des Mitgliedschaftsstatus oder der Kategorie."@de .

mbrc:resignation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Resignation"@en , "Utträde"@sv , "Austritt"@de ;
    skos:definition "The member leaves at their own request."@en , "Medlemmen lämnar på egen begäran."@sv , "Das Mitglied scheidet auf eigenen Wunsch aus."@de .

mbrc:lapse a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Lapse"@en , "Avförande"@sv , "Erlöschen"@de ;
    skos:definition "Membership ends because obligations were not met."@en , "Medlemskapet upphör för att skyldigheter inte fullgjorts."@sv , "Die Mitgliedschaft endet, weil Pflichten nicht erfüllt wurden."@de .

mbrc:expulsion a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Expulsion"@en , "Uteslutning"@sv , "Ausschluss"@de ;
    skos:definition "The organisation removes the member."@en , "Organisationen utesluter medlemmen."@sv , "Die Organisation entfernt das Mitglied."@de .

mbrc:reinstatement a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Reinstatement"@en , "Återinträde"@sv , "Wiederaufnahme"@de ;
    skos:definition "A former member is admitted again."@en , "En tidigare medlem upptas på nytt."@sv , "Ein ehemaliges Mitglied wird erneut aufgenommen."@de .

mbrc:death a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Death"@en , "Dödsfall"@sv , "Tod"@de ;
    skos:definition "The member dies."@en , "Medlemmen avlider."@sv , "Das Mitglied stirbt."@de .

##############################################################################
# 5. OFFICE TYPES  (hub; every concept is also a mbr:Office, i.e. an org:Role)
##############################################################################

mbrc:OfficeTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Office Types"@en , "Ämbetstyper"@sv , "Amtsarten"@de ;
    skos:definition "Generic offices found across clubs, societies and orders. Organisation-specific offices map to these."@en ,
                    "Generiska ämbeten som förekommer i klubbar, sällskap och ordnar. Organisationsspecifika ämbeten mappas hit."@sv ,
                    "Allgemeine Ämter, die sich in Clubs, Gesellschaften und Orden finden. Organisationsspezifische Ämter werden ihnen zugeordnet."@de ;
    skos:hasTopConcept mbrc:president , mbrc:vicePresident , mbrc:chancellor , mbrc:secretary , mbrc:treasurer ,
                       mbrc:archivist , mbrc:librarian , mbrc:chaplain , mbrc:masterOfCeremonies ,
                       mbrc:herald , mbrc:provost , mbrc:introducer , mbrc:steward ,
                       mbrc:cellarMaster , mbrc:kitchenMaster , mbrc:songLeader ,
                       mbrc:directorOfMusic , mbrc:chronicler , mbrc:webmaster , mbrc:custodian ,
                       mbrc:seniorAdviser , mbrc:regionalRepresentative , mbrc:eventLeader .

mbrc:president a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "President"@en , "Ordförande"@sv , "Präsident"@de ;
    skos:altLabel "Chair"@en , "Grand Master"@en , "Stormästare"@sv ;
    skos:definition "The highest executive officer of the organisation."@en , "Organisationens högsta verkställande ämbetsman."@sv , "Der höchste Amtsträger der Organisation."@de ;
    skos:scopeNote "Whatever the head is called locally (grand master, chancellor, governor …), map the head's office here and keep the local title as its label."@en ,
                   "Vad den högste ämbetsmannen än kallas lokalt (stormästare, kansler, guvernör …) mappas ämbetet hit och den lokala titeln behålls som dess etikett."@sv ,
                   "Wie auch immer das Oberhaupt vor Ort heißt (Großmeister, Kanzler, Statthalter …), das Amt des Oberhaupts hier zuordnen und den örtlichen Titel als Bezeichnung beibehalten."@de .

mbrc:vicePresident a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Vice President"@en , "Vice ordförande"@sv , "Vizepräsident"@de ;
    skos:definition "Deputy to the highest officer."@en , "Ställföreträdare för den högste ämbetsmannen."@sv , "Stellvertreter des höchsten Amtsträgers."@de .

mbrc:chancellor a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Chancellor"@en , "Kansler"@sv , "Kanzler"@de ;
    skos:altLabel "Grand Chancellor"@en , "Ordenskansler"@sv , "Storkansler"@sv ;
    skos:definition "The officer who keeps an order's seal, statutes and records of admissions and conferrals, usually second to the head."@en ,
                    "Den ämbetsman som förvarar en ordens sigill, stadgar och förteckningar över upptagningar och tilldelningar, vanligen närmast under den högste ämbetsmannen."@sv ,
                    "Der Amtsträger, der Siegel, Statuten und die Aufzeichnungen über Aufnahmen und Verleihungen eines Ordens verwahrt, meist der Zweite nach dem Oberhaupt."@de ;
    skos:scopeNote "Where the chancellor is the head of the order, record that office as mbrc:president."@en ,
                   "Där kanslern är ordens högste ämbetsman anges ämbetet som mbrc:president."@sv ,
                   "Ist der Kanzler das Oberhaupt des Ordens, dieses Amt als mbrc:president festhalten."@de .

mbrc:secretary a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Secretary"@en , "Sekreterare"@sv , "Schriftführer"@de ;
    skos:definition "Keeps minutes, the register of members and official correspondence."@en , "För protokoll, matrikel och officiell korrespondens."@sv , "Führt Protokolle, das Mitgliederverzeichnis und die offizielle Korrespondenz."@de .

mbrc:treasurer a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Treasurer"@en , "Skattmästare"@sv , "Schatzmeister"@de ;
    skos:altLabel "Kassör"@sv ;
    skos:definition "Manages the organisation's finances."@en , "Förvaltar organisationens ekonomi."@sv , "Verwaltet die Finanzen der Organisation."@de .

mbrc:archivist a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Archivist"@en , "Arkivarie"@sv , "Archivar"@de ;
    skos:definition "Keeps the organisation's archives."@en , "Förvaltar organisationens arkiv."@sv , "Verwahrt das Archiv der Organisation."@de .

mbrc:librarian a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Librarian"@en , "Bibliotekarie"@sv , "Bibliothekar"@de ;
    skos:definition "Keeps the organisation's library."@en , "Förvaltar organisationens bibliotek."@sv , "Verwahrt die Bibliothek der Organisation."@de .

mbrc:chaplain a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Chaplain"@en , "Kaplan"@sv , "Kaplan"@de ;
    skos:definition "Leads the spiritual or reflective parts of ceremonies."@en , "Leder de andliga eller reflekterande inslagen i ceremonier."@sv , "Leitet die geistlichen oder besinnlichen Teile von Zeremonien."@de .

mbrc:masterOfCeremonies a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Master of Ceremonies"@en , "Ceremonimästare"@sv , "Zeremonienmeister"@de ;
    skos:definition "Responsible for rituals, ceremonies and formal events."@en , "Ansvarar för ritualer, ceremonier och formella tillställningar."@sv , "Zuständig für Rituale, Zeremonien und förmliche Veranstaltungen."@de .

mbrc:herald a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Herald"@en , "Härold"@sv , "Herold"@de ;
    skos:definition "Makes official proclamations and assists at ceremonies."@en , "Utropar officiella meddelanden och biträder vid ceremonier."@sv , "Verkündet amtliche Bekanntmachungen und wirkt bei Zeremonien mit."@de .

mbrc:provost a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Provost"@en , "Profoss"@sv , "Profos"@de ;
    skos:altLabel "Sergeant-at-Arms"@en , "Tyler"@en ;
    skos:definition "Keeps order and discipline at gatherings."@en , "Upprätthåller ordning och disciplin vid sammankomster."@sv , "Wahrt Ordnung und Disziplin bei Zusammenkünften."@de .

mbrc:introducer a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Introducer"@en , "Introduktör"@sv , "Einführer"@de ;
    skos:definition "Introduces new members and guests."@en , "Introducerar nya medlemmar och gäster."@sv , "Führt neue Mitglieder und Gäste ein."@de .

mbrc:steward a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Feast Steward"@en , "Festvärd"@sv , "Festordner"@de ;
    skos:altLabel "Steward"@en ;
    skos:definition "Arranges tables, hospitality and the practical side of feasts."@en , "Ordnar taffel, gästfrihet och det praktiska kring fester."@sv , "Richtet Tische, Bewirtung und die praktische Seite von Festen aus."@de .

mbrc:cellarMaster a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Cellar Master"@en , "Källarmästare"@sv , "Kellermeister"@de ;
    skos:altLabel "Wine Steward"@en ;
    skos:definition "Responsible for wines and spirits."@en , "Ansvarar för viner och spritdrycker."@sv , "Zuständig für Wein und Spirituosen."@de .

mbrc:kitchenMaster a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Kitchen Master"@en , "Köksmästare"@sv , "Küchenmeister"@de ;
    skos:definition "Responsible for food and the kitchen."@en , "Ansvarar för mat och kök."@sv , "Zuständig für das Essen und die Küche."@de .

mbrc:songLeader a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Song Leader"@en , "Sånganförare"@sv , "Vorsänger"@de ;
    skos:definition "Leads communal singing at dinners and events."@en , "Leder allsången vid middagar och tillställningar."@sv , "Leitet den gemeinsamen Gesang bei Essen und Veranstaltungen."@de .

mbrc:directorOfMusic a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Director of Music"@en , "Musikanförare"@sv , "Musikdirektor"@de ;
    skos:altLabel "Director musices"@sv ;
    skos:definition "Leads the music of the organisation."@en , "Leder organisationens musik."@sv , "Leitet die Musik der Organisation."@de .

mbrc:chronicler a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Chronicler"@en , "Krönikör"@sv , "Chronist"@de ;
    skos:definition "Records the organisation's history and activities."@en , "Skriver organisationens historia och krönika."@sv , "Hält die Geschichte und die Tätigkeiten der Organisation fest."@de .

mbrc:webmaster a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Webmaster"@en , "Webbansvarig"@sv , "Webmaster"@de ;
    skos:definition "Manages the website and digital presence."@en , "Förvaltar webbplats och digital närvaro."@sv , "Betreut die Website und den digitalen Auftritt."@de .

mbrc:custodian a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Custodian of Premises"@en , "Lokalansvarig"@sv , "Hausverwalter"@de ;
    skos:definition "Responsible for premises and material assets."@en , "Ansvarar för lokaler och materiella tillgångar."@sv , "Zuständig für die Räumlichkeiten und das Sachvermögen."@de .

mbrc:seniorAdviser a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Senior Adviser"@en , "Senior rådgivare"@sv , "Seniorberater"@de ;
    skos:altLabel "Elder"@en , "Äldste"@sv ;
    skos:definition "An experienced member with an advisory role."@en , "En erfaren medlem med rådgivande roll."@sv , "Ein erfahrenes Mitglied mit beratender Rolle."@de .

mbrc:regionalRepresentative a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Regional Representative"@en , "Regional representant"@sv , "Regionalvertreter"@de ;
    skos:definition "Represents the organisation, or leads a branch, in a region."@en , "Representerar organisationen, eller leder en avdelning, i en region."@sv , "Vertritt die Organisation in einer Region oder leitet dort eine Zweigstelle."@de .

mbrc:eventLeader a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Event Leader"@en , "Arrangemangsansvarig"@sv , "Veranstaltungsleiter"@de ;
    skos:definition "Leads a particular event, trip or project, often temporarily."@en , "Leder ett visst arrangemang, en resa eller ett projekt, ofta tillfälligt."@sv , "Leitet eine bestimmte Veranstaltung, Reise oder ein Projekt, oft vorübergehend."@de .

##############################################################################
# 6. GATHERING TYPES
##############################################################################

mbrc:GatheringTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Gathering Types"@en , "Typer av sammankomster"@sv , "Arten von Zusammenkünften"@de ;
    skos:hasTopConcept mbrc:meeting , mbrc:formalDinner , mbrc:informalDinner , mbrc:ball ,
                       mbrc:excursion , mbrc:lecture , mbrc:guestNight , mbrc:anniversary ,
                       mbrc:commemoration .

mbrc:meeting a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Meeting"@en , "Möte"@sv , "Sitzung"@de ;
    skos:definition "A meeting for business or discussion."@en , "Ett möte för ärenden eller samtal."@sv , "Eine Zusammenkunft zur Beratung oder Erledigung von Geschäften."@de ;
    skos:narrower mbrc:generalMeeting .

mbrc:generalMeeting a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:broader mbrc:meeting ;
    skos:prefLabel "General Meeting"@en , "Stämma"@sv , "Mitgliederversammlung"@de ;
    skos:altLabel "Annual General Meeting"@en , "Congress"@en , "Årsmöte"@sv , "Kongress"@sv ;
    skos:definition "A meeting of all members, or of delegates elected by them, with decision-making power."@en ,
                    "Ett möte med alla medlemmar, eller med ombud valda av dem, som har beslutanderätt."@sv ,
                    "Eine Versammlung aller Mitglieder oder der von ihnen gewählten Delegierten mit Beschlussbefugnis."@de .

mbrc:formalDinner a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Formal Dinner"@en , "Högtidsmiddag"@sv , "Festessen"@de ;
    skos:altLabel "Banquet"@en , "Bankett"@sv ;
    skos:definition "A formal dinner with a prescribed dress code and ceremonial elements."@en , "En formell middag med föreskriven klädkod och ceremoniella inslag."@sv , "Ein förmliches Essen mit vorgeschriebener Kleiderordnung und zeremoniellen Elementen."@de .

mbrc:informalDinner a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Informal Dinner"@en , "Informell middag"@sv , "Zwangloses Essen"@de ;
    skos:definition "A dinner without full ceremonial."@en , "En middag utan fullt ceremoniel."@sv , "Ein Essen ohne volles Zeremoniell."@de .

mbrc:ball a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Ball"@en , "Bal"@sv , "Ball"@de ;
    skos:definition "A formal dance."@en , "En formell dans."@sv , "Ein förmlicher Tanzabend."@de .

mbrc:excursion a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Excursion"@en , "Utflykt"@sv , "Ausflug"@de ;
    skos:altLabel "Trip"@en , "Resa"@sv ;
    skos:definition "A trip made together by members."@en , "En resa som medlemmarna gör tillsammans."@sv , "Eine gemeinsame Fahrt der Mitglieder."@de .

mbrc:lecture a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Lecture"@en , "Föredrag"@sv , "Vortrag"@de ;
    skos:definition "A talk given to the members."@en , "Ett föredrag för medlemmarna."@sv , "Ein Vortrag vor den Mitgliedern."@de .

mbrc:guestNight a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Guest Night"@en , "Gästafton"@sv , "Gästeabend"@de ;
    skos:altLabel "Ladies' Night"@en , "Damafton"@sv ;
    skos:definition "A gathering to which members may bring guests."@en , "En sammankomst dit medlemmar får ta med gäster."@sv , "Eine Zusammenkunft, zu der Mitglieder Gäste mitbringen dürfen."@de .

mbrc:anniversary a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Anniversary"@en , "Jubileum"@sv , "Jubiläum"@de ;
    skos:definition "A celebration of an anniversary of the organisation."@en , "Ett firande av en av organisationens årsdagar."@sv , "Eine Feier zu einem Jubiläum der Organisation."@de .

mbrc:commemoration a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Commemoration"@en , "Minneshögtid"@sv , "Gedenkfeier"@de ;
    skos:definition "A gathering in memory of a person or event."@en , "En sammankomst till minne av en person eller händelse."@sv , "Eine Zusammenkunft zum Gedenken an eine Person oder ein Ereignis."@de .

##############################################################################
# 7. PARTICIPATION ROLES
##############################################################################

mbrc:ParticipationRoles a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Participation Roles"@en , "Deltagarroller"@sv , "Teilnahmerollen"@de ;
    skos:hasTopConcept mbrc:member , mbrc:guest , mbrc:host , mbrc:partner , mbrc:speaker ,
                       mbrc:officiant , mbrc:reciprocalVisitor .

mbrc:member a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Member"@en , "Medlem"@sv , "Mitglied"@de ;
    skos:definition "Takes part as a member of the organising organisation."@en , "Deltar som medlem i den anordnande organisationen."@sv , "Nimmt als Mitglied der veranstaltenden Organisation teil."@de .

mbrc:guest a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Guest"@en , "Gäst"@sv , "Gast"@de ;
    skos:definition "Takes part as a guest, usually introduced by a member."@en , "Deltar som gäst, vanligen introducerad av en medlem."@sv , "Nimmt als Gast teil, meist von einem Mitglied eingeführt."@de .

mbrc:host a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Host"@en , "Värd"@sv , "Gastgeber"@de ;
    skos:definition "Hosts the gathering."@en , "Står värd för sammankomsten."@sv , "Richtet die Zusammenkunft aus."@de .

mbrc:partner a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Partner"@en , "Partner"@sv , "Begleitung"@de ;
    skos:altLabel "Dinner Partner"@en , "moatjé"@sv , "bordsdam"@sv , "bordskavaljer"@sv ;
    skos:definition "Accompanies a member as partner or dinner companion."@en , "Följer med en medlem som partner eller bordsällskap."@sv , "Begleitet ein Mitglied als Partner oder Tischdame beziehungsweise Tischherr."@de .

mbrc:speaker a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Speaker"@en , "Talare"@sv , "Redner"@de ;
    skos:definition "Gives a speech or lecture."@en , "Håller tal eller föredrag."@sv , "Hält eine Rede oder einen Vortrag."@de .

mbrc:officiant a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Officiant"@en , "Förrättare"@sv , "Zelebrant"@de ;
    skos:definition "Performs a ceremony or ritual."@en , "Förrättar en ceremoni eller ritual."@sv , "Führt eine Zeremonie oder ein Ritual durch."@de .

mbrc:reciprocalVisitor a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Reciprocal Visitor"@en , "Besökare från vänorganisation"@sv , "Besucher auf Gegenseitigkeit"@de ;
    skos:definition "A member of a reciprocal or recognised organisation, visiting."@en , "En besökande medlem från en organisation med ömsesidighet eller erkännande."@sv , "Ein Mitglied einer auf Gegenseitigkeit verbundenen oder anerkannten Organisation, das zu Besuch ist."@de .

##############################################################################
# 8. DRESS CODES
##############################################################################

mbrc:DressCodes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Dress Codes"@en , "Klädkoder"@sv , "Kleiderordnungen"@de ;
    skos:hasTopConcept mbrc:whiteTie , mbrc:blackTie , mbrc:loungeSuit , mbrc:morningDress ,
                       mbrc:academicDress , mbrc:uniform , mbrc:nationalCostume , mbrc:insigniaWorn .

mbrc:whiteTie a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "White Tie"@en , "Frack"@sv , "Frack (weiße Fliege)"@de ;
    skos:definition "Tailcoat with white bow tie, or the equivalent evening dress."@en , "Frack med vit fluga, eller motsvarande aftonklädsel."@sv , "Frack mit weißer Fliege oder die entsprechende Abendkleidung."@de .

mbrc:blackTie a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "Black Tie"@en , "Smoking"@sv , "Smoking (schwarze Fliege)"@de ;
    skos:altLabel "Tuxedo"@en ;
    skos:definition "Dinner jacket with black bow tie, or the equivalent."@en , "Smoking med svart fluga, eller motsvarande."@sv , "Smoking mit schwarzer Fliege oder das Entsprechende."@de .

mbrc:loungeSuit a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "Lounge Suit"@en , "Mörk kostym"@sv , "Dunkler Anzug"@de ;
    skos:altLabel "Dark Suit"@en , "Kavaj"@sv ;
    skos:definition "Dark suit and tie, or the equivalent."@en , "Mörk kostym och slips, eller motsvarande."@sv , "Dunkler Anzug mit Krawatte oder das Entsprechende."@de ;
    skos:scopeNote "Swedish invitations sometimes distinguish \"mörk kostym\" from the slightly less formal \"kavaj\"; both are recorded with this code."@en ,
                   "Svenska inbjudningar skiljer ibland mellan \"mörk kostym\" och den något mindre formella \"kavaj\"; båda anges med denna kod."@sv ,
                   "Schwedische Einladungen unterscheiden mitunter „mörk kostym“ vom etwas weniger förmlichen „kavaj“; beide werden mit diesem Code erfasst."@de .

mbrc:morningDress a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "Morning Dress"@en , "Jackett"@sv , "Cut"@de ;
    skos:definition "Daytime formal dress with morning coat."@en , "Formell dagklädsel med jackett."@sv , "Förmliche Tageskleidung mit Cutaway."@de .

mbrc:academicDress a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "Academic Dress"@en , "Akademisk högtidsdräkt"@sv , "Akademische Tracht"@de ;
    skos:definition "Academic dress as prescribed by the university."@en , "Akademisk högtidsdräkt enligt universitetets föreskrifter."@sv , "Akademische Tracht, wie sie von der Universität vorgeschrieben ist."@de .

mbrc:uniform a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "Uniform"@en , "Uniform"@sv , "Uniform"@de ;
    skos:definition "Military or other uniform."@en , "Militär eller annan uniform."@sv , "Militär- oder andere Uniform."@de .

mbrc:nationalCostume a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "National Costume"@en , "Folkdräkt"@sv , "Tracht"@de ;
    skos:definition "Traditional regional or national dress."@en , "Traditionell bygde- eller nationaldräkt."@sv , "Traditionelle regionale oder nationale Kleidung."@de .

mbrc:insigniaWorn a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "Insignia to Be Worn"@en , "Ordenstecken bäres"@sv , "Ordenszeichen werden getragen"@de ;
    skos:altLabel "Decorations"@en , "Med ordnar"@sv ;
    skos:definition "Orders, medals and insignia are to be worn. Combined with another dress code."@en , "Ordnar, medaljer och tecken ska bäras. Kombineras med en annan klädkod."@sv , "Orden, Medaillen und Insignien sind zu tragen. Wird mit einer anderen Kleiderordnung kombiniert."@de .

##############################################################################
# 9. GENDER POLICIES
##############################################################################

mbrc:GenderPolicies a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Gender Policies"@en , "Könspolicyer"@sv , "Geschlechterregelungen"@de ;
    skos:hasTopConcept mbrc:menOnly , mbrc:womenOnly , mbrc:mixed , mbrc:mixedSeparateBranches .

mbrc:menOnly a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GenderPolicies ; skos:topConceptOf mbrc:GenderPolicies ;
    skos:prefLabel "Men Only"@en , "Endast män"@sv , "Nur Männer"@de ;
    skos:definition "Only men are admitted as members."@en , "Endast män upptas som medlemmar."@sv , "Nur Männer werden als Mitglieder aufgenommen."@de .

mbrc:womenOnly a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GenderPolicies ; skos:topConceptOf mbrc:GenderPolicies ;
    skos:prefLabel "Women Only"@en , "Endast kvinnor"@sv , "Nur Frauen"@de ;
    skos:definition "Only women are admitted as members."@en , "Endast kvinnor upptas som medlemmar."@sv , "Nur Frauen werden als Mitglieder aufgenommen."@de .

mbrc:mixed a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GenderPolicies ; skos:topConceptOf mbrc:GenderPolicies ;
    skos:prefLabel "Mixed"@en , "Blandat"@sv , "Gemischt"@de ;
    skos:definition "Members of any gender are admitted on equal terms."@en , "Medlemmar av alla kön upptas på lika villkor."@sv , "Mitglieder jeden Geschlechts werden zu gleichen Bedingungen aufgenommen."@de .

mbrc:mixedSeparateBranches a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GenderPolicies ; skos:topConceptOf mbrc:GenderPolicies ;
    skos:prefLabel "Mixed, Separate Branches"@en , "Blandat, separata avdelningar"@sv , "Gemischt, getrennte Zweigstellen"@de ;
    skos:definition "Men and women are admitted, but to separate branches or lodges."@en , "Både män och kvinnor upptas, men i separata avdelningar eller loger."@sv , "Männer und Frauen werden aufgenommen, aber in getrennte Zweigstellen oder Logen."@de .

##############################################################################
# 10. ADMISSION MODES
##############################################################################

mbrc:AdmissionModes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Admission Modes"@en , "Upptagningsformer"@sv , "Aufnahmeverfahren"@de ;
    skos:hasTopConcept mbrc:byInvitation , mbrc:proposalAndBallot , mbrc:proposalAndObjectionPeriod ,
                       mbrc:openApplication , mbrc:openEnrolment , mbrc:hereditary , mbrc:exOfficio .

mbrc:byInvitation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "By Invitation"@en , "Genom inbjudan"@sv , "Auf Einladung"@de ;
    skos:definition "Membership is only offered by invitation."@en , "Medlemskap erbjuds endast genom inbjudan."@sv , "Die Mitgliedschaft wird nur auf Einladung angeboten."@de .

mbrc:proposalAndBallot a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "Proposal and Ballot"@en , "Förslag och ballotering"@sv , "Vorschlag und Abstimmung"@de ;
    skos:definition "Candidates are proposed by members and elected by ballot."@en , "Kandidater föreslås av medlemmar och väljs genom ballotering."@sv , "Kandidaten werden von Mitgliedern vorgeschlagen und durch Abstimmung gewählt."@de .

mbrc:proposalAndObjectionPeriod a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "Proposal and Objection Period"@en , "Förslag och invändningstid"@sv , "Vorschlag und Einspruchsfrist"@de ;
    skos:definition "Candidates are proposed and seconded by members, and the proposal is made known to the members for a set period. Unless an objection leads the organisation to stop it, the candidate goes ahead to admission; there is no vote."@en ,
                    "Kandidater föreslås och understöds av medlemmar, och förslaget görs känt för medlemmarna under en bestämd tid. Om ingen invändning får organisationen att stoppa det går kandidaten vidare till upptagning; ingen omröstning sker."@sv ,
                    "Kandidaten werden von Mitgliedern vorgeschlagen und unterstützt, und der Vorschlag wird den Mitgliedern für eine bestimmte Frist bekannt gemacht. Führt kein Einspruch dazu, dass die Organisation ihn stoppt, geht der Kandidat weiter zur Aufnahme; es gibt keine Abstimmung."@de ;
    skos:scopeNote "Compare mbrc:proposalAndBallot, where the members vote. A proposal that is stopped is recorded as a mbrc:rejection event with the resulting status mbrc:notAdmitted."@en ,
                   "Jämför mbrc:proposalAndBallot, där medlemmarna röstar. Ett förslag som stoppas registreras som en händelse av typen mbrc:rejection med den nya statusen mbrc:notAdmitted."@sv ,
                   "Vergleiche mbrc:proposalAndBallot, wo die Mitglieder abstimmen. Ein gestoppter Vorschlag wird als Ereignis mbrc:rejection mit dem resultierenden Status mbrc:notAdmitted festgehalten."@de .

mbrc:openApplication a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "Open Application"@en , "Öppen ansökan"@sv , "Offene Bewerbung"@de ;
    skos:definition "Anyone meeting the criteria may apply, and the organisation, usually its board, decides whether to admit the applicant."@en ,
                    "Alla som uppfyller kriterierna kan ansöka, och organisationen, vanligen styrelsen, beslutar om den sökande ska tas upp."@sv ,
                    "Jeder, der die Kriterien erfüllt, kann sich bewerben, und die Organisation, meist ihr Vorstand, entscheidet über die Aufnahme des Bewerbers."@de ;
    skos:scopeNote "Compare mbrc:openEnrolment, where no admission decision is made."@en ,
                   "Jämför mbrc:openEnrolment, där inget beslut om upptagning fattas."@sv ,
                   "Vergleiche mbrc:openEnrolment, wo keine Aufnahmeentscheidung getroffen wird."@de .

mbrc:openEnrolment a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "Open Enrolment"@en , "Inträde genom anmälan"@sv , "Offener Beitritt"@de ;
    skos:altLabel "Open Membership"@en , "Open Enrollment"@en , "Öppet medlemskap"@sv ;
    skos:definition "Anyone who accepts the organisation's purpose and rules may join by registering and, where required, paying the fee. No admission decision is made."@en ,
                    "Var och en som godtar organisationens ändamål och stadgar kan bli medlem genom att anmäla sig och i förekommande fall betala avgiften. Inget beslut om upptagning fattas."@sv ,
                    "Jeder, der den Zweck und die Regeln der Organisation anerkennt, kann durch Anmeldung und, wo verlangt, Zahlung des Beitrags beitreten. Es wird keine Aufnahmeentscheidung getroffen."@de .

mbrc:hereditary a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "Hereditary"@en , "Ärftligt"@sv , "Erblich"@de ;
    skos:definition "Membership passes by descent."@en , "Medlemskap går i arv."@sv , "Die Mitgliedschaft geht durch Abstammung über."@de .

mbrc:exOfficio a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "Ex Officio"@en , "Ex officio"@sv , "Von Amts wegen"@de ;
    skos:definition "Membership follows from holding a certain position."@en , "Medlemskap följer av en viss befattning."@sv , "Die Mitgliedschaft ergibt sich aus der Innehabung einer bestimmten Position."@de .

##############################################################################
# 11. DISTINCTION TYPES
##############################################################################

mbrc:DistinctionTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Distinction Types"@en , "Typer av utmärkelser"@sv , "Arten von Auszeichnungen"@de ;
    skos:hasTopConcept mbrc:medal , mbrc:badge , mbrc:honoraryTitle , mbrc:honoraryMembership ,
                       mbrc:trophy , mbrc:diploma .

mbrc:medal a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DistinctionTypes ; skos:topConceptOf mbrc:DistinctionTypes ;
    skos:prefLabel "Medal"@en , "Medalj"@sv , "Medaille"@de ;
    skos:definition "A medal, usually worn on a ribbon."@en , "En medalj, vanligen buren i band."@sv , "Eine Medaille, meist an einem Band getragen."@de .

mbrc:badge a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DistinctionTypes ; skos:topConceptOf mbrc:DistinctionTypes ;
    skos:prefLabel "Badge"@en , "Tecken"@sv , "Abzeichen"@de ;
    skos:definition "A badge or emblem of distinction."@en , "Ett hederstecken eller emblem."@sv , "Ein Abzeichen oder Emblem als Auszeichnung."@de .

mbrc:honoraryTitle a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DistinctionTypes ; skos:topConceptOf mbrc:DistinctionTypes ;
    skos:prefLabel "Honorary Title"@en , "Hederstitel"@sv , "Ehrentitel"@de ;
    skos:definition "A title conferred as an honour."@en , "En titel som ges som hedersbetygelse."@sv , "Ein als Ehre verliehener Titel."@de .

mbrc:honoraryMembership a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DistinctionTypes ; skos:topConceptOf mbrc:DistinctionTypes ;
    skos:prefLabel "Honorary Membership"@en , "Hedersledamotskap"@sv , "Ehrenmitgliedschaft"@de ;
    skos:definition "Membership conferred as an honour."@en , "Medlemskap som ges som hedersbetygelse."@sv , "Als Ehre verliehene Mitgliedschaft."@de .

mbrc:trophy a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DistinctionTypes ; skos:topConceptOf mbrc:DistinctionTypes ;
    skos:prefLabel "Trophy"@en , "Pris"@sv , "Pokal"@de ;
    skos:altLabel "Vandringspris"@sv ;
    skos:definition "A prize object, often passed on between winners."@en , "Ett pris, ofta vandrande mellan vinnare."@sv , "Ein Preisgegenstand, der oft von Sieger zu Sieger weitergereicht wird."@de .

mbrc:diploma a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DistinctionTypes ; skos:topConceptOf mbrc:DistinctionTypes ;
    skos:prefLabel "Diploma"@en , "Diplom"@sv , "Urkunde"@de ;
    skos:definition "A certificate of distinction."@en , "Ett hedersdiplom."@sv , "Eine Urkunde als Auszeichnung."@de .

##############################################################################
# 12. MATERIALS
##############################################################################

mbrc:Materials a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Materials"@en , "Material"@sv , "Materialien"@de ;
    skos:definition "Materials of medals, badges and insignia."@en , "Material i medaljer, tecken och insignier."@sv , "Materialien von Medaillen, Abzeichen und Insignien."@de ;
    skos:hasTopConcept mbrc:gold , mbrc:silver , mbrc:giltSilver , mbrc:bronze , mbrc:pewter ,
                       mbrc:enamel .

mbrc:gold a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:Materials ; skos:topConceptOf mbrc:Materials ;
    skos:prefLabel "Gold"@en , "Guld"@sv , "Gold"@de .

mbrc:silver a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:Materials ; skos:topConceptOf mbrc:Materials ;
    skos:prefLabel "Silver"@en , "Silver"@sv , "Silber"@de .

mbrc:giltSilver a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:Materials ; skos:topConceptOf mbrc:Materials ;
    skos:prefLabel "Silver-gilt"@en , "Förgyllt silver"@sv , "Vergoldetes Silber"@de .

mbrc:bronze a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:Materials ; skos:topConceptOf mbrc:Materials ;
    skos:prefLabel "Bronze"@en , "Brons"@sv , "Bronze"@de .

mbrc:pewter a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:Materials ; skos:topConceptOf mbrc:Materials ;
    skos:prefLabel "Pewter"@en , "Tenn"@sv , "Zinn"@de ;
    skos:scopeNote "The tin-based alloy (Swedish 'tenn' in the craft sense), not the element tin."@en ,
                   "Den tennbaserade legeringen (tenn i hantverksbemärkelse), inte grundämnet."@sv ,
                   "Die Legierung auf Zinnbasis (schwedisch 'tenn' im handwerklichen Sinn), nicht das Element Zinn."@de .

mbrc:enamel a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:Materials ; skos:topConceptOf mbrc:Materials ;
    skos:prefLabel "Enamel"@en , "Emalj"@sv , "Email"@de .

##############################################################################
# 13. ORGANISATION STATUSES  (values of mbr:organizationStatus)
##############################################################################

mbrc:OrganizationStatuses a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Organisation Statuses"@en , "Organisationsstatusar"@sv , "Organisationsstatus"@de ;
    skos:definition "Whether an organisation still exists and operates."@en ,
                    "Om en organisation fortfarande finns och är verksam."@sv ,
                    "Ob eine Organisation noch besteht und tätig ist."@de ;
    skos:hasTopConcept mbrc:activeOrganization , mbrc:dormantOrganization ,
                       mbrc:mergedOrganization , mbrc:closedOrganization .

mbrc:activeOrganization a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationStatuses ; skos:topConceptOf mbrc:OrganizationStatuses ;
    skos:prefLabel "Active"@en , "Verksam"@sv , "Aktiv"@de ;
    skos:definition "The organisation exists and operates."@en , "Organisationen finns och är verksam."@sv , "Die Organisation besteht und ist tätig."@de .

mbrc:dormantOrganization a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationStatuses ; skos:topConceptOf mbrc:OrganizationStatuses ;
    skos:prefLabel "Dormant"@en , "Vilande"@sv , "Ruhend"@de ;
    skos:definition "The organisation still exists but has suspended its activities, for example while without premises."@en ,
                    "Organisationen finns kvar men har gjort uppehåll i verksamheten, t.ex. i väntan på nya lokaler."@sv ,
                    "Die Organisation besteht noch, hat ihre Tätigkeit aber eingestellt, zum Beispiel solange sie keine Räumlichkeiten hat."@de .

mbrc:mergedOrganization a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationStatuses ; skos:topConceptOf mbrc:OrganizationStatuses ;
    skos:prefLabel "Merged"@en , "Sammanslagen"@sv , "Fusioniert"@de ;
    skos:definition "The organisation no longer exists on its own, having merged into another. Record the merger as an org:ChangeEvent."@en ,
                    "Organisationen finns inte längre självständigt, eftersom den gått upp i en annan. Registrera sammanslagningen som en org:ChangeEvent."@sv ,
                    "Die Organisation besteht nicht mehr für sich, da sie in eine andere aufgegangen ist. Die Fusion als org:ChangeEvent festhalten."@de .

mbrc:closedOrganization a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationStatuses ; skos:topConceptOf mbrc:OrganizationStatuses ;
    skos:prefLabel "Closed"@en , "Nedlagd"@sv , "Aufgelöst"@de ;
    skos:altLabel "Defunct"@en , "Upplöst"@sv ;
    skos:definition "The organisation has been wound up."@en , "Organisationen har upplösts."@sv , "Die Organisation wurde abgewickelt."@de .

##############################################################################
# 14. OWNERSHIP MODELS  (values of mbr:ownershipModel)
##############################################################################

mbrc:OwnershipModels a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Ownership Models"@en , "Ägarformer"@sv , "Eigentumsmodelle"@de ;
    skos:definition "Who owns and runs a club or society."@en , "Vem som äger och driver en klubb eller ett sällskap."@sv , "Wem ein Club oder eine Gesellschaft gehört und wer sie betreibt."@de ;
    skos:hasTopConcept mbrc:membersClub , mbrc:proprietaryClub , mbrc:institutionalClub .

mbrc:membersClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OwnershipModels ; skos:topConceptOf mbrc:OwnershipModels ;
    skos:prefLabel "Members' Club"@en , "Medlemsägd klubb"@sv , "Mitgliederclub"@de ;
    skos:definition "Owned by its members, who govern it through a committee and share its property."@en ,
                    "Ägs av medlemmarna, som styr den genom en styrelse och delar på dess egendom."@sv ,
                    "Im Eigentum seiner Mitglieder, die ihn durch einen Ausschuss leiten und sein Vermögen teilen."@de .

mbrc:proprietaryClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OwnershipModels ; skos:topConceptOf mbrc:OwnershipModels ;
    skos:prefLabel "Proprietary Club"@en , "Ägarklubb"@sv , "Eigentümerclub"@de ;
    skos:definition "Owned and run by a proprietor or company for profit; members pay for the use of its facilities but do not own it."@en ,
                    "Ägs och drivs av en ägare eller ett bolag i vinstsyfte; medlemmarna betalar för tillgången men äger den inte."@sv ,
                    "Von einem Eigentümer oder einem Unternehmen auf Gewinn ausgerichtet geführt und besessen; Mitglieder zahlen für die Nutzung der Einrichtungen, besitzen ihn aber nicht."@de .

mbrc:institutionalClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OwnershipModels ; skos:topConceptOf mbrc:OwnershipModels ;
    skos:prefLabel "Institutional Club"@en , "Institutionsdriven klubb"@sv , "Institutionsclub"@de ;
    skos:definition "Owned or run by a parent institution, such as a university, regiment, company or government body."@en ,
                    "Ägs eller drivs av en moderinstitution, t.ex. ett universitet, ett regemente, ett företag eller en myndighet."@sv ,
                    "Im Besitz oder unter der Leitung einer übergeordneten Institution, etwa einer Universität, eines Regiments, eines Unternehmens oder einer Behörde."@de .

##############################################################################
# 15. FEE TYPES  (values of mbr:feeType)
##############################################################################

mbrc:FeeTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Fee Types"@en , "Avgiftstyper"@sv , "Beitragsarten"@de ;
    skos:definition "Kinds of membership fee, by when and how often they are paid."@en ,
                    "Typer av medlemsavgift, efter när och hur ofta de betalas."@sv ,
                    "Arten von Mitgliedsbeiträgen, danach, wann und wie oft sie gezahlt werden."@de ;
    skos:hasTopConcept mbrc:entranceFee , mbrc:annualFee , mbrc:monthlyFee , mbrc:lifeMembershipFee .

mbrc:entranceFee a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:FeeTypes ; skos:topConceptOf mbrc:FeeTypes ;
    skos:prefLabel "Entrance Fee"@en , "Inträdesavgift"@sv , "Aufnahmegebühr"@de ;
    skos:altLabel "Joining Fee"@en , "Anslutningsavgift"@sv ;
    skos:definition "A one-off fee paid on admission."@en , "En engångsavgift som betalas vid upptagningen."@sv , "Eine einmalige Gebühr bei der Aufnahme."@de .

mbrc:annualFee a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:FeeTypes ; skos:topConceptOf mbrc:FeeTypes ;
    skos:prefLabel "Annual Fee"@en , "Årsavgift"@sv , "Jahresbeitrag"@de ;
    skos:altLabel "Annual Subscription"@en , "Annual Dues"@en ;
    skos:definition "A fee paid every year to remain a member."@en , "En avgift som betalas varje år för att förbli medlem."@sv , "Ein Beitrag, der jedes Jahr zu zahlen ist, um Mitglied zu bleiben."@de .

mbrc:monthlyFee a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:FeeTypes ; skos:topConceptOf mbrc:FeeTypes ;
    skos:prefLabel "Monthly Fee"@en , "Månadsavgift"@sv , "Monatsbeitrag"@de ;
    skos:definition "A fee paid every month to remain a member, as is usual in trade unions."@en ,
                    "En avgift som betalas varje månad för att förbli medlem, som är vanligt i fackföreningar."@sv ,
                    "Ein Beitrag, der jeden Monat zu zahlen ist, um Mitglied zu bleiben, wie bei Gewerkschaften üblich."@de .

mbrc:lifeMembershipFee a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:FeeTypes ; skos:topConceptOf mbrc:FeeTypes ;
    skos:prefLabel "Life Membership Fee"@en , "Avgift för ständigt medlemskap"@sv , "Beitrag für lebenslange Mitgliedschaft"@de ;
    skos:definition "A one-off fee that buys membership for life (see mbrc:life)."@en ,
                    "En engångsavgift som ger medlemskap på livstid (se mbrc:life)."@sv ,
                    "Eine einmalige Gebühr, die die Mitgliedschaft auf Lebenszeit erwirbt (siehe mbrc:life)."@de .
