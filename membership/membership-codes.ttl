##############################################################################
# membership codelists  —  v1.1.0
#
# SKOS codelists for the Membership Organisations Ontology. They are the
# generic *hubs*: each organisation's own codelist maps to these (skos:*Match,
# kept in mappings/*.sssom.tsv), never directly to other organisations' lists.
# External mappings (Wikidata, Getty AAT) also live in mappings/, not here.
##############################################################################

@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix mbr:    <https://w3id.org/membership#> .
@prefix mbrc:   <https://w3id.org/membership/code/> .

<https://w3id.org/membership/code>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/membership/code/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    owl:priorVersion <https://w3id.org/membership/code/1.0.0> ;
    owl:backwardCompatibleWith <https://w3id.org/membership/code/1.0.0> ;
    owl:imports <https://w3id.org/membership> ;
    dcterms:title "Membership Organisations — codelists"@en ,
                  "Medlemsorganisationer — kodlistor"@sv ,
                  "Organisations de membres — listes de codes"@fr ,
                  "Mitgliederorganisationen – Codelisten"@de ,
                  "Organizzazioni associative — liste di codici"@it ,
                  "Organizaciones de miembros — listas de códigos"@es ,
                  "Organizações de membros — listas de códigos"@pt ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-10-09"^^xsd:date ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    vann:preferredNamespacePrefix "mbrc" ;
    vann:preferredNamespaceUri "https://w3id.org/membership/code/" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator <https://orcid.org/0009-0002-6239-5346> ;
    dcterms:rightsHolder <https://orcid.org/0009-0002-6239-5346> ;
    dcterms:publisher <https://github.com/society-ontologies> .

<https://orcid.org/0009-0002-6239-5346> <http://xmlns.com/foaf/0.1/name> "Oscar Almgren" .

<https://github.com/society-ontologies> a <http://xmlns.com/foaf/0.1/Organization> ;
    <http://xmlns.com/foaf/0.1/name> "Society Ontologies" .

##############################################################################
# 1. ORGANISATION TYPES
##############################################################################

mbrc:OrganizationTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Organisation Types"@en , "Organisationstyper"@sv , "Types d'organisations"@fr , "Organisationsarten"@de , "Tipi di organizzazione"@it , "Tipos de organización"@es , "Tipos de organização"@pt ;
    skos:definition "Kinds of membership organisation, used with org:classification. The fraternal codelists extend the fraternal branch."@en ,
                    "Typer av medlemsorganisationer, används med org:classification. Kodlistorna i fraternal utökar grenen för ordenssällskap."@sv ,
                    "Sortes d'organisations de membres, utilisées avec org:classification. Les listes de codes de fraternal étendent la branche des ordres fraternels."@fr ,
                    "Arten von Mitgliederorganisationen, verwendet mit org:classification. Die Codelisten von fraternal erweitern den Zweig der Ordensgesellschaften."@de ,
                    "Tipi di organizzazione associativa, usati con org:classification. Le liste di codici fraternali estendono il ramo fraternale."@it ,
                    "Tipos de organización de miembros, usados con org:classification. Las listas de códigos fraternales amplían la rama fraternal."@es ,
                    "Tipos de organização de membros, usados com org:classification. As listas de códigos fraternais ampliam o ramo fraternal."@pt ;
    skos:hasTopConcept mbrc:voluntaryAssociation .

mbrc:voluntaryAssociation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:topConceptOf mbrc:OrganizationTypes ;
    skos:prefLabel "Voluntary Association"@en , "Frivillig sammanslutning"@sv , "Association volontaire"@fr , "Freiwillige Vereinigung"@de , "Associazione volontaria"@it , "Asociación voluntaria"@es , "Associação voluntária"@pt ;
    skos:altLabel "ideell förening"@sv , "Associazione senza scopo di lucro"@it ;
    skos:definition "A group of people who join together voluntarily for a shared purpose."@en ,
                    "En grupp människor som frivilligt går samman för ett gemensamt syfte."@sv ,
                    "Groupe de personnes qui se réunissent volontairement dans un but commun."@fr ,
                    "Eine Gruppe von Menschen, die sich freiwillig für einen gemeinsamen Zweck zusammenschließen."@de ,
                    "Un gruppo di persone che si uniscono volontariamente per uno scopo comune."@it ,
                    "Un grupo de personas que se unen voluntariamente con un fin común."@es ,
                    "Um grupo de pessoas que se juntam voluntariamente com um fim comum."@pt ;
    skos:narrower mbrc:club , mbrc:society , mbrc:informalCircle , mbrc:fraternalOrganization ,
                  mbrc:politicalParty , mbrc:tradeUnion , mbrc:federation .

mbrc:informalCircle a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:voluntaryAssociation ;
    skos:prefLabel "Informal Circle"@en , "Kotteri"@sv , "Cercle informel"@fr , "Informeller Kreis"@de , "Cerchia informale"@it , "Círculo informal"@es , "Círculo informal"@pt ;
    skos:altLabel "Coterie"@en , "Circle of Friends"@en , "Vänkrets"@sv , "Umgängeskrets"@sv ,
                  "Coterie"@fr , "Cercle d'amis"@fr , "Freundeskreis"@de ,
                  "Cerchia di amici"@it ,
                  "Consorteria"@it ;
    skos:definition "A relatively closed company of friends or associates without legal status or registration, held together by friendship or invitation rather than formal admission. It may be a temporary group that keeps together at a larger gathering, or a more lasting circle of friends, often formed to arrange or take part in an occasion such as a ball, a banquet or a student celebration."@en ,
                    "Ett relativt slutet sällskap av vänner eller bekanta utan rättslig status eller registrering, som hålls samman av vänskap eller inbjudan snarare än av formellt upptagande. Det kan vara en tillfällig grupp som håller ihop vid ett större samkväm, eller en mer varaktig vänkrets, ofta bildad för att ordna eller delta i en tillställning som en bal, en bankett eller ett studentfirande."@sv ,
                    "Compagnie relativement fermée d'amis ou de relations, sans statut juridique ni enregistrement, unie par l'amitié ou l'invitation plutôt que par une admission formelle. Ce peut être un groupe provisoire qui reste ensemble lors d'une réunion plus large, ou un cercle d'amis plus durable, souvent formé pour organiser ou prendre part à une occasion comme un bal, un banquet ou une fête étudiante."@fr ,
                    "Eine verhältnismäßig geschlossene Gesellschaft von Freunden oder Bekannten ohne Rechtsstatus und ohne Eintragung, die durch Freundschaft oder Einladung statt durch förmliche Aufnahme zusammengehalten wird. Es kann eine vorübergehende Gruppe sein, die bei einer größeren Zusammenkunft zusammenbleibt, oder ein dauerhafterer Freundeskreis, oft gebildet, um einen Anlass wie einen Ball, ein Bankett oder eine Studentenfeier auszurichten oder daran teilzunehmen."@de ,
                    "Una compagnia relativamente chiusa di amici o conoscenti senza personalità giuridica né registrazione, tenuta insieme dall'amicizia o dall'invito più che da un'ammissione formale. Può essere un gruppo temporaneo che sta insieme a un incontro più grande, o una cerchia di amici più duratura, spesso formata per organizzare un'occasione o partecipare a essa, come un ballo, un banchetto o una festa studentesca."@it ,
                    "Una compañía relativamente cerrada de amigos o allegados sin personalidad jurídica ni registro, unida por la amistad o la invitación más que por una admisión formal. Puede ser un grupo temporal que se mantiene unido en una reunión mayor, o un círculo de amigos más duradero, a menudo formado para organizar o participar en una ocasión como un baile, un banquete o una fiesta estudiantil."@es ,
                    "Uma companhia relativamente fechada de amigos ou conhecidos sem personalidade jurídica nem registo, unida pela amizade ou pelo convite mais do que por uma admissão formal. Pode ser um grupo temporário que se mantém junto numa reunião maior, ou um círculo de amigos mais duradouro, muitas vezes formado para organizar ou participar numa ocasião como um baile, um banquete ou uma festa estudantil."@pt ;
    skos:scopeNote "The Swedish word kotteri, from French coterie, is often used in a derogatory sense of a clique that favours its own. That is a judgement, not a kind of organisation, and is not what this code records. The organiser of a gathering is given with mbr:organizer; compare mbrc:diningClub, a club that meets regularly for dinner."@en ,
                   "Ordet kotteri, av franskans coterie, används ofta i nedsättande mening om en klick som gynnar sina egna. Det är en bedömning och inte en slags organisation, och är inte vad den här koden anger. Den som ordnar en tillställning anges med mbr:organizer; jämför mbrc:diningClub, en klubb som regelbundet träffas för middag."@sv ,
                   "Le mot suédois kotteri, issu du français coterie, s'emploie souvent de façon péjorative pour une clique qui favorise les siens. C'est un jugement et non un genre d'organisation, et ce n'est pas ce que ce code enregistre. L'organisateur d'une réunion est indiqué avec mbr:organizer ; comparer mbrc:diningClub, club qui se réunit régulièrement pour dîner."@fr ,
                   "Das schwedische Wort kotteri, vom französischen coterie, wird oft abwertend für eine Clique gebraucht, die die Ihren begünstigt. Das ist ein Urteil und keine Art von Organisation und wird mit diesem Code nicht erfasst. Der Ausrichter einer Zusammenkunft wird mit mbr:organizer angegeben; vergleiche mbrc:diningClub, einen Club, der sich regelmäßig zum Essen trifft."@de ,
                   "La parola svedese kotteri, dal francese coterie, si usa spesso in senso spregiativo per una cricca che favorisce i propri. È un giudizio, non un tipo di organizzazione, e non è ciò che questo codice registra. L'organizzatore di un incontro si indica con mbr:organizer; si confronti mbrc:diningClub, un club che si riunisce regolarmente a cena."@it ,
                   "La palabra sueca kotteri, del francés coterie, se usa a menudo en sentido despectivo para una camarilla que favorece a los suyos. Eso es un juicio, no un tipo de organización, y no es lo que registra este código. El organizador de una reunión se indica con mbr:organizer; compárese mbrc:diningClub, un club que se reúne regularmente para cenar."@es ,
                   "A palavra sueca kotteri, do francês coterie, usa-se muitas vezes em sentido depreciativo para uma panelinha que favorece os seus. Isso é um juízo, não um tipo de organização, e não é o que este código regista. O organizador de uma reunião indica-se com mbr:organizer; compare-se mbrc:diningClub, um clube que se reúne regularmente para jantar."@pt .

mbrc:club a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:voluntaryAssociation ;
    skos:prefLabel "Club"@en , "Klubb"@sv , "Club"@fr , "Club"@de , "Circolo"@it , "Club"@es , "Clube"@pt ;
    skos:definition "An association of people for social or recreational purposes or for a shared interest."@en ,
                    "En sammanslutning för sällskapsliv, rekreation eller ett gemensamt intresse."@sv ,
                    "Association de personnes à but social ou récréatif ou autour d'un intérêt commun."@fr ,
                    "Ein Zusammenschluss von Menschen zu geselligen oder erholsamen Zwecken oder für ein gemeinsames Interesse."@de ,
                    "Un'associazione di persone per scopi sociali o ricreativi o per un interesse comune."@it ,
                    "Una asociación de personas con fines sociales o recreativos o por un interés común."@es ,
                    "Uma associação de pessoas com fins sociais ou recreativos ou por um interesse comum."@pt ;
    skos:narrower mbrc:privateClub , mbrc:diningClub , mbrc:countryClub , mbrc:armedForcesClub ,
                  mbrc:facultyClub , mbrc:sportsClub , mbrc:literaryClub , mbrc:serviceClub ,
                  mbrc:hobbyClub , mbrc:supportersClub .

mbrc:privateClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Private Club"@en , "Privat klubb"@sv , "Club privé"@fr , "Privatclub"@de , "Circolo privato"@it , "Club privado"@es , "Clube privado"@pt ;
    skos:definition "A club with exclusive membership, usually admitting members by proposal and election."@en ,
                    "En klubb med slutet medlemskap, där medlemmar vanligen upptas efter förslag och val."@sv ,
                    "Club à admission fermée, qui reçoit en général ses membres sur proposition et élection ; en France, un cercle."@fr ,
                    "Ein Club mit exklusiver Mitgliedschaft, der Mitglieder in der Regel auf Vorschlag und durch Wahl aufnimmt."@de ,
                    "Un circolo ad appartenenza esclusiva, che di solito ammette i soci su proposta ed elezione."@it ,
                    "Un club de pertenencia exclusiva, que normalmente admite a sus miembros por propuesta y elección."@es ,
                    "Um clube de filiação exclusiva, que normalmente admite os seus membros por proposta e eleição."@pt ;
    skos:narrower mbrc:gentlemensClub , mbrc:ladiesClub , mbrc:politicalClub , mbrc:universityClub ,
                  mbrc:professionalClub , mbrc:artsClub .

mbrc:gentlemensClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:privateClub ;
    skos:prefLabel "Gentlemen's Club"@en , "Herrklubb"@sv , "Club pour hommes"@fr , "Herrenclub"@de , "Gentlemen's club"@it , "Club de caballeros"@es , "Clube de cavalheiros"@pt ;
    skos:definition "A private social club traditionally for men, usually with its own clubhouse."@en ,
                    "En privat sällskapsklubb traditionellt för män, vanligen med eget klubbhus."@sv ,
                    "Club social privé traditionnellement réservé aux hommes, en général doté de son propre local ; en France, un cercle."@fr ,
                    "Ein privater geselliger Club, traditionell für Männer, meist mit eigenem Clubhaus."@de ,
                    "Un circolo sociale privato tradizionalmente per uomini, di solito con una propria sede."@it ,
                    "Un club social privado tradicionalmente para hombres, normalmente con sede propia."@es ,
                    "Um clube social privado tradicionalmente para homens, normalmente com sede própria."@pt .

mbrc:ladiesClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:privateClub ;
    skos:prefLabel "Ladies' Club"@en , "Damklubb"@sv , "Club pour femmes"@fr , "Damenclub"@de , "Circolo femminile"@it , "Club de señoras"@es , "Clube de senhoras"@pt ;
    skos:altLabel "Women's Club"@en , "Club féminin"@fr , "Club femminile"@it ;
    skos:definition "A private social club for women."@en ,
                    "En privat sällskapsklubb för kvinnor."@sv ,
                    "Club social privé pour femmes."@fr ,
                    "Ein privater geselliger Club für Frauen."@de ,
                    "Un circolo sociale privato per donne."@it ,
                    "Un club social privado para mujeres."@es ,
                    "Um clube social privado para mulheres."@pt .

mbrc:politicalClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:privateClub ;
    skos:prefLabel "Political Club"@en , "Politisk klubb"@sv , "Club politique"@fr , "Politischer Club"@de , "Circolo politico"@it , "Club político"@es , "Clube político"@pt ;
    skos:definition "A private club whose members share an allegiance to a political party or tradition."@en ,
                    "En privat klubb vars medlemmar delar tillhörighet till ett politiskt parti eller en politisk tradition."@sv ,
                    "Club privé dont les membres partagent l'adhésion à un parti ou à une tradition politique."@fr ,
                    "Ein privater Club, dessen Mitglieder einer politischen Partei oder Richtung verbunden sind."@de ,
                    "Un circolo privato i cui soci condividono l'appartenenza a un partito o a una tradizione politica."@it ,
                    "Un club privado cuyos miembros comparten la adhesión a un partido o a una tradición política."@es ,
                    "Um clube privado cujos membros partilham a adesão a um partido ou a uma tradição política."@pt ;
    skos:scopeNote "Not a political party: use mbrc:politicalParty for the party itself."@en ,
                   "Inte ett politiskt parti: använd mbrc:politicalParty för själva partiet."@sv ,
                   "Pas un parti politique : utiliser mbrc:politicalParty pour le parti lui-même."@fr ,
                   "Keine politische Partei: Für die Partei selbst mbrc:politicalParty verwenden."@de ,
                   "Non è un partito politico: per il partito stesso si usa mbrc:politicalParty."@it ,
                   "No es un partido político: para el partido mismo se usa mbrc:politicalParty."@es ,
                   "Não é um partido político: para o partido em si usa-se mbrc:politicalParty."@pt .

mbrc:universityClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:privateClub ;
    skos:prefLabel "University Club"@en , "Alumniklubb"@sv , "Club universitaire"@fr , "Universitätsclub"@de , "Circolo universitario"@it , "Club universitario"@es , "Clube universitário"@pt ;
    skos:definition "A private club for graduates of one or more particular universities."@en ,
                    "En privat klubb för dem som tagit examen vid ett eller flera bestämda universitet."@sv ,
                    "Club privé pour les diplômés d'une ou de plusieurs universités données."@fr ,
                    "Ein privater Club für Absolventen einer oder mehrerer bestimmter Universitäten."@de ,
                    "Un circolo privato per laureati di una o più università determinate."@it ,
                    "Un club privado para graduados de una o varias universidades concretas."@es ,
                    "Um clube privado para licenciados de uma ou mais universidades concretas."@pt .

mbrc:professionalClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:privateClub ;
    skos:prefLabel "Professional Club"@en , "Yrkesklubb"@sv , "Club professionnel"@fr , "Berufsclub"@de , "Circolo professionale"@it , "Club profesional"@es , "Clube profissional"@pt ;
    skos:definition "A private club whose members share a profession, such as law, medicine or the press."@en ,
                    "En privat klubb vars medlemmar delar ett yrke, t.ex. juridik, medicin eller press."@sv ,
                    "Club privé dont les membres partagent une profession, comme le droit, la médecine ou la presse."@fr ,
                    "Ein privater Club, dessen Mitglieder einen Beruf teilen, etwa Recht, Medizin oder Presse."@de ,
                    "Un circolo privato i cui soci condividono una professione, come il diritto, la medicina o la stampa."@it ,
                    "Un club privado cuyos miembros comparten una profesión, como el derecho, la medicina o la prensa."@es ,
                    "Um clube privado cujos membros partilham uma profissão, como o direito, a medicina ou a imprensa."@pt .

mbrc:artsClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:privateClub ;
    skos:prefLabel "Arts Club"@en , "Konstnärsklubb"@sv , "Club des arts"@fr , "Künstlerclub"@de , "Circolo artistico"@it , "Club de artes"@es , "Clube de artes"@pt ;
    skos:definition "A private club for people in the arts: artists, writers, actors, musicians and their patrons."@en ,
                    "En privat klubb för kulturutövare: konstnärer, författare, skådespelare, musiker och deras mecenater."@sv ,
                    "Club privé pour les gens des arts : artistes, écrivains, acteurs, musiciens et leurs mécènes."@fr ,
                    "Ein privater Club für Menschen in den Künsten: Künstler, Schriftsteller, Schauspieler, Musiker und ihre Förderer."@de ,
                    "Un circolo privato per persone che operano nelle arti: artisti, scrittori, attori, musicisti e i loro mecenati."@it ,
                    "Un club privado para gente de las artes: artistas, escritores, actores, músicos y sus mecenas."@es ,
                    "Um clube privado para gente das artes: artistas, escritores, atores, músicos e os seus mecenas."@pt .

mbrc:diningClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Dining Club"@en , "Middagsklubb"@sv , "Club de dîner"@fr , "Dinnerclub"@de , "Club di cene"@it , "Club gastronómico"@es , "Clube gastronómico"@pt ;
    skos:altLabel "middagssällskap"@sv , "Dîner-club"@fr ;
    skos:definition "A club that meets regularly for dinner and conversation."@en ,
                    "En klubb som regelbundet samlas till middag och samtal."@sv ,
                    "Club qui se réunit régulièrement pour dîner et converser."@fr ,
                    "Ein Club, der sich regelmäßig zu Essen und Gespräch trifft."@de ,
                    "Un club che si riunisce regolarmente per cenare e conversare."@it ,
                    "Un club que se reúne regularmente para cenar y conversar."@es ,
                    "Um clube que se reúne regularmente para jantar e conversar."@pt .

mbrc:countryClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Country Club"@en , "Countryclub"@sv , "Country club"@fr , "Country-Club"@de , "Country club"@it , "Club de campo"@es , "Clube de campo"@pt ;
    skos:definition "A club with sporting and social facilities, typically outside a city."@en ,
                    "En klubb med idrotts- och sällskapsanläggningar, oftast utanför staden."@sv ,
                    "Club doté d'installations sportives et sociales, en général hors de la ville."@fr ,
                    "Ein Club mit sportlichen und geselligen Einrichtungen, in der Regel außerhalb einer Stadt."@de ,
                    "Un club con strutture sportive e sociali, di solito fuori città."@it ,
                    "Un club con instalaciones deportivas y sociales, típicamente fuera de una ciudad."@es ,
                    "Um clube com instalações desportivas e sociais, tipicamente fora de uma cidade."@pt .

mbrc:armedForcesClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Armed Forces Club"@en , "Försvarsklubb"@sv , "Club des armées"@fr , "Club der Streitkräfte"@de , "Circolo delle forze armate"@it , "Club de las fuerzas armadas"@es , "Clube das forças armadas"@pt ;
    skos:altLabel "Service Club (military)"@en , "Cercle militaire"@fr , "Circolo militare"@it ;
    skos:definition "A club for serving and former members of the armed forces."@en ,
                    "En klubb för tjänstgörande och tidigare medlemmar av försvarsmakten."@sv ,
                    "Club pour les membres actuels et anciens des forces armées."@fr ,
                    "Ein Club für aktive und ehemalige Angehörige der Streitkräfte."@de ,
                    "Un circolo per militari in servizio e in congedo delle forze armate."@it ,
                    "Un club para miembros en activo y antiguos miembros de las fuerzas armadas."@es ,
                    "Um clube para membros no ativo e antigos membros das forças armadas."@pt ;
    skos:narrower mbrc:officersClub .

mbrc:officersClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:armedForcesClub ;
    skos:prefLabel "Officers' Club"@en , "Officersklubb"@sv , "Cercle des officiers"@fr , "Offiziersclub"@de , "Circolo ufficiali"@it , "Club de oficiales"@es , "Clube de oficiais"@pt ;
    skos:definition "A club for commissioned military officers."@en ,
                    "En klubb för officerare."@sv ,
                    "Club pour les officiers militaires."@fr ,
                    "Ein Club für Offiziere."@de ,
                    "Un circolo per ufficiali militari."@it ,
                    "Un club para oficiales militares con mando."@es ,
                    "Um clube para oficiais militares de comando."@pt .

mbrc:facultyClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Faculty Club"@en , "Universitetslärarklubb"@sv , "Club du corps enseignant"@fr , "Dozentenclub"@de , "Circolo dei docenti"@it , "Club del profesorado"@es , "Clube do corpo docente"@pt ;
    skos:definition "A club for the teaching staff of a university."@en ,
                    "En klubb för ett universitets lärare och forskare."@sv ,
                    "Club pour le personnel enseignant d'une université."@fr ,
                    "Ein Club für das Lehrpersonal einer Universität."@de ,
                    "Un circolo per il personale docente di un'università."@it ,
                    "Un club para el personal docente de una universidad."@es ,
                    "Um clube para o pessoal docente de uma universidade."@pt .

mbrc:sportsClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Sports Club"@en , "Idrottsklubb"@sv , "Club sportif"@fr , "Sportverein"@de , "Circolo sportivo"@it , "Club deportivo"@es , "Clube desportivo"@pt ;
    skos:definition "A club organised around a sport."@en ,
                    "En klubb organiserad kring en idrott."@sv ,
                    "Club organisé autour d'un sport."@fr ,
                    "Ein um eine Sportart organisierter Club."@de ,
                    "Un circolo organizzato intorno a uno sport."@it ,
                    "Un club organizado en torno a un deporte."@es ,
                    "Um clube organizado em torno de um desporto."@pt ;
    skos:narrower mbrc:yachtClub , mbrc:shootingSociety .

mbrc:yachtClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:sportsClub ;
    skos:prefLabel "Yacht Club"@en , "Segelsällskap"@sv , "Yacht-club"@fr , "Yachtclub"@de , "Yacht club"@it , "Club náutico"@es , "Clube náutico"@pt ;
    skos:altLabel "Kungliga segelsällskap"@sv ;
    skos:definition "A club for sailing and yachting, often with a social clubhouse."@en ,
                    "En klubb för segling och båtliv, ofta med ett sällskapligt klubbhus."@sv ,
                    "Club de voile et de plaisance, souvent doté d'un local social."@fr ,
                    "Ein Club für Segeln und Yachtsport, oft mit einem geselligen Clubhaus."@de ,
                    "Un club per la vela e la nautica da diporto, spesso con una sede sociale."@it ,
                    "Un club de vela y navegación de recreo, a menudo con una sede social."@es ,
                    "Um clube de vela e navegação de recreio, muitas vezes com uma sede social."@pt .

mbrc:serviceClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Service Club"@en , "Serviceklubb"@sv , "Club service"@fr , "Service-Club"@de , "Club di servizio"@it , "Club de servicio"@es , "Clube de serviço"@pt ;
    skos:definition "A club whose members meet socially and do voluntary or charitable work, such as Rotary or Lions clubs."@en ,
                    "En klubb vars medlemmar träffas socialt och gör ideella insatser, t.ex. Rotary- eller Lionsklubbar."@sv ,
                    "Club dont les membres se réunissent pour la convivialité et mènent des actions bénévoles ou caritatives, comme les clubs Rotary ou Lions."@fr ,
                    "Ein Club, dessen Mitglieder sich gesellig treffen und ehrenamtliche oder wohltätige Arbeit leisten, etwa Rotary- oder Lions-Clubs."@de ,
                    "Un club i cui soci si incontrano socialmente e fanno lavoro volontario o di beneficenza, come i Rotary o i Lions club."@it ,
                    "Un club cuyos miembros se reúnen socialmente y realizan trabajo voluntario o benéfico, como los clubes Rotary o Leones."@es ,
                    "Um clube cujos membros se reúnem socialmente e realizam trabalho voluntário ou de beneficência, como os clubes Rotary ou Leões."@pt .

mbrc:literaryClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Literary Club"@en , "Litterär klubb"@sv , "Club littéraire"@fr , "Literaturclub"@de , "Circolo letterario"@it , "Club literario"@es , "Clube literário"@pt ;
    skos:definition "A club devoted to literature, reading or writing."@en ,
                    "En klubb ägnad åt litteratur, läsning eller skrivande."@sv ,
                    "Club consacré à la littérature, à la lecture ou à l'écriture."@fr ,
                    "Ein Club, der der Literatur, dem Lesen oder dem Schreiben gewidmet ist."@de ,
                    "Un circolo dedicato alla letteratura, alla lettura o alla scrittura."@it ,
                    "Un club dedicado a la literatura, la lectura o la escritura."@es ,
                    "Um clube dedicado à literatura, à leitura ou à escrita."@pt .

mbrc:hobbyClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Hobby Club"@en , "Hobbyklubb"@sv , "Club de loisirs"@fr , "Hobbyclub"@de , "Circolo di appassionati"@it , "Club de aficionados"@es , "Clube de aficionados"@pt ;
    skos:altLabel "Hobbyförening"@sv , "Association de loisirs"@fr ;
    skos:definition "A club whose members pursue a hobby or craft together, such as a sewing circle, a photography club or a model railway club."@en ,
                    "En klubb vars medlemmar utövar en hobby eller ett hantverk tillsammans, t.ex. en syförening, en fotoklubb eller en modelljärnvägsklubb."@sv ,
                    "Club dont les membres pratiquent ensemble un passe-temps ou un artisanat, comme un cercle de couture, un club photo ou un club de modélisme ferroviaire."@fr ,
                    "Ein Club, dessen Mitglieder gemeinsam einem Hobby oder Handwerk nachgehen, etwa ein Nähkreis, ein Fotoclub oder ein Modelleisenbahnclub."@de ,
                    "Un circolo i cui soci coltivano insieme un hobby o un'arte manuale, come un circolo di cucito, di fotografia o di modellismo ferroviario."@it ,
                    "Un club cuyos miembros practican juntos una afición o un oficio, como un círculo de costura, un club de fotografía o un club de ferromodelismo."@es ,
                    "Um clube cujos membros praticam juntos um passatempo ou um ofício, como um círculo de costura, um clube de fotografia ou um clube de ferromodelismo."@pt .

mbrc:supportersClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:club ;
    skos:prefLabel "Supporters' Club"@en , "Supporterklubb"@sv , "Club de supporters"@fr , "Fanclub"@de , "Club di tifosi"@it , "Club de seguidores"@es , "Clube de adeptos"@pt ;
    skos:altLabel "Supporters' Association"@en , "Supporterförening"@sv , "Association de supporters"@fr , "Associazione di tifosi"@it ;
    skos:definition "A club for supporters of a sports team, most often a football club. It may be independent of the team or affiliated with it."@en ,
                    "En klubb för supportrar till ett idrottslag, oftast en fotbollsklubb. Den kan vara fristående från laget eller knuten till det."@sv ,
                    "Club de supporters d'une équipe sportive, le plus souvent de football. Il peut être indépendant de l'équipe ou lui être rattaché."@fr ,
                    "Ein Club für Anhänger einer Sportmannschaft, meist eines Fußballvereins. Er kann von der Mannschaft unabhängig oder mit ihr verbunden sein."@de ,
                    "Un club per i tifosi di una squadra sportiva, più spesso una squadra di calcio. Può essere indipendente dalla squadra o affiliato a essa."@it ,
                    "Un club de seguidores de un equipo deportivo, casi siempre de fútbol. Puede ser independiente del equipo o estar afiliado a él."@es ,
                    "Um clube de adeptos de uma equipa desportiva, quase sempre de futebol. Pode ser independente da equipa ou estar filiado nela."@pt .

mbrc:society a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:voluntaryAssociation ;
    skos:prefLabel "Society"@en , "Sällskap"@sv , "Société"@fr , "Gesellschaft"@de , "Società"@it , "Sociedad"@es , "Sociedade"@pt ;
    skos:definition "An association of people united by a common interest, purpose or profession."@en ,
                    "En sammanslutning av personer förenade av ett gemensamt intresse, syfte eller yrke."@sv ,
                    "Association de personnes unies par un intérêt, un but ou une profession communs."@fr ,
                    "Ein Zusammenschluss von Menschen, die ein gemeinsames Interesse, ein gemeinsamer Zweck oder ein gemeinsamer Beruf verbindet."@de ,
                    "Un'associazione di persone unite da un interesse, uno scopo o una professione comuni."@it ,
                    "Una asociación de personas unidas por un interés, un fin o una profesión comunes."@es ,
                    "Uma associação de pessoas unidas por um interesse, um fim ou uma profissão comuns."@pt ;
    skos:narrower mbrc:learnedSociety , mbrc:charitableSociety , mbrc:studentNation , mbrc:studentSociety ,
                  mbrc:alumniAssociation , mbrc:decorationHoldersAssociation , mbrc:guild , mbrc:contrada ,
                  mbrc:choralSociety , mbrc:carnivalSociety , mbrc:veteransAssociation .

mbrc:learnedSociety a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Learned Society"@en , "Lärt sällskap"@sv , "Société savante"@fr , "Gelehrte Gesellschaft"@de , "Società dotta"@it , "Sociedad científica"@es , "Sociedade científica"@pt ;
    skos:definition "A society that promotes an academic discipline or the arts."@en ,
                    "Ett sällskap som främjar en vetenskap eller konstart."@sv ,
                    "Société qui promeut une discipline universitaire ou les arts."@fr ,
                    "Eine Gesellschaft, die eine wissenschaftliche Disziplin oder die Künste fördert."@de ,
                    "Una società che promuove una disciplina accademica o le arti."@it ,
                    "Una sociedad que promueve una disciplina académica o las artes."@es ,
                    "Uma sociedade que promove uma disciplina académica ou as artes."@pt ;
    skos:narrower mbrc:academy .

mbrc:academy a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:learnedSociety ;
    skos:prefLabel "Academy"@en , "Akademi"@sv , "Académie"@fr , "Akademie"@de , "Accademia"@it , "Academia"@es , "Academia"@pt ;
    skos:definition "A learned society whose members are elected by its existing members, usually for life and often to a fixed number of numbered seats, as in the Académie française or the Swedish Academy."@en ,
                    "Ett lärt sällskap vars ledamöter väljs av de sittande ledamöterna, vanligen på livstid och ofta till ett fast antal numrerade stolar, som i Académie française eller Svenska Akademien."@sv ,
                    "Société savante dont les membres sont élus par ses membres, en général à vie et souvent à un nombre fixe de fauteuils numérotés, comme l'Académie française ou l'Académie suédoise."@fr ,
                    "Eine gelehrte Gesellschaft, deren Mitglieder von den bisherigen Mitgliedern gewählt werden, meist auf Lebenszeit und oft auf eine feste Zahl nummerierter Sitze, wie bei der Académie française oder der Schwedischen Akademie."@de ,
                    "Una società dotta i cui membri sono eletti dai membri già in carica, di solito a vita e spesso per un numero fisso di seggi numerati, come nell'Académie française o nell'Accademia svedese."@it ,
                    "Una sociedad científica cuyos miembros son elegidos por sus miembros actuales, normalmente de por vida y a menudo para un número fijo de sillones numerados, como en la Académie française o la Academia Sueca."@es ,
                    "Uma sociedade científica cujos membros são eleitos pelos seus membros atuais, normalmente para toda a vida e muitas vezes para um número fixo de cadeiras numeradas, como na Académie française ou na Academia Sueca."@pt ;
    skos:scopeNote "The numbered seats themselves (fauteuils, stolar) are not modelled; the model records who is a member and when."@en , "Les fauteuils numérotés eux-mêmes ne sont pas modélisés ; le modèle enregistre qui est membre et quand."@fr , "Die nummerierten Sitze selbst (fauteuils, stolar) werden nicht modelliert; das Modell hält fest, wer Mitglied ist und seit wann."@de , "I seggi numerati stessi (fauteuils, stolar) non sono modellati; il modello registra chi è socio e da quando."@it , "De numrerade stolarna själva (fauteuils, stolar) modelleras inte; modellen anger vem som är ledamot och när."@sv , "Los sillones numerados (fauteuils, stolar) no se modelan; el modelo registra quién es miembro y desde cuándo."@es , "As cadeiras numeradas (fauteuils, stolar) não se modelam; o modelo regista quem é membro e desde quando."@pt .

mbrc:alumniAssociation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Alumni Association"@en , "Alumniförening"@sv , "Association d'anciens"@fr , "Ehemaligenvereinigung"@de , "Associazione ex alunni"@it , "Asociación de antiguos alumnos"@es , "Associação de antigos alunos"@pt ;
    skos:altLabel "Old Pupils' Association"@en , "Amicale"@fr , "Associazione ex allievi"@it ;
    skos:definition "An association of former pupils, students or members of one school, university or institution, kept up for fellowship and mutual support."@en ,
                    "En förening för tidigare elever, studenter eller medlemmar vid en skola, ett universitet eller en institution, som hålls vid liv för gemenskap och ömsesidigt stöd."@sv ,
                    "Association d'anciens élèves, étudiants ou membres d'une école, d'une université ou d'une institution, entretenue pour la convivialité et l'entraide."@fr ,
                    "Eine Vereinigung ehemaliger Schüler, Studenten oder Mitglieder einer Schule, Universität oder Einrichtung, die der Geselligkeit und gegenseitigen Unterstützung dient."@de ,
                    "Un'associazione di ex alunni, ex studenti o ex membri di una scuola, università o istituzione, mantenuta per la convivialità e il sostegno reciproco."@it ,
                    "Una asociación de antiguos alumnos, estudiantes o miembros de una escuela, universidad o institución, mantenida por compañerismo y apoyo mutuo."@es ,
                    "Uma associação de antigos alunos, estudantes ou membros de uma escola, universidade ou instituição, mantida por camaradagem e apoio mútuo."@pt ;
    skos:scopeNote "Compare mbrc:studentSociety, whose members are students or former students and which exists at the institution itself."@en , "Comparer mbrc:studentSociety, dont les membres sont des étudiants ou d'anciens étudiants et qui existe dans l'établissement même."@fr , "Vgl. mbrc:studentSociety, deren Mitglieder Studenten oder ehemalige Studenten sind und die an der Einrichtung selbst besteht."@de , "Si confronti mbrc:studentSociety, i cui soci sono studenti o ex studenti e che esiste presso l'istituzione stessa."@it , "Jämför mbrc:studentSociety, vars medlemmar är studenter eller före detta studenter och som finns vid själva institutionen."@sv , "Compárese mbrc:studentSociety, cuyos miembros son estudiantes o antiguos estudiantes y que existe en la propia institución."@es , "Compare-se mbrc:studentSociety, cujos membros são estudantes ou antigos estudantes e que existe na própria instituição."@pt .

mbrc:decorationHoldersAssociation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Association of Decoration Holders"@en , "Förening för utmärkelsemottagare"@sv , "Association de décorés"@fr , "Vereinigung von Ordensträgern"@de , "Associazione di decorati"@it , "Asociación de condecorados"@es , "Associação de condecorados"@pt ;
    skos:definition "An association of people who hold a state order or decoration, separate from the order itself, which they do not run: it keeps up fellowship and supports the order's aims."@en ,
                    "En förening för personer som innehar en statlig orden eller utmärkelse, skild från själva orden, som den inte driver: den vårdar gemenskapen och stöder ordens syften."@sv ,
                    "Association de personnes titulaires d'un ordre ou d'une décoration de l'État, distincte de l'ordre lui-même, qu'elle ne dirige pas : elle entretient la convivialité et soutient les buts de l'ordre."@fr ,
                    "Eine Vereinigung von Personen, die einen staatlichen Orden oder eine Auszeichnung tragen, getrennt vom Orden selbst, den sie nicht leitet: Sie pflegt die Geselligkeit und unterstützt die Ziele des Ordens."@de ,
                    "Un'associazione di persone che detengono un ordine o una decorazione di Stato, distinta dall'ordine stesso, che non dirige: cura la convivialità e sostiene gli scopi dell'ordine."@it ,
                    "Una asociación de personas que poseen una orden o condecoración del Estado, distinta de la orden misma, que no dirigen: mantiene el compañerismo y apoya los fines de la orden."@es ,
                    "Uma associação de pessoas que possuem uma ordem ou condecoração do Estado, distinta da própria ordem, que não dirigem: mantém a camaradagem e apoia os fins da ordem."@pt ;
    skos:scopeNote "The order itself is fraternalc:orderOfChivalry, or a mbr:Distinction where it has no body of members. Example: the Société des membres de la Légion d'honneur, which is not the Legion of Honour."@en , "L'ordre lui-même est un fraternalc:orderOfChivalry, ou une mbr:Distinction s'il n'a pas de corps de membres. Exemple : la Société des membres de la Légion d'honneur, qui n'est pas la Légion d'honneur."@fr , "Der Orden selbst ist fraternalc:orderOfChivalry oder, wo er keinen Mitgliederkreis hat, eine mbr:Distinction. Beispiel: die Société des membres de la Légion d'honneur, die nicht die Ehrenlegion ist."@de , "L'ordine stesso è fraternalc:orderOfChivalry, oppure un mbr:Distinction se non ha un corpo di soci. Esempio: la Société des membres de la Légion d'honneur, che non è la Legion d'onore."@it , "Själva orden är fraternalc:orderOfChivalry, eller en mbr:Distinction om den saknar medlemskrets. Exempel: Société des membres de la Légion d'honneur, som inte är Hederslegionen."@sv , "La orden misma es fraternalc:orderOfChivalry, o una mbr:Distinction cuando no tiene cuerpo de miembros. Ejemplo: la Société des membres de la Légion d'honneur, que no es la Legión de Honor."@es , "A própria ordem é fraternalc:orderOfChivalry, ou uma mbr:Distinction quando não tem corpo de membros. Exemplo: a Société des membres de la Légion d'honneur, que não é a Legião de Honra."@pt .

mbrc:charitableSociety a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Charitable Society"@en , "Välgörenhetssällskap"@sv , "Société de bienfaisance"@fr , "Wohltätigkeitsgesellschaft"@de , "Società di beneficenza"@it , "Sociedad benéfica"@es , "Sociedade de beneficência"@pt ;
    skos:definition "A society whose main purpose is charity."@en ,
                    "Ett sällskap vars huvudsyfte är välgörenhet."@sv ,
                    "Société dont le but principal est la bienfaisance."@fr ,
                    "Eine Gesellschaft, deren Hauptzweck die Wohltätigkeit ist."@de ,
                    "Una società il cui scopo principale è la beneficenza."@it ,
                    "Una sociedad cuyo fin principal es la beneficencia."@es ,
                    "Uma sociedade cujo fim principal é a beneficência."@pt .

mbrc:studentNation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Student Nation"@en , "Studentnation"@sv , "Nation étudiante"@fr , "Studentennation"@de , "Nazione studentesca"@it , "Nación estudiantil"@es , "Nação estudantil"@pt ;
    skos:definition "A student organisation at a university, traditionally based on the students' home region, as at Uppsala and Lund."@en ,
                    "En studentorganisation vid ett universitet, traditionellt grundad på studenternas hembygd, som i Uppsala och Lund."@sv ,
                    "Organisation étudiante d'une université, fondée traditionnellement sur la région d'origine des étudiants, comme à Uppsala et à Lund."@fr ,
                    "Eine studentische Organisation an einer Universität, traditionell nach der Herkunftsregion der Studierenden gebildet, wie in Uppsala und Lund."@de ,
                    "Un'organizzazione studentesca di un'università, tradizionalmente fondata sulla regione di origine degli studenti, come a Uppsala e a Lund."@it ,
                    "Una organización estudiantil de una universidad, tradicionalmente basada en la región de origen de los estudiantes, como en Uppsala y Lund."@es ,
                    "Uma organização estudantil de uma universidade, tradicionalmente baseada na região de origem dos estudantes, como em Uppsala e Lund."@pt .

mbrc:studentSociety a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Student Society"@en , "Studentförening"@sv , "Association d'étudiants"@fr , "Studentische Vereinigung"@de , "Associazione studentesca"@it , "Sociedad estudiantil"@es , "Sociedade estudantil"@pt ;
    skos:definition "A society whose members are students or former students."@en ,
                    "En förening vars medlemmar är studenter eller före detta studenter."@sv ,
                    "Société dont les membres sont des étudiants ou d'anciens étudiants."@fr ,
                    "Eine Gesellschaft, deren Mitglieder Studierende oder ehemalige Studierende sind."@de ,
                    "Una società i cui soci sono studenti o ex studenti."@it ,
                    "Una sociedad cuyos miembros son estudiantes o antiguos estudiantes."@es ,
                    "Uma sociedade cujos membros são estudantes ou antigos estudantes."@pt .

mbrc:guild a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Guild"@en , "Skrå"@sv , "Corporazione di mestiere"@it , "Corporation de métier"@fr , "Zunft"@de , "Gremio"@es , "Grémio"@pt ;
    skos:altLabel "Arte"@it , "Gille"@sv ;
    skos:definition "An association of the practitioners of one trade or craft in a town, founded to regulate the trade and look after its members: a medieval guild, a livery company, a Zunft, an Italian arte."@en ,
                    "En sammanslutning av utövarna av ett hantverk eller yrke i en stad, bildad för att reglera yrket och ta hand om sina medlemmar: ett medeltida skrå, en livery company, en Zunft, en italiensk arte."@sv ,
                    "Associazione dei praticanti di un mestiere o di un'arte in una città, nata per regolare il mestiere e provvedere ai propri membri: una gilda medievale, una livery company, una Zunft, un'arte italiana."@it ,
                    "Association des praticiens d'un métier ou d'un art dans une ville, fondée pour réglementer le métier et veiller sur ses membres : une guilde médiévale, une livery company, une Zunft, une arte italienne."@fr ,
                    "Ein Zusammenschluss der Ausübenden eines Handwerks oder Gewerbes in einer Stadt, gegründet, um das Gewerbe zu regeln und für seine Mitglieder zu sorgen: eine mittelalterliche Gilde, eine Livery Company, eine Zunft, eine italienische Arte."@de ,
                    "Una asociación de los practicantes de un oficio en una ciudad, fundada para regular el oficio y cuidar de sus miembros: un gremio medieval, una livery company, una Zunft, un arte italiano."@es ,
                    "Uma associação dos praticantes de um ofício numa cidade, fundada para regular o ofício e cuidar dos seus membros: um grémio medieval, uma livery company, uma Zunft, uma arte italiana."@pt ;
    skos:scopeNote "A brotherhood that passes a trade on through initiation, ritual and stages of membership is fraternalc:craftBrotherhood. A body that only represents a trade today is a mbrc:professionalClub or a mbrc:tradeUnion, not a guild; use this type for organisations that call themselves guilds or continue a historic one."@en ,
                   "Ett brödraskap som för ett yrke vidare genom initiering, ritual och medlemsstadier är fraternalc:craftBrotherhood. Ett organ som i dag bara företräder ett yrke är en mbrc:professionalClub eller en mbrc:tradeUnion, inte ett skrå; använd typen för organisationer som kallar sig skrå eller för ett historiskt skrå vidare."@sv ,
                   "Una confraternita che trasmette un mestiere con iniziazione, rituale e stadi di appartenenza è fraternalc:craftBrotherhood. Un organismo che oggi si limita a rappresentare un mestiere è un mbrc:professionalClub o un mbrc:tradeUnion, non una corporazione; questo tipo vale per le organizzazioni che si dicono corporazioni o che ne proseguono una storica."@it ,
                   "Une fraternité qui transmet un métier par l'initiation, le rituel et des étapes d'appartenance est un fraternalc:craftBrotherhood. Un organisme qui ne fait aujourd'hui que représenter un métier est un mbrc:professionalClub ou un mbrc:tradeUnion, non une corporation de métier ; ce type vaut pour les organisations qui se disent corporations de métier ou qui en poursuivent une historique."@fr ,
                   "Eine Bruderschaft, die ein Gewerbe durch Aufnahme, Ritual und Mitgliedschaftsstufen weitergibt, ist fraternalc:craftBrotherhood. Eine Einrichtung, die heute nur ein Gewerbe vertritt, ist ein mbrc:professionalClub oder eine mbrc:tradeUnion, keine Zunft; dieser Typ gilt für Organisationen, die sich Zunft oder Gilde nennen oder eine historische fortführen."@de ,
                   "Una hermandad que transmite un oficio mediante iniciación, ritual y etapas de pertenencia es fraternalc:craftBrotherhood. Un organismo que hoy solo representa un oficio es un mbrc:professionalClub o un mbrc:tradeUnion, no un gremio; este tipo se usa para organizaciones que se llaman gremios o continúan uno histórico."@es ,
                   "Uma irmandade que transmite um ofício através de iniciação, ritual e etapas de filiação é fraternalc:craftBrotherhood. Um organismo que hoje apenas representa um ofício é um mbrc:professionalClub ou um mbrc:tradeUnion, não um grémio; este tipo usa-se para organizações que se chamam grémios ou continuam um histórico."@pt .

mbrc:contrada a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Contrada"@en , "Contrada"@sv , "Contrada"@it , "Contrada"@fr , "Contrada"@de , "Contrada"@es , "Contrada"@pt ;
    skos:altLabel "Neighbourhood society"@en , "Kvartersförening"@sv ;
    skos:definition "A society tied to a district of a town, whose members, the contradaioli, belong to it from birth or baptism and which carries its district's colours and traditions into a civic festival, as the seventeen contrade of Siena do in the Palio."@en ,
                    "Ett sällskap knutet till en stadsdel, vars medlemmar, contradaioli, hör till det från födseln eller dopet och som för sin stadsdels färger och traditioner in i en stadsfest, som Sienas sjutton contrade gör i Palio."@sv ,
                    "Società legata a un rione della città, i cui membri, i contradaioli, ne fanno parte dalla nascita o dal battesimo e che porta i colori e le tradizioni del proprio rione in una festa civica, come le diciassette contrade di Siena nel Palio."@it ,
                    "Société liée à un quartier d'une ville, dont les membres, les contradaioli, lui appartiennent dès la naissance ou le baptême et qui porte les couleurs et les traditions de son quartier dans une fête civique, comme les dix-sept contrade de Sienne dans le Palio."@fr ,
                    "Eine an einen Stadtteil gebundene Gesellschaft, deren Mitglieder, die Contradaioli, ihr von Geburt oder Taufe an angehören und die die Farben und Traditionen ihres Stadtteils in ein Stadtfest trägt, wie die siebzehn Contrade von Siena beim Palio."@de ,
                    "Una sociedad ligada a un barrio de una ciudad, cuyos miembros, los contradaioli, pertenecen a ella desde el nacimiento o el bautismo y que lleva los colores y tradiciones de su barrio a una fiesta cívica, como hacen las diecisiete contrade de Siena en el Palio."@es ,
                    "Uma sociedade ligada a um bairro de uma cidade, cujos membros, os contradaioli, pertencem a ela desde o nascimento ou o batismo e que leva as cores e tradições do seu bairro a uma festa cívica, como fazem as dezassete contrade de Siena no Palio."@pt ;
    skos:scopeNote "Membership by birth and baptism has no value of its own in mbrc:AdmissionModes; the closest is mbrc:hereditary. The head of a contrada, the priore, is recorded as mbrc:president with the local title as label; the capitano, who leads the contrada in the contest, is a local office."@en ,
                   "Medlemskap genom födelse och dop har inget eget värde i mbrc:AdmissionModes; närmast är mbrc:hereditary. En contradas chef, priore, anges som mbrc:president med den lokala titeln som etikett; capitano, som leder contradan i tävlingen, är ett lokalt ämbete."@sv ,
                   "L'appartenenza per nascita e battesimo non ha un valore proprio in mbrc:AdmissionModes; il più vicino è mbrc:hereditary. Il capo di una contrada, il priore, si registra come mbrc:president con il titolo locale come etichetta; il capitano, che guida la contrada nella gara, è un ufficio locale."@it ,
                   "L'appartenance par la naissance et le baptême n'a pas de valeur propre dans mbrc:AdmissionModes ; le plus proche est mbrc:hereditary. Le chef d'une contrada, le priore, est consigné comme mbrc:president avec le titre local pour libellé ; le capitano, qui conduit la contrada dans la course, est une fonction locale."@fr ,
                   "Die Mitgliedschaft durch Geburt und Taufe hat in mbrc:AdmissionModes keinen eigenen Wert; am nächsten liegt mbrc:hereditary. Das Oberhaupt einer Contrada, der Priore, wird als mbrc:president mit dem örtlichen Titel als Bezeichnung erfasst; der Capitano, der die Contrada im Wettkampf führt, ist ein örtliches Amt."@de ,
                   "La pertenencia por nacimiento y bautismo no tiene valor propio en mbrc:AdmissionModes; el más próximo es mbrc:hereditary. El jefe de una contrada, el priore, se registra como mbrc:president con el título local como etiqueta; el capitano, que dirige la contrada en la competición, es un cargo local."@es ,
                   "A filiação por nascimento e batismo não tem valor próprio em mbrc:AdmissionModes; o mais próximo é mbrc:hereditary. O chefe de uma contrada, o priore, regista-se como mbrc:president com o título local como etiqueta; o capitano, que dirige a contrada na competição, é um cargo local."@pt .

mbrc:fraternalOrganization a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:voluntaryAssociation ;
    skos:prefLabel "Fraternal Organisation"@en , "Ordenssällskap"@sv , "Organisation fraternelle"@fr , "Ordensgesellschaft"@de , "Organizzazione fraternale"@it , "Organización fraternal"@es , "Organização fraternal"@pt ;
    skos:altLabel "Fraternal Order"@en , "brödraskap"@sv , "Ordre fraternel"@fr , "Ordine fraternale"@it ;
    skos:definition "An organisation whose members are bound together by initiation, ritual and usually graded degrees. Refined by the fraternal codelists."@en ,
                    "En organisation vars medlemmar är förenade genom initiering, ritual och vanligen graderade grader. Förfinas av kodlistorna i fraternal."@sv ,
                    "Organisation dont les membres sont liés par l'initiation, le rituel et en général des degrés gradués. Précisée par les listes de codes de fraternal."@fr ,
                    "Eine Organisation, deren Mitglieder durch Initiation, Ritual und meist gestufte Grade verbunden sind. Wird von den Codelisten von fraternal verfeinert."@de ,
                    "Un'organizzazione i cui soci sono legati dall'iniziazione, dal rituale e di solito da gradi successivi. Specificata dalle liste di codici fraternali."@it ,
                    "Una organización cuyos miembros están unidos por la iniciación, el ritual y normalmente grados. Precisada por las listas de códigos fraternales."@es ,
                    "Uma organização cujos membros estão unidos pela iniciação, pelo ritual e normalmente por graus. Precisada pelas listas de códigos fraternais."@pt .

mbrc:politicalParty a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:voluntaryAssociation ;
    skos:prefLabel "Political Party"@en , "Politiskt parti"@sv , "Parti politique"@fr , "Politische Partei"@de , "Partito politico"@it , "Partido político"@es , "Partido político"@pt ;
    skos:definition "An organisation that seeks to influence public policy, usually by nominating candidates in public elections, and that people join as members."@en ,
                    "En organisation som söker påverka den offentliga politiken, vanligen genom att ställa upp kandidater i allmänna val, och som man blir medlem i."@sv ,
                    "Organisation qui cherche à influencer l'action publique, en général en présentant des candidats aux élections publiques, et à laquelle on adhère."@fr ,
                    "Eine Organisation, die Einfluss auf die Politik zu nehmen sucht, meist indem sie Kandidaten für öffentliche Wahlen aufstellt, und der man als Mitglied beitritt."@de ,
                    "Un'organizzazione che cerca di influire sulla politica pubblica, di solito presentando candidati alle elezioni, e a cui le persone aderiscono come soci."@it ,
                    "Una organización que busca influir en la política pública, normalmente presentando candidatos en elecciones públicas, y a la que las personas se afilian como miembros."@es ,
                    "Uma organização que procura influenciar a política pública, normalmente apresentando candidatos em eleições públicas, e a que as pessoas se filiam como membros."@pt ;
    skos:scopeNote "Not the same as mbrc:politicalClub, a private club whose members share a party allegiance. Data about who belongs to a party reveals political opinions: see the scope note on mbr:Membership."@en ,
                   "Inte detsamma som mbrc:politicalClub, en privat klubb vars medlemmar delar partitillhörighet. Uppgifter om vem som tillhör ett parti röjer politiska åsikter: se anmärkningen till mbr:Membership."@sv ,
                   "À ne pas confondre avec mbrc:politicalClub, club privé dont les membres partagent l'appartenance à un parti. Savoir qui appartient à un parti révèle des opinions politiques : voir la note d'application de mbr:Membership."@fr ,
                   "Nicht dasselbe wie mbrc:politicalClub, ein privater Club, dessen Mitglieder einer Partei verbunden sind. Daten darüber, wer einer Partei angehört, offenbaren politische Meinungen: siehe die Anwendungshinweise zu mbr:Membership."@de ,
                   "Non è lo stesso di mbrc:politicalClub, un circolo privato i cui soci condividono l'appartenenza a un partito. I dati su chi appartiene a un partito rivelano opinioni politiche: vedi la nota di ambito di mbr:Membership."@it ,
                   "No es lo mismo que mbrc:politicalClub, un club privado cuyos miembros comparten la adhesión a un partido. Los datos sobre quién pertenece a un partido revelan opiniones políticas: véase la nota de alcance de mbr:Membership."@es ,
                   "Não é o mesmo que mbrc:politicalClub, um clube privado cujos membros partilham a adesão a um partido. Os dados sobre quem pertence a um partido revelam opiniões políticas: ver a nota de âmbito de mbr:Membership."@pt .

mbrc:tradeUnion a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:voluntaryAssociation ;
    skos:prefLabel "Trade Union"@en , "Fackförening"@sv , "Syndicat"@fr , "Gewerkschaft"@de , "Sindacato"@it , "Sindicato"@es , "Sindicato"@pt ;
    skos:altLabel "Labour Union"@en , "Labor Union"@en-US , "Fackförbund"@sv , "Syndicat de salariés"@fr , "Organizzazione sindacale"@it ;
    skos:definition "An organisation of employees that represents its members' interests towards employers, for example in collective bargaining."@en ,
                    "En organisation av arbetstagare som företräder medlemmarnas intressen gentemot arbetsgivare, t.ex. i förhandlingar om kollektivavtal."@sv ,
                    "Organisation de salariés qui défend les intérêts de ses membres face aux employeurs, par exemple dans les négociations collectives."@fr ,
                    "Eine Organisation von Arbeitnehmern, die die Interessen ihrer Mitglieder gegenüber Arbeitgebern vertritt, etwa in Tarifverhandlungen."@de ,
                    "Un'organizzazione di lavoratori dipendenti che rappresenta gli interessi dei propri iscritti verso i datori di lavoro, per esempio nella contrattazione collettiva."@it ,
                    "Una organización de trabajadores que representa los intereses de sus miembros ante los empleadores, por ejemplo en la negociación colectiva."@es ,
                    "Uma organização de trabalhadores que representa os interesses dos seus membros perante os empregadores, por exemplo na negociação coletiva."@pt ;
    skos:scopeNote "Trade union membership is special-category personal data: see the scope note on mbr:Membership."@en ,
                   "Medlemskap i en fackförening är en känslig personuppgift: se anmärkningen till mbr:Membership."@sv ,
                   "L'adhésion à un syndicat est une donnée personnelle de catégorie particulière : voir la note d'application de mbr:Membership."@fr ,
                   "Die Mitgliedschaft in einer Gewerkschaft gehört zu den besonderen Kategorien personenbezogener Daten: siehe die Anwendungshinweise zu mbr:Membership."@de ,
                   "L'iscrizione a un sindacato è un dato personale di categoria particolare: vedi la nota di ambito di mbr:Membership."@it ,
                   "La afiliación a un sindicato es un dato personal de categoría especial: véase la nota de alcance de mbr:Membership."@es ,
                   "A filiação num sindicato é um dado pessoal de categoria especial: ver a nota de âmbito de mbr:Membership."@pt .

mbrc:federation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:voluntaryAssociation ;
    skos:prefLabel "Federation"@en , "Förbund"@sv , "Fédération"@fr , "Dachverband"@de , "Federazione"@it , "Federación"@es , "Federação"@pt ;
    skos:altLabel "Umbrella Organisation"@en ;
    skos:definition "An association whose members are other associations, which have come together to represent and serve their common interests."@en ,
                    "En förening vars medlemmar är andra föreningar som gått samman för att företräda och tjäna sina gemensamma intressen."@sv ,
                    "Association dont les membres sont d'autres associations, réunies pour représenter et servir leurs intérêts communs."@fr ,
                    "Ein Verein, dessen Mitglieder andere Vereine sind, die sich zusammengeschlossen haben, um ihre gemeinsamen Interessen zu vertreten und zu fördern."@de ,
                    "Un'associazione i cui membri sono altre associazioni, riunite per rappresentare e servire i loro interessi comuni."@it ,
                    "Una asociación cuyos miembros son otras asociaciones, que se han unido para representar y servir sus intereses comunes."@es ,
                    "Uma associação cujos membros são outras associações, que se uniram para representar e servir os seus interesses comuns."@pt .

mbrc:choralSociety a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Choral Society"@en , "Körförening"@sv , "Société chorale"@fr , "Gesangverein"@de , "Società corale"@it , "Sociedad coral"@es , "Sociedade coral"@pt ;
    skos:altLabel "Choir"@en ;
    skos:definition "A society of singers who meet to rehearse and perform choral music, often with social traditions of its own."@en ,
                    "Ett sällskap av sångare som träffas för att öva och framföra körmusik, ofta med egna sociala traditioner."@sv ,
                    "Société de chanteurs qui se réunissent pour répéter et exécuter de la musique chorale, souvent avec des traditions sociales propres."@fr ,
                    "Eine Gesellschaft von Sängern, die sich zum Einüben und Aufführen von Chormusik trifft, oft mit eigenen geselligen Traditionen."@de ,
                    "Una società di cantori che si riunisce per provare ed eseguire musica corale, spesso con proprie tradizioni sociali."@it ,
                    "Una sociedad de cantores que se reúnen para ensayar e interpretar música coral, a menudo con tradiciones sociales propias."@es ,
                    "Uma sociedade de cantores que se reúnem para ensaiar e interpretar música coral, muitas vezes com tradições sociais próprias."@pt .

mbrc:carnivalSociety a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Carnival Society"@en , "Karnevalsförening"@sv , "Société carnavalesque"@fr , "Karnevalsgesellschaft"@de , "Società carnevalesca"@it , "Sociedad de carnaval"@es , "Sociedade de carnaval"@pt ;
    skos:altLabel "Carnival Club"@en ;
    skos:definition "A society that organises and takes part in carnival, with its own offices, costumes and customs."@en ,
                    "Ett sällskap som ordnar och deltar i karnevalen, med egna ämbeten, dräkter och sedvänjor."@sv ,
                    "Société qui organise le carnaval et y prend part, avec ses propres fonctions, costumes et usages."@fr ,
                    "Eine Gesellschaft, die den Karneval veranstaltet und daran teilnimmt, mit eigenen Ämtern, Trachten und Bräuchen."@de ,
                    "Una società che organizza il carnevale e vi partecipa, con proprie cariche, costumi e usanze."@it ,
                    "Una sociedad que organiza el carnaval y participa en él, con sus propios cargos, trajes y costumbres."@es ,
                    "Uma sociedade que organiza o carnaval e participa nele, com os seus próprios cargos, trajes e costumes."@pt .

mbrc:shootingSociety a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:sportsClub ;
    skos:prefLabel "Shooting Society"@en , "Skytteförening"@sv , "Société de tir"@fr , "Schützenverein"@de , "Società di tiro"@it , "Sociedad de tiro"@es , "Sociedade de tiro"@pt ;
    skos:definition "A sports club for shooting, often also with ceremonial dress, a shooting festival and a tradition of its own, as with the guilds and brotherhoods of marksmen."@en ,
                    "En idrottsförening för skytte, ofta också med ceremoniell dräkt, skyttefest och egen tradition, som skyttegillena och skyttebrödraskapen."@sv ,
                    "Club sportif de tir, souvent aussi avec un costume d'apparat, une fête de tir et une tradition propre, comme les compagnies et confréries de tireurs."@fr ,
                    "Ein Sportverein für das Schießen, oft auch mit Festtracht, Schützenfest und eigener Tradition, wie die Schützengilden und Schützenbruderschaften."@de ,
                    "Un club sportivo di tiro, spesso anche con abito di gala, festa del tiro e tradizione propria, come le gilde e le confraternite di tiratori."@it ,
                    "Un club deportivo de tiro, a menudo también con traje de ceremonia, una fiesta de tiro y una tradición propia, como los gremios y hermandades de tiradores."@es ,
                    "Um clube desportivo de tiro, muitas vezes também com traje de cerimónia, uma festa de tiro e uma tradição própria, como os grémios e irmandades de atiradores."@pt .

mbrc:veteransAssociation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationTypes ; skos:broader mbrc:society ;
    skos:prefLabel "Veterans' Association"@en , "Veteranförening"@sv , "Association d'anciens combattants"@fr , "Veteranenverein"@de , "Associazione di veterani"@it , "Asociación de veteranos"@es , "Associação de veteranos"@pt ;
    skos:definition "An association of people who have served in the armed forces or in a war, for comradeship and remembrance."@en ,
                    "En förening för personer som tjänstgjort i de väpnade styrkorna eller deltagit i ett krig, för kamratskap och minne."@sv ,
                    "Association de personnes qui ont servi dans les forces armées ou dans une guerre, pour la camaraderie et le souvenir."@fr ,
                    "Eine Vereinigung von Personen, die in den Streitkräften oder in einem Krieg gedient haben, zur Kameradschaft und zum Gedenken."@de ,
                    "Un'associazione di persone che hanno prestato servizio nelle forze armate o in una guerra, per il cameratismo e il ricordo."@it ,
                    "Una asociación de personas que han servido en las fuerzas armadas o en una guerra, por camaradería y memoria."@es ,
                    "Uma associação de pessoas que serviram nas forças armadas ou numa guerra, por camaradagem e memória."@pt .

##############################################################################
# 2. MEMBERSHIP STATUSES
##############################################################################

mbrc:MembershipStatuses a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Membership Statuses"@en , "Medlemskapsstatusar"@sv , "Statuts d'adhésion"@fr , "Mitgliedschaftsstatus"@de , "Stati dell'appartenenza"@it , "Estados de la pertenencia"@es , "Estados da filiação"@pt ;
    skos:definition "Stages in the life of a membership, from being considered to leaving."@en ,
                    "Stadier i ett medlemskaps livscykel, från att vara påtänkt till utträde."@sv ,
                    "Étapes de la vie d'une adhésion, de la prise en considération au départ."@fr ,
                    "Abschnitte im Leben einer Mitgliedschaft, von der Erwägung bis zum Ausscheiden."@de ,
                    "Fasi nella vita di un'appartenenza, dall'essere preso in considerazione all'uscita."@it ,
                    "Etapas en la vida de una pertenencia, desde que se considera hasta que se abandona."@es ,
                    "Etapas na vida de uma filiação, desde que é considerada até ao abandono."@pt ;
    skos:hasTopConcept mbrc:prospect , mbrc:proposed , mbrc:candidate , mbrc:elected ,
                       mbrc:notAdmitted , mbrc:active , mbrc:dormant , mbrc:suspended ,
                       mbrc:resigned , mbrc:lapsed , mbrc:expelled , mbrc:deceased ,
                       mbrc:emeritus ,
                       mbrc:inArrears , mbrc:transferred .

mbrc:prospect a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Prospect"@en , "Påtänkt"@sv , "Personne envisagée"@fr , "Interessent"@de , "Aspirante"@it , "Posible candidato"@es , "Possível candidato"@pt ;
    skos:definition "Being considered for membership; not yet formally proposed."@en ,
                    "Påtänkt för medlemskap men ännu inte formellt föreslagen."@sv ,
                    "Envisagée pour l'adhésion ; pas encore formellement proposée."@fr ,
                    "Wird für die Mitgliedschaft in Betracht gezogen; noch nicht förmlich vorgeschlagen."@de ,
                    "Preso in considerazione per l'appartenenza; non ancora proposto formalmente."@it ,
                    "Se está considerando para la pertenencia; aún no ha sido propuesto formalmente."@es ,
                    "Está a ser considerado para a filiação; ainda não foi formalmente proposto."@pt .

mbrc:proposed a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Proposed"@en , "Föreslagen"@sv , "Proposé"@fr , "Vorgeschlagen"@de , "Proposto"@it , "Propuesto"@es , "Proposto"@pt ;
    skos:definition "Formally proposed for membership by a member."@en ,
                    "Formellt föreslagen till medlemskap av en medlem."@sv ,
                    "Formellement proposé à l'adhésion par un membre."@fr ,
                    "Von einem Mitglied förmlich für die Mitgliedschaft vorgeschlagen."@de ,
                    "Proposto formalmente da un socio per l'appartenenza."@it ,
                    "Propuesto formalmente para la pertenencia por un miembro."@es ,
                    "Proposto formalmente para a filiação por um membro."@pt .

mbrc:candidate a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Candidate"@en , "Kandidat"@sv , "Candidat"@fr , "Kandidat"@de , "Candidato"@it , "Candidato"@es , "Candidato"@pt ;
    skos:altLabel "Applicant"@en , "Sökande"@sv , "Postulant"@fr , "Richiedente"@it ;
    skos:definition "Accepted as a candidate, or has applied, and awaiting election, an admission decision or initiation."@en ,
                    "Antagen som kandidat, eller har ansökt, och i väntan på val, beslut om upptagning eller initiering."@sv ,
                    "Accepté comme candidat, ou ayant fait une demande, dans l'attente d'une élection, d'une décision d'admission ou d'une initiation."@fr ,
                    "Als Kandidat angenommen oder hat sich beworben und erwartet Wahl, Aufnahmeentscheidung oder Initiation."@de ,
                    "Accettato come candidato, o ha presentato domanda, e attende l'elezione, una decisione di ammissione o l'iniziazione."@it ,
                    "Aceptado como candidato, o ha presentado solicitud, y a la espera de elección, de una decisión de admisión o de iniciación."@es ,
                    "Aceite como candidato, ou apresentou pedido, e à espera de eleição, de uma decisão de admissão ou de iniciação."@pt .

mbrc:elected a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Elected"@en , "Invald"@sv , "Élu"@fr , "Gewählt"@de , "Eletto"@it , "Elegido"@es , "Eleito"@pt ;
    skos:definition "Elected to membership but not yet admitted."@en ,
                    "Invald men ännu inte upptagen."@sv ,
                    "Élu à l'adhésion mais pas encore admis."@fr ,
                    "In die Mitgliedschaft gewählt, aber noch nicht aufgenommen."@de ,
                    "Eletto all'appartenenza ma non ancora ammesso."@it ,
                    "Elegido para la pertenencia pero todavía no admitido."@es ,
                    "Eleito para a filiação mas ainda não admitido."@pt .

mbrc:notAdmitted a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Not Admitted"@en , "Ej upptagen"@sv , "Non admis"@fr , "Nicht aufgenommen"@de , "Non ammesso"@it , "No admitido"@es , "Não admitido"@pt ;
    skos:definition "The proposal or application ended without admission: it was rejected, stopped or withdrawn."@en ,
                    "Förslaget eller ansökan avslutades utan upptagning: det avslogs, stoppades eller drogs tillbaka."@sv ,
                    "La proposition ou la demande s'est terminée sans admission : elle a été rejetée, arrêtée ou retirée."@fr ,
                    "Der Vorschlag oder die Bewerbung endete ohne Aufnahme: Sie wurde abgelehnt, gestoppt oder zurückgezogen."@de ,
                    "La proposta o la domanda si è conclusa senza ammissione: è stata respinta, fermata o ritirata."@it ,
                    "La propuesta o la solicitud terminó sin admisión: fue rechazada, detenida o retirada."@es ,
                    "A proposta ou o pedido terminou sem admissão: foi rejeitado, interrompido ou retirado."@pt ;
    skos:scopeNote "Record the organisation's decision as a mbr:MembershipEvent of type mbrc:rejection with mbr:resultingStatus mbrc:notAdmitted."@en ,
                   "Organisationens beslut registreras som en mbr:MembershipEvent av typen mbrc:rejection med mbr:resultingStatus mbrc:notAdmitted."@sv ,
                   "Consigner la décision de l'organisation comme une mbr:MembershipEvent de type mbrc:rejection avec mbr:resultingStatus mbrc:notAdmitted."@fr ,
                   "Die Entscheidung der Organisation als mbr:MembershipEvent der Art mbrc:rejection mit mbr:resultingStatus mbrc:notAdmitted festhalten."@de ,
                   "La decisione dell'organizzazione si registra come mbr:MembershipEvent di tipo mbrc:rejection con mbr:resultingStatus mbrc:notAdmitted."@it ,
                   "La decisión de la organización se registra como un mbr:MembershipEvent de tipo mbrc:rejection con mbr:resultingStatus mbrc:notAdmitted."@es ,
                   "A decisão da organização regista-se como um mbr:MembershipEvent do tipo mbrc:rejection com mbr:resultingStatus mbrc:notAdmitted."@pt .

mbrc:active a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Active Member"@en , "Aktiv medlem"@sv , "Membre actif"@fr , "Aktives Mitglied"@de , "Socio attivo"@it , "Miembro activo"@es , "Membro ativo"@pt ;
    skos:definition "A full member in good standing."@en ,
                    "En fullvärdig medlem med alla rättigheter."@sv ,
                    "Membre à part entière en règle."@fr ,
                    "Ein Vollmitglied in gutem Ansehen."@de ,
                    "Un socio pieno in regola."@it ,
                    "Un miembro de pleno derecho en regla."@es ,
                    "Um membro de pleno direito em situação regular."@pt .

mbrc:dormant a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Dormant Member"@en , "Vilande medlem"@sv , "Membre en sommeil"@fr , "Ruhendes Mitglied"@de , "Socio dormiente"@it , "Miembro en excedencia"@es , "Membro em licença"@pt ;
    skos:definition "A member who has, by agreement, paused participation."@en ,
                    "En medlem som efter överenskommelse gjort uppehåll i deltagandet."@sv ,
                    "Membre qui a, d'un commun accord, suspendu sa participation."@fr ,
                    "Ein Mitglied, das die Teilnahme einvernehmlich ausgesetzt hat."@de ,
                    "Un socio che ha sospeso la partecipazione per accordo."@it ,
                    "Un miembro que, de común acuerdo, ha suspendido su participación."@es ,
                    "Um membro que, por acordo, suspendeu a sua participação."@pt .

mbrc:suspended a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Suspended"@en , "Avstängd"@sv , "Suspendu"@fr , "Suspendiert"@de , "Sospeso"@it , "Suspendido"@es , "Suspenso"@pt ;
    skos:definition "Temporarily deprived of the rights of membership."@en ,
                    "Tillfälligt fråntagen medlemskapets rättigheter."@sv ,
                    "Provisoirement privé des droits d'adhérent."@fr ,
                    "Vorübergehend der Rechte der Mitgliedschaft beraubt."@de ,
                    "Privato temporaneamente dei diritti di socio."@it ,
                    "Privado temporalmente de los derechos de la pertenencia."@es ,
                    "Privado temporariamente dos direitos da filiação."@pt .

mbrc:resigned a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Resigned"@en , "Utträdd"@sv , "Démissionnaire"@fr , "Ausgetreten"@de , "Dimissionario"@it , "Baja voluntaria"@es , "Demissão"@pt ;
    skos:definition "Left the organisation at their own request."@en ,
                    "Har lämnat organisationen på egen begäran."@sv ,
                    "A quitté l'organisation à sa propre demande."@fr ,
                    "Hat die Organisation auf eigenen Wunsch verlassen."@de ,
                    "Ha lasciato l'organizzazione di propria richiesta."@it ,
                    "Dejó la organización a petición propia."@es ,
                    "Deixou a organização a pedido próprio."@pt .

mbrc:lapsed a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Lapsed"@en , "Avförd"@sv , "Radié pour défaut de paiement"@fr , "Erloschen"@de , "Decaduto"@it , "Caducado"@es , "Caducado"@pt ;
    skos:definition "Membership ended because obligations such as fees were not met."@en ,
                    "Medlemskapet har upphört för att skyldigheter, t.ex. avgifter, inte fullgjorts."@sv ,
                    "L'adhésion a pris fin parce que des obligations comme la cotisation n'ont pas été remplies."@fr ,
                    "Die Mitgliedschaft endete, weil Pflichten wie die Beitragszahlung nicht erfüllt wurden."@de ,
                    "L'appartenenza è finita perché non sono stati rispettati obblighi come il pagamento delle quote."@it ,
                    "La pertenencia terminó porque no se cumplieron obligaciones como el pago de cuotas."@es ,
                    "A filiação terminou porque não se cumpriram obrigações como o pagamento de quotas."@pt .

mbrc:expelled a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Expelled"@en , "Utesluten"@sv , "Exclu"@fr , "Ausgeschlossen"@de , "Espulso"@it , "Expulsado"@es , "Expulso"@pt ;
    skos:definition "Removed from membership by decision of the organisation."@en ,
                    "Skild från medlemskapet genom beslut av organisationen."@sv ,
                    "Retiré de l'organisation par décision de celle-ci."@fr ,
                    "Durch Beschluss der Organisation aus der Mitgliedschaft entfernt."@de ,
                    "Tolto dall'appartenenza per decisione dell'organizzazione."@it ,
                    "Apartado de la pertenencia por decisión de la organización."@es ,
                    "Afastado da filiação por decisão da organização."@pt .

mbrc:deceased a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Deceased"@en , "Avliden"@sv , "Décédé"@fr , "Verstorben"@de , "Defunto"@it , "Fallecido"@es , "Falecido"@pt ;
    skos:definition "Membership ended by the death of the member."@en ,
                    "Medlemskapet har upphört genom medlemmens död."@sv ,
                    "L'adhésion a pris fin par le décès du membre."@fr ,
                    "Die Mitgliedschaft endete mit dem Tod des Mitglieds."@de ,
                    "L'appartenenza è finita con la morte del socio."@it ,
                    "La pertenencia terminó por la muerte del miembro."@es ,
                    "A filiação terminou com a morte do membro."@pt .

mbrc:emeritus a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Emeritus"@en , "Emeritus"@sv , "Émérite"@fr , "Emeritus"@de , "Emerito"@it , "Emérito"@es , "Emérito"@pt ;
    skos:definition "A retired member who keeps an honoured standing."@en ,
                    "En medlem som dragit sig tillbaka men behåller en hedrad ställning."@sv ,
                    "Membre retiré qui garde un rang honorifique."@fr ,
                    "Ein im Ruhestand befindliches Mitglied, das ein ehrenvolles Ansehen behält."@de ,
                    "Un socio in pensione che conserva una posizione onorata."@it ,
                    "Un miembro retirado que conserva una posición honrosa."@es ,
                    "Um membro reformado que conserva uma posição honrosa."@pt .

mbrc:inArrears a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "In Arrears"@en , "Med obetalda avgifter"@sv , "En retard de cotisation"@fr , "Im Beitragsrückstand"@de , "Moroso"@it , "Con cuotas atrasadas"@es , "Com quotas em atraso"@pt ;
    skos:definition "A member who has not paid the fees that are due, but whose membership has not yet lapsed."@en ,
                    "En medlem som inte betalat förfallna avgifter, men vars medlemskap ännu inte upphört."@sv ,
                    "Membre qui n'a pas payé les cotisations échues, mais dont l'adhésion n'a pas encore pris fin."@fr ,
                    "Ein Mitglied, das fällige Beiträge nicht bezahlt hat, dessen Mitgliedschaft aber noch nicht erloschen ist."@de ,
                    "Un socio che non ha pagato le quote dovute, ma la cui appartenenza non è ancora decaduta."@it ,
                    "Un miembro que no ha pagado las cuotas debidas, pero cuya pertenencia aún no ha caducado."@es ,
                    "Um membro que não pagou as quotas devidas, mas cuja filiação ainda não caducou."@pt .

mbrc:transferred a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipStatuses ; skos:topConceptOf mbrc:MembershipStatuses ;
    skos:prefLabel "Transferred"@en , "Överförd"@sv , "Transféré"@fr , "Übergetreten"@de , "Trasferito"@it , "Trasladado"@es , "Transferido"@pt ;
    skos:definition "A member who has moved to another branch or lodge of the same organisation and so no longer belongs to this one."@en ,
                    "En medlem som flyttat till en annan gren eller loge inom samma organisation och därför inte längre tillhör denna."@sv ,
                    "Membre passé à une autre section ou loge de la même organisation et n'appartenant donc plus à celle-ci."@fr ,
                    "Ein Mitglied, das in eine andere Gliederung oder Loge derselben Organisation gewechselt ist und deshalb dieser nicht mehr angehört."@de ,
                    "Un socio passato a un'altra sezione o loggia della stessa organizzazione e che perciò non appartiene più a questa."@it ,
                    "Un miembro que se ha pasado a otra sección o logia de la misma organización y por tanto ya no pertenece a esta."@es ,
                    "Um membro que passou para outra secção ou loja da mesma organização e, por isso, já não pertence a esta."@pt .

##############################################################################
# 3. MEMBERSHIP CATEGORIES
##############################################################################

mbrc:MembershipCategories a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Membership Categories"@en , "Medlemskategorier"@sv , "Catégories de membres"@fr , "Mitgliedschaftskategorien"@de , "Categorie di soci"@it , "Categorías de pertenencia"@es , "Categorias de filiação"@pt ;
    skos:definition "Categories of membership with different rights or fees."@en ,
                    "Medlemskategorier med olika rättigheter eller avgifter."@sv ,
                    "Catégories d'adhésion aux droits ou cotisations différents."@fr ,
                    "Kategorien der Mitgliedschaft mit unterschiedlichen Rechten oder Beiträgen."@de ,
                    "Categorie di appartenenza con diritti o quote diversi."@it ,
                    "Categorías de pertenencia con distintos derechos o cuotas."@es ,
                    "Categorias de filiação com direitos ou quotas diferentes."@pt ;
    skos:scopeNote "The categories can be combined: a membership may be both life and founding, or junior and overseas. They are grouped in eight sub-schemes by what they say (mbrc:CategoryRights, mbrc:CategoryDuration, mbrc:CategoryHonour, mbrc:CategoryAge, mbrc:CategoryResidence, mbrc:CategoryAffiliation, mbrc:CategoryFoundation, mbrc:CategoryContribution); every category is also in this scheme. The list is open, not an exhaustive division, and a membership without a category is not thereby ordinary. No combination is ruled out unless a category's definition says so."@en ,
                   "Kategorierna kan kombineras: ett medlemskap kan vara både ständigt och stiftande, eller junior och utlands-. De är grupperade i åtta underscheman efter vad de anger (mbrc:CategoryRights, mbrc:CategoryDuration, mbrc:CategoryHonour, mbrc:CategoryAge, mbrc:CategoryResidence, mbrc:CategoryAffiliation, mbrc:CategoryFoundation, mbrc:CategoryContribution); varje kategori finns också i detta schema. Listan är öppen och inte en uttömmande indelning, och ett medlemskap utan kategori är inte därmed ordinarie. Ingen kombination är utesluten om inte en kategoris definition säger det."@sv ,
                   "Les catégories peuvent se combiner : une adhésion peut être à la fois à vie et fondatrice, ou junior et résidant à l'étranger. Elles sont regroupées en huit sous-schémas selon ce qu'elles disent (mbrc:CategoryRights, mbrc:CategoryDuration, mbrc:CategoryHonour, mbrc:CategoryAge, mbrc:CategoryResidence, mbrc:CategoryAffiliation, mbrc:CategoryFoundation, mbrc:CategoryContribution) ; chaque catégorie figure aussi dans ce schéma. La liste est ouverte, non une répartition exhaustive, et une adhésion sans catégorie n'est pas pour autant ordinaire. Aucune combinaison n'est exclue, sauf si la définition d'une catégorie le dit."@fr ,
                   "Die Kategorien lassen sich kombinieren: Eine Mitgliedschaft kann zugleich auf Lebenszeit und Gründungsmitgliedschaft sein, oder jugendlich und im Ausland. Sie sind in acht Unterschemata danach gruppiert, was sie aussagen (mbrc:CategoryRights, mbrc:CategoryDuration, mbrc:CategoryHonour, mbrc:CategoryAge, mbrc:CategoryResidence, mbrc:CategoryAffiliation, mbrc:CategoryFoundation, mbrc:CategoryContribution); jede Kategorie gehört auch zu diesem Schema. Die Liste ist offen, keine erschöpfende Einteilung, und eine Mitgliedschaft ohne Kategorie ist dadurch nicht gewöhnlich. Keine Kombination ist ausgeschlossen, es sei denn, die Definition einer Kategorie sagt es."@de ,
                   "Le categorie si possono combinare: un'appartenenza può essere insieme a vita e fondatore, o giovane e d'oltremare. Sono raggruppate in otto sottoschemi secondo ciò che dicono (mbrc:CategoryRights, mbrc:CategoryDuration, mbrc:CategoryHonour, mbrc:CategoryAge, mbrc:CategoryResidence, mbrc:CategoryAffiliation, mbrc:CategoryFoundation, mbrc:CategoryContribution); ogni categoria è anche in questo schema. L'elenco è aperto, non una ripartizione esaustiva, e un'appartenenza senza categoria non è per questo ordinaria. Nessuna combinazione è esclusa, a meno che la definizione di una categoria non lo dica."@it ,
                   "Las categorías pueden combinarse: una pertenencia puede ser a la vez vitalicia y fundadora, o juvenil y de ultramar. Se agrupan en ocho subesquemas por lo que dicen (mbrc:CategoryRights, mbrc:CategoryDuration, mbrc:CategoryHonour, mbrc:CategoryAge, mbrc:CategoryResidence, mbrc:CategoryAffiliation, mbrc:CategoryFoundation, mbrc:CategoryContribution); cada categoría está también en este esquema. La lista es abierta, no una división exhaustiva, y una pertenencia sin categoría no es por ello ordinaria. No se excluye ninguna combinación salvo que lo diga la definición de una categoría."@es ,
                   "As categorias podem combinar-se: uma filiação pode ser ao mesmo tempo vitalícia e fundadora, ou juvenil e de além-mar. Agrupam-se em oito subesquemas pelo que dizem (mbrc:CategoryRights, mbrc:CategoryDuration, mbrc:CategoryHonour, mbrc:CategoryAge, mbrc:CategoryResidence, mbrc:CategoryAffiliation, mbrc:CategoryFoundation, mbrc:CategoryContribution); cada categoria está também neste esquema. A lista é aberta, não uma divisão exaustiva, e uma filiação sem categoria não é por isso ordinária. Nenhuma combinação é excluída, a não ser que a definição de uma categoria o diga."@pt ;
    skos:hasTopConcept mbrc:ordinary , mbrc:life , mbrc:honorary , mbrc:associate ,
                       mbrc:junior , mbrc:nonResident , mbrc:overseas , mbrc:partnerMember ,
                       mbrc:founding , mbrc:benefactorMember ,
                       mbrc:correspondingMember , mbrc:foreignMember , mbrc:familyMember .

mbrc:ordinary a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories , mbrc:CategoryRights ; skos:topConceptOf mbrc:MembershipCategories , mbrc:CategoryRights ;
    skos:prefLabel "Ordinary Member"@en , "Ordinarie medlem"@sv , "Membre ordinaire"@fr , "Ordentliches Mitglied"@de , "Socio ordinario"@it , "Miembro ordinario"@es , "Membro ordinário"@pt ;
    skos:definition "The standard category with full rights."@en , "Standardkategorin med fulla rättigheter."@sv , "La catégorie normale, avec tous les droits."@fr , "Die Standardkategorie mit allen Rechten."@de , "La categoria normale con tutti i diritti."@it , "La categoría habitual, con todos los derechos."@es , "A categoria habitual, com todos os direitos."@pt .

mbrc:life a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories , mbrc:CategoryDuration ; skos:topConceptOf mbrc:MembershipCategories , mbrc:CategoryDuration ;
    skos:prefLabel "Life Member"@en , "Ständig medlem"@sv , "Membre à vie"@fr , "Mitglied auf Lebenszeit"@de , "Socio a vita"@it , "Miembro vitalicio"@es , "Membro vitalício"@pt ;
    skos:definition "Membership for life, usually after a one-time fee."@en , "Medlemskap på livstid, vanligen efter en engångsavgift."@sv , "Adhésion à vie, en général après une cotisation unique."@fr , "Mitgliedschaft auf Lebenszeit, meist nach einer einmaligen Gebühr."@de , "Appartenenza per la vita, di solito dopo una quota una tantum."@it , "Pertenencia de por vida, normalmente tras el pago de una cuota única."@es , "Filiação para toda a vida, normalmente após o pagamento de uma quota única."@pt .

mbrc:honorary a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories , mbrc:CategoryHonour ; skos:topConceptOf mbrc:MembershipCategories , mbrc:CategoryHonour ;
    skos:prefLabel "Honorary Member"@en , "Hedersledamot"@sv , "Membre d'honneur"@fr , "Ehrenmitglied"@de , "Socio onorario"@it , "Miembro honorario"@es , "Membro honorário"@pt ;
    skos:definition "Membership conferred as an honour, usually without fees."@en , "Medlemskap som ges som hedersbetygelse, vanligen utan avgift."@sv , "Adhésion conférée à titre d'honneur, en général sans cotisation."@fr , "Als Ehre verliehene Mitgliedschaft, meist ohne Beiträge."@de , "Appartenenza conferita come onore, di solito senza quote."@it , "Pertenencia concedida como honor, normalmente sin cuotas."@es , "Filiação conferida como honra, normalmente sem quotas."@pt .

mbrc:associate a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories , mbrc:CategoryRights ; skos:topConceptOf mbrc:MembershipCategories , mbrc:CategoryRights ;
    skos:prefLabel "Associate Member"@en , "Associerad medlem"@sv , "Membre associé"@fr , "Außerordentliches Mitglied"@de , "Socio aggregato"@it , "Miembro asociado"@es , "Membro associado"@pt ;
    skos:definition "Membership with limited rights, for example without vote."@en , "Medlemskap med begränsade rättigheter, t.ex. utan rösträtt."@sv , "Adhésion aux droits limités, par exemple sans droit de vote."@fr , "Mitgliedschaft mit eingeschränkten Rechten, zum Beispiel ohne Stimmrecht."@de , "Appartenenza con diritti limitati, per esempio senza voto."@it , "Pertenencia con derechos limitados, por ejemplo sin voto."@es , "Filiação com direitos limitados, por exemplo sem voto."@pt .

mbrc:junior a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories , mbrc:CategoryAge ; skos:topConceptOf mbrc:MembershipCategories , mbrc:CategoryAge ;
    skos:prefLabel "Junior Member"@en , "Juniormedlem"@sv , "Membre junior"@fr , "Jugendmitglied"@de , "Socio giovane"@it , "Miembro juvenil"@es , "Membro juvenil"@pt ;
    skos:definition "Membership for younger members, often at a reduced fee."@en , "Medlemskap för yngre medlemmar, ofta till reducerad avgift."@sv , "Adhésion pour les membres plus jeunes, souvent à cotisation réduite."@fr , "Mitgliedschaft für jüngere Mitglieder, oft mit ermäßigtem Beitrag."@de , "Appartenenza per i soci più giovani, spesso con quota ridotta."@it , "Pertenencia para miembros jóvenes, a menudo con cuota reducida."@es , "Filiação para membros jovens, muitas vezes com quota reduzida."@pt .

mbrc:nonResident a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories , mbrc:CategoryResidence ; skos:topConceptOf mbrc:MembershipCategories , mbrc:CategoryResidence ;
    skos:prefLabel "Country Member"@en , "Landsortsmedlem"@sv , "Membre non résident"@fr , "Auswärtiges Mitglied"@de , "Socio non residente"@it , "Miembro no residente"@es , "Membro não residente"@pt ;
    skos:altLabel "Non-resident Member"@en , "Membre de province"@fr ;
    skos:definition "Membership for members living far from the club's premises."@en , "Medlemskap för medlemmar som bor långt från klubbens lokaler."@sv , "Adhésion pour les membres qui habitent loin des locaux du club."@fr , "Mitgliedschaft für Mitglieder, die weit von den Räumlichkeiten des Clubs entfernt wohnen."@de , "Appartenenza per i soci che vivono lontano dai locali del circolo."@it , "Pertenencia para miembros que viven lejos de los locales del club."@es , "Filiação para membros que vivem longe das instalações do clube."@pt .

mbrc:overseas a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories , mbrc:CategoryResidence ; skos:topConceptOf mbrc:MembershipCategories , mbrc:CategoryResidence ;
    skos:prefLabel "Overseas Member"@en , "Utlandsmedlem"@sv , "Membre à l'étranger"@fr , "Mitglied im Ausland"@de , "Socio d'oltremare"@it , "Miembro de ultramar"@es , "Membro de além-mar"@pt ;
    skos:definition "Membership for members living abroad."@en , "Medlemskap för medlemmar bosatta utomlands."@sv , "Adhésion pour les membres qui résident à l'étranger."@fr , "Mitgliedschaft für Mitglieder, die im Ausland leben."@de , "Appartenenza per i soci che vivono all'estero."@it , "Pertenencia para miembros que viven en el extranjero."@es , "Filiação para membros que vivem no estrangeiro."@pt .

mbrc:partnerMember a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories , mbrc:CategoryAffiliation ; skos:topConceptOf mbrc:MembershipCategories , mbrc:CategoryAffiliation ;
    skos:prefLabel "Partner Member"@en , "Partnermedlem"@sv , "Membre conjoint"@fr , "Partnermitglied"@de , "Socio coniuge o partner"@it , "Miembro acompañante"@es , "Membro acompanhante"@pt ;
    skos:definition "Membership granted to the spouse or partner of a member."@en , "Medlemskap för en medlems make, maka eller partner."@sv , "Adhésion accordée au conjoint ou au partenaire d'un membre."@fr , "Mitgliedschaft, die dem Ehegatten oder Partner eines Mitglieds gewährt wird."@de , "Appartenenza concessa al coniuge o al partner di un socio."@it , "Pertenencia concedida al cónyuge o pareja de un miembro."@es , "Filiação concedida ao cônjuge ou companheiro de um membro."@pt .

mbrc:founding a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories , mbrc:CategoryFoundation ; skos:topConceptOf mbrc:MembershipCategories , mbrc:CategoryFoundation ;
    skos:prefLabel "Founding Member"@en , "Stiftande medlem"@sv , "Membre fondateur"@fr , "Gründungsmitglied"@de , "Socio fondatore"@it , "Miembro fundador"@es , "Membro fundador"@pt ;
    skos:definition "A member who took part in founding the organisation."@en , "En medlem som deltog i organisationens grundande."@sv , "Membre qui a pris part à la fondation de l'organisation."@fr , "Ein Mitglied, das an der Gründung der Organisation beteiligt war."@de , "Un socio che ha preso parte alla fondazione dell'organizzazione."@it , "Un miembro que participó en la fundación de la organización."@es , "Um membro que participou na fundação da organização."@pt .

mbrc:benefactorMember a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories , mbrc:CategoryContribution ; skos:topConceptOf mbrc:MembershipCategories , mbrc:CategoryContribution ;
    skos:prefLabel "Benefactor Member"@en , "Understödjande medlem"@sv , "Membre bienfaiteur"@fr , "Fördermitglied"@de , "Socio sostenitore"@it , "Miembro protector"@es , "Membro benemérito"@pt ;
    skos:altLabel "Supporting Member"@en , "Patron Member"@en , "Gynnare"@sv , "Stödmedlem"@sv , "Socio benefattore"@it ;
    skos:definition "A member who supports the organisation with a contribution above the ordinary fee. Whether the category carries a vote depends on the statutes."@en ,
                    "En medlem som stöder organisationen med ett bidrag utöver den ordinarie avgiften. Om kategorin har rösträtt avgörs av stadgarna."@sv ,
                    "Membre qui soutient l'association par une cotisation supérieure à la cotisation ordinaire. Le droit de vote dépend des statuts."@fr ,
                    "Ein Mitglied, das die Organisation mit einem Beitrag über dem gewöhnlichen Beitrag unterstützt. Ob die Kategorie ein Stimmrecht trägt, hängt von der Satzung ab."@de ,
                    "Un socio che sostiene l'organizzazione con un contributo superiore alla quota ordinaria. Se la categoria dia diritto al voto dipende dallo statuto."@it ,
                    "Un miembro que apoya a la organización con una aportación superior a la cuota ordinaria. Que la categoría tenga voto depende de los estatutos."@es ,
                    "Um membro que apoia a organização com uma contribuição superior à quota ordinária. Se a categoria tem voto depende dos estatutos."@pt .

mbrc:CategoryRights a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:MembershipCategories ;
    skos:prefLabel "Category: Rights"@en , "Kategori: rättigheter"@sv , "Catégorie : droits"@fr , "Kategorie: Rechte"@de , "Categoria: diritti"@it , "Categoría: derechos"@es , "Categoria: direitos"@pt ;
    skos:definition "Categories that say what rights a membership carries. A sub-scheme of mbrc:MembershipCategories: its categories can be combined with those of the other sub-schemes."@en ,
                    "Kategorier som anger vilka rättigheter ett medlemskap ger. Ett underschema till mbrc:MembershipCategories: dess kategorier kan kombineras med de i de andra underschemana."@sv ,
                    "Catégories qui disent quels droits comporte une adhésion. Sous-schéma de mbrc:MembershipCategories : ses catégories peuvent se combiner avec celles des autres sous-schémas."@fr ,
                    "Kategorien, die sagen, welche Rechte eine Mitgliedschaft mit sich bringt. Ein Unterschema von mbrc:MembershipCategories: Seine Kategorien lassen sich mit denen der anderen Unterschemata kombinieren."@de ,
                    "Categorie che dicono quali diritti comporta un'appartenenza. Un sottoschema di mbrc:MembershipCategories: le sue categorie si possono combinare con quelle degli altri sottoschemi."@it ,
                    "Categorías que dicen qué derechos conlleva una pertenencia. Un subesquema de mbrc:MembershipCategories: sus categorías pueden combinarse con las de los demás subesquemas."@es ,
                    "Categorias que dizem que direitos comporta uma filiação. Um subesquema de mbrc:MembershipCategories: as suas categorias podem combinar-se com as dos outros subesquemas."@pt ;
    skos:hasTopConcept mbrc:ordinary , mbrc:associate .

mbrc:CategoryDuration a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:MembershipCategories ;
    skos:prefLabel "Category: Duration"@en , "Kategori: varaktighet"@sv , "Catégorie : durée"@fr , "Kategorie: Dauer"@de , "Categoria: durata"@it , "Categoría: duración"@es , "Categoria: duração"@pt ;
    skos:definition "Categories that say how long a membership lasts. A sub-scheme of mbrc:MembershipCategories: its categories can be combined with those of the other sub-schemes."@en ,
                    "Kategorier som anger hur länge ett medlemskap varar. Ett underschema till mbrc:MembershipCategories: dess kategorier kan kombineras med de i de andra underschemana."@sv ,
                    "Catégories qui disent combien de temps dure une adhésion. Sous-schéma de mbrc:MembershipCategories : ses catégories peuvent se combiner avec celles des autres sous-schémas."@fr ,
                    "Kategorien, die sagen, wie lange eine Mitgliedschaft dauert. Ein Unterschema von mbrc:MembershipCategories: Seine Kategorien lassen sich mit denen der anderen Unterschemata kombinieren."@de ,
                    "Categorie che dicono quanto dura un'appartenenza. Un sottoschema di mbrc:MembershipCategories: le sue categorie si possono combinare con quelle degli altri sottoschemi."@it ,
                    "Categorías que dicen cuánto dura una pertenencia. Un subesquema de mbrc:MembershipCategories: sus categorías pueden combinarse con las de los demás subesquemas."@es ,
                    "Categorias que dizem quanto dura uma filiação. Um subesquema de mbrc:MembershipCategories: as suas categorias podem combinar-se com as dos outros subesquemas."@pt ;
    skos:hasTopConcept mbrc:life .

mbrc:CategoryHonour a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:MembershipCategories ;
    skos:prefLabel "Category: Honour"@en , "Kategori: hedersställning"@sv , "Catégorie : honneur"@fr , "Kategorie: Ehrung"@de , "Categoria: onore"@it , "Categoría: honor"@es , "Categoria: honra"@pt ;
    skos:definition "Categories that say a membership is held as an honour. A sub-scheme of mbrc:MembershipCategories: its categories can be combined with those of the other sub-schemes."@en ,
                    "Kategorier som anger att ett medlemskap innehas som en hedersbetygelse. Ett underschema till mbrc:MembershipCategories: dess kategorier kan kombineras med de i de andra underschemana."@sv ,
                    "Catégories qui disent qu'une adhésion est détenue à titre d'honneur. Sous-schéma de mbrc:MembershipCategories : ses catégories peuvent se combiner avec celles des autres sous-schémas."@fr ,
                    "Kategorien, die sagen, dass eine Mitgliedschaft als Ehre gehalten wird. Ein Unterschema von mbrc:MembershipCategories: Seine Kategorien lassen sich mit denen der anderen Unterschemata kombinieren."@de ,
                    "Categorie che dicono che un'appartenenza è detenuta come onore. Un sottoschema di mbrc:MembershipCategories: le sue categorie si possono combinare con quelle degli altri sottoschemi."@it ,
                    "Categorías que dicen que una pertenencia se ostenta como honor. Un subesquema de mbrc:MembershipCategories: sus categorías pueden combinarse con las de los demás subesquemas."@es ,
                    "Categorias que dizem que uma filiação é detida como honra. Um subesquema de mbrc:MembershipCategories: as suas categorias podem combinar-se com as dos outros subesquemas."@pt ;
    skos:hasTopConcept mbrc:honorary .

mbrc:CategoryAge a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:MembershipCategories ;
    skos:prefLabel "Category: Age"@en , "Kategori: ålder"@sv , "Catégorie : âge"@fr , "Kategorie: Alter"@de , "Categoria: età"@it , "Categoría: edad"@es , "Categoria: idade"@pt ;
    skos:definition "Categories that depend on the age of the member. A sub-scheme of mbrc:MembershipCategories: its categories can be combined with those of the other sub-schemes."@en ,
                    "Kategorier som beror på medlemmens ålder. Ett underschema till mbrc:MembershipCategories: dess kategorier kan kombineras med de i de andra underschemana."@sv ,
                    "Catégories qui dépendent de l'âge du membre. Sous-schéma de mbrc:MembershipCategories : ses catégories peuvent se combiner avec celles des autres sous-schémas."@fr ,
                    "Kategorien, die vom Alter des Mitglieds abhängen. Ein Unterschema von mbrc:MembershipCategories: Seine Kategorien lassen sich mit denen der anderen Unterschemata kombinieren."@de ,
                    "Categorie che dipendono dall'età del socio. Un sottoschema di mbrc:MembershipCategories: le sue categorie si possono combinare con quelle degli altri sottoschemi."@it ,
                    "Categorías que dependen de la edad del miembro. Un subesquema de mbrc:MembershipCategories: sus categorías pueden combinarse con las de los demás subesquemas."@es ,
                    "Categorias que dependem da idade do membro. Um subesquema de mbrc:MembershipCategories: as suas categorias podem combinar-se com as dos outros subesquemas."@pt ;
    skos:hasTopConcept mbrc:junior .

mbrc:CategoryResidence a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:MembershipCategories ;
    skos:prefLabel "Category: Residence"@en , "Kategori: bosättning"@sv , "Catégorie : résidence"@fr , "Kategorie: Wohnsitz"@de , "Categoria: residenza"@it , "Categoría: residencia"@es , "Categoria: residência"@pt ;
    skos:definition "Categories that depend on where the member lives. A sub-scheme of mbrc:MembershipCategories: its categories can be combined with those of the other sub-schemes."@en ,
                    "Kategorier som beror på var medlemmen bor. Ett underschema till mbrc:MembershipCategories: dess kategorier kan kombineras med de i de andra underschemana."@sv ,
                    "Catégories qui dépendent du lieu où vit le membre. Sous-schéma de mbrc:MembershipCategories : ses catégories peuvent se combiner avec celles des autres sous-schémas."@fr ,
                    "Kategorien, die davon abhängen, wo das Mitglied wohnt. Ein Unterschema von mbrc:MembershipCategories: Seine Kategorien lassen sich mit denen der anderen Unterschemata kombinieren."@de ,
                    "Categorie che dipendono da dove vive il socio. Un sottoschema di mbrc:MembershipCategories: le sue categorie si possono combinare con quelle degli altri sottoschemi."@it ,
                    "Categorías que dependen de dónde vive el miembro. Un subesquema de mbrc:MembershipCategories: sus categorías pueden combinarse con las de los demás subesquemas."@es ,
                    "Categorias que dependem de onde vive o membro. Um subesquema de mbrc:MembershipCategories: as suas categorias podem combinar-se com as dos outros subesquemas."@pt ;
    skos:hasTopConcept mbrc:nonResident , mbrc:overseas , mbrc:correspondingMember , mbrc:foreignMember .

mbrc:CategoryAffiliation a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:MembershipCategories ;
    skos:prefLabel "Category: Affiliation"@en , "Kategori: anknytning"@sv , "Catégorie : rattachement"@fr , "Kategorie: Zugehörigkeit"@de , "Categoria: affiliazione"@it , "Categoría: vínculo"@es , "Categoria: vínculo"@pt ;
    skos:definition "Categories that depend on the member's tie to another member. A sub-scheme of mbrc:MembershipCategories: its categories can be combined with those of the other sub-schemes."@en ,
                    "Kategorier som beror på medlemmens anknytning till en annan medlem. Ett underschema till mbrc:MembershipCategories: dess kategorier kan kombineras med de i de andra underschemana."@sv ,
                    "Catégories qui dépendent du lien du membre avec un autre membre. Sous-schéma de mbrc:MembershipCategories : ses catégories peuvent se combiner avec celles des autres sous-schémas."@fr ,
                    "Kategorien, die von der Verbindung des Mitglieds zu einem anderen Mitglied abhängen. Ein Unterschema von mbrc:MembershipCategories: Seine Kategorien lassen sich mit denen der anderen Unterschemata kombinieren."@de ,
                    "Categorie che dipendono dal legame del socio con un altro socio. Un sottoschema di mbrc:MembershipCategories: le sue categorie si possono combinare con quelle degli altri sottoschemi."@it ,
                    "Categorías que dependen del vínculo del miembro con otro miembro. Un subesquema de mbrc:MembershipCategories: sus categorías pueden combinarse con las de los demás subesquemas."@es ,
                    "Categorias que dependem do vínculo do membro com outro membro. Um subesquema de mbrc:MembershipCategories: as suas categorias podem combinar-se com as dos outros subesquemas."@pt ;
    skos:hasTopConcept mbrc:partnerMember , mbrc:familyMember .

mbrc:CategoryFoundation a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:MembershipCategories ;
    skos:prefLabel "Category: Founding"@en , "Kategori: grundande"@sv , "Catégorie : fondation"@fr , "Kategorie: Gründung"@de , "Categoria: fondazione"@it , "Categoría: fundación"@es , "Categoria: fundação"@pt ;
    skos:definition "Categories that say the member took part in founding the organisation. A sub-scheme of mbrc:MembershipCategories: its categories can be combined with those of the other sub-schemes."@en ,
                    "Kategorier som anger att medlemmen deltog i organisationens grundande. Ett underschema till mbrc:MembershipCategories: dess kategorier kan kombineras med de i de andra underschemana."@sv ,
                    "Catégories qui disent que le membre a pris part à la fondation de l'organisation. Sous-schéma de mbrc:MembershipCategories : ses catégories peuvent se combiner avec celles des autres sous-schémas."@fr ,
                    "Kategorien, die sagen, dass das Mitglied an der Gründung der Organisation beteiligt war. Ein Unterschema von mbrc:MembershipCategories: Seine Kategorien lassen sich mit denen der anderen Unterschemata kombinieren."@de ,
                    "Categorie che dicono che il socio ha preso parte alla fondazione dell'organizzazione. Un sottoschema di mbrc:MembershipCategories: le sue categorie si possono combinare con quelle degli altri sottoschemi."@it ,
                    "Categorías que dicen que el miembro participó en la fundación de la organización. Un subesquema de mbrc:MembershipCategories: sus categorías pueden combinarse con las de los demás subesquemas."@es ,
                    "Categorias que dizem que o membro participou na fundação da organização. Um subesquema de mbrc:MembershipCategories: as suas categorias podem combinar-se com as dos outros subesquemas."@pt ;
    skos:hasTopConcept mbrc:founding .

mbrc:CategoryContribution a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:MembershipCategories ;
    skos:prefLabel "Category: Contribution"@en , "Kategori: bidrag"@sv , "Catégorie : contribution"@fr , "Kategorie: Beitrag"@de , "Categoria: contributo"@it , "Categoría: aportación"@es , "Categoria: contribuição"@pt ;
    skos:definition "Categories that say the member supports the organisation with a contribution beyond the ordinary fee. A sub-scheme of mbrc:MembershipCategories: its categories can be combined with those of the other sub-schemes."@en ,
                    "Kategorier som anger att medlemmen stöder organisationen med ett bidrag utöver den ordinarie avgiften. Ett underschema till mbrc:MembershipCategories: dess kategorier kan kombineras med de i de andra underschemana."@sv ,
                    "Catégories qui disent que le membre soutient l'organisation par une contribution supérieure à la cotisation ordinaire. Sous-schéma de mbrc:MembershipCategories : ses catégories peuvent se combiner avec celles des autres sous-schémas."@fr ,
                    "Kategorien, die sagen, dass das Mitglied die Organisation mit einem Beitrag über dem gewöhnlichen Beitrag unterstützt. Ein Unterschema von mbrc:MembershipCategories: Seine Kategorien lassen sich mit denen der anderen Unterschemata kombinieren."@de ,
                    "Categorie che dicono che il socio sostiene l'organizzazione con un contributo superiore alla quota ordinaria. Un sottoschema di mbrc:MembershipCategories: le sue categorie si possono combinare con quelle degli altri sottoschemi."@it ,
                    "Categorías que dicen que el miembro apoya a la organización con una aportación que va más allá de la cuota ordinaria. Un subesquema de mbrc:MembershipCategories: sus categorías pueden combinarse con las de los demás subesquemas."@es ,
                    "Categorias que dizem que o membro apoia a organização com uma contribuição que vai além da quota ordinária. Um subesquema de mbrc:MembershipCategories: as suas categorias podem combinar-se com as dos outros subesquemas."@pt ;
    skos:hasTopConcept mbrc:benefactorMember .

mbrc:correspondingMember a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories , mbrc:CategoryResidence ; skos:topConceptOf mbrc:MembershipCategories , mbrc:CategoryResidence ;
    skos:prefLabel "Corresponding Member"@en , "Korresponderande ledamot"@sv , "Membre correspondant"@fr , "Korrespondierendes Mitglied"@de , "Socio corrispondente"@it , "Miembro correspondiente"@es , "Membro correspondente"@pt ;
    skos:definition "A member elected for ties to the organisation or its field who lives elsewhere and takes part from a distance, as in an academy; usually with limited rights."@en ,
                    "En medlem som valts på grund av band till organisationen eller dess område, som bor på annan ort och deltar på distans, som i en akademi; vanligen med begränsade rättigheter."@sv ,
                    "Membre élu en raison de ses liens avec l'organisation ou son domaine, qui vit ailleurs et participe à distance, comme dans une académie ; en général avec des droits limités."@fr ,
                    "Ein Mitglied, das wegen seiner Verbindung zur Organisation oder zu ihrem Fachgebiet gewählt wurde, anderswo lebt und aus der Ferne teilnimmt, wie in einer Akademie; meist mit eingeschränkten Rechten."@de ,
                    "Un socio eletto per i suoi legami con l'organizzazione o con il suo campo, che vive altrove e partecipa a distanza, come in un'accademia; di solito con diritti limitati."@it ,
                    "Un miembro elegido por sus vínculos con la organización o con su ámbito que vive en otro lugar y participa a distancia, como en una academia; normalmente con derechos limitados."@es ,
                    "Um membro eleito pelos seus laços com a organização ou com o seu âmbito que vive noutro lugar e participa à distância, como numa academia; normalmente com direitos limitados."@pt .

mbrc:foreignMember a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories , mbrc:CategoryResidence ; skos:topConceptOf mbrc:MembershipCategories , mbrc:CategoryResidence ;
    skos:prefLabel "Foreign Member"@en , "Utländsk ledamot"@sv , "Membre étranger"@fr , "Ausländisches Mitglied"@de , "Socio straniero"@it , "Miembro extranjero"@es , "Membro estrangeiro"@pt ;
    skos:definition "A member who is a citizen of another country, elected as an honour, as in an academy."@en ,
                    "En medlem som är medborgare i ett annat land, vald som en hedersbetygelse, som i en akademi."@sv ,
                    "Membre ressortissant d'un autre pays, élu à titre d'honneur, comme dans une académie."@fr ,
                    "Ein Mitglied, das Bürger eines anderen Landes ist und als Ehre gewählt wurde, wie in einer Akademie."@de ,
                    "Un socio cittadino di un altro paese, eletto come onore, come in un'accademia."@it ,
                    "Un miembro que es ciudadano de otro país, elegido como honor, como en una academia."@es ,
                    "Um membro que é cidadão de outro país, eleito como honra, como numa academia."@pt .

mbrc:familyMember a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipCategories , mbrc:CategoryAffiliation ; skos:topConceptOf mbrc:MembershipCategories , mbrc:CategoryAffiliation ;
    skos:prefLabel "Family Member"@en , "Familjemedlem"@sv , "Membre de la famille"@fr , "Familienmitglied"@de , "Socio familiare"@it , "Miembro familiar"@es , "Membro familiar"@pt ;
    skos:definition "Membership for the relatives of a member, often on shared terms and at a reduced fee."@en ,
                    "Medlemskap för en medlems anhöriga, ofta på gemensamma villkor och till reducerad avgift."@sv ,
                    "Adhésion des proches d'un membre, souvent à des conditions communes et à cotisation réduite."@fr ,
                    "Mitgliedschaft für die Angehörigen eines Mitglieds, oft zu gemeinsamen Bedingungen und mit ermäßigtem Beitrag."@de ,
                    "Appartenenza per i familiari di un socio, spesso a condizioni comuni e con quota ridotta."@it ,
                    "Pertenencia para los familiares de un miembro, a menudo en condiciones compartidas y con cuota reducida."@es ,
                    "Filiação para os familiares de um membro, muitas vezes em condições partilhadas e com quota reduzida."@pt .

##############################################################################
# 4. MEMBERSHIP EVENT TYPES
##############################################################################

mbrc:ApplicationStatuses a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Application Statuses"@en , "Ansökningsstatusar"@sv , "Statuts de la demande"@fr , "Antragsstatus"@de , "Stati della domanda"@it , "Estados de la solicitud"@es , "Estados do pedido"@pt ;
    skos:definition "Where a membership application stands, from received to decided. Used with mbr:applicationStatus."@en ,
                    "Hur långt en medlemsansökan har kommit, från mottagen till avgjord. Används med mbr:applicationStatus."@sv ,
                    "L'état d'avancement d'une demande d'adhésion, de la réception à la décision. S'utilise avec mbr:applicationStatus."@fr ,
                    "Der Stand eines Mitgliedschaftsantrags, von eingegangen bis entschieden. Wird mit mbr:applicationStatus verwendet."@de ,
                    "A che punto è una domanda di ammissione, dalla ricezione alla decisione. Si usa con mbr:applicationStatus."@it ,
                    "En qué punto se encuentra una solicitud de ingreso, desde la recepción hasta la decisión. Se usa con mbr:applicationStatus."@es ,
                    "Em que ponto se encontra um pedido de admissão, desde a receção até à decisão. Usa-se com mbr:applicationStatus."@pt ;
    skos:hasTopConcept mbrc:received , mbrc:postedForObjection , mbrc:onBallot , mbrc:deferred ,
                       mbrc:accepted , mbrc:rejected , mbrc:withdrawn .

mbrc:received a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ApplicationStatuses ; skos:topConceptOf mbrc:ApplicationStatuses ;
    skos:prefLabel "Received"@en , "Mottagen"@sv , "Reçue"@fr , "Eingegangen"@de , "Ricevuta"@it , "Recibida"@es , "Recebido"@pt ;
    skos:definition "The application has been received and not yet taken further."@en ,
                    "Ansökan har kommit in och har inte tagits vidare."@sv ,
                    "La demande a été reçue et n'a pas encore été traitée."@fr ,
                    "Der Antrag ist eingegangen und noch nicht weiterbehandelt worden."@de ,
                    "La domanda è stata ricevuta e non è ancora stata trattata."@it ,
                    "La solicitud se ha recibido y aún no se ha tramitado."@es ,
                    "O pedido foi recebido e ainda não foi tratado."@pt .

mbrc:postedForObjection a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ApplicationStatuses ; skos:topConceptOf mbrc:ApplicationStatuses ;
    skos:prefLabel "Posted for Objection"@en , "Anslagen för invändningar"@sv , "Soumise à opposition"@fr , "Zur Einsprache ausgelegt"@de , "Esposta per opposizioni"@it , "Expuesta a oposición"@es , "Afixado para oposição"@pt ;
    skos:definition "The application has been made known to the members for a set period, during which they may object (see mbrc:proposalAndObjectionPeriod)."@en ,
                    "Ansökan har gjorts känd för medlemmarna under en bestämd tid, då de får invända (se mbrc:proposalAndObjectionPeriod)."@sv ,
                    "La demande a été portée à la connaissance des membres pendant un délai fixé, durant lequel ils peuvent s'y opposer (voir mbrc:proposalAndObjectionPeriod)."@fr ,
                    "Der Antrag ist den Mitgliedern für eine bestimmte Frist bekannt gemacht worden, in der sie Einspruch erheben können (siehe mbrc:proposalAndObjectionPeriod)."@de ,
                    "La domanda è stata portata a conoscenza dei soci per un periodo stabilito, durante il quale possono opporsi (vedi mbrc:proposalAndObjectionPeriod)."@it ,
                    "La solicitud se ha dado a conocer a los miembros durante un plazo fijo, en el que pueden oponerse (véase mbrc:proposalAndObjectionPeriod)."@es ,
                    "O pedido foi dado a conhecer aos membros durante um prazo fixo, no qual se podem opor (ver mbrc:proposalAndObjectionPeriod)."@pt .

mbrc:onBallot a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ApplicationStatuses ; skos:topConceptOf mbrc:ApplicationStatuses ;
    skos:prefLabel "On Ballot"@en , "Under ballotering"@sv , "Au scrutin"@fr , "In Abstimmung"@de , "In votazione"@it , "En votación"@es , "Em votação"@pt ;
    skos:definition "The application is being put to a vote by the members (see mbr:Ballot)."@en ,
                    "Ansökan läggs fram för medlemmarnas omröstning (se mbr:Ballot)."@sv ,
                    "La demande est soumise au vote des membres (voir mbr:Ballot)."@fr ,
                    "Der Antrag wird den Mitgliedern zur Abstimmung vorgelegt (siehe mbr:Ballot)."@de ,
                    "La domanda è sottoposta al voto dei soci (vedi mbr:Ballot)."@it ,
                    "La solicitud se somete a la votación de los miembros (véase mbr:Ballot)."@es ,
                    "O pedido está a ser submetido à votação dos membros (ver mbr:Ballot)."@pt .

mbrc:deferred a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ApplicationStatuses ; skos:topConceptOf mbrc:ApplicationStatuses ;
    skos:prefLabel "Deferred"@en , "Uppskjuten"@sv , "Ajournée"@fr , "Zurückgestellt"@de , "Rinviata"@it , "Aplazada"@es , "Adiado"@pt ;
    skos:definition "The decision on the application has been put off to a later meeting or ballot."@en ,
                    "Beslutet om ansökan har skjutits upp till ett senare möte eller en senare omröstning."@sv ,
                    "La décision sur la demande a été reportée à une réunion ou à un scrutin ultérieur."@fr ,
                    "Die Entscheidung über den Antrag ist auf eine spätere Sitzung oder Abstimmung verschoben worden."@de ,
                    "La decisione sulla domanda è stata rinviata a una riunione o a una votazione successiva."@it ,
                    "La decisión sobre la solicitud se ha aplazado a una reunión o votación posterior."@es ,
                    "A decisão sobre o pedido foi adiada para uma reunião ou votação posterior."@pt .

mbrc:accepted a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ApplicationStatuses ; skos:topConceptOf mbrc:ApplicationStatuses ;
    skos:prefLabel "Accepted"@en , "Antagen"@sv , "Acceptée"@fr , "Angenommen"@de , "Accolta"@it , "Aceptada"@es , "Aceite"@pt ;
    skos:definition "The application was granted. The membership it led to is given with mbr:resultingMembership."@en ,
                    "Ansökan bifölls. Det medlemskap den ledde till anges med mbr:resultingMembership."@sv ,
                    "La demande a été accueillie. L'adhésion qui en est issue est indiquée avec mbr:resultingMembership."@fr ,
                    "Der Antrag wurde bewilligt. Die Mitgliedschaft, zu der er geführt hat, wird mit mbr:resultingMembership angegeben."@de ,
                    "La domanda è stata accolta. L'appartenenza a cui ha portato si indica con mbr:resultingMembership."@it ,
                    "La solicitud fue concedida. La pertenencia a la que condujo se indica con mbr:resultingMembership."@es ,
                    "O pedido foi deferido. A filiação a que conduziu indica-se com mbr:resultingMembership."@pt .

mbrc:rejected a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ApplicationStatuses ; skos:topConceptOf mbrc:ApplicationStatuses ;
    skos:prefLabel "Rejected"@en , "Avslagen"@sv , "Rejetée"@fr , "Abgelehnt"@de , "Respinta"@it , "Rechazada"@es , "Rejeitado"@pt ;
    skos:definition "The organisation decided not to admit the applicant, by ballot or otherwise."@en ,
                    "Organisationen beslutade att inte ta upp den sökande, genom ballotering eller på annat sätt."@sv ,
                    "L'organisation a décidé de ne pas admettre le candidat, par scrutin ou autrement."@fr ,
                    "Die Organisation beschloss, den Antragsteller nicht aufzunehmen, durch Abstimmung oder auf andere Weise."@de ,
                    "L'organizzazione ha deciso di non ammettere il richiedente, con una votazione o in altro modo."@it ,
                    "La organización decidió no admitir al solicitante, por votación o de otro modo."@es ,
                    "A organização decidiu não admitir o requerente, por votação ou de outro modo."@pt .

mbrc:withdrawn a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ApplicationStatuses ; skos:topConceptOf mbrc:ApplicationStatuses ;
    skos:prefLabel "Withdrawn"@en , "Återkallad"@sv , "Retirée"@fr , "Zurückgezogen"@de , "Ritirata"@it , "Retirada"@es , "Retirado"@pt ;
    skos:definition "The applicant withdrew the application before it was decided."@en ,
                    "Den sökande drog tillbaka ansökan innan den avgjordes."@sv ,
                    "Le candidat a retiré sa demande avant qu'elle soit tranchée."@fr ,
                    "Der Antragsteller hat den Antrag zurückgezogen, bevor über ihn entschieden wurde."@de ,
                    "Il richiedente ha ritirato la domanda prima che fosse decisa."@it ,
                    "El solicitante retiró la solicitud antes de que se decidiera."@es ,
                    "O requerente retirou o pedido antes de ser decidido."@pt .

mbrc:MembershipEventTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Membership Event Types"@en , "Typer av medlemskapshändelser"@sv , "Types d'événements d'adhésion"@fr , "Arten von Mitgliedschaftsereignissen"@de , "Tipi di evento di appartenenza"@it , "Tipos de evento de pertenencia"@es , "Tipos de evento de filiação"@pt ;
    skos:definition "Kinds of event in the life of a membership, from application and admission to resignation, expulsion and death. Used with mbr:membershipEventType."@en ,
                    "Slag av händelser i ett medlemskaps liv, från ansökan och upptagning till utträde, uteslutning och död. Används med mbr:membershipEventType."@sv ,
                    "Types d'événements dans la vie d'une adhésion, de la candidature et de l'admission à la démission, l'exclusion et le décès. S'utilise avec mbr:membershipEventType."@fr ,
                    "Arten von Ereignissen im Verlauf einer Mitgliedschaft, von Antrag und Aufnahme bis zu Austritt, Ausschluss und Tod. Wird mit mbr:membershipEventType verwendet."@de ,
                    "Tipi di eventi nella vita di un'appartenenza, dalla domanda e dall'ammissione alle dimissioni, all'espulsione e alla morte. Si usa con mbr:membershipEventType."@it ,
                    "Tipos de evento en la vida de una pertenencia, desde la solicitud y la admisión hasta la baja voluntaria, la expulsión y la muerte. Se usa con mbr:membershipEventType."@es ,
                    "Tipos de evento na vida de uma filiação, desde o pedido e a admissão até à demissão, à expulsão e à morte. Usa-se com mbr:membershipEventType."@pt ;
    skos:hasTopConcept mbrc:application , mbrc:proposal , mbrc:objection , mbrc:ballot , mbrc:rejection ,
                       mbrc:admission , mbrc:statusChange , mbrc:resignation , mbrc:lapse ,
                       mbrc:expulsion , mbrc:reinstatement , mbrc:death ,
                       mbrc:suspension , mbrc:transfer , mbrc:officeElection .

mbrc:application a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Application"@en , "Ansökan"@sv , "Demande d'adhésion"@fr , "Antrag"@de , "Domanda"@it , "Solicitud"@es , "Pedido"@pt ;
    skos:definition "Someone applies for membership."@en , "Någon ansöker om medlemskap."@sv , "Quelqu'un demande à adhérer."@fr , "Jemand beantragt die Mitgliedschaft."@de , "Qualcuno chiede di essere ammesso come socio."@it , "Alguien solicita la pertenencia."@es , "Alguém pede a filiação."@pt .

mbrc:proposal a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Proposal"@en , "Förslag"@sv , "Proposition"@fr , "Vorschlag"@de , "Proposta"@it , "Propuesta"@es , "Proposta"@pt ;
    skos:definition "A member proposes a candidate."@en , "En medlem föreslår en kandidat."@sv , "Un membre propose un candidat."@fr , "Ein Mitglied schlägt einen Kandidaten vor."@de , "Un socio propone un candidato."@it , "Un miembro propone a un candidato."@es , "Um membro propõe um candidato."@pt .

mbrc:objection a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Objection"@en , "Invändning"@sv , "Opposition"@fr , "Einspruch"@de , "Opposizione"@it , "Oposición"@es , "Oposição"@pt ;
    skos:definition "A member objects to a proposal or application that has been made known for a set period (see mbrc:proposalAndObjectionPeriod)."@en ,
                    "En medlem invänder mot ett förslag eller en ansökan som gjorts känd under en bestämd tid (se mbrc:proposalAndObjectionPeriod)."@sv ,
                    "Un membre s'oppose à une proposition ou à une demande portée à la connaissance des membres pendant un délai fixé (voir mbrc:proposalAndObjectionPeriod)."@fr ,
                    "Ein Mitglied erhebt Einspruch gegen einen Vorschlag oder Antrag, der für eine bestimmte Frist bekannt gemacht wurde (siehe mbrc:proposalAndObjectionPeriod)."@de ,
                    "Un socio si oppone a una proposta o a una domanda portata a conoscenza dei soci per un periodo stabilito (vedi mbrc:proposalAndObjectionPeriod)."@it ,
                    "Un miembro se opone a una propuesta o solicitud que se ha dado a conocer durante un plazo fijo (véase mbrc:proposalAndObjectionPeriod)."@es ,
                    "Um membro opõe-se a uma proposta ou pedido que foi dado a conhecer durante um prazo fixo (ver mbrc:proposalAndObjectionPeriod)."@pt ;
    skos:scopeNote "Whether the objection stops the proposal is for the organisation to decide. A proposal that is stopped is recorded as a mbrc:rejection."@en ,
                   "Om invändningen stoppar förslaget avgör organisationen. Ett förslag som stoppas registreras som en mbrc:rejection."@sv ,
                   "C'est à l'organisation de décider si l'opposition arrête la proposition. Une proposition arrêtée est consignée comme une mbrc:rejection."@fr ,
                   "Ob der Einspruch den Vorschlag stoppt, entscheidet die Organisation. Ein gestoppter Vorschlag wird als mbrc:rejection festgehalten."@de ,
                   "Spetta all'organizzazione decidere se l'opposizione ferma la proposta. Una proposta fermata si registra come mbrc:rejection."@it ,
                   "Que la oposición detenga la propuesta lo decide la organización. Una propuesta que se detiene se registra como mbrc:rejection."@es ,
                   "Se a oposição trava a proposta decide-o a organização. Uma proposta que é travada regista-se como mbrc:rejection."@pt .

mbrc:ballot a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Ballot"@en , "Ballotering"@sv , "Scrutin"@fr , "Abstimmung"@de , "Votazione"@it , "Votación"@es , "Votação"@pt ;
    skos:definition "The members vote on a candidate."@en , "Medlemmarna röstar om en kandidat."@sv , "Les membres votent sur un candidat."@fr , "Die Mitglieder stimmen über einen Kandidaten ab."@de , "I soci votano su un candidato."@it , "Los miembros votan sobre un candidato."@es , "Os membros votam num candidato."@pt .

mbrc:rejection a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Rejection"@en , "Avslag"@sv , "Rejet"@fr , "Ablehnung"@de , "Rigetto"@it , "Rechazo"@es , "Rejeição"@pt ;
    skos:definition "The organisation decides not to go ahead with a proposal or application, by ballot or otherwise. The resulting status is mbrc:notAdmitted."@en ,
                    "Organisationen beslutar att inte gå vidare med ett förslag eller en ansökan, genom ballotering eller på annat sätt. Den nya statusen blir mbrc:notAdmitted."@sv ,
                    "L'organisation décide de ne pas donner suite à une proposition ou à une demande, par scrutin ou autrement. Le statut qui en résulte est mbrc:notAdmitted."@fr ,
                    "Die Organisation beschließt, einen Vorschlag oder Antrag nicht weiterzuverfolgen, durch Abstimmung oder auf andere Weise. Der resultierende Status ist mbrc:notAdmitted."@de ,
                    "L'organizzazione decide di non dare seguito a una proposta o a una domanda, con una votazione o in altro modo. Lo stato risultante è mbrc:notAdmitted."@it ,
                    "La organización decide no seguir adelante con una propuesta o solicitud, por votación o de otro modo. El estado resultante es mbrc:notAdmitted."@es ,
                    "A organização decide não prosseguir com uma proposta ou pedido, por votação ou de outro modo. O estado resultante é mbrc:notAdmitted."@pt .

mbrc:admission a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Admission"@en , "Upptagning"@sv , "Admission"@fr , "Aufnahme"@de , "Ammissione"@it , "Admisión"@es , "Admissão"@pt ;
    skos:definition "The candidate, applicant or person enrolling becomes a member."@en ,
                    "Kandidaten, den sökande eller den som anmäler sig blir medlem."@sv ,
                    "Le candidat, le demandeur ou la personne qui s'inscrit devient membre."@fr ,
                    "Der Kandidat, Antragsteller oder Eintretende wird Mitglied."@de ,
                    "Il candidato, il richiedente o chi si iscrive diventa socio."@it ,
                    "El candidato, solicitante o persona que se inscribe pasa a ser miembro."@es ,
                    "O candidato, requerente ou pessoa que se inscreve passa a ser membro."@pt .

mbrc:statusChange a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Status Change"@en , "Statusändring"@sv , "Changement de statut"@fr , "Statusänderung"@de , "Cambiamento di stato"@it , "Cambio de estado"@es , "Mudança de estado"@pt ;
    skos:definition "Any other change of membership status or category."@en , "Annan ändring av medlemskapets status eller kategori."@sv , "Tout autre changement de statut ou de catégorie d'adhésion."@fr , "Jede andere Änderung des Mitgliedschaftsstatus oder der Kategorie."@de , "Qualsiasi altro cambiamento di stato o di categoria di appartenenza."@it , "Cualquier otro cambio de estado o de categoría de la pertenencia."@es , "Qualquer outra mudança de estado ou de categoria da filiação."@pt .

mbrc:resignation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Resignation"@en , "Utträde"@sv , "Démission"@fr , "Austritt"@de , "Dimissioni"@it , "Baja voluntaria"@es , "Demissão"@pt ;
    skos:definition "The member leaves at their own request."@en , "Medlemmen lämnar på egen begäran."@sv , "Le membre part à sa propre demande."@fr , "Das Mitglied scheidet auf eigenen Wunsch aus."@de , "Il socio se ne va di propria richiesta."@it , "El miembro se va a petición propia."@es , "O membro sai a pedido próprio."@pt .

mbrc:lapse a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Lapse"@en , "Avförande"@sv , "Radiation pour défaut de paiement"@fr , "Erlöschen"@de , "Decadenza"@it , "Caducidad"@es , "Caducidade"@pt ;
    skos:definition "Membership ends because obligations were not met."@en , "Medlemskapet upphör för att skyldigheter inte fullgjorts."@sv , "L'adhésion prend fin parce que des obligations n'ont pas été remplies."@fr , "Die Mitgliedschaft endet, weil Pflichten nicht erfüllt wurden."@de , "L'appartenenza finisce perché non sono stati rispettati gli obblighi."@it , "La pertenencia termina porque no se cumplieron obligaciones."@es , "A filiação termina porque não se cumpriram obrigações."@pt .

mbrc:expulsion a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Expulsion"@en , "Uteslutning"@sv , "Exclusion"@fr , "Ausschluss"@de , "Espulsione"@it , "Expulsión"@es , "Expulsão"@pt ;
    skos:definition "The organisation removes the member."@en , "Organisationen utesluter medlemmen."@sv , "L'organisation retire le membre."@fr , "Die Organisation entfernt das Mitglied."@de , "L'organizzazione allontana il socio."@it , "La organización aparta al miembro."@es , "A organização afasta o membro."@pt .

mbrc:reinstatement a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Reinstatement"@en , "Återinträde"@sv , "Réintégration"@fr , "Wiederaufnahme"@de , "Riammissione"@it , "Readmisión"@es , "Readmissão"@pt ;
    skos:definition "A former member is admitted again."@en , "En tidigare medlem upptas på nytt."@sv , "Un ancien membre est de nouveau admis."@fr , "Ein ehemaliges Mitglied wird erneut aufgenommen."@de , "Un ex socio è ammesso di nuovo."@it , "Un antiguo miembro es admitido de nuevo."@es , "Um antigo membro é admitido de novo."@pt .

mbrc:death a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Death"@en , "Dödsfall"@sv , "Décès"@fr , "Tod"@de , "Decesso"@it , "Fallecimiento"@es , "Falecimento"@pt ;
    skos:definition "The member dies."@en , "Medlemmen avlider."@sv , "Le membre décède."@fr , "Das Mitglied stirbt."@de , "Il socio muore."@it , "El miembro muere."@es , "O membro morre."@pt .

mbrc:suspension a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Suspension"@en , "Avstängning"@sv , "Suspension"@fr , "Suspendierung"@de , "Sospensione"@it , "Suspensión"@es , "Suspensão"@pt ;
    skos:definition "A member is barred from taking part for a time, without losing membership."@en ,
                    "En medlem stängs av från deltagande för en tid, utan att förlora medlemskapet."@sv ,
                    "Un membre est écarté de la participation pour un temps, sans perdre son adhésion."@fr ,
                    "Ein Mitglied wird für eine Zeit von der Teilnahme ausgeschlossen, ohne die Mitgliedschaft zu verlieren."@de ,
                    "Un socio è escluso dalla partecipazione per un periodo, senza perdere l'appartenenza."@it ,
                    "Se impide a un miembro participar durante un tiempo, sin perder la pertenencia."@es ,
                    "Impede-se um membro de participar durante algum tempo, sem perder a filiação."@pt .

mbrc:transfer a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Transfer"@en , "Överflyttning"@sv , "Transfert"@fr , "Übertritt"@de , "Trasferimento"@it , "Traslado"@es , "Transferência"@pt ;
    skos:definition "A member leaves one branch or lodge of the organisation to join another."@en ,
                    "En medlem lämnar en gren eller loge inom organisationen för att gå med i en annan."@sv ,
                    "Un membre quitte une section ou loge de l'organisation pour en rejoindre une autre."@fr ,
                    "Ein Mitglied verlässt eine Gliederung oder Loge der Organisation, um einer anderen beizutreten."@de ,
                    "Un socio lascia una sezione o loggia dell'organizzazione per entrare in un'altra."@it ,
                    "Un miembro deja una sección o logia de la organización para ingresar en otra."@es ,
                    "Um membro deixa uma secção ou loja da organização para ingressar noutra."@pt .

mbrc:officeElection a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:MembershipEventTypes ; skos:topConceptOf mbrc:MembershipEventTypes ;
    skos:prefLabel "Election to Office"@en , "Val till ämbete"@sv , "Élection à une fonction"@fr , "Wahl in ein Amt"@de , "Elezione a una carica"@it , "Elección a un cargo"@es , "Eleição para um cargo"@pt ;
    skos:definition "A member is elected to an office or to a body of the organisation. Election to membership itself is the admission."@en ,
                    "En medlem väljs till ett ämbete eller ett organ inom organisationen. Valet till själva medlemskapet är upptagningen."@sv ,
                    "Un membre est élu à une fonction ou à un organe de l'organisation. L'élection à l'adhésion elle-même est l'admission."@fr ,
                    "Ein Mitglied wird in ein Amt oder in ein Organ der Organisation gewählt. Die Wahl zur Mitgliedschaft selbst ist die Aufnahme."@de ,
                    "Un socio è eletto a una carica o a un organo dell'organizzazione. L'elezione all'appartenenza stessa è l'ammissione."@it ,
                    "Un miembro es elegido para un cargo o para un órgano de la organización. La elección a la pertenencia misma es la admisión."@es ,
                    "Um membro é eleito para um cargo ou para um órgão da organização. A eleição para a própria filiação é a admissão."@pt .

##############################################################################
# 5. OFFICE TYPES  (hub; every concept is also a mbr:Office, i.e. an org:Role)
##############################################################################

mbrc:OfficeTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Office Types"@en , "Ämbetstyper"@sv , "Types de fonctions"@fr , "Amtsarten"@de , "Tipi di carica"@it , "Tipos de cargo"@es , "Tipos de cargo"@pt ;
    skos:definition "Generic offices found across clubs, societies and orders. Organisation-specific offices map to these."@en ,
                    "Generiska ämbeten som förekommer i klubbar, sällskap och ordnar. Organisationsspecifika ämbeten mappas hit."@sv ,
                    "Fonctions génériques que l'on trouve dans les clubs, sociétés et ordres. Les fonctions propres à une organisation y sont associées."@fr ,
                    "Allgemeine Ämter, die sich in Clubs, Gesellschaften und Orden finden. Organisationsspezifische Ämter werden ihnen zugeordnet."@de ,
                    "Cariche generiche che si trovano in circoli, società e ordini. Le cariche proprie di un'organizzazione si associano a queste."@it ,
                    "Cargos genéricos que se encuentran en clubes, sociedades y órdenes. Los cargos propios de cada organización se corresponden con estos."@es ,
                    "Cargos genéricos que se encontram em clubes, sociedades e ordens. Os cargos próprios de cada organização correspondem a estes."@pt ;
    skos:hasTopConcept mbrc:president , mbrc:vicePresident , mbrc:chancellor , mbrc:secretary , mbrc:treasurer ,
                       mbrc:archivist , mbrc:librarian , mbrc:chaplain , mbrc:masterOfCeremonies ,
                       mbrc:herald , mbrc:provost , mbrc:introducer , mbrc:steward ,
                       mbrc:cellarMaster , mbrc:kitchenMaster , mbrc:songLeader ,
                       mbrc:directorOfMusic , mbrc:chronicler , mbrc:webmaster , mbrc:custodian ,
                       mbrc:seniorAdviser , mbrc:regionalRepresentative , mbrc:eventLeader , mbrc:auditor ,
                       mbrc:orator , mbrc:almoner , mbrc:activityLeader ,
                       mbrc:boardMember , mbrc:honoraryPresident , mbrc:patron ,
                       mbrc:standardBearer , mbrc:noviceMaster , mbrc:courtOfHonourMember .

mbrc:president a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "President"@en , "Ordförande"@sv , "Président"@fr , "Präsident"@de , "Presidente"@it , "Presidente"@es , "Presidente"@pt ;
    skos:altLabel "Chair"@en , "Grand Master"@en , "Stormästare"@sv , "Grand Maître"@fr , "Obmann"@de-AT , "Obfrau"@de-AT , "Gran Maestro"@it ;
    skos:definition "The highest executive officer of the organisation."@en , "Organisationens högsta verkställande ämbetsman."@sv , "Le premier responsable exécutif de l'organisation."@fr , "Der höchste Amtsträger der Organisation."@de , "Il più alto titolare di carica esecutiva dell'organizzazione."@it , "El máximo cargo ejecutivo de la organización."@es , "O mais alto cargo executivo da organização."@pt ;
    skos:scopeNote "Whatever the head is called locally (grand master, chancellor, governor …), map the head's office here and keep the local title as its label."@en ,
                   "Vad den högste ämbetsmannen än kallas lokalt (stormästare, kansler, guvernör …) mappas ämbetet hit och den lokala titeln behålls som dess etikett."@sv ,
                   "Quel que soit le nom local du chef (grand maître, chancelier, gouverneur …), associer ici la fonction du chef et conserver le titre local comme libellé."@fr ,
                   "Wie auch immer das Oberhaupt vor Ort heißt (Großmeister, Kanzler, Statthalter …), das Amt des Oberhaupts hier zuordnen und den örtlichen Titel als Bezeichnung beibehalten."@de ,
                   "Comunque il capo si chiami localmente (gran maestro, cancelliere, governatore …), la carica del capo si associa qui e il titolo locale si conserva come etichetta."@it ,
                   "Cualquiera que sea el nombre local del jefe (gran maestre, canciller, gobernador…), el cargo del jefe se asocia aquí y el título local se conserva como etiqueta."@es ,
                   "Seja qual for o nome local do chefe (grão-mestre, chanceler, governador…), o cargo do chefe associa-se aqui e o título local conserva-se como etiqueta."@pt .

mbrc:vicePresident a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Vice President"@en , "Vice ordförande"@sv , "Vice-président"@fr , "Vizepräsident"@de , "Vicepresidente"@it , "Vicepresidente"@es , "Vice-presidente"@pt ;
    skos:altLabel "Obmann-Stellvertreter"@de-AT ;
    skos:definition "Deputy to the highest officer."@en , "Ställföreträdare för den högste ämbetsmannen."@sv , "Suppléant du premier responsable."@fr , "Stellvertreter des höchsten Amtsträgers."@de , "Sostituto del più alto titolare di carica."@it , "Suplente del máximo cargo."@es , "Substituto do mais alto cargo."@pt .

mbrc:chancellor a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Chancellor"@en , "Kansler"@sv , "Chancelier"@fr , "Kanzler"@de , "Cancelliere"@it , "Canciller"@es , "Chanceler"@pt ;
    skos:altLabel "Grand Chancellor"@en , "Ordenskansler"@sv , "Storkansler"@sv , "Grand chancelier"@fr , "Gran Cancelliere"@it ;
    skos:definition "The officer who keeps an order's seal, statutes and records of admissions and conferrals, usually second to the head."@en ,
                    "Den ämbetsman som förvarar en ordens sigill, stadgar och förteckningar över upptagningar och tilldelningar, vanligen närmast under den högste ämbetsmannen."@sv ,
                    "Officier qui garde le sceau, les statuts et les registres d'admission et de remise des distinctions d'un ordre, en général le second après le chef."@fr ,
                    "Der Amtsträger, der Siegel, Statuten und die Aufzeichnungen über Aufnahmen und Verleihungen eines Ordens verwahrt, meist der Zweite nach dem Oberhaupt."@de ,
                    "Il titolare di carica che custodisce il sigillo, gli statuti e i registri delle ammissioni e dei conferimenti di un ordine, di solito secondo dopo il capo."@it ,
                    "El cargo que custodia el sello, los estatutos y los registros de admisiones y concesiones de una orden, normalmente segundo después del jefe."@es ,
                    "O cargo que guarda o selo, os estatutos e os registos de admissões e atribuições de uma ordem, normalmente em segundo lugar depois do chefe."@pt ;
    skos:scopeNote "Where the chancellor is the head of the order, record that office as mbrc:president."@en ,
                   "Där kanslern är ordens högste ämbetsman anges ämbetet som mbrc:president."@sv ,
                   "Lorsque le chancelier est le chef de l'ordre, consigner cette fonction comme mbrc:president."@fr ,
                   "Ist der Kanzler das Oberhaupt des Ordens, dieses Amt als mbrc:president festhalten."@de ,
                   "Dove il cancelliere è il capo dell'ordine, quella carica si registra come mbrc:president."@it ,
                   "Cuando el canciller es el jefe de la orden, ese cargo se registra como mbrc:president."@es ,
                   "Quando o chanceler é o chefe da ordem, esse cargo regista-se como mbrc:president."@pt .

mbrc:secretary a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Secretary"@en , "Sekreterare"@sv , "Secrétaire"@fr , "Schriftführer"@de , "Segretario"@it , "Secretario"@es , "Secretário"@pt ;
    skos:definition "Keeps minutes, the register of members and official correspondence."@en , "För protokoll, matrikel och officiell korrespondens."@sv , "Tient les procès-verbaux, le registre des membres et la correspondance officielle."@fr , "Führt Protokolle, das Mitgliederverzeichnis und die offizielle Korrespondenz."@de , "Tiene i verbali, il libro dei soci e la corrispondenza ufficiale."@it , "Lleva las actas, el registro de miembros y la correspondencia oficial."@es , "Mantém as atas, o registo de membros e a correspondência oficial."@pt .

mbrc:treasurer a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Treasurer"@en , "Skattmästare"@sv , "Trésorier"@fr , "Schatzmeister"@de , "Tesoriere"@it , "Tesorero"@es , "Tesoureiro"@pt ;
    skos:altLabel "Kassör"@sv , "Kassier"@de-AT , "Cassiere"@it ;
    skos:definition "Manages the organisation's finances."@en , "Förvaltar organisationens ekonomi."@sv , "Gère les finances de l'organisation."@fr , "Verwaltet die Finanzen der Organisation."@de , "Gestisce le finanze dell'organizzazione."@it , "Gestiona las finanzas de la organización."@es , "Gere as finanças da organização."@pt .

mbrc:archivist a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Archivist"@en , "Arkivarie"@sv , "Archiviste"@fr , "Archivar"@de , "Archivista"@it , "Archivero"@es , "Arquivista"@pt ;
    skos:definition "Keeps the organisation's archives."@en , "Förvaltar organisationens arkiv."@sv , "Tient les archives de l'organisation."@fr , "Verwahrt das Archiv der Organisation."@de , "Custodisce l'archivio dell'organizzazione."@it , "Custodia el archivo de la organización."@es , "Guarda o arquivo da organização."@pt .

mbrc:librarian a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Librarian"@en , "Bibliotekarie"@sv , "Bibliothécaire"@fr , "Bibliothekar"@de , "Bibliotecario"@it , "Bibliotecario"@es , "Bibliotecário"@pt ;
    skos:definition "Keeps the organisation's library."@en , "Förvaltar organisationens bibliotek."@sv , "Tient la bibliothèque de l'organisation."@fr , "Verwahrt die Bibliothek der Organisation."@de , "Custodisce la biblioteca dell'organizzazione."@it , "Custodia la biblioteca de la organización."@es , "Guarda a biblioteca da organização."@pt .

mbrc:chaplain a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Chaplain"@en , "Kaplan"@sv , "Aumônier"@fr , "Kaplan"@de , "Cappellano"@it , "Capellán"@es , "Capelão"@pt ;
    skos:definition "Leads the spiritual or reflective parts of ceremonies."@en , "Leder de andliga eller reflekterande inslagen i ceremonier."@sv , "Dirige les parties spirituelles ou de recueillement des cérémonies."@fr , "Leitet die geistlichen oder besinnlichen Teile von Zeremonien."@de , "Guida le parti spirituali o di raccoglimento delle cerimonie."@it , "Dirige las partes espirituales o de reflexión de las ceremonias."@es , "Dirige as partes espirituais ou de reflexão das cerimónias."@pt .

mbrc:masterOfCeremonies a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Master of Ceremonies"@en , "Ceremonimästare"@sv , "Maître des cérémonies"@fr , "Zeremonienmeister"@de , "Maestro delle cerimonie"@it , "Maestro de ceremonias"@es , "Mestre de cerimónias"@pt ;
    skos:definition "Responsible for rituals, ceremonies and formal events."@en , "Ansvarar för ritualer, ceremonier och formella tillställningar."@sv , "Responsable des rites, des cérémonies et des manifestations solennelles."@fr , "Zuständig für Rituale, Zeremonien und förmliche Veranstaltungen."@de , "Responsabile di rituali, cerimonie ed eventi formali."@it , "Responsable de los rituales, las ceremonias y los actos formales."@es , "Responsável pelos rituais, pelas cerimónias e pelos atos formais."@pt .

mbrc:herald a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Herald"@en , "Härold"@sv , "Héraut"@fr , "Herold"@de , "Araldo"@it , "Heraldo"@es , "Arauto"@pt ;
    skos:definition "Makes official proclamations and assists at ceremonies."@en , "Utropar officiella meddelanden och biträder vid ceremonier."@sv , "Fait les proclamations officielles et assiste lors des cérémonies."@fr , "Verkündet amtliche Bekanntmachungen und wirkt bei Zeremonien mit."@de , "Fa le proclamazioni ufficiali e assiste alle cerimonie."@it , "Hace las proclamaciones oficiales y asiste en las ceremonias."@es , "Faz as proclamações oficiais e auxilia nas cerimónias."@pt .

mbrc:provost a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Provost"@en , "Profoss"@sv , "Prévôt"@fr , "Profos"@de , "Prevosto"@it , "Preboste"@es , "Preboste"@pt ;
    skos:altLabel "Sergeant-at-Arms"@en , "Tyler"@en , "Couvreur"@fr , "Sergent d'armes"@fr , "Copritore"@it , "Sergente d'armi"@it ;
    skos:definition "Keeps order and discipline at gatherings."@en , "Upprätthåller ordning och disciplin vid sammankomster."@sv , "Maintient l'ordre et la discipline lors des réunions."@fr , "Wahrt Ordnung und Disziplin bei Zusammenkünften."@de , "Mantiene l'ordine e la disciplina negli incontri."@it , "Mantiene el orden y la disciplina en las reuniones."@es , "Mantém a ordem e a disciplina nas reuniões."@pt .

mbrc:introducer a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Introducer"@en , "Introduktör"@sv , "Introducteur"@fr , "Einführer"@de , "Presentatore"@it , "Introductor"@es , "Introdutor"@pt ;
    skos:definition "Introduces new members and guests."@en , "Introducerar nya medlemmar och gäster."@sv , "Présente les nouveaux membres et les invités."@fr , "Führt neue Mitglieder und Gäste ein."@de , "Presenta i nuovi soci e gli ospiti."@it , "Presenta a los nuevos miembros y a los invitados."@es , "Apresenta os novos membros e os convidados."@pt .

mbrc:steward a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Feast Steward"@en , "Festvärd"@sv , "Responsable des banquets"@fr , "Festordner"@de , "Responsabile dei banchetti"@it , "Mayordomo de banquetes"@es , "Mordomo de banquetes"@pt ;
    skos:altLabel "Steward"@en ;
    skos:definition "Arranges tables, hospitality and the practical side of feasts."@en , "Ordnar taffel, gästfrihet och det praktiska kring fester."@sv , "Organise les tables, l'accueil et l'intendance pratique des festins."@fr , "Richtet Tische, Bewirtung und die praktische Seite von Festen aus."@de , "Predispone le tavole, l'ospitalità e gli aspetti pratici dei banchetti."@it , "Dispone las mesas, la hospitalidad y la parte práctica de los banquetes."@es , "Dispõe as mesas, a hospitalidade e a parte prática dos banquetes."@pt .

mbrc:cellarMaster a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Cellar Master"@en , "Källarmästare"@sv , "Maître de chai"@fr , "Kellermeister"@de , "Maestro di cantina"@it , "Bodeguero"@es , "Adegueiro"@pt ;
    skos:altLabel "Wine Steward"@en , "Sommelier"@it ;
    skos:definition "Responsible for wines and spirits."@en , "Ansvarar för viner och spritdrycker."@sv , "Responsable des vins et des spiritueux."@fr , "Zuständig für Wein und Spirituosen."@de , "Responsabile di vini e liquori."@it , "Responsable de los vinos y licores."@es , "Responsável pelos vinhos e licores."@pt .

mbrc:kitchenMaster a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Kitchen Master"@en , "Köksmästare"@sv , "Maître queux"@fr , "Küchenmeister"@de , "Maestro di cucina"@it , "Maestro de cocina"@es , "Mestre de cozinha"@pt ;
    skos:definition "Responsible for food and the kitchen."@en , "Ansvarar för mat och kök."@sv , "Responsable de la nourriture et de la cuisine."@fr , "Zuständig für das Essen und die Küche."@de , "Responsabile del cibo e della cucina."@it , "Responsable de la comida y la cocina."@es , "Responsável pela comida e pela cozinha."@pt .

mbrc:songLeader a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Song Leader"@en , "Sånganförare"@sv , "Chef de chant"@fr , "Vorsänger"@de , "Guida del canto"@it , "Director del canto"@es , "Diretor do canto"@pt ;
    skos:definition "Leads communal singing at dinners and events."@en , "Leder allsången vid middagar och tillställningar."@sv , "Dirige le chant collectif lors des dîners et manifestations."@fr , "Leitet den gemeinsamen Gesang bei Essen und Veranstaltungen."@de , "Guida il canto corale a cene ed eventi."@it , "Dirige el canto colectivo en cenas y actos."@es , "Dirige o canto coletivo em jantares e atos."@pt .

mbrc:directorOfMusic a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Director of Music"@en , "Musikanförare"@sv , "Directeur de la musique"@fr , "Musikdirektor"@de , "Direttore della musica"@it , "Director de música"@es , "Diretor de música"@pt ;
    skos:altLabel "Director musices"@sv ;
    skos:definition "Leads the music of the organisation."@en , "Leder organisationens musik."@sv , "Dirige la musique de l'organisation."@fr , "Leitet die Musik der Organisation."@de , "Guida la musica dell'organizzazione."@it , "Dirige la música de la organización."@es , "Dirige a música da organização."@pt .

mbrc:chronicler a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Chronicler"@en , "Krönikör"@sv , "Chroniqueur"@fr , "Chronist"@de , "Cronista"@it , "Cronista"@es , "Cronista"@pt ;
    skos:definition "Records the organisation's history and activities."@en , "Skriver organisationens historia och krönika."@sv , "Consigne l'histoire et les activités de l'organisation."@fr , "Hält die Geschichte und die Tätigkeiten der Organisation fest."@de , "Registra la storia e le attività dell'organizzazione."@it , "Registra la historia y las actividades de la organización."@es , "Regista a história e as atividades da organização."@pt .

mbrc:webmaster a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Webmaster"@en , "Webbansvarig"@sv , "Webmestre"@fr , "Webmaster"@de , "Webmaster"@it , "Administrador web"@es , "Administrador do sítio web"@pt ;
    skos:definition "Manages the website and digital presence."@en , "Förvaltar webbplats och digital närvaro."@sv , "Gère le site web et la présence numérique."@fr , "Betreut die Website und den digitalen Auftritt."@de , "Gestisce il sito web e la presenza digitale."@it , "Gestiona el sitio web y la presencia digital."@es , "Gere o sítio web e a presença digital."@pt .

mbrc:custodian a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Custodian of Premises"@en , "Lokalansvarig"@sv , "Responsable des locaux"@fr , "Hausverwalter"@de , "Responsabile dei locali"@it , "Conserje de los locales"@es , "Zelador das instalações"@pt ;
    skos:definition "Responsible for premises and material assets."@en , "Ansvarar för lokaler och materiella tillgångar."@sv , "Responsable des locaux et des biens matériels."@fr , "Zuständig für die Räumlichkeiten und das Sachvermögen."@de , "Responsabile dei locali e dei beni materiali."@it , "Responsable de los locales y los bienes materiales."@es , "Responsável pelas instalações e pelos bens materiais."@pt .

mbrc:seniorAdviser a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Senior Adviser"@en , "Senior rådgivare"@sv , "Conseiller senior"@fr , "Seniorberater"@de , "Consigliere anziano"@it , "Consejero veterano"@es , "Conselheiro veterano"@pt ;
    skos:altLabel "Elder"@en , "Äldste"@sv , "Anziano"@it ;
    skos:definition "An experienced member with an advisory role."@en , "En erfaren medlem med rådgivande roll."@sv , "Membre expérimenté ayant un rôle consultatif."@fr , "Ein erfahrenes Mitglied mit beratender Rolle."@de , "Un socio esperto con un ruolo consultivo."@it , "Un miembro con experiencia que desempeña una función consultiva."@es , "Um membro com experiência que desempenha uma função consultiva."@pt .

mbrc:regionalRepresentative a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Regional Representative"@en , "Regional representant"@sv , "Délégué régional"@fr , "Regionalvertreter"@de , "Rappresentante regionale"@it , "Representante regional"@es , "Representante regional"@pt ;
    skos:definition "Represents the organisation, or leads a branch, in a region."@en , "Representerar organisationen, eller leder en avdelning, i en region."@sv , "Représente l'organisation, ou dirige une section, dans une région."@fr , "Vertritt die Organisation in einer Region oder leitet dort eine Zweigstelle."@de , "Rappresenta l'organizzazione, o dirige una sezione, in una regione."@it , "Representa a la organización, o dirige una sección, en una región."@es , "Representa a organização, ou dirige uma secção, numa região."@pt .

mbrc:eventLeader a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Event Leader"@en , "Arrangemangsansvarig"@sv , "Responsable d'événement"@fr , "Veranstaltungsleiter"@de , "Responsabile di evento"@it , "Responsable de un acto"@es , "Responsável por um evento"@pt ;
    skos:definition "Leads a particular event, trip or project, often temporarily."@en , "Leder ett visst arrangemang, en resa eller ett projekt, ofta tillfälligt."@sv , "Dirige une manifestation, un voyage ou un projet donné, souvent à titre temporaire."@fr , "Leitet eine bestimmte Veranstaltung, Reise oder ein Projekt, oft vorübergehend."@de , "Guida un determinato evento, viaggio o progetto, spesso in modo temporaneo."@it , "Dirige un acto, viaje o proyecto determinado, a menudo de forma temporal."@es , "Dirige um evento, viagem ou projeto determinado, muitas vezes a título temporário."@pt .

mbrc:auditor a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Auditor"@en , "Revisor"@sv , "Revisore dei conti"@it , "Vérificateur aux comptes"@fr , "Rechnungsprüfer"@de , "Revisor de cuentas"@es , "Revisor de contas"@pt ;
    skos:definition "Checks the organisation's accounts and the board's management of them, independently of the board, and reports to the members."@en ,
                    "Granskar organisationens räkenskaper och styrelsens förvaltning av dem, oberoende av styrelsen, och rapporterar till medlemmarna."@sv ,
                    "Controlla i conti dell'organizzazione e la gestione che ne fa il direttivo, in modo indipendente da questo, e riferisce ai soci."@it ,
                    "Contrôle les comptes de l'organisation et la gestion qu'en fait le bureau, indépendamment de celui-ci, et rend compte aux membres."@fr ,
                    "Prüft die Rechnungsführung der Organisation und die Verwaltung durch den Vorstand, unabhängig von diesem, und berichtet den Mitgliedern."@de ,
                    "Comprueba las cuentas de la organización y la gestión que de ellas hace la junta, con independencia de esta, e informa a los miembros."@es ,
                    "Verifica as contas da organização e a gestão que delas faz a direção, com independência desta, e informa os membros."@pt .

mbrc:orator a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Orator"@en , "Orator"@sv , "Orateur"@fr , "Redner"@de , "Oratore"@it , "Orador"@es , "Orador"@pt ;
    skos:altLabel "Talare"@sv ;
    skos:definition "Guards the constitution and rules of the organisation and gives conclusions on the work presented at its meetings. Mostly found in lodges and learned societies."@en ,
                    "Vaktar organisationens stadgar och regler och framför slutsatser om det arbete som läggs fram vid dess sammankomster. Förekommer mest i loger och lärda sällskap."@sv ,
                    "Garant des statuts et des règlements de l'organisation, il donne ses conclusions sur les travaux présentés lors de ses réunions. On le trouve surtout dans les loges et les sociétés savantes."@fr ,
                    "Hütet die Satzung und die Regeln der Organisation und gibt zu den bei ihren Zusammenkünften vorgetragenen Arbeiten Schlussfolgerungen. Findet sich vor allem in Logen und gelehrten Gesellschaften."@de ,
                    "Custodisce lo statuto e le regole dell'organizzazione e dà le conclusioni sui lavori presentati alle sue riunioni. Si trova soprattutto nelle logge e nelle società dotte."@it ,
                    "Vela por la constitución y las reglas de la organización y da conclusiones sobre los trabajos presentados en sus reuniones. Se encuentra sobre todo en logias y sociedades científicas."@es ,
                    "Vela pela constituição e pelas regras da organização e dá conclusões sobre os trabalhos apresentados nas suas reuniões. Encontra-se sobretudo em lojas e sociedades científicas."@pt .

mbrc:almoner a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Almoner"@en , "Allmosegivare"@sv , "Hospitalier"@fr , "Almosenier"@de , "Elemosiniere"@it , "Limosnero"@es , "Esmoler"@pt ;
    skos:definition "Collects and distributes the organisation's charitable relief and looks after members in need."@en ,
                    "Samlar in och delar ut organisationens understöd och tar hand om medlemmar i nöd."@sv ,
                    "Recueille et distribue les secours de bienfaisance de l'organisation et veille sur les membres dans le besoin."@fr ,
                    "Sammelt und verteilt die wohltätigen Gaben der Organisation und kümmert sich um bedürftige Mitglieder."@de ,
                    "Raccoglie e distribuisce i soccorsi di beneficenza dell'organizzazione e si cura dei soci bisognosi."@it ,
                    "Recoge y reparte la ayuda benéfica de la organización y cuida de los miembros necesitados."@es ,
                    "Recolhe e distribui o socorro de beneficência da organização e cuida dos membros necessitados."@pt .

mbrc:activityLeader a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Activity Leader"@en , "Aktivitetsansvarig"@sv , "Responsable d'activité"@fr , "Aktivitätsverantwortlicher"@de , "Responsabile di attività"@it , "Responsable de actividad"@es , "Responsável por uma atividade"@pt ;
    skos:definition "Leads a regular activity of the organisation, such as a sports section, a choir or fencing practice, as distinct from a single event."@en ,
                    "Leder en regelbunden verksamhet inom organisationen, till exempel en idrottssektion, en kör eller fäktövningar, till skillnad från ett enskilt arrangemang."@sv ,
                    "Dirige une activité régulière de l'organisation, comme une section sportive, une chorale ou l'entraînement à l'escrime, à la différence d'une manifestation isolée."@fr ,
                    "Leitet eine regelmäßige Tätigkeit der Organisation, etwa eine Sportabteilung, einen Chor oder den Fechtbetrieb, im Unterschied zu einer einzelnen Veranstaltung."@de ,
                    "Dirige un'attività regolare dell'organizzazione, come una sezione sportiva, un coro o gli allenamenti di scherma, a differenza di un singolo evento."@it ,
                    "Dirige una actividad regular de la organización, como una sección deportiva, un coro o la práctica de esgrima, a diferencia de un acto aislado."@es ,
                    "Dirige uma atividade regular da organização, como uma secção desportiva, um coro ou a prática de esgrima, por oposição a um evento isolado."@pt .

mbrc:boardMember a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Board Member"@en , "Styrelseledamot"@sv , "Membre du conseil"@fr , "Vorstandsmitglied"@de , "Consigliere"@it , "Vocal de la junta"@es , "Vogal da direção"@pt ;
    skos:altLabel "Committee Member"@en ;
    skos:definition "A member of the board or committee that runs the organisation, without a more specific office."@en ,
                    "En ledamot av den styrelse eller kommitté som leder organisationen, utan något mer specifikt ämbete."@sv ,
                    "Membre du conseil ou du comité qui dirige l'organisation, sans fonction plus précise."@fr ,
                    "Ein Mitglied des Vorstands oder Ausschusses, der die Organisation leitet, ohne ein genaueres Amt."@de ,
                    "Un membro del consiglio o del comitato che dirige l'organizzazione, senza una carica più specifica."@it ,
                    "Un miembro de la junta o comité que dirige la organización, sin un cargo más específico."@es ,
                    "Um membro da direção ou comissão que dirige a organização, sem um cargo mais específico."@pt .

mbrc:honoraryPresident a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Honorary President"@en , "Hedersordförande"@sv , "Président d'honneur"@fr , "Ehrenpräsident"@de , "Presidente onorario"@it , "Presidente de honor"@es , "Presidente honorário"@pt ;
    skos:definition "A person given the title of president as an honour, usually without the duties of the president."@en ,
                    "En person som fått titeln ordförande som hedersbetygelse, vanligen utan ordförandens uppgifter."@sv ,
                    "Personne à qui le titre de président est donné à titre d'honneur, en général sans les fonctions du président."@fr ,
                    "Eine Person, der der Titel Präsident als Ehre verliehen wird, meist ohne die Aufgaben des Präsidenten."@de ,
                    "Una persona a cui è conferito il titolo di presidente come onore, di solito senza i compiti del presidente."@it ,
                    "Una persona a quien se da el título de presidente como honor, normalmente sin las funciones del presidente."@es ,
                    "Uma pessoa a quem se dá o título de presidente como honra, normalmente sem as funções do presidente."@pt .

mbrc:patron a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Patron"@en , "Beskyddare"@sv , "Protecteur"@fr , "Schirmherr"@de , "Protettore"@it , "Patrono"@es , "Patrono"@pt ;
    skos:altLabel "Protector"@en ;
    skos:definition "A person of standing, often a head of state or a member of a royal house, who lends the organisation a name and protection."@en ,
                    "En person med stor ställning, ofta ett statsöverhuvud eller en medlem av ett kungahus, som ger organisationen sitt namn och sitt beskydd."@sv ,
                    "Personnalité, souvent un chef d'État ou un membre d'une maison royale, qui prête à l'organisation son nom et sa protection."@fr ,
                    "Eine Persönlichkeit von Rang, oft ein Staatsoberhaupt oder ein Mitglied eines Königshauses, die der Organisation ihren Namen und ihren Schutz leiht."@de ,
                    "Una personalità di rango, spesso un capo di Stato o un membro di una casa reale, che offre all'organizzazione il proprio nome e la propria protezione."@it ,
                    "Una persona de prestigio, a menudo un jefe de Estado o un miembro de una casa real, que presta a la organización su nombre y protección."@es ,
                    "Uma pessoa de prestígio, muitas vezes um chefe de Estado ou um membro de uma casa real, que empresta à organização o seu nome e proteção."@pt .

mbrc:standardBearer a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Standard Bearer"@en , "Fanbärare"@sv , "Porte-drapeau"@fr , "Fahnenträger"@de , "Alfiere"@it , "Abanderado"@es , "Porta-estandarte"@pt ;
    skos:altLabel "Banner Bearer"@en ;
    skos:definition "Carries the organisation's standard or banner at processions and ceremonies."@en ,
                    "Bär organisationens fana eller banér vid tåg och ceremonier."@sv ,
                    "Porte l'étendard ou la bannière de l'organisation lors des cortèges et des cérémonies."@fr ,
                    "Trägt die Fahne oder das Banner der Organisation bei Umzügen und Zeremonien."@de ,
                    "Porta lo stendardo o il vessillo dell'organizzazione nei cortei e nelle cerimonie."@it ,
                    "Lleva el estandarte o la bandera de la organización en procesiones y ceremonias."@es ,
                    "Leva o estandarte ou a bandeira da organização em procissões e cerimónias."@pt .

mbrc:noviceMaster a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Novice Master"@en , "Ansvarig för nya medlemmar"@sv , "Responsable des novices"@fr , "Novizenmeister"@de , "Maestro dei novizi"@it , "Maestro de novicios"@es , "Mestre de noviços"@pt ;
    skos:altLabel "Instructor of Novices"@en ;
    skos:definition "Trains and looks after the new members during their time as novices, until they are admitted in full."@en ,
                    "Utbildar och tar hand om de nya medlemmarna under deras tid som noviser, tills de tas upp fullt ut."@sv ,
                    "Forme les nouveaux membres et veille sur eux pendant leur temps de novices, jusqu'à leur admission complète."@fr ,
                    "Bildet die neuen Mitglieder während ihrer Zeit als Novizen aus und betreut sie, bis sie voll aufgenommen werden."@de ,
                    "Forma i nuovi soci e se ne prende cura durante il periodo da novizi, fino alla piena ammissione."@it ,
                    "Forma y cuida de los nuevos miembros durante su tiempo como novicios, hasta que son admitidos plenamente."@es ,
                    "Forma e cuida dos novos membros durante o seu tempo como noviços, até serem plenamente admitidos."@pt .

mbrc:courtOfHonourMember a mbr:Office , skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OfficeTypes ; skos:topConceptOf mbrc:OfficeTypes ;
    skos:prefLabel "Member of the Court of Honour"@en , "Ledamot av hedersrätten"@sv , "Membre du tribunal d'honneur"@fr , "Mitglied des Ehrengerichts"@de , "Membro del collegio dei probiviri"@it , "Miembro del tribunal de honor"@es , "Membro do tribunal de honra"@pt ;
    skos:altLabel "Arbitrator"@en ;
    skos:definition "Sits on the body that settles disputes between members and judges breaches of the organisation's rules and honour."@en ,
                    "Ingår i det organ som avgör tvister mellan medlemmar och prövar överträdelser av organisationens regler och heder."@sv ,
                    "Siège dans l'organe qui règle les différends entre membres et juge les manquements aux règles et à l'honneur de l'organisation."@fr ,
                    "Gehört dem Organ an, das Streitigkeiten zwischen Mitgliedern schlichtet und Verstöße gegen die Regeln und die Ehre der Organisation beurteilt."@de ,
                    "Fa parte dell'organo che compone le controversie tra i soci e giudica le violazioni delle regole e dell'onore dell'organizzazione."@it ,
                    "Forma parte del órgano que resuelve los conflictos entre miembros y juzga las infracciones de las reglas y del honor de la organización."@es ,
                    "Integra o órgão que resolve os conflitos entre membros e julga as infrações às regras e à honra da organização."@pt .

##############################################################################
# 6. GATHERING TYPES
##############################################################################

mbrc:GatheringTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Gathering Types"@en , "Typer av sammankomster"@sv , "Types de réunions"@fr , "Arten von Zusammenkünften"@de , "Tipi di incontro"@it , "Tipos de reunión"@es , "Tipos de reunião"@pt ;
    skos:definition "Kinds of gathering that an organisation holds, such as meetings, dinners, balls and ceremonies. Used with mbr:gatheringType."@en ,
                    "Slag av sammankomster som en organisation håller, till exempel möten, middagar, baler och ceremonier. Används med mbr:gatheringType."@sv ,
                    "Types de réunions qu'une organisation tient, comme assemblées, dîners, bals et cérémonies. S'utilise avec mbr:gatheringType."@fr ,
                    "Arten von Zusammenkünften, die eine Organisation abhält, etwa Sitzungen, Essen, Bälle und Zeremonien. Wird mit mbr:gatheringType verwendet."@de ,
                    "Tipi di riunioni che un'organizzazione tiene, come assemblee, cene, balli e cerimonie. Si usa con mbr:gatheringType."@it ,
                    "Tipos de reunión que celebra una organización, como juntas, cenas, bailes y ceremonias. Se usa con mbr:gatheringType."@es ,
                    "Tipos de reunião que uma organização realiza, como assembleias, jantares, bailes e cerimónias. Usa-se com mbr:gatheringType."@pt ;
    skos:hasTopConcept mbrc:meeting , mbrc:formalDinner , mbrc:informalDinner , mbrc:ball ,
                       mbrc:excursion , mbrc:lecture , mbrc:guestNight , mbrc:anniversary ,
                       mbrc:commemoration , mbrc:ceremony , mbrc:socialEvening , mbrc:procession ,
                       mbrc:contest .

mbrc:meeting a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Meeting"@en , "Möte"@sv , "Réunion"@fr , "Sitzung"@de , "Riunione"@it , "Reunión"@es , "Reunião"@pt ;
    skos:definition "A meeting for business or discussion."@en , "Ett möte för ärenden eller samtal."@sv , "Réunion pour traiter d'affaires ou discuter."@fr , "Eine Zusammenkunft zur Beratung oder Erledigung von Geschäften."@de , "Una riunione per affari o discussione."@it , "Una reunión para tratar asuntos o debatir."@es , "Uma reunião para tratar de assuntos ou debater."@pt ;
    skos:narrower mbrc:generalMeeting .

mbrc:generalMeeting a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:broader mbrc:meeting ;
    skos:prefLabel "General Meeting"@en , "Stämma"@sv , "Assemblée générale"@fr , "Mitgliederversammlung"@de , "Assemblea generale"@it , "Asamblea general"@es , "Assembleia geral"@pt ;
    skos:altLabel "Annual General Meeting"@en , "Congress"@en , "Årsmöte"@sv , "Kongress"@sv , "Assemblea dei soci"@it , "Assemblea ordinaria"@it , "Congresso"@it ;
    skos:definition "A meeting of all members, or of delegates elected by them, with decision-making power."@en ,
                    "Ett möte med alla medlemmar, eller med ombud valda av dem, som har beslutanderätt."@sv ,
                    "Réunion de tous les membres, ou de délégués élus par eux, dotée du pouvoir de décision."@fr ,
                    "Eine Versammlung aller Mitglieder oder der von ihnen gewählten Delegierten mit Beschlussbefugnis."@de ,
                    "Una riunione di tutti i soci, o dei delegati da essi eletti, con potere decisionale."@it ,
                    "Una reunión de todos los miembros, o de delegados elegidos por ellos, con capacidad de decisión."@es ,
                    "Uma reunião de todos os membros, ou de delegados eleitos por eles, com poder de decisão."@pt ;
    skos:narrower mbrc:extraordinaryGeneralMeeting .

mbrc:extraordinaryGeneralMeeting a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:broader mbrc:generalMeeting ;
    skos:prefLabel "Extraordinary General Meeting"@en , "Extra stämma"@sv , "Assemblée générale extraordinaire"@fr , "Außerordentliche Mitgliederversammlung"@de , "Assemblea generale straordinaria"@it , "Asamblea general extraordinaria"@es , "Assembleia geral extraordinária"@pt ;
    skos:altLabel "Extra årsmöte"@sv , "Extra föreningsstämma"@sv , "Assemblea straordinaria"@it ;
    skos:definition "A general meeting called outside the regular yearly cycle to decide a particular matter, such as a change of statutes or the dissolution of the organisation."@en ,
                    "En stämma som kallas utanför den ordinarie årliga cykeln för att avgöra en bestämd fråga, t.ex. ändring av stadgarna eller organisationens upplösning."@sv ,
                    "Assemblée générale convoquée en dehors du cycle annuel ordinaire pour décider d'une question précise, comme la modification des statuts ou la dissolution de l'association."@fr ,
                    "Eine Mitgliederversammlung, die außerhalb des regelmäßigen Jahreszyklus einberufen wird, um eine bestimmte Angelegenheit zu entscheiden, etwa eine Satzungsänderung oder die Auflösung der Organisation."@de ,
                    "Un'assemblea generale convocata fuori dal ciclo annuale regolare per decidere una questione particolare, come una modifica dello statuto o lo scioglimento dell'organizzazione."@it ,
                    "Una asamblea general convocada fuera del ciclo anual ordinario para decidir un asunto determinado, como un cambio de estatutos o la disolución de la organización."@es ,
                    "Uma assembleia geral convocada fora do ciclo anual ordinário para decidir um assunto determinado, como uma alteração dos estatutos ou a dissolução da organização."@pt ;
    skos:scopeNote "The ordinary yearly meeting is mbrc:generalMeeting."@en , "L'assemblée annuelle ordinaire est mbrc:generalMeeting."@fr , "Die ordentliche Jahresversammlung ist mbrc:generalMeeting."@de , "La riunione annuale ordinaria è mbrc:generalMeeting."@it , "Det ordinarie årliga mötet är mbrc:generalMeeting."@sv , "La reunión anual ordinaria es mbrc:generalMeeting."@es , "A reunião anual ordinária é mbrc:generalMeeting."@pt .

mbrc:formalDinner a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Formal Dinner"@en , "Högtidsmiddag"@sv , "Dîner de gala"@fr , "Festessen"@de , "Cena formale"@it , "Cena de gala"@es , "Jantar de gala"@pt ;
    skos:altLabel "Banquet"@en , "Bankett"@sv , "Banchetto"@it ;
    skos:definition "A formal dinner with a prescribed dress code and ceremonial elements."@en , "En formell middag med föreskriven klädkod och ceremoniella inslag."@sv , "Dîner solennel avec un code vestimentaire prescrit et des éléments cérémoniels."@fr , "Ein förmliches Essen mit vorgeschriebener Kleiderordnung und zeremoniellen Elementen."@de , "Una cena formale con un codice di abbigliamento prescritto ed elementi cerimoniali."@it , "Una cena formal con un código de vestimenta prescrito y elementos ceremoniales."@es , "Um jantar formal com um código de vestuário prescrito e elementos cerimoniais."@pt .

mbrc:informalDinner a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Informal Dinner"@en , "Informell middag"@sv , "Dîner informel"@fr , "Zwangloses Essen"@de , "Cena informale"@it , "Cena informal"@es , "Jantar informal"@pt ;
    skos:definition "A dinner without full ceremonial."@en , "En middag utan fullt ceremoniel."@sv , "Dîner sans cérémonial complet."@fr , "Ein Essen ohne volles Zeremoniell."@de , "Una cena senza cerimoniale completo."@it , "Una cena sin ceremonial completo."@es , "Um jantar sem cerimonial completo."@pt .

mbrc:ball a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Ball"@en , "Bal"@sv , "Bal"@fr , "Ball"@de , "Ballo"@it , "Baile"@es , "Baile"@pt ;
    skos:definition "A formal dance."@en , "En formell dans."@sv , "Danse de cérémonie."@fr , "Ein förmlicher Tanzabend."@de , "Una danza formale."@it , "Un baile formal."@es , "Um baile formal."@pt .

mbrc:excursion a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Excursion"@en , "Utflykt"@sv , "Excursion"@fr , "Ausflug"@de , "Escursione"@it , "Excursión"@es , "Excursão"@pt ;
    skos:altLabel "Trip"@en , "Resa"@sv , "Gita"@it ;
    skos:definition "A trip made together by members."@en , "En resa som medlemmarna gör tillsammans."@sv , "Voyage fait ensemble par les membres."@fr , "Eine gemeinsame Fahrt der Mitglieder."@de , "Un viaggio fatto insieme dai soci."@it , "Un viaje hecho en común por los miembros."@es , "Uma viagem feita em conjunto pelos membros."@pt .

mbrc:lecture a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Lecture"@en , "Föredrag"@sv , "Conférence"@fr , "Vortrag"@de , "Conferenza"@it , "Conferencia"@es , "Conferência"@pt ;
    skos:definition "A talk given to the members."@en , "Ett föredrag för medlemmarna."@sv , "Exposé fait aux membres."@fr , "Ein Vortrag vor den Mitgliedern."@de , "Una conferenza tenuta ai soci."@it , "Una charla dada a los miembros."@es , "Uma palestra dada aos membros."@pt .

mbrc:guestNight a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Guest Night"@en , "Gästafton"@sv , "Soirée des invités"@fr , "Gästeabend"@de , "Serata con ospiti"@it , "Noche de invitados"@es , "Noite de convidados"@pt ;
    skos:altLabel "Ladies' Night"@en , "Damafton"@sv ;
    skos:definition "A gathering to which members may bring guests."@en , "En sammankomst dit medlemmar får ta med gäster."@sv , "Réunion à laquelle les membres peuvent amener des invités."@fr , "Eine Zusammenkunft, zu der Mitglieder Gäste mitbringen dürfen."@de , "Un incontro a cui i soci possono portare ospiti."@it , "Una reunión a la que los miembros pueden llevar invitados."@es , "Uma reunião a que os membros podem levar convidados."@pt .

mbrc:anniversary a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Anniversary"@en , "Jubileum"@sv , "Anniversaire"@fr , "Jubiläum"@de , "Anniversario"@it , "Aniversario"@es , "Aniversário"@pt ;
    skos:definition "A celebration of an anniversary of the organisation."@en , "Ett firande av en av organisationens årsdagar."@sv , "Célébration d'un anniversaire de l'organisation."@fr , "Eine Feier zu einem Jubiläum der Organisation."@de , "La celebrazione di un anniversario dell'organizzazione."@it , "Una celebración de un aniversario de la organización."@es , "Uma celebração de um aniversário da organização."@pt .

mbrc:commemoration a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Commemoration"@en , "Minneshögtid"@sv , "Commémoration"@fr , "Gedenkfeier"@de , "Commemorazione"@it , "Conmemoración"@es , "Comemoração"@pt ;
    skos:definition "A gathering in memory of a person or event."@en , "En sammankomst till minne av en person eller händelse."@sv , "Réunion à la mémoire d'une personne ou d'un événement."@fr , "Eine Zusammenkunft zum Gedenken an eine Person oder ein Ereignis."@de , "Un incontro in memoria di una persona o di un evento."@it , "Una reunión en memoria de una persona o un acontecimiento."@es , "Uma reunião em memória de uma pessoa ou de um acontecimento."@pt .

mbrc:ceremony a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Ceremony"@en , "Ceremoni"@sv , "Cérémonie"@fr , "Zeremonie"@de , "Cerimonia"@it , "Ceremonia"@es , "Cerimónia"@pt ;
    skos:definition "A gathering at which a prescribed ritual is performed, such as an initiation, an installation of officers or a conferral of degrees."@en ,
                    "En sammankomst där en föreskriven ritual utförs, till exempel en upptagning, en installation av ämbetsmän eller en tilldelning av grader."@sv ,
                    "Réunion au cours de laquelle un rituel prescrit est accompli, comme une initiation, une installation des officiers ou une collation de grades."@fr ,
                    "Eine Zusammenkunft, bei der ein vorgeschriebenes Ritual vollzogen wird, etwa eine Aufnahme, eine Einsetzung von Amtsträgern oder eine Verleihung von Graden."@de ,
                    "Un incontro in cui si esegue un rituale prescritto, come un'iniziazione, un insediamento dei titolari di carica o un conferimento di gradi."@it ,
                    "Una reunión en la que se realiza un ritual prescrito, como una iniciación, una toma de posesión de cargos o una concesión de grados."@es ,
                    "Uma reunião em que se realiza um ritual prescrito, como uma iniciação, uma tomada de posse de cargos ou uma atribuição de graus."@pt ;
    skos:scopeNote "The hub for the ceremony types of the fraternal codelists (fraternalc:CeremonyTypes), which map to it with skos:broadMatch."@en ,
                   "Navet för ceremonityperna i fraternals kodlistor (fraternalc:CeremonyTypes), som mappas hit med skos:broadMatch."@sv ,
                   "Le pivot des types de cérémonies des listes de codes fraternal (fraternalc:CeremonyTypes), qui y sont reliés par skos:broadMatch."@fr ,
                   "Der Oberbegriff für die Zeremonienarten der fraternalen Codelisten (fraternalc:CeremonyTypes), die mit skos:broadMatch auf ihn abgebildet werden."@de ,
                   "L'hub per i tipi di cerimonia delle liste di codici fraternali (fraternalc:CeremonyTypes), che vi si associano con skos:broadMatch."@it ,
                   "El núcleo de los tipos de ceremonia de las listas de códigos fraternales (fraternalc:CeremonyTypes), que se asocian a él con skos:broadMatch."@es ,
                   "O núcleo dos tipos de cerimónia das listas de códigos fraternais (fraternalc:CeremonyTypes), que se associam a ele com skos:broadMatch."@pt .

mbrc:socialEvening a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Social Evening"@en , "Sällskapsafton"@sv , "Soirée conviviale"@fr , "Geselliger Abend"@de , "Serata conviviale"@it , "Velada social"@es , "Serão social"@pt ;
    skos:definition "A social gathering for conversation, drink and often song, less formal than a dinner and without a prescribed ritual, such as a Stammtisch or a Kneipe."@en ,
                    "En social sammankomst med samtal, dryck och ofta sång, mindre formell än en middag och utan föreskriven ritual, till exempel ett Stammtisch eller en Kneipe."@sv ,
                    "Réunion conviviale pour converser, boire et souvent chanter, moins formelle qu'un dîner et sans rituel prescrit, comme un Stammtisch ou une Kneipe."@fr ,
                    "Eine gesellige Zusammenkunft zu Gespräch, Trunk und oft Gesang, weniger förmlich als ein Essen und ohne vorgeschriebenes Ritual, etwa ein Stammtisch oder eine Kneipe."@de ,
                    "Un incontro conviviale per conversare, bere e spesso cantare, meno formale di una cena e senza rituale prescritto, come uno Stammtisch o una Kneipe."@it ,
                    "Una reunión social para conversar, beber y a menudo cantar, menos formal que una cena y sin ritual prescrito, como un Stammtisch o una Kneipe."@es ,
                    "Uma reunião social para conversar, beber e muitas vezes cantar, menos formal do que um jantar e sem ritual prescrito, como um Stammtisch ou uma Kneipe."@pt .

mbrc:procession a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Procession"@en , "Procession"@sv , "Procession"@fr , "Umzug"@de , "Processione"@it , "Procesión"@es , "Procissão"@pt ;
    skos:definition "An orderly march of members together through the streets or to a place, for example with torches, banners or insignia."@en ,
                    "Ett ordnat tåg av medlemmar tillsammans genom gatorna eller till en plats, till exempel med facklor, fanor eller insignier."@sv ,
                    "Cortège ordonné de membres qui se déplacent ensemble dans les rues ou vers un lieu, par exemple avec des torches, des bannières ou des insignes."@fr ,
                    "Ein geordneter gemeinsamer Zug von Mitgliedern durch die Straßen oder zu einem Ort, etwa mit Fackeln, Bannern oder Insignien."@de ,
                    "Un corteo ordinato di soci che si muove insieme per le strade o verso un luogo, per esempio con torce, stendardi o insegne."@it ,
                    "Una marcha ordenada de los miembros juntos por las calles o hacia un lugar, por ejemplo con antorchas, estandartes o insignias."@es ,
                    "Uma marcha ordenada dos membros em conjunto pelas ruas ou até um lugar, por exemplo com tochas, estandartes ou insígnias."@pt .

mbrc:contest a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GatheringTypes ; skos:topConceptOf mbrc:GatheringTypes ;
    skos:prefLabel "Contest"@en , "Tävling"@sv , "Épreuve"@fr , "Wettkampf"@de , "Gara"@it , "Competición"@es , "Competição"@pt ;
    skos:definition "A gathering at which members or teams measure themselves against one another under fixed rules, such as a sports match, a regulated fencing bout or a traditional race."@en ,
                    "En sammankomst där medlemmar eller lag mäter sig mot varandra enligt fasta regler, till exempel en idrottstävling, en reglerad fäktning eller ett traditionellt lopp."@sv ,
                    "Réunion où des membres ou des équipes se mesurent selon des règles fixes, comme un match sportif, un assaut d'escrime réglementé ou une course traditionnelle."@fr ,
                    "Eine Zusammenkunft, bei der sich Mitglieder oder Mannschaften nach festen Regeln miteinander messen, etwa ein sportlicher Wettkampf, eine geregelte Fechtpartie oder ein traditionelles Rennen."@de ,
                    "Una riunione in cui soci o squadre si misurano secondo regole fisse, come una gara sportiva, un incontro di scherma regolamentato o una corsa tradizionale."@it ,
                    "Una reunión en la que miembros o equipos se miden entre sí con reglas fijas, como un partido deportivo, un asalto de esgrima reglamentado o una carrera tradicional."@es ,
                    "Uma reunião em que membros ou equipas se medem entre si com regras fixas, como um jogo desportivo, um assalto de esgrima regulamentado ou uma corrida tradicional."@pt .

##############################################################################
# 7. PARTICIPATION ROLES
##############################################################################

mbrc:ParticipationRoles a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Participation Roles"@en , "Deltagarroller"@sv , "Rôles de participation"@fr , "Teilnahmerollen"@de , "Ruoli di partecipazione"@it , "Papeles de participación"@es , "Papéis de participação"@pt ;
    skos:definition "The part a person takes in a gathering, such as member, guest, host or speaker. Used with mbr:participationRole."@en ,
                    "Den roll en person har vid en sammankomst, till exempel medlem, gäst, värd eller talare. Används med mbr:participationRole."@sv ,
                    "Le rôle d'une personne lors d'une réunion, comme membre, invité, hôte ou orateur. S'utilise avec mbr:participationRole."@fr ,
                    "Die Rolle, die eine Person bei einer Zusammenkunft einnimmt, etwa Mitglied, Gast, Gastgeber oder Redner. Wird mit mbr:participationRole verwendet."@de ,
                    "Il ruolo di una persona a una riunione, come socio, ospite, anfitrione o relatore. Si usa con mbr:participationRole."@it ,
                    "El papel que desempeña una persona en una reunión, como miembro, invitado, anfitrión o ponente. Se usa con mbr:participationRole."@es ,
                    "O papel que uma pessoa desempenha numa reunião, como membro, convidado, anfitrião ou orador. Usa-se com mbr:participationRole."@pt ;
    skos:hasTopConcept mbrc:member , mbrc:guest , mbrc:host , mbrc:partner , mbrc:speaker ,
                       mbrc:officiant , mbrc:reciprocalVisitor .

mbrc:member a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Member"@en , "Medlem"@sv , "Membre"@fr , "Mitglied"@de , "Socio"@it , "Miembro"@es , "Membro"@pt ;
    skos:definition "Takes part as a member of the organising organisation."@en , "Deltar som medlem i den anordnande organisationen."@sv , "Participe en tant que membre de l'organisation qui organise."@fr , "Nimmt als Mitglied der veranstaltenden Organisation teil."@de , "Partecipa come socio dell'organizzazione che organizza."@it , "Participa como miembro de la organización que convoca."@es , "Participa como membro da organização que convoca."@pt .

mbrc:guest a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Guest"@en , "Gäst"@sv , "Invité"@fr , "Gast"@de , "Ospite"@it , "Invitado"@es , "Convidado"@pt ;
    skos:definition "Takes part as a guest, usually introduced by a member."@en , "Deltar som gäst, vanligen introducerad av en medlem."@sv , "Participe en tant qu'invité, en général présenté par un membre."@fr , "Nimmt als Gast teil, meist von einem Mitglied eingeführt."@de , "Partecipa come ospite, di solito presentato da un socio."@it , "Participa como invitado, normalmente presentado por un miembro."@es , "Participa como convidado, normalmente apresentado por um membro."@pt .

mbrc:host a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Host"@en , "Värd"@sv , "Hôte"@fr , "Gastgeber"@de , "Anfitrione"@it , "Anfitrión"@es , "Anfitrião"@pt ;
    skos:definition "Hosts the gathering."@en , "Står värd för sammankomsten."@sv , "Reçoit la réunion."@fr , "Richtet die Zusammenkunft aus."@de , "Ospita l'incontro."@it , "Es el anfitrión de la reunión."@es , "É o anfitrião da reunião."@pt .

mbrc:partner a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Partner"@en , "Partner"@sv , "Accompagnant"@fr , "Begleitung"@de , "Accompagnatore"@it , "Acompañante"@es , "Acompanhante"@pt ;
    skos:altLabel "Dinner Partner"@en , "moatjé"@sv , "bordsdam"@sv , "bordskavaljer"@sv ;
    skos:definition "Accompanies a member as partner or dinner companion."@en , "Följer med en medlem som partner eller bordsällskap."@sv , "Accompagne un membre comme partenaire ou convive."@fr , "Begleitet ein Mitglied als Partner oder Tischdame beziehungsweise Tischherr."@de , "Accompagna un socio come partner o come commensale."@it , "Acompaña a un miembro como pareja o compañía en la cena."@es , "Acompanha um membro como par ou companhia no jantar."@pt .

mbrc:speaker a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Speaker"@en , "Talare"@sv , "Orateur invité"@fr , "Redner"@de , "Relatore"@it , "Ponente"@es , "Orador"@pt ;
    skos:definition "Gives a speech or lecture."@en , "Håller tal eller föredrag."@sv , "Prononce un discours ou une conférence."@fr , "Hält eine Rede oder einen Vortrag."@de , "Tiene un discorso o una conferenza."@it , "Pronuncia un discurso o una conferencia."@es , "Faz um discurso ou uma conferência."@pt .

mbrc:officiant a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Officiant"@en , "Förrättare"@sv , "Officiant"@fr , "Zelebrant"@de , "Officiante"@it , "Oficiante"@es , "Oficiante"@pt ;
    skos:definition "Performs a ceremony or ritual."@en , "Förrättar en ceremoni eller ritual."@sv , "Célèbre une cérémonie ou un rituel."@fr , "Führt eine Zeremonie oder ein Ritual durch."@de , "Compie una cerimonia o un rituale."@it , "Realiza una ceremonia o un ritual."@es , "Realiza uma cerimónia ou um ritual."@pt .

mbrc:reciprocalVisitor a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ParticipationRoles ; skos:topConceptOf mbrc:ParticipationRoles ;
    skos:prefLabel "Reciprocal Visitor"@en , "Besökare från vänorganisation"@sv , "Visiteur réciproque"@fr , "Besucher auf Gegenseitigkeit"@de , "Visitatore in reciprocità"@it , "Visitante por reciprocidad"@es , "Visitante por reciprocidade"@pt ;
    skos:definition "A member of a reciprocal or recognised organisation, visiting."@en , "En besökande medlem från en organisation med ömsesidighet eller erkännande."@sv , "Membre d'une organisation réciproque ou reconnue, en visite."@fr , "Ein Mitglied einer auf Gegenseitigkeit verbundenen oder anerkannten Organisation, das zu Besuch ist."@de , "Un socio di un'organizzazione reciproca o riconosciuta, in visita."@it , "Un miembro de una organización recíproca o reconocida, de visita."@es , "Um membro de uma organização recíproca ou reconhecida, em visita."@pt .

##############################################################################
# 8. DRESS CODES
##############################################################################

mbrc:DressCodes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Dress Codes"@en , "Klädkoder"@sv , "Codes vestimentaires"@fr , "Kleiderordnungen"@de , "Codici di abbigliamento"@it , "Códigos de vestimenta"@es , "Códigos de vestuário"@pt ;
    skos:definition "The dress required or expected at a gathering, from evening dress to uniform or the wearing of insignia. Used with mbr:dressCode."@en ,
                    "Den klädsel som krävs eller förväntas vid en sammankomst, från högtidsdräkt till uniform eller bärande av insignier. Används med mbr:dressCode."@sv ,
                    "La tenue exigée ou attendue lors d'une réunion, de la tenue de soirée à l'uniforme ou au port des insignes. S'utilise avec mbr:dressCode."@fr ,
                    "Die bei einer Zusammenkunft verlangte oder erwartete Kleidung, von der Abendgarderobe bis zur Uniform oder zum Tragen von Insignien. Wird mit mbr:dressCode verwendet."@de ,
                    "L'abbigliamento richiesto o previsto a una riunione, dall'abito da sera all'uniforme o all'uso delle insegne. Si usa con mbr:dressCode."@it ,
                    "La vestimenta exigida o esperada en una reunión, desde el traje de noche hasta el uniforme o el uso de insignias. Se usa con mbr:dressCode."@es ,
                    "O vestuário exigido ou esperado numa reunião, desde o traje de noite até ao uniforme ou ao uso de insígnias. Usa-se com mbr:dressCode."@pt ;
    skos:hasTopConcept mbrc:whiteTie , mbrc:blackTie , mbrc:loungeSuit , mbrc:morningDress ,
                       mbrc:academicDress , mbrc:uniform , mbrc:nationalCostume , mbrc:insigniaWorn .

mbrc:whiteTie a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "White Tie"@en , "Frack"@sv , "Cravate blanche"@fr , "Frack (weiße Fliege)"@de , "Cravatta bianca"@it , "Frac con corbata blanca"@es , "Casaca com gravata branca"@pt ;
    skos:definition "Tailcoat with white bow tie, or the equivalent evening dress."@en , "Frack med vit fluga, eller motsvarande aftonklädsel."@sv , "Habit avec nœud papillon blanc, ou tenue de soirée équivalente."@fr , "Frack mit weißer Fliege oder die entsprechende Abendkleidung."@de , "Frac con cravatta bianca, o l'abito da sera equivalente."@it , "Frac con pajarita blanca, o el traje de noche equivalente."@es , "Casaca com laço branco, ou o traje de noite equivalente."@pt .

mbrc:blackTie a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "Black Tie"@en , "Smoking"@sv , "Cravate noire"@fr , "Smoking (schwarze Fliege)"@de , "Cravatta nera"@it , "Esmoquin"@es , "Smoking"@pt ;
    skos:altLabel "Tuxedo"@en , "Smoking"@it ;
    skos:definition "Dinner jacket with black bow tie, or the equivalent."@en , "Smoking med svart fluga, eller motsvarande."@sv , "Smoking avec nœud papillon noir, ou l'équivalent."@fr , "Smoking mit schwarzer Fliege oder das Entsprechende."@de , "Smoking con cravatta nera, o l'equivalente."@it , "Esmoquin con pajarita negra, o el equivalente."@es , "Smoking com laço preto, ou o equivalente."@pt .

mbrc:loungeSuit a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "Lounge Suit"@en , "Mörk kostym"@sv , "Costume sombre"@fr , "Dunkler Anzug"@de , "Abito scuro"@it , "Traje oscuro"@es , "Fato escuro"@pt ;
    skos:altLabel "Dark Suit"@en , "Kavaj"@sv , "Giacca e cravatta"@it ;
    skos:definition "Dark suit and tie, or the equivalent."@en , "Mörk kostym och slips, eller motsvarande."@sv , "Costume sombre et cravate, ou l'équivalent."@fr , "Dunkler Anzug mit Krawatte oder das Entsprechende."@de , "Abito scuro e cravatta, o l'equivalente."@it , "Traje oscuro y corbata, o el equivalente."@es , "Fato escuro e gravata, ou o equivalente."@pt ;
    skos:scopeNote "Swedish invitations sometimes distinguish \"mörk kostym\" from the slightly less formal \"kavaj\"; both are recorded with this code."@en ,
                   "Svenska inbjudningar skiljer ibland mellan \"mörk kostym\" och den något mindre formella \"kavaj\"; båda anges med denna kod."@sv ,
                   "Les invitations suédoises distinguent parfois « mörk kostym » du « kavaj », un peu moins formel ; les deux sont consignés avec ce code."@fr ,
                   "Schwedische Einladungen unterscheiden mitunter „mörk kostym“ vom etwas weniger förmlichen „kavaj“; beide werden mit diesem Code erfasst."@de ,
                   "Gli inviti svedesi talvolta distinguono «mörk kostym» dal leggermente meno formale «kavaj»; entrambi si registrano con questo codice."@it ,
                   "Las invitaciones suecas distinguen a veces «mörk kostym» de «kavaj», algo menos formal; ambos se registran con este código."@es ,
                   "Os convites suecos distinguem por vezes «mörk kostym» de «kavaj», algo menos formal; ambos se registam com este código."@pt .

mbrc:morningDress a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "Morning Dress"@en , "Jackett"@sv , "Tenue de jour"@fr , "Cut"@de , "Tight"@it , "Chaqué"@es , "Fraque"@pt ;
    skos:definition "Daytime formal dress with morning coat."@en , "Formell dagklädsel med jackett."@sv , "Tenue de cérémonie de jour avec redingote."@fr , "Förmliche Tageskleidung mit Cutaway."@de , "Abito formale da giorno con tight."@it , "Traje formal de día con chaqué."@es , "Traje formal de dia com fraque."@pt .

mbrc:academicDress a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "Academic Dress"@en , "Akademisk högtidsdräkt"@sv , "Tenue académique"@fr , "Akademische Tracht"@de , "Toga accademica"@it , "Traje académico"@es , "Traje académico"@pt ;
    skos:definition "Academic dress as prescribed by the university."@en , "Akademisk högtidsdräkt enligt universitetets föreskrifter."@sv , "Tenue académique telle que prescrite par l'université."@fr , "Akademische Tracht, wie sie von der Universität vorgeschrieben ist."@de , "L'abito accademico prescritto dall'università."@it , "El traje académico prescrito por la universidad."@es , "O traje académico prescrito pela universidade."@pt .

mbrc:uniform a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "Uniform"@en , "Uniform"@sv , "Uniforme"@fr , "Uniform"@de , "Uniforme"@it , "Uniforme"@es , "Uniforme"@pt ;
    skos:definition "Military or other uniform."@en , "Militär eller annan uniform."@sv , "Uniforme militaire ou autre."@fr , "Militär- oder andere Uniform."@de , "Uniforme militare o di altro tipo."@it , "Uniforme militar o de otro tipo."@es , "Uniforme militar ou de outro tipo."@pt .

mbrc:nationalCostume a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "National Costume"@en , "Folkdräkt"@sv , "Costume traditionnel"@fr , "Tracht"@de , "Costume tradizionale"@it , "Traje regional"@es , "Traje regional"@pt ;
    skos:definition "Traditional regional or national dress."@en , "Traditionell bygde- eller nationaldräkt."@sv , "Costume traditionnel régional ou national."@fr , "Traditionelle regionale oder nationale Kleidung."@de , "Abito tradizionale regionale o nazionale."@it , "Traje tradicional regional o nacional."@es , "Traje tradicional regional ou nacional."@pt .

mbrc:insigniaWorn a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DressCodes ; skos:topConceptOf mbrc:DressCodes ;
    skos:prefLabel "Insignia to Be Worn"@en , "Ordenstecken bäres"@sv , "Décorations à porter"@fr , "Ordenszeichen werden getragen"@de , "Con le insegne"@it , "Con insignias"@es , "Com insígnias"@pt ;
    skos:altLabel "Decorations"@en , "Med ordnar"@sv , "Con le decorazioni"@it ;
    skos:definition "Orders, medals and insignia are to be worn. Combined with another dress code."@en , "Ordnar, medaljer och tecken ska bäras. Kombineras med en annan klädkod."@sv , "Les ordres, médailles et insignes doivent être portés. Se combine avec un autre code vestimentaire."@fr , "Orden, Medaillen und Insignien sind zu tragen. Wird mit einer anderen Kleiderordnung kombiniert."@de , "Si devono portare ordini, medaglie e insegne. Si combina con un altro codice di abbigliamento."@it , "Se deben llevar órdenes, medallas e insignias. Se combina con otro código de vestimenta."@es , "Devem usar-se ordens, medalhas e insígnias. Combina-se com outro código de vestuário."@pt .

##############################################################################
# 9. GENDER POLICIES
##############################################################################

mbrc:GenderPolicies a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Gender Policies"@en , "Könspolicyer"@sv , "Règles de mixité"@fr , "Geschlechterregelungen"@de , "Politiche di genere"@it , "Políticas de género"@es , "Políticas de género"@pt ;
    skos:definition "Whether an organisation admits men, women or both and, if both, whether in the same branch or in separate ones. Used with mbr:genderPolicy."@en ,
                    "Om en organisation tar in män, kvinnor eller båda och, om båda, i samma gren eller i skilda grenar. Används med mbr:genderPolicy."@sv ,
                    "Si une organisation admet des hommes, des femmes ou les deux et, dans ce dernier cas, dans la même section ou dans des sections distinctes. S'utilise avec mbr:genderPolicy."@fr ,
                    "Ob eine Organisation Männer, Frauen oder beide aufnimmt und, wenn beide, in derselben oder in getrennten Gliederungen. Wird mit mbr:genderPolicy verwendet."@de ,
                    "Se un'organizzazione ammette uomini, donne o entrambi e, in tal caso, nella stessa sezione o in sezioni separate. Si usa con mbr:genderPolicy."@it ,
                    "Si una organización admite hombres, mujeres o ambos y, si ambos, si en la misma sección o en secciones separadas. Se usa con mbr:genderPolicy."@es ,
                    "Se uma organização admite homens, mulheres ou ambos e, se ambos, se na mesma secção ou em secções separadas. Usa-se com mbr:genderPolicy."@pt ;
    skos:hasTopConcept mbrc:menOnly , mbrc:womenOnly , mbrc:mixed , mbrc:mixedSeparateBranches .

mbrc:menOnly a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GenderPolicies ; skos:topConceptOf mbrc:GenderPolicies ;
    skos:prefLabel "Men Only"@en , "Endast män"@sv , "Réservé aux hommes"@fr , "Nur Männer"@de , "Solo uomini"@it , "Solo hombres"@es , "Só homens"@pt ;
    skos:definition "Only men are admitted as members."@en , "Endast män upptas som medlemmar."@sv , "Seuls les hommes sont admis comme membres."@fr , "Nur Männer werden als Mitglieder aufgenommen."@de , "Sono ammessi come soci solo gli uomini."@it , "Solo se admite a hombres como miembros."@es , "Só se admitem homens como membros."@pt .

mbrc:womenOnly a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GenderPolicies ; skos:topConceptOf mbrc:GenderPolicies ;
    skos:prefLabel "Women Only"@en , "Endast kvinnor"@sv , "Réservé aux femmes"@fr , "Nur Frauen"@de , "Solo donne"@it , "Solo mujeres"@es , "Só mulheres"@pt ;
    skos:definition "Only women are admitted as members."@en , "Endast kvinnor upptas som medlemmar."@sv , "Seules les femmes sont admises comme membres."@fr , "Nur Frauen werden als Mitglieder aufgenommen."@de , "Sono ammesse come socie solo le donne."@it , "Solo se admite a mujeres como miembros."@es , "Só se admitem mulheres como membros."@pt .

mbrc:mixed a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GenderPolicies ; skos:topConceptOf mbrc:GenderPolicies ;
    skos:prefLabel "Mixed"@en , "Blandat"@sv , "Mixte"@fr , "Gemischt"@de , "Misto"@it , "Mixta"@es , "Mista"@pt ;
    skos:definition "Members of any gender are admitted on equal terms."@en , "Medlemmar av alla kön upptas på lika villkor."@sv , "Les membres de tout genre sont admis dans les mêmes conditions."@fr , "Mitglieder jeden Geschlechts werden zu gleichen Bedingungen aufgenommen."@de , "Sono ammessi soci di qualsiasi genere a parità di condizioni."@it , "Se admite a miembros de cualquier género en igualdad de condiciones."@es , "Admitem-se membros de qualquer género em igualdade de condições."@pt .

mbrc:mixedSeparateBranches a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:GenderPolicies ; skos:topConceptOf mbrc:GenderPolicies ;
    skos:prefLabel "Mixed, Separate Branches"@en , "Blandat, separata avdelningar"@sv , "Mixte, sections séparées"@fr , "Gemischt, getrennte Zweigstellen"@de , "Misto, sezioni separate"@it , "Mixta, con secciones separadas"@es , "Mista, com secções separadas"@pt ;
    skos:definition "Men and women are admitted, but to separate branches or lodges."@en , "Både män och kvinnor upptas, men i separata avdelningar eller loger."@sv , "Hommes et femmes sont admis, mais dans des sections ou des loges séparées."@fr , "Männer und Frauen werden aufgenommen, aber in getrennte Zweigstellen oder Logen."@de , "Sono ammessi uomini e donne, ma in sezioni o logge separate."@it , "Se admite a hombres y mujeres, pero en secciones o logias separadas."@es , "Admitem-se homens e mulheres, mas em secções ou lojas separadas."@pt .

##############################################################################
# 10. ADMISSION MODES
##############################################################################

mbrc:AdmissionModes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Admission Modes"@en , "Upptagningsformer"@sv , "Modes d'admission"@fr , "Aufnahmeverfahren"@de , "Modalità di ammissione"@it , "Modalidades de admisión"@es , "Modalidades de admissão"@pt ;
    skos:definition "The ways in which a person is admitted to an organisation, such as by invitation, by proposal and ballot, or by open application. Used with mbr:admissionMode."@en ,
                    "De sätt på vilka en person tas in i en organisation, till exempel genom inbjudan, genom förslag och omröstning eller genom öppen ansökan. Används med mbr:admissionMode."@sv ,
                    "Les manières dont une personne est admise dans une organisation, comme sur invitation, sur proposition et scrutin, ou sur candidature ouverte. S'utilise avec mbr:admissionMode."@fr ,
                    "Die Wege, auf denen eine Person in eine Organisation aufgenommen wird, etwa auf Einladung, durch Vorschlag und Abstimmung oder durch offene Bewerbung. Wird mit mbr:admissionMode verwendet."@de ,
                    "I modi in cui una persona viene ammessa in un'organizzazione, come su invito, per proposta e votazione, o per domanda aperta. Si usa con mbr:admissionMode."@it ,
                    "Las maneras en que una persona es admitida en una organización, como por invitación, por propuesta y votación, o por solicitud abierta. Se usa con mbr:admissionMode."@es ,
                    "As maneiras como uma pessoa é admitida numa organização, como por convite, por proposta e votação, ou por candidatura aberta. Usa-se com mbr:admissionMode."@pt ;
    skos:hasTopConcept mbrc:byInvitation , mbrc:proposalAndBallot , mbrc:proposalAndObjectionPeriod ,
                       mbrc:openApplication , mbrc:openEnrolment , mbrc:hereditary , mbrc:exOfficio ,
                       mbrc:byConferral , mbrc:byExamination .

mbrc:byInvitation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "By Invitation"@en , "Genom inbjudan"@sv , "Sur invitation"@fr , "Auf Einladung"@de , "Su invito"@it , "Por invitación"@es , "Por convite"@pt ;
    skos:definition "Membership is only offered by invitation."@en , "Medlemskap erbjuds endast genom inbjudan."@sv , "L'adhésion n'est offerte que sur invitation."@fr , "Die Mitgliedschaft wird nur auf Einladung angeboten."@de , "L'appartenenza viene offerta soltanto su invito."@it , "La pertenencia solo se ofrece por invitación."@es , "A filiação só se oferece por convite."@pt .

mbrc:proposalAndBallot a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "Proposal and Ballot"@en , "Förslag och ballotering"@sv , "Proposition et scrutin"@fr , "Vorschlag und Abstimmung"@de , "Proposta e votazione"@it , "Propuesta y votación"@es , "Proposta e votação"@pt ;
    skos:definition "Candidates are proposed by members and elected by ballot."@en , "Kandidater föreslås av medlemmar och väljs genom ballotering."@sv , "Les candidats sont proposés par des membres et élus au scrutin."@fr , "Kandidaten werden von Mitgliedern vorgeschlagen und durch Abstimmung gewählt."@de , "I candidati sono proposti dai soci ed eletti a scrutinio."@it , "Los candidatos son propuestos por miembros y elegidos por votación."@es , "Os candidatos são propostos por membros e eleitos por votação."@pt .

mbrc:proposalAndObjectionPeriod a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "Proposal and Objection Period"@en , "Förslag och invändningstid"@sv , "Proposition et délai d'opposition"@fr , "Vorschlag und Einspruchsfrist"@de , "Proposta e periodo di opposizione"@it , "Propuesta y plazo de oposición"@es , "Proposta e prazo de oposição"@pt ;
    skos:definition "Candidates are proposed and seconded by members, and the proposal is made known to the members for a set period. Unless an objection leads the organisation to stop it, the candidate goes ahead to admission; there is no vote."@en ,
                    "Kandidater föreslås och understöds av medlemmar, och förslaget görs känt för medlemmarna under en bestämd tid. Om ingen invändning får organisationen att stoppa det går kandidaten vidare till upptagning; ingen omröstning sker."@sv ,
                    "Les candidats sont proposés et appuyés par des membres, et la proposition est portée à la connaissance des membres pendant un délai fixé. Sauf si une opposition conduit l'organisation à l'arrêter, le candidat passe à l'admission ; il n'y a pas de vote."@fr ,
                    "Kandidaten werden von Mitgliedern vorgeschlagen und unterstützt, und der Vorschlag wird den Mitgliedern für eine bestimmte Frist bekannt gemacht. Führt kein Einspruch dazu, dass die Organisation ihn stoppt, geht der Kandidat weiter zur Aufnahme; es gibt keine Abstimmung."@de ,
                    "I candidati sono proposti e appoggiati dai soci, e la proposta è portata a conoscenza dei soci per un periodo stabilito. Se un'opposizione non induce l'organizzazione a fermarla, il candidato procede all'ammissione; non c'è votazione."@it ,
                    "Los candidatos son propuestos y secundados por miembros, y la propuesta se da a conocer a los miembros durante un plazo fijo. Salvo que una oposición lleve a la organización a detenerla, el candidato pasa a la admisión; no hay votación."@es ,
                    "Os candidatos são propostos e secundados por membros, e a proposta é dada a conhecer aos membros durante um prazo fixo. A não ser que uma oposição leve a organização a travá-la, o candidato passa à admissão; não há votação."@pt ;
    skos:scopeNote "Compare mbrc:proposalAndBallot, where the members vote. A proposal that is stopped is recorded as a mbrc:rejection event with the resulting status mbrc:notAdmitted."@en ,
                   "Jämför mbrc:proposalAndBallot, där medlemmarna röstar. Ett förslag som stoppas registreras som en händelse av typen mbrc:rejection med den nya statusen mbrc:notAdmitted."@sv ,
                   "Comparer mbrc:proposalAndBallot, où les membres votent. Une proposition arrêtée est consignée comme un événement mbrc:rejection avec le statut résultant mbrc:notAdmitted."@fr ,
                   "Vergleiche mbrc:proposalAndBallot, wo die Mitglieder abstimmen. Ein gestoppter Vorschlag wird als Ereignis mbrc:rejection mit dem resultierenden Status mbrc:notAdmitted festgehalten."@de ,
                   "Si confronti mbrc:proposalAndBallot, dove i soci votano. Una proposta che viene fermata si registra come evento mbrc:rejection con lo stato risultante mbrc:notAdmitted."@it ,
                   "Compárese mbrc:proposalAndBallot, donde los miembros votan. Una propuesta que se detiene se registra como un evento mbrc:rejection con el estado resultante mbrc:notAdmitted."@es ,
                   "Compare-se mbrc:proposalAndBallot, em que os membros votam. Uma proposta que é travada regista-se como um evento mbrc:rejection com o estado resultante mbrc:notAdmitted."@pt .

mbrc:openApplication a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "Open Application"@en , "Öppen ansökan"@sv , "Candidature libre"@fr , "Offene Bewerbung"@de , "Domanda aperta"@it , "Solicitud abierta"@es , "Candidatura aberta"@pt ;
    skos:definition "Anyone meeting the criteria may apply, and the organisation, usually its board, decides whether to admit the applicant."@en ,
                    "Alla som uppfyller kriterierna kan ansöka, och organisationen, vanligen styrelsen, beslutar om den sökande ska tas upp."@sv ,
                    "Toute personne remplissant les critères peut poser sa candidature, et l'organisation, en général son bureau ou son conseil, décide de l'admettre ou non."@fr ,
                    "Jeder, der die Kriterien erfüllt, kann sich bewerben, und die Organisation, meist ihr Vorstand, entscheidet über die Aufnahme des Bewerbers."@de ,
                    "Chiunque soddisfi i criteri può presentare domanda, e l'organizzazione, di solito il suo consiglio direttivo, decide se ammettere il richiedente."@it ,
                    "Cualquiera que cumpla los criterios puede solicitar el ingreso, y la organización, normalmente su junta, decide si admite al solicitante."@es ,
                    "Qualquer pessoa que cumpra os critérios pode candidatar-se, e a organização, normalmente a sua direção, decide se admite o requerente."@pt ;
    skos:scopeNote "Compare mbrc:openEnrolment, where no admission decision is made."@en ,
                   "Jämför mbrc:openEnrolment, där inget beslut om upptagning fattas."@sv ,
                   "Comparer mbrc:openEnrolment, où aucune décision d'admission n'est prise."@fr ,
                   "Vergleiche mbrc:openEnrolment, wo keine Aufnahmeentscheidung getroffen wird."@de ,
                   "Si confronti mbrc:openEnrolment, dove non si prende alcuna decisione di ammissione."@it ,
                   "Compárese mbrc:openEnrolment, donde no se toma ninguna decisión de admisión."@es ,
                   "Compare-se mbrc:openEnrolment, em que não se toma nenhuma decisão de admissão."@pt .

mbrc:openEnrolment a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "Open Enrolment"@en , "Inträde genom anmälan"@sv , "Adhésion libre"@fr , "Offener Beitritt"@de , "Iscrizione libera"@it , "Inscripción abierta"@es , "Inscrição aberta"@pt ;
    skos:altLabel "Open Membership"@en , "Open Enrollment"@en-US , "Öppet medlemskap"@sv , "Adesione aperta"@it ;
    skos:definition "Anyone who accepts the organisation's purpose and rules may join by registering and, where required, paying the fee. No admission decision is made."@en ,
                    "Var och en som godtar organisationens ändamål och stadgar kan bli medlem genom att anmäla sig och i förekommande fall betala avgiften. Inget beslut om upptagning fattas."@sv ,
                    "Toute personne qui accepte le but et les statuts de l'organisation peut adhérer en s'inscrivant et, le cas échéant, en payant la cotisation. Aucune décision d'admission n'est prise."@fr ,
                    "Jeder, der den Zweck und die Regeln der Organisation anerkennt, kann durch Anmeldung und, wo verlangt, Zahlung des Beitrags beitreten. Es wird keine Aufnahmeentscheidung getroffen."@de ,
                    "Chiunque accetti lo scopo e le regole dell'organizzazione può aderire iscrivendosi e, dove richiesto, pagando la quota. Non si prende alcuna decisione di ammissione."@it ,
                    "Cualquiera que acepte el fin y las reglas de la organización puede ingresar inscribiéndose y, cuando se exige, pagando la cuota. No se toma ninguna decisión de admisión."@es ,
                    "Qualquer pessoa que aceite o fim e as regras da organização pode ingressar inscrevendo-se e, quando exigido, pagando a quota. Não se toma nenhuma decisão de admissão."@pt .

mbrc:hereditary a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "Hereditary"@en , "Ärftligt"@sv , "Héréditaire"@fr , "Erblich"@de , "Ereditaria"@it , "Hereditaria"@es , "Hereditária"@pt ;
    skos:definition "Membership passes by descent."@en , "Medlemskap går i arv."@sv , "L'adhésion se transmet par filiation."@fr , "Die Mitgliedschaft geht durch Abstammung über."@de , "L'appartenenza si trasmette per discendenza."@it , "La pertenencia se transmite por descendencia."@es , "A filiação transmite-se por descendência."@pt .

mbrc:exOfficio a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "Ex Officio"@en , "Ex officio"@sv , "De droit"@fr , "Von Amts wegen"@de , "D'ufficio"@it , "De oficio"@es , "Por inerência"@pt ;
    skos:definition "Membership follows from holding a certain position."@en , "Medlemskap följer av en viss befattning."@sv , "L'adhésion découle de l'exercice d'une certaine fonction."@fr , "Die Mitgliedschaft ergibt sich aus der Innehabung einer bestimmten Position."@de , "L'appartenenza deriva dall'occupare una certa posizione."@it , "La pertenencia se deriva de ocupar un determinado puesto."@es , "A filiação decorre de ocupar um determinado cargo."@pt .

mbrc:byConferral a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "By Conferral"@en , "Genom tilldelning"@sv , "Par collation"@fr , "Durch Verleihung"@de , "Per conferimento"@it , "Por concesión"@es , "Por atribuição"@pt ;
    skos:definition "Membership is conferred by a head of state, a sovereign or another authority and is not applied for, as in a state order."@en ,
                    "Medlemskapet tilldelas av ett statsöverhuvud, en suverän eller en annan myndighet och söks inte, som i en statlig orden."@sv ,
                    "L'appartenance est conférée par un chef d'État, un souverain ou une autre autorité et n'est pas demandée, comme dans un ordre d'État."@fr ,
                    "Die Mitgliedschaft wird von einem Staatsoberhaupt, einem Souverän oder einer anderen Stelle verliehen und nicht beantragt, wie in einem staatlichen Orden."@de ,
                    "L'appartenenza è conferita da un capo di Stato, da un sovrano o da un'altra autorità e non è richiesta, come in un ordine di Stato."@it ,
                    "La pertenencia la confiere un jefe de Estado, un soberano u otra autoridad y no se solicita, como en una orden del Estado."@es ,
                    "A filiação é conferida por um chefe de Estado, um soberano ou outra autoridade e não se requer, como numa ordem do Estado."@pt .

mbrc:byExamination a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:AdmissionModes ; skos:topConceptOf mbrc:AdmissionModes ;
    skos:prefLabel "By Examination"@en , "Genom prövning"@sv , "Par examen"@fr , "Durch Prüfung"@de , "Per esame"@it , "Por examen"@es , "Por exame"@pt ;
    skos:definition "Admission depends on passing a test or presenting a piece of work, such as a masterpiece."@en ,
                    "Upptagning beror på att man klarar ett prov eller lägger fram ett arbete, till exempel ett mästerstycke."@sv ,
                    "L'admission dépend de la réussite d'une épreuve ou de la présentation d'une œuvre, comme un chef-d'œuvre."@fr ,
                    "Die Aufnahme hängt davon ab, dass man eine Prüfung besteht oder ein Werk vorlegt, etwa ein Meisterstück."@de ,
                    "L'ammissione dipende dal superamento di una prova o dalla presentazione di un'opera, come un capolavoro."@it ,
                    "La admisión depende de superar una prueba o de presentar una obra, como una obra maestra."@es ,
                    "A admissão depende de passar numa prova ou de apresentar uma obra, como uma obra-prima."@pt .

##############################################################################
# 11. DISTINCTION TYPES
##############################################################################

mbrc:DistinctionTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Distinction Types"@en , "Typer av utmärkelser"@sv , "Types de distinctions"@fr , "Arten von Auszeichnungen"@de , "Tipi di riconoscimento"@it , "Tipos de distinción"@es , "Tipos de distinção"@pt ;
    skos:definition "Kinds of award or honour that an organisation can confer, such as a medal, a badge or an honorary title. Used with mbr:distinctionType."@en ,
                    "Slag av utmärkelser som en organisation kan tilldela, till exempel en medalj, ett märke eller en hederstitel. Används med mbr:distinctionType."@sv ,
                    "Types de distinctions qu'une organisation peut conférer, comme une médaille, un insigne ou un titre honorifique. S'utilise avec mbr:distinctionType."@fr ,
                    "Arten von Auszeichnungen, die eine Organisation verleihen kann, etwa eine Medaille, ein Abzeichen oder ein Ehrentitel. Wird mit mbr:distinctionType verwendet."@de ,
                    "Tipi di riconoscimenti che un'organizzazione può conferire, come una medaglia, un distintivo o un titolo onorifico. Si usa con mbr:distinctionType."@it ,
                    "Tipos de premio u honor que una organización puede conceder, como una medalla, una insignia o un título honorífico. Se usa con mbr:distinctionType."@es ,
                    "Tipos de prémio ou honra que uma organização pode conferir, como uma medalha, um distintivo ou um título honorífico. Usa-se com mbr:distinctionType."@pt ;
    skos:hasTopConcept mbrc:medal , mbrc:badge , mbrc:honoraryTitle , mbrc:honoraryMembership ,
                       mbrc:trophy , mbrc:diploma .

mbrc:medal a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DistinctionTypes ; skos:topConceptOf mbrc:DistinctionTypes ;
    skos:prefLabel "Medal"@en , "Medalj"@sv , "Médaille"@fr , "Medaille"@de , "Medaglia"@it , "Medalla"@es , "Medalha"@pt ;
    skos:definition "A medal, usually worn on a ribbon."@en , "En medalj, vanligen buren i band."@sv , "Médaille, en général portée sur un ruban."@fr , "Eine Medaille, meist an einem Band getragen."@de , "Una medaglia, di solito portata su un nastro."@it , "Una medalla, normalmente llevada en una cinta."@es , "Uma medalha, normalmente usada numa fita."@pt .

mbrc:badge a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DistinctionTypes ; skos:topConceptOf mbrc:DistinctionTypes ;
    skos:prefLabel "Badge"@en , "Tecken"@sv , "Insigne"@fr , "Abzeichen"@de , "Distintivo"@it , "Insignia"@es , "Distintivo"@pt ;
    skos:definition "A badge or emblem of distinction."@en , "Ett hederstecken eller emblem."@sv , "Insigne ou emblème de distinction."@fr , "Ein Abzeichen oder Emblem als Auszeichnung."@de , "Un distintivo o emblema di riconoscimento."@it , "Una insignia o emblema de distinción."@es , "Um distintivo ou emblema de distinção."@pt .

mbrc:honoraryTitle a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DistinctionTypes ; skos:topConceptOf mbrc:DistinctionTypes ;
    skos:prefLabel "Honorary Title"@en , "Hederstitel"@sv , "Titre honorifique"@fr , "Ehrentitel"@de , "Titolo onorifico"@it , "Título honorífico"@es , "Título honorífico"@pt ;
    skos:definition "A title conferred as an honour."@en , "En titel som ges som hedersbetygelse."@sv , "Titre conféré à titre d'honneur."@fr , "Ein als Ehre verliehener Titel."@de , "Un titolo conferito come onore."@it , "Un título conferido como honor."@es , "Um título conferido como honra."@pt .

mbrc:honoraryMembership a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DistinctionTypes ; skos:topConceptOf mbrc:DistinctionTypes ;
    skos:prefLabel "Honorary Membership"@en , "Hedersledamotskap"@sv , "Adhésion honoraire"@fr , "Ehrenmitgliedschaft"@de , "Appartenenza onoraria"@it , "Pertenencia honoraria"@es , "Filiação honorária"@pt ;
    skos:definition "Membership conferred as an honour."@en , "Medlemskap som ges som hedersbetygelse."@sv , "Adhésion conférée à titre d'honneur."@fr , "Als Ehre verliehene Mitgliedschaft."@de , "Appartenenza conferita come onore."@it , "Pertenencia conferida como honor."@es , "Filiação conferida como honra."@pt .

mbrc:trophy a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DistinctionTypes ; skos:topConceptOf mbrc:DistinctionTypes ;
    skos:prefLabel "Trophy"@en , "Pris"@sv , "Trophée"@fr , "Pokal"@de , "Trofeo"@it , "Trofeo"@es , "Troféu"@pt ;
    skos:altLabel "Vandringspris"@sv ;
    skos:definition "A prize object, often passed on between winners."@en , "Ett pris, ofta vandrande mellan vinnare."@sv , "Objet de prix, souvent transmis de lauréat en lauréat."@fr , "Ein Preisgegenstand, der oft von Sieger zu Sieger weitergereicht wird."@de , "Un oggetto premio, spesso passato tra i vincitori."@it , "Un objeto de premio, a menudo transmitido entre ganadores."@es , "Um objeto de prémio, muitas vezes transmitido entre vencedores."@pt .

mbrc:diploma a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:DistinctionTypes ; skos:topConceptOf mbrc:DistinctionTypes ;
    skos:prefLabel "Diploma"@en , "Diplom"@sv , "Diplôme"@fr , "Urkunde"@de , "Diploma"@it , "Diploma"@es , "Diploma"@pt ;
    skos:definition "A certificate of distinction."@en , "Ett hedersdiplom."@sv , "Certificat de distinction."@fr , "Eine Urkunde als Auszeichnung."@de , "Un attestato di riconoscimento."@it , "Un certificado de distinción."@es , "Um certificado de distinção."@pt .

##############################################################################
# 12. MATERIALS
##############################################################################

mbrc:Materials a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Materials"@en , "Material"@sv , "Matériaux"@fr , "Materialien"@de , "Materiali"@it , "Materiales"@es , "Materiais"@pt ;
    skos:definition "Materials of medals, badges and insignia."@en , "Material i medaljer, tecken och insignier."@sv , "Matériaux des médailles, insignes et décorations."@fr , "Materialien von Medaillen, Abzeichen und Insignien."@de , "Materiali di medaglie, distintivi e insegne."@it , "Materiales de medallas, insignias y distintivos."@es , "Materiais de medalhas, distintivos e insígnias."@pt ;
    skos:hasTopConcept mbrc:gold , mbrc:silver , mbrc:giltSilver , mbrc:bronze , mbrc:pewter ,
                       mbrc:enamel .

mbrc:gold a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:Materials ; skos:topConceptOf mbrc:Materials ;
    skos:prefLabel "Gold"@en , "Guld"@sv , "Or"@fr , "Gold"@de , "Oro"@it , "Oro"@es , "Ouro"@pt ;
    skos:definition "The metal gold, used for medals, badges and insignia."@en ,
                    "Metallen guld, som används till medaljer, märken och insignier."@sv ,
                    "Le métal or, utilisé pour les médailles, les insignes et les décorations."@fr ,
                    "Das Metall Gold, verwendet für Medaillen, Abzeichen und Insignien."@de ,
                    "Il metallo oro, usato per medaglie, distintivi e insegne."@it ,
                    "El metal oro, usado en medallas, insignias y distintivos."@es ,
                    "O metal ouro, usado em medalhas, distintivos e insígnias."@pt .

mbrc:silver a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:Materials ; skos:topConceptOf mbrc:Materials ;
    skos:prefLabel "Silver"@en , "Silver"@sv , "Argent"@fr , "Silber"@de , "Argento"@it , "Plata"@es , "Prata"@pt ;
    skos:definition "The metal silver, used for medals, badges and insignia."@en ,
                    "Metallen silver, som används till medaljer, märken och insignier."@sv ,
                    "Le métal argent, utilisé pour les médailles, les insignes et les décorations."@fr ,
                    "Das Metall Silber, verwendet für Medaillen, Abzeichen und Insignien."@de ,
                    "Il metallo argento, usato per medaglie, distintivi e insegne."@it ,
                    "El metal plata, usado en medallas, insignias y distintivos."@es ,
                    "O metal prata, usado em medalhas, distintivos e insígnias."@pt .

mbrc:giltSilver a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:Materials ; skos:topConceptOf mbrc:Materials ;
    skos:prefLabel "Silver-gilt"@en , "Förgyllt silver"@sv , "Vermeil"@fr , "Vergoldetes Silber"@de , "Argento dorato"@it , "Plata dorada"@es , "Prata dourada"@pt ;
    skos:definition "Silver covered with a thin layer of gold (vermeil)."@en ,
                    "Silver täckt med ett tunt lager guld (förgyllt silver)."@sv ,
                    "Argent recouvert d'une fine couche d'or (vermeil)."@fr ,
                    "Mit einer dünnen Goldschicht überzogenes Silber (Vermeil)."@de ,
                    "Argento ricoperto da un sottile strato d'oro (vermeil)."@it ,
                    "Plata cubierta con una fina capa de oro (vermeil)."@es ,
                    "Prata coberta com uma fina camada de ouro (vermeil)."@pt .

mbrc:bronze a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:Materials ; skos:topConceptOf mbrc:Materials ;
    skos:prefLabel "Bronze"@en , "Brons"@sv , "Bronze"@fr , "Bronze"@de , "Bronzo"@it , "Bronce"@es , "Bronze"@pt ;
    skos:definition "The alloy of copper and tin, used for medals and badges."@en ,
                    "Legeringen av koppar och tenn, som används till medaljer och märken."@sv ,
                    "L'alliage de cuivre et d'étain, utilisé pour les médailles et les insignes."@fr ,
                    "Die Legierung aus Kupfer und Zinn, verwendet für Medaillen und Abzeichen."@de ,
                    "La lega di rame e stagno, usata per medaglie e distintivi."@it ,
                    "La aleación de cobre y estaño, usada en medallas e insignias."@es ,
                    "A liga de cobre e estanho, usada em medalhas e distintivos."@pt .

mbrc:pewter a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:Materials ; skos:topConceptOf mbrc:Materials ;
    skos:prefLabel "Pewter"@en , "Tenn"@sv , "Étain"@fr , "Zinn"@de , "Peltro"@it , "Peltre"@es , "Peltre"@pt ;
    skos:scopeNote "The tin-based alloy (Swedish 'tenn' in the craft sense), not the element tin."@en ,
                   "Den tennbaserade legeringen (tenn i hantverksbemärkelse), inte grundämnet."@sv ,
                   "L'alliage à base d'étain (le suédois « tenn » au sens artisanal), et non l'élément étain."@fr ,
                   "Die Legierung auf Zinnbasis (schwedisch 'tenn' im handwerklichen Sinn), nicht das Element Zinn."@de ,
                   "La lega a base di stagno (lo svedese 'tenn' in senso artigianale), non l'elemento stagno."@it ,
                   "La aleación a base de estaño (en sueco «tenn» en el sentido artesanal), no el elemento estaño."@es ,
                   "A liga à base de estanho (em sueco «tenn» no sentido artesanal), não o elemento estanho."@pt ;
    skos:definition "A soft alloy consisting mostly of tin, used for badges, tankards and other keepsakes."@en ,
                    "En mjuk legering som mest består av tenn, och som används till märken, sejdlar och andra minnessaker."@sv ,
                    "Alliage mou composé surtout d'étain, utilisé pour des insignes, des chopes et d'autres souvenirs."@fr ,
                    "Eine weiche Legierung, die überwiegend aus Zinn besteht und für Abzeichen, Humpen und andere Erinnerungsstücke verwendet wird."@de ,
                    "Una lega morbida composta soprattutto di stagno, usata per distintivi, boccali e altri ricordi."@it ,
                    "Una aleación blanda compuesta sobre todo de estaño, usada en insignias, jarras y otros recuerdos."@es ,
                    "Uma liga macia composta sobretudo de estanho, usada em distintivos, canecas e outras lembranças."@pt .

mbrc:enamel a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:Materials ; skos:topConceptOf mbrc:Materials ;
    skos:prefLabel "Enamel"@en , "Emalj"@sv , "Émail"@fr , "Email"@de , "Smalto"@it , "Esmalte"@es , "Esmalte"@pt ;
    skos:definition "A glassy coating fused onto metal, used to colour badges and insignia."@en ,
                    "Ett glasartat skikt som smälts fast på metall och används för att färga märken och insignier."@sv ,
                    "Revêtement vitreux fondu sur le métal, utilisé pour colorer les insignes et les décorations."@fr ,
                    "Eine glasartige, auf Metall aufgeschmolzene Schicht, mit der Abzeichen und Insignien farbig gestaltet werden."@de ,
                    "Un rivestimento vetroso fuso sul metallo, usato per colorare distintivi e insegne."@it ,
                    "Un recubrimiento vítreo fundido sobre el metal, usado para dar color a insignias y distintivos."@es ,
                    "Um revestimento vítreo fundido sobre o metal, usado para dar cor a distintivos e insígnias."@pt .

##############################################################################
# 13. ORGANISATION STATUSES  (values of mbr:organizationStatus)
##############################################################################

mbrc:OrganizationStatuses a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Organisation Statuses"@en , "Organisationsstatusar"@sv , "Statuts des organisations"@fr , "Organisationsstatus"@de , "Stati dell'organizzazione"@it , "Estados de la organización"@es , "Estados da organização"@pt ;
    skos:definition "Whether an organisation still exists and operates."@en ,
                    "Om en organisation fortfarande finns och är verksam."@sv ,
                    "Indique si une organisation existe encore et est en activité."@fr ,
                    "Ob eine Organisation noch besteht und tätig ist."@de ,
                    "Se un'organizzazione esiste e opera ancora."@it ,
                    "Si una organización sigue existiendo y funcionando."@es ,
                    "Se uma organização continua a existir e a funcionar."@pt ;
    skos:hasTopConcept mbrc:activeOrganization , mbrc:dormantOrganization ,
                       mbrc:mergedOrganization , mbrc:closedOrganization ,
                       mbrc:suppressedOrganization , mbrc:inExileOrganization .

mbrc:activeOrganization a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationStatuses ; skos:topConceptOf mbrc:OrganizationStatuses ;
    skos:prefLabel "Active"@en , "Verksam"@sv , "En activité"@fr , "Aktiv"@de , "Attiva"@it , "Activa"@es , "Ativa"@pt ;
    skos:definition "The organisation exists and operates."@en , "Organisationen finns och är verksam."@sv , "L'organisation existe et est en activité."@fr , "Die Organisation besteht und ist tätig."@de , "L'organizzazione esiste e opera."@it , "La organización existe y funciona."@es , "A organização existe e funciona."@pt .

mbrc:dormantOrganization a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationStatuses ; skos:topConceptOf mbrc:OrganizationStatuses ;
    skos:prefLabel "Dormant"@en , "Vilande"@sv , "En sommeil"@fr , "Ruhend"@de , "Dormiente"@it , "Latente"@es , "Latente"@pt ;
    skos:definition "The organisation still exists but has suspended its activities, for example while without premises."@en ,
                    "Organisationen finns kvar men har gjort uppehåll i verksamheten, t.ex. i väntan på nya lokaler."@sv ,
                    "L'organisation existe encore mais a suspendu ses activités, par exemple faute de locaux."@fr ,
                    "Die Organisation besteht noch, hat ihre Tätigkeit aber eingestellt, zum Beispiel solange sie keine Räumlichkeiten hat."@de ,
                    "L'organizzazione esiste ancora ma ha sospeso le attività, per esempio perché senza locali."@it ,
                    "La organización sigue existiendo pero ha suspendido sus actividades, por ejemplo mientras no tiene local."@es ,
                    "A organização continua a existir mas suspendeu as suas atividades, por exemplo enquanto não tem instalações."@pt .

mbrc:mergedOrganization a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationStatuses ; skos:topConceptOf mbrc:OrganizationStatuses ;
    skos:prefLabel "Merged"@en , "Sammanslagen"@sv , "Fusionnée"@fr , "Fusioniert"@de , "Fusa"@it , "Fusionada"@es , "Fundida"@pt ;
    skos:definition "The organisation no longer exists on its own, having merged into another. Record the merger as an org:ChangeEvent."@en ,
                    "Organisationen finns inte längre självständigt, eftersom den gått upp i en annan. Registrera sammanslagningen som en org:ChangeEvent."@sv ,
                    "L'organisation n'existe plus en propre, car elle a fusionné avec une autre. Consigner la fusion comme une org:ChangeEvent."@fr ,
                    "Die Organisation besteht nicht mehr für sich, da sie in eine andere aufgegangen ist. Die Fusion als org:ChangeEvent festhalten."@de ,
                    "L'organizzazione non esiste più in quanto tale, essendo confluita in un'altra. La fusione si registra come org:ChangeEvent."@it ,
                    "La organización ya no existe por sí sola, por haberse fusionado con otra. La fusión se registra como un org:ChangeEvent."@es ,
                    "A organização já não existe por si, por se ter fundido com outra. A fusão regista-se como um org:ChangeEvent."@pt .

mbrc:closedOrganization a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationStatuses ; skos:topConceptOf mbrc:OrganizationStatuses ;
    skos:prefLabel "Closed"@en , "Nedlagd"@sv , "Dissoute"@fr , "Aufgelöst"@de , "Chiusa"@it , "Cerrada"@es , "Encerrada"@pt ;
    skos:altLabel "Defunct"@en , "Upplöst"@sv , "Sciolta"@it ;
    skos:definition "The organisation has been wound up."@en , "Organisationen har upplösts."@sv , "L'organisation a été liquidée."@fr , "Die Organisation wurde abgewickelt."@de , "L'organizzazione è stata messa in liquidazione."@it , "La organización ha sido liquidada."@es , "A organização foi liquidada."@pt .

mbrc:suppressedOrganization a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationStatuses ; skos:topConceptOf mbrc:OrganizationStatuses ;
    skos:prefLabel "Suppressed"@en , "Förbjuden"@sv , "Interdite"@fr , "Verboten"@de , "Soppressa"@it , "Suprimida"@es , "Suprimida"@pt ;
    skos:definition "The organisation has been banned or dissolved by the state and may not operate, although it may be refounded later."@en ,
                    "Organisationen har förbjudits eller upplösts av staten och får inte verka, men kan senare återgrundas."@sv ,
                    "L'organisation a été interdite ou dissoute par l'État et ne peut agir, mais peut être refondée plus tard."@fr ,
                    "Die Organisation wurde vom Staat verboten oder aufgelöst und darf nicht tätig sein, kann aber später neu gegründet werden."@de ,
                    "L'organizzazione è stata vietata o sciolta dallo Stato e non può operare, ma può essere rifondata in seguito."@it ,
                    "La organización ha sido prohibida o disuelta por el Estado y no puede funcionar, aunque pueda refundarse más tarde."@es ,
                    "A organização foi proibida ou dissolvida pelo Estado e não pode funcionar, embora possa ser refundada mais tarde."@pt .

mbrc:inExileOrganization a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OrganizationStatuses ; skos:topConceptOf mbrc:OrganizationStatuses ;
    skos:prefLabel "In Exile"@en , "I exil"@sv , "En exil"@fr , "Im Exil"@de , "In esilio"@it , "En el exilio"@es , "No exílio"@pt ;
    skos:definition "The organisation carries on its activity outside its country, because it cannot work there."@en ,
                    "Organisationen bedriver sin verksamhet utanför sitt land, eftersom den inte kan verka där."@sv ,
                    "L'organisation poursuit son activité hors de son pays, parce qu'elle ne peut y travailler."@fr ,
                    "Die Organisation setzt ihre Tätigkeit außerhalb ihres Landes fort, weil sie dort nicht arbeiten kann."@de ,
                    "L'organizzazione continua la sua attività fuori dal proprio paese, perché non può operare al suo interno."@it ,
                    "La organización continúa su actividad fuera de su país, porque no puede trabajar en él."@es ,
                    "A organização continua a sua atividade fora do seu país, porque não pode trabalhar nele."@pt .

##############################################################################
# 14. OWNERSHIP MODELS  (values of mbr:ownershipModel)
##############################################################################

mbrc:OwnershipModels a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Ownership Models"@en , "Ägarformer"@sv , "Modes de propriété"@fr , "Eigentumsmodelle"@de , "Forme di proprietà"@it , "Modelos de propiedad"@es , "Modelos de propriedade"@pt ;
    skos:definition "Who owns and runs a club or society."@en , "Vem som äger och driver en klubb eller ett sällskap."@sv , "Qui possède et dirige un club ou une société."@fr , "Wem ein Club oder eine Gesellschaft gehört und wer sie betreibt."@de , "Chi possiede e dirige un club o una società."@it , "Quién es dueño de un club o sociedad y lo dirige."@es , "Quem é dono de um clube ou sociedade e o dirige."@pt ;
    skos:hasTopConcept mbrc:membersClub , mbrc:proprietaryClub , mbrc:institutionalClub .

mbrc:membersClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OwnershipModels ; skos:topConceptOf mbrc:OwnershipModels ;
    skos:prefLabel "Members' Club"@en , "Medlemsägd klubb"@sv , "Club de membres"@fr , "Mitgliederclub"@de , "Circolo dei soci"@it , "Club de socios"@es , "Clube de sócios"@pt ;
    skos:definition "Owned by its members, who govern it through a committee and share its property."@en ,
                    "Ägs av medlemmarna, som styr den genom en styrelse och delar på dess egendom."@sv ,
                    "Appartient à ses membres, qui la dirigent par un comité et en partagent les biens."@fr ,
                    "Im Eigentum seiner Mitglieder, die ihn durch einen Ausschuss leiten und sein Vermögen teilen."@de ,
                    "Di proprietà dei suoi soci, che lo governano tramite un comitato e ne condividono i beni."@it ,
                    "Propiedad de sus miembros, que lo gobiernan mediante una junta y comparten su patrimonio."@es ,
                    "Propriedade dos seus membros, que o governam através de uma direção e partilham o seu património."@pt .

mbrc:proprietaryClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OwnershipModels ; skos:topConceptOf mbrc:OwnershipModels ;
    skos:prefLabel "Proprietary Club"@en , "Ägarklubb"@sv , "Club à propriétaire"@fr , "Eigentümerclub"@de , "Circolo a proprietà privata"@it , "Club de propietario"@es , "Clube de proprietário"@pt ;
    skos:definition "Owned and run by a proprietor or company for profit; members pay for the use of its facilities but do not own it."@en ,
                    "Ägs och drivs av en ägare eller ett bolag i vinstsyfte; medlemmarna betalar för tillgången men äger den inte."@sv ,
                    "Possédé et exploité par un propriétaire ou une société dans un but lucratif ; les membres paient l'accès aux installations mais n'en sont pas propriétaires."@fr ,
                    "Von einem Eigentümer oder einem Unternehmen auf Gewinn ausgerichtet geführt und besessen; Mitglieder zahlen für die Nutzung der Einrichtungen, besitzen ihn aber nicht."@de ,
                    "Posseduto e gestito da un proprietario o da una società a scopo di lucro; i soci pagano per usarne le strutture ma non ne sono proprietari."@it ,
                    "Propiedad de un propietario o una empresa, que lo dirige con ánimo de lucro; los miembros pagan por el uso de sus instalaciones pero no son sus dueños."@es ,
                    "Propriedade de um proprietário ou de uma empresa, que o dirige com fins lucrativos; os membros pagam pelo uso das suas instalações mas não são seus donos."@pt .

mbrc:institutionalClub a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:OwnershipModels ; skos:topConceptOf mbrc:OwnershipModels ;
    skos:prefLabel "Institutional Club"@en , "Institutionsdriven klubb"@sv , "Club institutionnel"@fr , "Institutionsclub"@de , "Circolo istituzionale"@it , "Club institucional"@es , "Clube institucional"@pt ;
    skos:definition "Owned or run by a parent institution, such as a university, regiment, company or government body."@en ,
                    "Ägs eller drivs av en moderinstitution, t.ex. ett universitet, ett regemente, ett företag eller en myndighet."@sv ,
                    "Possédé ou exploité par une institution mère, comme une université, un régiment, une entreprise ou un organisme public."@fr ,
                    "Im Besitz oder unter der Leitung einer übergeordneten Institution, etwa einer Universität, eines Regiments, eines Unternehmens oder einer Behörde."@de ,
                    "Posseduto o gestito da un'istituzione madre, come un'università, un reggimento, un'impresa o un ente pubblico."@it ,
                    "Propiedad o gestión de una institución matriz, como una universidad, un regimiento, una empresa o un organismo público."@es ,
                    "Propriedade ou gestão de uma instituição-mãe, como uma universidade, um regimento, uma empresa ou um organismo público."@pt .

##############################################################################
# 15. FEE TYPES  (values of mbr:feeType)
##############################################################################

mbrc:FeeTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Fee Types"@en , "Avgiftstyper"@sv , "Types de cotisation"@fr , "Beitragsarten"@de , "Tipi di quota"@it , "Tipos de cuota"@es , "Tipos de quota"@pt ;
    skos:definition "Kinds of membership fee, by when and how often they are paid."@en ,
                    "Typer av medlemsavgift, efter när och hur ofta de betalas."@sv ,
                    "Sortes de cotisations, selon le moment et la fréquence de leur paiement."@fr ,
                    "Arten von Mitgliedsbeiträgen, danach, wann und wie oft sie gezahlt werden."@de ,
                    "Tipi di quota associativa, secondo quando e con quale frequenza si paga."@it ,
                    "Tipos de cuota de socio, según cuándo y con qué frecuencia se pagan."@es ,
                    "Tipos de quota de filiação, consoante quando e com que frequência se pagam."@pt ;
    skos:hasTopConcept mbrc:entranceFee , mbrc:annualFee , mbrc:monthlyFee , mbrc:lifeMembershipFee .

mbrc:entranceFee a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:FeeTypes ; skos:topConceptOf mbrc:FeeTypes ;
    skos:prefLabel "Entrance Fee"@en , "Inträdesavgift"@sv , "Droit d'entrée"@fr , "Aufnahmegebühr"@de , "Quota d'ingresso"@it , "Cuota de entrada"@es , "Joia de admissão"@pt ;
    skos:altLabel "Joining Fee"@en , "Anslutningsavgift"@sv , "Quota di iscrizione"@it ;
    skos:definition "A one-off fee paid on admission."@en , "En engångsavgift som betalas vid upptagningen."@sv , "Somme unique payée lors de l'admission."@fr , "Eine einmalige Gebühr bei der Aufnahme."@de , "Una quota una tantum pagata all'ammissione."@it , "Una cuota única que se paga al ser admitido."@es , "Uma quota única que se paga ao ser admitido."@pt .

mbrc:annualFee a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:FeeTypes ; skos:topConceptOf mbrc:FeeTypes ;
    skos:prefLabel "Annual Fee"@en , "Årsavgift"@sv , "Cotisation annuelle"@fr , "Jahresbeitrag"@de , "Quota annuale"@it , "Cuota anual"@es , "Quota anual"@pt ;
    skos:altLabel "Annual Subscription"@en , "Annual Dues"@en , "Quota annua"@it ;
    skos:definition "A fee paid every year to remain a member."@en , "En avgift som betalas varje år för att förbli medlem."@sv , "Somme payée chaque année pour rester membre."@fr , "Ein Beitrag, der jedes Jahr zu zahlen ist, um Mitglied zu bleiben."@de , "Una quota pagata ogni anno per restare socio."@it , "Una cuota que se paga cada año para seguir siendo miembro."@es , "Uma quota que se paga todos os anos para continuar a ser membro."@pt .

mbrc:monthlyFee a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:FeeTypes ; skos:topConceptOf mbrc:FeeTypes ;
    skos:prefLabel "Monthly Fee"@en , "Månadsavgift"@sv , "Cotisation mensuelle"@fr , "Monatsbeitrag"@de , "Quota mensile"@it , "Cuota mensual"@es , "Quota mensal"@pt ;
    skos:definition "A fee paid every month to remain a member, as is usual in trade unions."@en ,
                    "En avgift som betalas varje månad för att förbli medlem, som är vanligt i fackföreningar."@sv ,
                    "Somme payée chaque mois pour rester membre, comme c'est l'usage dans les syndicats."@fr ,
                    "Ein Beitrag, der jeden Monat zu zahlen ist, um Mitglied zu bleiben, wie bei Gewerkschaften üblich."@de ,
                    "Una quota pagata ogni mese per restare socio, come è d'uso nei sindacati."@it ,
                    "Una cuota que se paga cada mes para seguir siendo miembro, como es habitual en los sindicatos."@es ,
                    "Uma quota que se paga todos os meses para continuar a ser membro, como é habitual nos sindicatos."@pt .

mbrc:lifeMembershipFee a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:FeeTypes ; skos:topConceptOf mbrc:FeeTypes ;
    skos:prefLabel "Life Membership Fee"@en , "Avgift för ständigt medlemskap"@sv , "Cotisation à vie"@fr , "Beitrag für lebenslange Mitgliedschaft"@de , "Quota di socio a vita"@it , "Cuota de pertenencia vitalicia"@es , "Quota de filiação vitalícia"@pt ;
    skos:definition "A one-off fee that buys membership for life (see mbrc:life)."@en ,
                    "En engångsavgift som ger medlemskap på livstid (se mbrc:life)."@sv ,
                    "Somme unique qui achète l'adhésion à vie (voir mbrc:life)."@fr ,
                    "Eine einmalige Gebühr, die die Mitgliedschaft auf Lebenszeit erwirbt (siehe mbrc:life)."@de ,
                    "Una quota una tantum che compra l'appartenenza per la vita (vedi mbrc:life)."@it ,
                    "Una cuota única que compra la pertenencia de por vida (véase mbrc:life)."@es ,
                    "Uma quota única que compra a filiação para toda a vida (ver mbrc:life)."@pt .

##############################################################################
# 16. LEGAL FORMS  (values of rov:orgType)
##############################################################################

mbrc:LegalForms a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Legal Forms"@en , "Associationsformer"@sv , "Formes juridiques"@fr , "Rechtsformen"@de , "Forme giuridiche"@it , "Formas jurídicas"@es , "Formas jurídicas"@pt ;
    skos:definition "Nation-neutral kinds of legal form for membership organisations, used with rov:orgType from the W3C Registered Organization Vocabulary. They say whether and how an organisation is a legal person of its own, not which national statute it falls under. Where a jurisdiction has its own list (such as the ISO 20275 entity legal forms), map that list to these values with SKOS mapping properties."@en ,
                    "Nationsneutrala slag av associationsform för medlemsorganisationer, används med rov:orgType från W3C:s Registered Organization Vocabulary. De anger om och hur en organisation är en egen juridisk person, inte under vilken nationell lag den faller. Där en jurisdiktion har en egen lista (som ISO 20275 för juridiska former) kopplas den listan till dessa värden med SKOS-kopplingar."@sv ,
                    "Sortes de formes juridiques, neutres quant au pays, pour les organisations de membres, utilisées avec rov:orgType du vocabulaire W3C des organisations enregistrées. Elles disent si et comment une organisation est une personne morale, et non de quelle loi nationale elle relève. Lorsqu'une juridiction a sa propre liste (comme les formes juridiques de l'ISO 20275), associer cette liste à ces valeurs avec les propriétés de correspondance SKOS."@fr ,
                    "Länderneutrale Arten der Rechtsform für Mitgliederorganisationen, verwendet mit rov:orgType aus dem W3C Registered Organization Vocabulary. Sie sagen, ob und wie eine Organisation eine eigene juristische Person ist, nicht unter welches nationale Gesetz sie fällt. Wo eine Rechtsordnung eine eigene Liste hat (etwa die Rechtsformen nach ISO 20275), ist diese Liste mit SKOS-Abbildungseigenschaften auf diese Werte abzubilden."@de ,
                    "Tipi di forma giuridica, neutri rispetto al paese, per le organizzazioni associative, usati con rov:orgType del Registered Organization Vocabulary del W3C. Dicono se e come un'organizzazione è una persona giuridica a sé, non a quale legge nazionale è soggetta. Dove una giurisdizione ha un proprio elenco (come le forme giuridiche delle entità secondo l'ISO 20275), quell'elenco si associa a questi valori con le proprietà di corrispondenza SKOS."@it ,
                    "Tipos de forma jurídica neutros respecto a la nación para organizaciones de miembros, usados con rov:orgType del Vocabulario de organizaciones registradas del W3C. Dicen si una organización es persona jurídica propia y cómo, no a qué ley nacional se somete. Cuando una jurisdicción tiene su propia lista (como las formas jurídicas de entidad de la norma ISO 20275), esa lista se asocia a estos valores con propiedades de correspondencia SKOS."@es ,
                    "Tipos de forma jurídica neutros quanto à nação para organizações de membros, usados com rov:orgType do Vocabulário de organizações registadas do W3C. Dizem se uma organização é pessoa jurídica própria e como, não a que lei nacional se submete. Quando uma jurisdição tem a sua própria lista (como as formas jurídicas de entidade da norma ISO 20275), essa lista associa-se a estes valores com propriedades de correspondência SKOS."@pt ;
    skos:scopeNote "Compulsory memberships and economic-benefit memberships, such as professional chambers, mutual insurers and cooperatives whose members are customers, are outside the scope of the membership model and so of this list (compare the scope note on mbr:MembershipOrganization)."@en ,
                   "Obligatoriska medlemskap och medlemskap för ekonomisk nytta, som yrkeskårer, ömsesidiga försäkringsbolag och kooperativ vars medlemmar är kunder, ligger utanför medlemsmodellen och därmed utanför den här listan (jämför omfattningsanmärkningen vid mbr:MembershipOrganization)."@sv ,
                   "Les adhésions obligatoires et les adhésions procurant un avantage économique, comme les chambres professionnelles, les mutuelles d'assurance et les coopératives dont les membres sont des clients, sortent du champ du modèle d'adhésion et donc de cette liste (voir la note d'application de mbr:MembershipOrganization)."@fr ,
                   "Pflichtmitgliedschaften und Mitgliedschaften mit wirtschaftlichem Nutzen, etwa berufsständische Kammern, Versicherungsvereine auf Gegenseitigkeit und Genossenschaften, deren Mitglieder Kunden sind, liegen außerhalb des Mitgliedschaftsmodells und damit dieser Liste (vgl. die Anmerkung zu mbr:MembershipOrganization)."@de ,
                   "Le appartenenze obbligatorie e quelle che danno un vantaggio economico, come le camere professionali, le mutue assicuratrici e le cooperative i cui soci sono clienti, restano fuori dal campo del modello di appartenenza e quindi da questa lista (si confronti la nota di ambito di mbr:MembershipOrganization)."@it ,
                   "Las pertenencias obligatorias y las que dan un beneficio económico, como las cámaras profesionales, las mutuas de seguros y las cooperativas cuyos miembros son clientes, quedan fuera del alcance del modelo de pertenencia y, por tanto, de esta lista (compárese la nota de alcance de mbr:MembershipOrganization)."@es ,
                   "As filiações obrigatórias e as que dão um benefício económico, como as câmaras profissionais, as mútuas de seguros e as cooperativas cujos membros são clientes, ficam fora do âmbito do modelo de filiação e, por isso, desta lista (compare-se a nota de âmbito de mbr:MembershipOrganization)."@pt ;
    skos:hasTopConcept mbrc:unincorporated , mbrc:incorporatedAssociation ,
                       mbrc:foundation , mbrc:company , mbrc:publicLawBody .

mbrc:unincorporated a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:LegalForms ; skos:topConceptOf mbrc:LegalForms ;
    skos:prefLabel "Unincorporated"@en , "Utan juridisk person"@sv , "Sans personnalité morale"@fr , "Nicht rechtsfähig"@de , "Senza personalità giuridica"@it , "Sin personalidad jurídica"@es , "Sem personalidade jurídica"@pt ;
    skos:altLabel "Informal"@en , "Unincorporated association"@en , "Oregistrerad sammanslutning"@sv , "Associazione non riconosciuta"@it , "Informale"@it ;
    skos:definition "A group that is not a legal person of its own: it cannot hold property or sign contracts in its own name, and its members or officers act in their own names. Includes informal circles (mbrc:informalCircle) and associations that have not completed the steps their law requires for legal personality."@en ,
                    "En grupp som inte är en egen juridisk person: den kan inte äga egendom eller ingå avtal i eget namn, och medlemmarna eller funktionärerna agerar i eget namn. Hit hör informella sällskap (mbrc:informalCircle) och föreningar som inte tagit de steg som lagen kräver för att bli juridisk person."@sv ,
                    "Groupe qui n'est pas une personne morale : il ne peut pas posséder de biens ni conclure de contrats en son propre nom, et ses membres ou responsables agissent en leur nom propre. Comprend les cercles informels (mbrc:informalCircle) et les associations qui n'ont pas accompli les formalités que leur droit exige pour la personnalité morale."@fr ,
                    "Eine Gruppe, die keine eigene juristische Person ist: Sie kann nicht in eigenem Namen Eigentum halten oder Verträge schließen, und ihre Mitglieder oder Amtsträger handeln in eigenem Namen. Dazu gehören informelle Kreise (mbrc:informalCircle) und Vereinigungen, die die nach ihrem Recht für die Rechtsfähigkeit nötigen Schritte nicht vollzogen haben."@de ,
                    "Un gruppo che non è una persona giuridica a sé: non può possedere beni né firmare contratti a proprio nome, e i suoi soci o titolari di cariche agiscono a nome proprio. Comprende le cerchie informali (mbrc:informalCircle) e le associazioni che non hanno compiuto i passi che la loro legge richiede per la personalità giuridica."@it ,
                    "Un grupo que no es persona jurídica propia: no puede tener bienes ni firmar contratos en su propio nombre, y sus miembros o cargos actúan en nombre propio. Incluye los círculos informales (mbrc:informalCircle) y las asociaciones que no han completado los trámites que su ley exige para la personalidad jurídica."@es ,
                    "Um grupo que não é pessoa jurídica própria: não pode ter bens nem assinar contratos em nome próprio, e os seus membros ou titulares de cargos agem em nome próprio. Inclui os círculos informais (mbrc:informalCircle) e as associações que não cumpriram os trâmites que a sua lei exige para a personalidade jurídica."@pt ;
    skos:note "Examples: a French association non déclarée (ISO 20275 ELF 491H); a German nicht rechtsfähiger Verein; a kotteri. The Italian associazione non riconosciuta (Codice civile art. 36-38) is only a loose fit: it has no legal personality but a common fund, and the persons who acted in its name also answer personally for its debts."@en , "Exempel: en fransk association non déclarée (ISO 20275 ELF 491H), en tysk nicht rechtsfähiger Verein, ett kotteri. Den italienska associazione non riconosciuta (Codice civile art. 36–38) passar bara löst: den är ingen juridisk person men har en gemensam fond, och de som handlat i dess namn svarar även personligen för dess skulder."@sv , "Exemples : une association non déclarée française (ISO 20275 ELF 491H) ; un nicht rechtsfähiger Verein allemand ; un kotteri. L'associazione non riconosciuta italienne (Codice civile art. 36-38) ne convient que de loin : elle n'a pas la personnalité juridique mais un fonds commun, et les personnes qui ont agi en son nom répondent aussi personnellement de ses dettes."@fr , "Beispiele: eine französische association non déclarée (ISO 20275 ELF 491H); ein deutscher nicht rechtsfähiger Verein; ein kotteri. Die italienische associazione non riconosciuta (Codice civile Art. 36–38) passt nur bedingt: Sie hat keine Rechtspersönlichkeit, aber ein gemeinsames Vermögen, und die in ihrem Namen Handelnden haften auch persönlich für ihre Schulden."@de , "Esempi: un'association non déclarée francese (ISO 20275 ELF 491H); un nicht rechtsfähiger Verein tedesco; un kotteri. L'associazione non riconosciuta italiana (Codice civile art. 36-38) vi rientra solo in modo approssimativo: non ha personalità giuridica ma ha un fondo comune, e le persone che hanno agito in suo nome rispondono anche personalmente dei suoi debiti."@it , "Ejemplos: una association non déclarée francesa (ISO 20275 ELF 491H); un nicht rechtsfähiger Verein alemán; un kotteri. La associazione non riconosciuta italiana (Código civil, arts. 36-38) solo encaja de forma aproximada: no tiene personalidad jurídica pero sí un fondo común, y las personas que actuaron en su nombre responden también personalmente de sus deudas."@es , "Exemplos: uma association non déclarée francesa (ISO 20275 ELF 491H); um nicht rechtsfähiger Verein alemão; um kotteri. A associazione non riconosciuta italiana (Código Civil, arts. 36-38) só se ajusta de forma aproximada: não tem personalidade jurídica mas tem um fundo comum, e as pessoas que agiram em seu nome respondem também pessoalmente pelas suas dívidas."@pt ;
    skos:related mbrc:informalCircle .

mbrc:incorporatedAssociation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:LegalForms ; skos:topConceptOf mbrc:LegalForms ;
    skos:prefLabel "Incorporated Association"@en , "Förening som juridisk person"@sv , "Association dotée de la personnalité morale"@fr , "Rechtsfähige Vereinigung"@de , "Associazione con personalità giuridica"@it , "Asociación con personalidad jurídica"@es , "Associação com personalidade jurídica"@pt ;
    skos:definition "A non-profit association that is a legal person of its own, whether it gets that status by registration or simply by adopting statutes and appointing a board."@en ,
                    "En ideell sammanslutning som är en egen juridisk person, oavsett om den får den ställningen genom registrering eller bara genom att anta stadgar och utse en styrelse."@sv ,
                    "Association à but non lucratif qui est une personne morale, que ce statut résulte d'un enregistrement ou simplement de l'adoption de statuts et de la désignation d'un bureau."@fr ,
                    "Eine gemeinnützige Vereinigung, die eine eigene juristische Person ist, sei es durch Eintragung oder schlicht dadurch, dass sie sich eine Satzung gibt und einen Vorstand bestellt."@de ,
                    "Un'associazione senza scopo di lucro che è una persona giuridica a sé, sia che ottenga quella condizione con la registrazione, sia semplicemente adottando uno statuto e nominando un consiglio direttivo."@it ,
                    "Una asociación sin ánimo de lucro que es persona jurídica propia, tanto si obtiene ese estatus por inscripción como si basta con adoptar estatutos y nombrar una junta."@es ,
                    "Uma associação sem fins lucrativos que é pessoa jurídica própria, quer obtenha esse estatuto por registo, quer baste adotar estatutos e nomear uma direção."@pt ;
    skos:note "Example without registration: a Swedish ideell förening."@en , "Exempel utan registrering: en svensk ideell förening."@sv , "Exemple sans enregistrement : une ideell förening suédoise."@fr , "Beispiel ohne Eintragung: eine schwedische ideell förening."@de , "Esempio senza registrazione: una ideell förening svedese."@it , "Ejemplo sin inscripción: una ideell förening sueca."@es , "Exemplo sem registo: uma ideell förening sueca."@pt ;
    skos:narrower mbrc:registeredAssociation .

mbrc:registeredAssociation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:LegalForms ; skos:broader mbrc:incorporatedAssociation ;
    skos:prefLabel "Registered Association"@en , "Registrerad förening"@sv , "Association déclarée ou enregistrée"@fr , "Eingetragene Vereinigung"@de , "Associazione registrata"@it , "Asociación inscrita"@es , "Associação registada"@pt ;
    skos:definition "An incorporated association that becomes a legal person by being entered in, or declared to, a public register. The register entry can carry an identifier (see rov:registration)."@en ,
                    "En förening som blir juridisk person genom att föras in i eller anmälas till ett offentligt register. Registerposten kan ha ett identifierande nummer (se rov:registration)."@sv ,
                    "Association dotée de la personnalité morale qui l'acquiert par son inscription, ou sa déclaration, à un registre public. L'inscription au registre peut porter un identifiant (voir rov:registration)."@fr ,
                    "Eine rechtsfähige Vereinigung, die dadurch juristische Person wird, dass sie in ein öffentliches Register eingetragen oder bei ihm angemeldet wird. Der Registereintrag kann eine Kennung tragen (siehe rov:registration)."@de ,
                    "Un'associazione con personalità giuridica che diventa persona giuridica essendo iscritta in un registro pubblico, o dichiarata a esso. L'iscrizione al registro può portare un identificativo (vedi rov:registration)."@it ,
                    "Una asociación con personalidad jurídica que la adquiere al inscribirse en un registro público o al declararse a él. La inscripción puede llevar un identificador (véase rov:registration)."@es ,
                    "Uma associação com personalidade jurídica que a adquire ao inscrever-se num registo público ou ao declarar-se a ele. A inscrição pode ter um identificador (ver rov:registration)."@pt ;
    skos:note "Examples: a German eingetragener Verein (ISO 20275 ELF QZ3L); a French association déclarée (ELF BEWI), including its Alsace-Moselle local-law form (ELF HF2L); an Italian associazione riconosciuta, entered in the register of legal persons (D.P.R. 361/2000) or, for a Terzo settore entity, in the RUNTS."@en , "Exempel: en tysk eingetragener Verein (ISO 20275 ELF QZ3L), en fransk association déclarée (ELF BEWI) med dess lokala form i Alsace-Moselle (ELF HF2L), en italiensk associazione riconosciuta, införd i registret över juridiska personer (D.P.R. 361/2000) eller, för en enhet inom tredje sektorn, i RUNTS."@sv , "Exemples : un eingetragener Verein allemand (ISO 20275 ELF QZ3L) ; une association déclarée française (ELF BEWI), y compris sa forme de droit local d'Alsace-Moselle (ELF HF2L) ; une associazione riconosciuta italienne, inscrite au registre des personnes morales (D.P.R. 361/2000) ou, pour une entité du tiers secteur, au RUNTS."@fr , "Beispiele: ein deutscher eingetragener Verein (ISO 20275 ELF QZ3L); eine französische association déclarée (ELF BEWI), einschließlich ihrer Form des Lokalrechts in Elsass-Lothringen (ELF HF2L); eine italienische associazione riconosciuta, eingetragen im Register der juristischen Personen (D.P.R. 361/2000) oder, bei einer Einrichtung des Dritten Sektors, im RUNTS."@de , "Esempi: un eingetragener Verein tedesco (ISO 20275 ELF QZ3L); un'association déclarée francese (ELF BEWI), compresa la sua forma di diritto locale in Alsazia-Mosella (ELF HF2L); un'associazione riconosciuta italiana, iscritta nel registro delle persone giuridiche (D.P.R. 361/2000) o, per un ente del Terzo settore, nel RUNTS."@it , "Ejemplos: un eingetragener Verein alemán (ISO 20275 ELF QZ3L); una association déclarée francesa (ELF BEWI), incluida su forma de derecho local de Alsacia-Mosela (ELF HF2L); una associazione riconosciuta italiana, inscrita en el registro de personas jurídicas (D.P.R. 361/2000) o, para una entidad del Tercer Sector, en el RUNTS."@es , "Exemplos: um eingetragener Verein alemão (ISO 20275 ELF QZ3L); uma association déclarée francesa (ELF BEWI), incluindo a sua forma de direito local da Alsácia-Mosela (ELF HF2L); uma associazione riconosciuta italiana, inscrita no registo das pessoas jurídicas (D.P.R. 361/2000) ou, para uma entidade do Terceiro Setor, no RUNTS."@pt .

mbrc:foundation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:LegalForms ; skos:topConceptOf mbrc:LegalForms ;
    skos:prefLabel "Foundation"@en , "Stiftelse"@sv , "Fondation"@fr , "Stiftung"@de , "Fondazione"@it , "Fundación"@es , "Fundação"@pt ;
    skos:definition "A legal person formed by dedicating assets to a purpose, with no members of its own. A membership organisation can be run or funded by a foundation."@en ,
                    "En juridisk person som bildas genom att egendom avsätts för ett ändamål, utan egna medlemmar. En medlemsorganisation kan drivas eller finansieras av en stiftelse."@sv ,
                    "Personne morale constituée par l'affectation de biens à un but, sans membres propres. Une organisation de membres peut être dirigée ou financée par une fondation."@fr ,
                    "Eine juristische Person, die durch die Widmung von Vermögen für einen Zweck entsteht und keine eigenen Mitglieder hat. Eine Mitgliederorganisation kann von einer Stiftung geführt oder finanziert werden."@de ,
                    "Una persona giuridica formata destinando un patrimonio a uno scopo, senza soci propri. Un'organizzazione associativa può essere gestita o finanziata da una fondazione."@it ,
                    "Una persona jurídica formada al dedicar un patrimonio a un fin, sin miembros propios. Una organización de miembros puede ser dirigida o financiada por una fundación."@es ,
                    "Uma pessoa jurídica formada ao dedicar um património a um fim, sem membros próprios. Uma organização de membros pode ser dirigida ou financiada por uma fundação."@pt ;
    skos:note "Examples: a French fondation (ISO 20275 ELF 9T5S); a German Stiftung des privaten Rechts (ELF V2YH)."@en , "Exempel: en fransk fondation (ISO 20275 ELF 9T5S), en tysk Stiftung des privaten Rechts (ELF V2YH)."@sv , "Exemples : une fondation française (ISO 20275 ELF 9T5S) ; une Stiftung des privaten Rechts allemande (ELF V2YH)."@fr , "Beispiele: eine französische fondation (ISO 20275 ELF 9T5S); eine deutsche Stiftung des privaten Rechts (ELF V2YH)."@de , "Esempi: una fondation francese (ISO 20275 ELF 9T5S); una Stiftung des privaten Rechts tedesca (ELF V2YH)."@it , "Ejemplos: una fondation francesa (ISO 20275 ELF 9T5S); una Stiftung des privaten Rechts alemana (ELF V2YH)."@es , "Exemplos: uma fondation francesa (ISO 20275 ELF 9T5S); uma Stiftung des privaten Rechts alemã (ELF V2YH)."@pt .

mbrc:company a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:LegalForms ; skos:topConceptOf mbrc:LegalForms ;
    skos:prefLabel "Company"@en , "Bolag"@sv , "Société commerciale"@fr , "Handelsgesellschaft"@de , "Società commerciale"@it , "Sociedad mercantil"@es , "Sociedade comercial"@pt ;
    skos:definition "A legal person with owners or shareholders, used by proprietary clubs (see mbrc:proprietaryClub) and by clubs that are limited by guarantee."@en ,
                    "En juridisk person med ägare eller aktieägare, som används av ägarklubbar (se mbrc:proprietaryClub) och av klubbar som är garantibegränsade."@sv ,
                    "Personne morale à propriétaires ou actionnaires, utilisée par les clubs à propriétaire (voir mbrc:proprietaryClub) et par les clubs à responsabilité limitée par garantie."@fr ,
                    "Eine juristische Person mit Eigentümern oder Gesellschaftern, verwendet von Eigentümerclubs (siehe mbrc:proprietaryClub) und von Clubs, deren Haftung begrenzt ist."@de ,
                    "Una persona giuridica con proprietari o azionisti, usata dai circoli a proprietà privata (vedi mbrc:proprietaryClub) e dai circoli a responsabilità limitata dalla garanzia."@it ,
                    "Una persona jurídica con propietarios o accionistas, usada por los clubes de propietario (véase mbrc:proprietaryClub) y por los clubes limitados por garantía."@es ,
                    "Uma pessoa jurídica com proprietários ou acionistas, usada pelos clubes de proprietário (ver mbrc:proprietaryClub) e pelos clubes limitados por garantia."@pt .

mbrc:publicLawBody a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:LegalForms ; skos:topConceptOf mbrc:LegalForms ;
    skos:prefLabel "Public-Law Body"@en , "Offentligrättslig juridisk person"@sv , "Personne morale de droit public"@fr , "Öffentlich-rechtliche Körperschaft"@de , "Ente di diritto pubblico"@it , "Entidad de derecho público"@es , "Entidade de direito público"@pt ;
    skos:definition "A legal person created or recognised by public law, such as a state institution or a corporation of public law, as opposed to one formed by private agreement."@en ,
                    "En juridisk person som skapats eller erkänns genom offentlig rätt, som en statlig institution eller en offentligrättslig korporation, till skillnad från en som bildats genom privat avtal."@sv ,
                    "Personne morale créée ou reconnue par le droit public, comme une institution d'État ou une corporation de droit public, par opposition à celle formée par accord privé."@fr ,
                    "Eine juristische Person, die durch öffentliches Recht geschaffen oder anerkannt ist, etwa eine staatliche Einrichtung oder eine Körperschaft des öffentlichen Rechts, im Gegensatz zu einer durch private Vereinbarung gebildeten."@de ,
                    "Una persona giuridica creata o riconosciuta dal diritto pubblico, come un'istituzione statale o una corporazione di diritto pubblico, in contrapposizione a una formata per accordo privato."@it ,
                    "Una persona jurídica creada o reconocida por el derecho público, como una institución del Estado o una corporación de derecho público, frente a una formada por acuerdo privado."@es ,
                    "Uma pessoa jurídica criada ou reconhecida pelo direito público, como uma instituição do Estado ou uma corporação de direito público, por oposição a uma formada por acordo privado."@pt ;
    skos:note "Example: a German Körperschaft des öffentlichen Rechts (ISO 20275 ELF SQKS)."@en , "Exempel: en tysk Körperschaft des öffentlichen Rechts (ISO 20275 ELF SQKS)."@sv , "Exemple : une Körperschaft des öffentlichen Rechts allemande (ISO 20275 ELF SQKS)."@fr , "Beispiel: eine deutsche Körperschaft des öffentlichen Rechts (ISO 20275 ELF SQKS)."@de , "Esempio: una Körperschaft des öffentlichen Rechts tedesca (ISO 20275 ELF SQKS)."@it , "Ejemplo: una Körperschaft des öffentlichen Rechts alemana (ISO 20275 ELF SQKS)."@es , "Exemplo: uma Körperschaft des öffentlichen Rechts alemã (ISO 20275 ELF SQKS)."@pt .

##############################################################################
# 17. PUBLIC BENEFIT STATUSES  (values of mbr:publicBenefitStatus)
##############################################################################

mbrc:PublicBenefitStatuses a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Public Benefit Statuses"@en , "Allmännyttiga statusar"@sv , "Statuts d'utilité publique"@fr , "Gemeinnützigkeitsstatus"@de , "Status di pubblica utilità"@it , "Estatus de utilidad pública"@es , "Estatutos de utilidade pública"@pt ;
    skos:definition "Public-benefit statuses that an organisation can have, such as recognition as serving the public good or relief from tax as a charity. Used with mbr:publicBenefitStatus."@en ,
                    "Allmännyttiga statusar som en organisation kan ha, till exempel erkännande som tjänande det allmänna bästa eller skattelättnad som välgörenhetsorganisation. Används med mbr:publicBenefitStatus."@sv ,
                    "Statuts d'utilité publique qu'une organisation peut avoir, comme la reconnaissance de servir l'intérêt général ou l'allègement fiscal d'un organisme caritatif. S'utilisent avec mbr:publicBenefitStatus."@fr ,
                    "Gemeinnützigkeitsstatus, die eine Organisation haben kann, etwa die Anerkennung, dem Gemeinwohl zu dienen, oder die Steuererleichterung einer gemeinnützigen Körperschaft. Werden mit mbr:publicBenefitStatus verwendet."@de ,
                    "Status di pubblica utilità che un'organizzazione può avere, come il riconoscimento di servire il bene comune o l'agevolazione fiscale di un ente benefico. Si usano con mbr:publicBenefitStatus."@it ,
                    "Estatus de utilidad pública que puede tener una organización, como el reconocimiento de que sirve al bien común o la exención fiscal como entidad benéfica. Se usa con mbr:publicBenefitStatus."@es ,
                    "Estatutos de utilidade pública que uma organização pode ter, como o reconhecimento de que serve o bem comum ou a isenção fiscal como entidade de beneficência. Usa-se com mbr:publicBenefitStatus."@pt ;
    skos:scopeNote "The statuses of one country are in schemes of their own that say dcterms:isPartOf this scheme (see mbrc:ItalianThirdSectorStatuses). A status of the country is mapped to a concept here where there is a counterpart."@en ,
                   "Ett lands statusar finns i egna scheman som anger dcterms:isPartOf detta schema (se mbrc:ItalianThirdSectorStatuses). En status i landet mappas till ett begrepp här där det finns en motsvarighet."@sv ,
                   "Les statuts d'un pays sont dans des schémas propres qui indiquent dcterms:isPartOf ce schéma (voir mbrc:ItalianThirdSectorStatuses). Un statut du pays est associé à un concept d'ici lorsqu'il existe un équivalent."@fr ,
                   "Die Status eines Landes stehen in eigenen Schemata, die dcterms:isPartOf dieses Schema angeben (siehe mbrc:ItalianThirdSectorStatuses). Ein Status des Landes wird einem Konzept hier zugeordnet, wo es eine Entsprechung gibt."@de ,
                   "Gli status di un paese sono in schemi propri che indicano dcterms:isPartOf questo schema (vedi mbrc:ItalianThirdSectorStatuses). Uno status del paese è associato a un concetto qui dove esiste un equivalente."@it ,
                   "Los estatus de un país están en esquemas propios que dicen dcterms:isPartOf este esquema (véase mbrc:ItalianThirdSectorStatuses). Un estatus del país se asocia a un concepto de aquí donde hay uno equivalente."@es ,
                   "Os estatutos de um país estão em esquemas próprios que dizem dcterms:isPartOf este esquema (ver mbrc:ItalianThirdSectorStatuses). Um estatuto do país associa-se a um conceito daqui onde haja um equivalente."@pt ;
    skos:hasTopConcept mbrc:publicBenefit , mbrc:taxExemptCharity .

mbrc:publicBenefit a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:PublicBenefitStatuses ; skos:topConceptOf mbrc:PublicBenefitStatuses ;
    skos:prefLabel "Public Benefit"@en , "Allmännytta"@sv , "Utilité publique"@fr , "Gemeinwohlanerkennung"@de , "Pubblica utilità"@it , "Utilidad pública"@es , "Utilidade pública"@pt ;
    skos:definition "Recognition by a public authority that the organisation serves the public good, usually with duties (such as reporting and openness) and privileges."@en ,
                    "Erkännande från en myndighet att organisationen tjänar det allmänna bästa, vanligen med skyldigheter (som redovisning och öppenhet) och förmåner."@sv ,
                    "Reconnaissance par une autorité publique que l'organisation sert l'intérêt général, en général avec des obligations (comme la reddition de comptes et la transparence) et des avantages."@fr ,
                    "Anerkennung durch eine öffentliche Stelle, dass die Organisation dem Gemeinwohl dient, meist mit Pflichten (wie Berichtspflicht und Offenheit) und Vorteilen."@de ,
                    "Riconoscimento da parte di un'autorità pubblica che l'organizzazione serve il bene comune, di solito con obblighi (come la rendicontazione e la trasparenza) e vantaggi."@it ,
                    "Reconocimiento por una autoridad pública de que la organización sirve al bien común, normalmente con obligaciones (como informar y ser transparente) y privilegios."@es ,
                    "Reconhecimento por uma autoridade pública de que a organização serve o bem comum, normalmente com deveres (como prestar informação e ser transparente) e privilégios."@pt .

mbrc:taxExemptCharity a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:PublicBenefitStatuses ; skos:topConceptOf mbrc:PublicBenefitStatuses ;
    skos:prefLabel "Tax-exempt Charity"@en , "Skattebefriad välgörenhetsorganisation"@sv , "Organisme caritatif exonéré d'impôt"@fr , "Steuerbegünstigte Gemeinnützigkeit"@de , "Ente benefico esente da imposte"@it , "Entidad benéfica exenta de impuestos"@es , "Entidade de beneficência isenta de impostos"@pt ;
    skos:definition "Recognition by the tax authority that the organisation pursues charitable purposes and is therefore relieved of tax in whole or in part."@en ,
                    "Erkännande från skattemyndigheten att organisationen eftersträvar välgörande ändamål och därför helt eller delvis är befriad från skatt."@sv ,
                    "Reconnaissance par l'administration fiscale que l'organisation poursuit des buts caritatifs et est de ce fait exonérée d'impôt en tout ou en partie."@fr ,
                    "Anerkennung durch die Steuerbehörde, dass die Organisation gemeinnützige Zwecke verfolgt und deshalb ganz oder teilweise von Steuern befreit ist."@de ,
                    "Riconoscimento da parte dell'amministrazione fiscale che l'organizzazione persegue scopi benefici ed è perciò esentata in tutto o in parte dalle imposte."@it ,
                    "Reconocimiento por la autoridad fiscal de que la organización persigue fines benéficos y, por tanto, está exenta de impuestos total o parcialmente."@es ,
                    "Reconhecimento pela autoridade fiscal de que a organização prossegue fins de beneficência e, por isso, está isenta de impostos total ou parcialmente."@pt .

mbrc:ItalianThirdSectorStatuses a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:PublicBenefitStatuses ;
    skos:prefLabel "Statuses under the Italian Third Sector Code"@en , "Statusar enligt den italienska lagen om tredje sektorn"@sv , "Statuts selon le Code du Troisième secteur italien"@fr , "Status nach dem italienischen Kodex des Dritten Sektors"@de , "Status secondo il Codice del Terzo settore"@it , "Estatus según el Código del Tercer Sector italiano"@es , "Estatutos segundo o Código do Terceiro Setor italiano"@pt ;
    skos:definition "The statuses of entities of the Third Sector under the Italian Third Sector Code (Legislative Decree 117 of 3 July 2017): the general status of a Third Sector entity and two of its kinds, the social promotion association and the voluntary organisation. The entities are entered in the national register, the RUNTS."@en ,
                    "Statusarna för enheter i tredje sektorn enligt den italienska lagen om tredje sektorn (lagstiftande dekret 117 av den 3 juli 2017): den allmänna statusen som enhet i tredje sektorn och två av dess slag, föreningen för socialt främjande och frivilligorganisationen. Enheterna förs in i det nationella registret, RUNTS."@sv ,
                    "Les statuts des entités du Troisième secteur selon le Code du Troisième secteur italien (décret législatif 117 du 3 juillet 2017) : le statut général d'entité du Troisième secteur et deux de ses sortes, l'association de promotion sociale et l'organisation de bénévoles. Les entités sont inscrites au registre national, le RUNTS."@fr ,
                    "Die Status der Einrichtungen des Dritten Sektors nach dem italienischen Kodex des Dritten Sektors (Gesetzesdekret 117 vom 3. Juli 2017): der allgemeine Status einer Einrichtung des Dritten Sektors und zwei ihrer Arten, der Verein zur Förderung des Sozialen und die Freiwilligenorganisation. Die Einrichtungen sind im nationalen Register, dem RUNTS, eingetragen."@de ,
                    "Gli status degli enti del Terzo settore secondo il Codice del Terzo settore (decreto legislativo 117 del 3 luglio 2017): lo status generale di ente del Terzo settore e due sue specie, l'associazione di promozione sociale e l'organizzazione di volontariato. Gli enti sono iscritti nel registro nazionale, il RUNTS."@it ,
                    "Los estatus de las entidades del Tercer Sector según el Código del Tercer Sector italiano (Decreto Legislativo 117 de 3 de julio de 2017): el estatus general de entidad del Tercer Sector y dos de sus tipos, la asociación de promoción social y la organización de voluntariado. Las entidades se inscriben en el registro nacional, el RUNTS."@es ,
                    "Os estatutos das entidades do Terceiro Setor segundo o Código do Terceiro Setor italiano (Decreto Legislativo 117, de 3 de julho de 2017): o estatuto geral de entidade do Terceiro Setor e dois dos seus tipos, a associação de promoção social e a organização de voluntariado. As entidades inscrevem-se no registo nacional, o RUNTS."@pt ;
    skos:hasTopConcept mbrc:thirdSectorEntity .

mbrc:thirdSectorEntity a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ItalianThirdSectorStatuses ; skos:topConceptOf mbrc:ItalianThirdSectorStatuses ;
    skos:narrower mbrc:socialPromotionAssociation , mbrc:voluntaryOrganization ;
    skos:prefLabel "Third Sector Entity"@en , "Enhet i tredje sektorn"@sv , "Entité du Troisième secteur"@fr , "Einrichtung des Dritten Sektors"@de , "Ente del Terzo settore"@it , "Entidad del Tercer Sector"@es , "Entidade do Terceiro Setor"@pt ;
    skos:altLabel "ETS"@en ;
    skos:definition "An organisation entered in the national register of Third Sector entities (RUNTS) under the Italian Third Sector Code, with the duties and the tax and other benefits that follow."@en ,
                    "En organisation som förts in i det nationella registret över enheter i tredje sektorn (RUNTS) enligt den italienska lagen om tredje sektorn, med de skyldigheter och de skatte- och andra förmåner som följer."@sv ,
                    "Organisation inscrite au registre national des entités du Troisième secteur (RUNTS) selon le Code du Troisième secteur italien, avec les obligations et les avantages fiscaux et autres qui en découlent."@fr ,
                    "Eine Organisation, die nach dem italienischen Kodex des Dritten Sektors im nationalen Register der Einrichtungen des Dritten Sektors (RUNTS) eingetragen ist, mit den daraus folgenden Pflichten sowie steuerlichen und anderen Vorteilen."@de ,
                    "Un'organizzazione iscritta nel registro nazionale degli enti del Terzo settore (RUNTS) secondo il Codice del Terzo settore, con gli obblighi e i vantaggi fiscali e di altro genere che ne derivano."@it ,
                    "Una organización inscrita en el registro nacional de entidades del Tercer Sector (RUNTS) según el Código del Tercer Sector italiano, con las obligaciones y los beneficios fiscales y de otro tipo que se derivan de ello."@es ,
                    "Uma organização inscrita no registo nacional das entidades do Terceiro Setor (RUNTS) nos termos do Código do Terceiro Setor italiano, com os deveres e os benefícios fiscais e de outro tipo que daí decorrem."@pt .

mbrc:socialPromotionAssociation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ItalianThirdSectorStatuses ; skos:broader mbrc:thirdSectorEntity ;
    skos:prefLabel "Social Promotion Association"@en , "Förening för socialt främjande"@sv , "Association de promotion sociale"@fr , "Verein zur Förderung des Sozialen"@de , "Associazione di promozione sociale"@it , "Asociación de promoción social"@es , "Associação de promoção social"@pt ;
    skos:altLabel "APS"@en ;
    skos:definition "A kind of Third Sector entity: an association for social promotion (associazione di promozione sociale) in the sense of the Italian Third Sector Code."@en ,
                    "En sorts enhet i tredje sektorn: en förening för socialt främjande (associazione di promozione sociale) i den italienska lagens mening."@sv ,
                    "Une sorte d'entité du Troisième secteur : une association de promotion sociale (associazione di promozione sociale) au sens du Code du Troisième secteur italien."@fr ,
                    "Eine Art von Einrichtung des Dritten Sektors: ein Verein zur Förderung des Sozialen (associazione di promozione sociale) im Sinne des italienischen Kodex des Dritten Sektors."@de ,
                    "Una specie di ente del Terzo settore: un'associazione di promozione sociale ai sensi del Codice del Terzo settore."@it ,
                    "Un tipo de entidad del Tercer Sector: una asociación de promoción social (associazione di promozione sociale) en el sentido del Código del Tercer Sector italiano."@es ,
                    "Um tipo de entidade do Terceiro Setor: uma associação de promoção social (associazione di promozione sociale) na aceção do Código do Terceiro Setor italiano."@pt .

mbrc:voluntaryOrganization a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ItalianThirdSectorStatuses ; skos:broader mbrc:thirdSectorEntity ;
    skos:prefLabel "Voluntary Organisation"@en , "Frivilligorganisation"@sv , "Organisation de bénévoles"@fr , "Freiwilligenorganisation"@de , "Organizzazione di volontariato"@it , "Organización de voluntariado"@es , "Organização de voluntariado"@pt ;
    skos:altLabel "ODV"@en ;
    skos:definition "A kind of Third Sector entity: a voluntary organisation (organizzazione di volontariato) in the sense of the Italian Third Sector Code."@en ,
                    "En sorts enhet i tredje sektorn: en frivilligorganisation (organizzazione di volontariato) i den italienska lagens mening."@sv ,
                    "Une sorte d'entité du Troisième secteur : une organisation de bénévoles (organizzazione di volontariato) au sens du Code du Troisième secteur italien."@fr ,
                    "Eine Art von Einrichtung des Dritten Sektors: eine Freiwilligenorganisation (organizzazione di volontariato) im Sinne des italienischen Kodex des Dritten Sektors."@de ,
                    "Una specie di ente del Terzo settore: un'organizzazione di volontariato ai sensi del Codice del Terzo settore."@it ,
                    "Un tipo de entidad del Tercer Sector: una organización de voluntariado (organizzazione di volontariato) en el sentido del Código del Tercer Sector italiano."@es ,
                    "Um tipo de entidade do Terceiro Setor: uma organização de voluntariado (organizzazione di volontariato) na aceção do Código do Terceiro Setor italiano."@pt .

##############################################################################
# 18. CHARTER STATUSES  (values of mbr:charterStatus)
##############################################################################

mbrc:CharterStatuses a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Charter Statuses"@en , "Tillstånd för stiftelsebrev"@sv , "États de la charte"@fr , "Zustände der Urkunde"@de , "Stati della carta"@it , "Estados de la carta constitutiva"@es , "Estados da carta constitutiva"@pt ;
    skos:definition "Whether a charter is in force or has been suspended, given back or withdrawn. Used with mbr:charterStatus."@en ,
                    "Om ett stiftelsebrev gäller eller har stängts av, lämnats tillbaka eller dragits in. Används med mbr:charterStatus."@sv ,
                    "Si une charte est en vigueur ou a été suspendue, rendue ou retirée. S'utilise avec mbr:charterStatus."@fr ,
                    "Ob eine Urkunde gilt oder ruht, zurückgegeben oder entzogen wurde. Wird mit mbr:charterStatus verwendet."@de ,
                    "Se una carta è in vigore o è stata sospesa, restituita o ritirata. Si usa con mbr:charterStatus."@it ,
                    "Si una carta constitutiva está en vigor o ha sido suspendida, devuelta o retirada. Se usa con mbr:charterStatus."@es ,
                    "Se uma carta constitutiva está em vigor ou foi suspensa, devolvida ou retirada. Usa-se com mbr:charterStatus."@pt ;
    skos:hasTopConcept mbrc:charterGranted , mbrc:charterSuspended , mbrc:charterSurrendered , mbrc:charterRevoked .

mbrc:charterGranted a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:CharterStatuses ; skos:topConceptOf mbrc:CharterStatuses ;
    skos:prefLabel "In Force"@en , "Gäller"@sv , "En vigueur"@fr , "In Kraft"@de , "In vigore"@it , "En vigor"@es , "Em vigor"@pt ;
    skos:definition "The charter was granted and has not ended."@en ,
                    "Stiftelsebrevet beviljades och har inte upphört."@sv ,
                    "La charte a été accordée et n'a pas pris fin."@fr ,
                    "Die Urkunde wurde erteilt und ist nicht beendet."@de ,
                    "La carta è stata concessa e non è finita."@it ,
                    "La carta se concedió y no ha terminado."@es ,
                    "A carta foi concedida e não terminou."@pt .

mbrc:charterSuspended a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:CharterStatuses ; skos:topConceptOf mbrc:CharterStatuses ;
    skos:prefLabel "Suspended"@en , "Avstängt"@sv , "Suspendue"@fr , "Ruhend"@de , "Sospesa"@it , "Suspendida"@es , "Suspensa"@pt ;
    skos:definition "The issuing body has suspended the charter for a time; the body that holds it may not act under it meanwhile."@en ,
                    "Det utfärdande organet har stängt av stiftelsebrevet för en tid; det organ som innehar det får under tiden inte verka med stöd av det."@sv ,
                    "L'organe émetteur a suspendu la charte pour un temps ; l'organe qui la détient ne peut pas agir en vertu d'elle dans l'intervalle."@fr ,
                    "Das ausstellende Organ hat die Urkunde für eine Zeit ruhen lassen; das Organ, das sie innehat, darf in dieser Zeit nicht aufgrund von ihr handeln."@de ,
                    "L'organismo emittente ha sospeso la carta per un periodo; nel frattempo l'organismo che la detiene non può operare in base ad essa."@it ,
                    "El organismo emisor ha suspendido la carta por un tiempo; el organismo que la posee no puede actuar al amparo de ella mientras tanto."@es ,
                    "O organismo emissor suspendeu a carta por algum tempo; o organismo que a detém não pode agir ao abrigo dela entretanto."@pt .

mbrc:charterSurrendered a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:CharterStatuses ; skos:topConceptOf mbrc:CharterStatuses ;
    skos:prefLabel "Surrendered"@en , "Återlämnat"@sv , "Rendue"@fr , "Zurückgegeben"@de , "Restituita"@it , "Devuelta"@es , "Devolvida"@pt ;
    skos:definition "The body that held the charter gave it back to the issuing body, for example when it closed or went dormant."@en ,
                    "Det organ som innehade stiftelsebrevet lämnade tillbaka det till det utfärdande organet, till exempel när det lades ned eller vilade."@sv ,
                    "L'organe qui détenait la charte l'a rendue à l'organe émetteur, par exemple en se dissolvant ou en se mettant en sommeil."@fr ,
                    "Das Organ, das die Urkunde innehatte, hat sie dem ausstellenden Organ zurückgegeben, etwa bei Auflösung oder wenn es ruhte."@de ,
                    "L'organismo che deteneva la carta l'ha restituita all'organismo emittente, per esempio quando si è sciolto o è entrato in sonno."@it ,
                    "El organismo que poseía la carta la devolvió al organismo emisor, por ejemplo cuando cerró o quedó latente."@es ,
                    "O organismo que detinha a carta devolveu-a ao organismo emissor, por exemplo quando encerrou ou ficou latente."@pt .

mbrc:charterRevoked a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:CharterStatuses ; skos:topConceptOf mbrc:CharterStatuses ;
    skos:prefLabel "Revoked"@en , "Indraget"@sv , "Retirée"@fr , "Entzogen"@de , "Ritirata"@it , "Revocada"@es , "Revogada"@pt ;
    skos:definition "The issuing body withdrew the charter against the will of the body that held it."@en ,
                    "Det utfärdande organet drog in stiftelsebrevet mot det innehavande organets vilja."@sv ,
                    "L'organe émetteur a retiré la charte contre la volonté de l'organe qui la détenait."@fr ,
                    "Das ausstellende Organ hat die Urkunde gegen den Willen des Organs, das sie innehatte, entzogen."@de ,
                    "L'organismo emittente ha ritirato la carta contro la volontà dell'organismo che la deteneva."@it ,
                    "El organismo emisor retiró la carta contra la voluntad del organismo que la poseía."@es ,
                    "O organismo emissor retirou a carta contra a vontade do organismo que a detinha."@pt .

##############################################################################
# 19. CHANGE EVENT TYPES  (values of mbr:changeEventType on an org:ChangeEvent)
##############################################################################

mbrc:ChangeEventTypes a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Change Event Types"@en , "Typer av organisationsförändringar"@sv , "Types de changements d'organisation"@fr , "Arten von Organisationsveränderungen"@de , "Tipi di cambiamento dell'organizzazione"@it , "Tipos de cambio de organización"@es , "Tipos de alteração da organização"@pt ;
    skos:definition "Kinds of change in the existence of an organisation, recorded on an org:ChangeEvent. Used with mbr:changeEventType."@en ,
                    "Slag av förändringar i en organisations existens, registrerade på en org:ChangeEvent. Används med mbr:changeEventType."@sv ,
                    "Types de changements dans l'existence d'une organisation, consignés sur un org:ChangeEvent. S'utilise avec mbr:changeEventType."@fr ,
                    "Arten von Veränderungen im Bestehen einer Organisation, festgehalten an einem org:ChangeEvent. Wird mit mbr:changeEventType verwendet."@de ,
                    "Tipi di cambiamento nell'esistenza di un'organizzazione, registrati su un org:ChangeEvent. Si usa con mbr:changeEventType."@it ,
                    "Tipos de cambio en la existencia de una organización, registrados en un org:ChangeEvent. Se usa con mbr:changeEventType."@es ,
                    "Tipos de alteração na existência de uma organização, registados num org:ChangeEvent. Usa-se com mbr:changeEventType."@pt ;
    skos:hasTopConcept mbrc:merger , mbrc:split , mbrc:renaming , mbrc:refoundation .

mbrc:merger a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ChangeEventTypes ; skos:topConceptOf mbrc:ChangeEventTypes ;
    skos:prefLabel "Merger"@en , "Sammanslagning"@sv , "Fusion"@fr , "Fusion"@de , "Fusione"@it , "Fusión"@es , "Fusão"@pt ;
    skos:definition "Two or more organisations become one: the originals end or are absorbed, and the result carries on."@en ,
                    "Två eller flera organisationer blir en: de ursprungliga upphör eller tas upp, och resultatet fortsätter."@sv ,
                    "Deux organisations ou plus n'en font plus qu'une : les originales prennent fin ou sont absorbées, et le résultat continue."@fr ,
                    "Zwei oder mehr Organisationen werden eine: die ursprünglichen enden oder gehen auf, und das Ergebnis besteht fort."@de ,
                    "Due o più organizzazioni diventano una: le originarie finiscono o vengono assorbite, e il risultato prosegue."@it ,
                    "Dos o más organizaciones pasan a ser una: las originales terminan o son absorbidas, y el resultado continúa."@es ,
                    "Duas ou mais organizações passam a ser uma: as originais terminam ou são absorvidas, e o resultado continua."@pt .

mbrc:split a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ChangeEventTypes ; skos:topConceptOf mbrc:ChangeEventTypes ;
    skos:prefLabel "Split"@en , "Delning"@sv , "Scission"@fr , "Spaltung"@de , "Scissione"@it , "Escisión"@es , "Cisão"@pt ;
    skos:definition "One organisation divides into two or more, for example when a group of members leaves to form a body of their own."@en ,
                    "En organisation delas i två eller flera, till exempel när en grupp medlemmar lämnar för att bilda ett eget organ."@sv ,
                    "Une organisation se divise en deux ou plus, par exemple quand un groupe de membres la quitte pour former un organe à part."@fr ,
                    "Eine Organisation teilt sich in zwei oder mehr, etwa wenn eine Gruppe von Mitgliedern austritt, um ein eigenes Organ zu bilden."@de ,
                    "Un'organizzazione si divide in due o più, per esempio quando un gruppo di soci se ne va per formare un organismo proprio."@it ,
                    "Una organización se divide en dos o más, por ejemplo cuando un grupo de miembros se va para formar un organismo propio."@es ,
                    "Uma organização divide-se em duas ou mais, por exemplo quando um grupo de membros sai para formar um organismo próprio."@pt ;
    skos:altLabel "Schism"@en , "Schisma"@sv , "Schisme"@fr , "Schisma"@de , "Scisma"@it .

mbrc:renaming a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ChangeEventTypes ; skos:topConceptOf mbrc:ChangeEventTypes ;
    skos:prefLabel "Renaming"@en , "Namnbyte"@sv , "Changement de nom"@fr , "Namensänderung"@de , "Cambio di nome"@it , "Cambio de nombre"@es , "Mudança de nome"@pt ;
    skos:definition "The organisation continues as itself under a new name."@en ,
                    "Organisationen fortsätter som sig själv under ett nytt namn."@sv ,
                    "L'organisation continue d'exister sous un nouveau nom."@fr ,
                    "Die Organisation besteht unter einem neuen Namen als sie selbst fort."@de ,
                    "L'organizzazione continua a esistere come se stessa con un nuovo nome."@it ,
                    "La organización continúa siendo ella misma con un nombre nuevo."@es ,
                    "A organização continua a ser ela própria com um nome novo."@pt .

mbrc:refoundation a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:ChangeEventTypes ; skos:topConceptOf mbrc:ChangeEventTypes ;
    skos:prefLabel "Refoundation"@en , "Nystiftelse"@sv , "Refondation"@fr , "Neugründung"@de , "Rifondazione"@it , "Refundación"@es , "Refundação"@pt ;
    skos:definition "An organisation that had ended or lain dormant is founded again, often under the old name and with the same traditions."@en ,
                    "En organisation som hade upphört eller vilat grundas på nytt, ofta under det gamla namnet och med samma traditioner."@sv ,
                    "Une organisation qui avait cessé ou dormait est fondée à nouveau, souvent sous l'ancien nom et avec les mêmes traditions."@fr ,
                    "Eine Organisation, die geendet hatte oder geruht hatte, wird neu gegründet, oft unter dem alten Namen und mit denselben Traditionen."@de ,
                    "Un'organizzazione che era cessata o in sonno viene fondata di nuovo, spesso con il vecchio nome e le stesse tradizioni."@it ,
                    "Una organización que había terminado o estado latente se funda de nuevo, a menudo con el nombre antiguo y las mismas tradiciones."@es ,
                    "Uma organização que tinha terminado ou estado latente é fundada de novo, muitas vezes com o nome antigo e as mesmas tradições."@pt ;
    skos:scopeNote "Whether the new body is the old one continued or a new one is for the sources to say; record the old one as org:originalOrganization when it is treated as a predecessor."@en ,
                   "Om det nya organet är det gamla som fortsätter eller ett nytt avgör källorna; ange det gamla som org:originalOrganization när det behandlas som föregångare."@sv ,
                   "Aux sources de dire si le nouvel organe est l'ancien qui continue ou un nouveau ; indiquez l'ancien comme org:originalOrganization quand il est traité comme prédécesseur."@fr ,
                   "Ob das neue Organ das alte in Fortführung oder ein neues ist, sagen die Quellen; das alte wird als org:originalOrganization angegeben, wenn es als Vorgänger behandelt wird."@de ,
                   "Spetta alle fonti dire se il nuovo organismo è il vecchio che continua o uno nuovo; si indica il vecchio come org:originalOrganization quando è trattato come predecessore."@it ,
                   "Si el nuevo organismo es el antiguo que continúa o uno nuevo lo dicen las fuentes; el antiguo se registra como org:originalOrganization cuando se trata como predecesor."@es ,
                   "Se o novo organismo é o antigo que continua ou um novo dizem-no as fontes; o antigo regista-se como org:originalOrganization quando é tratado como predecessor."@pt .

##############################################################################
# 20. PORTUGAL  (the status of a private social solidarity institution)
# A first draft from general knowledge and Portuguese Wikipedia, for a Portuguese-speaking
# reviewer. The scheme says dcterms:isPartOf mbrc:PublicBenefitStatuses and its concept is
# mapped in mappings/membership-portugal.sssom.tsv. A declaration of public utility
# (utilidade pública) is the generic mbrc:publicBenefit and needs no concept of its own.
##############################################################################

mbrc:PortugueseSolidarityStatuses a skos:ConceptScheme , owl:NamedIndividual ;
    dcterms:isPartOf mbrc:PublicBenefitStatuses ;
    skos:prefLabel "Statuses under the Portuguese statute of social solidarity institutions"@en , "Statusar enligt den portugisiska stadgan för institutioner för social solidaritet"@sv , "Statuts selon le statut portugais des institutions de solidarité sociale"@fr , "Status nach dem portugiesischen Statut der Einrichtungen der sozialen Solidarität"@de , "Stati secondo lo statuto portoghese delle istituzioni di solidarietà sociale"@it , "Estatus según el estatuto portugués de las instituciones de solidaridad social"@es , "Estatutos ao abrigo do Estatuto das Instituições Particulares de Solidariedade Social"@pt ;
    skos:definition "The status of a private institution of social solidarity (IPSS) under the Portuguese statute of such institutions, first approved in 1983."@en ,
                    "Statusen som privat institution för social solidaritet (IPSS) enligt den portugisiska stadgan för sådana institutioner, som först antogs 1983."@sv ,
                    "Le statut d'institution privée de solidarité sociale (IPSS) selon le statut portugais de ces institutions, approuvé pour la première fois en 1983."@fr ,
                    "Der Status einer privaten Einrichtung der sozialen Solidarität (IPSS) nach dem portugiesischen Statut solcher Einrichtungen, erstmals 1983 genehmigt."@de ,
                    "Lo stato di istituzione privata di solidarietà sociale (IPSS) secondo lo statuto portoghese di tali istituzioni, approvato per la prima volta nel 1983."@it ,
                    "El estatus de institución particular de solidaridad social (IPSS) según el estatuto portugués de esas instituciones, aprobado por primera vez en 1983."@es ,
                    "O estatuto de Instituição Particular de Solidariedade Social (IPSS) ao abrigo do respetivo Estatuto, aprovado pela primeira vez em 1983."@pt ;
    skos:hasTopConcept mbrc:ipss .

mbrc:ipss a skos:Concept , owl:NamedIndividual ;
    skos:inScheme mbrc:PortugueseSolidarityStatuses ; skos:topConceptOf mbrc:PortugueseSolidarityStatuses ;
    skos:prefLabel "Private Institution of Social Solidarity"@en , "Privat institution för social solidaritet"@sv , "Institution privée de solidarité sociale"@fr , "Private Einrichtung der sozialen Solidarität"@de , "Istituzione privata di solidarietà sociale"@it , "Institución particular de solidaridad social"@es , "Instituição Particular de Solidariedade Social"@pt ;
    skos:altLabel "IPSS"@en , "IPSS"@pt ;
    skos:definition "A non-profit institution set up by private persons to give organised expression to the moral duty of solidarity and justice, not run by the State or a local authority. Its aims include support for children, young people, the family and the elderly, health, education and housing."@en ,
                    "En ideell institution som bildats av enskilda för att ge organiserat uttryck åt den moraliska plikten till solidaritet och rättvisa, och som inte drivs av staten eller en lokal myndighet. Dess syften omfattar stöd till barn, ungdomar, familjen och äldre, hälsa, utbildning och bostäder."@sv ,
                    "Une institution sans but lucratif créée par des particuliers pour donner une expression organisée au devoir moral de solidarité et de justice, non administrée par l'État ni par une collectivité locale. Ses objectifs comprennent l'aide aux enfants, aux jeunes, à la famille et aux personnes âgées, la santé, l'éducation et le logement."@fr ,
                    "Eine gemeinnützige Einrichtung, die von Privatpersonen gegründet wurde, um der moralischen Pflicht zu Solidarität und Gerechtigkeit organisierten Ausdruck zu geben, und die nicht vom Staat oder einer Gebietskörperschaft verwaltet wird. Zu ihren Zielen gehören die Unterstützung von Kindern, Jugendlichen, der Familie und älteren Menschen, Gesundheit, Bildung und Wohnen."@de ,
                    "Un'istituzione senza scopo di lucro creata da privati per dare espressione organizzata al dovere morale di solidarietà e giustizia, non amministrata dallo Stato o da un ente locale. I suoi scopi comprendono il sostegno a bambini, giovani, famiglia e anziani, la salute, l'istruzione e l'alloggio."@it ,
                    "Una institución sin ánimo de lucro creada por particulares para dar expresión organizada al deber moral de solidaridad y justicia, no administrada por el Estado ni por una entidad local. Sus objetivos incluyen el apoyo a la infancia, la juventud, la familia y los mayores, la salud, la educación y la vivienda."@es ,
                    "Instituição constituída sem finalidade lucrativa, por iniciativa de particulares, com o objetivo de dar expressão organizada ao dever moral de solidariedade e de justiça entre os indivíduos, não administrada pelo Estado nem por um corpo autárquico. Os seus objetivos incluem o apoio a crianças, jovens, família e idosos, a saúde, a educação e a habitação."@pt .
