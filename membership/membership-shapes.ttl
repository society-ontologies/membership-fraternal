mbrsh:ConferralShape a sh:NodeShape ;
    sh:targetClass mbr:Conferral ;
    sh:property [ sh:path mbr:recipient ; sh:minCount 1 ; sh:class foaf:Agent ] ,
                [ sh:path mbr:conferred ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:message "A conferral needs exactly one conferred concept (distinction or degree). | En tilldelning behöver exakt ett tilldelat begrepp (utmärkelse eller grad). | Une attribution a besoin d'exactement un concept conféré (distinction ou degré). | Eine Verleihung braucht genau ein verliehenes Konzept (Auszeichnung oder Grad). | Un conferimento richiede esattamente un concetto conferito (riconoscimento o grado). | Una concesión necesita exactamente un concepto conferido (distinción o grado). | Uma atribuição precisa de exatamente um conceito conferido (distinção ou grau). | Egy adományozásnak pontosan egy odaítélt fogalma kell legyen (kitüntetés vagy fokozat). | Μια απονομή χρειάζεται ακριβώς μία έννοια που απονέμεται (διάκριση ή βαθμός). | Een verlening heeft precies één verleend concept nodig (onderscheiding of graad)." ] ,
                [ sh:path mbr:conferredAt ; sh:maxCount 1 ; sh:class schema:Event ] ,
                [ sh:path mbr:conferredBy ; sh:maxCount 1 ; sh:class foaf:Agent ] .

mbrsh:DistinctionConferralShape a sh:NodeShape ;
    sh:targetClass mbr:DistinctionConferral ;
    sh:property [ sh:path mbr:conferred ; sh:class mbr:Distinction ] .

