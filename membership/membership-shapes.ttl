    sh:property [ sh:path skos:inScheme ; sh:minCount 1 ] ,
                [ sh:path mbr:distinctionType ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:node mbrsh:DistinctionTypeValue ;
                  sh:message "mbr:distinctionType must be a concept in mbrc:DistinctionTypes, or one mapped to it. | mbr:distinctionType ska vara ett begrepp i mbrc:DistinctionTypes, eller ett som är mappat dit. | mbr:distinctionType doit être un concept de mbrc:DistinctionTypes, ou un concept qui y est mappé. | mbr:distinctionType muss ein Konzept aus mbrc:DistinctionTypes sein oder eines, das darauf abgebildet ist. | mbr:distinctionType deve essere un concetto di mbrc:DistinctionTypes, o uno associato a esso. | mbr:distinctionType debe ser un concepto de mbrc:DistinctionTypes, o uno asociado a él. | mbr:distinctionType tem de ser um conceito de mbrc:DistinctionTypes, ou um associado a ele. | Az mbr:distinctionType értéke az mbrc:DistinctionTypes egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:distinctionType πρέπει να είναι έννοια του mbrc:DistinctionTypes, ή αντιστοιχισμένη σε αυτό. | mbr:distinctionType moet een concept in mbrc:DistinctionTypes zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path mbr:material ; sh:class skos:Concept ;
                  sh:node mbrsh:MaterialValue ;
                  sh:message "mbr:material must be a concept in mbrc:Materials, or one mapped to it. | mbr:material ska vara ett begrepp i mbrc:Materials, eller ett som är mappat dit. | mbr:material doit être un concept de mbrc:Materials, ou un concept qui y est mappé. | mbr:material muss ein Konzept aus mbrc:Materials sein oder eines, das darauf abgebildet ist. | mbr:material deve essere un concetto di mbrc:Materials, o uno associato a esso. | mbr:material debe ser un concepto de mbrc:Materials, o uno asociado a él. | mbr:material tem de ser um conceito de mbrc:Materials, ou um associado a ele. | Az mbr:material értéke az mbrc:Materials egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:material πρέπει να είναι έννοια του mbrc:Materials, ή αντιστοιχισμένη σε αυτό. | mbr:material moet een concept in mbrc:Materials zijn, of een concept dat daarop is afgebeeld." ] ,
