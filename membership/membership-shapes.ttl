##############################################################################
# membership SHACL shapes  —  v1.2.0
#
# Validation lives here, not in OWL domains/ranges. Validate a data graph that
# is merged with the ontology and codelists, so sh:class sees the subclass
# hierarchy (e.g. mbr:Office ⊑ org:Role ⊑ skos:Concept).
#
# Also merge the mappings (mappings/generated/*.ttl) when your data uses concepts
# from your own codelists: a value taken from a codelist is checked against the
# hub scheme for its property (see "Codelist values"), and a local concept passes
# only if a mapping places it in that scheme.
#
# Dates may be partial (xsd:date, xsd:gYearMonth, xsd:gYear). An end is reported as
# before its start only when it is certainly so: the latest moment the end could
# mean lies before the earliest moment the start could mean. Supported: years
# 0001-9999 written with four digits. A timezone on a date is ignored, so the
# calendar date as written is compared. A date outside that form is not ordered;
# it gives a warning instead of passing silently.
##############################################################################

@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix schema:  <http://schema.org/> .
@prefix org:     <http://www.w3.org/ns/org#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rov:     <http://www.w3.org/ns/regorg#> .
@prefix adms:    <http://www.w3.org/ns/adms#> .
@prefix mbr:    <https://w3id.org/membership#> .
@prefix mbrc:   <https://w3id.org/membership/code/> .
@prefix mbrsh:<https://w3id.org/membership/shapes#> .

<https://w3id.org/membership/shapes>
    a owl:Ontology ;
    owl:versionInfo "1.2.0" ;
    rdfs:label "membership SHACL shapes"@en , "SHACL-regler för membership"@sv , "SHACL-Shapes für membership"@de , "Shapes SHACL pour membership"@fr , "Shape SHACL per membership"@it , "Formas SHACL de membership"@es , "Formas SHACL de membership (regras de validação)"@pt , "A membership SHACL-szabályai"@hu , "Κανόνες SHACL για το membership"@el , "SHACL-regels voor membership"@nl ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator <https://orcid.org/0009-0002-6239-5346> ;
    dcterms:rightsHolder <https://orcid.org/0009-0002-6239-5346> ;
    dcterms:publisher <https://github.com/society-ontologies> ;
    sh:declare [ sh:prefix "mbr" ; sh:namespace "https://w3id.org/membership#"^^xsd:anyURI ] ,
               [ sh:prefix "mbrc" ; sh:namespace "https://w3id.org/membership/code/"^^xsd:anyURI ] ,
               [ sh:prefix "org" ; sh:namespace "http://www.w3.org/ns/org#"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
               [ sh:prefix "schema" ; sh:namespace "http://schema.org/"^^xsd:anyURI ] .

<https://orcid.org/0009-0002-6239-5346> foaf:name "Oscar Almgren" .

<https://github.com/society-ontologies> a foaf:Organization ;
    foaf:name "Society Ontologies" .

##############################################################################
# Dates: xsd:date, xsd:gYearMonth or xsd:gYear; at most one of each
##############################################################################

mbrsh:DateList
    sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:gYearMonth ] [ sh:datatype xsd:gYear ] ) .

mbrsh:StartDateShape a sh:NodeShape ;
    sh:targetSubjectsOf mbr:startDate ;
    sh:property [
        sh:path mbr:startDate ;
        sh:maxCount 1 ;
        sh:node mbrsh:DateList ;
        sh:message "mbr:startDate must be a single xsd:date, xsd:gYearMonth or xsd:gYear. | mbr:startDate ska vara ett enda xsd:date, xsd:gYearMonth eller xsd:gYear. | mbr:startDate doit être un unique xsd:date, xsd:gYearMonth ou xsd:gYear. | mbr:startDate muss ein einzelnes xsd:date, xsd:gYearMonth oder xsd:gYear sein. | mbr:startDate deve essere un unico xsd:date, xsd:gYearMonth o xsd:gYear. | mbr:startDate debe ser un único xsd:date, xsd:gYearMonth o xsd:gYear. | mbr:startDate tem de ser um único xsd:date, xsd:gYearMonth ou xsd:gYear. | Az mbr:startDate értéke egyetlen xsd:date, xsd:gYearMonth vagy xsd:gYear kell legyen. | Το mbr:startDate πρέπει να είναι ένα μόνο xsd:date, xsd:gYearMonth ή xsd:gYear. | mbr:startDate moet één xsd:date, xsd:gYearMonth of xsd:gYear zijn."
    ] .

mbrsh:EndDateShape a sh:NodeShape ;
    sh:targetSubjectsOf mbr:endDate ;
    sh:property [
        sh:path mbr:endDate ;
        sh:maxCount 1 ;
        sh:node mbrsh:DateList ;
        sh:message "mbr:endDate must be a single xsd:date, xsd:gYearMonth or xsd:gYear. | mbr:endDate ska vara ett enda xsd:date, xsd:gYearMonth eller xsd:gYear. | mbr:endDate doit être un unique xsd:date, xsd:gYearMonth ou xsd:gYear. | mbr:endDate muss ein einzelnes xsd:date, xsd:gYearMonth oder xsd:gYear sein. | mbr:endDate deve essere un unico xsd:date, xsd:gYearMonth o xsd:gYear. | mbr:endDate debe ser un único xsd:date, xsd:gYearMonth o xsd:gYear. | mbr:endDate tem de ser um único xsd:date, xsd:gYearMonth ou xsd:gYear. | Az mbr:endDate értéke egyetlen xsd:date, xsd:gYearMonth vagy xsd:gYear kell legyen. | Το mbr:endDate πρέπει να είναι ένα μόνο xsd:date, xsd:gYearMonth ή xsd:gYear. | mbr:endDate moet één xsd:date, xsd:gYearMonth of xsd:gYear zijn."
    ] ;
    # An end cannot come before its start. Partial dates are widened to the earliest
    # and latest day they could mean ("2000" is 2000-01-01 to 2000-12-31, "2000-03" is
    # 2000-03-01 to 2000-03-31; 31 is an upper bound, not a calendar day), and the
    # ISO form makes the text order the date order. Only an end whose latest day is
    # before the start's earliest day is an error.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The end date is certainly before the start date. | Slutdatumet ligger säkert före startdatumet. | La date de fin est certainement antérieure à la date de début. | Das Enddatum liegt sicher vor dem Startdatum. | La data di fine è certamente anteriore alla data di inizio. | La fecha de fin es con seguridad anterior a la fecha de inicio. | A data de fim é com certeza anterior à data de início. | A záró dátum biztosan korábbi a kezdő dátumnál. | Η ημερομηνία λήξης είναι σίγουρα πριν από την ημερομηνία έναρξης. | De einddatum ligt zeker vóór de begindatum." ;
        sh:prefixes <https://w3id.org/membership/shapes> ;
        sh:select """
            SELECT $this WHERE {
                $this mbr:startDate ?s ;
                      mbr:endDate ?e .
                FILTER (datatype(?s) IN (xsd:date, xsd:gYearMonth, xsd:gYear) &&
                        datatype(?e) IN (xsd:date, xsd:gYearMonth, xsd:gYear))
                FILTER (REGEX(STR(?s), "^[0-9]{4}") && REGEX(STR(?e), "^[0-9]{4}"))
                BIND (IF(datatype(?s) = xsd:date, SUBSTR(STR(?s), 1, 10),
                      IF(datatype(?s) = xsd:gYearMonth, CONCAT(SUBSTR(STR(?s), 1, 7), "-01"),
                         CONCAT(SUBSTR(STR(?s), 1, 4), "-01-01"))) AS ?earliestStart)
                BIND (IF(datatype(?e) = xsd:date, SUBSTR(STR(?e), 1, 10),
                      IF(datatype(?e) = xsd:gYearMonth, CONCAT(SUBSTR(STR(?e), 1, 7), "-31"),
                         CONCAT(SUBSTR(STR(?e), 1, 4), "-12-31"))) AS ?latestEnd)
                FILTER (?latestEnd < ?earliestStart)
            }
        """
    ] .

# Dates that the ordering checks cannot compare are reported, not passed over.
mbrsh:SupportedDateFormShape a sh:NodeShape ;
    sh:targetSubjectsOf mbr:startDate , mbr:endDate , mbr:foundingDate , mbr:dissolutionDate , mbr:decisionDate ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The date {?value} is not a year 0001-9999 written with four digits, so its order against other dates is not checked. | Datumet {?value} är inte ett år 0001-9999 skrivet med fyra siffror, så dess ordning mot andra datum kontrolleras inte. | La date {?value} n'est pas une année de 0001 à 9999 écrite avec quatre chiffres ; son ordre par rapport aux autres dates n'est donc pas vérifié. | Das Datum {?value} ist kein vierstellig geschriebenes Jahr von 0001 bis 9999, daher wird seine Reihenfolge gegenüber anderen Daten nicht geprüft. | La data {?value} non è un anno da 0001 a 9999 scritto con quattro cifre, quindi il suo ordine rispetto alle altre date non viene controllato. | La fecha {?value} no es un año 0001-9999 escrito con cuatro cifras, por lo que no se comprueba su orden respecto a otras fechas. | A data {?value} não é um ano 0001-9999 escrito com quatro algarismos, pelo que não se verifica a sua ordem em relação a outras datas. | A(z) {?value} dátum nem négy számjeggyel írt 0001–9999 év, ezért más dátumokhoz viszonyított sorrendjét nem ellenőrizzük. | Η ημερομηνία {?value} δεν είναι έτος 0001–9999 γραμμένο με τέσσερα ψηφία, οπότε η σειρά της σε σχέση με άλλες ημερομηνίες δεν ελέγχεται. | De datum {?value} is geen jaar 0001-9999 met vier cijfers geschreven, dus de volgorde ten opzichte van andere datums wordt niet gecontroleerd." ;
        sh:prefixes <https://w3id.org/membership/shapes> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this mbr:startDate|mbr:endDate|mbr:foundingDate|mbr:dissolutionDate|mbr:decisionDate ?value .
                FILTER (datatype(?value) IN (xsd:date, xsd:gYearMonth, xsd:gYear))
                FILTER (!REGEX(STR(?value), "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?(Z|[+-][0-9]{2}:[0-9]{2})?$"))
            }
        """
    ] .

##############################################################################
# Codelist values
#
# A value of a codelist property must be a concept in the hub scheme for that
# property, or a local concept that is mapped to a concept in that scheme with
# skos:exactMatch, skos:closeMatch or skos:broadMatch (it is narrower than, or
# the same as, a hub concept). The three are not interchangeable and none is
# owl:sameAs. A local concept that is only related to the hub (skos:relatedMatch),
# or broader than a hub concept (skos:narrowMatch), is not accepted. A mapping does not make an organisation a mbr:GentlemensClub
# or other convenience class: those are defined by owl:hasValue on the hub
# concept itself.
##############################################################################

mbrsh:OrganizationTypeValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:OrganizationTypes ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:OrganizationTypes ] ) .

mbrsh:MembershipStatusValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:MembershipStatuses ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:MembershipStatuses ] ) .

mbrsh:MembershipCategoryValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:MembershipCategories ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:MembershipCategories ] ) .

mbrsh:MembershipEventTypeValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:MembershipEventTypes ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:MembershipEventTypes ] ) .

mbrsh:GatheringTypeValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:GatheringTypes ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:GatheringTypes ] ) .

mbrsh:ParticipationRoleValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:ParticipationRoles ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:ParticipationRoles ] ) .

mbrsh:DressCodeValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:DressCodes ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:DressCodes ] ) .

mbrsh:GenderPolicyValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:GenderPolicies ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:GenderPolicies ] ) .

mbrsh:AdmissionModeValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:AdmissionModes ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:AdmissionModes ] ) .

mbrsh:DistinctionTypeValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:DistinctionTypes ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:DistinctionTypes ] ) .

mbrsh:MaterialValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:Materials ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:Materials ] ) .

mbrsh:OrganizationStatusValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:OrganizationStatuses ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:OrganizationStatuses ] ) .

mbrsh:OwnershipModelValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:OwnershipModels ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:OwnershipModels ] ) .

mbrsh:FeeTypeValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:FeeTypes ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:FeeTypes ] ) .

mbrsh:OfficeTypeValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:OfficeTypes ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:OfficeTypes ]
            [ sh:path ( skos:inScheme dcterms:isPartOf ) ; sh:hasValue mbrc:OfficeTypes ] ) .

mbrsh:LegalFormValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:LegalForms ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:LegalForms ] ) .

mbrsh:ApplicationStatusValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:ApplicationStatuses ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:ApplicationStatuses ] ) .

mbrsh:CharterStatusValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:CharterStatuses ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:CharterStatuses ] ) .

mbrsh:ChangeEventTypeValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:ChangeEventTypes ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:ChangeEventTypes ] ) .

mbrsh:PublicBenefitStatusValue a sh:NodeShape ;
    sh:or ( [ sh:path skos:inScheme ; sh:hasValue mbrc:PublicBenefitStatuses ]
            [ sh:path ( [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] skos:inScheme ) ; sh:hasValue mbrc:PublicBenefitStatuses ]
            [ sh:path ( skos:inScheme dcterms:isPartOf ) ; sh:hasValue mbrc:PublicBenefitStatuses ] ) .

mbrsh:FoundingDateShape a sh:NodeShape ;
    sh:targetSubjectsOf mbr:foundingDate ;
    sh:property [
        sh:path mbr:foundingDate ;
        sh:maxCount 1 ;
        sh:node mbrsh:DateList ;
        sh:message "mbr:foundingDate must be a single xsd:date, xsd:gYearMonth or xsd:gYear. | mbr:foundingDate ska vara ett enda xsd:date, xsd:gYearMonth eller xsd:gYear. | mbr:foundingDate doit être un unique xsd:date, xsd:gYearMonth ou xsd:gYear. | mbr:foundingDate muss ein einzelnes xsd:date, xsd:gYearMonth oder xsd:gYear sein. | mbr:foundingDate deve essere un unico xsd:date, xsd:gYearMonth o xsd:gYear. | mbr:foundingDate debe ser un único xsd:date, xsd:gYearMonth o xsd:gYear. | mbr:foundingDate tem de ser um único xsd:date, xsd:gYearMonth ou xsd:gYear. | Az mbr:foundingDate értéke egyetlen xsd:date, xsd:gYearMonth vagy xsd:gYear kell legyen. | Το mbr:foundingDate πρέπει να είναι ένα μόνο xsd:date, xsd:gYearMonth ή xsd:gYear. | mbr:foundingDate moet één xsd:date, xsd:gYearMonth of xsd:gYear zijn."
    ] .

mbrsh:DissolutionDateShape a sh:NodeShape ;
    sh:targetSubjectsOf mbr:dissolutionDate ;
    sh:property [
        sh:path mbr:dissolutionDate ;
        sh:maxCount 1 ;
        sh:node mbrsh:DateList ;
        sh:message "mbr:dissolutionDate must be a single xsd:date, xsd:gYearMonth or xsd:gYear. | mbr:dissolutionDate ska vara ett enda xsd:date, xsd:gYearMonth eller xsd:gYear. | mbr:dissolutionDate doit être un unique xsd:date, xsd:gYearMonth ou xsd:gYear. | mbr:dissolutionDate muss ein einzelnes xsd:date, xsd:gYearMonth oder xsd:gYear sein. | mbr:dissolutionDate deve essere un unico xsd:date, xsd:gYearMonth o xsd:gYear. | mbr:dissolutionDate debe ser un único xsd:date, xsd:gYearMonth o xsd:gYear. | mbr:dissolutionDate tem de ser um único xsd:date, xsd:gYearMonth ou xsd:gYear. | Az mbr:dissolutionDate értéke egyetlen xsd:date, xsd:gYearMonth vagy xsd:gYear kell legyen. | Το mbr:dissolutionDate πρέπει να είναι ένα μόνο xsd:date, xsd:gYearMonth ή xsd:gYear. | mbr:dissolutionDate moet één xsd:date, xsd:gYearMonth of xsd:gYear zijn."
    ] .

# A decision may come before or after it takes effect, so it is not ordered against mbr:startDate.
mbrsh:DecisionDateShape a sh:NodeShape ;
    sh:targetSubjectsOf mbr:decisionDate ;
    sh:property [
        sh:path mbr:decisionDate ;
        sh:maxCount 1 ;
        sh:node mbrsh:DateList ;
        sh:message "mbr:decisionDate must be a single xsd:date, xsd:gYearMonth or xsd:gYear. | mbr:decisionDate ska vara ett enda xsd:date, xsd:gYearMonth eller xsd:gYear. | mbr:decisionDate doit être un seul xsd:date, xsd:gYearMonth ou xsd:gYear. | mbr:decisionDate muss ein einzelnes xsd:date, xsd:gYearMonth oder xsd:gYear sein. | mbr:decisionDate deve essere un unico xsd:date, xsd:gYearMonth o xsd:gYear. | mbr:decisionDate debe ser un único xsd:date, xsd:gYearMonth o xsd:gYear. | mbr:decisionDate tem de ser um único xsd:date, xsd:gYearMonth ou xsd:gYear. | Az mbr:decisionDate értéke egyetlen xsd:date, xsd:gYearMonth vagy xsd:gYear kell legyen. | Το mbr:decisionDate πρέπει να είναι ένα μόνο xsd:date, xsd:gYearMonth ή xsd:gYear. | mbr:decisionDate moet één xsd:date, xsd:gYearMonth of xsd:gYear zijn."
    ] .

mbrsh:AsOfShape a sh:NodeShape ;
    sh:targetSubjectsOf mbr:asOf ;
    sh:property [
        sh:path mbr:asOf ;
        sh:maxCount 1 ;
        sh:node mbrsh:DateList ;
        sh:message "mbr:asOf must be a single xsd:date, xsd:gYearMonth or xsd:gYear. | mbr:asOf ska vara ett enda xsd:date, xsd:gYearMonth eller xsd:gYear. | mbr:asOf doit être un unique xsd:date, xsd:gYearMonth ou xsd:gYear. | mbr:asOf muss ein einzelnes xsd:date, xsd:gYearMonth oder xsd:gYear sein. | mbr:asOf deve essere un unico xsd:date, xsd:gYearMonth o xsd:gYear. | mbr:asOf debe ser un único xsd:date, xsd:gYearMonth o xsd:gYear. | mbr:asOf tem de ser um único xsd:date, xsd:gYearMonth ou xsd:gYear. | Az mbr:asOf értéke egyetlen xsd:date, xsd:gYearMonth vagy xsd:gYear kell legyen. | Το mbr:asOf πρέπει να είναι ένα μόνο xsd:date, xsd:gYearMonth ή xsd:gYear. | mbr:asOf moet één xsd:date, xsd:gYearMonth of xsd:gYear zijn."
    ] .

##############################################################################
# Membership
##############################################################################

mbrsh:MembershipShape a sh:NodeShape ;
    sh:targetClass mbr:Membership ;
    sh:property [ sh:path org:member ; sh:minCount 1 ; sh:maxCount 1 ; sh:class foaf:Agent ] ,
                [ sh:path org:organization ; sh:minCount 1 ; sh:maxCount 1 ; sh:class org:Organization ] ,
                [ sh:path mbr:membershipStatus ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:node mbrsh:MembershipStatusValue ;
                  sh:message "mbr:membershipStatus must be a concept in mbrc:MembershipStatuses, or one mapped to it. | mbr:membershipStatus ska vara ett begrepp i mbrc:MembershipStatuses, eller ett som är mappat dit. | mbr:membershipStatus doit être un concept de mbrc:MembershipStatuses, ou un concept qui y est mappé. | mbr:membershipStatus muss ein Konzept aus mbrc:MembershipStatuses sein oder eines, das darauf abgebildet ist. | mbr:membershipStatus deve essere un concetto di mbrc:MembershipStatuses, o uno associato a esso. | mbr:membershipStatus debe ser un concepto de mbrc:MembershipStatuses, o uno asociado a él. | mbr:membershipStatus tem de ser um conceito de mbrc:MembershipStatuses, ou um associado a ele. | Az mbr:membershipStatus értéke az mbrc:MembershipStatuses egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:membershipStatus πρέπει να είναι έννοια του mbrc:MembershipStatuses, ή αντιστοιχισμένη σε αυτό. | mbr:membershipStatus moet een concept in mbrc:MembershipStatuses zijn, of een concept dat daarop is afgebeeld." ] ,
                # A membership may have several categories at once (life and founding, junior
                # and overseas): no maxCount, and no incompatibility rule beyond what a
                # category's own definition says.
                [ sh:path mbr:membershipCategory ; sh:class skos:Concept ;
                  sh:node mbrsh:MembershipCategoryValue ;
                  sh:message "mbr:membershipCategory must be a concept in mbrc:MembershipCategories, or one mapped to it. | mbr:membershipCategory ska vara ett begrepp i mbrc:MembershipCategories, eller ett som är mappat dit. | mbr:membershipCategory doit être un concept de mbrc:MembershipCategories, ou un concept qui y est mappé. | mbr:membershipCategory muss ein Konzept aus mbrc:MembershipCategories sein oder eines, das darauf abgebildet ist. | mbr:membershipCategory deve essere un concetto di mbrc:MembershipCategories, o uno associato a esso. | mbr:membershipCategory debe ser un concepto de mbrc:MembershipCategories, o uno asociado a él. | mbr:membershipCategory tem de ser um conceito de mbrc:MembershipCategories, ou um associado a ele. | Az mbr:membershipCategory értéke az mbrc:MembershipCategories egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:membershipCategory πρέπει να είναι έννοια του mbrc:MembershipCategories, ή αντιστοιχισμένη σε αυτό. | mbr:membershipCategory moet een concept in mbrc:MembershipCategories zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path mbr:sponsor ; sh:class foaf:Agent ] ,
                [ sh:path mbr:proposer ; sh:class foaf:Agent ] ,
                [ sh:path mbr:seconder ; sh:class foaf:Agent ] ,
                [ sh:path mbr:mentor ; sh:class foaf:Agent ] ,
                [ sh:path mbr:membershipNumber ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "mbr:membershipNumber must be one xsd:string, such as \"1207\" or \"L-0042\". | mbr:membershipNumber ska vara en enda xsd:string, t.ex. \"1207\" eller \"L-0042\". | mbr:membershipNumber doit être un seul xsd:string, comme \"1207\" ou \"L-0042\". | mbr:membershipNumber muss ein einzelner xsd:string sein, etwa \"1207\" oder \"L-0042\". | mbr:membershipNumber deve essere un unico xsd:string, come \"1207\" o \"L-0042\". | mbr:membershipNumber debe ser un único xsd:string, como \"1207\" o \"L-0042\". | mbr:membershipNumber tem de ser um único xsd:string, como \"1207\" ou \"L-0042\". | Az mbr:membershipNumber értéke egyetlen xsd:string kell legyen, például \"1207\" vagy \"L-0042\". | Το mbr:membershipNumber πρέπει να είναι ένα μόνο xsd:string, όπως \"1207\" ή \"L-0042\". | mbr:membershipNumber moet één xsd:string zijn, zoals \"1207\" of \"L-0042\"." ] ;
    # Register policy: a number identifies one membership in one organisation at a time.
    # The same number may be reused by a later membership, but only when the two periods
    # certainly do not overlap: one ends (latest possible day) before the other begins
    # (earliest possible day), compared as in mbrsh:EndDateShape. A membership without
    # dates cannot show that, so a shared number is reported.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Membership number {?num} is used by more than one membership in {?org} at overlapping or unknown times. | Medlemsnummer {?num} används av mer än ett medlemskap i {?org} under överlappande eller okända tider. | Le numéro d'adhérent {?num} est utilisé par plus d'une adhésion dans {?org} à des moments qui se chevauchent ou qui sont inconnus. | Die Mitgliedsnummer {?num} wird in {?org} von mehr als einer Mitgliedschaft zu sich überschneidenden oder unbekannten Zeiten verwendet. | Il numero di socio {?num} è usato da più di un'appartenenza in {?org} in periodi che si sovrappongono o non sono noti. | El número de socio {?num} lo usa más de una pertenencia en {?org} en períodos que se solapan o se desconocen. | O número de sócio {?num} é usado por mais de uma filiação em {?org} em períodos que se sobrepõem ou são desconhecidos. | A(z) {?num} tagsági számot egynél több tagság használja a(z) {?org} szervezetben egymást átfedő vagy ismeretlen időszakokban. | Ο αριθμός μέλους {?num} χρησιμοποιείται από περισσότερες από μία ιδιότητες μέλους στην {?org} σε περιόδους που επικαλύπτονται ή είναι άγνωστες. | Lidnummer {?num} wordt door meer dan één lidmaatschap in {?org} gebruikt op elkaar overlappende of onbekende tijden." ;
        sh:prefixes <https://w3id.org/membership/shapes> ;
        sh:select """
            SELECT $this ?num ?org WHERE {
                $this mbr:membershipNumber ?num ;
                      org:organization ?org .
                ?other mbr:membershipNumber ?num ;
                       org:organization ?org .
                FILTER (?other != $this)
                FILTER NOT EXISTS {
                    $this mbr:endDate ?e .
                    ?other mbr:startDate ?s .
                    FILTER (datatype(?e) IN (xsd:date, xsd:gYearMonth, xsd:gYear) &&
                            datatype(?s) IN (xsd:date, xsd:gYearMonth, xsd:gYear) &&
                            REGEX(STR(?e), "^[0-9]{4}") && REGEX(STR(?s), "^[0-9]{4}"))
                    BIND (IF(datatype(?e) = xsd:date, SUBSTR(STR(?e), 1, 10),
                          IF(datatype(?e) = xsd:gYearMonth, CONCAT(SUBSTR(STR(?e), 1, 7), "-31"),
                             CONCAT(SUBSTR(STR(?e), 1, 4), "-12-31"))) AS ?latestEnd)
                    BIND (IF(datatype(?s) = xsd:date, SUBSTR(STR(?s), 1, 10),
                          IF(datatype(?s) = xsd:gYearMonth, CONCAT(SUBSTR(STR(?s), 1, 7), "-01"),
                             CONCAT(SUBSTR(STR(?s), 1, 4), "-01-01"))) AS ?earliestStart)
                    FILTER (?latestEnd < ?earliestStart)
                }
                FILTER NOT EXISTS {
                    ?other mbr:endDate ?e .
                    $this mbr:startDate ?s .
                    FILTER (datatype(?e) IN (xsd:date, xsd:gYearMonth, xsd:gYear) &&
                            datatype(?s) IN (xsd:date, xsd:gYearMonth, xsd:gYear) &&
                            REGEX(STR(?e), "^[0-9]{4}") && REGEX(STR(?s), "^[0-9]{4}"))
                    BIND (IF(datatype(?e) = xsd:date, SUBSTR(STR(?e), 1, 10),
                          IF(datatype(?e) = xsd:gYearMonth, CONCAT(SUBSTR(STR(?e), 1, 7), "-31"),
                             CONCAT(SUBSTR(STR(?e), 1, 4), "-12-31"))) AS ?latestEnd)
                    BIND (IF(datatype(?s) = xsd:date, SUBSTR(STR(?s), 1, 10),
                          IF(datatype(?s) = xsd:gYearMonth, CONCAT(SUBSTR(STR(?s), 1, 7), "-01"),
                             CONCAT(SUBSTR(STR(?s), 1, 4), "-01-01"))) AS ?earliestStart)
                    FILTER (?latestEnd < ?earliestStart)
                }
            }
        """
    ] ,
    # A member is not their own mentor.
    [
        a sh:SPARQLConstraint ;
        sh:message "A member cannot be their own mentor (mbr:mentor). | En medlem kan inte vara sin egen fadder (mbr:mentor). | Un membre ne peut pas être son propre mentor (mbr:mentor). | Ein Mitglied kann nicht sein eigener Mentor sein (mbr:mentor). | Un socio non può essere il proprio mentore (mbr:mentor). | Un miembro no puede ser su propio mentor (mbr:mentor). | Um membro não pode ser o seu próprio mentor (mbr:mentor). | Egy tag nem lehet a saját mentora (mbr:mentor). | Ένα μέλος δεν μπορεί να είναι ο μέντορας του εαυτού του (mbr:mentor). | Een lid kan niet zijn of haar eigen mentor zijn (mbr:mentor)." ;
        sh:prefixes <https://w3id.org/membership/shapes> ;
        sh:select """
            SELECT $this ?m WHERE {
                $this mbr:mentor ?m ;
                      org:member ?m .
            }
        """
    ] .

mbrsh:MembershipEventShape a sh:NodeShape ;
    sh:targetClass mbr:MembershipEvent ;
    sh:property [ sh:path mbr:concernsMembership ; sh:minCount 1 ; sh:maxCount 1 ; sh:class org:Membership ] ,
                [ sh:path mbr:membershipEventType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:node mbrsh:MembershipEventTypeValue ;
                  sh:message "mbr:membershipEventType must be a concept in mbrc:MembershipEventTypes, or one mapped to it. | mbr:membershipEventType ska vara ett begrepp i mbrc:MembershipEventTypes, eller ett som är mappat dit. | mbr:membershipEventType doit être un concept de mbrc:MembershipEventTypes, ou un concept qui y est mappé. | mbr:membershipEventType muss ein Konzept aus mbrc:MembershipEventTypes sein oder eines, das darauf abgebildet ist. | mbr:membershipEventType deve essere un concetto di mbrc:MembershipEventTypes, o uno associato a esso. | mbr:membershipEventType debe ser un concepto de mbrc:MembershipEventTypes, o uno asociado a él. | mbr:membershipEventType tem de ser um conceito de mbrc:MembershipEventTypes, ou um associado a ele. | Az mbr:membershipEventType értéke az mbrc:MembershipEventTypes egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:membershipEventType πρέπει να είναι έννοια του mbrc:MembershipEventTypes, ή αντιστοιχισμένη σε αυτό. | mbr:membershipEventType moet een concept in mbrc:MembershipEventTypes zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path mbr:resultingStatus ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:node mbrsh:MembershipStatusValue ;
                  sh:message "mbr:resultingStatus must be a concept in mbrc:MembershipStatuses, or one mapped to it. | mbr:resultingStatus ska vara ett begrepp i mbrc:MembershipStatuses, eller ett som är mappat dit. | mbr:resultingStatus doit être un concept de mbrc:MembershipStatuses, ou un concept qui y est mappé. | mbr:resultingStatus muss ein Konzept aus mbrc:MembershipStatuses sein oder eines, das darauf abgebildet ist. | mbr:resultingStatus deve essere un concetto di mbrc:MembershipStatuses, o uno associato a esso. | mbr:resultingStatus debe ser un concepto de mbrc:MembershipStatuses, o uno asociado a él. | mbr:resultingStatus tem de ser um conceito de mbrc:MembershipStatuses, ou um associado a ele. | Az mbr:resultingStatus értéke az mbrc:MembershipStatuses egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:resultingStatus πρέπει να είναι έννοια του mbrc:MembershipStatuses, ή αντιστοιχισμένη σε αυτό. | mbr:resultingStatus moet een concept in mbrc:MembershipStatuses zijn, of een concept dat daarop is afgebeeld." ] ,
                # The whole set of categories after the event, not an addition to the earlier set.
                [ sh:path mbr:resultingCategory ; sh:class skos:Concept ;
                  sh:node mbrsh:MembershipCategoryValue ;
                  sh:message "mbr:resultingCategory must be a concept in mbrc:MembershipCategories, or one mapped to it. | mbr:resultingCategory ska vara ett begrepp i mbrc:MembershipCategories, eller ett som är mappat dit. | mbr:resultingCategory doit être un concept de mbrc:MembershipCategories, ou un concept qui y est mappé. | mbr:resultingCategory muss ein Konzept aus mbrc:MembershipCategories sein oder eines, das darauf abgebildet ist. | mbr:resultingCategory deve essere un concetto di mbrc:MembershipCategories, o uno associato a esso. | mbr:resultingCategory debe ser un concepto de mbrc:MembershipCategories, o uno asociado a él. | mbr:resultingCategory tem de ser um conceito de mbrc:MembershipCategories, ou um associado a ele. | Az mbr:resultingCategory értéke az mbrc:MembershipCategories egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:resultingCategory πρέπει να είναι έννοια του mbrc:MembershipCategories, ή αντιστοιχισμένη σε αυτό. | mbr:resultingCategory moet een concept in mbrc:MembershipCategories zijn, of een concept dat daarop is afgebeeld." ] .

##############################################################################
# Membership applications and ballots
##############################################################################

mbrsh:MembershipApplicationShape a sh:NodeShape ;
    sh:targetClass mbr:MembershipApplication ;
    sh:property [ sh:path mbr:applicant ; sh:minCount 1 ; sh:maxCount 1 ; sh:class foaf:Agent ;
                  sh:message "A membership application needs exactly one applicant (mbr:applicant). | En medlemsansökan behöver exakt en sökande (mbr:applicant). | Une demande d'adhésion a besoin d'exactement un candidat (mbr:applicant). | Ein Mitgliedschaftsantrag braucht genau einen Antragsteller (mbr:applicant). | Una domanda di ammissione richiede esattamente un richiedente (mbr:applicant). | Una solicitud de ingreso necesita exactamente un solicitante (mbr:applicant). | Um pedido de admissão precisa de exatamente um requerente (mbr:applicant). | Egy felvételi kérelemnek pontosan egy kérelmezője kell legyen (mbr:applicant). | Μια αίτηση εισδοχής χρειάζεται ακριβώς έναν αιτούντα (mbr:applicant). | Een aanvraag tot lidmaatschap heeft precies één aanvrager nodig (mbr:applicant)." ] ,
                [ sh:path mbr:appliedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class org:Organization ;
                  sh:message "A membership application needs exactly one organisation it is addressed to (mbr:appliedTo). | En medlemsansökan behöver exakt en organisation den riktas till (mbr:appliedTo). | Une demande d'adhésion a besoin d'exactement une organisation destinataire (mbr:appliedTo). | Ein Mitgliedschaftsantrag braucht genau eine Organisation, an die er gerichtet ist (mbr:appliedTo). | Una domanda di ammissione richiede esattamente un'organizzazione destinataria (mbr:appliedTo). | Una solicitud de ingreso necesita exactamente una organización destinataria (mbr:appliedTo). | Um pedido de admissão precisa de exatamente uma organização destinatária (mbr:appliedTo). | Egy felvételi kérelemnek pontosan egy címzett szervezete kell legyen (mbr:appliedTo). | Μια αίτηση εισδοχής χρειάζεται ακριβώς μία οργάνωση προς την οποία απευθύνεται (mbr:appliedTo). | Een aanvraag tot lidmaatschap heeft precies één organisatie nodig waaraan ze is gericht (mbr:appliedTo)." ] ,
                [ sh:path mbr:applicationStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:node mbrsh:ApplicationStatusValue ;
                  sh:message "mbr:applicationStatus must be exactly one concept in mbrc:ApplicationStatuses, or one mapped to it. | mbr:applicationStatus ska vara exakt ett begrepp i mbrc:ApplicationStatuses, eller ett som är mappat dit. | mbr:applicationStatus doit être exactement un concept de mbrc:ApplicationStatuses, ou un concept qui y est mis en correspondance. | mbr:applicationStatus muss genau ein Konzept in mbrc:ApplicationStatuses sein, oder eines, das darauf abgebildet ist. | mbr:applicationStatus deve essere esattamente un concetto di mbrc:ApplicationStatuses, o uno mappato su di esso. | mbr:applicationStatus debe ser exactamente un concepto de mbrc:ApplicationStatuses, o uno asociado a él. | mbr:applicationStatus tem de ser exatamente um conceito de mbrc:ApplicationStatuses, ou um associado a ele. | Az mbr:applicationStatus értéke pontosan egy fogalom az mbrc:ApplicationStatuses-ból, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:applicationStatus πρέπει να είναι ακριβώς μία έννοια του mbrc:ApplicationStatuses, ή αντιστοιχισμένη σε αυτό. | mbr:applicationStatus moet precies één concept in mbrc:ApplicationStatuses zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path mbr:resultingMembership ; sh:maxCount 1 ; sh:class org:Membership ] ,
                [ sh:path mbr:proposer ; sh:class foaf:Agent ] ,
                [ sh:path mbr:seconder ; sh:class foaf:Agent ] ;
    # org:member is for a Membership; an applicant is not yet a member.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A membership application has mbr:applicant, not org:member (org:member is for a membership). | En medlemsansökan har mbr:applicant, inte org:member (org:member hör till ett medlemskap). | Une demande d'adhésion a mbr:applicant, pas org:member (org:member est pour une adhésion). | Ein Mitgliedschaftsantrag hat mbr:applicant, nicht org:member (org:member gehört zu einer Mitgliedschaft). | Una domanda di ammissione ha mbr:applicant, non org:member (org:member è per un'appartenenza). | Una solicitud de ingreso tiene mbr:applicant, no org:member (org:member es para una pertenencia). | Um pedido de admissão tem mbr:applicant, não org:member (org:member é para uma filiação). | A felvételi kérelemnek mbr:applicant van, nem org:member (az org:member tagságra szolgál). | Μια αίτηση εισδοχής έχει mbr:applicant, όχι org:member (το org:member προορίζεται για ιδιότητα μέλους). | Een aanvraag tot lidmaatschap heeft mbr:applicant, geen org:member (org:member is voor een lidmaatschap)." ;
        sh:prefixes <https://w3id.org/membership/shapes> ;
        sh:select """
            SELECT $this ?m WHERE { $this org:member ?m . }
        """
    ] .

mbrsh:BallotShape a sh:NodeShape ;
    sh:targetClass mbr:Ballot ;
    sh:property [ sh:path mbr:ballotOn ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mbr:MembershipApplication ;
                  sh:message "A ballot needs exactly one application it is held on (mbr:ballotOn). | En ballotering behöver exakt en ansökan den gäller (mbr:ballotOn). | Un scrutin a besoin d'exactement une demande sur laquelle il porte (mbr:ballotOn). | Eine Abstimmung braucht genau einen Antrag, über den abgestimmt wird (mbr:ballotOn). | Una votazione richiede esattamente una domanda su cui si tiene (mbr:ballotOn). | Una votación necesita exactamente una solicitud sobre la que se celebra (mbr:ballotOn). | Uma votação precisa de exatamente um pedido sobre o qual se realiza (mbr:ballotOn). | Egy szavazásnak pontosan egy kérelme kell legyen, amelyről szól (mbr:ballotOn). | Μια ψηφοφορία χρειάζεται ακριβώς μία αίτηση για την οποία διεξάγεται (mbr:ballotOn). | Een ballotage heeft precies één aanvraag nodig waarover ze wordt gehouden (mbr:ballotOn)." ] ,
                [ sh:path mbr:votesFor ; sh:maxCount 1 ; sh:node mbrsh:CountList ;
                  sh:message "mbr:votesFor must be one non-negative integer. | mbr:votesFor ska vara ett enda icke-negativt heltal. | mbr:votesFor doit être un seul entier non négatif. | mbr:votesFor muss eine einzige nichtnegative ganze Zahl sein. | mbr:votesFor deve essere un solo intero non negativo. | mbr:votesFor debe ser un único entero no negativo. | mbr:votesFor tem de ser um único inteiro não negativo. | Az mbr:votesFor értéke egyetlen nemnegatív egész szám kell legyen. | Το mbr:votesFor πρέπει να είναι ένας μη αρνητικός ακέραιος. | mbr:votesFor moet één niet-negatief geheel getal zijn." ] ,
                [ sh:path mbr:votesAgainst ; sh:maxCount 1 ; sh:node mbrsh:CountList ;
                  sh:message "mbr:votesAgainst must be one non-negative integer. | mbr:votesAgainst ska vara ett enda icke-negativt heltal. | mbr:votesAgainst doit être un seul entier non négatif. | mbr:votesAgainst muss eine einzige nichtnegative ganze Zahl sein. | mbr:votesAgainst deve essere un solo intero non negativo. | mbr:votesAgainst debe ser un único entero no negativo. | mbr:votesAgainst tem de ser um único inteiro não negativo. | Az mbr:votesAgainst értéke egyetlen nemnegatív egész szám kell legyen. | Το mbr:votesAgainst πρέπει να είναι ένας μη αρνητικός ακέραιος. | mbr:votesAgainst moet één niet-negatief geheel getal zijn." ] .

##############################################################################
# Charters and changes of organisation
##############################################################################

mbrsh:CharterShape a sh:NodeShape ;
    sh:targetClass mbr:Charter ;
    sh:property [ sh:path mbr:issuedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class org:Organization ;
                  sh:message "A charter needs exactly one issuing organisation (mbr:issuedBy). | Ett stiftelsebrev behöver exakt en utfärdande organisation (mbr:issuedBy). | Une charte a besoin d'exactement une organisation émettrice (mbr:issuedBy). | Eine Urkunde braucht genau eine ausstellende Organisation (mbr:issuedBy). | Una carta richiede esattamente un'organizzazione emittente (mbr:issuedBy). | Una carta constitutiva necesita exactamente una organización emisora (mbr:issuedBy). | Uma carta constitutiva precisa de exatamente uma organização emissora (mbr:issuedBy). | Egy alapítólevélnek pontosan egy kiállító szervezete kell legyen (mbr:issuedBy). | Ένας ιδρυτικός χάρτης χρειάζεται ακριβώς μία εκδούσα οργάνωση (mbr:issuedBy). | Een charter heeft precies één verlenende organisatie nodig (mbr:issuedBy)." ] ,
                [ sh:path mbr:issuedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class org:Organization ;
                  sh:message "A charter needs exactly one organisation that holds it (mbr:issuedTo). | Ett stiftelsebrev behöver exakt en organisation som innehar det (mbr:issuedTo). | Une charte a besoin d'exactement une organisation qui la détient (mbr:issuedTo). | Eine Urkunde braucht genau eine Organisation, die sie innehat (mbr:issuedTo). | Una carta richiede esattamente un'organizzazione che la detiene (mbr:issuedTo). | Una carta constitutiva necesita exactamente una organización que la posea (mbr:issuedTo). | Uma carta constitutiva precisa de exatamente uma organização que a detenha (mbr:issuedTo). | Egy alapítólevélnek pontosan egy szervezete kell legyen, amely birtokolja (mbr:issuedTo). | Ένας ιδρυτικός χάρτης χρειάζεται ακριβώς μία οργάνωση που τον κατέχει (mbr:issuedTo). | Een charter heeft precies één organisatie nodig die het houdt (mbr:issuedTo)." ] ,
                [ sh:path mbr:charterStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:node mbrsh:CharterStatusValue ;
                  sh:message "mbr:charterStatus must be exactly one concept in mbrc:CharterStatuses, or one mapped to it. | mbr:charterStatus ska vara exakt ett begrepp i mbrc:CharterStatuses, eller ett som är mappat dit. | mbr:charterStatus doit être exactement un concept de mbrc:CharterStatuses, ou un concept qui y est mis en correspondance. | mbr:charterStatus muss genau ein Konzept in mbrc:CharterStatuses sein, oder eines, das darauf abgebildet ist. | mbr:charterStatus deve essere esattamente un concetto di mbrc:CharterStatuses, o uno mappato su di esso. | mbr:charterStatus debe ser exactamente un concepto de mbrc:CharterStatuses, o uno asociado a él. | mbr:charterStatus tem de ser exatamente um conceito de mbrc:CharterStatuses, ou um associado a ele. | Az mbr:charterStatus értéke pontosan egy fogalom az mbrc:CharterStatuses-ból, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:charterStatus πρέπει να είναι ακριβώς μία έννοια του mbrc:CharterStatuses, ή αντιστοιχισμένη σε αυτό. | mbr:charterStatus moet precies één concept in mbrc:CharterStatuses zijn, of een concept dat daarop is afgebeeld." ] ;
    # A body does not charter itself.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A charter cannot be issued by the organisation that holds it (mbr:issuedBy and mbr:issuedTo are the same). | Ett stiftelsebrev kan inte utfärdas av den organisation som innehar det (mbr:issuedBy och mbr:issuedTo är samma). | Une charte ne peut pas être délivrée par l'organisation qui la détient (mbr:issuedBy et mbr:issuedTo sont identiques). | Eine Urkunde kann nicht von der Organisation ausgestellt werden, die sie innehat (mbr:issuedBy und mbr:issuedTo sind dieselbe). | Una carta non può essere rilasciata dall'organizzazione che la detiene (mbr:issuedBy e mbr:issuedTo coincidono). | Una carta constitutiva no puede ser expedida por la organización que la posee (mbr:issuedBy y mbr:issuedTo son la misma). | Uma carta constitutiva não pode ser emitida pela organização que a detém (mbr:issuedBy e mbr:issuedTo são a mesma). | Az alapítólevelet nem állíthatja ki az a szervezet, amely birtokolja (az mbr:issuedBy és az mbr:issuedTo azonos). | Ένας ιδρυτικός χάρτης δεν μπορεί να εκδοθεί από την οργάνωση που τον κατέχει (τα mbr:issuedBy και mbr:issuedTo είναι τα ίδια). | Een charter kan niet worden verleend door de organisatie die het houdt (mbr:issuedBy en mbr:issuedTo zijn gelijk)." ;
        sh:prefixes <https://w3id.org/membership/shapes> ;
        sh:select """
            SELECT $this ?o WHERE { $this mbr:issuedBy ?o ; mbr:issuedTo ?o . }
        """
    ] .

mbrsh:ChangeEventShape a sh:NodeShape ;
    sh:targetClass org:ChangeEvent ;
    sh:property [ sh:path mbr:changeEventType ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:node mbrsh:ChangeEventTypeValue ;
                  sh:message "mbr:changeEventType must be one concept in mbrc:ChangeEventTypes, or one mapped to it. | mbr:changeEventType ska vara ett begrepp i mbrc:ChangeEventTypes, eller ett som är mappat dit. | mbr:changeEventType doit être un concept de mbrc:ChangeEventTypes, ou un concept qui y est mis en correspondance. | mbr:changeEventType muss ein Konzept in mbrc:ChangeEventTypes sein, oder eines, das darauf abgebildet ist. | mbr:changeEventType deve essere un concetto di mbrc:ChangeEventTypes, o uno mappato su di esso. | mbr:changeEventType debe ser un concepto de mbrc:ChangeEventTypes, o uno asociado a él. | mbr:changeEventType tem de ser um conceito de mbrc:ChangeEventTypes, ou um associado a ele. | Az mbr:changeEventType értéke az mbrc:ChangeEventTypes egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:changeEventType πρέπει να είναι μία έννοια του mbrc:ChangeEventTypes, ή αντιστοιχισμένη σε αυτό. | mbr:changeEventType moet één concept in mbrc:ChangeEventTypes zijn, of een concept dat daarop is afgebeeld." ] .

##############################################################################
# Membership fees
##############################################################################

mbrsh:AmountList
    sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] ) .

mbrsh:MembershipFeeLinkShape a sh:NodeShape ;
    sh:targetSubjectsOf mbr:membershipFee ;
    sh:property [ sh:path mbr:membershipFee ; sh:class mbr:MembershipFee ] .

mbrsh:MembershipFeeShape a sh:NodeShape ;
    sh:targetClass mbr:MembershipFee ;
    sh:property [ sh:path mbr:feeType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:node mbrsh:FeeTypeValue ;
                  sh:message "A membership fee needs exactly one mbr:feeType from mbrc:FeeTypes, or a concept mapped to it. | En medlemsavgift behöver exakt en mbr:feeType från mbrc:FeeTypes, eller ett begrepp som är mappat dit. | Une cotisation a besoin d'exactement un mbr:feeType de mbrc:FeeTypes, ou d'un concept qui y est mappé. | Ein Mitgliedsbeitrag braucht genau einen mbr:feeType aus mbrc:FeeTypes oder ein darauf abgebildetes Konzept. | Una quota associativa richiede esattamente un mbr:feeType di mbrc:FeeTypes, o un concetto associato a esso. | Una cuota de socio necesita exactamente un mbr:feeType de mbrc:FeeTypes, o un concepto asociado a él. | Uma quota precisa de exatamente um mbr:feeType de mbrc:FeeTypes, ou de um conceito associado a ele. | Egy tagdíjnak pontosan egy mbr:feeType értéke kell legyen az mbrc:FeeTypes-ból, vagy egy hozzárendelt fogalom. | Μια συνδρομή μέλους χρειάζεται ακριβώς ένα mbr:feeType από το mbrc:FeeTypes, ή μια έννοια αντιστοιχισμένη σε αυτό. | Een contributie heeft precies één mbr:feeType uit mbrc:FeeTypes nodig, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path schema:price ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:node mbrsh:AmountList ; sh:minInclusive 0 ;
                  sh:message "A membership fee needs exactly one schema:price, a number of zero or more. | En medlemsavgift behöver exakt ett schema:price, ett tal som är noll eller större. | Une cotisation a besoin d'exactement un schema:price, un nombre supérieur ou égal à zéro. | Ein Mitgliedsbeitrag braucht genau einen schema:price, eine Zahl von null oder mehr. | Una quota associativa richiede esattamente un schema:price, un numero pari o superiore a zero. | Una cuota de socio necesita exactamente un schema:price, un número igual o mayor que cero. | Uma quota precisa de exatamente um schema:price, um número igual ou superior a zero. | Egy tagdíjnak pontosan egy schema:price értéke kell legyen, nullánál nem kisebb szám. | Μια συνδρομή μέλους χρειάζεται ακριβώς ένα schema:price, έναν αριθμό μηδέν ή μεγαλύτερο. | Een contributie heeft precies één schema:price nodig, een getal van nul of meer." ] ,
                [ sh:path schema:priceCurrency ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:pattern "^[A-Z]{3}$" ;
                  sh:message "schema:priceCurrency must be a three-letter ISO 4217 code such as SEK or GBP. | schema:priceCurrency ska vara en trebokstavskod enligt ISO 4217, t.ex. SEK eller GBP. | schema:priceCurrency doit être un code ISO 4217 de trois lettres, comme SEK ou GBP. | schema:priceCurrency muss ein dreibuchstabiger ISO-4217-Code wie SEK oder GBP sein. | schema:priceCurrency deve essere un codice ISO 4217 di tre lettere come SEK o GBP. | schema:priceCurrency debe ser un código ISO 4217 de tres letras como SEK o GBP. | schema:priceCurrency tem de ser um código ISO 4217 de três letras como SEK ou GBP. | A schema:priceCurrency értéke hárombetűs ISO 4217 kód kell legyen, például SEK vagy GBP. | Το schema:priceCurrency πρέπει να είναι τριγράμματος κωδικός ISO 4217 όπως SEK ή GBP. | schema:priceCurrency moet een ISO 4217-code van drie letters zijn, zoals SEK of GBP." ] ,
                [ sh:path mbr:appliesToCategory ; sh:class skos:Concept ;
                  sh:node mbrsh:MembershipCategoryValue ;
                  sh:message "mbr:appliesToCategory must be a concept in mbrc:MembershipCategories, or one mapped to it. | mbr:appliesToCategory ska vara ett begrepp i mbrc:MembershipCategories, eller ett som är mappat dit. | mbr:appliesToCategory doit être un concept de mbrc:MembershipCategories, ou un concept qui y est mappé. | mbr:appliesToCategory muss ein Konzept aus mbrc:MembershipCategories sein oder eines, das darauf abgebildet ist. | mbr:appliesToCategory deve essere un concetto di mbrc:MembershipCategories, o uno associato a esso. | mbr:appliesToCategory debe ser un concepto de mbrc:MembershipCategories, o uno asociado a él. | mbr:appliesToCategory tem de ser um conceito de mbrc:MembershipCategories, ou um associado a ele. | Az mbr:appliesToCategory értéke az mbrc:MembershipCategories egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:appliesToCategory πρέπει να είναι έννοια του mbrc:MembershipCategories, ή αντιστοιχισμένη σε αυτό. | mbr:appliesToCategory moet een concept in mbrc:MembershipCategories zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path mbr:startDate ; sh:minCount 1 ; sh:severity sh:Warning ;
                  sh:message "Give the date from which the fee applies (mbr:startDate). | Ange från vilket datum avgiften gäller (mbr:startDate). | Indiquer la date à partir de laquelle la cotisation s'applique (mbr:startDate). | Das Datum angeben, ab dem der Beitrag gilt (mbr:startDate). | Indicare la data da cui si applica la quota (mbr:startDate). | Indique la fecha desde la que se aplica la cuota (mbr:startDate). | Indique a data a partir da qual se aplica a quota (mbr:startDate). | Adja meg a dátumot, amelytől a díj érvényes (mbr:startDate). | Δώστε την ημερομηνία από την οποία ισχύει η συνδρομή (mbr:startDate). | Geef de datum vanaf wanneer de contributie geldt (mbr:startDate)." ] .

##############################################################################
# Offices and terms of office
##############################################################################

mbrsh:TenureShape a sh:NodeShape ;
    sh:targetClass mbr:Tenure ;
    sh:property [ sh:path org:member ; sh:minCount 1 ; sh:maxCount 1 ; sh:class foaf:Agent ] ,
                [ sh:path org:organization ; sh:minCount 1 ; sh:maxCount 1 ; sh:class org:Organization ] ,
                [ sh:path org:role ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mbr:Office ;
                  sh:message "A term of office needs exactly one org:role that is a mbr:Office. | En ämbetsperiod behöver exakt en org:role som är ett mbr:Office. | Un mandat a besoin d'exactement un org:role qui est un mbr:Office. | Eine Amtszeit braucht genau eine org:role, die ein mbr:Office ist. | Un mandato richiede esattamente un org:role che sia un mbr:Office. | Un mandato necesita exactamente un org:role que sea un mbr:Office. | Um mandato precisa de exatamente um org:role que seja um mbr:Office. | Egy megbízatásnak pontosan egy org:role értéke kell legyen, amely mbr:Office. | Μια θητεία χρειάζεται ακριβώς έναν org:role που είναι mbr:Office. | Een ambtstermijn heeft precies één org:role nodig die een mbr:Office is." ] ,
                [ sh:path org:role ; sh:node mbrsh:OfficeTypeValue ;
                  sh:message "org:role must be a concept in mbrc:OfficeTypes, or one mapped to it. | org:role ska vara ett begrepp i mbrc:OfficeTypes, eller ett som är mappat dit. | org:role doit être un concept de mbrc:OfficeTypes, ou un concept qui y est associé. | org:role muss ein Konzept aus mbrc:OfficeTypes sein oder eines, das darauf abgebildet ist. | org:role deve essere un concetto di mbrc:OfficeTypes, o uno associato a esso. | org:role debe ser un concepto de mbrc:OfficeTypes, o uno asociado a él. | org:role tem de ser um conceito de mbrc:OfficeTypes, ou um associado a ele. | Az org:role értéke az mbrc:OfficeTypes egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το org:role πρέπει να είναι έννοια του mbrc:OfficeTypes, ή αντιστοιχισμένη σε αυτό. | org:role moet een concept in mbrc:OfficeTypes zijn, of een concept dat daarop is afgebeeld." ] .

