                [ sh:path mbr:publicBenefitStatus ; sh:class skos:Concept ;
                  sh:node mbrsh:PublicBenefitStatusValue ;
                  sh:message "mbr:publicBenefitStatus must be a concept in mbrc:PublicBenefitStatuses, or one mapped to it. | mbr:publicBenefitStatus ska vara ett begrepp i mbrc:PublicBenefitStatuses, eller ett som är mappat dit. | mbr:publicBenefitStatus doit être un concept de mbrc:PublicBenefitStatuses, ou un concept qui y est associé. | mbr:publicBenefitStatus muss ein Konzept aus mbrc:PublicBenefitStatuses sein oder eines, das darauf abgebildet ist. | mbr:publicBenefitStatus deve essere un concetto di mbrc:PublicBenefitStatuses, o uno associato a esso. | mbr:publicBenefitStatus debe ser un concepto de mbrc:PublicBenefitStatuses, o uno asociado a él. | mbr:publicBenefitStatus tem de ser um conceito de mbrc:PublicBenefitStatuses, ou um associado a ele. | Az mbr:publicBenefitStatus értéke az mbrc:PublicBenefitStatuses egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:publicBenefitStatus πρέπει να είναι έννοια του mbrc:PublicBenefitStatuses, ή αντιστοιχισμένη σε αυτό. | mbr:publicBenefitStatus moet een concept in mbrc:PublicBenefitStatuses zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path rov:registration ; sh:class adms:Identifier ] ,
                [ sh:path mbr:ownershipModel ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:node mbrsh:OwnershipModelValue ;
                  sh:message "mbr:ownershipModel must be a concept in mbrc:OwnershipModels, or one mapped to it. | mbr:ownershipModel ska vara ett begrepp i mbrc:OwnershipModels, eller ett som är mappat dit. | mbr:ownershipModel doit être un concept de mbrc:OwnershipModels, ou un concept qui y est mappé. | mbr:ownershipModel muss ein Konzept aus mbrc:OwnershipModels sein oder eines, das darauf abgebildet ist. | mbr:ownershipModel deve essere un concetto di mbrc:OwnershipModels, o uno associato a esso. | mbr:ownershipModel debe ser un concepto de mbrc:OwnershipModels, o uno asociado a él. | mbr:ownershipModel tem de ser um conceito de mbrc:OwnershipModels, ou um associado a ele. | Az mbr:ownershipModel értéke az mbrc:OwnershipModels egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:ownershipModel πρέπει να είναι έννοια του mbrc:OwnershipModels, ή αντιστοιχισμένη σε αυτό. | mbr:ownershipModel moet een concept in mbrc:OwnershipModels zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path mbr:hasMemberCount ; sh:class mbr:MemberCount ] ,
                [ sh:path mbr:dressCode ; sh:class skos:Concept ; sh:node mbrsh:DressCodeValue ;
                  sh:message "mbr:dressCode must be a concept in mbrc:DressCodes, or one mapped to it. | mbr:dressCode ska vara ett begrepp i mbrc:DressCodes, eller ett som är mappat dit. | mbr:dressCode doit être un concept de mbrc:DressCodes, ou un concept qui y est mappé. | mbr:dressCode muss ein Konzept aus mbrc:DressCodes sein oder eines, das darauf abgebildet ist. | mbr:dressCode deve essere un concetto di mbrc:DressCodes, o uno associato a esso. | mbr:dressCode debe ser un concepto de mbrc:DressCodes, o uno asociado a él. | mbr:dressCode tem de ser um conceito de mbrc:DressCodes, ou um associado a ele. | Az mbr:dressCode értéke az mbrc:DressCodes egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:dressCode πρέπει να είναι έννοια του mbrc:DressCodes, ή αντιστοιχισμένη σε αυτό. | mbr:dressCode moet een concept in mbrc:DressCodes zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path schema:url ; sh:nodeKind sh:IRI ;
                  sh:message "schema:url must be an IRI, e.g. <https://example.org/>. | schema:url ska vara en IRI, t.ex. <https://example.org/>. | schema:url doit être une IRI, par ex. <https://example.org/>. | schema:url muss eine IRI sein, z. B. <https://example.org/>. | schema:url deve essere un IRI, ad es. <https://example.org/>. | schema:url debe ser un IRI, p. ej. <https://example.org/>. | schema:url tem de ser um IRI, p. ex. <https://example.org/>. | A schema:url értéke IRI kell legyen, például <https://example.org/>. | Το schema:url πρέπει να είναι IRI, π.χ. <https://example.org/>. | schema:url moet een IRI zijn, bijv. <https://example.org/>." ] ,
                [ sh:path schema:email ; sh:datatype xsd:string ; sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ;
                  sh:message "schema:email must be a plain e-mail address. | schema:email ska vara en e-postadress. | schema:email doit être une simple adresse e-mail. | schema:email muss eine einfache E-Mail-Adresse sein. | schema:email deve essere un semplice indirizzo e-mail. | schema:email debe ser una dirección de correo electrónico simple. | schema:email tem de ser um endereço de correio eletrónico simples. | A schema:email értéke egyszerű e-mail-cím kell legyen. | Το schema:email πρέπει να είναι απλή διεύθυνση ηλεκτρονικού ταχυδρομείου. | schema:email moet een gewoon e-mailadres zijn." ] ,
                [ sh:path schema:telephone ; sh:datatype xsd:string ] ;

    # A closed or merged organisation should not still be marked active.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An organisation with a dissolution date cannot have status active. | En organisation med upplösningsdatum kan inte ha status verksam. | Une organisation ayant une date de dissolution ne peut pas avoir le statut en activité. | Eine Organisation mit Auflösungsdatum kann nicht den Status „aktiv“ haben. | Un'organizzazione con una data di scioglimento non può avere lo stato attivo. | Una organización con fecha de disolución no puede tener el estado activa. | Uma organização com data de dissolução não pode ter o estado ativa. | A megszűnési dátummal rendelkező szervezet állapota nem lehet működő. | Μια οργάνωση με ημερομηνία λύσης δεν μπορεί να έχει κατάσταση ενεργή. | Een organisatie met een datum van opheffing kan niet de status actief hebben." ;
        sh:prefixes <https://w3id.org/membership/shapes> ;
        sh:select """
            SELECT $this WHERE {
                $this mbr:dissolutionDate ?d ;
                      mbr:organizationStatus mbrc:activeOrganization .
            }
        """
    ] ;

    # Dissolution cannot come before founding; partial dates are compared as in
    # mbrsh:EndDateShape (an error only when certain).
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The dissolution date is certainly before the founding date. | Upplösningsdatumet ligger säkert före grundningsdatumet. | La date de dissolution est certainement antérieure à la date de fondation. | Das Auflösungsdatum liegt sicher vor dem Gründungsdatum. | La data di scioglimento è certamente anteriore alla data di fondazione. | La fecha de disolución es con seguridad anterior a la fecha de fundación. | A data de dissolução é com certeza anterior à data de fundação. | A megszűnés dátuma biztosan korábbi az alapítás dátumánál. | Η ημερομηνία λύσης είναι σίγουρα πριν από την ημερομηνία ίδρυσης. | De datum van opheffing ligt zeker vóór de oprichtingsdatum." ;
        sh:prefixes <https://w3id.org/membership/shapes> ;
        sh:select """
            SELECT $this WHERE {
                $this mbr:foundingDate ?f ;
                      mbr:dissolutionDate ?d .
                FILTER (datatype(?f) IN (xsd:date, xsd:gYearMonth, xsd:gYear) &&
                        datatype(?d) IN (xsd:date, xsd:gYearMonth, xsd:gYear))
                FILTER (REGEX(STR(?f), "^[0-9]{4}") && REGEX(STR(?d), "^[0-9]{4}"))
                BIND (IF(datatype(?f) = xsd:date, SUBSTR(STR(?f), 1, 10),
                      IF(datatype(?f) = xsd:gYearMonth, CONCAT(SUBSTR(STR(?f), 1, 7), "-01"),
                         CONCAT(SUBSTR(STR(?f), 1, 4), "-01-01"))) AS ?earliestFounding)
                BIND (IF(datatype(?d) = xsd:date, SUBSTR(STR(?d), 1, 10),
                      IF(datatype(?d) = xsd:gYearMonth, CONCAT(SUBSTR(STR(?d), 1, 7), "-31"),
                         CONCAT(SUBSTR(STR(?d), 1, 4), "-12-31"))) AS ?latestDissolution)
                FILTER (?latestDissolution < ?earliestFounding)
            }
        """
    ] .

##############################################################################
# Periods of gender policy, admission mode, ownership model and status
##############################################################################

mbrsh:HasPeriodShape a sh:NodeShape ;
    sh:targetSubjectsOf mbr:hasPeriod ;
    sh:class org:Organization ;
    sh:property [ sh:path mbr:hasPeriod ; sh:class mbr:OrganizationPeriod ;
                  sh:message "mbr:hasPeriod must lead to an mbr:OrganizationPeriod. | mbr:hasPeriod ska leda till en mbr:OrganizationPeriod. | mbr:hasPeriod doit mener à une mbr:OrganizationPeriod. | mbr:hasPeriod muss auf eine mbr:OrganizationPeriod verweisen. | mbr:hasPeriod deve condurre a un mbr:OrganizationPeriod. | mbr:hasPeriod debe conducir a un mbr:OrganizationPeriod. | mbr:hasPeriod tem de conduzir a um mbr:OrganizationPeriod. | Az mbr:hasPeriod egy mbr:OrganizationPeriod-ra kell mutasson. | Το mbr:hasPeriod πρέπει να οδηγεί σε ένα mbr:OrganizationPeriod. | mbr:hasPeriod moet naar een mbr:OrganizationPeriod leiden." ] .

# Kept apart from the shape below: a sh:message on a shape replaces the messages of the
# SPARQL constraint in that shape.
mbrsh:OrganizationPeriodContentShape a sh:NodeShape ;
    sh:targetClass mbr:OrganizationPeriod ;
    sh:targetObjectsOf mbr:hasPeriod ;
    sh:or ( [ sh:path mbr:genderPolicy ; sh:minCount 1 ]
            [ sh:path mbr:admissionMode ; sh:minCount 1 ]
            [ sh:path mbr:ownershipModel ; sh:minCount 1 ]
            [ sh:path mbr:organizationStatus ; sh:minCount 1 ]
            [ sh:path mbr:organizationType ; sh:minCount 1 ]
            [ sh:path mbr:legalForm ; sh:minCount 1 ]
            [ sh:path mbr:publicBenefitStatus ; sh:minCount 1 ] ) ;
    sh:message "A period needs at least one of mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType, mbr:legalForm and mbr:publicBenefitStatus. | En period behöver minst en av mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType, mbr:legalForm och mbr:publicBenefitStatus. | Une période a besoin d'au moins l'un de mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType, mbr:legalForm et mbr:publicBenefitStatus. | Ein Zeitraum braucht mindestens eines von mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType, mbr:legalForm und mbr:publicBenefitStatus. | Un periodo richiede almeno una tra mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType, mbr:legalForm e mbr:publicBenefitStatus. | Un período necesita al menos una de las propiedades mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType, mbr:legalForm y mbr:publicBenefitStatus. | Um período precisa de pelo menos uma das propriedades mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType, mbr:legalForm e mbr:publicBenefitStatus. | Egy időszaknak legalább egyet tartalmaznia kell ezek közül: mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType, mbr:legalForm és mbr:publicBenefitStatus. | Μια περίοδος χρειάζεται τουλάχιστον ένα από τα mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType, mbr:legalForm και mbr:publicBenefitStatus. | Een periode heeft ten minste een van mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType, mbr:legalForm en mbr:publicBenefitStatus nodig." .

mbrsh:OrganizationPeriodShape a sh:NodeShape ;
    sh:targetClass mbr:OrganizationPeriod ;
    sh:targetObjectsOf mbr:hasPeriod ;
    sh:property [ sh:path [ sh:inversePath mbr:hasPeriod ] ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A period belongs to exactly one organisation, linked with mbr:hasPeriod. | En period hör till exakt en organisation, kopplad med mbr:hasPeriod. | Une période appartient à exactement une organisation, reliée par mbr:hasPeriod. | Ein Zeitraum gehört zu genau einer Organisation, verknüpft mit mbr:hasPeriod. | Un periodo appartiene a esattamente un'organizzazione, collegata con mbr:hasPeriod. | Un período pertenece a exactamente una organización, vinculada con mbr:hasPeriod. | Um período pertence a exatamente uma organização, ligada com mbr:hasPeriod. | Egy időszak pontosan egy szervezethez tartozik, az mbr:hasPeriod-dal kapcsolva. | Μια περίοδος ανήκει σε ακριβώς μία οργάνωση, συνδεδεμένη με το mbr:hasPeriod. | Een periode hoort bij precies één organisatie, gekoppeld met mbr:hasPeriod." ] ,
                [ sh:path mbr:genderPolicy ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:node mbrsh:GenderPolicyValue ;
                  sh:message "mbr:genderPolicy must be one concept in mbrc:GenderPolicies, or one mapped to it. | mbr:genderPolicy ska vara ett begrepp i mbrc:GenderPolicies, eller ett som är mappat dit. | mbr:genderPolicy doit être un seul concept de mbrc:GenderPolicies, ou un concept qui y est mappé. | mbr:genderPolicy muss ein einzelnes Konzept aus mbrc:GenderPolicies sein oder eines, das darauf abgebildet ist. | mbr:genderPolicy deve essere un unico concetto di mbrc:GenderPolicies, o uno associato a esso. | mbr:genderPolicy debe ser un concepto de mbrc:GenderPolicies, o uno asociado a él. | mbr:genderPolicy tem de ser um conceito de mbrc:GenderPolicies, ou um associado a ele. | Az mbr:genderPolicy értéke az mbrc:GenderPolicies egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:genderPolicy πρέπει να είναι μία έννοια του mbrc:GenderPolicies, ή αντιστοιχισμένη σε αυτό. | mbr:genderPolicy moet één concept in mbrc:GenderPolicies zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path mbr:admissionMode ; sh:class skos:Concept ;
                  sh:node mbrsh:AdmissionModeValue ;
                  sh:message "mbr:admissionMode must be a concept in mbrc:AdmissionModes, or one mapped to it. | mbr:admissionMode ska vara ett begrepp i mbrc:AdmissionModes, eller ett som är mappat dit. | mbr:admissionMode doit être un concept de mbrc:AdmissionModes, ou un concept qui y est mappé. | mbr:admissionMode muss ein Konzept aus mbrc:AdmissionModes sein oder eines, das darauf abgebildet ist. | mbr:admissionMode deve essere un concetto di mbrc:AdmissionModes, o uno associato a esso. | mbr:admissionMode debe ser un concepto de mbrc:AdmissionModes, o uno asociado a él. | mbr:admissionMode tem de ser um conceito de mbrc:AdmissionModes, ou um associado a ele. | Az mbr:admissionMode értéke az mbrc:AdmissionModes egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:admissionMode πρέπει να είναι έννοια του mbrc:AdmissionModes, ή αντιστοιχισμένη σε αυτό. | mbr:admissionMode moet een concept in mbrc:AdmissionModes zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path mbr:ownershipModel ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:node mbrsh:OwnershipModelValue ;
                  sh:message "mbr:ownershipModel must be one concept in mbrc:OwnershipModels, or one mapped to it. | mbr:ownershipModel ska vara ett begrepp i mbrc:OwnershipModels, eller ett som är mappat dit. | mbr:ownershipModel doit être un seul concept de mbrc:OwnershipModels, ou un concept qui y est mappé. | mbr:ownershipModel muss ein einzelnes Konzept aus mbrc:OwnershipModels sein oder eines, das darauf abgebildet ist. | mbr:ownershipModel deve essere un unico concetto di mbrc:OwnershipModels, o uno associato a esso. | mbr:ownershipModel debe ser un concepto de mbrc:OwnershipModels, o uno asociado a él. | mbr:ownershipModel tem de ser um conceito de mbrc:OwnershipModels, ou um associado a ele. | Az mbr:ownershipModel értéke az mbrc:OwnershipModels egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:ownershipModel πρέπει να είναι μία έννοια του mbrc:OwnershipModels, ή αντιστοιχισμένη σε αυτό. | mbr:ownershipModel moet één concept in mbrc:OwnershipModels zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path mbr:organizationStatus ; sh:maxCount 1 ; sh:class skos:Concept ;
                  sh:node mbrsh:OrganizationStatusValue ;
                  sh:message "mbr:organizationStatus must be one concept in mbrc:OrganizationStatuses, or one mapped to it. | mbr:organizationStatus ska vara ett begrepp i mbrc:OrganizationStatuses, eller ett som är mappat dit. | mbr:organizationStatus doit être un seul concept de mbrc:OrganizationStatuses, ou un concept qui y est mappé. | mbr:organizationStatus muss ein einzelnes Konzept aus mbrc:OrganizationStatuses sein oder eines, das darauf abgebildet ist. | mbr:organizationStatus deve essere un unico concetto di mbrc:OrganizationStatuses, o uno associato a esso. | mbr:organizationStatus debe ser un concepto de mbrc:OrganizationStatuses, o uno asociado a él. | mbr:organizationStatus tem de ser um conceito de mbrc:OrganizationStatuses, ou um associado a ele. | Az mbr:organizationStatus értéke az mbrc:OrganizationStatuses egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:organizationStatus πρέπει να είναι μία έννοια του mbrc:OrganizationStatuses, ή αντιστοιχισμένη σε αυτό. | mbr:organizationStatus moet één concept in mbrc:OrganizationStatuses zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path mbr:organizationType ; sh:class skos:Concept ;
                  sh:node mbrsh:OrganizationTypeValue ;
                  sh:message "mbr:organizationType must be a concept in mbrc:OrganizationTypes, or one mapped to it. | mbr:organizationType ska vara ett begrepp i mbrc:OrganizationTypes, eller ett som är mappat dit. | mbr:organizationType doit être un concept de mbrc:OrganizationTypes, ou un concept qui y est mappé. | mbr:organizationType muss ein Konzept aus mbrc:OrganizationTypes sein oder eines, das darauf abgebildet ist. | mbr:organizationType deve essere un concetto di mbrc:OrganizationTypes, o uno associato a esso. | mbr:organizationType debe ser un concepto de mbrc:OrganizationTypes, o uno asociado a él. | mbr:organizationType tem de ser um conceito de mbrc:OrganizationTypes, ou um associado a ele. | Az mbr:organizationType értéke az mbrc:OrganizationTypes egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:organizationType πρέπει να είναι έννοια του mbrc:OrganizationTypes, ή αντιστοιχισμένη σε αυτό. | mbr:organizationType moet een concept in mbrc:OrganizationTypes zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path mbr:publicBenefitStatus ; sh:class skos:Concept ;
                  sh:node mbrsh:PublicBenefitStatusValue ;
                  sh:message "mbr:publicBenefitStatus must be a concept in mbrc:PublicBenefitStatuses, or one mapped to it. | mbr:publicBenefitStatus ska vara ett begrepp i mbrc:PublicBenefitStatuses, eller ett som är mappat dit. | mbr:publicBenefitStatus doit être un concept de mbrc:PublicBenefitStatuses, ou un concept qui y est associé. | mbr:publicBenefitStatus muss ein Konzept aus mbrc:PublicBenefitStatuses sein oder eines, das darauf abgebildet ist. | mbr:publicBenefitStatus deve essere un concetto di mbrc:PublicBenefitStatuses, o uno associato a esso. | mbr:publicBenefitStatus debe ser un concepto de mbrc:PublicBenefitStatuses, o uno asociado a él. | mbr:publicBenefitStatus tem de ser um conceito de mbrc:PublicBenefitStatuses, ou um associado a ele. | Az mbr:publicBenefitStatus értéke az mbrc:PublicBenefitStatuses egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:publicBenefitStatus πρέπει να είναι έννοια του mbrc:PublicBenefitStatuses, ή αντιστοιχισμένη σε αυτό. | mbr:publicBenefitStatus moet een concept in mbrc:PublicBenefitStatuses zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path mbr:legalForm ; sh:class skos:Concept ;
                  sh:node mbrsh:LegalFormValue ;
                  sh:message "mbr:legalForm must be a concept in mbrc:LegalForms, or one mapped to it. | mbr:legalForm ska vara ett begrepp i mbrc:LegalForms, eller ett som är mappat dit. | mbr:legalForm doit être un concept de mbrc:LegalForms, ou un concept qui y est mappé. | mbr:legalForm muss ein Konzept aus mbrc:LegalForms sein oder eines, das darauf abgebildet ist. | mbr:legalForm deve essere un concetto di mbrc:LegalForms, o uno associato a esso. | mbr:legalForm debe ser un concepto de mbrc:LegalForms, o uno asociado a él. | mbr:legalForm tem de ser um conceito de mbrc:LegalForms, ou um associado a ele. | Az mbr:legalForm értéke az mbrc:LegalForms egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:legalForm πρέπει να είναι έννοια του mbrc:LegalForms, ή αντιστοιχισμένη σε αυτό. | mbr:legalForm moet een concept in mbrc:LegalForms zijn, of een concept dat daarop is afgebeeld." ] ,
                [ sh:path mbr:startDate ; sh:minCount 1 ; sh:severity sh:Warning ;
                  sh:message "Give the date from which the period applies (mbr:startDate). | Ange från vilket datum perioden gäller (mbr:startDate). | Indiquez la date à partir de laquelle la période s'applique (mbr:startDate). | Das Datum angeben, ab dem der Zeitraum gilt (mbr:startDate). | Indicare la data da cui si applica il periodo (mbr:startDate). | Indique la fecha desde la que se aplica el período (mbr:startDate). | Indique a data a partir da qual se aplica o período (mbr:startDate). | Adja meg a dátumot, amelytől az időszak érvényes (mbr:startDate). | Δώστε την ημερομηνία από την οποία ισχύει η περίοδος (mbr:startDate). | Geef de datum vanaf wanneer de periode geldt (mbr:startDate)." ] ;

    # One organisation cannot have two different values of the same single-valued property
    # at once. Reported only when two periods certainly overlap: both have a start and an end,
    # and the latest each could start is before the earliest the other could end (dates
    # compared as in mbrsh:EndDateShape). A period that ends on the day another starts, or
    # that has no end date, is not reported. mbr:admissionMode, mbr:organizationType,
    # mbr:legalForm and mbr:publicBenefitStatus are left out: an organisation may admit in
    # several ways, have several types, in some jurisdictions more than one legal form at
    # once, and several public-benefit statuses (an Italian association is both a
    # Third Sector entity and a social promotion association).
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The organisation has two different values of {?p} in periods that certainly overlap ({?other}). | Organisationen har två olika värden på {?p} i perioder som säkert överlappar ({?other}). | L'organisation a deux valeurs différentes de {?p} dans des périodes qui se chevauchent certainement ({?other}). | Die Organisation hat zwei verschiedene Werte von {?p} in Zeiträumen, die sich sicher überschneiden ({?other}). | L'organizzazione ha due valori diversi di {?p} in periodi che certamente si sovrappongono ({?other}). | La organización tiene dos valores distintos de {?p} en períodos que con seguridad se solapan ({?other}). | A organização tem dois valores diferentes de {?p} em períodos que com certeza se sobrepõem ({?other}). | A szervezetnek két különböző értéke van a(z) {?p} tulajdonságból biztosan átfedő időszakokban ({?other}). | Η οργάνωση έχει δύο διαφορετικές τιμές του {?p} σε περιόδους που σίγουρα επικαλύπτονται ({?other}). | De organisatie heeft twee verschillende waarden van {?p} in perioden die elkaar zeker overlappen ({?other})." ;
        sh:prefixes <https://w3id.org/membership/shapes> ;
        sh:select """
            SELECT $this ?other ?p WHERE {
                ?org mbr:hasPeriod $this , ?other .
                FILTER (?other != $this)
                VALUES ?p { mbr:genderPolicy mbr:ownershipModel mbr:organizationStatus }
                $this ?p ?v1 ; mbr:startDate ?s1 ; mbr:endDate ?e1 .
                ?other ?p ?v2 ; mbr:startDate ?s2 ; mbr:endDate ?e2 .
                FILTER (?v1 != ?v2)
                FILTER (datatype(?s1) IN (xsd:date, xsd:gYearMonth, xsd:gYear) &&
                        datatype(?e1) IN (xsd:date, xsd:gYearMonth, xsd:gYear) &&
                        datatype(?s2) IN (xsd:date, xsd:gYearMonth, xsd:gYear) &&
                        datatype(?e2) IN (xsd:date, xsd:gYearMonth, xsd:gYear))
                FILTER (REGEX(STR(?s1), "^[0-9]{4}") && REGEX(STR(?e1), "^[0-9]{4}") &&
                        REGEX(STR(?s2), "^[0-9]{4}") && REGEX(STR(?e2), "^[0-9]{4}"))
                BIND (IF(datatype(?s1) = xsd:date, SUBSTR(STR(?s1), 1, 10),
                      IF(datatype(?s1) = xsd:gYearMonth, CONCAT(SUBSTR(STR(?s1), 1, 7), "-31"),
                         CONCAT(SUBSTR(STR(?s1), 1, 4), "-12-31"))) AS ?latestStart1)
                BIND (IF(datatype(?s2) = xsd:date, SUBSTR(STR(?s2), 1, 10),
                      IF(datatype(?s2) = xsd:gYearMonth, CONCAT(SUBSTR(STR(?s2), 1, 7), "-31"),
                         CONCAT(SUBSTR(STR(?s2), 1, 4), "-12-31"))) AS ?latestStart2)
                BIND (IF(datatype(?e1) = xsd:date, SUBSTR(STR(?e1), 1, 10),
                      IF(datatype(?e1) = xsd:gYearMonth, CONCAT(SUBSTR(STR(?e1), 1, 7), "-01"),
                         CONCAT(SUBSTR(STR(?e1), 1, 4), "-01-01"))) AS ?earliestEnd1)
                BIND (IF(datatype(?e2) = xsd:date, SUBSTR(STR(?e2), 1, 10),
                      IF(datatype(?e2) = xsd:gYearMonth, CONCAT(SUBSTR(STR(?e2), 1, 7), "-01"),
                         CONCAT(SUBSTR(STR(?e2), 1, 4), "-01-01"))) AS ?earliestEnd2)
                FILTER (?latestStart1 < ?earliestEnd2 && ?latestStart2 < ?earliestEnd1)
            }
        """
    ] .

##############################################################################
# Registry identifiers (rov:registration)
##############################################################################

mbrsh:IdentifierShape a sh:NodeShape ;
    sh:targetClass adms:Identifier ;
    sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A registry identifier needs exactly one skos:notation, the number itself. | En registeridentifierare behöver exakt en skos:notation, själva numret. | Un identifiant de registre a besoin d'exactement une skos:notation, le numéro lui-même. | Eine Registerkennung braucht genau eine skos:notation, die Nummer selbst. | Un identificativo di registro richiede esattamente una skos:notation, il numero stesso. | Un identificador de registro necesita exactamente una skos:notation, el número mismo. | Um identificador de registo precisa de exatamente uma skos:notation, o próprio número. | A nyilvántartási azonosítónak pontosan egy skos:notation értéke kell legyen, maga a szám. | Ένα αναγνωριστικό μητρώου χρειάζεται ακριβώς ένα skos:notation, τον ίδιο τον αριθμό. | Een registeridentificatie heeft precies één skos:notation nodig, het nummer zelf." ] ,
                [ sh:path adms:schemaAgency ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:severity sh:Warning ;
                  sh:message "Name the register that issued the identifier with adms:schemaAgency. | Ange registret som utfärdat identifieraren med adms:schemaAgency. | Nommer le registre qui a délivré l'identifiant avec adms:schemaAgency. | Das Register, das die Kennung vergeben hat, mit adms:schemaAgency benennen. | Indicare il registro che ha rilasciato l'identificativo con adms:schemaAgency. | Indique el registro que expidió el identificador con adms:schemaAgency. | Indique o registo que emitiu o identificador com adms:schemaAgency. | Nevezze meg az azonosítót kiállító nyilvántartást az adms:schemaAgency-vel. | Ονομάστε το μητρώο που εξέδωσε το αναγνωριστικό με το adms:schemaAgency. | Noem het register dat de identificatie heeft uitgegeven met adms:schemaAgency." ] .

##############################################################################
# Premises, addresses, coordinates, occupancy and member counts
##############################################################################

mbrsh:PremisesShape a sh:NodeShape ;
    sh:targetClass mbr:Premises ;
    sh:property [ sh:path schema:address ; sh:class schema:PostalAddress ] ,
                [ sh:path schema:geo ; sh:maxCount 1 ; sh:class schema:GeoCoordinates ] ,
                [ sh:path schema:containedInPlace ; sh:nodeKind sh:IRI ] ,
                [ sh:path mbr:dressCode ; sh:class skos:Concept ; sh:node mbrsh:DressCodeValue ;
                  sh:message "mbr:dressCode must be a concept in mbrc:DressCodes, or one mapped to it. | mbr:dressCode ska vara ett begrepp i mbrc:DressCodes, eller ett som är mappat dit. | mbr:dressCode doit être un concept de mbrc:DressCodes, ou un concept qui y est mappé. | mbr:dressCode muss ein Konzept aus mbrc:DressCodes sein oder eines, das darauf abgebildet ist. | mbr:dressCode deve essere un concetto di mbrc:DressCodes, o uno associato a esso. | mbr:dressCode debe ser un concepto de mbrc:DressCodes, o uno asociado a él. | mbr:dressCode tem de ser um conceito de mbrc:DressCodes, ou um associado a ele. | Az mbr:dressCode értéke az mbrc:DressCodes egy fogalma, vagy egy hozzárendelt fogalom kell legyen. | Το mbr:dressCode πρέπει να είναι έννοια του mbrc:DressCodes, ή αντιστοιχισμένη σε αυτό. | mbr:dressCode moet een concept in mbrc:DressCodes zijn, of een concept dat daarop is afgebeeld." ] ;
    # A building may have had several addresses over time, but only one current one.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Premises have more than one current address (addresses without mbr:endDate). Give former addresses an end date. | Lokalen har mer än en nuvarande adress (adresser utan mbr:endDate). Ge tidigare adresser ett slutdatum. | Les locaux ont plus d'une adresse actuelle (adresses sans mbr:endDate). Donner une date de fin aux anciennes adresses. | Die Räumlichkeiten haben mehr als eine aktuelle Adresse (Adressen ohne mbr:endDate). Früheren Adressen ein Enddatum geben. | I locali hanno più di un indirizzo attuale (indirizzi senza mbr:endDate). Dare una data di fine agli indirizzi precedenti. | Los locales tienen más de una dirección actual (direcciones sin mbr:endDate). Dé una fecha de fin a las direcciones anteriores. | As instalações têm mais de uma morada atual (moradas sem mbr:endDate). Dê data de fim às moradas anteriores. | A helyiségeknek egynél több jelenlegi címük van (mbr:endDate nélküli címek). Adjon záró dátumot a korábbi címeknek. | Οι χώροι έχουν περισσότερες από μία τρέχουσες διευθύνσεις (διευθύνσεις χωρίς mbr:endDate). Δώστε ημερομηνία λήξης στις παλιές διευθύνσεις. | Het onderkomen heeft meer dan één huidig adres (adressen zonder mbr:endDate). Geef eerdere adressen een einddatum." ;
        sh:prefixes <https://w3id.org/membership/shapes> ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this schema:address ?a1 , ?a2 .
                FILTER (?a1 != ?a2)
                FILTER NOT EXISTS { ?a1 mbr:endDate ?e1 }
                FILTER NOT EXISTS { ?a2 mbr:endDate ?e2 }
            }
        """
    ] .

mbrsh:PostalAddressShape a sh:NodeShape ;
    sh:targetClass schema:PostalAddress ;
    sh:property [ sh:path schema:streetAddress ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path schema:postalCode ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path schema:addressRegion ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
                [ sh:path schema:addressLocality ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:severity sh:Warning ] ,
                [ sh:path schema:addressCountry ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:pattern "^[A-Z]{2}$" ;
                  sh:message "schema:addressCountry must be a two-letter ISO 3166-1 code such as GB or SE. | schema:addressCountry ska vara en tvåbokstavskod enligt ISO 3166-1, t.ex. GB eller SE. | schema:addressCountry doit être un code ISO 3166-1 de deux lettres, comme GB ou SE. | schema:addressCountry muss ein zweibuchstabiger ISO-3166-1-Code wie GB oder SE sein. | schema:addressCountry deve essere un codice ISO 3166-1 di due lettere come GB o SE. | schema:addressCountry debe ser un código ISO 3166-1 de dos letras como GB o SE. | schema:addressCountry tem de ser um código ISO 3166-1 de duas letras como GB ou SE. | A schema:addressCountry értéke kétbetűs ISO 3166-1 kód kell legyen, például GB vagy SE. | Το schema:addressCountry πρέπει να είναι διγράμματος κωδικός ISO 3166-1 όπως GB ή SE. | schema:addressCountry moet een ISO 3166-1-code van twee letters zijn, zoals GB of SE." ] .

mbrsh:CoordinateList
    sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] ) .

mbrsh:GeoCoordinatesShape a sh:NodeShape ;
    sh:targetClass schema:GeoCoordinates ;
    sh:property [ sh:path schema:latitude ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:node mbrsh:CoordinateList ; sh:minInclusive -90 ; sh:maxInclusive 90 ;
                  sh:message "schema:latitude must be one decimal number between -90 and 90. | schema:latitude ska vara ett decimaltal mellan -90 och 90. | schema:latitude doit être un seul nombre décimal compris entre -90 et 90. | schema:latitude muss eine einzelne Dezimalzahl zwischen -90 und 90 sein. | schema:latitude deve essere un unico numero decimale compreso tra -90 e 90. | schema:latitude debe ser un único número decimal entre -90 y 90. | schema:latitude tem de ser um único número decimal entre -90 e 90. | A schema:latitude értéke egyetlen tizedes szám kell legyen -90 és 90 között. | Το schema:latitude πρέπει να είναι ένας δεκαδικός αριθμός μεταξύ -90 και 90. | schema:latitude moet één decimaal getal tussen -90 en 90 zijn." ] ,
                [ sh:path schema:longitude ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:node mbrsh:CoordinateList ; sh:minInclusive -180 ; sh:maxInclusive 180 ;
                  sh:message "schema:longitude must be one decimal number between -180 and 180. | schema:longitude ska vara ett decimaltal mellan -180 och 180. | schema:longitude doit être un seul nombre décimal compris entre -180 et 180. | schema:longitude muss eine einzelne Dezimalzahl zwischen -180 und 180 sein. | schema:longitude deve essere un unico numero decimale compreso tra -180 e 180. | schema:longitude debe ser un único número decimal entre -180 y 180. | schema:longitude tem de ser um único número decimal entre -180 e 180. | A schema:longitude értéke egyetlen tizedes szám kell legyen -180 és 180 között. | Το schema:longitude πρέπει να είναι ένας δεκαδικός αριθμός μεταξύ -180 και 180. | schema:longitude moet één decimaal getal tussen -180 en 180 zijn." ] .

mbrsh:OccupancyShape a sh:NodeShape ;
    sh:targetClass mbr:Occupancy ;
    sh:property [ sh:path mbr:occupant ; sh:minCount 1 ; sh:maxCount 1 ; sh:class org:Organization ] ,
                [ sh:path mbr:occupiedPremises ; sh:minCount 1 ; sh:maxCount 1 ; sh:class org:Site ] .

# xsd:nonNegativeInteger, as in the OWL range. A plain Turtle 42 is an xsd:integer with
# the same value, which the OWL range also admits, so it passes when it is zero or more.
mbrsh:CountList
    sh:or ( [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:integer ; sh:minInclusive 0 ] ) .

mbrsh:MemberCountShape a sh:NodeShape ;
    sh:targetClass mbr:MemberCount ;
    sh:property [ sh:path mbr:count ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:node mbrsh:CountList ;
                  sh:message "mbr:count must be one non-negative integer (xsd:nonNegativeInteger, or xsd:integer of zero or more). | mbr:count ska vara ett enda icke-negativt heltal (xsd:nonNegativeInteger, eller xsd:integer som är noll eller större). | mbr:count doit être un seul entier non négatif (xsd:nonNegativeInteger, ou xsd:integer égal ou supérieur à zéro). | mbr:count muss eine einzelne nichtnegative ganze Zahl sein (xsd:nonNegativeInteger oder xsd:integer von null oder mehr). | mbr:count deve essere un unico numero intero non negativo (xsd:nonNegativeInteger, o xsd:integer pari o superiore a zero). | mbr:count debe ser un único entero no negativo (xsd:nonNegativeInteger, o xsd:integer igual o mayor que cero). | mbr:count tem de ser um único inteiro não negativo (xsd:nonNegativeInteger, ou xsd:integer igual ou superior a zero). | Az mbr:count értéke egyetlen nemnegatív egész szám kell legyen (xsd:nonNegativeInteger, vagy nullánál nem kisebb xsd:integer). | Το mbr:count πρέπει να είναι ένας μη αρνητικός ακέραιος (xsd:nonNegativeInteger, ή xsd:integer μηδέν ή μεγαλύτερο). | mbr:count moet één niet-negatief geheel getal zijn (xsd:nonNegativeInteger, of xsd:integer van nul of meer)." ] ,
                [ sh:path mbr:asOf ; sh:minCount 1 ;
                  sh:message "A member count needs the date it refers to (mbr:asOf). | Ett medlemsantal behöver det datum det avser (mbr:asOf). | Un effectif a besoin de la date à laquelle il se rapporte (mbr:asOf). | Eine Mitgliederzahl braucht das Datum, auf das sie sich bezieht (mbr:asOf). | Un numero di soci richiede la data a cui si riferisce (mbr:asOf). | Un recuento de miembros necesita la fecha a la que se refiere (mbr:asOf). | Uma contagem de membros precisa da data a que se refere (mbr:asOf). | A taglétszámnak szüksége van arra a dátumra, amelyre vonatkozik (mbr:asOf). | Ένας αριθμός μελών χρειάζεται την ημερομηνία στην οποία αναφέρεται (mbr:asOf). | Een ledental heeft de datum nodig waarop het betrekking heeft (mbr:asOf)." ] .

mbrsh:ConceptShape a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:uniqueLang true ;
                  sh:severity sh:Warning ] .
