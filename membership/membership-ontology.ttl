##############################################################################
# membership — Membership Organisations Ontology  —  v1.1.0
#
# Generic layer for membership organisations of every kind, closed or open:
# private clubs (gentlemen's and ladies' clubs, dining clubs), societies and
# student nations, hobby and supporters' clubs, associations, political parties
# and trade unions — and, via the fraternal layer, fraternal orders and
# sororities. It also describes organisations as catalogue entries: founding
# and closure, status, ownership model, admission and fees, where their premises
# are (postal address, coordinates) and how that changed over time, contact
# details and membership size.
#
# Design:
#   * Built on W3C ORG. Anything with a time span or a role is a qualified node
#     (Membership, Tenure, Occupancy, Conferral, Participation), not a direct link.
#   * Addresses, coordinates, contact details and fee amounts reuse schema.org
#     (schema:PostalAddress, schema:GeoCoordinates, schema:url/email/telephone,
#     schema:price/priceCurrency), the vocabulary directory sites and search
#     engines already read.
#   * Anything that is "a value from a list" is a SKOS concept (membership-codes.ttl).
#   * Constraints live in SHACL (membership-shapes.ttl); OWL domains/ranges are only
#     stated where they hold for every use.
#   * Dates accept xsd:date, xsd:gYearMonth or xsd:gYear (checked in SHACL),
#     because historical registers often record only a year.
##############################################################################

@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix schema:  <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org:     <http://www.w3.org/ns/org#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix mbr:    <https://w3id.org/membership#> .
@prefix mbrc:   <https://w3id.org/membership/code/> .

<https://w3id.org/membership>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/membership/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    owl:priorVersion <https://w3id.org/membership/1.0.0> ;
    owl:backwardCompatibleWith <https://w3id.org/membership/1.0.0> ;
    owl:imports <https://w3id.org/membership/external> ;
    dcterms:title "Membership Organisations Ontology"@en ,
                  "Ontologi för medlemsorganisationer"@sv ,
                  "Ontologie des organisations de membres"@fr ,
                  "Ontologie der Mitgliederorganisationen"@de ,
                  "Ontologia delle organizzazioni associative"@it ,
                  "Ontología de organizaciones de miembros"@es ,
                  "Ontologia de organizações de membros"@pt ,
                  "Tagsági szervezetek ontológiája"@hu ;
    dcterms:description "Generic ontology for membership organisations of every kind, closed or open — from private clubs, societies, student nations and (through the fraternal extension) fraternal orders to hobby and supporters' clubs, associations, political parties and trade unions: memberships and their lifecycle, admission and fees, offices and terms of office, gatherings and participation, distinctions and their conferral, premises and reciprocity between organisations."@en ,
                        "Generisk ontologi för medlemsorganisationer av alla slag, med slutet eller öppet medlemskap — från privata klubbar, sällskap, studentnationer och (via tillägget fraternal) ordenssällskap till hobby- och supporterklubbar, föreningar, politiska partier och fackföreningar: medlemskap och dess livscykel, upptagning och avgifter, ämbeten och ämbetsperioder, sammankomster och deltagande, utmärkelser och deras tilldelning, lokaler och ömsesidighet mellan organisationer."@sv ,
                        "Ontologie générique des organisations de membres de toute sorte, à adhésion fermée ou ouverte — des clubs privés, sociétés, nations étudiantes et (par l'extension fraternal) ordres fraternels aux clubs de loisirs et de supporters, associations, partis politiques et syndicats : les adhésions et leur cycle de vie, l'admission et les cotisations, les fonctions et leurs mandats, les réunions et la participation, les distinctions et leur attribution, les locaux et la réciprocité entre organisations."@fr ,
                        "Allgemeine Ontologie für Mitgliederorganisationen jeder Art, mit geschlossener oder offener Mitgliedschaft – von privaten Clubs, Gesellschaften, Studentennationen und (über die Erweiterung fraternal) Ordensgemeinschaften bis zu Hobby- und Fanclubs, Vereinen, politischen Parteien und Gewerkschaften: Mitgliedschaften und ihr Lebenszyklus, Aufnahme und Beiträge, Ämter und Amtszeiten, Zusammenkünfte und Teilnahme, Auszeichnungen und ihre Verleihung, Räumlichkeiten und Gegenseitigkeit zwischen Organisationen."@de ,
                        "Ontologia generica per organizzazioni associative di ogni genere, chiuse o aperte: dai circoli privati, dalle società, dalle nazioni studentesche e (attraverso l'estensione fraternale) dagli ordini fraternali ai club di appassionati e di tifosi, alle associazioni, ai partiti politici e ai sindacati. Descrive le appartenenze e il loro ciclo di vita, l'ammissione e le quote, le cariche e i mandati, gli incontri e la partecipazione, i riconoscimenti e il loro conferimento, i locali e la reciprocità tra organizzazioni."@it ,
                        "Ontología genérica para organizaciones de miembros de todo tipo, cerradas o abiertas —desde clubes privados, sociedades, naciones estudiantiles y (mediante la extensión fraternal) órdenes fraternales hasta clubes de aficionados y de seguidores, asociaciones, partidos políticos y sindicatos—: pertenencias y su ciclo de vida, admisión y cuotas, cargos y mandatos, reuniones y participación, distinciones y su concesión, locales y reciprocidad entre organizaciones."@es ,
                        "Ontologia genérica para organizações de membros de todos os tipos, fechadas ou abertas — desde clubes privados, sociedades, nações estudantis e (através da extensão fraternal) ordens fraternais até clubes de aficionados e de adeptos, associações, partidos políticos e sindicatos: filiações e o seu ciclo de vida, admissão e quotas, cargos e mandatos, reuniões e participação, distinções e a sua atribuição, instalações e reciprocidade entre organizações."@pt ,
                        "Általános ontológia mindenfajta tagsági szervezethez, zárthoz és nyílthoz — a zártkörű klubokon, társaságokon, diáknemzeteken és (a fraternal kiterjesztésen keresztül) testvéri rendeken át a hobbi- és szurkolóklubokig, egyesületekig, politikai pártokig és szakszervezetekig: a tagságok és életciklusuk, a felvétel és a tagdíjak, a tisztségek és megbízatások, az összejövetelek és a részvétel, a kitüntetések és adományozásuk, a helyiségek és a szervezetek közötti viszonosság."@hu ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:issued "2026-10-09"^^xsd:date ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    vann:preferredNamespacePrefix "mbr" ;
    vann:preferredNamespaceUri "https://w3id.org/membership#" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator <https://orcid.org/0009-0002-6239-5346> ;
    dcterms:rightsHolder <https://orcid.org/0009-0002-6239-5346> ;
    dcterms:publisher <https://github.com/society-ontologies> ;
    bibo:status <http://purl.org/ontology/bibo/status/published> ;
    dcterms:source <https://github.com/society-ontologies/membership-fraternal> ;
    dcterms:bibliographicCitation "Almgren, O. (2026). Membership Organisations Ontology. https://w3id.org/membership" ;
    dcterms:identifier <https://doi.org/10.5281/zenodo.23080656> ;
    schema:includedInDataCatalog <https://lov.linkeddata.es/dataset/lov> .

<https://orcid.org/0009-0002-6239-5346> foaf:name "Oscar Almgren" .

<https://github.com/society-ontologies> a foaf:Organization ;
    foaf:name "Society Ontologies" .

##############################################################################
# ORGANISATIONS
##############################################################################

mbr:MembershipOrganization a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subClassOf org:FormalOrganization ;
    rdfs:label "Membership Organisation"@en , "Medlemsorganisation"@sv , "Organisation de membres"@fr , "Mitgliederorganisation"@de , "Organizzazione associativa"@it , "Organización de miembros"@es , "Organização de membros"@pt , "Tagsági szervezet"@hu ;
    skos:definition "An organisation whose participants are admitted as members and which exists for those members as a body: they share its purpose, premises or activities, and usually govern it themselves. Some clubs are instead owned by a proprietor or an institution (see mbr:ownershipModel). The kind of organisation is given with org:classification (see mbrc:OrganizationTypes). Its legal form is given with rov:orgType (see mbrc:LegalForms)."@en ,
                    "En organisation vars deltagare upptas som medlemmar och som finns till för medlemmarna som grupp: de delar dess syfte, lokaler eller verksamhet och styr den vanligen själva. Vissa klubbar ägs i stället av en ägare eller en institution (se mbr:ownershipModel). Organisationstypen anges med org:classification (se mbrc:OrganizationTypes). Dess associationsform anges med rov:orgType (se mbrc:LegalForms)."@sv ,
                    "Organisation dont les participants sont admis comme membres et qui existe pour eux en tant que corps : ils partagent son but, ses locaux ou ses activités, et la dirigent en général eux-mêmes. Certains clubs appartiennent plutôt à un propriétaire ou à une institution (voir mbr:ownershipModel). Le genre d'organisation est indiqué avec org:classification (voir mbrc:OrganizationTypes). Sa forme juridique est indiquée avec rov:orgType (voir mbrc:LegalForms)."@fr ,
                    "Eine Organisation, deren Teilnehmer als Mitglieder aufgenommen werden und die für diese Mitglieder als Gemeinschaft besteht: Sie teilen ihren Zweck, ihre Räumlichkeiten oder ihre Tätigkeiten und verwalten sie in der Regel selbst. Manche Clubs gehören stattdessen einem Eigentümer oder einer Institution (siehe mbr:ownershipModel). Die Art der Organisation wird mit org:classification angegeben (siehe mbrc:OrganizationTypes). Ihre Rechtsform wird mit rov:orgType angegeben (siehe mbrc:LegalForms)."@de ,
                    "Un'organizzazione i cui partecipanti sono ammessi come soci e che esiste per loro come corpo: ne condividono lo scopo, i locali o le attività e di solito la governano essi stessi. Alcuni club appartengono invece a un proprietario o a un'istituzione (vedi mbr:ownershipModel). Il tipo di organizzazione si indica con org:classification (vedi mbrc:OrganizationTypes). La sua forma giuridica si indica con rov:orgType (vedi mbrc:LegalForms)."@it ,
                    "Una organización cuyos participantes son admitidos como miembros y que existe para esos miembros como cuerpo: comparten su finalidad, sus locales o sus actividades, y por lo general la gobiernan ellos mismos. Algunos clubes pertenecen, en cambio, a un propietario o a una institución (véase mbr:ownershipModel). El tipo de organización se indica con org:classification (véase mbrc:OrganizationTypes). Su forma jurídica se indica con rov:orgType (véase mbrc:LegalForms)."@es ,
                    "Uma organização cujos participantes são admitidos como membros e que existe para esses membros como corpo: partilham o seu objetivo, as suas instalações ou as suas atividades e, em regra, governam-na eles próprios. Alguns clubes pertencem, em vez disso, a um proprietário ou a uma instituição (ver mbr:ownershipModel). O tipo de organização indica-se com org:classification (ver mbrc:OrganizationTypes). A sua forma jurídica indica-se com rov:orgType (ver mbrc:LegalForms)."@pt ,
                    "Olyan szervezet, amelynek résztvevőit tagként veszik fel, és amely e tagok számára, testületként létezik: közös a céljuk, a helyiségeik vagy a tevékenységeik, és rendszerint maguk irányítják. Egyes klubok ehelyett egy tulajdonosé vagy egy intézményé (lásd mbr:ownershipModel). A szervezet fajtáját az org:classification adja meg (lásd mbrc:OrganizationTypes). Jogi formáját a rov:orgType adja meg (lásd mbrc:LegalForms)."@hu ;
    skos:scopeNote "Covers organisations with closed membership, such as private clubs and order societies, and open ones, such as hobby and supporters' clubs, associations, political parties and trade unions (see mbr:admissionMode). Not covered: customer loyalty schemes and commercial subscriptions such as most gym memberships, where membership means no more than buying the service. Nor is compulsory membership, as in professional chambers and the professional bodies that French calls an ordre (ordre des médecins), or membership that gives an economic benefit, as in mutual insurers and cooperatives whose members are their customers."@en ,
                   "Omfattar organisationer med slutet medlemskap, som privata klubbar och ordenssällskap, och med öppet, som hobby- och supporterklubbar, föreningar, politiska partier och fackföreningar (se mbr:admissionMode). Omfattas inte: kundklubbar och kommersiella abonnemang som de flesta gymkort, där medlemskapet inte är mer än köpet av tjänsten. Inte heller obligatoriskt medlemskap, som i yrkeskammare och de yrkesorgan som på franska kallas ordre (ordre des médecins), eller medlemskap som ger ekonomisk nytta, som i ömsesidiga försäkringsbolag och kooperativ vars medlemmar är kunderna."@sv ,
                   "Couvre les organisations à adhésion fermée, comme les clubs privés et les sociétés d'ordre, et à adhésion ouverte, comme les clubs de loisirs et de supporters, les associations, les partis politiques et les syndicats (voir mbr:admissionMode). Non couverts : les programmes de fidélité et les abonnements commerciaux, comme la plupart des cartes de salle de sport, où l'adhésion n'est rien de plus que l'achat du service. Ne le sont pas non plus l'adhésion obligatoire, comme dans les chambres professionnelles et les organismes professionnels que le français appelle un ordre (ordre des médecins), ni l'adhésion qui procure un avantage économique, comme dans les mutuelles d'assurance et les coopératives dont les membres sont les clients."@fr ,
                   "Umfasst Organisationen mit geschlossener Mitgliedschaft, etwa private Clubs und Ordensgesellschaften, und mit offener Mitgliedschaft, etwa Hobby- und Fanclubs, Vereine, politische Parteien und Gewerkschaften (siehe mbr:admissionMode). Nicht umfasst: Kundenbindungsprogramme und kommerzielle Abonnements wie die meisten Fitnessstudio-Mitgliedschaften, bei denen die Mitgliedschaft nicht mehr bedeutet als den Kauf der Dienstleistung. Ebenso wenig die Pflichtmitgliedschaft, etwa in Berufskammern und den Berufsorganen, die das Französische ordre nennt (ordre des médecins), oder eine Mitgliedschaft, die einen wirtschaftlichen Vorteil gewährt, etwa in Versicherungsvereinen auf Gegenseitigkeit und Genossenschaften, deren Mitglieder ihre Kunden sind."@de ,
                   "Comprende organizzazioni ad ammissione chiusa, come i circoli privati e le società d'ordine, e ad ammissione aperta, come i club di appassionati e di tifosi, le associazioni, i partiti politici e i sindacati (vedi mbr:admissionMode). Restano fuori i programmi di fidelizzazione dei clienti e gli abbonamenti commerciali, come la maggior parte delle iscrizioni a una palestra, dove l'iscrizione non è altro che l'acquisto del servizio. Restano fuori anche l'appartenenza obbligatoria, come nelle camere professionali e negli enti professionali che il francese chiama ordre (ordre des médecins), e l'appartenenza che dà un vantaggio economico, come nelle mutue assicuratrici e nelle cooperative i cui soci sono clienti."@it ,
                   "Abarca organizaciones de pertenencia cerrada, como los clubes privados y las sociedades de orden, y de pertenencia abierta, como los clubes de aficionados y de seguidores, las asociaciones, los partidos políticos y los sindicatos (véase mbr:admissionMode). No abarca los programas de fidelización de clientes ni las suscripciones comerciales, como la mayoría de las matrículas de gimnasio, en las que ser miembro no es más que comprar el servicio. Tampoco la pertenencia obligatoria, como en las cámaras profesionales y en los organismos profesionales que el francés llama ordre (ordre des médecins), ni la pertenencia que da un beneficio económico, como en las mutuas de seguros y las cooperativas cuyos miembros son sus clientes."@es ,
                   "Abrange organizações de filiação fechada, como os clubes privados e as sociedades de ordem, e de filiação aberta, como os clubes de aficionados e de adeptos, as associações, os partidos políticos e os sindicatos (ver mbr:admissionMode). Não abrange os programas de fidelização de clientes nem as subscrições comerciais, como a maioria das inscrições em ginásios, em que ser membro não é mais do que comprar o serviço. Nem a filiação obrigatória, como nas câmaras profissionais e nos organismos profissionais que o francês chama ordre (ordre des médecins), nem a filiação que dá um benefício económico, como nas mútuas de seguros e nas cooperativas cujos membros são os clientes."@pt ,
                   "Magában foglalja a zárt tagságú szervezeteket, mint a zártkörű klubok és a rendtársaságok, és a nyílt tagságúakat, mint a hobbi- és szurkolóklubok, az egyesületek, a politikai pártok és a szakszervezetek (lásd mbr:admissionMode). Nem tartoznak ide az ügyfélhűségi programok és a kereskedelmi előfizetések, például a legtöbb konditermi bérlet, ahol a tagság nem több a szolgáltatás megvásárlásánál. Ugyanígy a kötelező tagság, mint a szakmai kamaráknál és azoknál a szakmai testületeknél, amelyeket a francia ordre-nak nevez (ordre des médecins), valamint a gazdasági előnyt nyújtó tagság, mint a biztosító egyesületeknél és a szövetkezeteknél, amelyek tagjai egyben az ügyfelek."@hu .

mbr:Branch a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subClassOf org:OrganizationalUnit ;
    rdfs:label "Branch"@en , "Avdelning"@sv , "Section"@fr , "Zweigstelle"@de , "Sezione"@it , "Sección"@es , "Secção"@pt , "Tagozat"@hu ;
    skos:definition "A local or regional section of a membership organisation, linked to it with org:unitOf."@en ,
                    "En lokal eller regional avdelning av en medlemsorganisation, kopplad till den med org:unitOf."@sv ,
                    "Section locale ou régionale d'une organisation de membres, rattachée à elle par org:unitOf."@fr ,
                    "Eine örtliche oder regionale Gliederung einer Mitgliederorganisation, die mit org:unitOf mit ihr verknüpft ist."@de ,
                    "Una sezione locale o regionale di un'organizzazione associativa, collegata ad essa con org:unitOf."@it ,
                    "Una sección local o regional de una organización de miembros, vinculada a ella con org:unitOf."@es ,
                    "Uma secção local ou regional de uma organização de membros, ligada a ela com org:unitOf."@pt ,
                    "Egy tagsági szervezet helyi vagy területi egysége, az org:unitOf segítségével kapcsolva hozzá."@hu .

mbr:Premises a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subClassOf org:Site ;
    rdfs:label "Premises"@en , "Lokal"@sv , "Locaux"@fr , "Räumlichkeiten"@de , "Locali"@it , "Local"@es , "Instalações"@pt , "Helyiségek"@hu ;
    skos:definition "A clubhouse, lodge building or other premises used by a membership organisation. org:hasSite links an organisation to its current premises; mbr:Occupancy records which premises it used when. Give the location with schema:address (a schema:PostalAddress), schema:geo (a schema:GeoCoordinates) and schema:containedInPlace (the city, as a Wikidata IRI). If the building's address changed while the building stayed the same (a street renamed or renumbered), give each address with its own mbr:startDate and mbr:endDate; the current address is the one without an end date."@en ,
                    "Ett klubbhus, en ordenslokal eller annan lokal som används av en medlemsorganisation. org:hasSite kopplar en organisation till dess nuvarande lokal; mbr:Occupancy anger vilka lokaler den använt och när. Platsen anges med schema:address (en schema:PostalAddress), schema:geo (en schema:GeoCoordinates) och schema:containedInPlace (orten, som Wikidata-IRI). Om byggnadens adress ändrats medan byggnaden är densamma (en gata som bytt namn eller numrering), anges varje adress med egna mbr:startDate och mbr:endDate; den nuvarande adressen är den utan slutdatum."@sv ,
                    "Siège de club, bâtiment de loge ou autres locaux utilisés par une organisation de membres. org:hasSite relie une organisation à ses locaux actuels ; mbr:Occupancy consigne quels locaux elle a utilisés et quand. Indiquer le lieu avec schema:address (un schema:PostalAddress), schema:geo (un schema:GeoCoordinates) et schema:containedInPlace (la ville, comme IRI Wikidata). Si l'adresse du bâtiment a changé alors que le bâtiment est resté le même (rue rebaptisée ou renumérotée), indiquer chaque adresse avec ses propres mbr:startDate et mbr:endDate ; l'adresse actuelle est celle sans date de fin."@fr ,
                    "Ein Vereinshaus, Logenhaus oder andere Räumlichkeiten, die eine Mitgliederorganisation nutzt. Mit org:hasSite wird eine Organisation mit ihren aktuellen Räumlichkeiten verknüpft; mbr:Occupancy hält fest, welche Räumlichkeiten sie wann nutzte. Der Ort wird mit schema:address (ein schema:PostalAddress), schema:geo (ein schema:GeoCoordinates) und schema:containedInPlace (die Stadt, als Wikidata-IRI) angegeben. Hat sich die Adresse eines Gebäudes geändert, während das Gebäude dasselbe blieb (eine Straße wurde umbenannt oder neu nummeriert), wird jede Adresse mit eigenem mbr:startDate und mbr:endDate angegeben; die aktuelle Adresse ist die ohne Enddatum."@de ,
                    "Una sede sociale, un edificio di loggia o altri locali usati da un'organizzazione associativa. org:hasSite collega un'organizzazione ai suoi locali attuali; mbr:Occupancy registra quali locali ha usato e quando. L'ubicazione si indica con schema:address (uno schema:PostalAddress), schema:geo (uno schema:GeoCoordinates) e schema:containedInPlace (la città, come IRI di Wikidata). Se l'indirizzo dell'edificio è cambiato mentre l'edificio è rimasto lo stesso (una via ribattezzata o rinumerata), si indica ogni indirizzo con il proprio mbr:startDate e mbr:endDate; l'indirizzo attuale è quello senza data di fine."@it ,
                    "Una sede social, un edificio de logia u otros locales que usa una organización de miembros. org:hasSite vincula una organización con su local actual; mbr:Occupancy registra qué locales usó y cuándo. La ubicación se da con schema:address (un schema:PostalAddress), schema:geo (un schema:GeoCoordinates) y schema:containedInPlace (la ciudad, como IRI de Wikidata). Si la dirección del edificio cambió mientras el edificio seguía siendo el mismo (una calle rebautizada o renumerada), se da cada dirección con su propio mbr:startDate y mbr:endDate; la dirección actual es la que no tiene fecha de fin."@es ,
                    "Uma sede social, um edifício de loja ou outras instalações usadas por uma organização de membros. org:hasSite liga uma organização às suas instalações atuais; mbr:Occupancy regista que instalações usou e quando. A localização indica-se com schema:address (um schema:PostalAddress), schema:geo (um schema:GeoCoordinates) e schema:containedInPlace (a cidade, como IRI da Wikidata). Se a morada do edifício mudou enquanto o edifício continuou o mesmo (uma rua rebatizada ou renumerada), indica-se cada morada com o seu próprio mbr:startDate e mbr:endDate; a morada atual é a que não tem data de fim."@pt ,
                    "Egy klubház, páholyépület vagy más helyiségek, amelyeket egy tagsági szervezet használ. Az org:hasSite egy szervezetet a jelenlegi helyiségeihez kapcsol; az mbr:Occupancy rögzíti, mely helyiségeket mikor használta. A helyet a schema:address (egy schema:PostalAddress), a schema:geo (egy schema:GeoCoordinates) és a schema:containedInPlace (a város, Wikidata IRI-ként) adja meg. Ha az épület címe megváltozott, miközben az épület ugyanaz maradt (átnevezett vagy átszámozott utca), minden címet a saját mbr:startDate és mbr:endDate értékével kell megadni; a jelenlegi cím az, amelynek nincs záró dátuma."@hu .

mbr:Occupancy a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "Occupancy"@en , "Lokalinnehav"@sv , "Occupation de locaux"@fr , "Raumnutzung"@de , "Occupazione"@it , "Ocupación"@es , "Ocupação"@pt , "Használat"@hu ;
    skos:definition "The period during which an organisation (mbr:occupant) used a set of premises (mbr:occupiedPremises), with mbr:startDate and mbr:endDate. Records a club's moves between clubhouses."@en ,
                    "Den period under vilken en organisation (mbr:occupant) använde en lokal (mbr:occupiedPremises), med mbr:startDate och mbr:endDate. Beskriver t.ex. en klubbs flyttar mellan klubbhus."@sv ,
                    "La période pendant laquelle une organisation (mbr:occupant) a utilisé des locaux (mbr:occupiedPremises), avec mbr:startDate et mbr:endDate. Consigne les déménagements d'un club."@fr ,
                    "Der Zeitraum, in dem eine Organisation (mbr:occupant) bestimmte Räumlichkeiten (mbr:occupiedPremises) nutzte, mit mbr:startDate und mbr:endDate. Hält die Umzüge eines Clubs zwischen Vereinshäusern fest."@de ,
                    "Il periodo in cui un'organizzazione (mbr:occupant) ha usato un insieme di locali (mbr:occupiedPremises), con mbr:startDate e mbr:endDate. Registra i trasferimenti di un club da una sede all'altra."@it ,
                    "El período durante el cual una organización (mbr:occupant) usó unos locales (mbr:occupiedPremises), con mbr:startDate y mbr:endDate. Registra los traslados de un club entre sedes."@es ,
                    "O período durante o qual uma organização (mbr:occupant) usou umas instalações (mbr:occupiedPremises), com mbr:startDate e mbr:endDate. Regista as mudanças de um clube entre sedes."@pt ,
                    "Az az időszak, amely alatt egy szervezet (mbr:occupant) helyiségeket (mbr:occupiedPremises) használt, az mbr:startDate és mbr:endDate értékével. Egy klub klubházak közötti költözéseit rögzíti."@hu .

mbr:occupant a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "occupant"@en , "innehavare"@sv , "occupant"@fr , "Nutzer"@de , "occupante"@it , "ocupante"@es , "ocupante"@pt , "használó"@hu ;
    skos:definition "The organisation that used the premises during an occupancy."@en ,
                    "Den organisation som använde lokalen under lokalinnehavet."@sv ,
                    "L'organisation qui a utilisé les locaux pendant une occupation."@fr ,
                    "Die Organisation, die die Räumlichkeiten während einer Raumnutzung nutzte."@de ,
                    "L'organizzazione che ha usato i locali durante un'occupazione."@it ,
                    "La organización que usó los locales durante una ocupación."@es ,
                    "A organização que usou as instalações durante uma ocupação."@pt ,
                    "A szervezet, amely a helyiségeket egy használat során használta."@hu ;
    rdfs:domain mbr:Occupancy ;
    rdfs:range org:Organization .

mbr:occupiedPremises a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "occupied premises"@en , "använd lokal"@sv , "locaux occupés"@fr , "genutzte Räumlichkeiten"@de , "locali occupati"@it , "locales ocupados"@es , "instalações ocupadas"@pt , "használt helyiségek"@hu ;
    skos:definition "The premises an organisation used during an occupancy."@en ,
                    "Den lokal som en organisation använde under lokalinnehavet."@sv ,
                    "Les locaux qu'une organisation a utilisés pendant une occupation."@fr ,
                    "Die Räumlichkeiten, die eine Organisation während einer Raumnutzung nutzte."@de ,
                    "I locali che un'organizzazione ha usato durante un'occupazione."@it ,
                    "Los locales que una organización usó durante una ocupación."@es ,
                    "As instalações que uma organização usou durante uma ocupação."@pt ,
                    "A helyiségek, amelyeket egy szervezet egy használat során használt."@hu ;
    rdfs:domain mbr:Occupancy ;
    rdfs:range org:Site .

mbr:MemberCount a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "Member Count"@en , "Medlemsantal"@sv , "Effectif"@fr , "Mitgliederzahl"@de , "Numero di soci"@it , "Recuento de miembros"@es , "Contagem de membros"@pt , "Taglétszám"@hu ;
    skos:definition "The number of members an organisation had at a given date (mbr:count, mbr:asOf). Linked from the organisation with mbr:hasMemberCount; several counts over time are allowed."@en ,
                    "Antalet medlemmar en organisation hade vid ett visst datum (mbr:count, mbr:asOf). Kopplas från organisationen med mbr:hasMemberCount; flera värden över tid är tillåtna."@sv ,
                    "Le nombre de membres d'une organisation à une date donnée (mbr:count, mbr:asOf). Relié à l'organisation par mbr:hasMemberCount ; plusieurs effectifs dans le temps sont permis."@fr ,
                    "Die Zahl der Mitglieder, die eine Organisation zu einem bestimmten Datum hatte (mbr:count, mbr:asOf). Von der Organisation aus mit mbr:hasMemberCount verknüpft; mehrere Zahlen im Zeitverlauf sind zulässig."@de ,
                    "Il numero di soci che un'organizzazione aveva a una data determinata (mbr:count, mbr:asOf). Collegato all'organizzazione con mbr:hasMemberCount; sono ammessi più conteggi nel tempo."@it ,
                    "El número de miembros que tenía una organización en una fecha dada (mbr:count, mbr:asOf). Se vincula desde la organización con mbr:hasMemberCount; se admiten varios recuentos a lo largo del tiempo."@es ,
                    "O número de membros que uma organização tinha numa data dada (mbr:count, mbr:asOf). Liga-se a partir da organização com mbr:hasMemberCount; admitem-se várias contagens ao longo do tempo."@pt ,
                    "A tagok száma, amellyel egy szervezet egy adott napon rendelkezett (mbr:count, mbr:asOf). A szervezetből az mbr:hasMemberCount kapcsolja; az idők során több létszám is megengedett."@hu .

mbr:hasMemberCount a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "has member count"@en , "har medlemsantal"@sv , "a pour effectif"@fr , "hat Mitgliederzahl"@de , "ha numero di soci"@it , "tiene recuento de miembros"@es , "tem contagem de membros"@pt , "taglétszáma van"@hu ;
    skos:definition "Links an organisation to a member count (mbr:MemberCount) recorded at a given date. An organisation may have several, one for each date."@en ,
                    "Kopplar en organisation till ett medlemsantal (mbr:MemberCount) som registrerats vid ett visst datum. En organisation kan ha flera, ett för varje datum."@sv ,
                    "Relie une organisation à un effectif (mbr:MemberCount) relevé à une date donnée. Une organisation peut en avoir plusieurs, un par date."@fr ,
                    "Verknüpft eine Organisation mit einer zu einem bestimmten Datum festgehaltenen Mitgliederzahl (mbr:MemberCount). Eine Organisation kann mehrere haben, eine für jedes Datum."@de ,
                    "Collega un'organizzazione a un numero di soci (mbr:MemberCount) registrato a una data determinata. Un'organizzazione può averne diversi, uno per ogni data."@it ,
                    "Vincula una organización con un recuento de miembros (mbr:MemberCount) registrado en una fecha dada. Una organización puede tener varios, uno por fecha."@es ,
                    "Liga uma organização a uma contagem de membros (mbr:MemberCount) registada numa data dada. Uma organização pode ter várias, uma por data."@pt ,
                    "Egy szervezetet egy adott napon rögzített taglétszámmal (mbr:MemberCount) kapcsol össze. Egy szervezetnek több is lehet, napokként egy."@hu ;
    rdfs:range mbr:MemberCount .

mbr:count a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "count"@en , "antal"@sv , "nombre"@fr , "Anzahl"@de , "numero"@it , "número"@es , "número"@pt , "szám"@hu ;
    skos:definition "The number of members recorded in a member count, as a non-negative integer."@en ,
                    "Det antal medlemmar som anges i ett medlemsantal, som ett icke-negativt heltal."@sv ,
                    "Le nombre de membres consigné dans un effectif, sous forme d'entier non négatif."@fr ,
                    "Die in einer Mitgliederzahl festgehaltene Zahl der Mitglieder, als nichtnegative ganze Zahl."@de ,
                    "Il numero di soci registrato in un conteggio dei soci, come intero non negativo."@it ,
                    "El número de miembros registrado en un recuento de miembros, como entero no negativo."@es ,
                    "O número de membros registado numa contagem de membros, como inteiro não negativo."@pt ,
                    "A taglétszámban rögzített tagok száma, nemnegatív egész számként."@hu ;
    rdfs:domain mbr:MemberCount ;
    rdfs:range xsd:nonNegativeInteger .

mbr:asOf a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "as of"@en , "per datum"@sv , "à la date du"@fr , "Stand"@de , "alla data"@it , "a fecha de"@es , "à data de"@pt , "időpontja"@hu ;
    skos:definition "The date a figure refers to. Value is xsd:date, xsd:gYearMonth or xsd:gYear."@en ,
                    "Det datum en uppgift avser. Värdet är xsd:date, xsd:gYearMonth eller xsd:gYear."@sv ,
                    "La date à laquelle se rapporte un chiffre. La valeur est de type xsd:date, xsd:gYearMonth ou xsd:gYear."@fr ,
                    "Das Datum, auf das sich eine Angabe bezieht. Der Wert ist xsd:date, xsd:gYearMonth oder xsd:gYear."@de ,
                    "La data a cui si riferisce una cifra. Il valore è xsd:date, xsd:gYearMonth o xsd:gYear."@it ,
                    "La fecha a la que se refiere una cifra. El valor es xsd:date, xsd:gYearMonth o xsd:gYear."@es ,
                    "A data a que se refere um valor. O valor é xsd:date, xsd:gYearMonth ou xsd:gYear."@pt ,
                    "A nap, amelyre egy adat vonatkozik. Az érték xsd:date, xsd:gYearMonth vagy xsd:gYear."@hu .

##############################################################################
# ORGANISATION LIFECYCLE AND CATALOGUE FACTS
##############################################################################

mbr:foundingDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subPropertyOf schema:foundingDate ;
    rdfs:label "founding date"@en , "grundningsdatum"@sv , "date de fondation"@fr , "Gründungsdatum"@de , "data di fondazione"@it , "fecha de fundación"@es , "data de fundação"@pt , "alapítás dátuma"@hu ;
    skos:definition "When the organisation was founded. Value is xsd:date, xsd:gYearMonth or xsd:gYear."@en ,
                    "När organisationen grundades. Värdet är xsd:date, xsd:gYearMonth eller xsd:gYear."@sv ,
                    "Quand l'organisation a été fondée. La valeur est de type xsd:date, xsd:gYearMonth ou xsd:gYear."@fr ,
                    "Wann die Organisation gegründet wurde. Der Wert ist xsd:date, xsd:gYearMonth oder xsd:gYear."@de ,
                    "Quando l'organizzazione è stata fondata. Il valore è xsd:date, xsd:gYearMonth o xsd:gYear."@it ,
                    "Cuándo se fundó la organización. El valor es xsd:date, xsd:gYearMonth o xsd:gYear."@es ,
                    "Quando foi fundada a organização. O valor é xsd:date, xsd:gYearMonth ou xsd:gYear."@pt ,
                    "Mikor alapították a szervezetet. Az érték xsd:date, xsd:gYearMonth vagy xsd:gYear."@hu .

mbr:dissolutionDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subPropertyOf schema:dissolutionDate ;
    rdfs:label "dissolution date"@en , "upplösningsdatum"@sv , "date de dissolution"@fr , "Auflösungsdatum"@de , "data di scioglimento"@it , "fecha de disolución"@es , "data de dissolução"@pt , "megszűnés dátuma"@hu ;
    skos:definition "When the organisation closed or ceased to exist as itself (including by merger). Value is xsd:date, xsd:gYearMonth or xsd:gYear. Record a merger itself as an org:ChangeEvent."@en ,
                    "När organisationen upphörde eller slutade finnas som sig själv (även genom sammanslagning). Värdet är xsd:date, xsd:gYearMonth eller xsd:gYear. Själva sammanslagningen registreras som en org:ChangeEvent."@sv ,
                    "Quand l'organisation a fermé ou a cessé d'exister en tant que telle (y compris par fusion). La valeur est de type xsd:date, xsd:gYearMonth ou xsd:gYear. Consigner la fusion elle-même comme une org:ChangeEvent."@fr ,
                    "Wann die Organisation aufgelöst wurde oder als sie selbst zu bestehen aufhörte (auch durch Fusion). Der Wert ist xsd:date, xsd:gYearMonth oder xsd:gYear. Eine Fusion selbst wird als org:ChangeEvent festgehalten."@de ,
                    "Quando l'organizzazione è stata chiusa o ha cessato di esistere in quanto tale (anche per fusione). Il valore è xsd:date, xsd:gYearMonth o xsd:gYear. Una fusione si registra come org:ChangeEvent."@it ,
                    "Cuándo se cerró la organización o dejó de existir como tal (incluso por fusión). El valor es xsd:date, xsd:gYearMonth o xsd:gYear. Una fusión misma se registra como un org:ChangeEvent."@es ,
                    "Quando a organização encerrou ou deixou de existir como tal (incluindo por fusão). O valor é xsd:date, xsd:gYearMonth ou xsd:gYear. Uma fusão em si regista-se como um org:ChangeEvent."@pt ,
                    "Mikor szűnt meg a szervezet, vagy mikor szűnt meg önmagaként létezni (összeolvadás miatt is). Az érték xsd:date, xsd:gYearMonth vagy xsd:gYear. Magát az összeolvadást org:ChangeEvent-ként kell rögzíteni."@hu .

mbr:organizationStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "organisation status"@en , "organisationsstatus"@sv , "statut de l'organisation"@fr , "Organisationsstatus"@de , "stato dell'organizzazione"@it , "estado de la organización"@es , "estado da organização"@pt , "szervezet állapota"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "Whether the organisation is active, dormant, merged or closed (see mbrc:OrganizationStatuses)."@en ,
                    "Om organisationen är verksam, vilande, sammanslagen eller nedlagd (se mbrc:OrganizationStatuses)."@sv ,
                    "Indique si l'organisation est en activité, en sommeil, fusionnée ou dissoute (voir mbrc:OrganizationStatuses)."@fr ,
                    "Ob die Organisation aktiv, ruhend, fusioniert oder aufgelöst ist (siehe mbrc:OrganizationStatuses)."@de ,
                    "Se l'organizzazione è attiva, dormiente, fusa o chiusa (vedi mbrc:OrganizationStatuses)."@it ,
                    "Si la organización está activa, latente, fusionada o cerrada (véase mbrc:OrganizationStatuses)."@es ,
                    "Se a organização está ativa, latente, fundida ou encerrada (ver mbrc:OrganizationStatuses)."@pt ,
                    "Hogy a szervezet működik-e, szünetel-e, beolvadt-e vagy megszűnt-e (lásd mbrc:OrganizationStatuses)."@hu ;
    skos:scopeNote "On an organisation this is the registered current picture. Earlier and later values, with the dates they applied, are given with mbr:OrganizationPeriod; the current value is not derived from the periods."@en ,
                   "På en organisation är detta den registrerade aktuella bilden. Tidigare och senare värden, med de datum de gällde, anges med mbr:OrganizationPeriod; det aktuella värdet härleds inte ur perioderna."@sv ,
                   "Sur une organisation, c'est l'image actuelle enregistrée. Les valeurs antérieures et postérieures, avec les dates auxquelles elles s'appliquaient, sont indiquées avec mbr:OrganizationPeriod ; la valeur actuelle n'est pas déduite des périodes."@fr ,
                   "An einer Organisation ist dies das eingetragene aktuelle Bild. Frühere und spätere Werte mit den Daten, an denen sie galten, werden mit mbr:OrganizationPeriod angegeben; der aktuelle Wert wird nicht aus den Perioden abgeleitet."@de ,
                   "Su un'organizzazione è il quadro attuale registrato. I valori precedenti e successivi, con le date in cui valevano, si indicano con mbr:OrganizationPeriod; il valore attuale non è ricavato dai periodi."@it ,
                   "En una organización es la imagen actual registrada. Los valores anteriores y posteriores, con las fechas en que se aplicaron, se dan con mbr:OrganizationPeriod; el valor actual no se deriva de los períodos."@es ,
                   "Numa organização é a imagem atual registada. Os valores anteriores e posteriores, com as datas em que se aplicaram, indicam-se com mbr:OrganizationPeriod; o valor atual não se deriva dos períodos."@pt ,
                   "Egy szervezeten ez a nyilvántartott jelenlegi kép. A korábbi és későbbi értékeket, érvényességük dátumával, az mbr:OrganizationPeriod adja meg; a jelenlegi értéket nem az időszakokból származtatják."@hu .

mbr:ownershipModel a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "ownership model"@en , "ägarform"@sv , "mode de propriété"@fr , "Eigentumsmodell"@de , "forma di proprietà"@it , "modelo de propiedad"@es , "modelo de propriedade"@pt , "tulajdonmodell"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "Who owns and runs the organisation: its members, a proprietor, or a parent institution (see mbrc:OwnershipModels)."@en ,
                    "Vem som äger och driver organisationen: medlemmarna, en ägare eller en moderinstitution (se mbrc:OwnershipModels)."@sv ,
                    "Qui possède et dirige l'organisation : ses membres, un propriétaire ou une institution mère (voir mbrc:OwnershipModels)."@fr ,
                    "Wem die Organisation gehört und wer sie betreibt: ihre Mitglieder, ein Eigentümer oder eine übergeordnete Institution (siehe mbrc:OwnershipModels)."@de ,
                    "Chi possiede e dirige l'organizzazione: i suoi soci, un proprietario o un'istituzione madre (vedi mbrc:OwnershipModels)."@it ,
                    "Quién es dueño de la organización y la dirige: sus miembros, un propietario o una institución matriz (véase mbrc:OwnershipModels)."@es ,
                    "Quem é dono da organização e a dirige: os seus membros, um proprietário ou uma instituição-mãe (ver mbrc:OwnershipModels)."@pt ,
                    "Ki a tulajdonosa és irányítója a szervezetnek: a tagjai, egy tulajdonos vagy egy fenntartó intézmény (lásd mbrc:OwnershipModels)."@hu ;
    skos:scopeNote "On an organisation this is the registered current picture. Earlier and later values, with the dates they applied, are given with mbr:OrganizationPeriod; the current value is not derived from the periods."@en ,
                   "På en organisation är detta den registrerade aktuella bilden. Tidigare och senare värden, med de datum de gällde, anges med mbr:OrganizationPeriod; det aktuella värdet härleds inte ur perioderna."@sv ,
                   "Sur une organisation, c'est l'image actuelle enregistrée. Les valeurs antérieures et postérieures, avec les dates auxquelles elles s'appliquaient, sont indiquées avec mbr:OrganizationPeriod ; la valeur actuelle n'est pas déduite des périodes."@fr ,
                   "An einer Organisation ist dies das eingetragene aktuelle Bild. Frühere und spätere Werte mit den Daten, an denen sie galten, werden mit mbr:OrganizationPeriod angegeben; der aktuelle Wert wird nicht aus den Perioden abgeleitet."@de ,
                   "Su un'organizzazione è il quadro attuale registrato. I valori precedenti e successivi, con le date in cui valevano, si indicano con mbr:OrganizationPeriod; il valore attuale non è ricavato dai periodi."@it ,
                   "En una organización es la imagen actual registrada. Los valores anteriores y posteriores, con las fechas en que se aplicaron, se dan con mbr:OrganizationPeriod; el valor actual no se deriva de los períodos."@es ,
                   "Numa organização é a imagem atual registada. Os valores anteriores e posteriores, com as datas em que se aplicaram, indicam-se com mbr:OrganizationPeriod; o valor atual não se deriva dos períodos."@pt ,
                   "Egy szervezeten ez a nyilvántartott jelenlegi kép. A korábbi és későbbi értékeket, érvényességük dátumával, az mbr:OrganizationPeriod adja meg; a jelenlegi értéket nem az időszakokból származtatják."@hu .

mbr:Charter a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "Charter"@en , "Stiftelsebrev"@sv , "Charte"@fr , "Konstitutionsurkunde"@de , "Carta costitutiva"@it , "Carta constitutiva"@es , "Carta constitutiva"@pt , "Alapítólevél"@hu ;
    skos:definition "The document or act by which a body grants another the right to exist and act as part of it: a lodge's warrant, a club's charter from Rotary International, a student corporation's charter from its federation. It is given by one organisation (mbr:issuedBy) to another (mbr:issuedTo), with the date it was granted (mbr:startDate), the date it ended, if it did (mbr:endDate), and its state (mbr:charterStatus)."@en ,
                    "Det dokument eller den akt varigenom ett organ ger ett annat rätt att finnas och verka som en del av det: en loges stiftelsebrev, en klubbs charter från Rotary International, en studentkorporations charter från sitt förbund. Det ges av en organisation (mbr:issuedBy) till en annan (mbr:issuedTo), med dagen då det beviljades (mbr:startDate), dagen då det upphörde, om det gjorde det (mbr:endDate), och dess tillstånd (mbr:charterStatus)."@sv ,
                    "Le document ou l'acte par lequel un organe accorde à un autre le droit d'exister et d'agir comme une partie de lui : les lettres patentes d'une loge, la charte d'un club accordée par Rotary International, la charte d'une corporation étudiante accordée par sa fédération. Elle est délivrée par une organisation (mbr:issuedBy) à une autre (mbr:issuedTo), avec la date de son octroi (mbr:startDate), la date de sa fin, s'il y en a une (mbr:endDate), et son état (mbr:charterStatus)."@fr ,
                    "Die Urkunde oder der Akt, durch den ein Organ einem anderen das Recht gibt, als Teil von ihm zu bestehen und zu wirken: das Patent einer Loge, die Charter eines Clubs von Rotary International, die Charter einer studentischen Korporation von ihrem Verband. Sie wird von einer Organisation (mbr:issuedBy) an eine andere (mbr:issuedTo) erteilt, mit dem Tag der Erteilung (mbr:startDate), dem Tag ihres Endes, falls sie endete (mbr:endDate), und ihrem Zustand (mbr:charterStatus)."@de ,
                    "Il documento o l'atto con cui un organismo concede a un altro il diritto di esistere e di agire come parte di esso: la patente di una loggia, la carta costitutiva di un club concessa da Rotary International, la carta di una corporazione studentesca concessa dalla sua federazione. È rilasciata da un'organizzazione (mbr:issuedBy) a un'altra (mbr:issuedTo), con la data di concessione (mbr:startDate), la data in cui è finita, se è finita (mbr:endDate), e il suo stato (mbr:charterStatus)."@it ,
                    "El documento o acto por el cual un organismo concede a otro el derecho a existir y actuar como parte de él: la patente de una logia, la carta de un club concedida por Rotary International, la carta de una corporación estudiantil concedida por su federación. La concede una organización (mbr:issuedBy) a otra (mbr:issuedTo), con la fecha en que se concedió (mbr:startDate), la fecha en que terminó, si terminó (mbr:endDate), y su estado (mbr:charterStatus)."@es ,
                    "O documento ou ato pelo qual um organismo concede a outro o direito de existir e agir como parte dele: a patente de uma loja, a carta de um clube concedida pelo Rotary International, a carta de uma corporação estudantil concedida pela sua federação. É concedida por uma organização (mbr:issuedBy) a outra (mbr:issuedTo), com a data em que foi concedida (mbr:startDate), a data em que terminou, se terminou (mbr:endDate), e o seu estado (mbr:charterStatus)."@pt ,
                    "Az irat vagy aktus, amellyel egy testület jogot ad egy másiknak, hogy részeként létezzen és működjön: egy páholy pátense, egy klub Rotary Internationaltól kapott oklevele, egy diákkorporáció szövetségétől kapott oklevele. Egy szervezet (mbr:issuedBy) adja egy másiknak (mbr:issuedTo), a megadás napjával (mbr:startDate), a megszűnés napjával, ha megszűnt (mbr:endDate), és az állapotával (mbr:charterStatus)."@hu ;
    skos:scopeNote "fraternal:warrantedBy is the shortcut for the current state: the body that issued the lodge's warrant. Use a charter when its date, its state or its history matters. A charter that is surrendered and later given again is two charters, the second one with its own dates. The number a lodge has in its grand lodge's roll is not on the charter: give it as an adms:Identifier with skos:notation and adms:schemaAgency, linked with adms:identifier."@en ,
                   "fraternal:warrantedBy är genvägen för det nuvarande läget: det organ som utfärdade logens stiftelsebrev. Använd ett stiftelsebrev när dess datum, tillstånd eller historia har betydelse. Ett stiftelsebrev som lämnas tillbaka och senare ges på nytt är två stiftelsebrev, det andra med egna datum. Det nummer en loge har i sin storloges förteckning hör inte till stiftelsebrevet: ange det som en adms:Identifier med skos:notation och adms:schemaAgency, länkad med adms:identifier."@sv ,
                   "fraternal:warrantedBy est le raccourci pour l'état actuel : l'organe qui a délivré les lettres patentes de la loge. Utilisez une charte lorsque sa date, son état ou son historique comptent. Une charte rendue puis accordée de nouveau fait deux chartes, la seconde avec ses propres dates. Le numéro qu'une loge porte au tableau de sa grande loge n'est pas sur la charte : indiquez-le comme un adms:Identifier avec skos:notation et adms:schemaAgency, relié par adms:identifier."@fr ,
                   "fraternal:warrantedBy ist die Abkürzung für den aktuellen Stand: die Stelle, die das Patent der Loge ausgestellt hat. Eine Urkunde wird verwendet, wenn ihr Datum, ihr Zustand oder ihre Geschichte wichtig ist. Eine Charter, die zurückgegeben und später erneut erteilt wird, sind zwei Urkunden, die zweite mit eigenen Daten. Die Nummer, die eine Loge im Verzeichnis ihrer Großloge führt, gehört nicht zur Urkunde: Sie wird als adms:Identifier mit skos:notation und adms:schemaAgency angegeben, verknüpft mit adms:identifier."@de ,
                   "fraternal:warrantedBy è la scorciatoia per lo stato attuale: l'organismo che ha rilasciato la patente della loggia. Si usa una carta quando contano la sua data, il suo stato o la sua storia. Una carta restituita e poi concessa di nuovo sono due carte, la seconda con date proprie. Il numero che una loggia ha nell'elenco della sua gran loggia non è sulla carta: si indica come adms:Identifier con skos:notation e adms:schemaAgency, collegato con adms:identifier."@it ,
                   "fraternal:warrantedBy es el atajo para el estado actual: el organismo que expidió la patente de la logia. Se usa una carta cuando importan su fecha, su estado o su historia. Una carta que se devuelve y más tarde se concede de nuevo son dos cartas, la segunda con sus propias fechas. El número que una logia tiene en el registro de su gran logia no está en la carta: se da como un adms:Identifier con skos:notation y adms:schemaAgency, vinculado con adms:identifier."@es ,
                   "fraternal:warrantedBy é o atalho para o estado atual: o organismo que emitiu a patente da loja. Usa-se uma carta quando importam a sua data, o seu estado ou a sua história. Uma carta que é devolvida e mais tarde concedida de novo são duas cartas, a segunda com as suas próprias datas. O número que uma loja tem no registo da sua grande loja não está na carta: indica-se como um adms:Identifier com skos:notation e adms:schemaAgency, ligado com adms:identifier."@pt ,
                   "A fraternal:warrantedBy a jelenlegi állapot rövidítése: az a testület, amely a páholy pátensét kiállította. Alapítólevelet akkor használjunk, ha a dátuma, az állapota vagy a története számít. Az az alapítólevél, amelyet visszaadtak, majd később újra megadtak, két alapítólevél, a második a saját dátumaival. A számot, amelyet egy páholy a nagypáholya nyilvántartásában visel, nem az alapítólevél tartalmazza: adms:Identifier-ként kell megadni skos:notation és adms:schemaAgency értékkel, az adms:identifier segítségével kapcsolva."@hu .

mbr:OrganizationPeriod a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "Organisation Period"@en , "Organisationsperiod"@sv , "Période d'organisation"@fr , "Organisationsperiode"@de , "Periodo dell'organizzazione"@it , "Período de la organización"@es , "Período da organização"@pt , "Szervezeti időszak"@hu ;
    skos:definition "A period during which a membership organisation had a given gender policy, admission mode, ownership model, status, organisation type or legal form. The values are given on the period with mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType and mbr:legalForm, and the period carries the dates: mbr:startDate and mbr:endDate for when they applied and mbr:decisionDate for when they were decided. Linked from the organisation with mbr:hasPeriod."@en ,
                    "En period under vilken en medlemsorganisation hade en viss könspolicy, upptagningsform, ägarform, status, organisationstyp eller associationsform. Värdena anges på perioden med mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType och mbr:legalForm, och perioden bär datumen: mbr:startDate och mbr:endDate för när de gällde och mbr:decisionDate för när de beslutades. Kopplas från organisationen med mbr:hasPeriod."@sv ,
                    "Période pendant laquelle une organisation de membres avait une règle de mixité, un mode d'admission, un mode de propriété, un statut, un type d'organisation ou une forme juridique donnés. Les valeurs sont indiquées sur la période avec mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType et mbr:legalForm, et la période porte les dates : mbr:startDate et mbr:endDate pour le moment où elles s'appliquaient, et mbr:decisionDate pour le moment où elles ont été décidées. Reliée à l'organisation par mbr:hasPeriod."@fr ,
                    "Ein Zeitraum, in dem eine Mitgliederorganisation eine bestimmte Geschlechterregelung, ein bestimmtes Aufnahmeverfahren, ein bestimmtes Eigentumsmodell, einen bestimmten Status, eine bestimmte Organisationsart oder Rechtsform hatte. Die Werte werden an der Periode mit mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType und mbr:legalForm angegeben, und die Periode trägt die Daten: mbr:startDate und mbr:endDate für die Zeit, in der sie galten, und mbr:decisionDate für den Zeitpunkt, an dem sie beschlossen wurden. Von der Organisation aus mit mbr:hasPeriod verknüpft."@de ,
                    "Un periodo in cui un'organizzazione associativa aveva una determinata politica di genere, modalità di ammissione, forma di proprietà, stato, tipo di organizzazione o forma giuridica. I valori si indicano sul periodo con mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType e mbr:legalForm, e il periodo porta le date: mbr:startDate e mbr:endDate per quando i valori valevano e mbr:decisionDate per quando furono decisi. Collegato all'organizzazione con mbr:hasPeriod."@it ,
                    "Un período durante el cual una organización de miembros tuvo una determinada política de género, modalidad de admisión, modelo de propiedad, estado, tipo de organización o forma jurídica. Los valores se dan en el período con mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType y mbr:legalForm, y el período lleva las fechas: mbr:startDate y mbr:endDate para cuando se aplicaron y mbr:decisionDate para cuando se decidieron. Se vincula desde la organización con mbr:hasPeriod."@es ,
                    "Um período durante o qual uma organização de membros teve uma determinada política de género, modalidade de admissão, modelo de propriedade, estado, tipo de organização ou forma jurídica. Os valores indicam-se no período com mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType e mbr:legalForm, e o período leva as datas: mbr:startDate e mbr:endDate para quando se aplicaram e mbr:decisionDate para quando foram decididos. Liga-se a partir da organização com mbr:hasPeriod."@pt ,
                    "Az az időszak, amely alatt egy tagsági szervezetnek adott nemi politikája, felvételi módja, tulajdonmodellje, állapota, szervezettípusa vagy jogi formája volt. Az értékeket az időszakon az mbr:genderPolicy, mbr:admissionMode, mbr:ownershipModel, mbr:organizationStatus, mbr:organizationType és mbr:legalForm adja meg, az időszak pedig a dátumokat hordozza: az mbr:startDate és mbr:endDate azt, mikor érvényesek voltak, az mbr:decisionDate azt, mikor döntöttek róluk. A szervezetből az mbr:hasPeriod kapcsolja."@hu ;
    skos:scopeNote "Give only the properties a period concerns: a club that begins to admit women gets a new period with mbr:genderPolicy and leaves its ownership model alone. Periods for different properties may overlap in time. The start is when the value began to apply, which may be earlier or later than the decision (a vote taken in one year, in force from the next, or a decision with retroactive effect). A period without an end date has no stated end; that does not say it still applies. The registered current picture stays on the organisation itself; it is not derived from the periods, and the two are not compared except in a profile whose history is complete. A change of policy does not change org:classification: a club classified as mbrc:gentlemensClub stays so, and so stays an mbr:GentlemensClub, until its classification is changed. When it is, the registered current classification changes on the organisation and the earlier one is kept as a period with mbr:organizationType. The convenience classes follow the current org:classification on the organisation, never the periods."@en ,
                   "Ange bara de egenskaper en period gäller: en klubb som börjar upta kvinnor får en ny period med mbr:genderPolicy och lämnar sin ägarform ifred. Perioder för olika egenskaper får överlappa i tid. Starten är när värdet började gälla, vilket kan vara tidigare eller senare än beslutet (en omröstning ett år som gäller från nästa, eller ett beslut med retroaktiv verkan). En period utan slutdatum har inget angivet slut; det säger inte att den fortfarande gäller. Den registrerade aktuella bilden finns kvar på organisationen själv; den härleds inte ur perioderna, och de två jämförs inte utom i en profil med komplett historik. En ändrad policy ändrar inte org:classification: en klubb klassificerad som mbrc:gentlemensClub förblir det, och därmed en mbr:GentlemensClub, tills klassificeringen ändras. När den ändras byts den registrerade aktuella klassificeringen på organisationen och den tidigare behålls som en period med mbr:organizationType. Bekvämlighetsklasserna följer den aktuella org:classification på organisationen, aldrig perioderna."@sv ,
                   "N'indiquez que les propriétés qu'une période concerne : un club qui commence à admettre des femmes reçoit une nouvelle période avec mbr:genderPolicy et laisse son mode de propriété tel quel. Des périodes portant sur des propriétés différentes peuvent se chevaucher dans le temps. Le début est le moment où la valeur a commencé à s'appliquer, qui peut précéder ou suivre la décision (un vote pris une année et en vigueur l'année suivante, ou une décision à effet rétroactif). Une période sans date de fin n'a pas de fin indiquée ; cela ne dit pas qu'elle s'applique encore. L'image actuelle enregistrée reste sur l'organisation elle-même ; elle n'est pas déduite des périodes, et les deux ne sont comparées que dans un profil dont l'historique est complet. Un changement de règle ne change pas org:classification : un club classé comme mbrc:gentlemensClub le reste, et reste donc un mbr:GentlemensClub, jusqu'à ce que sa classification soit changée. Quand elle l'est, la classification actuelle enregistrée change sur l'organisation et la précédente est conservée comme période avec mbr:organizationType. Les classes de commodité suivent l'org:classification actuelle de l'organisation, jamais les périodes."@fr ,
                   "Es werden nur die Eigenschaften angegeben, die eine Periode betrifft: Ein Club, der beginnt, Frauen aufzunehmen, erhält eine neue Periode mit mbr:genderPolicy und lässt sein Eigentumsmodell unberührt. Perioden für verschiedene Eigenschaften dürfen sich zeitlich überschneiden. Der Beginn ist der Zeitpunkt, ab dem der Wert galt; er kann vor oder nach dem Beschluss liegen (eine Abstimmung in einem Jahr, in Kraft ab dem nächsten, oder ein Beschluss mit rückwirkender Kraft). Eine Periode ohne Enddatum hat kein angegebenes Ende; das sagt nicht, dass sie noch gilt. Das eingetragene aktuelle Bild bleibt an der Organisation selbst; es wird nicht aus den Perioden abgeleitet, und beide werden nicht verglichen, außer in einem Profil, dessen Verlauf vollständig ist. Eine Änderung der Regelung ändert org:classification nicht: Ein als mbrc:gentlemensClub eingeordneter Club bleibt es und damit ein mbr:GentlemensClub, bis seine Einordnung geändert wird. Geschieht das, ändert sich die eingetragene aktuelle Einordnung an der Organisation, und die frühere bleibt als Periode mit mbr:organizationType erhalten. Die Komfortklassen folgen der aktuellen org:classification der Organisation, nie den Perioden."@de ,
                   "Si indicano solo le proprietà a cui il periodo si riferisce: un club che comincia ad ammettere le donne ottiene un nuovo periodo con mbr:genderPolicy e lascia stare la forma di proprietà. I periodi di proprietà diverse possono sovrapporsi nel tempo. L'inizio è il momento in cui il valore ha cominciato a valere, che può essere precedente o successivo alla decisione (un voto preso in un anno e in vigore dall'anno seguente, o una decisione con effetto retroattivo). Un periodo senza data di fine non ha una fine dichiarata; ciò non dice che valga ancora. Il quadro attuale registrato resta sull'organizzazione stessa; non è ricavato dai periodi, e i due non vengono confrontati se non in un profilo la cui storia sia completa. Un cambiamento di politica non cambia org:classification: un club classificato come mbrc:gentlemensClub resta tale, e quindi resta un mbr:GentlemensClub, finché la sua classificazione non viene cambiata. Quando lo è, la classificazione attuale registrata cambia sull'organizzazione e quella precedente si conserva come periodo con mbr:organizationType. Le classi di comodo seguono la org:classification attuale dell'organizzazione, mai i periodi."@it ,
                   "Se dan solo las propiedades que afectan al período: un club que empieza a admitir mujeres recibe un nuevo período con mbr:genderPolicy y deja intacto su modelo de propiedad. Los períodos de distintas propiedades pueden solaparse en el tiempo. El inicio es cuando el valor empezó a aplicarse, que puede ser anterior o posterior a la decisión (una votación en un año con efecto desde el siguiente, o una decisión con efecto retroactivo). Un período sin fecha de fin no tiene un final declarado; eso no dice que siga aplicándose. La imagen actual registrada permanece en la propia organización; no se deriva de los períodos, y ambas no se comparan salvo en un perfil cuya historia esté completa. Un cambio de política no cambia org:classification: un club clasificado como mbrc:gentlemensClub sigue siéndolo, y por tanto sigue siendo un mbr:GentlemensClub, hasta que se cambie su clasificación. Cuando se cambia, la clasificación actual registrada cambia en la organización y la anterior se conserva como un período con mbr:organizationType. Las clases de conveniencia siguen la org:classification actual de la organización, nunca los períodos."@es ,
                   "Indicam-se apenas as propriedades a que o período diz respeito: um clube que começa a admitir mulheres recebe um novo período com mbr:genderPolicy e deixa intacto o seu modelo de propriedade. Os períodos de propriedades diferentes podem sobrepor-se no tempo. O início é quando o valor começou a aplicar-se, que pode ser anterior ou posterior à decisão (uma votação num ano com efeito a partir do seguinte, ou uma decisão com efeito retroativo). Um período sem data de fim não tem um fim declarado; isso não diz que continue a aplicar-se. A imagem atual registada permanece na própria organização; não se deriva dos períodos, e ambas não se comparam, exceto num perfil cuja história esteja completa. Uma mudança de política não muda org:classification: um clube classificado como mbrc:gentlemensClub continua a sê-lo, e por isso continua a ser um mbr:GentlemensClub, até que a sua classificação seja alterada. Quando é alterada, a classificação atual registada muda na organização e a anterior fica guardada como um período com mbr:organizationType. As classes de conveniência seguem a org:classification atual da organização, nunca os períodos."@pt ,
                   "Csak azokat a tulajdonságokat kell megadni, amelyeket az időszak érint: az a klub, amely nőket kezd felvenni, új időszakot kap az mbr:genderPolicy értékkel, a tulajdonmodelljét pedig érintetlenül hagyja. A különböző tulajdonságok időszakai átfedhetik egymást az időben. A kezdet az, amikor az érték érvényessé vált, ami lehet korábbi vagy későbbi a döntésnél (az egyik évben hozott szavazás a következő évtől hatályos, vagy visszamenőleges hatályú döntés). A záró dátum nélküli időszaknak nincs megadott vége; ez nem mondja azt, hogy még érvényes. A nyilvántartott jelenlegi kép magán a szervezeten marad; nem az időszakokból származtatják, és a kettőt nem hasonlítják össze, kivéve olyan profilban, amelynek története teljes. A politika megváltozása nem változtatja meg az org:classification értéket: az mbrc:gentlemensClub besorolású klub az marad, és így mbr:GentlemensClub marad, amíg a besorolását meg nem változtatják. Amikor megváltoztatják, a nyilvántartott jelenlegi besorolás megváltozik a szervezeten, a korábbit pedig mbr:organizationType értékű időszakként őrzik meg. A kényelmi osztályok a szervezet jelenlegi org:classification értékét követik, soha nem az időszakokat."@hu .

mbr:issuedBy a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "issued by"@en , "utfärdat av"@sv , "délivrée par"@fr , "ausgestellt von"@de , "rilasciata da"@it , "expedida por"@es , "emitida por"@pt , "kiállította"@hu ;
    rdfs:domain mbr:Charter ;
    rdfs:range org:Organization ;
    skos:definition "The organisation that granted a charter."@en ,
                    "Den organisation som beviljade ett stiftelsebrev."@sv ,
                    "L'organisation qui a accordé une charte."@fr ,
                    "Die Organisation, die eine Urkunde erteilt hat."@de ,
                    "L'organizzazione che ha concesso una carta."@it ,
                    "La organización que concedió una carta."@es ,
                    "A organização que concedeu uma carta."@pt ,
                    "A szervezet, amely az alapítólevelet megadta."@hu .

mbr:issuedTo a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "issued to"@en , "utfärdat till"@sv , "délivrée à"@fr , "ausgestellt an"@de , "rilasciata a"@it , "expedida a"@es , "emitida a"@pt , "kinek állították ki"@hu ;
    rdfs:domain mbr:Charter ;
    rdfs:range org:Organization ;
    skos:definition "The organisation that holds a charter."@en ,
                    "Den organisation som innehar ett stiftelsebrev."@sv ,
                    "L'organisation qui détient une charte."@fr ,
                    "Die Organisation, die eine Urkunde innehat."@de ,
                    "L'organizzazione che detiene una carta."@it ,
                    "La organización que posee una carta."@es ,
                    "A organização que detém uma carta."@pt ,
                    "A szervezet, amely az alapítólevelet birtokolja."@hu .

mbr:charterStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "charter status"@en , "stiftelsebrevets tillstånd"@sv , "état de la charte"@fr , "Zustand der Urkunde"@de , "stato della carta"@it , "estado de la carta"@es , "estado da carta"@pt , "alapítólevél állapota"@hu ;
    rdfs:domain mbr:Charter ;
    rdfs:range skos:Concept ;
    skos:definition "Whether a charter is in force, suspended, given back or withdrawn (see mbrc:CharterStatuses)."@en ,
                    "Om ett stiftelsebrev gäller, är avstängt, har lämnats tillbaka eller dragits in (se mbrc:CharterStatuses)."@sv ,
                    "Si une charte est en vigueur, suspendue, rendue ou retirée (voir mbrc:CharterStatuses)."@fr ,
                    "Ob eine Urkunde gilt, ruht, zurückgegeben oder entzogen ist (siehe mbrc:CharterStatuses)."@de ,
                    "Se una carta è in vigore, sospesa, restituita o ritirata (vedi mbrc:CharterStatuses)."@it ,
                    "Si una carta está en vigor, suspendida, devuelta o retirada (véase mbrc:CharterStatuses)."@es ,
                    "Se uma carta está em vigor, suspensa, devolvida ou retirada (ver mbrc:CharterStatuses)."@pt ,
                    "Hogy az alapítólevél érvényben van-e, fel van-e függesztve, vissza van-e adva vagy vissza van-e vonva (lásd mbrc:CharterStatuses)."@hu .

mbr:changeEventType a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "change event type"@en , "typ av förändring"@sv , "type de changement"@fr , "Art der Veränderung"@de , "tipo di cambiamento"@it , "tipo de cambio"@es , "tipo de alteração"@pt , "változás típusa"@hu ;
    rdfs:domain org:ChangeEvent ;
    rdfs:range skos:Concept ;
    skos:definition "The kind of change an org:ChangeEvent records, such as a merger, a split or a change of name (see mbrc:ChangeEventTypes)."@en ,
                    "Slaget av förändring som en org:ChangeEvent registrerar, till exempel en sammanslagning, en delning eller ett namnbyte (se mbrc:ChangeEventTypes)."@sv ,
                    "Le genre de changement qu'un org:ChangeEvent consigne, comme une fusion, une scission ou un changement de nom (voir mbrc:ChangeEventTypes)."@fr ,
                    "Die Art der Veränderung, die ein org:ChangeEvent festhält, etwa eine Fusion, eine Spaltung oder eine Namensänderung (siehe mbrc:ChangeEventTypes)."@de ,
                    "Il tipo di cambiamento che un org:ChangeEvent registra, come una fusione, una scissione o un cambio di nome (vedi mbrc:ChangeEventTypes)."@it ,
                    "El tipo de cambio que registra un org:ChangeEvent, como una fusión, una escisión o un cambio de nombre (véase mbrc:ChangeEventTypes)."@es ,
                    "O tipo de alteração que um org:ChangeEvent regista, como uma fusão, uma cisão ou uma mudança de nome (ver mbrc:ChangeEventTypes)."@pt ,
                    "A változás fajtája, amelyet egy org:ChangeEvent rögzít, például összeolvadás, szétválás vagy névváltozás (lásd mbrc:ChangeEventTypes)."@hu .

mbr:hasPeriod a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "has period"@en , "har period"@sv , "a pour période"@fr , "hat Periode"@de , "ha periodo"@it , "tiene período"@es , "tem período"@pt , "időszaka van"@hu ;
    rdfs:range mbr:OrganizationPeriod ;
    skos:definition "Links an organisation to a period (mbr:OrganizationPeriod) in which it had a gender policy, admission mode, ownership model, status, organisation type or legal form. An organisation may have many."@en ,
                    "Kopplar en organisation till en period (mbr:OrganizationPeriod) under vilken den hade en könspolicy, upptagningsform, ägarform, status, organisationstyp eller associationsform. En organisation kan ha många."@sv ,
                    "Relie une organisation à une période (mbr:OrganizationPeriod) pendant laquelle elle avait une règle de mixité, un mode d'admission, un mode de propriété, un statut, un type d'organisation ou une forme juridique. Une organisation peut en avoir plusieurs."@fr ,
                    "Verknüpft eine Organisation mit einer Periode (mbr:OrganizationPeriod), in der sie eine Geschlechterregelung, ein Aufnahmeverfahren, ein Eigentumsmodell, einen Status, eine Organisationsart oder eine Rechtsform hatte. Eine Organisation kann mehrere haben."@de ,
                    "Collega un'organizzazione a un periodo (mbr:OrganizationPeriod) in cui aveva una politica di genere, una modalità di ammissione, una forma di proprietà, uno stato, un tipo di organizzazione o una forma giuridica. Un'organizzazione può averne molti."@it ,
                    "Vincula una organización con un período (mbr:OrganizationPeriod) en el que tuvo una política de género, modalidad de admisión, modelo de propiedad, estado, tipo de organización o forma jurídica. Una organización puede tener muchos."@es ,
                    "Liga uma organização a um período (mbr:OrganizationPeriod) em que teve uma política de género, modalidade de admissão, modelo de propriedade, estado, tipo de organização ou forma jurídica. Uma organização pode ter muitos."@pt ,
                    "Egy szervezetet egy időszakkal (mbr:OrganizationPeriod) kapcsol össze, amelyben nemi politikája, felvételi módja, tulajdonmodellje, állapota, szervezettípusa vagy jogi formája volt. Egy szervezetnek sok lehet."@hu .

mbr:organizationType a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "organisation type"@en , "organisationstyp"@sv , "type d'organisation"@fr , "Organisationsart"@de , "tipo di organizzazione"@it , "tipo de organización"@es , "tipo de organização"@pt , "szervezettípus"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "The kind of organisation it was during a period (see mbrc:OrganizationTypes). Used on an mbr:OrganizationPeriod; the same values as org:classification gives on the organisation."@en ,
                    "Vilken sorts organisation den var under en period (se mbrc:OrganizationTypes). Används på en mbr:OrganizationPeriod; samma värden som org:classification anger på organisationen."@sv ,
                    "Le genre d'organisation qu'elle était pendant une période (voir mbrc:OrganizationTypes). Utilisé sur une mbr:OrganizationPeriod ; les mêmes valeurs que celles données par org:classification sur l'organisation."@fr ,
                    "Die Art der Organisation während einer Periode (siehe mbrc:OrganizationTypes). Wird an einer mbr:OrganizationPeriod verwendet; dieselben Werte, die org:classification an der Organisation angibt."@de ,
                    "Il tipo di organizzazione che era durante un periodo (vedi mbrc:OrganizationTypes). Si usa su un mbr:OrganizationPeriod; gli stessi valori che org:classification dà sull'organizzazione."@it ,
                    "El tipo de organización que fue durante un período (véase mbrc:OrganizationTypes). Se usa en un mbr:OrganizationPeriod; son los mismos valores que org:classification da en la organización."@es ,
                    "O tipo de organização que foi durante um período (ver mbrc:OrganizationTypes). Usa-se num mbr:OrganizationPeriod; são os mesmos valores que org:classification dá na organização."@pt ,
                    "A szervezet fajtája, amely egy időszak alatt volt (lásd mbrc:OrganizationTypes). Egy mbr:OrganizationPeriod-on használatos; ugyanazok az értékek, amelyeket az org:classification ad a szervezeten."@hu ;
    skos:scopeNote "A separate property because org:classification has the domain org:Organization: used on a period, it would make the period an organisation. An organisation may have several types at once, so periods with different types may overlap. The registered current classification stays on the organisation with org:classification."@en ,
                   "En egen egenskap eftersom org:classification har domänen org:Organization: använd på en period skulle den göra perioden till en organisation. En organisation kan ha flera typer samtidigt, så perioder med olika typer får överlappa. Den registrerade aktuella klassificeringen finns kvar på organisationen med org:classification."@sv ,
                   "Propriété distincte parce que org:classification a pour domaine org:Organization : utilisée sur une période, elle ferait de la période une organisation. Une organisation peut avoir plusieurs types à la fois, de sorte que des périodes de types différents peuvent se chevaucher. La classification actuelle enregistrée reste sur l'organisation avec org:classification."@fr ,
                   "Eine eigene Eigenschaft, weil org:classification den Definitionsbereich org:Organization hat: An einer Periode verwendet, würde sie die Periode zu einer Organisation machen. Eine Organisation kann mehrere Arten gleichzeitig haben, daher dürfen sich Perioden mit verschiedenen Arten überschneiden. Die eingetragene aktuelle Einordnung bleibt mit org:classification an der Organisation."@de ,
                   "Una proprietà separata perché org:classification ha come dominio org:Organization: usata su un periodo, farebbe del periodo un'organizzazione. Un'organizzazione può avere più tipi contemporaneamente, quindi periodi con tipi diversi possono sovrapporsi. La classificazione attuale registrata resta sull'organizzazione con org:classification."@it ,
                   "Una propiedad aparte porque org:classification tiene como dominio org:Organization: usada en un período, convertiría el período en una organización. Una organización puede tener varios tipos a la vez, por lo que los períodos con distintos tipos pueden solaparse. La clasificación actual registrada permanece en la organización con org:classification."@es ,
                   "Uma propriedade à parte porque org:classification tem como domínio org:Organization: usada num período, tornaria o período numa organização. Uma organização pode ter vários tipos ao mesmo tempo, pelo que os períodos com tipos diferentes podem sobrepor-se. A classificação atual registada permanece na organização com org:classification."@pt ,
                   "Külön tulajdonság, mert az org:classification értelmezési tartománya az org:Organization: egy időszakon használva az időszakot szervezetté tenné. Egy szervezetnek egyszerre több típusa is lehet, ezért a különböző típusú időszakok átfedhetik egymást. A nyilvántartott jelenlegi besorolás az org:classification-nel a szervezeten marad."@hu .

mbr:legalForm a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "legal form"@en , "associationsform"@sv , "forme juridique"@fr , "Rechtsform"@de , "forma giuridica"@it , "forma jurídica"@es , "forma jurídica"@pt , "jogi forma"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "The legal form the organisation had during a period (see mbrc:LegalForms). Used on an mbr:OrganizationPeriod; the same values as rov:orgType gives on the organisation."@en ,
                    "Den associationsform organisationen hade under en period (se mbrc:LegalForms). Används på en mbr:OrganizationPeriod; samma värden som rov:orgType anger på organisationen."@sv ,
                    "La forme juridique que l'organisation avait pendant une période (voir mbrc:LegalForms). Utilisé sur une mbr:OrganizationPeriod ; les mêmes valeurs que celles données par rov:orgType sur l'organisation."@fr ,
                    "Die Rechtsform, die die Organisation während einer Periode hatte (siehe mbrc:LegalForms). Wird an einer mbr:OrganizationPeriod verwendet; dieselben Werte, die rov:orgType an der Organisation angibt."@de ,
                    "La forma giuridica che l'organizzazione aveva durante un periodo (vedi mbrc:LegalForms). Si usa su un mbr:OrganizationPeriod; gli stessi valori che rov:orgType dà sull'organizzazione."@it ,
                    "La forma jurídica que tuvo la organización durante un período (véase mbrc:LegalForms). Se usa en un mbr:OrganizationPeriod; son los mismos valores que rov:orgType da en la organización."@es ,
                    "A forma jurídica que a organização teve durante um período (ver mbrc:LegalForms). Usa-se num mbr:OrganizationPeriod; são os mesmos valores que rov:orgType dá na organização."@pt ,
                    "A jogi forma, amellyel a szervezet egy időszak alatt rendelkezett (lásd mbrc:LegalForms). Egy mbr:OrganizationPeriod-on használatos; ugyanazok az értékek, amelyeket a rov:orgType ad a szervezeten."@hu ;
    skos:scopeNote "A separate property because rov:orgType, a sub-property of org:classification, has the domain org:Organization: used on a period, it would make the period an organisation. The registered current legal form stays on the organisation with rov:orgType. A change of legal form is a change in the organisation's form, not a new organisation; if the organisation is replaced by another, record it as an org:ChangeEvent."@en ,
                   "En egen egenskap eftersom rov:orgType, en underegenskap till org:classification, har domänen org:Organization: använd på en period skulle den göra perioden till en organisation. Den registrerade aktuella associationsformen finns kvar på organisationen med rov:orgType. En ändrad associationsform är en ändring av organisationens form, inte en ny organisation; ersätts organisationen av en annan, registrera det som en org:ChangeEvent."@sv ,
                   "Propriété distincte parce que rov:orgType, sous-propriété de org:classification, a pour domaine org:Organization : utilisée sur une période, elle ferait de la période une organisation. La forme juridique actuelle enregistrée reste sur l'organisation avec rov:orgType. Un changement de forme juridique est un changement de forme de l'organisation, non une nouvelle organisation ; si l'organisation est remplacée par une autre, enregistrez-le comme un org:ChangeEvent."@fr ,
                   "Eine eigene Eigenschaft, weil rov:orgType, eine Untereigenschaft von org:classification, den Definitionsbereich org:Organization hat: An einer Periode verwendet, würde sie die Periode zu einer Organisation machen. Die eingetragene aktuelle Rechtsform bleibt mit rov:orgType an der Organisation. Ein Wechsel der Rechtsform ist eine Änderung der Form der Organisation, keine neue Organisation; wird die Organisation durch eine andere ersetzt, ist das als org:ChangeEvent festzuhalten."@de ,
                   "Una proprietà separata perché rov:orgType, una sottoproprietà di org:classification, ha come dominio org:Organization: usata su un periodo, farebbe del periodo un'organizzazione. La forma giuridica attuale registrata resta sull'organizzazione con rov:orgType. Un cambiamento di forma giuridica è un cambiamento nella forma dell'organizzazione, non una nuova organizzazione; se l'organizzazione viene sostituita da un'altra, si registra come org:ChangeEvent."@it ,
                   "Una propiedad aparte porque rov:orgType, una subpropiedad de org:classification, tiene como dominio org:Organization: usada en un período, convertiría el período en una organización. La forma jurídica actual registrada permanece en la organización con rov:orgType. Un cambio de forma jurídica es un cambio en la forma de la organización, no una organización nueva; si la organización es sustituida por otra, se registra como un org:ChangeEvent."@es ,
                   "Uma propriedade à parte porque rov:orgType, uma subpropriedade de org:classification, tem como domínio org:Organization: usada num período, tornaria o período numa organização. A forma jurídica atual registada permanece na organização com rov:orgType. Uma mudança de forma jurídica é uma mudança na forma da organização, não uma organização nova; se a organização for substituída por outra, regista-se como um org:ChangeEvent."@pt ,
                   "Külön tulajdonság, mert a rov:orgType, az org:classification alulajdonsága, értelmezési tartománya az org:Organization: egy időszakon használva az időszakot szervezetté tenné. A nyilvántartott jelenlegi jogi forma a rov:orgType-pal a szervezeten marad. A jogi forma változása a szervezet formájának változása, nem új szervezet; ha a szervezetet egy másik váltja fel, org:ChangeEvent-ként kell rögzíteni."@hu .

mbr:publicBenefitStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "public benefit status"@en , "allmännyttig status"@sv , "statut d'utilité publique"@fr , "Gemeinnützigkeitsstatus"@de , "status di pubblica utilità"@it , "estatus de utilidad pública"@es , "estatuto de utilidade pública"@pt , "közhasznúsági státusz"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "A public-benefit status that the organisation has, or had during a period (see mbrc:PublicBenefitStatuses): a recognition by a public authority that it serves the public good, usually with duties and privileges such as tax relief. Used on an organisation and on an mbr:OrganizationPeriod; an organisation may have several."@en ,
                    "En allmännyttig status som organisationen har, eller hade under en period (se mbrc:PublicBenefitStatuses): ett erkännande från en myndighet att den tjänar det allmänna bästa, vanligen med skyldigheter och förmåner som skattelättnad. Används på en organisation och på en mbr:OrganizationPeriod; en organisation kan ha flera."@sv ,
                    "Un statut d'utilité publique que l'organisation a, ou avait pendant une période (voir mbrc:PublicBenefitStatuses) : une reconnaissance par une autorité publique qu'elle sert l'intérêt général, en général avec des obligations et des avantages comme un allègement fiscal. Utilisé sur une organisation et sur une mbr:OrganizationPeriod ; une organisation peut en avoir plusieurs."@fr ,
                    "Ein Gemeinnützigkeitsstatus, den die Organisation hat oder während einer Periode hatte (siehe mbrc:PublicBenefitStatuses): die Anerkennung durch eine öffentliche Stelle, dass sie dem Gemeinwohl dient, meist mit Pflichten und Vorteilen wie Steuererleichterung. Wird an einer Organisation und an einer mbr:OrganizationPeriod verwendet; eine Organisation kann mehrere haben."@de ,
                    "Uno status di pubblica utilità che l'organizzazione ha, o aveva durante un periodo (vedi mbrc:PublicBenefitStatuses): il riconoscimento da parte di un'autorità pubblica che essa serve il bene comune, di solito con obblighi e vantaggi come l'agevolazione fiscale. Si usa su un'organizzazione e su un mbr:OrganizationPeriod; un'organizzazione può averne più di uno."@it ,
                    "Un estatus de utilidad pública que la organización tiene, o tuvo durante un período (véase mbrc:PublicBenefitStatuses): un reconocimiento por una autoridad pública de que sirve al bien común, normalmente con obligaciones y privilegios como beneficios fiscales. Se usa en una organización y en un mbr:OrganizationPeriod; una organización puede tener varios."@es ,
                    "Um estatuto de utilidade pública que a organização tem, ou teve durante um período (ver mbrc:PublicBenefitStatuses): um reconhecimento por uma autoridade pública de que serve o bem comum, normalmente com deveres e privilégios como benefícios fiscais. Usa-se numa organização e num mbr:OrganizationPeriod; uma organização pode ter vários."@pt ,
                    "Közhasznúsági státusz, amellyel a szervezet rendelkezik, vagy egy időszak alatt rendelkezett (lásd mbrc:PublicBenefitStatuses): állami hatóság elismerése arról, hogy a szervezet a közjót szolgálja, rendszerint kötelezettségekkel és kiváltságokkal, például adókedvezménnyel. Szervezeten és mbr:OrganizationPeriod-on használatos; egy szervezetnek több is lehet."@hu ;
    skos:scopeNote "schema:nonprofitStatus has a similar purpose, but its range is the national types of five countries (Germany, Italy, the Netherlands, the United Kingdom and the United States), which mix legal form and charitable status, so it cannot hold the statuses of other countries. The statuses here are SKOS concepts; where a schema.org type corresponds to one, the mapping set links them."@en ,
                   "schema:nonprofitStatus har ett liknande syfte, men dess intervall är de nationella typerna i fem länder (Tyskland, Italien, Nederländerna, Storbritannien och USA), som blandar associationsform och välgörenhetsstatus, så den kan inte rymma andra länders statusar. Statusarna här är SKOS-begrepp; där en schema.org-typ motsvarar en länkar mappningsmängden dem."@sv ,
                   "schema:nonprofitStatus a un but proche, mais sa portée est constituée des types nationaux de cinq pays (Allemagne, Italie, Pays-Bas, Royaume-Uni et États-Unis), qui mêlent forme juridique et statut caritatif ; elle ne peut donc pas contenir les statuts d'autres pays. Les statuts ici sont des concepts SKOS ; lorsqu'un type de schema.org correspond à l'un d'eux, l'ensemble de mappings les relie."@fr ,
                   "schema:nonprofitStatus hat einen ähnlichen Zweck, aber sein Wertebereich sind die nationalen Typen von fünf Ländern (Deutschland, Italien, die Niederlande, das Vereinigte Königreich und die USA), die Rechtsform und Gemeinnützigkeit vermischen; er kann daher die Status anderer Länder nicht aufnehmen. Die Status hier sind SKOS-Konzepte; wo ein schema.org-Typ einem entspricht, verbindet sie die Mappingmenge."@de ,
                   "schema:nonprofitStatus ha uno scopo simile, ma il suo intervallo sono i tipi nazionali di cinque paesi (Germania, Italia, Paesi Bassi, Regno Unito e Stati Uniti), che mescolano forma giuridica e status di ente benefico, quindi non può contenere gli status di altri paesi. Gli status qui sono concetti SKOS; dove un tipo di schema.org corrisponde a uno di essi, l'insieme di mapping li collega."@it ,
                   "schema:nonprofitStatus tiene una finalidad parecida, pero su rango son los tipos nacionales de cinco países (Alemania, Italia, los Países Bajos, el Reino Unido y los Estados Unidos), que mezclan forma jurídica y estatus benéfico, por lo que no puede contener los estatus de otros países. Los estatus de aquí son conceptos SKOS; cuando un tipo de schema.org corresponde a uno, el conjunto de correspondencias los vincula."@es ,
                   "schema:nonprofitStatus tem uma finalidade semelhante, mas o seu contradomínio são os tipos nacionais de cinco países (Alemanha, Itália, Países Baixos, Reino Unido e Estados Unidos), que misturam forma jurídica e estatuto de beneficência, pelo que não pode conter os estatutos de outros países. Os estatutos daqui são conceitos SKOS; quando um tipo de schema.org corresponde a um deles, o conjunto de correspondências liga-os."@pt ,
                   "A schema:nonprofitStatus hasonló célt szolgál, de értéktartománya öt ország (Németország, Olaszország, Hollandia, az Egyesült Királyság és az Egyesült Államok) nemzeti típusai, amelyek keverik a jogi formát és a jótékonysági státuszt, ezért nem képes más országok státuszait tartalmazni. Az itteni státuszok SKOS-fogalmak; ahol egy schema.org-típus megfelel egynek, a megfeleltetési halmaz összeköti őket."@hu .

mbr:ReciprocityAgreement a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "Reciprocity Agreement"@en , "Ömsesidighetsavtal"@sv , "Accord de réciprocité"@fr , "Gegenseitigkeitsabkommen"@de , "Accordo di reciprocità"@it , "Acuerdo de reciprocidad"@es , "Acordo de reciprocidade"@pt , "Viszonossági megállapodás"@hu ;
    skos:definition "An agreement under which members of each party may use the other party's premises or attend its gatherings. The qualified form of mbr:reciprocalWith."@en ,
                    "Ett avtal enligt vilket medlemmar i vardera parten får använda den andra partens lokaler eller delta i dess sammankomster. Kvalificerad form av mbr:reciprocalWith."@sv ,
                    "Accord en vertu duquel les membres de chaque partie peuvent utiliser les locaux de l'autre ou assister à ses réunions. La forme qualifiée de mbr:reciprocalWith."@fr ,
                    "Ein Abkommen, nach dem die Mitglieder jeder Vertragspartei die Räumlichkeiten der anderen nutzen oder deren Zusammenkünfte besuchen dürfen. Die qualifizierte Form von mbr:reciprocalWith."@de ,
                    "Un accordo in base al quale i soci di ciascuna parte possono usare i locali dell'altra o partecipare ai suoi incontri. La forma qualificata di mbr:reciprocalWith."@it ,
                    "Un acuerdo por el cual los miembros de cada parte pueden usar los locales de la otra o asistir a sus reuniones. La forma cualificada de mbr:reciprocalWith."@es ,
                    "Um acordo pelo qual os membros de cada parte podem usar as instalações da outra ou assistir às suas reuniões. A forma qualificada de mbr:reciprocalWith."@pt ,
                    "Megállapodás, amely szerint mindegyik fél tagjai használhatják a másik fél helyiségeit vagy részt vehetnek összejöveteleiken. Az mbr:reciprocalWith minősített formája."@hu .

# Convenience classes defined by classification (pattern P2). A reasoner puts an
# organisation here when it is classified with exactly this concept.

# Individuals used in the definitions below (described in membership-codes.ttl).
mbrc:gentlemensClub a owl:NamedIndividual .
mbrc:ladiesClub a owl:NamedIndividual .
mbrc:studentNation a owl:NamedIndividual .

mbr:GentlemensClub a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( mbr:MembershipOrganization
                             [ a owl:Restriction ;
                               owl:onProperty org:classification ;
                               owl:hasValue mbrc:gentlemensClub ] )
    ] ;
    rdfs:label "Gentlemen's Club"@en , "Herrklubb"@sv , "Club pour hommes"@fr , "Herrenclub"@de , "Club per soli uomini"@it , "Club de caballeros"@es , "Clube de cavalheiros"@pt , "Úriklub"@hu ;
    skos:definition "A membership organisation classified as a gentlemen's club."@en ,
                    "En medlemsorganisation klassificerad som herrklubb."@sv ,
                    "Organisation de membres classée comme club pour hommes."@fr ,
                    "Eine Mitgliederorganisation, die als Herrenclub eingeordnet ist."@de ,
                    "Un'organizzazione associativa classificata come gentlemen's club."@it ,
                    "Una organización de miembros clasificada como club de caballeros."@es ,
                    "Uma organização de membros classificada como clube de cavalheiros."@pt ,
                    "Úriklubként besorolt tagsági szervezet."@hu .

mbr:LadiesClub a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( mbr:MembershipOrganization
                             [ a owl:Restriction ;
                               owl:onProperty org:classification ;
                               owl:hasValue mbrc:ladiesClub ] )
    ] ;
    rdfs:label "Ladies' Club"@en , "Damklubb"@sv , "Club pour femmes"@fr , "Damenclub"@de , "Club femminile"@it , "Club de señoras"@es , "Clube de senhoras"@pt , "Hölgyklub"@hu ;
    skos:definition "A membership organisation classified as a ladies' club."@en ,
                    "En medlemsorganisation klassificerad som damklubb."@sv ,
                    "Organisation de membres classée comme club pour femmes."@fr ,
                    "Eine Mitgliederorganisation, die als Damenclub eingeordnet ist."@de ,
                    "Un'organizzazione associativa classificata come club femminile."@it ,
                    "Una organización de miembros clasificada como club de señoras."@es ,
                    "Uma organização de membros classificada como clube de senhoras."@pt ,
                    "Hölgyklubként besorolt tagsági szervezet."@hu .

mbr:StudentNation a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( mbr:MembershipOrganization
                             [ a owl:Restriction ;
                               owl:onProperty org:classification ;
                               owl:hasValue mbrc:studentNation ] )
    ] ;
    rdfs:label "Student Nation"@en , "Studentnation"@sv , "Nation étudiante"@fr , "Studentennation"@de , "Nazione studentesca"@it , "Nación estudiantil"@es , "Nação estudantil"@pt , "Diáknemzet"@hu ;
    skos:definition "A membership organisation classified as a student nation."@en ,
                    "En medlemsorganisation klassificerad som studentnation."@sv ,
                    "Organisation de membres classée comme nation étudiante."@fr ,
                    "Eine Mitgliederorganisation, die als Studentennation eingeordnet ist."@de ,
                    "Un'organizzazione associativa classificata come nazione studentesca."@it ,
                    "Una organización de miembros clasificada como nación estudiantil."@es ,
                    "Uma organização de membros classificada como nação estudantil."@pt ,
                    "Diáknemzetként besorolt tagsági szervezet."@hu .

##############################################################################
# MEMBERSHIP
##############################################################################

mbr:Membership a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subClassOf org:Membership ;
    rdfs:label "Membership"@en , "Medlemskap"@sv , "Adhésion"@fr , "Mitgliedschaft"@de , "Appartenenza"@it , "Pertenencia"@es , "Filiação"@pt , "Tagság"@hu ;
    skos:definition "The qualified relationship between an agent (org:member) and a membership organisation (org:organization), carrying status, category, membership number, sponsors and dates. A person's path from prospect to full member is recorded as status changes on one Membership, not as changes of the person's type."@en ,
                    "Den kvalificerade relationen mellan en agent (org:member) och en medlemsorganisation (org:organization), med status, kategori, medlemsnummer, rekommendatörer och datum. En persons väg från påtänkt till fullvärdig medlem registreras som statusändringar på ett och samma medlemskap, inte som ändringar av personens typ."@sv ,
                    "La relation qualifiée entre un agent (org:member) et une organisation de membres (org:organization), portant statut, catégorie, numéro d'adhérent, parrains et dates. Le parcours d'une personne, de la candidature au plein statut de membre, est consigné comme des changements de statut d'une seule Adhésion et non comme des changements du type de la personne."@fr ,
                    "Die qualifizierte Beziehung zwischen einem Akteur (org:member) und einer Mitgliederorganisation (org:organization) mit Status, Kategorie, Mitgliedsnummer, Bürgen und Daten. Der Weg einer Person vom Interessenten zum Vollmitglied wird als Statusänderungen einer einzigen Mitgliedschaft festgehalten, nicht als Änderung des Typs der Person."@de ,
                    "La relazione qualificata tra un agente (org:member) e un'organizzazione associativa (org:organization), con stato, categoria, numero di socio, presentatori e date. Il percorso di una persona da aspirante a socio pieno si registra come cambiamenti di stato di una sola Membership, non come cambiamenti del tipo della persona."@it ,
                    "La relación cualificada entre un agente (org:member) y una organización de miembros (org:organization), con estado, categoría, número de socio, avalistas y fechas. El camino de una persona desde candidato hasta miembro de pleno derecho se registra como cambios de estado en una sola Pertenencia, no como cambios del tipo de la persona."@es ,
                    "A relação qualificada entre um agente (org:member) e uma organização de membros (org:organization), com estado, categoria, número de sócio, avalistas e datas. O percurso de uma pessoa desde candidato até membro de pleno direito regista-se como mudanças de estado numa só Filiação, não como mudanças do tipo da pessoa."@pt ,
                    "A minősített kapcsolat egy ágens (org:member) és egy tagsági szervezet (org:organization) között, amely az állapotot, a kategóriát, a tagsági számot, az ajánlókat és a dátumokat hordozza. Egy személy útja a jelöltből a teljes jogú taggá egyetlen Tagság állapotváltozásaiként kerül rögzítésre, nem a személy típusának változásaiként."@hu ;
    skos:scopeNote "Data about who belongs to a political party, a trade union, or an organisation with a religious or philosophical aim (which can include fraternal orders) is special-category personal data under Article 9 of the EU General Data Protection Regulation (GDPR). The organisation itself may keep a register of its members and former members (Art. 9(2)(d)), but may not disclose it outside the organisation without their consent. Anyone else needs another exception in Art. 9(2) to process such data, for example explicit consent, or that the person has made the membership public, as elected representatives do. GDPR does not apply to deceased persons."@en ,
                   "Uppgifter om vem som tillhör ett politiskt parti, en fackförening eller en organisation med religiöst eller filosofiskt syfte (vilket kan omfatta ordenssällskap) är känsliga personuppgifter enligt artikel 9 i EU:s dataskyddsförordning (GDPR). Organisationen själv får föra register över sina nuvarande och tidigare medlemmar (art. 9.2 d) men inte lämna ut det utanför organisationen utan deras samtycke. Andra behöver ett annat undantag i art. 9.2 för att behandla sådana uppgifter, t.ex. uttryckligt samtycke eller att personen själv har offentliggjort medlemskapet, som förtroendevalda gör. GDPR gäller inte avlidna personer."@sv ,
                   "Les données sur l'appartenance à un parti politique, à un syndicat ou à une organisation à but religieux ou philosophique (ce qui peut inclure des ordres fraternels) sont des données personnelles de catégorie particulière au sens de l'article 9 du règlement général de l'UE sur la protection des données (RGPD). L'organisation elle-même peut tenir un registre de ses membres actuels et anciens (art. 9, par. 2, point d), mais ne peut le communiquer hors de l'organisation sans leur consentement. Toute autre personne a besoin d'une autre exception de l'art. 9, par. 2, pour traiter ces données, par exemple le consentement explicite, ou le fait que la personne ait rendu son adhésion publique, comme le font les élus. Le RGPD ne s'applique pas aux personnes décédées."@fr ,
                   "Daten darüber, wer einer politischen Partei, einer Gewerkschaft oder einer Organisation mit religiöser oder weltanschaulicher Ausrichtung (dazu können Ordensgemeinschaften gehören) angehört, sind besondere Kategorien personenbezogener Daten nach Artikel 9 der Datenschutz-Grundverordnung (DSGVO). Die Organisation selbst darf ein Verzeichnis ihrer Mitglieder und ehemaligen Mitglieder führen (Art. 9 Abs. 2 Buchst. d), es aber ohne deren Einwilligung nicht außerhalb der Organisation offenlegen. Wer sonst solche Daten verarbeiten will, braucht eine andere Ausnahme nach Art. 9 Abs. 2, etwa eine ausdrückliche Einwilligung oder dass die Person die Mitgliedschaft öffentlich gemacht hat, wie es gewählte Vertreter tun. Die DSGVO gilt nicht für Verstorbene."@de ,
                   "I dati su chi appartiene a un partito politico, a un sindacato o a un'organizzazione con finalità religiose o filosofiche (tra cui possono rientrare gli ordini fraternali) sono dati personali di categoria particolare ai sensi dell'articolo 9 del Regolamento generale dell'UE sulla protezione dei dati (GDPR). L'organizzazione stessa può tenere un registro dei propri soci e dei soci passati (art. 9, par. 2, lett. d), ma non può comunicarlo all'esterno senza il loro consenso. Chiunque altro ha bisogno di un'altra eccezione dell'art. 9, par. 2 per trattare tali dati, per esempio il consenso esplicito, o che la persona abbia reso pubblica la propria appartenenza, come fanno i rappresentanti eletti. Il GDPR non si applica alle persone defunte."@it ,
                   "Los datos sobre quién pertenece a un partido político, a un sindicato o a una organización con fines religiosos o filosóficos (entre las que pueden incluirse las órdenes fraternales) son datos personales de categoría especial según el artículo 9 del Reglamento general de protección de datos de la UE (RGPD). La propia organización puede llevar un registro de sus miembros y antiguos miembros (art. 9.2.d), pero no puede divulgarlo fuera de la organización sin su consentimiento. Cualquier otra persona necesita otra excepción del art. 9.2 para tratar esos datos, por ejemplo el consentimiento explícito o que la persona haya hecho pública su pertenencia, como los representantes electos. El RGPD no se aplica a las personas fallecidas."@es ,
                   "Os dados sobre quem pertence a um partido político, a um sindicato ou a uma organização com fins religiosos ou filosóficos (entre as quais podem incluir-se as ordens fraternais) são dados pessoais de categoria especial nos termos do artigo 9.º do Regulamento Geral sobre a Proteção de Dados da UE (RGPD). A própria organização pode manter um registo dos seus membros e antigos membros (art. 9.º, n.º 2, alínea d)), mas não o pode divulgar fora da organização sem o seu consentimento. Qualquer outra pessoa precisa de outra exceção do art. 9.º, n.º 2, para tratar esses dados, por exemplo o consentimento explícito ou que a pessoa tenha tornado pública a sua filiação, como os representantes eleitos. O RGPD não se aplica a pessoas falecidas."@pt ,
                   "A politikai pártba, szakszervezetbe vagy vallási vagy filozófiai célú szervezetbe (amelybe a testvéri rendek is beletartozhatnak) tartozásra vonatkozó adatok az Európai Unió általános adatvédelmi rendeletének (GDPR) 9. cikke szerinti különleges kategóriájú személyes adatok. Maga a szervezet vezethet nyilvántartást tagjairól és volt tagjairól (9. cikk (2) bekezdés d) pont), de ezt a tagok hozzájárulása nélkül nem hozhatja nyilvánosságra a szervezeten kívül. Bárki másnak a 9. cikk (2) bekezdésének másik kivételére van szüksége az ilyen adatok kezeléséhez, például kifejezett hozzájárulásra, vagy arra, hogy az érintett nyilvánosságra hozta a tagságát, ahogy a megválasztott képviselők teszik. A GDPR nem vonatkozik az elhunyt személyekre."@hu .

mbr:MembershipApplication a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "Membership Application"@en , "Medlemsansökan"@sv , "Demande d'adhésion"@fr , "Mitgliedschaftsantrag"@de , "Domanda di ammissione"@it , "Solicitud de ingreso"@es , "Pedido de admissão"@pt , "Felvételi kérelem"@hu ;
    skos:definition "A request to be admitted to a membership organisation, with its decision. It exists before there is a membership and may never lead to one. The applicant is given with mbr:applicant, the organisation with mbr:appliedTo, where it stands with mbr:applicationStatus, and an accepted application points to the membership it led to with mbr:resultingMembership. Proposers and seconders are given with mbr:proposer and mbr:seconder, the date of the application with mbr:startDate and the date of the decision with mbr:decisionDate."@en ,
                    "En begäran om att tas upp i en medlemsorganisation, med beslutet om den. Den finns innan det finns något medlemskap och behöver aldrig leda till ett. Den sökande anges med mbr:applicant, organisationen med mbr:appliedTo, hur långt den har kommit med mbr:applicationStatus, och en antagen ansökan pekar på det medlemskap den ledde till med mbr:resultingMembership. Förslagsställare och understödjare anges med mbr:proposer och mbr:seconder, ansökans datum med mbr:startDate och beslutets datum med mbr:decisionDate."@sv ,
                    "Une demande d'être admis dans une organisation de membres, avec la décision qui la concerne. Elle existe avant qu'il y ait une adhésion et peut ne jamais en produire. Le candidat est indiqué avec mbr:applicant, l'organisation avec mbr:appliedTo, l'état d'avancement avec mbr:applicationStatus, et une demande acceptée renvoie à l'adhésion qui en est issue avec mbr:resultingMembership. Les proposants et les seconds se donnent avec mbr:proposer et mbr:seconder, la date de la demande avec mbr:startDate et celle de la décision avec mbr:decisionDate."@fr ,
                    "Ein Antrag, in eine Mitgliederorganisation aufgenommen zu werden, samt der Entscheidung darüber. Er besteht, bevor es eine Mitgliedschaft gibt, und muss nie zu einer führen. Der Antragsteller wird mit mbr:applicant angegeben, die Organisation mit mbr:appliedTo, der Stand mit mbr:applicationStatus, und ein angenommener Antrag verweist mit mbr:resultingMembership auf die Mitgliedschaft, zu der er geführt hat. Vorschlagende und Unterstützer werden mit mbr:proposer und mbr:seconder angegeben, das Datum des Antrags mit mbr:startDate und das Datum der Entscheidung mit mbr:decisionDate."@de ,
                    "Una richiesta di essere ammessi in un'organizzazione associativa, con la relativa decisione. Esiste prima che ci sia un'appartenenza e può non portarne mai a una. Il richiedente si indica con mbr:applicant, l'organizzazione con mbr:appliedTo, lo stato di avanzamento con mbr:applicationStatus, e una domanda accolta rinvia all'appartenenza a cui ha portato con mbr:resultingMembership. Proponenti e secondi proponenti si indicano con mbr:proposer e mbr:seconder, la data della domanda con mbr:startDate e quella della decisione con mbr:decisionDate."@it ,
                    "Una petición de ser admitido en una organización de miembros, con su decisión. Existe antes de que haya una pertenencia y puede no llegar a producir ninguna. El solicitante se indica con mbr:applicant, la organización con mbr:appliedTo, el estado en que se encuentra con mbr:applicationStatus, y una solicitud aceptada remite a la pertenencia a la que condujo con mbr:resultingMembership. Los proponentes y quienes los secundan se indican con mbr:proposer y mbr:seconder, la fecha de la solicitud con mbr:startDate y la fecha de la decisión con mbr:decisionDate."@es ,
                    "Um pedido para ser admitido numa organização de membros, com a sua decisão. Existe antes de haver uma filiação e pode nunca conduzir a nenhuma. O requerente indica-se com mbr:applicant, a organização com mbr:appliedTo, o ponto em que se encontra com mbr:applicationStatus, e um pedido aceite remete para a filiação a que conduziu com mbr:resultingMembership. Os proponentes e quem os secunda indicam-se com mbr:proposer e mbr:seconder, a data do pedido com mbr:startDate e a data da decisão com mbr:decisionDate."@pt ,
                    "Kérelem egy tagsági szervezetbe való felvételre, döntésével együtt. Létezik, mielőtt tagság lenne, és előfordulhat, hogy soha nem vezet tagsághoz. A kérelmezőt az mbr:applicant adja meg, a szervezetet az mbr:appliedTo, azt, hogy hol tart, az mbr:applicationStatus, az elfogadott kérelem pedig az mbr:resultingMembership segítségével arra a tagságra utal, amelyhez vezetett. A javaslattevőket és támogatóikat az mbr:proposer és az mbr:seconder adja meg, a kérelem dátumát az mbr:startDate, a döntés dátumát az mbr:decisionDate."@hu ;
    skos:scopeNote "Not an org:Membership: org:member has that class as its domain, so an application has mbr:applicant and never org:member. A membership with the status mbrc:proposed or mbrc:candidate, and its events (mbrc:MembershipEventTypes), is the lighter way to record a candidacy. Use an application when the request itself, its decision or its ballot is to be recorded."@en ,
                   "Inte ett org:Membership: org:member har den klassen som domän, så en ansökan har mbr:applicant och aldrig org:member. Ett medlemskap med statusen mbrc:proposed eller mbrc:candidate, och dess händelser (mbrc:MembershipEventTypes), är det enklare sättet att registrera en kandidatur. Använd en ansökan när själva begäran, beslutet eller omröstningen ska registreras."@sv ,
                   "Ce n'est pas un org:Membership : org:member a cette classe pour domaine, une demande a donc mbr:applicant et jamais org:member. Une adhésion avec le statut mbrc:proposed ou mbrc:candidate, et ses événements (mbrc:MembershipEventTypes), est la manière plus légère de consigner une candidature. Utilisez une demande lorsque la requête elle-même, sa décision ou son scrutin doit être consigné."@fr ,
                   "Kein org:Membership: org:member hat diese Klasse als Definitionsbereich, ein Antrag hat daher mbr:applicant und nie org:member. Eine Mitgliedschaft mit dem Status mbrc:proposed oder mbrc:candidate samt ihren Ereignissen (mbrc:MembershipEventTypes) ist die leichtere Art, eine Kandidatur festzuhalten. Ein Antrag wird verwendet, wenn der Antrag selbst, seine Entscheidung oder seine Abstimmung festgehalten werden soll."@de ,
                   "Non è un org:Membership: org:member ha quella classe come dominio, quindi una domanda ha mbr:applicant e mai org:member. Un'appartenenza con lo stato mbrc:proposed o mbrc:candidate, e i suoi eventi (mbrc:MembershipEventTypes), è il modo più leggero di registrare una candidatura. Si usa una domanda quando va registrata la richiesta stessa, la sua decisione o la sua votazione."@it ,
                   "No es un org:Membership: org:member tiene esa clase como dominio, así que una solicitud tiene mbr:applicant y nunca org:member. Una pertenencia con el estado mbrc:proposed o mbrc:candidate, y sus eventos (mbrc:MembershipEventTypes), es la manera más ligera de registrar una candidatura. Se usa una solicitud cuando hay que registrar la petición misma, su decisión o su votación."@es ,
                   "Não é um org:Membership: org:member tem essa classe como domínio, pelo que um pedido tem mbr:applicant e nunca org:member. Uma filiação com o estado mbrc:proposed ou mbrc:candidate, e os seus eventos (mbrc:MembershipEventTypes), é a forma mais leve de registar uma candidatura. Usa-se um pedido quando é preciso registar o próprio pedido, a sua decisão ou a sua votação."@pt ,
                   "Nem org:Membership: az org:member értelmezési tartománya ez az osztály, ezért a kérelemnek mbr:applicant van, és soha nem org:member. Az mbrc:proposed vagy mbrc:candidate állapotú tagság és eseményei (mbrc:MembershipEventTypes) a könnyebb módja egy jelölés rögzítésének. Kérelmet akkor használjunk, ha magát a kérelmet, a döntését vagy a szavazását kell rögzíteni."@hu .

mbr:Ballot a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "Ballot"@en , "Ballotering"@sv , "Scrutin"@fr , "Abstimmung"@de , "Votazione"@it , "Votación"@es , "Votação"@pt , "Szavazás"@hu ;
    skos:definition "A vote by the members on an application (mbr:ballotOn), with the number of votes for and against (mbr:votesFor, mbr:votesAgainst) and its date (mbr:startDate). An application can have more than one ballot, for example when it is put to the vote again."@en ,
                    "En omröstning bland medlemmarna om en ansökan (mbr:ballotOn), med antalet röster för och emot (mbr:votesFor, mbr:votesAgainst) och dess datum (mbr:startDate). En ansökan kan ha fler än en ballotering, till exempel när den tas upp till omröstning på nytt."@sv ,
                    "Un vote des membres sur une demande (mbr:ballotOn), avec le nombre de voix pour et contre (mbr:votesFor, mbr:votesAgainst) et sa date (mbr:startDate). Une demande peut avoir plusieurs scrutins, par exemple quand elle est de nouveau mise aux voix."@fr ,
                    "Eine Abstimmung der Mitglieder über einen Antrag (mbr:ballotOn), mit der Zahl der Stimmen dafür und dagegen (mbr:votesFor, mbr:votesAgainst) und ihrem Datum (mbr:startDate). Ein Antrag kann mehr als eine Abstimmung haben, etwa wenn er erneut zur Abstimmung gestellt wird."@de ,
                    "Una votazione dei soci su una domanda (mbr:ballotOn), con il numero di voti favorevoli e contrari (mbr:votesFor, mbr:votesAgainst) e la sua data (mbr:startDate). Una domanda può avere più di una votazione, per esempio quando viene rimessa ai voti."@it ,
                    "Una votación de los miembros sobre una solicitud (mbr:ballotOn), con el número de votos a favor y en contra (mbr:votesFor, mbr:votesAgainst) y su fecha (mbr:startDate). Una solicitud puede tener más de una votación, por ejemplo cuando se vuelve a someter a voto."@es ,
                    "Uma votação dos membros sobre um pedido (mbr:ballotOn), com o número de votos a favor e contra (mbr:votesFor, mbr:votesAgainst) e a sua data (mbr:startDate). Um pedido pode ter mais de uma votação, por exemplo quando é de novo posto a votos."@pt ,
                    "A tagok szavazása egy kérelemről (mbr:ballotOn), az igen és nem szavazatok számával (mbr:votesFor, mbr:votesAgainst) és a dátumával (mbr:startDate). Egy kérelemről több szavazás is lehet, például ha újra szavazásra bocsátják."@hu ;
    skos:scopeNote "The rule that decides the vote, for example that a single black ball rejects or that two thirds must vote for, is the organisation's own and is not recorded here. The outcome is given by mbr:applicationStatus on the application."@en ,
                   "Regeln som avgör omröstningen, till exempel att en enda svartkula avslår eller att två tredjedelar måste rösta för, är organisationens egen och registreras inte här. Utfallet anges med mbr:applicationStatus på ansökan."@sv ,
                   "La règle qui décide du vote, par exemple qu'une seule boule noire rejette ou que deux tiers doivent voter pour, est propre à l'organisation et n'est pas consignée ici. Le résultat est indiqué par mbr:applicationStatus sur la demande."@fr ,
                   "Die Regel, die über die Abstimmung entscheidet, etwa dass eine einzige schwarze Kugel ablehnt oder zwei Drittel dafür stimmen müssen, ist die der Organisation selbst und wird hier nicht festgehalten. Das Ergebnis wird mit mbr:applicationStatus am Antrag angegeben."@de ,
                   "La regola che decide la votazione, per esempio che una sola pallina nera respinga o che servano due terzi di voti favorevoli, è propria dell'organizzazione e non si registra qui. L'esito si indica con mbr:applicationStatus sulla domanda."@it ,
                   "La regla que decide la votación, por ejemplo que una sola bola negra rechaza o que se necesitan dos tercios a favor, es propia de la organización y no se registra aquí. El resultado se indica con mbr:applicationStatus en la solicitud."@es ,
                   "A regra que decide a votação, por exemplo que uma única bola preta rejeita ou que são precisos dois terços a favor, é própria da organização e não se regista aqui. O resultado indica-se com mbr:applicationStatus no pedido."@pt ,
                   "A szabály, amely a szavazásról dönt, például hogy egyetlen fekete golyó elutasít, vagy hogy kétharmad kell az igenhez, a szervezet saját dolga, és itt nem kerül rögzítésre. Az eredményt az mbr:applicationStatus adja meg a kérelmen."@hu .

mbr:MembershipEvent a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Membership Event"@en , "Medlemskapshändelse"@sv , "Événement d'adhésion"@fr , "Mitgliedschaftsereignis"@de , "Evento di appartenenza"@it , "Evento de pertenencia"@es , "Evento de filiação"@pt , "Tagsági esemény"@hu ;
    skos:definition "An event in the life of a membership, such as proposal, ballot, admission, resignation or expulsion. The kind of event is given with mbr:membershipEventType."@en ,
                    "En händelse i ett medlemskaps livscykel, t.ex. förslag, ballotering, inval, utträde eller uteslutning. Händelsetypen anges med mbr:membershipEventType."@sv ,
                    "Événement de la vie d'une adhésion, comme la proposition, le scrutin, l'admission, la démission ou l'exclusion. Le genre d'événement est indiqué avec mbr:membershipEventType."@fr ,
                    "Ein Ereignis im Leben einer Mitgliedschaft, etwa Vorschlag, Abstimmung, Aufnahme, Austritt oder Ausschluss. Die Art des Ereignisses wird mit mbr:membershipEventType angegeben."@de ,
                    "Un evento nella vita di un'appartenenza, come la proposta, la votazione, l'ammissione, le dimissioni o l'espulsione. Il tipo di evento si indica con mbr:membershipEventType."@it ,
                    "Un evento en la vida de una pertenencia, como la propuesta, la votación, la admisión, la baja voluntaria o la expulsión. El tipo de evento se indica con mbr:membershipEventType."@es ,
                    "Um evento na vida de uma filiação, como a proposta, a votação, a admissão, a demissão ou a expulsão. O tipo de evento indica-se com mbr:membershipEventType."@pt ,
                    "Esemény egy tagság életében, mint a javaslat, a szavazás, a felvétel, a kilépés vagy a kizárás. Az esemény fajtáját az mbr:membershipEventType adja meg."@hu .

mbr:membershipStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "membership status"@en , "medlemskapsstatus"@sv , "statut d'adhésion"@fr , "Mitgliedschaftsstatus"@de , "stato dell'appartenenza"@it , "estado de la pertenencia"@es , "estado da filiação"@pt , "tagság állapota"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "The current status of a membership (see mbrc:MembershipStatuses)."@en ,
                    "Ett medlemskaps aktuella status (se mbrc:MembershipStatuses)."@sv ,
                    "Le statut actuel d'une adhésion (voir mbrc:MembershipStatuses)."@fr ,
                    "Der aktuelle Status einer Mitgliedschaft (siehe mbrc:MembershipStatuses)."@de ,
                    "Lo stato attuale di un'appartenenza (vedi mbrc:MembershipStatuses)."@it ,
                    "El estado actual de una pertenencia (véase mbrc:MembershipStatuses)."@es ,
                    "O estado atual de uma filiação (ver mbrc:MembershipStatuses)."@pt ,
                    "A tagság jelenlegi állapota (lásd mbrc:MembershipStatuses)."@hu .

mbr:membershipCategory a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "membership category"@en , "medlemskategori"@sv , "catégorie d'adhésion"@fr , "Mitgliedschaftskategorie"@de , "categoria di appartenenza"@it , "categoría de pertenencia"@es , "categoria de filiação"@pt , "tagsági kategória"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "A category of a membership, such as ordinary, life or honorary (see mbrc:MembershipCategories). A membership may have several, for example life and founding."@en ,
                    "En kategori som ett medlemskap tillhör, t.ex. ordinarie, ständigt eller heders- (se mbrc:MembershipCategories). Ett medlemskap kan ha flera, till exempel ständigt och stiftande."@sv ,
                    "Une catégorie d'une adhésion, comme ordinaire, à vie ou d'honneur (voir mbrc:MembershipCategories). Une adhésion peut en avoir plusieurs, par exemple à vie et fondateur."@fr ,
                    "Eine Kategorie einer Mitgliedschaft, etwa ordentlich, lebenslang oder ehrenhalber (siehe mbrc:MembershipCategories). Eine Mitgliedschaft kann mehrere haben, zum Beispiel lebenslang und Gründung."@de ,
                    "Una categoria di un'appartenenza, come ordinario, a vita o onorario (vedi mbrc:MembershipCategories). Un'appartenenza può averne diverse, per esempio a vita e fondatore."@it ,
                    "Una categoría de una pertenencia, como ordinaria, vitalicia u honoraria (véase mbrc:MembershipCategories). Una pertenencia puede tener varias, por ejemplo vitalicia y fundadora."@es ,
                    "Uma categoria de uma filiação, como ordinária, vitalícia ou honorária (ver mbrc:MembershipCategories). Uma filiação pode ter várias, por exemplo vitalícia e fundadora."@pt ,
                    "Egy tagság kategóriája, például rendes, élethossziglani vagy tiszteleti (lásd mbrc:MembershipCategories). Egy tagságnak több is lehet, például élethossziglani és alapító."@hu ;
    skos:scopeNote "The categories are properties that can be combined, not an exhaustive division: they are grouped by what they say (rights, duration, honour, age, residence, affiliation, founding), and a membership with no category is not thereby ordinary. No combination is ruled out unless a category's definition says so. Changes to the set are recorded with mbr:resultingCategory on membership events."@en ,
                   "Kategorierna är egenskaper som kan kombineras, inte en uttömmande indelning: de är grupperade efter vad de anger (rättigheter, varaktighet, hedersställning, ålder, bosättning, anknytning, grundande), och ett medlemskap utan kategori är inte därmed ordinarie. Ingen kombination är utesluten om inte en kategoris definition säger det. Ändringar av uppsättningen anges med mbr:resultingCategory på medlemskapshändelser."@sv ,
                   "Les catégories sont des propriétés combinables, non une répartition exhaustive : elles sont regroupées selon ce qu'elles disent (droits, durée, honneur, âge, résidence, rattachement, fondation), et une adhésion sans catégorie n'est pas pour autant ordinaire. Aucune combinaison n'est exclue, sauf si la définition d'une catégorie le dit. Les changements de l'ensemble sont enregistrés avec mbr:resultingCategory sur les événements d'adhésion."@fr ,
                   "Die Kategorien sind Eigenschaften, die sich kombinieren lassen, keine erschöpfende Einteilung: Sie sind danach gruppiert, was sie aussagen (Rechte, Dauer, Ehrung, Alter, Wohnsitz, Zugehörigkeit, Gründung), und eine Mitgliedschaft ohne Kategorie ist dadurch nicht gewöhnlich. Keine Kombination ist ausgeschlossen, es sei denn, die Definition einer Kategorie sagt es. Änderungen der Menge werden mit mbr:resultingCategory an Mitgliedschaftsereignissen festgehalten."@de ,
                   "Le categorie sono proprietà che si possono combinare, non una ripartizione esaustiva: sono raggruppate per ciò che dicono (diritti, durata, onore, età, residenza, affiliazione, fondazione), e un'appartenenza senza categoria non è per questo ordinaria. Nessuna combinazione è esclusa, a meno che la definizione di una categoria non lo dica. I cambiamenti dell'insieme si registrano con mbr:resultingCategory sugli eventi di appartenenza."@it ,
                   "Las categorías son propiedades que pueden combinarse, no una división exhaustiva: se agrupan por lo que dicen (derechos, duración, honor, edad, residencia, afiliación, fundación), y una pertenencia sin categoría no es por ello ordinaria. No se excluye ninguna combinación salvo que lo diga la definición de una categoría. Los cambios del conjunto se registran con mbr:resultingCategory en los eventos de pertenencia."@es ,
                   "As categorias são propriedades que se podem combinar, não uma divisão exaustiva: agrupam-se pelo que dizem (direitos, duração, honra, idade, residência, afiliação, fundação), e uma filiação sem categoria não é por isso ordinária. Nenhuma combinação é excluída, a não ser que a definição de uma categoria o diga. As alterações ao conjunto registam-se com mbr:resultingCategory nos eventos de filiação."@pt ,
                   "A kategóriák kombinálható tulajdonságok, nem kimerítő felosztás: aszerint csoportosítottak, amit mondanak (jogok, időtartam, megtiszteltetés, életkor, lakóhely, kapcsolat, alapítás), és a kategória nélküli tagság emiatt még nem rendes. Semmilyen kombináció nincs kizárva, hacsak egy kategória meghatározása nem mondja. A halmaz változásait az mbr:resultingCategory rögzíti a tagsági eseményeken."@hu .

mbr:membershipNumber a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subPropertyOf schema:membershipNumber ;
    rdfs:label "membership number"@en , "medlemsnummer"@sv , "numéro d'adhérent"@fr , "Mitgliedsnummer"@de , "numero di socio"@it , "número de socio"@es , "número de sócio"@pt , "tagsági szám"@hu ;
    rdfs:range xsd:string ;
    skos:definition "The number under which a membership is recorded in the organisation's register, written as an xsd:string because registers use numbers such as L-0042 and 0042. A number identifies one membership in one organisation at a time; a later membership may reuse it when the periods certainly do not overlap (checked in SHACL)."@en ,
                    "Det nummer under vilket ett medlemskap förs i organisationens matrikel, skrivet som xsd:string eftersom matriklar har nummer som L-0042 och 0042. Ett nummer identifierar ett medlemskap i en organisation åt gången; ett senare medlemskap får återanvända det när perioderna säkert inte överlappar (kontrolleras i SHACL)."@sv ,
                    "Le numéro sous lequel une adhésion est inscrite au registre de l'organisation, écrit en xsd:string parce que les registres utilisent des numéros comme L-0042 et 0042. Un numéro identifie une adhésion dans une organisation à la fois ; une adhésion ultérieure peut le réutiliser lorsque les périodes ne se chevauchent certainement pas (vérifié en SHACL)."@fr ,
                    "Die Nummer, unter der eine Mitgliedschaft im Register der Organisation geführt wird, als xsd:string geschrieben, weil Register Nummern wie L-0042 und 0042 verwenden. Eine Nummer kennzeichnet zu einer Zeit eine Mitgliedschaft in einer Organisation; eine spätere Mitgliedschaft darf sie wiederverwenden, wenn sich die Zeiträume sicher nicht überschneiden (in SHACL geprüft)."@de ,
                    "Il numero con cui un'appartenenza è registrata nel libro soci dell'organizzazione, scritto come xsd:string perché i registri usano numeri come L-0042 e 0042. Un numero identifica una sola appartenenza in una sola organizzazione per volta; un'appartenenza successiva può riusarlo quando i periodi certamente non si sovrappongono (controllato in SHACL)."@it ,
                    "El número con que se registra una pertenencia en el registro de la organización, escrito como xsd:string porque los registros usan números como L-0042 y 0042. Un número identifica una sola pertenencia en una sola organización a la vez; una pertenencia posterior puede reutilizarlo cuando los períodos con certeza no se solapan (se comprueba en SHACL)."@es ,
                    "O número com que se regista uma filiação no registo da organização, escrito como xsd:string porque os registos usam números como L-0042 e 0042. Um número identifica uma só filiação numa só organização de cada vez; uma filiação posterior pode reutilizá-lo quando os períodos com certeza não se sobrepõem (verifica-se em SHACL)."@pt ,
                    "A szám, amelyen a tagságot a szervezet nyilvántartásában rögzítik, xsd:string-ként írva, mert a nyilvántartások olyan számokat használnak, mint az L-0042 és a 0042. Egy szám egy időben egy szervezetben egy tagságot azonosít; egy későbbi tagság újra felhasználhatja, ha az időszakok bizonyosan nem fedik egymást (SHACL-ban ellenőrzött)."@hu .

mbr:sponsor a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "sponsor"@en , "rekommendatör"@sv , "parrain"@fr , "Bürge"@de , "garante"@it , "avalista"@es , "avalista"@pt , "ajánló"@hu ;
    rdfs:range foaf:Agent ;
    skos:definition "An agent who sponsored the admission of the member."@en ,
                    "En agent som rekommenderade medlemmens upptagning."@sv ,
                    "Agent qui a parrainé l'admission du membre."@fr ,
                    "Ein Akteur, der für die Aufnahme des Mitglieds gebürgt hat."@de ,
                    "Un agente che ha sostenuto l'ammissione del socio."@it ,
                    "Un agente que avaló la admisión del miembro."@es ,
                    "Um agente que avalizou a admissão do membro."@pt ,
                    "Ágens, aki kezeskedett a tag felvételéért."@hu .

mbr:proposer a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subPropertyOf mbr:sponsor ;
    rdfs:label "proposer"@en , "förslagsställare"@sv , "proposant"@fr , "Vorschlagender"@de , "proponente"@it , "proponente"@es , "proponente"@pt , "javaslattevő"@hu ;
    skos:definition "The member who formally proposed the candidate."@en ,
                    "Den medlem som formellt föreslog kandidaten."@sv ,
                    "Le membre qui a formellement proposé le candidat."@fr ,
                    "Das Mitglied, das den Kandidaten förmlich vorgeschlagen hat."@de ,
                    "Il socio che ha proposto formalmente il candidato."@it ,
                    "El miembro que propuso formalmente al candidato."@es ,
                    "O membro que propôs formalmente o candidato."@pt ,
                    "A tag, aki hivatalosan javasolta a jelöltet."@hu .

mbr:seconder a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subPropertyOf mbr:sponsor ;
    rdfs:label "seconder"@en , "understödjare"@sv , "second"@fr , "Unterstützer"@de , "secondo proponente"@it , "secundante"@es , "secundante"@pt , "támogató"@hu ;
    skos:definition "A member who seconded the proposal."@en ,
                    "En medlem som understödde förslaget."@sv ,
                    "Membre qui a appuyé la proposition."@fr ,
                    "Ein Mitglied, das den Vorschlag unterstützt hat."@de ,
                    "Un socio che ha appoggiato la proposta."@it ,
                    "Un miembro que secundó la propuesta."@es ,
                    "Um membro que secundou a proposta."@pt ,
                    "Tag, aki támogatta a javaslatot."@hu .

mbr:mentor a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "mentor"@en , "fadder"@sv , "mentor"@fr , "Mentor"@de , "mentore"@it , "mentor"@es , "mentor"@pt , "mentor"@hu ;
    rdfs:range foaf:Agent ;
    skos:definition "An agent who personally guides and looks after the holder of the membership in the organisation, usually a more senior member: the Leibbursch of a Studentenverbindung, the big sister of a sorority, the fadder of a student nation. The relation goes on after the admission."@en ,
                    "En agent som personligen vägleder och tar hand om medlemskapets innehavare i organisationen, vanligen en mer erfaren medlem: en Studentenverbindungs Leibbursch, en sororitys \"big sister\", en studentnations fadder. Relationen fortsätter efter upptagningen."@sv ,
                    "Agent qui guide et prend personnellement en charge le titulaire de l'adhésion dans l'organisation, en général un membre plus ancien : le Leibbursch d'une Studentenverbindung, la « big sister » d'une sororité, le fadder d'une nation étudiante. La relation se poursuit après l'admission."@fr ,
                    "Ein Akteur, der den Inhaber der Mitgliedschaft in der Organisation persönlich anleitet und betreut, meist ein älteres Mitglied: der Leibbursch einer Studentenverbindung, die „Big Sister“ einer Sorority, der Fadder einer Studentennation. Die Beziehung besteht über die Aufnahme hinaus."@de ,
                    "Un agente che guida e segue personalmente il titolare dell'appartenenza nell'organizzazione, di solito un socio più anziano: il Leibbursch di una Studentenverbindung, la «big sister» di una sorority, il fadder di una nazione studentesca. La relazione prosegue dopo l'ammissione."@it ,
                    "Un agente que guía y cuida personalmente al titular de la pertenencia en la organización, normalmente un miembro de más antigüedad: el Leibbursch de una Studentenverbindung, la hermana mayor de una sororidad, el fadder de una nación estudiantil. La relación continúa después de la admisión."@es ,
                    "Um agente que orienta e acompanha pessoalmente o titular da filiação na organização, normalmente um membro mais antigo: o Leibbursch de uma Studentenverbindung, a irmã mais velha de uma sororidade, o fadder de uma nação estudantil. A relação continua depois da admissão."@pt ,
                    "Ágens, aki személyesen kalauzolja és gondozza a tagság birtokosát a szervezetben, rendszerint egy régebbi tag: egy Studentenverbindung Leibbursch-a, egy női egylet idősebb testvére, egy diáknemzet fadder-e. A kapcsolat a felvétel után is tart."@hu ;
    skos:scopeNote "Not mbr:sponsor, who vouches for the candidate at the admission. The Relationship vocabulary has rel:mentorOf, which links two persons without any organisation or time; this property is on the membership, so the relation belongs to one organisation and one period."@en ,
                   "Inte mbr:sponsor, som går i god för kandidaten vid upptagningen. Relationship-vokabulären har rel:mentorOf, som länkar två personer utan organisation eller tid; den här egenskapen sitter på medlemskapet, så relationen hör till en organisation och en period."@sv ,
                   "Ce n'est pas mbr:sponsor, qui se porte garant du candidat lors de l'admission. Le vocabulaire Relationship a rel:mentorOf, qui relie deux personnes sans organisation ni durée ; cette propriété est portée par l'adhésion, la relation appartient donc à une organisation et à une période."@fr ,
                   "Nicht mbr:sponsor, der bei der Aufnahme für den Kandidaten bürgt. Das Vokabular Relationship hat rel:mentorOf, das zwei Personen ohne Organisation und Zeit verbindet; diese Eigenschaft hängt an der Mitgliedschaft, die Beziehung gehört also zu einer Organisation und einer Periode."@de ,
                   "Non mbr:sponsor, che garantisce per il candidato all'ammissione. Il vocabolario Relationship ha rel:mentorOf, che collega due persone senza organizzazione né tempo; questa proprietà è sull'appartenenza, quindi la relazione appartiene a un'organizzazione e a un periodo."@it ,
                   "No es mbr:sponsor, que avala al candidato en la admisión. El vocabulario Relationship tiene rel:mentorOf, que vincula a dos personas sin organización ni tiempo; esta propiedad está en la pertenencia, de modo que la relación corresponde a una organización y a un período."@es ,
                   "Não é mbr:sponsor, que avaliza o candidato na admissão. O vocabulário Relationship tem rel:mentorOf, que liga duas pessoas sem organização nem tempo; esta propriedade está na filiação, pelo que a relação pertence a uma organização e a um período."@pt ,
                   "Nem az mbr:sponsor, aki a felvételkor kezeskedik a jelöltért. A Relationship szókincsben van rel:mentorOf, amely két személyt köt össze szervezet és idő nélkül; ez a tulajdonság a tagságon van, ezért a kapcsolat egy szervezethez és egy időszakhoz tartozik."@hu .

mbr:applicant a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "applicant"@en , "sökande"@sv , "candidat"@fr , "Antragsteller"@de , "richiedente"@it , "solicitante"@es , "requerente"@pt , "kérelmező"@hu ;
    rdfs:domain mbr:MembershipApplication ;
    rdfs:range foaf:Agent ;
    skos:definition "The person or other agent that applies for membership."@en ,
                    "Den person eller annan agent som ansöker om medlemskap."@sv ,
                    "La personne ou autre agent qui demande l'adhésion."@fr ,
                    "Die Person oder der andere Akteur, die oder der die Mitgliedschaft beantragt."@de ,
                    "La persona o altro agente che chiede l'ammissione."@it ,
                    "La persona u otro agente que solicita la pertenencia."@es ,
                    "A pessoa ou outro agente que pede a filiação."@pt ,
                    "A személy vagy más ágens, aki a tagságot kéri."@hu .

mbr:appliedTo a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "applied to"@en , "sökt medlemskap i"@sv , "adhésion demandée à"@fr , "beantragt bei"@de , "richiesta a"@it , "solicitud dirigida a"@es , "pedido dirigido a"@pt , "kérelem címzettje"@hu ;
    rdfs:domain mbr:MembershipApplication ;
    rdfs:range mbr:MembershipOrganization ;
    skos:definition "The membership organisation that an application is addressed to."@en ,
                    "Den medlemsorganisation som en ansökan riktas till."@sv ,
                    "L'organisation de membres à laquelle une demande est adressée."@fr ,
                    "Die Mitgliederorganisation, an die ein Antrag gerichtet ist."@de ,
                    "L'organizzazione associativa a cui è rivolta una domanda."@it ,
                    "La organización de miembros a la que se dirige una solicitud."@es ,
                    "A organização de membros a que se dirige um pedido."@pt ,
                    "A tagsági szervezet, amelyhez a kérelem szól."@hu .

mbr:applicationStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "application status"@en , "ansökningsstatus"@sv , "statut de la demande"@fr , "Antragsstatus"@de , "stato della domanda"@it , "estado de la solicitud"@es , "estado do pedido"@pt , "kérelem állapota"@hu ;
    rdfs:domain mbr:MembershipApplication ;
    rdfs:range skos:Concept ;
    skos:definition "Where an application stands (see mbrc:ApplicationStatuses)."@en ,
                    "Hur långt en ansökan har kommit (se mbrc:ApplicationStatuses)."@sv ,
                    "L'état d'avancement d'une demande (voir mbrc:ApplicationStatuses)."@fr ,
                    "Der Stand eines Antrags (siehe mbrc:ApplicationStatuses)."@de ,
                    "A che punto è una domanda (vedi mbrc:ApplicationStatuses)."@it ,
                    "En qué punto se encuentra una solicitud (véase mbrc:ApplicationStatuses)."@es ,
                    "Em que ponto se encontra um pedido (ver mbrc:ApplicationStatuses)."@pt ,
                    "Hol tart a kérelem (lásd mbrc:ApplicationStatuses)."@hu .

mbr:resultingMembership a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "resulting membership"@en , "resulterande medlemskap"@sv , "adhésion résultante"@fr , "resultierende Mitgliedschaft"@de , "appartenenza risultante"@it , "pertenencia resultante"@es , "filiação resultante"@pt , "eredményezett tagság"@hu ;
    rdfs:domain mbr:MembershipApplication ;
    rdfs:range org:Membership ;
    skos:definition "The membership that an accepted application led to."@en ,
                    "Det medlemskap som en antagen ansökan ledde till."@sv ,
                    "L'adhésion à laquelle a abouti une demande acceptée."@fr ,
                    "Die Mitgliedschaft, zu der ein angenommener Antrag geführt hat."@de ,
                    "L'appartenenza a cui ha portato una domanda accolta."@it ,
                    "La pertenencia a la que condujo una solicitud aceptada."@es ,
                    "A filiação a que conduziu um pedido aceite."@pt ,
                    "A tagság, amelyhez az elfogadott kérelem vezetett."@hu .

mbr:ballotOn a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "ballot on"@en , "omröstning om"@sv , "scrutin sur"@fr , "Abstimmung über"@de , "votazione su"@it , "votación sobre"@es , "votação sobre"@pt , "szavazás tárgya"@hu ;
    rdfs:domain mbr:Ballot ;
    rdfs:range mbr:MembershipApplication ;
    skos:definition "The application that a ballot is held on."@en ,
                    "Den ansökan som en ballotering gäller."@sv ,
                    "La demande sur laquelle porte un scrutin."@fr ,
                    "Der Antrag, über den eine Abstimmung stattfindet."@de ,
                    "La domanda su cui si tiene una votazione."@it ,
                    "La solicitud sobre la que se celebra una votación."@es ,
                    "O pedido sobre o qual se realiza uma votação."@pt ,
                    "A kérelem, amelyről a szavazást tartják."@hu .

mbr:votesFor a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "votes for"@en , "röster för"@sv , "voix pour"@fr , "Stimmen dafür"@de , "voti favorevoli"@it , "votos a favor"@es , "votos a favor"@pt , "igen szavazatok"@hu ;
    rdfs:domain mbr:Ballot ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The number of votes for the application in a ballot, as a non-negative integer."@en ,
                    "Antalet röster för ansökan i en ballotering, som ett icke-negativt heltal."@sv ,
                    "Le nombre de voix pour la demande dans un scrutin, sous forme d'entier non négatif."@fr ,
                    "Die Zahl der Stimmen für den Antrag in einer Abstimmung, als nichtnegative ganze Zahl."@de ,
                    "Il numero di voti favorevoli alla domanda in una votazione, come intero non negativo."@it ,
                    "El número de votos a favor de la solicitud en una votación, como entero no negativo."@es ,
                    "O número de votos a favor do pedido numa votação, como inteiro não negativo."@pt ,
                    "A kérelem mellett leadott szavazatok száma egy szavazáson, nemnegatív egész számként."@hu .

mbr:votesAgainst a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "votes against"@en , "röster emot"@sv , "voix contre"@fr , "Gegenstimmen"@de , "voti contrari"@it , "votos en contra"@es , "votos contra"@pt , "nem szavazatok"@hu ;
    rdfs:domain mbr:Ballot ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The number of votes against the application in a ballot, such as black balls, as a non-negative integer."@en ,
                    "Antalet röster emot ansökan i en ballotering, till exempel svartkulor, som ett icke-negativt heltal."@sv ,
                    "Le nombre de voix contre la demande dans un scrutin, par exemple des boules noires, sous forme d'entier non négatif."@fr ,
                    "Die Zahl der Stimmen gegen den Antrag in einer Abstimmung, etwa schwarze Kugeln, als nichtnegative ganze Zahl."@de ,
                    "Il numero di voti contrari alla domanda in una votazione, per esempio palline nere, come intero non negativo."@it ,
                    "El número de votos en contra de la solicitud en una votación, como las bolas negras, como entero no negativo."@es ,
                    "O número de votos contra o pedido numa votação, como as bolas pretas, como inteiro não negativo."@pt ,
                    "A kérelem ellen leadott szavazatok száma egy szavazáson, például fekete golyók, nemnegatív egész számként."@hu .

mbr:concernsMembership a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "concerns membership"@en , "avser medlemskap"@sv , "concerne l'adhésion"@fr , "betrifft Mitgliedschaft"@de , "riguarda l'appartenenza"@it , "afecta a la pertenencia"@es , "diz respeito à filiação"@pt , "tagságot érint"@hu ;
    rdfs:domain mbr:MembershipEvent ;
    rdfs:range org:Membership ;
    skos:definition "The membership a membership event belongs to."@en ,
                    "Det medlemskap som en medlemskapshändelse hör till."@sv ,
                    "L'adhésion à laquelle appartient un événement d'adhésion."@fr ,
                    "Die Mitgliedschaft, zu der ein Mitgliedschaftsereignis gehört."@de ,
                    "L'appartenenza a cui appartiene un evento di appartenenza."@it ,
                    "La pertenencia a la que corresponde un evento de pertenencia."@es ,
                    "A filiação a que pertence um evento de filiação."@pt ,
                    "A tagság, amelyhez a tagsági esemény tartozik."@hu .

mbr:membershipEventType a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "membership event type"@en , "typ av medlemskapshändelse"@sv , "type d'événement d'adhésion"@fr , "Art des Mitgliedschaftsereignisses"@de , "tipo di evento di appartenenza"@it , "tipo de evento de pertenencia"@es , "tipo de evento de filiação"@pt , "tagsági esemény típusa"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "The kind of membership event (see mbrc:MembershipEventTypes)."@en ,
                    "Typen av medlemskapshändelse (se mbrc:MembershipEventTypes)."@sv ,
                    "Le genre d'événement d'adhésion (voir mbrc:MembershipEventTypes)."@fr ,
                    "Die Art des Mitgliedschaftsereignisses (siehe mbrc:MembershipEventTypes)."@de ,
                    "Il tipo di evento di appartenenza (vedi mbrc:MembershipEventTypes)."@it ,
                    "El tipo de evento de pertenencia (véase mbrc:MembershipEventTypes)."@es ,
                    "O tipo de evento de filiação (ver mbrc:MembershipEventTypes)."@pt ,
                    "A tagsági esemény fajtája (lásd mbrc:MembershipEventTypes)."@hu .

mbr:resultingStatus a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "resulting status"@en , "resulterande status"@sv , "statut résultant"@fr , "resultierender Status"@de , "stato risultante"@it , "estado resultante"@es , "estado resultante"@pt , "eredményezett állapot"@hu ;
    rdfs:domain mbr:MembershipEvent ;
    rdfs:range skos:Concept ;
    skos:definition "The membership status that applies after the event."@en ,
                    "Den medlemskapsstatus som gäller efter händelsen."@sv ,
                    "Le statut d'adhésion qui s'applique après l'événement."@fr ,
                    "Der Mitgliedschaftsstatus, der nach dem Ereignis gilt."@de ,
                    "Lo stato dell'appartenenza che vale dopo l'evento."@it ,
                    "El estado de pertenencia que rige después del evento."@es ,
                    "O estado de filiação que vigora depois do evento."@pt ,
                    "A tagsági állapot, amely az esemény után érvényes."@hu .

mbr:resultingCategory a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "resulting category"@en , "resulterande kategori"@sv , "catégorie résultante"@fr , "resultierende Kategorie"@de , "categoria risultante"@it , "categoría resultante"@es , "categoria resultante"@pt , "eredményezett kategória"@hu ;
    rdfs:domain mbr:MembershipEvent ;
    rdfs:range skos:Concept ;
    skos:definition "A membership category that applies after the event (see mbrc:MembershipCategories). Give one value for each category in the complete set after the event."@en ,
                    "En medlemskategori som gäller efter händelsen (se mbrc:MembershipCategories). Ange ett värde för varje kategori i hela uppsättningen efter händelsen."@sv ,
                    "Une catégorie d'adhésion qui s'applique après l'événement (voir mbrc:MembershipCategories). Indiquez une valeur pour chaque catégorie de l'ensemble complet après l'événement."@fr ,
                    "Eine Mitgliedschaftskategorie, die nach dem Ereignis gilt (siehe mbrc:MembershipCategories). Für jede Kategorie der vollständigen Menge nach dem Ereignis ist ein Wert anzugeben."@de ,
                    "Una categoria di appartenenza che vale dopo l'evento (vedi mbrc:MembershipCategories). Si indica un valore per ciascuna categoria dell'insieme completo dopo l'evento."@it ,
                    "Una categoría de pertenencia que rige después del evento (véase mbrc:MembershipCategories). Se da un valor por cada categoría del conjunto completo después del evento."@es ,
                    "Uma categoria de filiação que vigora depois do evento (ver mbrc:MembershipCategories). Indica-se um valor por cada categoria do conjunto completo depois do evento."@pt ,
                    "Tagsági kategória, amely az esemény után érvényes (lásd mbrc:MembershipCategories). Az esemény utáni teljes halmaz minden kategóriájához egy értéket kell megadni."@hu ;
    skos:scopeNote "The values are the whole set of categories after the event, not an addition to the earlier set. An event that makes a life member also a founding member gives both, mbrc:life and mbrc:founding; giving only mbrc:founding says the membership then has only that category. An event that leaves the categories unchanged leaves mbr:resultingCategory out."@en ,
                   "Värdena är hela uppsättningen kategorier efter händelsen, inte ett tillägg till den tidigare. En händelse som gör en ständig medlem också stiftande ger båda, mbrc:life och mbrc:founding; anges bara mbrc:founding betyder det att medlemskapet då bara har den kategorin. En händelse som lämnar kategorierna oförändrade utelämnar mbr:resultingCategory."@sv ,
                   "Les valeurs sont l'ensemble complet des catégories après l'événement, non un ajout à l'ensemble précédent. Un événement qui fait d'un membre à vie aussi un membre fondateur donne les deux, mbrc:life et mbrc:founding ; ne donner que mbrc:founding dit que l'adhésion n'a alors que cette catégorie. Un événement qui laisse les catégories inchangées omet mbr:resultingCategory."@fr ,
                   "Die Werte sind die gesamte Menge der Kategorien nach dem Ereignis, keine Ergänzung der früheren Menge. Ein Ereignis, das ein Lebenszeitmitglied zugleich zum Gründungsmitglied macht, gibt beide an, mbrc:life und mbrc:founding; wird nur mbrc:founding angegeben, hat die Mitgliedschaft danach nur diese Kategorie. Ein Ereignis, das die Kategorien unverändert lässt, lässt mbr:resultingCategory weg."@de ,
                   "I valori sono l'intero insieme di categorie dopo l'evento, non un'aggiunta all'insieme precedente. Un evento che rende socio fondatore anche un socio a vita dà entrambi, mbrc:life e mbrc:founding; indicare solo mbrc:founding dice che l'appartenenza ha allora soltanto quella categoria. Un evento che lascia invariate le categorie omette mbr:resultingCategory."@it ,
                   "Los valores son el conjunto completo de categorías después del evento, no un añadido al conjunto anterior. Un evento que convierte a un miembro vitalicio también en miembro fundador da ambas, mbrc:life y mbrc:founding; dar solo mbrc:founding dice que la pertenencia tiene entonces únicamente esa categoría. Un evento que deja las categorías sin cambio omite mbr:resultingCategory."@es ,
                   "Os valores são o conjunto completo de categorias depois do evento, não um acrescento ao conjunto anterior. Um evento que torna um membro vitalício também membro fundador dá ambas, mbrc:life e mbrc:founding; dar apenas mbrc:founding diz que a filiação tem então somente essa categoria. Um evento que deixa as categorias inalteradas omite mbr:resultingCategory."@pt ,
                   "Az értékek az esemény utáni teljes kategóriahalmaz, nem a korábbi halmaz kiegészítése. Az az esemény, amely az élethossziglani tagot alapító taggá is teszi, mindkettőt megadja, az mbrc:life és az mbrc:founding értéket; ha csak az mbrc:founding szerepel, az azt mondja, hogy a tagságnak ekkor csak ez a kategóriája van. Az az esemény, amely a kategóriákat változatlanul hagyja, elhagyja az mbr:resultingCategory-t."@hu .

##############################################################################
# MEMBERSHIP FEES
##############################################################################

mbr:MembershipFee a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subClassOf schema:PriceSpecification ;
    rdfs:label "Membership Fee"@en , "Medlemsavgift"@sv , "Cotisation"@fr , "Mitgliedsbeitrag"@de , "Quota associativa"@it , "Cuota de socio"@es , "Quota"@pt , "Tagdíj"@hu ;
    skos:definition "A fee an organisation charges for membership: the kind of fee (mbr:feeType), the amount (schema:price) in a currency (schema:priceCurrency, an ISO 4217 code such as SEK), the membership categories it applies to (mbr:appliesToCategory; left out when it applies to all members) and when it was in force (mbr:startDate, mbr:endDate). Linked from the organisation or branch with mbr:membershipFee. When a fee changes, add a new fee and give the old one an end date."@en ,
                    "En avgift som en organisation tar ut för medlemskap: avgiftens typ (mbr:feeType), beloppet (schema:price) i en valuta (schema:priceCurrency, en kod enligt ISO 4217, t.ex. SEK), de medlemskategorier den gäller (mbr:appliesToCategory; utelämnas när den gäller alla medlemmar) och när den gällde (mbr:startDate, mbr:endDate). Kopplas från organisationen eller avdelningen med mbr:membershipFee. När en avgift ändras läggs en ny avgift till och den gamla får ett slutdatum."@sv ,
                    "Somme qu'une organisation demande pour l'adhésion : le type de cotisation (mbr:feeType), le montant (schema:price) dans une monnaie (schema:priceCurrency, un code ISO 4217 comme SEK), les catégories de membres concernées (mbr:appliesToCategory ; omis lorsqu'elle s'applique à tous les membres) et la période où elle était en vigueur (mbr:startDate, mbr:endDate). Reliée à l'organisation ou à la section par mbr:membershipFee. Quand une cotisation change, ajouter une nouvelle cotisation et donner une date de fin à l'ancienne."@fr ,
                    "Ein Beitrag, den eine Organisation für die Mitgliedschaft erhebt: die Art des Beitrags (mbr:feeType), der Betrag (schema:price) in einer Währung (schema:priceCurrency, ein ISO-4217-Code wie SEK), die Mitgliedschaftskategorien, für die er gilt (mbr:appliesToCategory; entfällt, wenn er für alle Mitglieder gilt) und wann er in Kraft war (mbr:startDate, mbr:endDate). Von der Organisation oder Zweigstelle aus mit mbr:membershipFee verknüpft. Ändert sich ein Beitrag, wird ein neuer Beitrag angelegt und der alte erhält ein Enddatum."@de ,
                    "Una quota che un'organizzazione richiede per l'appartenenza: il tipo di quota (mbr:feeType), l'importo (schema:price) in una valuta (schema:priceCurrency, un codice ISO 4217 come SEK), le categorie di soci a cui si applica (mbr:appliesToCategory; omesso quando vale per tutti i soci) e quando era in vigore (mbr:startDate, mbr:endDate). Collegata all'organizzazione o alla sezione con mbr:membershipFee. Quando una quota cambia, si aggiunge una nuova quota e si dà una data di fine alla vecchia."@it ,
                    "Una cuota que una organización cobra por la pertenencia: el tipo de cuota (mbr:feeType), el importe (schema:price) en una moneda (schema:priceCurrency, un código ISO 4217 como SEK), las categorías de pertenencia a las que se aplica (mbr:appliesToCategory; se omite cuando se aplica a todos los miembros) y cuándo estuvo en vigor (mbr:startDate, mbr:endDate). Se vincula desde la organización o sección con mbr:membershipFee. Cuando una cuota cambia, se añade una cuota nueva y se da fecha de fin a la antigua."@es ,
                    "Uma quota que uma organização cobra pela filiação: o tipo de quota (mbr:feeType), o montante (schema:price) numa moeda (schema:priceCurrency, um código ISO 4217 como SEK), as categorias de filiação a que se aplica (mbr:appliesToCategory; omite-se quando se aplica a todos os membros) e quando esteve em vigor (mbr:startDate, mbr:endDate). Liga-se a partir da organização ou secção com mbr:membershipFee. Quando uma quota muda, acrescenta-se uma quota nova e dá-se data de fim à antiga."@pt ,
                    "Díj, amelyet egy szervezet a tagságért számít fel: a díj fajtája (mbr:feeType), az összeg (schema:price) egy pénznemben (schema:priceCurrency, ISO 4217 kód, például SEK), a tagsági kategóriák, amelyekre vonatkozik (mbr:appliesToCategory; elhagyandó, ha minden tagra vonatkozik), és mikor volt érvényben (mbr:startDate, mbr:endDate). A szervezetből vagy tagozatból az mbr:membershipFee kapcsolja. Ha a díj változik, új díjat kell felvenni, a régi pedig záró dátumot kap."@hu .

mbr:membershipFee a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "membership fee"@en , "medlemsavgift"@sv , "cotisation"@fr , "Mitgliedsbeitrag"@de , "quota associativa"@it , "cuota de socio"@es , "quota"@pt , "tagdíj"@hu ;
    rdfs:range mbr:MembershipFee ;
    skos:definition "A fee the organisation or branch charges for membership, now or in the past."@en ,
                    "En avgift som organisationen eller avdelningen tar eller har tagit ut för medlemskap."@sv ,
                    "Somme que l'organisation ou la section demande pour l'adhésion, aujourd'hui ou par le passé."@fr ,
                    "Ein Beitrag, den die Organisation oder Zweigstelle für die Mitgliedschaft erhebt, jetzt oder früher."@de ,
                    "Una quota che l'organizzazione o la sezione richiede per l'appartenenza, ora o in passato."@it ,
                    "Una cuota que la organización o sección cobra por la pertenencia, ahora o en el pasado."@es ,
                    "Uma quota que a organização ou secção cobra pela filiação, agora ou no passado."@pt ,
                    "Díj, amelyet a szervezet vagy tagozat a tagságért számít fel, most vagy a múltban."@hu .

mbr:feeType a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "fee type"@en , "avgiftstyp"@sv , "type de cotisation"@fr , "Beitragsart"@de , "tipo di quota"@it , "tipo de cuota"@es , "tipo de quota"@pt , "díjtípus"@hu ;
    rdfs:domain mbr:MembershipFee ;
    rdfs:range skos:Concept ;
    skos:definition "When and how often the fee is paid: on joining, every year, every month or once for life (see mbrc:FeeTypes)."@en ,
                    "När och hur ofta avgiften betalas: vid inträdet, varje år, varje månad eller en gång för livet (se mbrc:FeeTypes)."@sv ,
                    "Quand et à quelle fréquence la cotisation est payée : à l'entrée, chaque année, chaque mois ou une fois pour la vie (voir mbrc:FeeTypes)."@fr ,
                    "Wann und wie oft der Beitrag gezahlt wird: beim Eintritt, jährlich, monatlich oder einmalig auf Lebenszeit (siehe mbrc:FeeTypes)."@de ,
                    "Quando e con quale frequenza si paga la quota: all'ingresso, ogni anno, ogni mese o una volta per sempre (vedi mbrc:FeeTypes)."@it ,
                    "Cuándo y con qué frecuencia se paga la cuota: al ingresar, cada año, cada mes o una sola vez de por vida (véase mbrc:FeeTypes)."@es ,
                    "Quando e com que frequência se paga a quota: ao ingressar, todos os anos, todos os meses ou uma só vez para toda a vida (ver mbrc:FeeTypes)."@pt ,
                    "Mikor és milyen gyakran fizetik a díjat: belépéskor, évente, havonta vagy egyszer egy életre (lásd mbrc:FeeTypes)."@hu .

mbr:appliesToCategory a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "applies to category"@en , "gäller kategori"@sv , "s'applique à la catégorie"@fr , "gilt für Kategorie"@de , "si applica alla categoria"@it , "se aplica a la categoría"@es , "aplica-se à categoria"@pt , "kategóriára vonatkozik"@hu ;
    rdfs:domain mbr:MembershipFee ;
    rdfs:range skos:Concept ;
    skos:definition "A membership category the fee applies to, such as junior or overseas members (see mbrc:MembershipCategories). Left out when the fee applies to all members."@en ,
                    "En medlemskategori som avgiften gäller, t.ex. junior- eller utlandsmedlemmar (se mbrc:MembershipCategories). Utelämnas när avgiften gäller alla medlemmar."@sv ,
                    "Catégorie d'adhésion à laquelle la cotisation s'applique, comme les membres juniors ou à l'étranger (voir mbrc:MembershipCategories). Omis lorsque la cotisation s'applique à tous les membres."@fr ,
                    "Eine Mitgliedschaftskategorie, für die der Beitrag gilt, etwa jugendliche Mitglieder oder Mitglieder im Ausland (siehe mbrc:MembershipCategories). Entfällt, wenn der Beitrag für alle Mitglieder gilt."@de ,
                    "Una categoria di appartenenza a cui si applica la quota, come i soci giovani o d'oltremare (vedi mbrc:MembershipCategories). Omessa quando la quota vale per tutti i soci."@it ,
                    "Una categoría de pertenencia a la que se aplica la cuota, como los miembros juveniles o de ultramar (véase mbrc:MembershipCategories). Se omite cuando la cuota se aplica a todos los miembros."@es ,
                    "Uma categoria de filiação a que se aplica a quota, como os membros juvenis ou de além-mar (ver mbrc:MembershipCategories). Omite-se quando a quota se aplica a todos os membros."@pt ,
                    "Tagsági kategória, amelyre a díj vonatkozik, például az ifjúsági vagy külföldi tagok (lásd mbrc:MembershipCategories). Elhagyandó, ha a díj minden tagra vonatkozik."@hu .

##############################################################################
# OFFICES AND TERMS OF OFFICE
##############################################################################

mbr:Office a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subClassOf org:Role ;
    rdfs:label "Office"@en , "Ämbete"@sv , "Fonction"@fr , "Amt"@de , "Carica"@it , "Cargo"@es , "Cargo"@pt , "Tisztség"@hu ;
    skos:definition "A kind of office in a membership organisation, such as treasurer or master of ceremonies. Offices are org:Role and therefore SKOS concepts: they live in codelists (mbrc:OfficeTypes is the generic hub)."@en ,
                    "En typ av ämbete i en medlemsorganisation, t.ex. skattmästare eller ceremonimästare. Ämbeten är org:Role och därmed SKOS-begrepp: de förs i kodlistor (mbrc:OfficeTypes är det generiska navet)."@sv ,
                    "Sorte de fonction dans une organisation de membres, comme trésorier ou maître des cérémonies. Les fonctions sont des org:Role et donc des concepts SKOS : elles vivent dans des listes de codes (mbrc:OfficeTypes est le pivot générique)."@fr ,
                    "Eine Art von Amt in einer Mitgliederorganisation, etwa Schatzmeister oder Zeremonienmeister. Ämter sind org:Role und damit SKOS-Konzepte: Sie stehen in Codelisten (mbrc:OfficeTypes ist der allgemeine Knotenpunkt)."@de ,
                    "Un tipo di carica in un'organizzazione associativa, come tesoriere o maestro delle cerimonie. Le cariche sono org:Role e quindi concetti SKOS: stanno nelle liste di codici (mbrc:OfficeTypes è l'hub generico)."@it ,
                    "Un tipo de cargo en una organización de miembros, como tesorero o maestro de ceremonias. Los cargos son org:Role y, por tanto, conceptos SKOS: viven en listas de códigos (mbrc:OfficeTypes es el núcleo genérico)."@es ,
                    "Um tipo de cargo numa organização de membros, como tesoureiro ou mestre de cerimónias. Os cargos são org:Role e, por isso, conceitos SKOS: vivem em listas de códigos (mbrc:OfficeTypes é o núcleo genérico)."@pt ,
                    "Egy tisztségfajta egy tagsági szervezetben, például pénztáros vagy szertartásmester. A tisztségek org:Role-ok, ezért SKOS-fogalmak: kódlistákban élnek (az mbrc:OfficeTypes az általános gyűjtőlista)."@hu .

mbr:Tenure a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subClassOf org:Membership ;
    rdfs:label "Term of Office"@en , "Ämbetsperiod"@sv , "Mandat"@fr , "Amtszeit"@de , "Mandato"@it , "Mandato"@es , "Mandato"@pt , "Megbízatás"@hu ;
    skos:definition "A period during which an agent (org:member) holds an office (org:role) in an organisation (org:organization)."@en ,
                    "En period under vilken en agent (org:member) innehar ett ämbete (org:role) i en organisation (org:organization)."@sv ,
                    "Période pendant laquelle un agent (org:member) exerce une fonction (org:role) dans une organisation (org:organization)."@fr ,
                    "Ein Zeitraum, in dem ein Akteur (org:member) ein Amt (org:role) in einer Organisation (org:organization) innehat."@de ,
                    "Un periodo in cui un agente (org:member) ricopre una carica (org:role) in un'organizzazione (org:organization)."@it ,
                    "Un período durante el cual un agente (org:member) ocupa un cargo (org:role) en una organización (org:organization)."@es ,
                    "Um período durante o qual um agente (org:member) ocupa um cargo (org:role) numa organização (org:organization)."@pt ,
                    "Az az időszak, amely alatt egy ágens (org:member) tisztséget (org:role) tölt be egy szervezetben (org:organization)."@hu .

##############################################################################
# DATES (shared by memberships, tenures, gatherings, conferrals, events)
##############################################################################

mbr:startDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subPropertyOf schema:startDate ;
    rdfs:label "start date"@en , "startdatum"@sv , "date de début"@fr , "Beginndatum"@de , "data di inizio"@it , "fecha de inicio"@es , "data de início"@pt , "kezdő dátum"@hu ;
    skos:definition "When something began or took place. Value is xsd:date, xsd:gYearMonth or xsd:gYear."@en ,
                    "När något började eller ägde rum. Värdet är xsd:date, xsd:gYearMonth eller xsd:gYear."@sv ,
                    "Quand quelque chose a commencé ou a eu lieu. La valeur est de type xsd:date, xsd:gYearMonth ou xsd:gYear."@fr ,
                    "Wann etwas begann oder stattfand. Der Wert ist xsd:date, xsd:gYearMonth oder xsd:gYear."@de ,
                    "Quando qualcosa è cominciato o ha avuto luogo. Il valore è xsd:date, xsd:gYearMonth o xsd:gYear."@it ,
                    "Cuándo empezó o tuvo lugar algo. El valor es xsd:date, xsd:gYearMonth o xsd:gYear."@es ,
                    "Quando algo começou ou teve lugar. O valor é xsd:date, xsd:gYearMonth ou xsd:gYear."@pt ,
                    "Mikor kezdődött vagy történt valami. Az érték xsd:date, xsd:gYearMonth vagy xsd:gYear."@hu .

mbr:endDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subPropertyOf schema:endDate ;
    rdfs:label "end date"@en , "slutdatum"@sv , "date de fin"@fr , "Enddatum"@de , "data di fine"@it , "fecha de fin"@es , "data de fim"@pt , "záró dátum"@hu ;
    skos:definition "When something ended. Value is xsd:date, xsd:gYearMonth or xsd:gYear."@en ,
                    "När något upphörde. Värdet är xsd:date, xsd:gYearMonth eller xsd:gYear."@sv ,
                    "Quand quelque chose a pris fin. La valeur est de type xsd:date, xsd:gYearMonth ou xsd:gYear."@fr ,
                    "Wann etwas endete. Der Wert ist xsd:date, xsd:gYearMonth oder xsd:gYear."@de ,
                    "Quando qualcosa è finito. Il valore è xsd:date, xsd:gYearMonth o xsd:gYear."@it ,
                    "Cuándo terminó algo. El valor es xsd:date, xsd:gYearMonth o xsd:gYear."@es ,
                    "Quando algo terminou. O valor é xsd:date, xsd:gYearMonth ou xsd:gYear."@pt ,
                    "Mikor ért véget valami. Az érték xsd:date, xsd:gYearMonth vagy xsd:gYear."@hu ;
    skos:scopeNote "SHACL reports an end before a start only when it is certain: the latest day the end could mean is before the earliest day the start could mean, so 2000 and 2000-03 may overlap and are not an error. Supported are years 0001-9999 written with four digits; a timezone is ignored and the calendar date as written is compared. Other dates are not ordered and give a warning. The same rule applies to mbr:foundingDate and mbr:dissolutionDate."@en ,
                   "SHACL anger ett slut före en start bara när det är säkert: den senaste dag slutet kan avse ligger före den tidigaste dag starten kan avse, så 2000 och 2000-03 kan överlappa och är inte ett fel. Stöd finns för år 0001-9999 skrivna med fyra siffror; tidszon ignoreras och kalenderdatumet så som det skrivits jämförs. Andra datum ordnas inte och ger en varning. Samma regel gäller mbr:foundingDate och mbr:dissolutionDate."@sv ,
                   "SHACL ne signale une fin antérieure à un début que lorsque c'est certain : le dernier jour que la fin peut désigner précède le premier jour que le début peut désigner ; 2000 et 2000-03 peuvent donc se chevaucher et ne sont pas une erreur. Les années 0001-9999 écrites avec quatre chiffres sont prises en charge ; un fuseau horaire est ignoré et la date calendaire telle qu'écrite est comparée. Les autres dates ne sont pas ordonnées et donnent un avertissement. La même règle s'applique à mbr:foundingDate et mbr:dissolutionDate."@fr ,
                   "SHACL meldet ein Ende vor einem Beginn nur, wenn es sicher ist: Der späteste Tag, den das Ende bedeuten könnte, liegt vor dem frühesten Tag, den der Beginn bedeuten könnte; 2000 und 2000-03 können sich also überschneiden und sind kein Fehler. Unterstützt werden die Jahre 0001–9999 in vierstelliger Schreibweise; eine Zeitzone wird ignoriert und das Kalenderdatum wie geschrieben verglichen. Andere Datumsangaben werden nicht geordnet und ergeben eine Warnung. Dieselbe Regel gilt für mbr:foundingDate und mbr:dissolutionDate."@de ,
                   "SHACL segnala una fine anteriore a un inizio solo quando è certa: l'ultimo giorno che la fine potrebbe indicare precede il primo giorno che l'inizio potrebbe indicare, quindi 2000 e 2000-03 possono sovrapporsi e non sono un errore. Sono supportati gli anni 0001-9999 scritti con quattro cifre; il fuso orario è ignorato e si confronta la data di calendario come scritta. Le altre date non vengono ordinate e danno un avviso. La stessa regola vale per mbr:foundingDate e mbr:dissolutionDate."@it ,
                   "SHACL señala un fin anterior a un inicio solo cuando es seguro: el último día que podría significar el fin es anterior al primer día que podría significar el inicio, de modo que 2000 y 2000-03 pueden solaparse y no son un error. Se admiten los años 0001-9999 escritos con cuatro cifras; se ignora la zona horaria y se compara la fecha del calendario tal como está escrita. Otras fechas no se ordenan y dan una advertencia. La misma regla se aplica a mbr:foundingDate y mbr:dissolutionDate."@es ,
                   "O SHACL assinala um fim anterior a um início apenas quando é certo: o último dia que o fim poderia significar é anterior ao primeiro dia que o início poderia significar, pelo que 2000 e 2000-03 podem sobrepor-se e não são um erro. Admitem-se os anos 0001-9999 escritos com quatro algarismos; ignora-se o fuso horário e compara-se a data do calendário tal como está escrita. Outras datas não se ordenam e dão um aviso. A mesma regra aplica-se a mbr:foundingDate e mbr:dissolutionDate."@pt ,
                   "A SHACL a kezdet előtti véget csak akkor jelez, ha biztos: az utolsó nap, amelyet a vég jelenthet, korábbi, mint az első nap, amelyet a kezdet jelenthet, így a 2000 és a 2000-03 átfedhetik egymást, és nem hiba. A 0001–9999 évek támogatottak négy számjeggyel írva; az időzónát figyelmen kívül hagyják, és a naptári dátumot úgy hasonlítják össze, ahogy írták. Más dátumokat nem rendeznek, és figyelmeztetést adnak. Ugyanez a szabály érvényes az mbr:foundingDate és az mbr:dissolutionDate értékre."@hu .

mbr:decisionDate a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "decision date"@en , "beslutsdatum"@sv , "date de décision"@fr , "Beschlussdatum"@de , "data della decisione"@it , "fecha de decisión"@es , "data de decisão"@pt , "döntés dátuma"@hu ;
    skos:definition "When a decision was taken, such as the date of a members' vote. Value is xsd:date, xsd:gYearMonth or xsd:gYear. The date the decision began to apply is mbr:startDate."@en ,
                    "När ett beslut fattades, till exempel dagen för en medlemsomröstning. Värdet är xsd:date, xsd:gYearMonth eller xsd:gYear. Det datum beslutet började gälla är mbr:startDate."@sv ,
                    "Quand une décision a été prise, par exemple la date d'un vote des membres. La valeur est de type xsd:date, xsd:gYearMonth ou xsd:gYear. La date à laquelle la décision a commencé à s'appliquer est mbr:startDate."@fr ,
                    "Wann ein Beschluss gefasst wurde, etwa das Datum einer Mitgliederabstimmung. Der Wert ist xsd:date, xsd:gYearMonth oder xsd:gYear. Das Datum, ab dem der Beschluss galt, ist mbr:startDate."@de ,
                    "Quando è stata presa una decisione, come la data di un voto dei soci. Il valore è xsd:date, xsd:gYearMonth o xsd:gYear. La data in cui la decisione ha cominciato a valere è mbr:startDate."@it ,
                    "Cuándo se tomó una decisión, como la fecha de una votación de los miembros. El valor es xsd:date, xsd:gYearMonth o xsd:gYear. La fecha en que la decisión empezó a aplicarse es mbr:startDate."@es ,
                    "Quando se tomou uma decisão, como a data de uma votação dos membros. O valor é xsd:date, xsd:gYearMonth ou xsd:gYear. A data em que a decisão começou a aplicar-se é mbr:startDate."@pt ,
                    "Mikor hoztak döntést, például a tagok szavazásának napja. Az érték xsd:date, xsd:gYearMonth vagy xsd:gYear. A nap, amikor a döntés hatályossá vált, az mbr:startDate."@hu ;
    skos:scopeNote "A decision may come before or after it takes effect, so SHACL does not compare it with mbr:startDate."@en ,
                   "Ett beslut kan komma före eller efter att det träder i kraft, så SHACL jämför det inte med mbr:startDate."@sv ,
                   "Une décision peut précéder ou suivre son entrée en vigueur ; SHACL ne la compare donc pas à mbr:startDate."@fr ,
                   "Ein Beschluss kann vor oder nach seinem Inkrafttreten liegen, daher vergleicht SHACL ihn nicht mit mbr:startDate."@de ,
                   "Una decisione può precedere o seguire il momento in cui ha effetto, quindi SHACL non la confronta con mbr:startDate."@it ,
                   "Una decisión puede ser anterior o posterior a su entrada en vigor, por lo que SHACL no la compara con mbr:startDate."@es ,
                   "Uma decisão pode ser anterior ou posterior à sua entrada em vigor, pelo que o SHACL não a compara com mbr:startDate."@pt ,
                   "A döntés megelőzheti vagy követheti a hatálybalépését, ezért a SHACL nem hasonlítja az mbr:startDate értékhez."@hu .

##############################################################################
# GATHERINGS AND PARTICIPATION
##############################################################################

mbr:Gathering a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subClassOf schema:Event ;
    rdfs:label "Gathering"@en , "Sammankomst"@sv , "Réunion"@fr , "Zusammenkunft"@de , "Incontro"@it , "Reunión"@es , "Reunião"@pt , "Összejövetel"@hu ;
    skos:definition "An occasion on which members (and possibly guests) come together: a meeting, dinner, ball, excursion and so on. The kind of gathering is given with mbr:gatheringType."@en ,
                    "Ett tillfälle då medlemmar (och eventuellt gäster) samlas: möte, middag, bal, utflykt osv. Typen av sammankomst anges med mbr:gatheringType."@sv ,
                    "Occasion où des membres (et éventuellement des invités) se retrouvent : réunion, dîner, bal, excursion, etc. Le genre de réunion est indiqué avec mbr:gatheringType."@fr ,
                    "Ein Anlass, bei dem Mitglieder (und möglicherweise Gäste) zusammenkommen: eine Sitzung, ein Essen, ein Ball, ein Ausflug und so weiter. Die Art der Zusammenkunft wird mit mbr:gatheringType angegeben."@de ,
                    "Un'occasione in cui i soci (ed eventualmente gli ospiti) si riuniscono: una riunione, una cena, un ballo, un'escursione e così via. Il tipo di incontro si indica con mbr:gatheringType."@it ,
                    "Una ocasión en que se reúnen los miembros (y posiblemente invitados): una reunión, una cena, un baile, una excursión, etc. El tipo de reunión se indica con mbr:gatheringType."@es ,
                    "Uma ocasião em que os membros (e possivelmente convidados) se juntam: uma reunião, um jantar, um baile, uma excursão, etc. O tipo de reunião indica-se com mbr:gatheringType."@pt ,
                    "Alkalom, amelyen a tagok (és esetleg vendégek) összegyűlnek: ülés, vacsora, bál, kirándulás stb. Az összejövetel fajtáját az mbr:gatheringType adja meg."@hu .

mbr:GatheringSeries a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subClassOf schema:EventSeries ;
    rdfs:label "Gathering Series"@en , "Återkommande sammankomst"@sv , "Série de réunions"@fr , "Zusammenkunftsreihe"@de , "Serie di incontri"@it , "Serie de reuniones"@es , "Série de reuniões"@pt , "Összejövetelsorozat"@hu ;
    skos:definition "A recurring gathering, such as an annual feast. Each occurrence is a mbr:Gathering linked to the series with schema:superEvent."@en ,
                    "En återkommande sammankomst, t.ex. en årlig högtid. Varje tillfälle är en mbr:Gathering kopplad till serien med schema:superEvent."@sv ,
                    "Réunion récurrente, comme un banquet annuel. Chaque occurrence est une mbr:Gathering reliée à la série par schema:superEvent."@fr ,
                    "Eine wiederkehrende Zusammenkunft, etwa ein jährliches Fest. Jedes Stattfinden ist eine mbr:Gathering, die mit schema:superEvent mit der Reihe verknüpft ist."@de ,
                    "Un incontro ricorrente, come una festa annuale. Ogni occorrenza è un mbr:Gathering collegato alla serie con schema:superEvent."@it ,
                    "Una reunión recurrente, como una fiesta anual. Cada celebración es un mbr:Gathering vinculado a la serie con schema:superEvent."@es ,
                    "Uma reunião recorrente, como uma festa anual. Cada realização é um mbr:Gathering ligado à série com schema:superEvent."@pt ,
                    "Ismétlődő összejövetel, például éves ünnep. Minden alkalom egy mbr:Gathering, amely a schema:superEvent segítségével kapcsolódik a sorozathoz."@hu .

mbr:gatheringType a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "gathering type"@en , "typ av sammankomst"@sv , "type de réunion"@fr , "Art der Zusammenkunft"@de , "tipo di incontro"@it , "tipo de reunión"@es , "tipo de reunião"@pt , "összejövetel típusa"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "The kind of gathering (see mbrc:GatheringTypes)."@en ,
                    "Typen av sammankomst (se mbrc:GatheringTypes)."@sv ,
                    "Le genre de réunion (voir mbrc:GatheringTypes)."@fr ,
                    "Die Art der Zusammenkunft (siehe mbrc:GatheringTypes)."@de ,
                    "Il tipo di incontro (vedi mbrc:GatheringTypes)."@it ,
                    "El tipo de reunión (véase mbrc:GatheringTypes)."@es ,
                    "O tipo de reunião (ver mbrc:GatheringTypes)."@pt ,
                    "Az összejövetel fajtája (lásd mbrc:GatheringTypes)."@hu .

mbr:organizer a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subPropertyOf schema:organizer ;
    rdfs:label "organiser"@en , "arrangör"@sv , "organisateur"@fr , "Veranstalter"@de , "organizzatore"@it , "organizador"@es , "organizador"@pt , "szervező"@hu ;
    rdfs:range foaf:Agent ;
    skos:definition "The organisation or agent that arranges a gathering."@en ,
                    "Den organisation eller agent som anordnar en sammankomst."@sv ,
                    "L'organisation ou l'agent qui organise une réunion."@fr ,
                    "Die Organisation oder der Akteur, der eine Zusammenkunft ausrichtet."@de ,
                    "L'organizzazione o l'agente che predispone un incontro."@it ,
                    "La organización o agente que organiza una reunión."@es ,
                    "A organização ou agente que organiza uma reunião."@pt ,
                    "A szervezet vagy ágens, amely az összejövetelt szervezi."@hu .

mbr:dressCode a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "dress code"@en , "klädkod"@sv , "code vestimentaire"@fr , "Kleiderordnung"@de , "codice di abbigliamento"@it , "código de vestimenta"@es , "código de vestuário"@pt , "öltözködési szabály"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "The dress code prescribed for a gathering, or — used on an organisation or its premises — the house dress code that applies day to day (see mbrc:DressCodes)."@en ,
                    "Den klädkod som gäller för en sammankomst, eller — använd på en organisation eller dess lokal — den klädkod som gäller i huset till vardags (se mbrc:DressCodes)."@sv ,
                    "Le code vestimentaire prescrit pour une réunion ou — employé pour une organisation ou ses locaux — le code vestimentaire de la maison qui s'applique au quotidien (voir mbrc:DressCodes)."@fr ,
                    "Die für eine Zusammenkunft vorgeschriebene Kleiderordnung oder – bei einer Organisation oder ihren Räumlichkeiten – die Hausordnung zur Kleidung, die im Alltag gilt (siehe mbrc:DressCodes)."@de ,
                    "Il codice di abbigliamento prescritto per un incontro oppure, usato su un'organizzazione o sui suoi locali, il codice di abbigliamento della casa che vale giorno per giorno (vedi mbrc:DressCodes)."@it ,
                    "El código de vestimenta prescrito para una reunión o, usado en una organización o sus locales, el código de vestimenta de la casa que rige en el día a día (véase mbrc:DressCodes)."@es ,
                    "O código de vestuário prescrito para uma reunião ou, usado numa organização ou nas suas instalações, o código de vestuário da casa que vigora no dia a dia (ver mbrc:DressCodes)."@pt ,
                    "Az összejövetelre előírt öltözködési szabály, vagy — szervezeten vagy helyiségein használva — a mindennap érvényes házirendi öltözködés (lásd mbrc:DressCodes)."@hu .

mbr:Participation a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "Participation"@en , "Deltagande"@sv , "Participation"@fr , "Teilnahme"@de , "Partecipazione"@it , "Participación"@es , "Participação"@pt , "Részvétel"@hu ;
    skos:definition "The qualified relationship between an agent and a gathering, carrying the role in which the agent took part (member, guest, partner, speaker …) and who introduced a guest."@en ,
                    "Den kvalificerade relationen mellan en agent och en sammankomst, med den roll agenten deltog i (medlem, gäst, moatjé, talare …) och vem som introducerade en gäst."@sv ,
                    "La relation qualifiée entre un agent et une réunion, portant le rôle dans lequel l'agent a pris part (membre, invité, accompagnant, orateur …) et qui a présenté un invité."@fr ,
                    "Die qualifizierte Beziehung zwischen einem Akteur und einer Zusammenkunft, mit der Rolle, in der der Akteur teilnahm (Mitglied, Gast, Begleitung, Redner …) und wer einen Gast eingeführt hat."@de ,
                    "La relazione qualificata tra un agente e un incontro, con il ruolo in cui l'agente ha partecipato (socio, ospite, partner, relatore …) e chi ha presentato un ospite."@it ,
                    "La relación cualificada entre un agente y una reunión, con el papel en que participó el agente (miembro, invitado, acompañante, ponente…) y quién presentó a un invitado."@es ,
                    "A relação qualificada entre um agente e uma reunião, com o papel em que o agente participou (membro, convidado, acompanhante, orador…) e quem apresentou um convidado."@pt ,
                    "A minősített kapcsolat egy ágens és egy összejövetel között, amely azt a szerepet hordozza, amelyben az ágens részt vett (tag, vendég, kísérő, előadó…), és azt, hogy ki mutatta be a vendéget."@hu .

mbr:participant a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "participant"@en , "deltagare"@sv , "participant"@fr , "Teilnehmer"@de , "partecipante"@it , "participante"@es , "participante"@pt , "résztvevő"@hu ;
    skos:definition "The agent who took part in a gathering, as recorded in a participation."@en ,
                    "Den agent som deltog i en sammankomst, så som det anges i ett deltagande."@sv ,
                    "L'agent qui a pris part à une réunion, tel que consigné dans une participation."@fr ,
                    "Der Akteur, der an einer Zusammenkunft teilnahm, wie in einer Teilnahme festgehalten."@de ,
                    "L'agente che ha preso parte a un incontro, come registrato in una partecipazione."@it ,
                    "El agente que participó en una reunión, tal como consta en una participación."@es ,
                    "O agente que participou numa reunião, tal como consta numa participação."@pt ,
                    "Az ágens, aki részt vett egy összejövetelen, ahogy a részvétel rögzíti."@hu ;
    rdfs:domain mbr:Participation ;
    rdfs:range foaf:Agent .

mbr:participationIn a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "participation in"@en , "deltagande i"@sv , "participation à"@fr , "Teilnahme an"@de , "partecipazione a"@it , "participación en"@es , "participação em"@pt , "részvétel ebben"@hu ;
    skos:definition "The gathering or other event that a participation concerns."@en ,
                    "Den sammankomst eller annan händelse som ett deltagande avser."@sv ,
                    "La réunion ou autre événement qu'une participation concerne."@fr ,
                    "Die Zusammenkunft oder das andere Ereignis, auf das sich eine Teilnahme bezieht."@de ,
                    "L'incontro o altro evento a cui si riferisce una partecipazione."@it ,
                    "La reunión u otro evento al que se refiere una participación."@es ,
                    "A reunião ou outro evento a que se refere uma participação."@pt ,
                    "Az összejövetel vagy más esemény, amelyre a részvétel vonatkozik."@hu ;
    rdfs:domain mbr:Participation ;
    rdfs:range schema:Event .

mbr:participationRole a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "participation role"@en , "deltagarroll"@sv , "rôle de participation"@fr , "Teilnahmerolle"@de , "ruolo di partecipazione"@it , "papel de participación"@es , "papel de participação"@pt , "részvételi szerep"@hu ;
    rdfs:domain mbr:Participation ;
    rdfs:range skos:Concept ;
    skos:definition "The role in which the agent took part (see mbrc:ParticipationRoles)."@en ,
                    "Den roll i vilken agenten deltog (se mbrc:ParticipationRoles)."@sv ,
                    "Le rôle dans lequel l'agent a pris part (voir mbrc:ParticipationRoles)."@fr ,
                    "Die Rolle, in der der Akteur teilnahm (siehe mbrc:ParticipationRoles)."@de ,
                    "Il ruolo in cui l'agente ha partecipato (vedi mbrc:ParticipationRoles)."@it ,
                    "El papel en que participó el agente (véase mbrc:ParticipationRoles)."@es ,
                    "O papel em que participou o agente (ver mbrc:ParticipationRoles)."@pt ,
                    "A szerep, amelyben az ágens részt vett (lásd mbrc:ParticipationRoles)."@hu .

mbr:introducedBy a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "introduced by"@en , "introducerad av"@sv , "présenté par"@fr , "eingeführt von"@de , "presentato da"@it , "presentado por"@es , "apresentado por"@pt , "bemutatta"@hu ;
    rdfs:domain mbr:Participation ;
    rdfs:range foaf:Agent ;
    skos:definition "The member who introduced a guest to the gathering."@en ,
                    "Den medlem som introducerade en gäst vid sammankomsten."@sv ,
                    "Le membre qui a présenté un invité à la réunion."@fr ,
                    "Das Mitglied, das einen Gast in die Zusammenkunft eingeführt hat."@de ,
                    "Il socio che ha presentato un ospite all'incontro."@it ,
                    "El miembro que presentó a un invitado a la reunión."@es ,
                    "O membro que apresentou um convidado à reunião."@pt ,
                    "A tag, aki a vendéget bemutatta az összejövetelen."@hu .

mbr:attended a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    owl:inverseOf schema:attendee ;
    rdfs:label "attended"@en , "har deltagit i"@sv , "a assisté à"@fr , "nahm teil an"@de , "ha partecipato a"@it , "asistió a"@es , "assistiu a"@pt , "részt vett"@hu ;
    rdfs:range schema:Event ;
    skos:definition "Shortcut from an agent to a gathering it attended, when the role does not need to be recorded. Inverse of schema:attendee."@en ,
                    "Genväg från en agent till en sammankomst den deltog i, när rollen inte behöver anges. Invers till schema:attendee."@sv ,
                    "Raccourci d'un agent vers une réunion à laquelle il a assisté, lorsque le rôle n'a pas à être consigné. Inverse de schema:attendee."@fr ,
                    "Abkürzung von einem Akteur zu einer Zusammenkunft, an der er teilnahm, wenn die Rolle nicht festgehalten werden muss. Inverse von schema:attendee."@de ,
                    "Scorciatoia da un agente a un incontro a cui ha partecipato, quando non occorre registrare il ruolo. Inversa di schema:attendee."@it ,
                    "Atajo desde un agente hasta una reunión a la que asistió, cuando no hace falta registrar el papel. Inversa de schema:attendee."@es ,
                    "Atalho de um agente para uma reunião a que assistiu, quando não é preciso registar o papel. Inversa de schema:attendee."@pt ,
                    "Rövidítés egy ágenstől az összejövetelhez, amelyen részt vett, ha a szerepet nem kell rögzíteni. A schema:attendee inverze."@hu .

##############################################################################
# DISTINCTIONS AND CONFERRALS
##############################################################################

mbr:Distinction a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Distinction"@en , "Utmärkelse"@sv , "Distinction"@fr , "Auszeichnung"@de , "Riconoscimento"@it , "Distinción"@es , "Distinção"@pt , "Kitüntetés"@hu ;
    skos:definition "A kind of honour an organisation can confer: a medal, badge, honorary title, honorary membership and so on. Distinctions are SKOS concepts kept in the organisation's codelist; the individual award is a mbr:DistinctionConferral."@en ,
                    "En typ av hedersbetygelse som en organisation kan tilldela: medalj, tecken, hederstitel, hedersledamotskap osv. Utmärkelser är SKOS-begrepp i organisationens kodlista; själva tilldelningen är en mbr:DistinctionConferral."@sv ,
                    "Sorte d'honneur qu'une organisation peut conférer : médaille, insigne, titre honorifique, adhésion honoraire, etc. Les distinctions sont des concepts SKOS tenus dans la liste de codes de l'organisation ; l'attribution individuelle est une mbr:DistinctionConferral."@fr ,
                    "Eine Art von Ehrung, die eine Organisation verleihen kann: eine Medaille, ein Abzeichen, ein Ehrentitel, eine Ehrenmitgliedschaft und so weiter. Auszeichnungen sind SKOS-Konzepte in der Codeliste der Organisation; die einzelne Verleihung ist eine mbr:DistinctionConferral."@de ,
                    "Un tipo di onore che un'organizzazione può conferire: una medaglia, un distintivo, un titolo onorifico, l'appartenenza onoraria e così via. I riconoscimenti sono concetti SKOS conservati nella lista di codici dell'organizzazione; il singolo conferimento è un mbr:DistinctionConferral."@it ,
                    "Un tipo de honor que una organización puede conceder: una medalla, una insignia, un título honorífico, una pertenencia honoraria, etc. Las distinciones son conceptos SKOS guardados en la lista de códigos de la organización; la concesión individual es un mbr:DistinctionConferral."@es ,
                    "Um tipo de honra que uma organização pode conferir: uma medalha, um distintivo, um título honorífico, uma filiação honorária, etc. As distinções são conceitos SKOS guardados na lista de códigos da organização; a atribuição individual é um mbr:DistinctionConferral."@pt ,
                    "A kitüntetés egy fajtája, amelyet egy szervezet adományozhat: érem, jelvény, díszcím, tiszteleti tagság stb. A kitüntetések SKOS-fogalmak, amelyeket a szervezet kódlistája őriz; az egyedi odaítélés egy mbr:DistinctionConferral."@hu .

mbr:distinctionType a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "distinction type"@en , "typ av utmärkelse"@sv , "type de distinction"@fr , "Art der Auszeichnung"@de , "tipo di riconoscimento"@it , "tipo de distinción"@es , "tipo de distinção"@pt , "kitüntetés típusa"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "The generic kind of a distinction (see mbrc:DistinctionTypes)."@en ,
                    "Utmärkelsens generiska typ (se mbrc:DistinctionTypes)."@sv ,
                    "Le genre générique d'une distinction (voir mbrc:DistinctionTypes)."@fr ,
                    "Die allgemeine Art einer Auszeichnung (siehe mbrc:DistinctionTypes)."@de ,
                    "Il tipo generico di un riconoscimento (vedi mbrc:DistinctionTypes)."@it ,
                    "El tipo genérico de una distinción (véase mbrc:DistinctionTypes)."@es ,
                    "O tipo genérico de uma distinção (ver mbrc:DistinctionTypes)."@pt ,
                    "A kitüntetés általános fajtája (lásd mbrc:DistinctionTypes)."@hu .

mbr:material a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "material"@en , "material"@sv , "matériau"@fr , "Material"@de , "materiale"@it , "material"@es , "material"@pt , "anyag"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "The material a medal, badge or insignia is made of (see mbrc:Materials)."@en ,
                    "Det material en medalj, ett tecken eller en insignie är tillverkad av (se mbrc:Materials)."@sv ,
                    "Le matériau dont est faite une médaille, un insigne ou une décoration (voir mbrc:Materials)."@fr ,
                    "Das Material, aus dem eine Medaille, ein Abzeichen oder eine Insignie besteht (siehe mbrc:Materials)."@de ,
                    "Il materiale di cui sono fatti una medaglia, un distintivo o un'insegna (vedi mbrc:Materials)."@it ,
                    "El material del que está hecha una medalla, insignia o distintivo (véase mbrc:Materials)."@es ,
                    "O material de que é feita uma medalha, distintivo ou insígnia (ver mbrc:Materials)."@pt ,
                    "Az anyag, amelyből az érem, jelvény vagy jelkép készült (lásd mbrc:Materials)."@hu .

mbr:ribbonColour a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "ribbon colour"@en , "bandfärg"@sv , "couleur du ruban"@fr , "Bandfarbe"@de , "colore del nastro"@it , "color de la cinta"@es , "cor da fita"@pt , "szalag színe"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "The colour of the ribbon on which a medal or badge is worn, given as a concept. No codelist of colours is supplied."@en ,
                    "Färgen på det band i vilket en medalj eller ett tecken bärs, angiven som ett begrepp. Ingen kodlista för färger tillhandahålls."@sv ,
                    "La couleur du ruban auquel est portée une médaille ou un insigne, donnée sous forme de concept. Aucune liste de codes de couleurs n'est fournie."@fr ,
                    "Die Farbe des Bandes, an dem eine Medaille oder ein Abzeichen getragen wird, als Konzept angegeben. Eine Codeliste der Farben wird nicht mitgeliefert."@de ,
                    "Il colore del nastro con cui si porta una medaglia o un distintivo, indicato come concetto. Non viene fornita alcuna lista di codici dei colori."@it ,
                    "El color de la cinta de la que se lleva una medalla o insignia, dado como concepto. No se suministra ninguna lista de códigos de colores."@es ,
                    "A cor da fita em que se usa uma medalha ou distintivo, dada como conceito. Não se fornece nenhuma lista de códigos de cores."@pt ,
                    "A szalag színe, amelyen az érmet vagy jelvényt viselik, fogalomként megadva. Színek kódlistáját nem biztosítjuk."@hu .

mbr:Conferral a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Conferral"@en , "Tilldelning"@sv , "Attribution"@fr , "Verleihung"@de , "Conferimento"@it , "Concesión"@es , "Atribuição"@pt , "Adományozás"@hu ;
    skos:definition "The act of conferring something (a distinction, a degree) on a recipient. The recipient may be any agent, member or not."@en ,
                    "Handlingen att tilldela någon något (en utmärkelse, en grad). Mottagaren kan vara vilken agent som helst, medlem eller inte."@sv ,
                    "L'acte de conférer quelque chose (une distinction, un degré) à un bénéficiaire. Le bénéficiaire peut être n'importe quel agent, membre ou non."@fr ,
                    "Der Akt, jemandem etwas zu verleihen (eine Auszeichnung, einen Grad). Der Empfänger kann jeder Akteur sein, Mitglied oder nicht."@de ,
                    "L'atto di conferire qualcosa (un riconoscimento, un grado) a un destinatario. Il destinatario può essere qualsiasi agente, socio o no."@it ,
                    "El acto de conferir algo (una distinción, un grado) a un destinatario. El destinatario puede ser cualquier agente, miembro o no."@es ,
                    "O ato de conferir algo (uma distinção, um grau) a um destinatário. O destinatário pode ser qualquer agente, membro ou não."@pt ,
                    "Valami (egy kitüntetés, egy fokozat) odaítélésének aktusa egy címzettnek. A címzett bármely ágens lehet, tag vagy nem."@hu .

mbr:DistinctionConferral a owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subClassOf mbr:Conferral ;
    rdfs:label "Distinction Conferral"@en , "Utmärkelsetilldelning"@sv , "Attribution de distinction"@fr , "Auszeichnungsverleihung"@de , "Conferimento di un riconoscimento"@it , "Concesión de distinción"@es , "Atribuição de distinção"@pt , "Kitüntetés adományozása"@hu ;
    skos:definition "The conferral of a distinction. The same agent may receive the same distinction more than once."@en ,
                    "Tilldelningen av en utmärkelse. Samma agent kan motta samma utmärkelse flera gånger."@sv ,
                    "L'attribution d'une distinction. Le même agent peut recevoir plusieurs fois la même distinction."@fr ,
                    "Die Verleihung einer Auszeichnung. Derselbe Akteur kann dieselbe Auszeichnung mehr als einmal erhalten."@de ,
                    "Il conferimento di un riconoscimento. Lo stesso agente può ricevere più volte lo stesso riconoscimento."@it ,
                    "La concesión de una distinción. Un mismo agente puede recibir la misma distinción más de una vez."@es ,
                    "A atribuição de uma distinção. O mesmo agente pode receber a mesma distinção mais de uma vez."@pt ,
                    "Egy kitüntetés odaítélése. Ugyanaz az ágens ugyanazt a kitüntetést többször is megkaphatja."@hu .

mbr:recipient a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "recipient"@en , "mottagare"@sv , "bénéficiaire"@fr , "Empfänger"@de , "destinatario"@it , "destinatario"@es , "destinatário"@pt , "címzett"@hu ;
    skos:definition "The agent on whom something is conferred, member or not."@en ,
                    "Den agent som något tilldelas, medlem eller inte."@sv ,
                    "L'agent à qui quelque chose est conféré, membre ou non."@fr ,
                    "Der Akteur, dem etwas verliehen wird, Mitglied oder nicht."@de ,
                    "L'agente a cui viene conferito qualcosa, socio o no."@it ,
                    "El agente a quien se confiere algo, sea o no miembro."@es ,
                    "O agente a quem se confere algo, seja ou não membro."@pt ,
                    "Az ágens, akinek valamit odaítélnek, tag vagy nem."@hu ;
    rdfs:domain mbr:Conferral ;
    rdfs:range foaf:Agent .

mbr:conferred a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "conferred"@en , "tilldelat"@sv , "conféré"@fr , "verliehen"@de , "conferito"@it , "conferido"@es , "conferido"@pt , "odaítélt"@hu ;
    rdfs:domain mbr:Conferral ;
    rdfs:range skos:Concept ;
    skos:definition "What was conferred: a distinction, a degree or another concept."@en ,
                    "Vad som tilldelades: en utmärkelse, en grad eller annat begrepp."@sv ,
                    "Ce qui a été conféré : une distinction, un degré ou un autre concept."@fr ,
                    "Was verliehen wurde: eine Auszeichnung, ein Grad oder ein anderes Konzept."@de ,
                    "Ciò che è stato conferito: un riconoscimento, un grado o un altro concetto."@it ,
                    "Lo que se confirió: una distinción, un grado u otro concepto."@es ,
                    "O que foi conferido: uma distinção, um grau ou outro conceito."@pt ,
                    "Amit odaítéltek: kitüntetés, fokozat vagy más fogalom."@hu .

mbr:conferredAt a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "conferred at"@en , "tilldelat vid"@sv , "conféré lors de"@fr , "verliehen bei"@de , "conferito in occasione di"@it , "conferido en"@es , "conferido em"@pt , "odaítélés helye"@hu ;
    rdfs:domain mbr:Conferral ;
    rdfs:range schema:Event ;
    skos:definition "The gathering at which the conferral took place."@en ,
                    "Den sammankomst vid vilken tilldelningen skedde."@sv ,
                    "La réunion au cours de laquelle l'attribution a eu lieu."@fr ,
                    "Die Zusammenkunft, bei der die Verleihung stattfand."@de ,
                    "L'incontro in cui ha avuto luogo il conferimento."@it ,
                    "La reunión en la que tuvo lugar la concesión."@es ,
                    "A reunião em que teve lugar a atribuição."@pt ,
                    "Az összejövetel, amelyen az odaítélés történt."@hu .

mbr:conferredBy a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    rdfs:label "conferred by"@en , "tilldelat av"@sv , "conféré par"@fr , "verliehen durch"@de , "conferito da"@it , "conferido por"@es , "conferido por"@pt , "odaítélte"@hu ;
    rdfs:domain mbr:Conferral ;
    skos:definition "The organisation (or officer) that made the conferral."@en ,
                    "Den organisation (eller ämbetsman) som gjorde tilldelningen."@sv ,
                    "L'organisation (ou le responsable) qui a fait l'attribution."@fr ,
                    "Die Organisation (oder der Amtsträger), die die Verleihung vorgenommen hat."@de ,
                    "L'organizzazione (o il titolare di carica) che ha fatto il conferimento."@it ,
                    "La organización (o responsable) que hizo la concesión."@es ,
                    "A organização (ou responsável) que fez a atribuição."@pt ,
                    "A szervezet (vagy tisztségviselő), amely az odaítélést végezte."@hu .

##############################################################################
# ORGANISATION-LEVEL PROPERTIES AND RELATIONS BETWEEN ORGANISATIONS
##############################################################################

mbr:genderPolicy a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "gender policy"@en , "könspolicy"@sv , "règle de mixité"@fr , "Geschlechterregelung"@de , "politica di genere"@it , "política de género"@es , "política de género"@pt , "nemi politika"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "Who may be admitted, by gender (see mbrc:GenderPolicies)."@en ,
                    "Vilka som kan upptas, efter kön (se mbrc:GenderPolicies)."@sv ,
                    "Qui peut être admis, selon le genre (voir mbrc:GenderPolicies)."@fr ,
                    "Wer nach Geschlecht aufgenommen werden darf (siehe mbrc:GenderPolicies)."@de ,
                    "Chi può essere ammesso, secondo il genere (vedi mbrc:GenderPolicies)."@it ,
                    "Quién puede ser admitido, según el género (véase mbrc:GenderPolicies)."@es ,
                    "Quem pode ser admitido, segundo o género (ver mbrc:GenderPolicies)."@pt ,
                    "Ki vehető fel nem szerint (lásd mbrc:GenderPolicies)."@hu ;
    skos:scopeNote "On an organisation this is the registered current picture. Earlier and later values, with the dates they applied, are given with mbr:OrganizationPeriod; the current value is not derived from the periods. A club that changed from men only to mixed has the earlier policy and the later one as two periods."@en ,
                   "På en organisation är detta den registrerade aktuella bilden. Tidigare och senare värden, med de datum de gällde, anges med mbr:OrganizationPeriod; det aktuella värdet härleds inte ur perioderna. En klubb som gick från endast män till blandat har den tidigare och den senare policyn som två perioder."@sv ,
                   "Sur une organisation, c'est l'image actuelle enregistrée. Les valeurs antérieures et postérieures, avec les dates auxquelles elles s'appliquaient, sont indiquées avec mbr:OrganizationPeriod ; la valeur actuelle n'est pas déduite des périodes. Un club passé d'hommes seulement à mixte a la règle antérieure et la règle postérieure sous forme de deux périodes."@fr ,
                   "An einer Organisation ist dies das eingetragene aktuelle Bild. Frühere und spätere Werte mit den Daten, an denen sie galten, werden mit mbr:OrganizationPeriod angegeben; der aktuelle Wert wird nicht aus den Perioden abgeleitet. Ein Club, der von „nur Männer“ zu gemischt wechselte, hat die frühere und die spätere Regelung als zwei Perioden."@de ,
                   "Su un'organizzazione è il quadro attuale registrato. I valori precedenti e successivi, con le date in cui valevano, si indicano con mbr:OrganizationPeriod; il valore attuale non è ricavato dai periodi. Un club che è passato da soli uomini a misto ha la politica precedente e quella successiva come due periodi."@it ,
                   "En una organización es la imagen actual registrada. Los valores anteriores y posteriores, con las fechas en que se aplicaron, se dan con mbr:OrganizationPeriod; el valor actual no se deriva de los períodos. Un club que pasó de solo hombres a mixto tiene la política anterior y la posterior como dos períodos."@es ,
                   "Numa organização é a imagem atual registada. Os valores anteriores e posteriores, com as datas em que se aplicaram, indicam-se com mbr:OrganizationPeriod; o valor atual não se deriva dos períodos. Um clube que passou de só homens a misto tem a política anterior e a posterior como dois períodos."@pt ,
                   "Egy szervezeten ez a nyilvántartott jelenlegi kép. A korábbi és későbbi értékeket, érvényességük dátumával, az mbr:OrganizationPeriod adja meg; a jelenlegi értéket nem az időszakokból származtatják. Az a klub, amely csak férfiakból vegyessé vált, a korábbi és a későbbi politikával két időszakkal rendelkezik."@hu .

mbr:admissionMode a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "admission mode"@en , "upptagningsform"@sv , "mode d'admission"@fr , "Aufnahmeverfahren"@de , "modalità di ammissione"@it , "modalidad de admisión"@es , "modalidade de admissão"@pt , "felvételi mód"@hu ;
    rdfs:range skos:Concept ;
    skos:definition "How new members are admitted (see mbrc:AdmissionModes)."@en ,
                    "Hur nya medlemmar upptas (se mbrc:AdmissionModes)."@sv ,
                    "Comment les nouveaux membres sont admis (voir mbrc:AdmissionModes)."@fr ,
                    "Wie neue Mitglieder aufgenommen werden (siehe mbrc:AdmissionModes)."@de ,
                    "Come vengono ammessi i nuovi soci (vedi mbrc:AdmissionModes)."@it ,
                    "Cómo se admite a los nuevos miembros (véase mbrc:AdmissionModes)."@es ,
                    "Como se admitem os novos membros (ver mbrc:AdmissionModes)."@pt ,
                    "Hogyan veszik fel az új tagokat (lásd mbrc:AdmissionModes)."@hu ;
    skos:scopeNote "On an organisation this is the registered current picture. Earlier and later values, with the dates they applied, are given with mbr:OrganizationPeriod; the current value is not derived from the periods."@en ,
                   "På en organisation är detta den registrerade aktuella bilden. Tidigare och senare värden, med de datum de gällde, anges med mbr:OrganizationPeriod; det aktuella värdet härleds inte ur perioderna."@sv ,
                   "Sur une organisation, c'est l'image actuelle enregistrée. Les valeurs antérieures et postérieures, avec les dates auxquelles elles s'appliquaient, sont indiquées avec mbr:OrganizationPeriod ; la valeur actuelle n'est pas déduite des périodes."@fr ,
                   "An einer Organisation ist dies das eingetragene aktuelle Bild. Frühere und spätere Werte mit den Daten, an denen sie galten, werden mit mbr:OrganizationPeriod angegeben; der aktuelle Wert wird nicht aus den Perioden abgeleitet."@de ,
                   "Su un'organizzazione è il quadro attuale registrato. I valori precedenti e successivi, con le date in cui valevano, si indicano con mbr:OrganizationPeriod; il valore attuale non è ricavato dai periodi."@it ,
                   "En una organización es la imagen actual registrada. Los valores anteriores y posteriores, con las fechas en que se aplicaron, se dan con mbr:OrganizationPeriod; el valor actual no se deriva de los períodos."@es ,
                   "Numa organização é a imagem atual registada. Os valores anteriores e posteriores, com as datas em que se aplicaram, indicam-se com mbr:OrganizationPeriod; o valor atual não se deriva dos períodos."@pt ,
                   "Egy szervezeten ez a nyilvántartott jelenlegi kép. A korábbi és későbbi értékeket, érvényességük dátumával, az mbr:OrganizationPeriod adja meg; a jelenlegi értéket nem az időszakokból származtatják."@hu .

mbr:reciprocalWith a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:subPropertyOf org:linkedTo ;
    rdfs:label "reciprocal with"@en , "ömsesidighet med"@sv , "réciproque avec"@fr , "auf Gegenseitigkeit mit"@de , "reciproca con"@it , "recíproca con"@es , "recíproca com"@pt , "viszonos ezzel"@hu ;
    skos:definition "The two organisations grant each other's members reciprocal access. Use mbr:ReciprocityAgreement for dates and terms."@en ,
                    "De två organisationerna ger varandras medlemmar ömsesidigt tillträde. Använd mbr:ReciprocityAgreement för datum och villkor."@sv ,
                    "Les deux organisations accordent à leurs membres respectifs un accès réciproque. Utiliser mbr:ReciprocityAgreement pour les dates et les conditions."@fr ,
                    "Die beiden Organisationen gewähren den Mitgliedern der jeweils anderen gegenseitigen Zutritt. Für Daten und Bedingungen mbr:ReciprocityAgreement verwenden."@de ,
                    "Le due organizzazioni si concedono a vicenda l'accesso reciproco per i propri soci. Per date e condizioni si usa mbr:ReciprocityAgreement."@it ,
                    "Las dos organizaciones se conceden mutuamente acceso recíproco para sus miembros. Se usa mbr:ReciprocityAgreement para las fechas y las condiciones."@es ,
                    "As duas organizações concedem-se mutuamente acesso recíproco para os seus membros. Usa-se mbr:ReciprocityAgreement para as datas e as condições."@pt ,
                    "A két szervezet kölcsönösen viszonos hozzáférést ad egymás tagjainak. A dátumokhoz és feltételekhez az mbr:ReciprocityAgreement használandó."@hu .

mbr:party a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://w3id.org/membership> ;
    rdfs:label "party"@en , "part"@sv , "partie"@fr , "Vertragspartei"@de , "parte"@it , "parte"@es , "parte"@pt , "fél"@hu ;
    skos:definition "An organisation that is a party to a reciprocity agreement. An agreement has two or more parties."@en ,
                    "En organisation som är part i ett ömsesidighetsavtal. Ett avtal har två eller flera parter."@sv ,
                    "Organisation partie à un accord de réciprocité. Un accord a deux parties ou plus."@fr ,
                    "Eine Organisation, die Vertragspartei eines Gegenseitigkeitsabkommens ist. Ein Abkommen hat zwei oder mehr Vertragsparteien."@de ,
                    "Un'organizzazione che è parte di un accordo di reciprocità. Un accordo ha due o più parti."@it ,
                    "Una organización que es parte de un acuerdo de reciprocidad. Un acuerdo tiene dos o más partes."@es ,
                    "Uma organização que é parte de um acordo de reciprocidade. Um acordo tem duas ou mais partes."@pt ,
                    "Szervezet, amely egy viszonossági megállapodás fele. Egy megállapodásnak két vagy több fele van."@hu ;
    rdfs:domain mbr:ReciprocityAgreement ;
    rdfs:range org:Organization .
